{
  "$id": "producer.health.event.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "authority_class": {
      "minLength": 1,
      "type": "string"
    },
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "minLength": 1,
            "type": "string"
          },
          "details": {
            "type": [
              "object",
              "null"
            ]
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "available",
              "capability_unavailable",
              "degraded",
              "unknown"
            ]
          }
        },
        "required": [
          "capability",
          "status",
          "reason_code"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "dead_letter_count": {
      "type": "integer"
    },
    "dispatch_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "emitted_at": {
      "format": "date-time",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "properties": {
        "evidence_provenance": {
          "enum": [
            "production",
            "recorded",
            "synthetic"
          ]
        }
      },
      "required": [
        "evidence_provenance"
      ],
      "type": "object"
    },
    "gate_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "gate_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "invalid_count": {
      "type": "integer"
    },
    "lag": {
      "type": [
        "integer",
        "null"
      ]
    },
    "last_successful_emission": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_payload_count": {
      "type": "integer"
    },
    "model_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "module_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "parent_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "producer_id": {
      "type": "string"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "quarantined_count": {
      "type": "integer"
    },
    "reconciliation": {
      "type": [
        "object",
        "null"
      ]
    },
    "restart_count": {
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "telemetry_envelope.v1"
    },
    "seq": {
      "minimum": 1,
      "type": "integer"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "source_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown",
        "not_applicable"
      ]
    },
    "tool_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "const": "producer.health"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_type": {
      "enum": [
        "pipeline",
        "module",
        "gate",
        "generator",
        "validator",
        "pipeline_step",
        null
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "source_event_id",
    "type",
    "occurred_at",
    "emitted_at",
    "seq",
    "cursor",
    "project",
    "run_id",
    "source",
    "producer",
    "authority_class",
    "extensions",
    "producer_id",
    "status",
    "invalid_count",
    "quarantined_count",
    "dead_letter_count",
    "last_successful_emission",
    "capabilities"
  ],
  "type": "object"
}
