{
  "$id": "agent.tool.finished.event.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "agent_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "type": "number"
    },
    "authority_class": {
      "minLength": 1,
      "type": "string"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "dispatch_id": {
      "minLength": 1,
      "type": "string"
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "emitted_at": {
      "format": "date-time",
      "type": "string"
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "properties": {
        "evidence_provenance": {
          "enum": [
            "production",
            "recorded",
            "synthetic"
          ]
        }
      },
      "required": [
        "evidence_provenance"
      ],
      "type": "object"
    },
    "gate_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "gate_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "gateway_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_call_id": {
      "minLength": 1,
      "type": "string"
    },
    "module_id": {
      "minLength": 1,
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "outcome": {
      "minLength": 1,
      "type": "string"
    },
    "parent_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_bytes": {
      "minimum": 0,
      "type": "number"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "telemetry_envelope.v1"
    },
    "seq": {
      "minimum": 1,
      "type": "integer"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_key": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "source_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_call_id": {
      "minLength": 1,
      "type": "string"
    },
    "tool_name": {
      "minLength": 1,
      "type": "string"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "const": "agent.tool.finished"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_type": {
      "enum": [
        "pipeline",
        "module",
        "gate",
        "generator",
        "validator",
        "pipeline_step",
        null
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "source_event_id",
    "type",
    "occurred_at",
    "emitted_at",
    "seq",
    "cursor",
    "project",
    "run_id",
    "source",
    "producer",
    "authority_class",
    "extensions",
    "tool_name",
    "tool_call_id",
    "session_key",
    "model_call_id",
    "module_id",
    "attempt",
    "dispatch_id",
    "content_completeness",
    "outcome",
    "result_bytes",
    "error"
  ],
  "type": "object"
}
