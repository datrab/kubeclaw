{
  "$id": "lifecycle.transition.payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "authority": {
      "type": "string"
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "dispatch_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "effective_at": {
      "format": "date-time",
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "gate_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "gate_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle_version": {
      "const": "pipeline_lifecycle.v1"
    },
    "model_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "module_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "new_state": {
      "type": "string"
    },
    "previous_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "tool_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "lifecycle_version",
    "new_state",
    "reason_code",
    "effective_at",
    "authority",
    "previous_state"
  ],
  "type": "object"
}
