{
  "$id": "pipeline_command_evidence.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "type": "string"
    },
    "capability": {
      "minLength": 1,
      "type": "string"
    },
    "command_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "command_id": {
      "minLength": 1,
      "type": "string"
    },
    "command_type": {
      "enum": [
        "approval.resolve",
        "pipeline.pause",
        "pipeline.resume",
        "pipeline.cancel"
      ]
    },
    "expected_lifecycle_version": {
      "minimum": 0,
      "type": "integer"
    },
    "extensions": {
      "type": "object"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "result": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "error_class": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "completed",
                "failed",
                "rejected"
              ]
            },
            "value": {}
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "pipeline_command_evidence.v1"
    },
    "state": {
      "enum": [
        "requested",
        "accepted",
        "rejected",
        "completed"
      ]
    },
    "target": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "state",
    "recorded_at",
    "command_id",
    "command_type",
    "actor",
    "reason",
    "command_hash"
  ],
  "type": "object"
}
