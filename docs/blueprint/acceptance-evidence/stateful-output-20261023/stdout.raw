    matchLabels:
      app.kubernetes.io/name: kubeclaw
      app.kubernetes.io/component: nova
  egress:
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: kubeclaw
            app.kubernetes.io/component: buster
      toPorts:
        - ports:
            - protocol: TCP
              port: '18891'
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: kubeclaw-buster-test-gates-from-nova
spec:
  endpointSelector:
    matchLabels:
      app.kubernetes.io/name: kubeclaw
      app.kubernetes.io/component: buster
  ingress:
    - fromEndpoints:
        - matchLabels:
            app.kubernetes.io/name: kubeclaw
            app.kubernetes.io/component: nova
      toPorts:
        - ports:
            - protocol: TCP
              port: '18891'
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: kubeclaw-nova-prism-agent-trust
spec:
  endpointSelector:
    matchLabels:
      app.kubernetes.io/name: kubeclaw
      app.kubernetes.io/component: nova
  egress:
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: kubeclaw
            app.kubernetes.io/component: prism
      toPorts:
        - ports:
            - protocol: TCP
              port: '18082'
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: kubeclaw
            app.kubernetes.io/component: prism
            io.cilium.k8s.namespace.labels.kubeclaw/managed-by: buster-namespace-controller
      toPorts:
        - ports:
            - protocol: TCP
              port: '18082'
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: kubeclaw-redis-ingress
spec:
  endpointSelector:
    matchLabels:
      app.kubernetes.io/instance: redis
      app.kubernetes.io/name: redis
      app.kubernetes.io/component: master
  ingress:
    - fromEndpoints:
        - matchLabels:
            app.kubernetes.io/name: kubeclaw
        - matchLabels:
            app.kubernetes.io/name: clawdeck
      toPorts:
        - ports:
            - port: '6379'
              protocol: TCP
