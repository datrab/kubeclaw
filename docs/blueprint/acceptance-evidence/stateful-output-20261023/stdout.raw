apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: kubeclaw-agents-egress
spec:
  endpointSelector:
    matchLabels:
      app.kubernetes.io/name: kubeclaw
    matchExpressions:
      - key: app.kubernetes.io/component
        operator: NotIn
        values:
          - prism
  egress:
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/instance: redis
            app.kubernetes.io/name: redis
            app.kubernetes.io/component: master
      toPorts:
        - ports:
            - port: '6379'
              protocol: TCP
    - toEndpoints:
        - matchLabels:
            app: litellm
      toPorts:
        - ports:
            - protocol: TCP
              port: '4000'
    - toEndpoints:
        - matchLabels:
            app: registry-local
      toPorts:
        - ports:
            - protocol: TCP
              port: '5000'
            - protocol: TCP
              port: '5001'
    - toEndpoints:
        - matchLabels:
            app: registry-mirror
      toPorts:
        - ports:
            - protocol: TCP
              port: '5000'
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: kubeclaw
      toPorts:
        - ports:
            - protocol: TCP
              port: '18789'
            - protocol: TCP
              port: '18790'
    - toEntities:
        - world
      toPorts:
        - ports:
            - protocol: TCP
              port: '22'
            - protocol: TCP
              port: '80'
            - protocol: TCP
              port: '443'
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: kubeclaw-agents-ingress
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: kubeclaw
    matchExpressions:
      - key: app.kubernetes.io/component
        operator: NotIn
        values:
          - prism
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector: {}
      ports:
        - protocol: TCP
          port: 18789
        - protocol: TCP
          port: 18790
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: kubeclaw-buster-namespace-controller-api-egress
spec:
  endpointSelector:
    matchLabels:
      app.kubernetes.io/name: kubeclaw
      app.kubernetes.io/component: buster-namespace-controller
  egress:
    - toEntities:
        - kube-apiserver
      toPorts:
        - ports:
            - protocol: TCP
              port: '443'
            - protocol: TCP
              port: '6443'
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
