import fs from 'node:fs';import path from 'node:path';import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';import os from 'node:os';
import {stageInfrastructureChart,verifyInfrastructureChart} from '/home/node/.openclaw/workspace/kubeclaw-pr13-recovery/scripts/infrastructure-chart.mjs';
const root=process.cwd(),out='/home/node/.openclaw/workspace/tmp/pr13-stateful-20261023',sha=x=>createHash('sha256').update(x).digest('hex');
for(const key of ['NODE_OPTIONS','NODE_PATH'])assert(!process.env[key],key+' must be absent');
const require=createRequire(root+'/scripts/render-stateful-network-policies.mjs'),resolved=require.resolve('js-yaml'),pkg=path.dirname(resolved),files=[];
function walk(dir){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const f=path.join(dir,e.name);if(e.isDirectory()&&e.name!=='node_modules')walk(f);else if(e.isFile()&&(/\.(?:js|mjs|cjs|json)$/.test(f)))files.push({path:f,canonical:fs.realpathSync(f),sha256:sha(fs.readFileSync(f))});}}
walk(pkg);files.sort((a,b)=>a.path.localeCompare(b.path));
const tools=['helm','tar','curl'].map(name=>{const p=execFileSync('/usr/bin/which',[name],{encoding:'utf8'}).trim();return {name,path:p,canonical:fs.realpathSync(p),sha256:sha(fs.readFileSync(p))};});tools.push({name:'node',path:process.execPath,canonical:fs.realpathSync(process.execPath),sha256:sha(fs.readFileSync(process.execPath)),version:process.version});
const expected=JSON.parse(fs.readFileSync('versions.json'));const helmVersion=execFileSync('helm',['version','--short'],{encoding:'utf8'}).trim();assert(helmVersion.startsWith('v'+expected.buildArgs.HELM_VERSION+'+'));
const archives=['redis','postgresql'].map(name=>{const file=stageInfrastructureChart(name);return {name,path:file,canonical:fs.realpathSync(file),bytes:fs.statSync(file).size,lock:expected.infrastructureCharts[name],verified:verifyInfrastructureChart(name,file)};});
const scratch=fs.mkdtempSync(path.join(os.tmpdir(),'stateful-archive-negative-'));
try{for(const row of archives){const file=path.join(scratch,row.name+'.tgz');const bytes=fs.readFileSync(row.path);bytes[bytes.length-1]^=1;fs.writeFileSync(file,bytes);assert.throws(()=>verifyInfrastructureChart(row.name,file),/INFRASTRUCTURE_CHART_DIGEST_MISMATCH/);}}
finally{fs.rmSync(scratch,{recursive:true,force:true});}
const evidence={scope:'Current original default-profile acquired chart/tool/parser closure. Neither arbitrary profiles nor live cluster operations.',yamlResolution:{importer:root+'/scripts/render-stateful-network-policies.mjs',resolved,packageSha256:sha(fs.readFileSync(pkg+'/package.json')),files},tools,helmVersion,archives,archiveMutationNegatives:2,loaderEnvironmentAbsent:['NODE_OPTIONS','NODE_PATH'],sourceInputs:['scripts/render-stateful-network-policies.mjs','scripts/stateful-database-service.mjs','scripts/infrastructure-chart.mjs','scripts/infrastructure-chart-lock.mjs','scripts/infrastructure-oci-chart.mjs','scripts/infrastructure-release.mjs','scripts/infrastructure-image-renderer.mjs','scripts/deploy.sh','versions.json','package.json','package-lock.json','my-values/infra/network-policies.yaml','my-values/infra/redis-values.yaml','my-values/infra/postgresql-values.yaml'].map(f=>({path:f,sha256:sha(fs.readFileSync(f))}))};
fs.writeFileSync(out+'/acquired-closure.json',JSON.stringify(evidence,null,2)+'\n');console.log(JSON.stringify({parserFiles:files.length,tools:tools.length,lockedArchives:archives.length,negativeArchives:2,helmVersion}));
