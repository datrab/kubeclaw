import hashlib,json,os,subprocess,tempfile
from pathlib import Path
from datetime import datetime,timezone
P=Path(__file__).resolve().parent;BASE=P.parents[3];R=BASE/'ci-green/repo'
R=Path('/home/node/.openclaw/workspace/tmp/pr13-resume-20261014/efficiency-20261015/finish-20261017/ci-green/repo')
E=Path('/home/node/.openclaw/workspace/tmp/pr13-resume-20261014/efficiency-20261015')
ENV=dict(os.environ,GIT_OPTIONAL_LOCKS='0',GIT_AUTHOR_NAME='Nova',GIT_AUTHOR_EMAIL='nova@openclaw.local',GIT_COMMITTER_NAME='Nova',GIT_COMMITTER_EMAIL='nova@openclaw.local')
def git(*a,input=None,env=None):
 p=subprocess.run(['git',*a],cwd=R,env=env or ENV,input=input,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
 if p.returncode:raise RuntimeError((a,p.returncode,p.stderr.decode()))
 return p.stdout
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def save(n,d):(P/n).write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n')
def bind(p):return {'path':str(p),'sha256':sha(p)}
review=json.loads((P/'review.json').read_text());actual=json.loads((P/'actual-focused-result.json').read_text());assert review['findings']==[] and actual['state']=='BOUNDED_ROUTE_CONTINUITY_REGRESSIONS_PASS'
notice=json.loads((E/'pending-source-proposal-checkpoint.json').read_text());receipt=json.loads(Path(notice['currentVerifiedReceipt']).read_text());registration=json.loads((E/'finish-20261017/acceptance-registration-1152/receipt.json').read_text());assert registration['state']=='REGISTERED_COMMITTED_PUSHED_BOTH_REFS_VERIFIED'
manifest=json.loads((P/'manifest.json').read_text());files=manifest['files']
for f,h in files.items():assert sha(P/'repo'/f)==h
canonical=Path('/home/node/.openclaw/workspace/kubeclaw-documentation-cloud')
# Check the exact old freeze and exactly one user-authorized metadata delta;
# neither refresh nor replace that original freeze.
freeze=json.loads((E/'current-coordinator-work.json').read_text());freeze_path=Path(freeze['currentFreeze']);save('old-freeze-preserved.json',{'freeze':bind(freeze_path),'authorizedDelta':bind(E/'finish-20261017/acceptance-registration-1152/receipt.json'),'matrixSHA256':sha(canonical/'docs/blueprint/documentation-completion-matrix.json')})
assert sha(canonical/'docs/blueprint/documentation-completion-matrix.json')==registration['canonicalRegistry']['afterSha256']
head=git('rev-parse','HEAD').decode().strip();branch=git('rev-parse','--symbolic-full-name','HEAD');idx=Path(git('rev-parse','--git-path','index').decode().strip());idx=idx if idx.is_absolute() else R/idx;idxsha=sha(idx)
status=git('status','--porcelain=v1','-z','--untracked-files=all')
paths=set(x.decode() for x in (git('diff','--name-only','-z','HEAD').split(b'\0')+git('ls-files','--others','--exclude-standard','-z').split(b'\0')) if x)
before={p:sha(R/p) for p in paths if (R/p).is_file()}
# Fetch only refs; never checkout/reset/stash the preserved dirty lane.
git('fetch','origin','refs/heads/docs/documentation-overhaul:refs/remotes/origin/docs/documentation-overhaul','refs/heads/checkpoint/pr13-documentation-overhaul:refs/remotes/origin/checkpoint/pr13-documentation-overhaul')
old=git('rev-parse','refs/remotes/origin/docs/documentation-overhaul').decode().strip();assert git('rev-parse','refs/remotes/origin/checkpoint/pr13-documentation-overhaul').decode().strip()==old
git('merge-base','--is-ancestor',registration['registrationCommit'],old);git('merge-base','--is-ancestor',head,old)
assert git('show',old+':scripts/docs-governance.mjs')==git('show',manifest['publishedBaseline']+':scripts/docs-governance.mjs')
for f in files:
 if f=='scripts/docs-governance.mjs':continue
 existing=git('ls-tree',old,'--',f)
 if existing:
  assert git('show',old+':'+f)==(P/'repo'/f).read_bytes(),f+' unexpectedly differs'
for f in manifest.get('deletions',[]):
 assert git('show',old+':'+f)==(P/'repo/scripts/docs-published-route-baseline.json').read_bytes(), 'relocation changed baseline bytes'
assert hashlib.sha256(git('show',old+':docs/blueprint/documentation-completion-matrix.json')).hexdigest()==registration['canonicalRegistry']['afterSha256']
with tempfile.TemporaryDirectory(prefix='route-checkpoint-index-',dir=P) as t:
 env=dict(ENV,GIT_INDEX_FILE=str(Path(t)/'index'))
 # Fast-forward the temporary publishing tree to actual remote, never stale CI HEAD.
 git('read-tree',old,env=env)
 for f,h in files.items():
  blob=git('hash-object','-w','--stdin',input=(P/'repo'/f).read_bytes()).decode().strip()
  git('update-index','--add','--cacheinfo','100644',blob,f,env=env)
 for f in manifest.get('deletions',[]):
  git('update-index','--force-remove','--',f,env=env)
 git('diff','--cached','--check',old,env=env)
 tree=git('write-tree',env=env).decode().strip();assert tree!=git('show','-s','--format=%T',old).decode().strip()
 message='docs: keep pinned route baseline with automation authorities\n\nMove byte-identical machine baseline outside classified documentation tree.\nPinned source map and generated output unchanged. Independently reviewed\nGPT-6.1-Sol; affected route regressions repeated. No gate acceptance.\n'
 commit=git('commit-tree',tree,'-p',old,input=message.encode()).decode().strip()
 save('checkpoint-prepush.json',{'commit':commit,'base':old,'tree':tree,'files':files,'review':bind(P/'review.json'),'actual':bind(P/'actual-focused-result.json')})
 assert git('rev-parse','HEAD').decode().strip()==head and sha(idx)==idxsha and git('rev-parse','--symbolic-full-name','HEAD')==branch
 assert {p:sha(R/p) for p in before}==before and git('status','--porcelain=v1','-z','--untracked-files=all')==status
 git('push','--atomic','origin',commit+':refs/heads/docs/documentation-overhaul',commit+':refs/heads/checkpoint/pr13-documentation-overhaul')
 heads={line.split()[1]:line.split()[0] for line in git('ls-remote','--heads','origin','refs/heads/docs/documentation-overhaul','refs/heads/checkpoint/pr13-documentation-overhaul').decode().splitlines()};assert set(heads.values())=={commit}
 assert git('rev-parse','HEAD').decode().strip()==head and sha(idx)==idxsha and {p:sha(R/p) for p in before}==before
 out={'utc':datetime.now(timezone.utc).isoformat(),'state':'BOUNDED_ROUTE_CORRECTION_PUSHED_BOTH_REFS_VERIFIED','base':old,'commit':commit,'tree':tree,'files':files,'remoteHeads':heads,'remoteVerified':True,'ciHEADUnchanged':head,'ciIndexSHA256Unchanged':idxsha,'originalDirtyPathsPreserved':len(before),'canonicalWrites':False,'formalAcceptance':False,'ciGreen':False,'review':bind(P/'review.json'),'actual':bind(P/'actual-focused-result.json'),'checkpointMethod':'Same isolated-index read-tree/commit-tree/atomic normal-FF invariant as git-checkpoint.py, pinned to fetched remote; canonical-only helper cannot snapshot this external candidate without stale-source rollback. No CI checkout/index/worktree mutation.'}
 save('checkpoint-receipt.json',out);print(json.dumps(out,ensure_ascii=False,indent=2))
