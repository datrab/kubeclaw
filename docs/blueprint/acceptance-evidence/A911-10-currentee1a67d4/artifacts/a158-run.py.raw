import subprocess,json,hashlib,copy,re
from pathlib import Path
from datetime import datetime,timezone
P=Path(__file__).resolve().parent;R=Path('/home/node/.openclaw/workspace/tmp/pr13-resume-20261014/efficiency-20261015/finish-20261017/ci-green/repo');F=P/'fixture';REV='b1b2fe3d9f8d57e1cd2d3803824311fbd796aad9'
S='scripts/generate-buster-provider-reference.mjs';SCHEMA='skills/buster/plugins/api-flow/schemas/config.schema.json';PAGE='docs/site/reference/buster-provider-configuration.md'
def g(root,*args):return subprocess.check_output(['git',*args],cwd=root,stderr=subprocess.PIPE)
def sha(b):return hashlib.sha256(b).hexdigest()
assert R.is_dir() and not F.exists()
assert json.loads((P/'review.json').read_text())['findings']==[]
files=g(R,'ls-tree','-r','--name-only',REV,'skills/buster/plugins').decode().splitlines();files=[p for p in files if p.endswith('.json')]+[PAGE]
inputs={};F.mkdir()
for p in files:
 b=g(R,'show',REV+':'+p);o=F/p;o.parent.mkdir(parents=True,exist_ok=True);o.write_bytes(b);inputs[p]=sha(b)
o=F/S;o.parent.mkdir(parents=True,exist_ok=True);o.write_bytes((P/S).read_bytes());inputs[S]=sha(o.read_bytes())
g(F,'init','-q');g(F,'config','user.name','Nova');g(F,'config','user.email','nova@openclaw.local');g(F,'config','core.hooksPath','/dev/null')
# Git operations affect this synthetic source fixture only, never upstream branches.
def commit(label):
 g(F,'add','--','skills',S);g(F,'commit','-qm',label);return g(F,'rev-parse','HEAD').decode().strip()
base=commit('bounded provider provenance baseline');cases=[]
def run(name,rev=None,write=False,diagnostic=None):
 args=['node',S]+(['--revision='+rev] if rev is not None else [])+(['--write'] if write else [])
 r=subprocess.run(args,cwd=F,capture_output=True,text=True,timeout=60)
 for ext,s in [('stdout',r.stdout),('stderr',r.stderr)]: (P/(name+'.'+ext)).write_text(s)
 cases.append({'id':name,'exitCode':r.returncode,'expectedDiagnostic':diagnostic,'stdoutSHA256':sha(r.stdout.encode()),'stderrSHA256':sha(r.stderr.encode())})
 if diagnostic:assert r.returncode!=0 and diagnostic in r.stderr,(name,r.stderr[:1000])
 else:assert r.returncode==0,(name,r.stderr[:1000])
 return (F/PAGE).read_text()
def section(t):return t.split('## `kubeclaw.api-flow@1`',1)[1].split('\n## ',1)[0]
def schema(d):(F/SCHEMA).write_text(json.dumps(d,indent=2)+'\n')
def attributed(t,rev):
 assert f'Evidence revision: `{rev}`' in t and f'committed provider inputs {rev}' in t
 assert f'blob/{rev}/{SCHEMA}' in t
 assert g(F,'show',rev+':'+SCHEMA)==(F/SCHEMA).read_bytes()
run('reject-tree-object',rev=g(F,'rev-parse',base+'^{tree}').decode().strip(),diagnostic='BUSTER_PROVIDER_SOURCE_REVISION')
run('reject-invalid-revision',rev='main',diagnostic='BUSTER_PROVIDER_SOURCE_REVISION')
run('reject-missing-revision',rev='f'*40,diagnostic='BUSTER_PROVIDER_SOURCE_REVISION')
baseline=run('baseline-write',base,True);run('baseline-check',base);attributed(baseline,base)
original=json.loads((F/SCHEMA).read_text());delayed=copy.deepcopy(original);del delayed['properties']['maximumSteps'];schema(delayed)
prior=(F/PAGE).read_bytes();run('remove-uncommitted-rejected-before-write',base,True,'BUSTER_PROVIDER_SOURCE_REVISION');assert (F/PAGE).read_bytes()==prior
removed=commit('remove maximumSteps source field');run('remove-stale-output-rejected',removed,diagnostic='generated Buster provider configuration reference is stale')
t=run('remove-new-source-write',removed,True);assert '| `maximumSteps` |' not in section(t);attributed(t,removed);run('remove-new-source-check',removed);(P/'removed-output.md').write_text(t)
renamed=copy.deepcopy(original);renamed['properties']['maximumStepsAfterRename']=renamed['properties'].pop('maximumSteps');schema(renamed)
prior=(F/PAGE).read_bytes();run('rename-uncommitted-rejected-before-write',removed,True,'BUSTER_PROVIDER_SOURCE_REVISION');assert (F/PAGE).read_bytes()==prior
rename=commit('rename maximumSteps source field');run('rename-old-pin-rejected',base,True,'BUSTER_PROVIDER_SOURCE_REVISION')
run('rename-stale-output-rejected',rename,diagnostic='generated Buster provider configuration reference is stale')
t=run('rename-new-source-write',rename,True);assert '| `maximumSteps` |' not in section(t) and '| `maximumStepsAfterRename` |' in section(t);attributed(t,rename);run('rename-new-source-check',rename);run('noarg-owning-caller-after-rename');(P/'renamed-output.md').write_text(t)
assert re.search(r'^Owner: (.+)$',t,re.M).group(1)=='buster'
result={'utc':datetime.now(timezone.utc).isoformat(),'primaryGate':'A911-10','state':'PINNED_SOURCE_REMOVE_RENAME_POSITIVE_NEGATIVE_CASES_PASS','cases':cases,'inputHashes':inputs,'sourceCommits':{'baseline':base,'removed':removed,'renamed':rename},'source':SCHEMA,'output':PAGE,'provenance':'Actual git show equality of changed schema and output-pinned source; uncommitted/mismatched/invalid/missing source rejected before output overwrite.','ownerPreserved':'buster','routeRedirect':'Not applicable to this field-only transition; original page-route and link evidence retained separately.','scope':'Bounded source provenance + provider field rendering only; not registered84mutation or full gate/Source/Reader/Quality acceptance.','canonicalWrites':False,'formalAcceptance':False}
(P/'actual-result.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps({'state':result['state'],'cases':len(cases),'sourceCommits':result['sourceCommits']},indent=2))
