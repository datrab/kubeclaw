 assert git('rev-parse','HEAD').decode().strip()==head and sha(idx)==idxsha and {p:sha(R/p) for p in dirty}==dirty and git('status','--porcelain=v1','-z','--untracked-files=all')==status
 assert sha(CAN/'docs/blueprint/documentation-completion-matrix.json')==reg['canonicalRegistry']['afterSha256']
 out={'utc':datetime.now(timezone.utc).isoformat(),'state':'REVIEWED_PROVIDER_PROVENANCE_CORRECTION_PUSHED_BOTH_REFS_VERIFIED','commit':commit,'base':base,'tree':tree,'files':files,'remoteHeads':heads,'remoteVerified':True,'ciHEADUnchanged':head,'ciIndexSHA256Unchanged':idxsha,'originalDirtyPathsPreserved':len(dirty),'packageReview':bind(P/'package-review.json'),'actual':bind(P/'actual-result.json'),'currentPackage':bind(P/'current-package-result.json'),'checkpointMethod':'git-checkpoint.py invariant reused for exact external candidate: source helper cannot snapshot canonical frozen stale source. NormalFF temporary index against fetched remote; no real checkout/index writes.','formalAcceptance':False,'canonicalWrites':False,'fullCurrentGovernancePASS':False,'ciGreen':False}
