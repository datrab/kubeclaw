import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';import {gzipSync} from 'node:zlib';
import {discoverScriptInputGraph} from '/home/node/.openclaw/workspace/kubeclaw-pr13-recovery/scripts/docs-api-output-discovery.mjs';
import {createSerializedOutputRoleClassifier} from '/home/node/.openclaw/workspace/kubeclaw-pr13-recovery/scripts/docs-api-output-role-classification.mjs';
const root=process.cwd(),out=new URL('.',import.meta.url),sha=bytes=>createHash('sha256').update(bytes).digest('hex');const authorityPath='scripts/docs-api-top-level-script-purpose-authority.json',helper='scripts/docs-api-top-level-script-purpose.mjs',changed='scripts/docs-api-output-role-classification.mjs';
const oldBytes=fs.readFileSync(authorityPath),authority=JSON.parse(oldBytes),sources=Object.keys(authority.sourcePins);assert.equal(sources.length,11);assert.equal(authority.inputs.length,68);assert.equal(authority.descriptors.length,24);
const graph=discoverScriptInputGraph(root);fs.writeFileSync(new URL('purpose-graph.json.gz',out),gzipSync(JSON.stringify(graph)));
assert.deepEqual(graph.edges.filter(e=>sources.includes(e.target)),authority.incomingEdges);assert.deepEqual(graph.publicEntries.filter(e=>sources.includes(e.canonicalSource)),authority.publicEntries);
for(const [file,digest]of Object.entries(authority.sourcePins))assert.equal(sha(fs.readFileSync(file)),digest);
for(const file of authority.absentPackageBoundaries)assert(!fs.existsSync(file));
const classify=createSerializedOutputRoleClassifier(root,graph.closureSources),descriptor=role=>Object.fromEntries(['line','sink','expression','sinkContract','role'].map(key=>[key,role[key]??null]));const actual=sources.flatMap(source=>classify(source).map(role=>({source,...descriptor(role)})));assert.deepEqual(actual,authority.descriptors);
const deltas=[];for(const input of authority.inputs){const actual=sha(fs.readFileSync(input.path));if(actual===input.sha256)continue;assert.equal(input.path,changed);assert.equal(sha(execFileSync('git',['show','d90995f5:'+input.path])),input.sha256);deltas.push({path:input.path,before:input.sha256,after:actual});input.sha256=actual;}assert.equal(deltas.length,1);
const bytes=Buffer.from(JSON.stringify(authority,null,2)+'\n');let code=fs.readFileSync(helper,'utf8');assert.equal(code.split(sha(oldBytes)).length,2);code=code.replace(sha(oldBytes),sha(bytes));fs.writeFileSync(new URL('authority-candidate.json',out),bytes);fs.writeFileSync(new URL('purpose-helper-candidate.mjs.raw',out),code);
fs.writeFileSync(new URL('purpose-renewal.json',out),JSON.stringify({inputCount:68,sourceCount:11,descriptorCount:24,incomingEdges:authority.incomingEdges.length,publicEntries:authority.publicEntries.length,absentPackageBoundaries:authority.absentPackageBoundaries,deltas,onlyAuthorityInputAndHelperConstantChanged:true,oldAuthoritySha256:sha(oldBytes),newAuthoritySha256:sha(bytes)},null,2)+'\n');console.log('PASS exact68inputs/11sources/24descriptors/current graph; only reviewed classifier pin changes');
