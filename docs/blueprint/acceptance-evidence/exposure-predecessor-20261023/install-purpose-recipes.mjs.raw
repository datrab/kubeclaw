import fs from 'node:fs';import assert from 'node:assert/strict';import {gunzipSync} from 'node:zlib';
import {documentationExecutableRoleRecipes as recipes} from '/home/node/.openclaw/workspace/kubeclaw-pr13-recovery/scripts/docs-api-documentation-role-custody.mjs';
import {nativeOperationFactDigest as digest} from '/home/node/.openclaw/workspace/kubeclaw-pr13-recovery/scripts/docs-api-output-role-classification.mjs';
const out=new URL('.',import.meta.url),read=f=>JSON.parse(fs.readFileSync(new URL(f,out)));const changes=read('recipe-delta.json'),old=JSON.parse(gunzipSync(fs.readFileSync('docs/blueprint/acceptance-evidence/release-renderer-20261023/current-recipes.json.gz'))).records,now=JSON.parse(gunzipSync(fs.readFileSync(new URL('current-recipes.json.gz',out)))).records;
assert.equal(old.length,105);assert.equal(now.length,105);assert.equal(changes.length,6);const file='scripts/docs-api-documentation-role-custody.mjs';let code=fs.readFileSync(file,'utf8');let installed=0;
for(const before of old){assert.equal(digest(before.facts),before.actualDigest);const after=now.find(r=>r.source===before.source);assert(after);assert.equal(digest(after.facts),after.actualDigest);if(!changes.some(c=>c.source===before.source))assert.deepEqual(after.facts,before.facts);}
for(const c of changes){assert.equal(recipes[c.source].factsDigest,c.beforeDigest);assert(!c.childChanged);assert(!c.selectorsChanged);const classifier=c.source==='scripts/docs-api-output-role-classification.mjs';assert.equal(c.baselineSelectorsChanged,classifier);assert.equal(c.added.length,classifier?2:4);assert.equal(c.removed.length,classifier?2:4);
 const allowed=classifier?{createSerializedOutputRoleClassifier:'scripts/docs-api-output-role-classification.mjs',qualifiedFileRole:'scripts/docs-api-output-role-classification.mjs'}:{createSerializedOutputRoleClassifier:'scripts/docs-api-output-role-classification.mjs',authoritySha256:'scripts/docs-api-top-level-script-purpose.mjs',reviewedCallerCensusSha256:'scripts/docs-deployment-scalar-occurrence-custody.mjs',reviewedSelectedGraphSha256:'scripts/docs-deployment-scalar-occurrence-custody.mjs'};
 for(const f of [...c.added,...c.removed])assert.equal(f.source,allowed[f.symbol]);
 if(c.beforeDigest!==c.actualDigest){assert.equal(code.split(c.beforeDigest).length,2);code=code.replace(c.beforeDigest,c.actualDigest);installed++;}
}
assert.equal(installed,5);fs.writeFileSync(file,code);console.log(JSON.stringify({baseline:105,unchanged:99,reviewedFinalDeltas:6,additionalRecipeUpdates:5,onlyReviewedClassifierPurposeSealAndScalarPinFacts:true}));
