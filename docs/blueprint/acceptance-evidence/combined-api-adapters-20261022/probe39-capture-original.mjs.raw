import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import {fileURLToPath,pathToFileURL} from 'node:url';
const packet=path.dirname(fileURLToPath(import.meta.url));
const seal=JSON.parse(fs.readFileSync(path.join(packet,'seal.json'),'utf8'));
assert.equal(process.argv[2],'--execute-approved-packet','Prepared packet only; explicit parent approval required before execute.');
assert.equal(process.execPath,seal.node.path);assert.equal(process.version,seal.node.version);
const hash=x=>createHash('sha256').update(x).digest('hex');
const physical=(file,expected)=>{assert.equal(fs.realpathSync(file),file);assert(fs.lstatSync(file).isFile());assert.equal(hash(fs.readFileSync(file)),expected,`changed sealed input:${file}`);};
assert.equal(fs.realpathSync(seal.root),seal.root);
physical(seal.node.path,seal.node.sha256);
for(const [relative,digest] of Object.entries(seal.sourceFiles))physical(path.join(seal.root,relative),digest);
for(const relative of seal.absentBoundaries){try{fs.lstatSync(path.join(seal.root,relative));assert.fail(`new package/loader boundary:${relative}`);}catch(e){if(e.code!=='ENOENT')throw e;}}
for(const [relative,digest] of Object.entries(seal.inputFiles))physical(path.join(packet,relative),digest);
const resolved=import.meta.resolve('js-yaml',pathToFileURL(path.join(seal.root,'scripts/render-kubernetes-api-probe.mjs')).href);
assert.equal(resolved,seal.actualEsmResolution,'actual original-importer bare ESM resolution changed; run packet Node with --experimental-import-meta-resolve');
const output=path.join(packet,'capture');fs.mkdirSync(output,{recursive:false,mode:0o700});
const argv=[path.join(seal.root,'scripts/render-kubernetes-api-probe.mjs'),path.join(packet,'inputs/pod.fixture.json'),path.join(packet,'inputs/origins.fixture.json')];
fs.writeFileSync(path.join(output,'invocation.json'),JSON.stringify({node:seal.node,argv,cwd:seal.root,env:seal.childEnv,sealSha256:hash(fs.readFileSync(path.join(packet,'seal.json'))),inputKind:'explicit owned fixture,not observed actualPod',preparedRevision:seal.sourceRevisionAtPreparation},null,2)+'\n');
const result=spawnSync(seal.node.path,argv,{cwd:seal.root,env:seal.childEnv,timeout:30000,maxBuffer:16*1024*1024});
fs.writeFileSync(path.join(output,'stdout.raw'),result.stdout??Buffer.alloc(0));fs.writeFileSync(path.join(output,'stderr.raw'),result.stderr??Buffer.alloc(0));
const receipt={status:result.status,signal:result.signal,error:result.error?{name:result.error.name,code:result.error.code,message:result.error.message}:null,stdoutSha256:hash(result.stdout??''),stderrSha256:hash(result.stderr??''),originalUuidPreserved:true,productProbeExecuted:false,apiApplyAuthorized:false,runtimeExecutionAuthorized:false};
fs.writeFileSync(path.join(output,'result.json'),JSON.stringify(receipt,null,2)+'\n');
assert.equal(result.status,0,'OriginalCLI failed; retain captured failure,do not synthesize output.');assert.equal(result.stderr.length,0);
for(const [relative,digest] of Object.entries(seal.sourceFiles))physical(path.join(seal.root,relative),digest);
const {loadAll}=await import(resolved);const docs=loadAll(result.stdout.toString('utf8'));assert.equal(docs.length,2);assert.deepEqual(docs.map(x=>[x.apiVersion,x.kind]),[['v1','ConfigMap'],['batch/v1','Job']]);
const [config,job]=docs;const pod=JSON.parse(fs.readFileSync(argv[1],'utf8'));assert.match(config.metadata.name,/^api-policy-proof-[a-f0-9-]{36}$/);assert.equal(config.metadata.name,job.metadata.name);assert.equal(config.metadata.namespace,pod.metadata.namespace);assert.equal(config.metadata.annotations['kubeclaw.io/source-pod-uid'],pod.metadata.uid);assert.equal(job.spec.template.spec.serviceAccountName,pod.spec.serviceAccountName);assert.equal(job.spec.template.spec.containers[0].image,JSON.parse(fs.readFileSync(path.join(seal.root,'versions.json'),'utf8')).buildArgs.NODE_BASE);
fs.writeFileSync(path.join(output,'parsed-original-documents.json'),JSON.stringify(docs,null,2)+'\n');
fs.writeFileSync(path.join(output,'parsed-result.json'),JSON.stringify({originalDocuments:2,kinds:docs.map(x=>x.kind),originalGeneratedName:config.metadata.name,originalStdoutHash:receipt.stdoutSha256,constructorAndFixtureChecks:'PASS',schemaAdmission:'NOT_RUN',actualPodIdentity:'NOT_CLAIMED',networkProbe:'NOT_RUN',limits:seal.limits},null,2)+'\n');
