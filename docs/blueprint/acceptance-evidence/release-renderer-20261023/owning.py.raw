result={'exitCode':r.returncode,'finishedAt':datetime.datetime.now(datetime.timezone.utc).isoformat(),'inputsUnchanged':all(hashfile(p)==h for p,h in record['inputs'].items()),'streams':{s:hashfile(out/s) for s in ['stdout.raw','stderr.raw']}};(out/'result.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result));print((out/'stderr.raw').read_text()[:3500])
