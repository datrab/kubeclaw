set -euo pipefail; trap 'unset COMPILED_GATEWAY_TOKEN' EXIT; export COMPILED_JOURNEY_PARENT=/home/node/.openclaw/workspace/tmp/qua007-fresh/runtime; export COMPILED_JOURNEY="$COMPILED_JOURNEY_PARENT/journey"; export COMPILED_TOOLS_BIN="$COMPILED_JOURNEY_PARENT/nova-tools/node_modules/.bin"; export PATH="$COMPILED_JOURNEY_PARENT/semgrep/bin:$PATH"; export SEMGREP_SETTINGS_FILE="$COMPILED_JOURNEY_PARENT/semgrep-settings.yml"; export SEMGREP_LOG_FILE="$COMPILED_JOURNEY_PARENT/semgrep.log"; export COMPILED_GATEWAY_ENDPOINT=http://127.0.0.1:18789/tools/invoke; export COMPILED_AGENT_ID=main; export COMPILED_MODEL=openai/gpt-6.1-sol; export COMPILED_GATEWAY_TOKEN="$OPENCLAW_GATEWAY_TOKEN"; node docs/site/use/workflows/examples/compiled-project.mjs run "$COMPILED_JOURNEY"
