{
  "status": "explicit current schema definition control, not deployed selection or consumer effect; omitted target-only fields remain inventoried literal policies and proposed migration work",
  "omittedTargetOnlyFields": {
    "artifact-store": [
      "maximumRecordBytes"
    ],
    "telemetry-store": [
      "jsonMaximumDepth",
      "jsonMaximumNodes"
    ],
    "command-runner": [
      "maximumProcesses",
      "memoryBytes",
      "cpuMillis",
      "openFiles"
    ],
    "redis-transport": [
      "maximumPayloadBytes",
      "maximumBulkReplyBytes",
      "maximumReplyHeaderBytes"
    ],
    "transport-publisher": [
      "terminalReservationBytes",
      "deliveryMetadataAllowanceBytes",
      "jsonMaximumDepth"
    ],
    "operator-messaging": [
      "terminalReservationBytes",
      "deliveryMetadataAllowanceBytes",
      "jsonMaximumDepth",
      "jsonMaximumContainerEntries",
      "targets.receiptMode"
    ],
    "notification-observer": [
      "presentationFallbackMode",
      "unknownSeverity"
    ],
    "openclaw-agent-events": [
      "observedFieldsMaximum",
      "observedFieldNameCharacters",
      "identityCharactersMaximum"
    ],
    "runtime-dispatch:runtime": [
      "jsonMaximumDepth",
      "jsonMaximumContainerEntries",
      "jsonKeyCharactersMaximum"
    ],
    "runtime-dispatch:openclaw": [
      "sessionListCacheMs",
      "collectorWaitSeconds",
      "recentListMinimumMinutes",
      "recentListMarginMinutes",
      "pollExponentialMaximumPower",
      "cleanupPollMs",
      "maximumResultBytes",
      "targets.resultMode"
    ]
  },
  "profiles": {
    "artifact-store": {
      "artifactRoot": "${CASE_ROOT}/artifact",
      "maxArtifactBytes": 16777216,
      "maximumRecords": 100000,
      "maximumStoreBytes": 268435456
    },
    "state-store": {
      "root": "${CASE_ROOT}/state",
      "maxEntryBytes": 1048576,
      "maximumRecords": 100000,
      "maximumStoreBytes": 268435456
    },
    "telemetry-store": {
      "root": "${CASE_ROOT}/telemetry",
      "maxRecordBytes": 1048576,
      "maximumRecords": 100000,
      "maximumStoreBytes": 268435456
    },
    "wait-store": {
      "root": "${CASE_ROOT}/wait",
      "maxEntryBytes": 1048576,
      "maximumRecords": 100000,
      "maximumStoreBytes": 268435456
    },
    "network-http": {
      "allowedOrigins": [
        "${HTTP_FIXTURE_ORIGIN}",
        "${HTTP_FIXTURE_ORIGIN_B}"
      ],
      "allowedMethods": [
        "GET",
        "POST"
      ],
      "allowedHeaders": [
        "accept",
        "content-type",
        "idempotency-key",
        "authorization",
        "x-kubeclaw-signature",
        "x-kubeclaw-target",
        "x-case"
      ],
      "maxRequestBytes": 1048576,
      "maxResponseBytes": 1048576,
      "timeoutMs": 30000
    },
    "command-runner": {
      "allowedExecutables": [
        "${CASE_ROOT}/bin/case-child"
      ],
      "executableCatalog": {
        "case-child": "${CASE_ROOT}/bin/case-child"
      },
      "allowedWorkingRoots": [
        "${CASE_ROOT}/work"
      ],
      "maxOutputBytes": 1048576,
      "maxExecutionMs": 30000,
      "terminationGraceMs": 1000
    },
    "git-workspace": {
      "allowedRepositoryRoots": [
        "${CASE_ROOT}/repo"
      ],
      "workspaceRoot": "${CASE_ROOT}/worktrees",
      "gitExecutable": "${REAL_GIT_EXECUTABLE}",
      "authorName": "Case Author",
      "authorEmail": "case@example.invalid",
      "maxExecutionMs": 30000,
      "maxOutputBytes": 1048576,
      "terminationGraceMs": 1000
    },
    "redis-transport": {
      "url": "${REDIS_FIXTURE_URL}",
      "passwordSecret": "case.redis.password",
      "streamPrefix": "case:events",
      "maxLen": 100000,
      "dedupTtlMs": 86400000,
      "timeoutMs": 30000
    },
    "secret-resolver": {
      "environment": {
        "case.secret": "CASE_SECRET_A"
      }
    },
    "transport-publisher": {
      "deliveryRoot": "${CASE_ROOT}/transport",
      "maximumDeliveryRecords": 100000,
      "maximumDeliveryBytes": 268435456,
      "targets": {
        "case-target": {
          "endpoint": "${HTTP_FIXTURE_ORIGIN}/publish",
          "signingSecret": "case.signing",
          "maxPayloadBytes": 262144
        }
      }
    },
    "operator-messaging": {
      "deliveryRoot": "${CASE_ROOT}/operator",
      "maximumDeliveryRecords": 100000,
      "maximumDeliveryBytes": 268435456,
      "targets": {
        "case-target": {
          "endpoint": "${HTTP_FIXTURE_ORIGIN}/publish",
          "tokenSecret": "case.signing",
          "maxPayloadBytes": 65536,
          "format": "json"
        }
      }
    },
    "notification-observer": {
      "target": "case-target",
      "pipelineLabel": "Case Pipeline",
      "modelLabel": "Case Model",
      "stageLabels": {
        "stage:case": "Case Stage"
      },
      "maxMessageChars": 8192,
      "suppressEventTypes": []
    },
    "openclaw-agent-events": {
      "hooks": [
        "agent_end",
        "llm_input"
      ],
      "maxQueueEvents": 256,
      "maxQueueBytes": 1048576,
      "drainTimeoutMs": 5000
    },
    "runtime-dispatch:runtime": {
      "targets": {
        "case-target": {
          "endpoint": "${HTTP_FIXTURE_ORIGIN}/runtime",
          "authentication": "hmac",
          "tokenSecret": "case.runtime.hmac",
          "maxRequestBytes": 1048576,
          "maxResponseBytes": 1048576
        }
      }
    },
    "runtime-dispatch:openclaw": {
      "targets": {
        "case-target": {
          "endpoint": "${HTTP_FIXTURE_ORIGIN}/tools/invoke",
          "tokenSecret": "case.gateway.token",
          "runtime": "subagent",
          "agentId": "codex",
          "agentRole": "case-role",
          "model": "${VALID_INSTALLED_MODEL_A}",
          "thinking": "high",
          "controllerSessionKey": "agent:codex:case-controller",
          "collectorMode": false,
          "spawnIntervalMs": 1500,
          "tokenizerEncoding": "o200k_base",
          "maxPromptBytes": 900000,
          "maxInputTokens": 120000,
          "maxOutputTokens": 6000,
          "maxContextTokens": 128000,
          "cwd": "${CASE_ROOT}/repo",
          "repositoryRoot": "${CASE_ROOT}/repo",
          "workspaceRoot": "${CASE_ROOT}/worktrees",
          "pollMs": 1000,
          "maxPollMs": 15000,
          "maxPolls": 1800,
          "sessionTimeoutMs": 1800000,
          "resultPathPrefix": "results/case"
        }
      }
    }
  }
}
