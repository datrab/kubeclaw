79: function requireToolExecution(result: any, toolId: any) {
80:   if (result?.timedOut) {
81:     throw Object.assign(new Error(`${toolId} timed out: ${result.error}`), { code: `${toolId}-timeout` });
82:   }
83:   if (result?.exitCode === -1) {
84:     throw Object.assign(new Error(`${toolId} could not execute: ${result.error || 'unknown execution error'}`), { code: `${toolId}-execution-failed` });
85:   }
86:   return result;
87: }
