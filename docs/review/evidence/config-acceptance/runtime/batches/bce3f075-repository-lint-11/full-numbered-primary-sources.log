78: async function runTrivyKubernetes(ctx: any) {
79:   const findings: any[] = [];
80:   for (const chartDir of configuredMarkerDirectories(ctx, 'Chart.yaml')) {
81:     const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kubeclaw-trivy-kubernetes-'));
82:     const manifestPath = path.join(tempDir, 'rendered.yaml');
83:     try {
84:       const rendered = await renderChart(ctx, chartDir);
85:       fs.writeFileSync(manifestPath, rendered);
86:       const args = ['config', '--quiet', '--format', 'json', '--misconfig-scanners', 'kubernetes', '--severity', 'HIGH,CRITICAL', '--skip-check-update', '--skip-version-check', '--exit-code', '1', ...ctx.tool.arguments, manifestPath];
87:       const result = requireToolExecution(await safeExec('trivy', args, { signal: ctx.signal, cwd: ctx.repoRoot, timeout: ctx.tool.timeout_ms }), 'trivy-kubernetes');
88:       const parsed = tryParseJson(result.stdout);
89:       if (!parsed.ok) return failParse(ctx, 'trivy-kubernetes', parsed, result, chartDir);
90:       if (result.exitCode !== 0 && result.exitCode !== 1) return failParse(ctx, 'trivy-kubernetes', { error: `unexpected exit code ${result.exitCode}` }, result, chartDir);
91:       const results = Array.isArray(parsed.data?.Results) ? parsed.data.Results : [];
92:       const issues = results.flatMap((entry: any) => Array.isArray(entry.Misconfigurations) ? entry.Misconfigurations : []);
93:       findings.push(...trivyFindings(ctx, chartDir, rendered, issues));
94:       if (result.exitCode !== 0 && issues.length === 0) return failParse(ctx, 'trivy-kubernetes', { error: 'non-zero exit without misconfigurations' }, result, chartDir);
95:     } finally {
96:       fs.rmSync(tempDir, { recursive: true, force: true });
97:     }
98:   }
99:   return { errors: findings.length, warnings: 0, findings };
100: }
