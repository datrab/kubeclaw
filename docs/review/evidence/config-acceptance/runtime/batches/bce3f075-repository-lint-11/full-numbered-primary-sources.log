6:   }
7:   const rawManifests = kubernetes === undefined ? undefined : (kubernetes as Record<string, unknown>).rawManifests;
8:   const helmCharts = kubernetes === undefined ? undefined : (kubernetes as Record<string, unknown>).helmCharts;
9:   if (kubernetes !== undefined && (![rawManifests, helmCharts].every((entries) => Array.isArray(entries)
10:     && entries.every((entry) => typeof entry === 'string')))) {
11:     throw new Error('LINT_KUBERNETES_INPUT_INVALID');
12:   }
