200:           const match = line.match(/^(\d+)\s+(\S+)\s+(\S+)\s+(.+?\.go):(\d+):(\d+)$/);
201:           if (!match) failParse(ctx, 'gocyclo', { error: 'unrecognized complexity finding' }, result, moduleRoot);
202:           findings.push({
203:             file: path.resolve(moduleRoot, match[4]),
204:             line: Number(match[5]),
205:             column: Number(match[6]),
206:             severity: 'error',
207:             code: 'go-complexity',
208:             message: `${match[3]} has cyclomatic complexity ${match[1]}; maximum allowed is 10.`,
209:             fingerprint_seed: { package: match[2], function: match[3], file: path.relative(ctx.repoRoot, path.resolve(moduleRoot, match[4])).split(path.sep).join('/') },
210:           });
211:         }
212:         if (result.exitCode !== 0 && (result.exitCode !== 1 || findings.length === 0)) {
213:           failParse(ctx, 'gocyclo', { error: 'non-zero exit without complexity findings' }, result, moduleRoot);
214:         }
215:       }
216:       return findingsResult(findings);
217:     },
218:   };
