38: const MODULE_SPECIFIER = /(?:import|export)\s+(?:(?:[^'";\/]|\/(?![*/])|\/\/[^\n]*\n|\/\*[\s\S]*?\*\/)*?\s+from\s+)?['"](\.[^'"\n]+)['"]|require\(\s*['"](\.[^'"\n]+)['"]\s*\)|import\s*\(\s*['"](\.[^'"\n]+)['"]\s*\)/gu;
39: const SOURCE_EXTENSIONS = ['.ts', '.tsx', '.mts', '.cts', '.js', '.jsx', '.mjs', '.cjs'] as const;
40: 
41: export function referenceNeedle(sourcePath: string): string {
42:   return path.posix.basename(sourcePath).replace(/\.[^.]+$/u, '');
43: }
44: 
45: function possibleModulePaths(candidatePath: string, specifier: string): ReadonlySet<string> {
46:   const base = path.posix.normalize(path.posix.join(path.posix.dirname(candidatePath), specifier));
47:   const values = new Set<string>([base]);
48:   for (const extension of SOURCE_EXTENSIONS) {
49:     values.add(`${base}${extension}`); values.add(`${base}/index${extension}`);
50:   }
51:   const suppliedExtension = path.posix.extname(base);
52:   if (!SOURCE_EXTENSIONS.includes(suppliedExtension as typeof SOURCE_EXTENSIONS[number])) return values;
53:   const stem = base.slice(0, -suppliedExtension.length);
54:   for (const extension of SOURCE_EXTENSIONS) values.add(`${stem}${extension}`);
55:   return values;
56: }
57: 
58: export function directlyReferences(candidatePath: string, sourcePath: string, content: string): boolean {
59:   for (const match of content.matchAll(MODULE_SPECIFIER)) {
60:     let specifier = match[1];
61:     if (specifier === undefined) specifier = match[2] ?? match[3];
62:     if (specifier && possibleModulePaths(candidatePath, specifier).has(sourcePath)) return true;
63:   }
64:   return false;
65: }
