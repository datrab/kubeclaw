261: function jscpdTool() {
262:   return {
263:     id: 'jscpd',
264:     name: 'JSCPD',
265:     binary: 'jscpd',
266:     run: async (ctx: any) => {
267:       if (!ctx.tool.config_path || !fs.existsSync(ctx.tool.config_path)) failConfigMissing('jscpd-config-missing', 'JSCPD requires its exact configured path.');
268:       const testConfigPath = path.join(path.dirname(ctx.tool.config_path), 'jscpd-tests.json');
269:       if (!fs.existsSync(testConfigPath)) failConfigMissing('jscpd-test-config-missing', 'JSCPD requires its dedicated test calibration.');
270: 
271:       const productionDuplicates = await executeJscpd(ctx, ctx.tool.config_path, configuredTargetPaths(ctx), 'production');
272:       const testDuplicates = await executeJscpd(ctx, testConfigPath, ['tests'], 'tests');
273:       return findingsResult(jscpdFindings({ duplicates: [...productionDuplicates, ...testDuplicates] }, ctx.repoRoot));
274:     },
275:   };
276: }
