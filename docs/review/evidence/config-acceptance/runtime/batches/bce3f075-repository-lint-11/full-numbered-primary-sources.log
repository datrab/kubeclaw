177:   } else if (result.status === 'ok') log('OK', `${tool.name}: ${result.errors} errors, ${result.warnings} warnings (${result.duration_ms}ms)`);
178:   else if (result.status === 'not_applicable') log('INFO', `${tool.name}: not applicable — ${result.reason}`);
179:   else log('WARN', `${tool.name}: error — ${result.error}`);
