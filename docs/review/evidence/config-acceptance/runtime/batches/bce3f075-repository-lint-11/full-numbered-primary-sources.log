5: import { compareCodeUnits, directlyReferences, fullObjectId, regularFileMode, parseRevisionInventory, referenceNeedle,
6:   type RevisionInventoryRecord } from './revision-parsers.ts';
7: 
8: export type { RevisionInventoryRecord } from './revision-parsers.ts';
9: 
10: export interface ChangedPathRecord {
11:   readonly path: string;
12:   readonly status: 'added' | 'modified' | 'deleted' | 'renamed' | 'copied' | 'type_changed';
13:   readonly previousPath?: string;
14: }
15: 
16: export interface ChangedLineRange { readonly start: number; readonly end: number }
17: export interface RevisionReferenceRecord { readonly path: string; readonly sourcePath: string }
18: 
19: function assertExpected(payload: Readonly<Record<string, unknown>>, key: string, actual: unknown, code: string): void {
20:   if (payload[key] !== undefined && payload[key] !== actual) throw new Error(code);
21: }
22: 
23: export function repositoryRelativePath(value: unknown): string {
24:   if (typeof value !== 'string' || !value || value.startsWith('/') || value.includes(':')
25:     || value.includes('\\') || /[\u0000-\u001F\u007F]/u.test(value)
26:     || value.split('/').some((part) => !part || part === '.' || part === '..')) {
27:     throw new Error('REPOSITORY_PATH_FORBIDDEN');
28:   }
29:   return value;
30: }
31: 
32: function git(root: string, args: readonly string[], maxBuffer = 1024 * 1024): Buffer {
33:   return execFileSync('git', ['-C', root, ...args], {
34:     encoding: 'buffer', maxBuffer, stdio: ['ignore', 'pipe', 'pipe'],
35:   });
36: }
37: 
38: function resolveHead(root: string): string {
39:   return git(root, ['rev-parse', '--verify', 'HEAD^{commit}']).toString('utf8').trim();
40: }
41: 
42: function statusName(status: string): ChangedPathRecord['status'] {
43:   if (status === 'A') return 'added';
44:   if (status === 'M') return 'modified';
45:   if (status === 'D') return 'deleted';
46:   if (status === 'T') return 'type_changed';
47:   if (status.startsWith('R')) return 'renamed';
48:   if (status.startsWith('C')) return 'copied';
49:   throw new Error(`REPOSITORY_CHANGE_STATUS_UNSUPPORTED:${status}`);
50: }
51: 
52: function parseChangedManifest(output: Buffer): readonly ChangedPathRecord[] {
53:   const fields = new TextDecoder('utf-8', { fatal: true }).decode(output).split('\0');
54:   if (fields.at(-1) === '') fields.pop();
55:   const records: ChangedPathRecord[] = [];
56:   for (let index = 0; index < fields.length;) {
57:     const statusToken = fields[index++];
58:     if (!statusToken) throw new Error('REPOSITORY_CHANGE_MANIFEST_INVALID');
59:     const status = statusName(statusToken);
60:     const firstPath = repositoryRelativePath(fields[index++]);
61:     if (status === 'renamed' || status === 'copied') {
62:       const path = repositoryRelativePath(fields[index++]);
63:       records.push({ path, status, previousPath: firstPath });
64:     } else records.push({ path: firstPath, status });
65:   }
66:   return records.sort((left, right) => left.path < right.path ? -1 : left.path > right.path ? 1 : 0);
67: }
68: 
69: function scopePrefix(value: unknown): string {
70:   if (value === '.') return '.';
71:   return repositoryRelativePath(value);
72: }
73: 
74: function inScope(path: string, prefixes: readonly string[]): boolean {
75:   return prefixes.some((prefix) => prefix === '.' || path === prefix || path.startsWith(`${prefix}/`));
76: }
77: 
78: function allowedScopePrefixes(value: unknown): readonly string[] {
79:   if (!Array.isArray(value) || value.length < 1 || value.length > 128) {
80:     throw new Error('REPOSITORY_SCOPE_INVALID');
81:   }
82:   const prefixes = value.map(scopePrefix);
83:   if (new Set(prefixes).size !== prefixes.length) throw new Error('REPOSITORY_SCOPE_INVALID');
84:   return prefixes;
85: }
86: 
87: function scopedChange(record: ChangedPathRecord, prefixes: readonly string[]): ChangedPathRecord | undefined {
88:   const current = inScope(record.path, prefixes);
89:   if (record.status !== 'renamed' && record.status !== 'copied') return current ? record : undefined;
90:   const previous = inScope(record.previousPath ?? '', prefixes);
91:   if (current && previous) return record;
92:   if (current) return { path: record.path, status: 'added' };
93:   if (previous && record.status === 'renamed') {
94:     return { path: record.previousPath as string, status: 'deleted' };
95:   }
96:   return undefined;
97: }
98: 
99: function verifiedAncestor(root: string, base: string, head: string): true {
100:   const result = spawnSync('git', ['-C', root, 'merge-base', '--is-ancestor', base, head], {
101:     encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'],
102:   });
103:   if (result.status === 1) throw new Error('REPOSITORY_BASE_NOT_ANCESTOR');
104:   if (result.status !== 0) throw new Error('REPOSITORY_REVISION_INVALID');
105:   return true;
106: }
107: 
108: function changedLineRanges(output: Buffer): readonly ChangedLineRange[] {
109:   const patch = output.toString('latin1');
110:   const ranges: ChangedLineRange[] = [];
111:   const header = /^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@/gmu;
112:   for (const match of patch.matchAll(header)) {
113:     const start = Number(match[1]);
114:     const count = match[2] === undefined ? 1 : Number(match[2]);
115:     if (!Number.isSafeInteger(start) || start < 0 || !Number.isSafeInteger(count) || count < 0) {
116:       throw new Error('REPOSITORY_DIFF_INVALID');
117:     }
118:     if (count > 0) ranges.push({ start, end: start + count - 1 });
119:   }
120:   return ranges;
121: }
122: 
123: function sourcePaths(value: unknown): readonly string[] {
124:   if (!Array.isArray(value) || value.length < 1 || value.length > 256) {
125:     throw new Error('REPOSITORY_REFERENCE_SOURCE_INVALID');
126:   }
127:   const paths = value.map(repositoryRelativePath);
128:   if (new Set(paths).size !== paths.length) throw new Error('REPOSITORY_REFERENCE_SOURCE_INVALID');
129:   return paths.sort();
130: }
131: 
132: function referenceSearchCandidates(
133:   root: string, head: string, sources: readonly string[], allowedPrefixes: readonly string[], maximum: number,
134: ): readonly RevisionReferenceRecord[] {
135:   const candidates = new Map<string, RevisionReferenceRecord>();
136:   for (const sourcePath of sources) {
137:     for (const candidate of grepReferencePaths(root, head, referenceNeedle(sourcePath))) {
138:       if (candidate === sourcePath || !inScope(candidate, allowedPrefixes)) continue;
139:       candidates.set(`${candidate}\0${sourcePath}`, { path: candidate, sourcePath });
140:       if (candidates.size > maximum) throw new Error(`REPOSITORY_REFERENCE_SEARCH_LIMIT_EXCEEDED:${maximum}`);
141:     }
142:   }
143:   return [...candidates.values()].sort((left, right) => compareCodeUnits(
144:     `${left.path}\0${left.sourcePath}`, `${right.path}\0${right.sourcePath}`,
145:   ));
146: }
147: 
148: const REFERENCE_SCAN_CEILING = 32_768;
149: 
150: function provenReferences(
151:   root: string, head: string, candidates: readonly RevisionReferenceRecord[],
152: ): readonly RevisionReferenceRecord[] {
153:   return candidates.filter(({ path: candidate, sourcePath }) => {
154:     const content = git(root, ['show', `${head}:${candidate}`], 2 * 1024 * 1024).toString('utf8');
155:     return directlyReferences(candidate, sourcePath, content);
156:   });
157: }
158: 
159: function grepReferencePaths(root: string, head: string, needle: string): readonly string[] {
160:   const result = spawnSync('git', ['-C', root, 'grep', '-l', '-z', '-F', '-e', needle, head, '--'], {
161:     encoding: 'buffer', maxBuffer: 32 * 1024 * 1024, stdio: ['ignore', 'pipe', 'pipe'],
162:   });
163:   if (result.status === 1) return [];
164:   if (result.status !== 0 || !Buffer.isBuffer(result.stdout)) throw new Error('REPOSITORY_REFERENCE_SEARCH_FAILED');
165:   const prefix = `${head}:`;
166:   const fields = new TextDecoder('utf-8', { fatal: true }).decode(result.stdout).split('\0');
167:   if (fields.at(-1) === '') fields.pop();
168:   return fields.map((field) => repositoryRelativePath(field.startsWith(prefix) ? field.slice(prefix.length) : field));
169: }
