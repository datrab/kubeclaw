10: export interface RevisionInventoryRecord {
11:   readonly path: string;
12:   readonly objectId: string;
13:   readonly mode: string;
14:   readonly sizeBytes: number;
15: }
16: 
17: export function compareCodeUnits(left: string, right: string): number {
18:   return left < right ? -1 : left > right ? 1 : 0;
19: }
20: 
21: export function parseRevisionInventory(
22:   output: Buffer, safePath: (value: unknown) => string,
23: ): readonly RevisionInventoryRecord[] {
24:   const fields = new TextDecoder('utf-8', { fatal: true }).decode(output).split('\0');
25:   if (fields.at(-1) === '') fields.pop();
26:   return fields.map((field) => {
27:     const match = /^(\d{6}) (blob|commit) ([0-9a-f]{40}|[0-9a-f]{64}) +(\d+|-)\t([\s\S]+)$/u.exec(field);
28:     if (!match) throw new Error('REPOSITORY_INVENTORY_INVALID');
29:     const gitlink = match[1] === '160000' && match[2] === 'commit' && match[4] === '-';
30:     if (match[2] !== 'blob' && !gitlink) throw new Error('REPOSITORY_INVENTORY_INVALID');
31:     const sizeBytes = gitlink ? 0 : Number(match[4]);
32:     if (!Number.isSafeInteger(sizeBytes) || sizeBytes < 0) throw new Error('REPOSITORY_FILE_SIZE_INVALID');
33:     return { mode: match[1] as string, objectId: match[3] as string,
34:       sizeBytes, path: safePath(match[5]) };
35:   }).sort((left, right) => compareCodeUnits(left.path, right.path));
36: }
