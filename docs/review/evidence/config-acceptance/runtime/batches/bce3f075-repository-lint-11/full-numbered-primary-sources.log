136: async function runTool(tool: any, ctx: any) {
137:   const startTime = Date.now();
138: 
139:   assertNotAborted(ctx.signal);
140:   validatePolicyTargetPaths(ctx.repoRoot, { ...ctx.policy, tools: [tool] }, ctx.policyProject);
141:   const scopedContext = toolContext(ctx, tool);
142:   if (tool.scope === 'changed-files' && scopedContext.changedFilesRequested && scopedContext.changedFiles.length === 0) {
143:     return { status: 'not_applicable', reason: 'No requested changed files match the configured tool scope.', duration_ms: Date.now() - startTime };
144:   }
145: 
146:   // Check if the tool binary exists
147:   const binaryName = toolBinaryName(tool);
148:   if (!await commandExists(binaryName, ctx.signal)) return missingBinaryResult(tool, binaryName);
149: 
150:   try {
151:     const result = await tool.run(scopedContext);
152:     const durationMs = Date.now() - startTime;
153: 
154:     if (result?.status === 'not_applicable') {
155:       return { ...result, duration_ms: durationMs };
156:     }
157: 
158:     const findings = normalizeFindings(scopedContext, tool.id, resultFindings(result.findings));
159:     return successfulResult(ctx, tool, result, findings, durationMs);
160:   } catch (e: any) {
161:     assertNotAborted(ctx.signal);
162:     return executionError(tool, e, startTime);
163:   }
164: }
