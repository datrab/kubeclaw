35: type RepositoryRequest = AdapterInvocation['request'];
36: const REVISION_OPERATIONS = {
37:   freeze_head: (reader: RevisionReader, request: RepositoryRequest, attemptId: string) => reader.freezeHead(attemptId, request.payload),
38:   verify_ancestry: (reader: RevisionReader, request: RepositoryRequest, attemptId: string) => (
39:     reader.verifyAncestry(request.payload, attemptId)
40:   ),
41:   changed_manifest: (reader: RevisionReader, request: RepositoryRequest, attemptId: string) => (
42:     reader.changedManifest(request.payload, attemptId)
43:   ),
44:   read_revision_text: (reader: RevisionReader, request: RepositoryRequest, attemptId: string) => (
45:     reader.readRevisionText(request.resource.canonicalId, request.payload, attemptId)
46:   ),
47:   changed_line_ranges: (reader: RevisionReader, request: RepositoryRequest, attemptId: string) => (
48:     reader.changedLineRanges(request.resource.canonicalId, request.payload, attemptId)
49:   ),
50:   list_revision_paths: (reader: RevisionReader, request: RepositoryRequest, attemptId: string) => (
51:     reader.listRevisionPaths(request.payload, attemptId)
52:   ),
53:   inventory_revision: (reader: RevisionReader, request: RepositoryRequest, attemptId: string) => (
54:     reader.inventoryRevision(request.payload, attemptId)
55:   ),
56:   find_revision_references: (reader: RevisionReader, request: RepositoryRequest, attemptId: string) => (
57:     reader.findRevisionReferences(request.payload, attemptId)
58:   ),
59: } as const;
