16: export function requestPayload(value: Readonly<Record<string, unknown>>): LintExecutionRequest {
17:   const tier = value.tier;
18:   if (tier !== 'pre-check' && tier !== 'full') throw new Error('LINT_TIER_INVALID');
19:   const changedFiles = value.changedFiles;
20:   if (changedFiles !== undefined && (!Array.isArray(changedFiles) || changedFiles.some((item) => typeof item !== 'string'))) {
21:     throw new Error('LINT_CHANGED_FILES_INVALID');
22:   }
23:   if (typeof value.workingDirectory !== 'string') throw new Error('LINT_WORKING_DIRECTORY_INVALID');
24:   if (typeof value.policyPath !== 'string') throw new Error('LINT_POLICY_PATH_INVALID');
25:   if (typeof value.policyProject !== 'string') throw new Error('LINT_POLICY_PROJECT_INVALID');
