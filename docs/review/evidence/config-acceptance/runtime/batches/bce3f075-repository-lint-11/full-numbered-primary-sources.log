163: function cloneContext(repoRoot: any, file: any) {
164:   if (!repoRoot) return null;
165:   const sourcePath = path.resolve(repoRoot, file.name);
166:   if (!fs.existsSync(sourcePath)) return null;
167:   const lines = fs.readFileSync(sourcePath, 'utf8').split('\n');
168:   return [
169:     ...lines.slice(Math.max(0, file.start - 4), Math.max(0, file.start - 1)),
170:     ...lines.slice(file.end, file.end + 3),
171:   ].join('\n').trim().replace(/\s+/g, ' ');
172: }
