4: export interface ProcessOptions {
5:   cwd?: string | undefined;
6:   env?: NodeJS.ProcessEnv | undefined;
7:   input?: string | undefined;
8:   signal?: AbortSignal | undefined;
9:   timeout: number;
10:   maxBuffer?: number;
11: }
12: export interface ProcessResult {
13:   ok: boolean;
14:   stdout: string;
15:   stderr: string;
16:   exitCode: number;
17:   timedOut?: boolean;
18:   error?: string;
19: }
20: export function assertNotAborted(signal?: AbortSignal): void {
21:   if (signal?.aborted) throw Object.assign(new Error('LINT_CANCELLED', { cause: signal.reason }), { code: 'LINT_CANCELLED' });
22: }
23: 
24: /** One native lifecycle for lint tools and candidate Git. */
25: export async function runProcess(command: string, args: string[], options: ProcessOptions): Promise<ProcessResult> {
26:   assertNotAborted(options.signal);
27:   const child = spawn(command, args, { cwd: options.cwd, env: options.env, detached: process.platform !== 'win32', stdio: ['pipe', 'pipe', 'pipe'] });
28:   const stdout: Buffer[] = [];
29:   const stderr: Buffer[] = [];
30:   let bytes = 0;
31:   const termination = new ProcessTermination(child);
32:   const closed = new Promise<number | null>((resolve) => child.once('close', resolve));
33:   const capture = (chunks: Buffer[], chunk: Buffer): void => {
34:     bytes += chunk.length;
35:     if (bytes > (options.maxBuffer ?? 10 * 1024 * 1024)) termination.stop('output limit exceeded');
36:     else chunks.push(chunk);
37:   };
38:   child.stdout.on('data', (chunk: Buffer) => capture(stdout, chunk));
39:   child.stderr.on('data', (chunk: Buffer) => capture(stderr, chunk));
40:   child.stdin.on('error', (error: NodeJS.ErrnoException) => { if (error.code !== 'EPIPE') termination.error = error; });
41:   child.once('error', (error) => { termination.error = error; });
42:   termination.capture();
43:   const aborted = (): void => termination.stop('cancelled');
44:   options.signal?.addEventListener('abort', aborted, { once: true });
45:   if (options.signal?.aborted) aborted();
46:   const timer = setTimeout(() => termination.stop('timeout'), options.timeout);
47:   child.stdin.end(options.input);
48:   let status: number | null;
49:   try {
50:     status = await termination.finish(closed);
51:   } finally {
52:     clearTimeout(timer);
53:     options.signal?.removeEventListener('abort', aborted);
54:   }
55:   assertNotAborted(options.signal);
56:   return processResult(status, termination.reason, termination.error, stdout, stderr, options.timeout);
57: }
58: 
59: function processResult(status: number | null, reason: string | undefined, startError: Error | undefined, stdout: Buffer[], stderr: Buffer[], timeout: number): ProcessResult {
60:   const timedOut = reason === 'timeout' || (startError as NodeJS.ErrnoException | undefined)?.code === 'ETIMEDOUT';
61:   return {
62:     ok: status === 0 && !reason && !startError,
63:     stdout: Buffer.concat(stdout).toString('utf8'), stderr: Buffer.concat(stderr).toString('utf8'),
64:     exitCode: reason || startError ? -1 : status ?? -1,
65:     ...(timedOut ? { timedOut: true } : {}),
66:     ...(reason || startError ? { error: timedOut ? `timeout after ${timeout}ms` : reason ?? startError!.message } : {}),
67:   };
68: }
