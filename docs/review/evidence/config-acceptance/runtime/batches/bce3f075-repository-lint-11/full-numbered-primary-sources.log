171: export class RevisionReader {
172:   readonly #root: string;
173:   readonly #maxFileBytes: number;
174:   readonly #maxChangedPaths: number;
175:   readonly #expectedHead: string | undefined;
176:   readonly #proofKey = randomBytes(32);
177: 
178:   constructor(root: string, maxFileBytes: number, maxChangedPaths: number, expectedHead?: string) {
179:     this.#root = root;
180:     this.#maxFileBytes = maxFileBytes;
181:     this.#maxChangedPaths = maxChangedPaths;
182:     this.#expectedHead = expectedHead === undefined ? undefined : fullObjectId(expectedHead, 'expected_head');
183:   }
184: 
185:   #proof(head: string, attemptId: string): string {
186:     return createHmac('sha256', this.#proofKey).update(`${attemptId}\0${head}`).digest('hex');
187:   }
188: 
189:   #assertProof(payload: Readonly<Record<string, unknown>>, attemptId: string): string {
190:     const head = fullObjectId(payload.head, 'head');
191:     if (typeof payload.proof !== 'string' || !/^[0-9a-f]{64}$/u.test(payload.proof)) {
192:       throw new Error('REPOSITORY_REVISION_PROOF_INVALID');
193:     }
194:     const supplied = Buffer.from(payload.proof, 'hex');
195:     const expected = Buffer.from(this.#proof(head, attemptId), 'hex');
196:     if (!timingSafeEqual(supplied, expected)) throw new Error('REPOSITORY_REVISION_PROOF_INVALID');
197:     return head;
198:   }
199: 
200:   freezeHead(attemptId: string, payload: Readonly<Record<string, unknown>> = {}) {
201:     if (payload.repositoryRoot !== undefined && payload.repositoryRoot !== this.#root) throw new Error('REVIEW_REPOSITORY_IDENTITY_INVALID');
202:     const ref = payload.ref ?? 'HEAD';
203:     if (typeof ref !== 'string' || !ref || ref.startsWith('-') || /[\0\r\n]/u.test(ref)) throw new Error('REPOSITORY_REF_INVALID');
204:     const head = ref === 'HEAD' ? resolveHead(this.#root) : fullObjectId(git(this.#root, ['rev-parse', '--verify', `${ref}^{commit}`]).toString('utf8').trim(), 'ref');
205:     if (payload.requireClean === true && git(this.#root, ['status', '--porcelain=v1', '--untracked-files=all']).length) throw new Error('REVIEW_SOURCE_DIRTY');
206:     if (this.#expectedHead !== undefined && head !== this.#expectedHead) throw new Error('REPOSITORY_HEAD_MISMATCH');
207:     return { head, proof: this.#proof(head, attemptId), ...(payload.repositoryRoot === undefined ? {} : { repositoryRoot: this.#root }) };
208:   }
209: 
210:   verifyAncestry(payload: Readonly<Record<string, unknown>>, attemptId: string) {
211:     const base = fullObjectId(payload.base, 'base');
212:     const head = this.#assertProof(payload, attemptId);
213:     return { base, head, ancestryVerified: verifiedAncestor(this.#root, base, head) };
214:   }
215: 
216:   changedManifest(payload: Readonly<Record<string, unknown>>, attemptId: string) {
217:     const base = fullObjectId(payload.base, 'base');
218:     const head = this.#assertProof(payload, attemptId);
219:     verifiedAncestor(this.#root, base, head);
220:     const allowedPrefixes = allowedScopePrefixes(payload.allowedPrefixes);
221:     const changedPaths = parseChangedManifest(git(
222:       this.#root,
223:       ['diff', '--name-status', '-z', '--find-renames', '--find-copies', base, head, '--'],
224:       16 * 1024 * 1024,
225:     )).map((record) => scopedChange(record, allowedPrefixes)).filter(
226:       (record): record is ChangedPathRecord => record !== undefined,
227:     );
228:     if (changedPaths.length > this.#maxChangedPaths) {
229:       throw new Error(`REPOSITORY_CHANGE_LIMIT_EXCEEDED:${changedPaths.length}:${this.#maxChangedPaths}`);
230:     }
231:     return {
232:       base, head, changedPaths,
233:       manifestDigest: sha256Text(canonicalJson(changedPaths)),
234:     };
235:   }
236: 
237:   listRevisionPaths(payload: Readonly<Record<string, unknown>>, attemptId: string) {
238:     const head = this.#assertProof(payload, attemptId);
239:     const allowedPrefixes = allowedScopePrefixes(payload.allowedPrefixes);
240:     const requestedMaximum = payload.maxPaths ?? this.#maxChangedPaths * 8;
241:     if (!Number.isSafeInteger(requestedMaximum) || Number(requestedMaximum) < 1
242:       || Number(requestedMaximum) > 65_536) throw new Error('REPOSITORY_PATH_LIMIT_INVALID');
243:     const fields = new TextDecoder('utf-8', { fatal: true }).decode(git(
244:       this.#root, ['ls-tree', '-r', '--name-only', '-z', head], 64 * 1024 * 1024,
245:     )).split('\0');
246:     if (fields.at(-1) === '') fields.pop();
247:     const paths = fields.map(repositoryRelativePath).filter((path) => inScope(path, allowedPrefixes)).sort();
248:     if (paths.length > Number(requestedMaximum)) {
249:       throw new Error(`REPOSITORY_PATH_LIMIT_EXCEEDED:${paths.length}:${requestedMaximum}`);
250:     }
251:     return { head, paths, pathsDigest: sha256Text(canonicalJson(paths)) };
252:   }
253: 
254:   inventoryRevision(payload: Readonly<Record<string, unknown>>, attemptId: string) {
255:     const head = this.#assertProof(payload, attemptId);
256:     const allowedPrefixes = allowedScopePrefixes(payload.allowedPrefixes);
257:     const requestedMaximum = payload.maxPaths ?? this.#maxChangedPaths * 8;
258:     if (!Number.isSafeInteger(requestedMaximum) || Number(requestedMaximum) < 1
259:       || Number(requestedMaximum) > 1_000_000) throw new Error('REPOSITORY_PATH_LIMIT_INVALID');
260:     const files = parseRevisionInventory(git(
261:       this.#root, ['ls-tree', '-r', '-l', '-z', head], 256 * 1024 * 1024,
262:     ), repositoryRelativePath).filter(({ path }) => inScope(path, allowedPrefixes));
263:     if (files.length > Number(requestedMaximum)) {
264:       throw new Error(`REPOSITORY_PATH_LIMIT_EXCEEDED:${files.length}:${requestedMaximum}`);
265:     }
266:     return { head, files, inventoryDigest: sha256Text(canonicalJson(files)) };
267:   }
268: 
269:   findRevisionReferences(payload: Readonly<Record<string, unknown>>, attemptId: string) {
270:     const head = this.#assertProof(payload, attemptId);
271:     const allowedPrefixes = allowedScopePrefixes(payload.allowedPrefixes);
272:     const sources = sourcePaths(payload.sourcePaths);
273:     const requestedMaximum = payload.maxPaths ?? 256;
274:     if (!Number.isSafeInteger(requestedMaximum) || Number(requestedMaximum) < 1
275:       || Number(requestedMaximum) > 4096) throw new Error('REPOSITORY_REFERENCE_LIMIT_INVALID');
276:     const scanMaximum = REFERENCE_SCAN_CEILING;
277:     const candidates = referenceSearchCandidates(this.#root, head, sources, allowedPrefixes, scanMaximum);
278:     const records = provenReferences(this.#root, head, candidates);
279:     const unique = [...new Map(records.map((record) => [`${record.path}\0${record.sourcePath}`, record])).values()]
280:       .sort((left, right) => compareCodeUnits(
281:         `${left.path}\0${left.sourcePath}`, `${right.path}\0${right.sourcePath}`,
282:       ));
283:     if (unique.length > Number(requestedMaximum)) {
284:       throw new Error(`REPOSITORY_REFERENCE_LIMIT_EXCEEDED:${unique.length}:${requestedMaximum}`);
285:     }
286:     return { head, references: unique, referencesDigest: sha256Text(canonicalJson(unique)) };
287:   }
288: 
289:   readRevisionText(pathInput: unknown, payload: Readonly<Record<string, unknown>>, attemptId: string) {
290:     const path = repositoryRelativePath(pathInput);
291:     const head = this.#assertProof(payload, attemptId);
292:     // Core authorization has already constrained request.resource.canonicalId
293:     // against the capability grant. This payload check is defense-in-depth and
294:     // cannot expand the authority established by that grant.
295:     const allowedPrefixes = allowedScopePrefixes(payload.allowedPrefixes);
296:     if (!inScope(path, allowedPrefixes)) throw new Error(`REPOSITORY_PATH_OUT_OF_SCOPE:${path}`);
297:     const object = `${head}:${path}`;
298:     const mode = payload.requireRegularFile === true ? regularFileMode(git(this.#root, ['--literal-pathspecs', 'ls-tree', '-z', head, '--', path]).toString('utf8'), path) : undefined;
299:     const requestedMaximum = payload.maxBytes === undefined ? this.#maxFileBytes : payload.maxBytes;
300:     if (!Number.isSafeInteger(requestedMaximum) || Number(requestedMaximum) < 1
301:       || Number(requestedMaximum) > this.#maxFileBytes) throw new Error('REPOSITORY_FILE_LIMIT_INVALID');
302:     const maximum = Number(requestedMaximum);
303:     const type = git(this.#root, ['cat-file', '-t', object]).toString('utf8').trim();
304:     if (type !== 'blob') throw new Error('REPOSITORY_NOT_A_FILE');
305:     const objectId = fullObjectId(git(this.#root, ['rev-parse', '--verify', object]).toString('utf8').trim(), 'object');
306:     assertExpected(payload, 'expectedObjectId', objectId, 'REPOSITORY_OBJECT_ID_MISMATCH');
307:     const size = Number(git(this.#root, ['cat-file', '-s', object]).toString('utf8').trim());
308:     if (!Number.isSafeInteger(size) || size < 0) throw new Error('REPOSITORY_FILE_SIZE_INVALID');
309:     assertExpected(payload, 'expectedSizeBytes', size, 'REPOSITORY_FILE_SIZE_MISMATCH');
310:     if (size > maximum) throw new Error(`REPOSITORY_FILE_TOO_LARGE:${size}:${maximum}`);
311:     const bytes = git(this.#root, ['show', object], maximum + 1);
312:     const content = new TextDecoder('utf-8', { fatal: true }).decode(bytes);
313:     return { path, head, objectId, content, sizeBytes: bytes.length, digest: sha256Text(content), ...(mode ? { mode } : {}) };
314:   }
315: 
316:   changedLineRanges(pathInput: unknown, payload: Readonly<Record<string, unknown>>, attemptId: string) {
317:     const path = repositoryRelativePath(pathInput);
318:     const base = fullObjectId(payload.base, 'base');
319:     const head = this.#assertProof(payload, attemptId);
320:     verifiedAncestor(this.#root, base, head);
321:     const ranges = changedLineRanges(git(
322:       this.#root,
323:       [
324:         'diff', '--unified=0', '--no-color', '--no-ext-diff', '--no-textconv', '--text',
325:         '--diff-algorithm=myers', '--find-renames', '--find-copies', base, head, '--', path,
326:       ],
327:       16 * 1024 * 1024,
328:     ));
329:     return { base, head, path, ranges, rangesDigest: sha256Text(canonicalJson(ranges)) };
330:   }
331: }
