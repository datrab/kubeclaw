63: function secretRule(ctx: AnyRecord): AnyRecord[] {
64:   const { resource, rule, lookup, pod, namespace, group, container, keys, label } = ctx;
65:   const results: AnyRecord[] = [];
66:       for (const [envIndex, env] of (container.env || []).entries()) {
67:         const ref = env?.valueFrom?.secretKeyRef;
68:         if (ref && ref.optional !== true && !lookup.secrets.get(`${namespace}/${ref.name}`)?.has(ref.key)) results.push(finding(resource, rule, `${label} references missing Secret key ${ref.name}/${ref.key}.`, [...keys, 'env', envIndex]));
69:       }
70:   results.push(...secretSourceRule(ctx));
71: 
72:   return results;
73: }
74: 
75: function secretSourceRule(ctx: AnyRecord): AnyRecord[] {
76:   const { resource, rule, lookup, namespace, container, keys, label } = ctx;
77:   const results: AnyRecord[] = [];
78:       for (const [sourceIndex, source] of (container.envFrom || []).entries()) {
79:         const ref = source?.secretRef;
80:         if (ref?.name && ref.optional !== true && !lookup.secrets.has(`${namespace}/${ref.name}`)) results.push(finding(resource, rule, `${label} references missing Secret ${ref.name}.`, [...keys, 'envFrom', sourceIndex]));
81:       }
82:   return results;
83: }
84: 
85: function pullSecretRule(ctx: AnyRecord): AnyRecord[] {
86:   const { resource, rule, lookup, pod, namespace, group, container, keys, label } = ctx;
87:   const results: AnyRecord[] = [];
88:       const registry = rule.parameters.registries.find((prefix: string) => typeof container.image === 'string' && (container.image === prefix || container.image.startsWith(`${prefix}/`)));
89:       if (registry && pullSecrets(pod, namespace, lookup).length === 0) results.push(finding(resource, rule, `${label} uses private registry ${registry} without imagePullSecrets.`, keys));
90: 
91:   return results;
92: }
93: 
94: function resourceRule(ctx: AnyRecord): AnyRecord[] {
95:   const { resource, rule, lookup, pod, namespace, group, container, keys, label } = ctx;
96:   const results: AnyRecord[] = [];
97:       if (rule.parameters.cpu && !container.resources?.limits?.cpu) results.push(finding(resource, rule, `${label} has no CPU limit.`, keys));
98:       if (rule.parameters.memory && !container.resources?.limits?.memory) results.push(finding(resource, rule, `${label} has no memory limit.`, keys));
99: 
100:   return results;
101: }
102: 
103: function containerRule(ctx: AnyRecord): AnyRecord[] {
104:   const { resource, rule, group, container, keys, label } = ctx;
105:   switch (rule.type) {
106:     case 'required-env': return environmentRule(ctx);
107:     case 'secret-ref': return secretRule(ctx);
108:     case 'private-registry-pull-secret': return pullSecretRule(ctx);
109:     case 'resource-limits': return resourceRule(ctx);
110:     case 'readiness-probe': return group.probes && !container.readinessProbe
111:       ? [finding(resource, rule, `${label} has no readinessProbe.`, keys)] : [];
112:     case 'liveness-probe': return group.probes && !container.livenessProbe
113:       ? [finding(resource, rule, `${label} has no livenessProbe.`, keys)] : [];
114:     default: return [];
115:   }
116: }
117: 
118: function evaluateRule(resource: AnyRecord, podPath: Array<string | number>, rule: AnyRecord, lookup: AnyRecord): AnyRecord[] {
119:   const pod = podPath.reduce((value: AnyRecord, key) => value?.[key], resource.value);
120:   if (!pod || typeof pod !== 'object') return [];
121:   const namespace = resource.value.metadata?.namespace || 'default';
122:   const containerGroups = [
123:     { field: 'containers', values: Array.isArray(pod.containers) ? pod.containers : [], probes: true },
124:     { field: 'initContainers', values: Array.isArray(pod.initContainers) ? pod.initContainers : [], probes: false },
125:   ];
126:   const results: AnyRecord[] = [];
127:   for (const group of containerGroups) group.values.forEach((container: AnyRecord, index: number) => {
128:     const keys = [...podPath, group.field, index];
129:     const label = `${resourceName(resource)} ${group.field === 'initContainers' ? 'init container' : 'container'} '${container?.name || index}'`;
130:     results.push(...containerRule({ resource, rule, lookup, pod, namespace, group, container, keys, label }));
131:   });
132:   return results;
133: }
