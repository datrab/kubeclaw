1: function globRegex(pattern: string): RegExp {
2:   let source = '^';
3:   for (let index = 0; index < pattern.length; index++) {
4:     const char = pattern.charAt(index);
5:     if (char === '*' && pattern[index + 1] === '*') {
6:       const followedBySlash = pattern[index + 2] === '/';
7:       source += followedBySlash ? '(?:.*/)?' : '.*';
8:       index += followedBySlash ? 2 : 1;
9:     } else if (char === '*') source += '[^/]*';
10:     else source += /[.+^${}()|[\]\\]/.test(char) ? `\\${char}` : char;
11:   }
12:   return new RegExp(`${source}$`);
13: }
14: 
15: export function matchesPolicyPattern(file: string, pattern: string): boolean {
16:   return globRegex(pattern).test(file.replace(/\\/g, '/').replace(/^\.\//, ''));
17: }
18: 
19: export function policyIncludesFile(file: string, tool: Record<string, any>, globalExclusions: string[]): boolean {
20:   const normalized = file.replace(/\\/g, '/').replace(/^\.\//, '');
21:   const targeted = tool.targets.some((target: string) => target === '.' || normalized === target || normalized.startsWith(`${target.replace(/\/$/, '')}/`));
22:   if (!targeted) return false;
23:   if ([...globalExclusions, ...tool.exclude].some((pattern: any) => matchesPolicyPattern(normalized, pattern))) return false;
24:   return tool.include.length === 0 || tool.include.some((pattern: string) => matchesPolicyPattern(normalized, pattern));
25: }
