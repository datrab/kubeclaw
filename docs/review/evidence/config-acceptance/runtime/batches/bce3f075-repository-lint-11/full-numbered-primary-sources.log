43: function validateToolTargets(repoRoot: string, projectRoot: string, policy: Record<string, any>): void {
44:   const visited = new Set<string>();
45:   for (const tool of policy.tools) {
46:     for (const target of tool.targets) {
47:       const absolute = requireRepositoryPath(projectRoot, path.resolve(projectRoot, target));
48:       // Discovery exclusions are not a security boundary: native tsconfig,
49:       // Terraform and Helm traversals can still include excluded source paths.
50:       requireRepositoryTree(repoRoot, absolute, (file) => path.basename(file) === '.git', visited);
51:       const relative = path.relative(projectRoot, absolute);
52:       if (relative.startsWith('..') || path.isAbsolute(relative)) fail(`policy.tools.${tool.id}.targets`, `escapes project root: ${target}`);
53:       if (!fs.existsSync(absolute)) fail(`policy.tools.${tool.id}.targets`, `does not exist: ${target}`);
54:     }
55:   }
56: }
