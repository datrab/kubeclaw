75: export function kubeconformTool(id = 'kubeconform', includeRaw = false) {
76:   return {
77:     id,
78:     name: includeRaw ? 'Kubernetes schema validation' : 'Kubeconform',
79:     binary: 'kubeconform',
80:     tier: 'full',
81:     detect: (ctx: any) => {
82:       const kubernetes = ctx.policyProject?.kubernetes;
83:       const explicitInputCount = (Array.isArray(kubernetes?.raw_manifests) ? kubernetes.raw_manifests.length : 0)
84:         + (Array.isArray(kubernetes?.helm_charts) ? kubernetes.helm_charts.length : 0);
85:       return includeRaw ? explicitInputCount > 0 : ctx.projectTypes.has('helm') && explicitInputCount === 0;
86:     },
87:     run: async (ctx: any) => {
88:       const findings: any[] = [];
89:       const evidence: any[] = [];
90:       const settings = ctx.policyProject.kubernetes;
91:       const projectRoot = path.resolve(ctx.repoRoot, ctx.policyProject.root);
92:       // The migrated Kubernetes lint path owns its pinned local schema source.
93:       // The retained generic Helm adapter stays compatible for non-migrated use.
94:       const baseArgs = includeRaw
95:         ? ['-output', 'json', '-summary', '-strict', '-kubernetes-version', settings.kubernetes_version, '-schema-location', settings.schema_location]
96:         : ['-output', 'json', '-summary', '-strict'];
97:       if (includeRaw) evidence.push(...(await loadKubernetesResources(ctx)).sources);
98: 
99:       const { pushResourceFinding, recordEvidence } = collectors(ctx, id, findings, evidence);
100:       if (includeRaw) await validateRaw(ctx, baseArgs, projectRoot, pushResourceFinding, recordEvidence);
101: 
102:       const chartDirs = includeRaw
103:         ? settings.helm_charts.map((relative: string) => ({ chartDir: path.resolve(projectRoot, relative), source: relative }))
104:         : configuredMarkerDirectories(ctx, 'Chart.yaml').map((chartDir: string) => ({ chartDir, source: path.relative(ctx.repoRoot, chartDir).split(path.sep).join('/') }));
105:       for (const chart of chartDirs) await validateChart(ctx, includeRaw, baseArgs, chart, findings, pushResourceFinding, recordEvidence);
106: 
107:       return {
108:         errors: findings.filter((f: any) => f.severity === 'error').length,
109:         warnings: findings.filter((f: any) => f.severity === 'warning').length,
110:         findings,
111:         evidence,
112:       };
113:     },
114:   };
115: }
