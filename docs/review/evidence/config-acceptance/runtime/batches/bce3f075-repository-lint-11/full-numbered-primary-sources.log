67: export function regularFileMode(listing: string, path: string): '100644' | '100755' {
68:   const mode = listing.slice(0, 6);
69:   if (!['100644', '100755'].includes(mode) || listing.slice(listing.indexOf('\t') + 1) !== `${path}\0`) throw new Error('REVIEW_SOURCE_NOT_REGULAR');
70:   return mode as '100644' | '100755';
71: }
