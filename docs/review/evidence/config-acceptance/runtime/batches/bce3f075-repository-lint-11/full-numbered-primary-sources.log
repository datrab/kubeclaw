1: import fs from 'node:fs';
2: import { readdir, readFile } from 'node:fs/promises';
3: 
4: function ids(status: string, field: string): number[] {
5:   const value = new RegExp(`^${field}:\\s+(.+)$`, 'm').exec(status)?.[1];
6:   if (!value) throw new Error(`LINT_PROCESS_GROUP_STATUS_INVALID:${field}`);
7:   return value.trim().split(/\s+/u).map(Number);
8: }
9: 
10: function vanished(error: unknown): boolean {
11:   const code = (error as NodeJS.ErrnoException).code;
12:   return code === 'ENOENT' || code === 'ESRCH';
13: }
14: 
15: /** Capture host PGID before yielding/reaping the leader. /proc may be mounted
16:  * outside our PID namespace; namespace-local PIDs are unsafe /proc keys. */
17: export function captureLinuxProcessGroup(pid: number): number | undefined {
18:   const own = fs.readFileSync('/proc/self/status', 'utf8');
19:   const namespace = fs.readlinkSync('/proc/self/ns/pid');
20:   const depth = ids(own, 'NSpid').length - 1;
21:   const children = fs.readdirSync('/proc').filter((entry) => /^\d+$/u.test(entry));
22:   for (const child of children) {
23:     let status: string;
24:     try { status = fs.readFileSync(`/proc/${child}/status`, 'utf8'); }
25:     catch (error) { if (vanished(error)) continue; throw error; }
26:     if (ids(status, 'NSpgid')[depth] !== pid) continue;
27:     try { if (fs.readlinkSync(`/proc/${child}/ns/pid`) === namespace) return ids(status, 'NSpgid')[0]!; }
28:     catch (error) { if (vanished(error)) continue; throw error; }
29:   }
30:   try { process.kill(-pid, 0); }
31:   catch (error) { if ((error as NodeJS.ErrnoException).code === 'ESRCH') return undefined; throw error; }
32:   throw new Error(`LINT_PROCESS_GROUP_UNVERIFIABLE:${pid}`);
33: }
