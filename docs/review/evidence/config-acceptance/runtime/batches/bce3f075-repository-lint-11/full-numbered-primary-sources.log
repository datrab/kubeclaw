76: function validateToolPolicy(value: AnyRecord, path: string, expected: AnyRecord | null): void {
77:   requireString(value.category, `${path}.category`);
78:   requireString(value.scope, `${path}.scope`);
79:   if (!['warning', 'error'].includes(value.blocking_severity)) fail(`${path}.blocking_severity`, 'unknown severity');
80:   if (!['blocking', 'experimental'].includes(value.mode)) fail(`${path}.mode`, 'unknown mode');
81:   if (!expected) return;
82:   for (const field of ['category', 'scope', 'blocking_severity', 'mode']) if (value[field] !== expected[field]) fail(`${path}.${field}`, 'does not match configured tool policy');
83: }
