91: function layerForFile(layers: any, file: any) {
92:   const matches = layers.flatMap((layer: any) => layer.roots
93:     .filter((root: any) => file === root || file.startsWith(`${root}/`))
94:     .map((root: any) => ({ layer, root })));
95:   return matches.sort((left: any, right: any) => right.root.length - left.root.length)[0]?.layer ?? null;
96: }
