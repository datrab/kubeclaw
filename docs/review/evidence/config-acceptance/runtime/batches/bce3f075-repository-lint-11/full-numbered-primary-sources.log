135:       const yamlFiles = configuredTargetFilesForScope(ctx, (file: any) => file.endsWith('.yaml') || file.endsWith('.yml'));
136:       if (yamlFiles.length === 0) return { errors: 0, warnings: 0, findings: [] };
137:       const args = ['-c', config, '-f', 'parsable', '--strict', ...yamlFiles];
