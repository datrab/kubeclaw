3: export function fullObjectId(value: unknown, label: string): string {
4:   if (typeof value !== 'string' || !/^(?:[0-9a-f]{40}|[0-9a-f]{64})$/u.test(value)) {
5:     throw new Error(`${label.toUpperCase()}_INVALID`);
6:   }
7:   return value;
8: }
