144:       for (const line of lines) {
145:         const match = line.match(/^(.+?):(\d+):(\d+): \[(error|warning)\] (.+)/);
146:         if (match) {
147:           findings.push({
148:             file: match[1],
149:             line: parseInt(match[2], 10),
150:             column: parseInt(match[3], 10),
151:             severity: match[4],
152:             code: 'yamllint',
153:             message: match[5],
154:           });
155:         }
156:       }
157:       if (findings.length === 0 && result.exitCode !== 0) {
158:         return failParse(ctx, 'yamllint', { error: 'non-zero exit without parsed findings' }, result, ctx.repoRoot);
159:       }
160: 
161:       return {
162:         errors: findings.filter((f: any) => f.severity === 'error').length,
163:         warnings: findings.filter((f: any) => f.severity === 'warning').length,
164:         findings,
165:       };
166:     },
167:   };
