66: function validateProject(input: unknown, field: string, packIds: Set<string>): Record<string, any> {
67:   const project = record(input, field);
68:   const languages = stringList(project.languages, `${field}.languages`, { nonEmpty: true });
69:   for (const language of languages) if (!LANGUAGES.has(language)) fail(`${field}.languages`, `unknown language '${language}'`);
70:   const languageEvidence = validateLanguageEvidence(project, field, languages);
71:   if (!Number.isSafeInteger(project.discovery_max_depth) || project.discovery_max_depth < 0) fail(`${field}.discovery_max_depth`, 'required non-negative integer');
72:   const goModules = validateProjectGo(project, field, languages);
73:   const terraform = validateProjectTerraform(project, field, languages);
74:   const kubernetes = validateProjectKubernetes(project, field, packIds);
75:   return {
76:     id: text(project.id, `${field}.id`),
77:     root: repoRelative(project.root, `${field}.root`),
78:     languages,
79:     language_evidence: languageEvidence,
80:     discovery_max_depth: project.discovery_max_depth,
81:     go: { modules: goModules },
82:     terraform,
