22: export class AdapterStarter {
23:   readonly #options: StartupOptions; readonly #instances = new Map<string, AdapterInstance>(); readonly #controllers = new Map<string, AbortController>(); readonly #starting = new Set<string>();
24:   constructor(options: StartupOptions) { this.#options = options; }
25: 
26:   async startAll(): Promise<StartedAdapters> {
27:     try {
28:       for (const [id] of this.#options.runtime.granted.snapshot.adapters) {
29:         if (this.#options.runtime.granted.enabledRegistrations.has(id)) await this.#start(id);
30:       }
31:       if (this.#options.stopping()) throw new Error('ADAPTER_RUNTIME_STOPPING');
32:       return { instances: this.#instances, controllers: this.#controllers };
33:     } catch (error) { await this.#rollback(); throw error; }
34:   }
