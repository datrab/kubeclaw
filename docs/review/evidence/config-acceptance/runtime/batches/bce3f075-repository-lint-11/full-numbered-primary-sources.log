135: function kubernetesPolicyTool() {
136:   return {
137:     id: 'kubernetes-policy', name: 'Kubernetes manifest policy', binary: 'node', tier: 'full',
138:     detect: (ctx: AnyRecord) => ctx.policyProject.kubernetes.policy_packs.length > 0,
139:     run: async (ctx: AnyRecord) => {
140:       const { resources, sources } = await loadKubernetesResources(ctx);
141:       const lookup = indexes(resources);
142:       const packs = ctx.policy.kubernetes_policy_packs.filter((pack: AnyRecord) => ctx.policyProject.kubernetes.policy_packs.includes(pack.id));
143:       const findings: AnyRecord[] = [];
144:       for (const resource of resources) {
145:         const podPath = WORKLOAD_PATHS[resource.value.kind];
146:         if (!podPath) continue;
147:         for (const pack of packs) for (const rule of pack.rules) findings.push(...evaluateRule(resource, podPath, rule, lookup));
148:       }
149:       return {
150:         errors: findings.filter((entry) => entry.severity === 'error').length,
151:         warnings: findings.filter((entry) => entry.severity === 'warning').length,
152:         findings,
153:         evidence: [...sources, ...packs.map((pack: AnyRecord) => ({ kind: 'policy-pack', source: path.basename(pack.path), sha256: pack.digest, bytes: pack.bytes }))],
154:       };
155:     },
156:   };
157: }
158: 
159: function registerKubernetesPolicyTools(registerTool: any): void { registerTool(kubernetesPolicyTool()); }
