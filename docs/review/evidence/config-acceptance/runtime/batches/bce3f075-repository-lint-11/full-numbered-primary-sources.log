98: function dependencyCruiserFindings(ctx: any, modules: any) {
99:   const findings: any[] = [];
100:   for (const module of modules) {
101:     const source = module.source;
102:     const sourceLayer = layerForFile(ctx.policy.architecture.layers, source);
103:     for (const dependency of Array.isArray(module.dependencies) ? module.dependencies : []) {
104:       if (!sourceLayer || dependency.coreModule || dependency.couldNotResolve || !dependency.resolved) continue;
105:       const targetLayer = layerForFile(ctx.policy.architecture.layers, dependency.resolved);
106:       if (!targetLayer || sourceLayer.may_depend_on.includes(targetLayer.id)) continue;
107:       findings.push({
108:         file: source,
109:         line: null,
110:         column: null,
111:         severity: 'error',
112:         code: 'architecture:forbidden-dependency',
113:         message: `${sourceLayer.id} may not depend on ${targetLayer.id}: ${source} → ${dependency.resolved}`,
114:         fingerprint_seed: { source, target: dependency.resolved, source_layer: sourceLayer.id, target_layer: targetLayer.id },
115:       });
116:     }
117:   }
118:   for (const members of stronglyConnectedComponents(modules)) {
119:     findings.push({
120:       file: members[0],
121:       line: null,
122:       column: null,
123:       severity: 'error',
124:       code: 'architecture:circular-dependency',
125:       message: `Circular dependency component (${members.length} modules): ${members.join(', ')}`,
126:       fingerprint_seed: { members },
127:     });
128:   }
129:   return findings;
130: }
