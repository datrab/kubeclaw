98: function validateProjectGo(project: Record<string, any>, field: string, languages: string[]): Record<string, any>[] {
99:   const goSettings = project.go === undefined ? { modules: [] } : record(project.go, `${field}.go`);
100:   const goModules = Array.isArray(goSettings.modules) ? goSettings.modules.map((entry: any, index: any) => {
101:     const moduleField = `${field}.go.modules[${index}]`;
102:     const module = record(entry, moduleField);
103:     return {
104:       mod_file: repoRelative(module.mod_file, `${moduleField}.mod_file`),
105:       packages: stringList(module.packages, `${moduleField}.packages`, { nonEmpty: true }),
106:       build_tags: stringList(module.build_tags, `${moduleField}.build_tags`),
107:       allowed_import_prefixes: stringList(module.allowed_import_prefixes, `${moduleField}.allowed_import_prefixes`, { nonEmpty: true }),
108:     };
109:   }) : fail(`${field}.go.modules`, 'required array');
110:   if (languages.includes('go') && goModules.length === 0) fail(`${field}.go.modules`, 'required non-empty array when Go is enabled');
111:   return goModules;
112: }
