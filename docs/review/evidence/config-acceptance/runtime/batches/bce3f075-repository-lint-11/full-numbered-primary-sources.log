128: function collectForbiddenImports(findings: any[], packageInfo: any, settings: any, moduleRoot: string): void {
129:   for (const imported of Array.isArray(packageInfo.Imports) ? packageInfo.Imports : []) {
130:     const external = imported.split('/')[0].includes('.');
131:     const allowed = settings.allowed_import_prefixes.some((prefix: any) => imported === prefix || imported.startsWith(`${prefix}/`));
132:     if (!external || allowed) continue;
133:     findings.push({
134:       file: path.join(moduleRoot, 'go.mod'), line: null, column: null, severity: 'error',
135:       code: 'go-import-boundary',
136:       message: `Package ${packageInfo.ImportPath} imports '${imported}', which is outside the allowed import prefixes.`,
137:     });
138:   }
139: }
