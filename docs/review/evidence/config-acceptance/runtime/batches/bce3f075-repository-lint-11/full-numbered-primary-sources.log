88: function advanceJsonStream(state: JsonStreamState, character: string): void {
89:   if (state.inString) {
90:     if (state.escaped) state.escaped = false;
91:     else if (character === '\\') state.escaped = true;
92:     else if (character === '"') state.inString = false;
93:     return;
94:   }
95:   if (character === '"') state.inString = true;
96:   else if (character === '{' || character === '[') state.depth++;
97:   else if (character === '}' || character === ']') state.depth--;
98: }
99: 
100: function beginJsonStreamValue(ctx: any, toolId: any, result: any, target: any, state: JsonStreamState, character: string, index: number): boolean {
101:   if (/\s/.test(character)) return false;
102:   if (character !== '{' && character !== '[') failParse(ctx, toolId, { error: 'unexpected text outside JSON value' }, result, target);
103:   state.start = index;
104:   state.depth = 1;
105:   return true;
106: }
107: 
108: function parseJsonStream(ctx: any, toolId: any, result: any, target: any) {
109:   const values: any[] = [];
110:   const state: JsonStreamState = { start: -1, depth: 0, inString: false, escaped: false };
111:   for (let index = 0; index < result.stdout.length; index++) {
112:     const character = result.stdout[index];
113:     if (state.start < 0) {
114:       beginJsonStreamValue(ctx, toolId, result, target, state, character, index);
115:       continue;
116:     }
117:     advanceJsonStream(state, character);
118:     if (state.depth !== 0) continue;
119:     const parsed = tryParseJson(result.stdout.slice(state.start, index + 1));
120:     if (!parsed.ok) failParse(ctx, toolId, parsed, result, target);
121:     values.push(parsed.data);
122:     state.start = -1;
123:   }
124:   if (state.start >= 0 || values.length === 0) failParse(ctx, toolId, { error: state.start >= 0 ? 'incomplete JSON stream' : 'empty JSON stream' }, result, target);
125:   return values;
126: }
