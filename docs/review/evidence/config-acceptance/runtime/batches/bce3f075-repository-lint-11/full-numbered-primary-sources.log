SOURCE skills/nova/plugins/lint/src/adapter.ts SHA256 7d525ef53fc8a187eba48e7ee15ca7f8f2df1d00a4e23823de15bae47a1b49e4
1: import fs from 'node:fs';
2: import { assertNotAborted } from './engine/process.ts';
3: import { withLintCandidate } from './candidate.ts';
4: import path from 'node:path';
5: 
6: import type { AdapterActivationContext, AdapterInstance } from '@kubeclaw/plugin-sdk';
7: import { requestPayload } from './request.ts';
8: import { executeLintReport } from './engine/index.ts';
9: 
10: function configuredRoots(config: Readonly<Record<string, unknown>>, key: string): string[] {
11:   const value = config[key];
12:   if (!Array.isArray(value) || value.length === 0 || value.some((item) => typeof item !== 'string')) {
13:     throw new Error(`lint adapter ${key} must be a non-empty string array`);
14:   }
15:   return value.map((root) => fs.realpathSync(path.resolve(root as string)));
16: }
17: 
18: function requireInside(value: unknown, roots: readonly string[], label: string): string {
19:   if (typeof value !== 'string' || value.length === 0) throw new Error(`${label}_INVALID`);
20:   const canonical = fs.realpathSync(path.resolve(value));
21:   if (!roots.some((root) => canonical === root || canonical.startsWith(`${root}${path.sep}`))) {
22:     throw new Error(`${label}_DENIED:${canonical}`);
23:   }
24:   return canonical;
25: }
26: 
27: 
28: export function activate(context: AdapterActivationContext): AdapterInstance {
29:   const repositoryRoots = configuredRoots(context.config, 'allowedRepositoryRoots');
30:   const policyRoots = configuredRoots(context.config, 'allowedPolicyRoots');
31:   const shutdown = new AbortController();
32:   const active = new Set<Promise<Readonly<Record<string, unknown>>>>();
33:   return {
34:     async ready() {},
35:     async invoke({ request, signal: callerSignal, confidential, fence }) {
36:       const signal = AbortSignal.any([callerSignal, shutdown.signal]);
37:       const execute = async (): Promise<Readonly<Record<string, unknown>>> => {
38:       if (!confidential) fence.assertCurrent();
39:       if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
40:       if (request.capability !== 'lint.execute' || request.operation !== 'run_report') {
41:         throw new Error(`LINT_OPERATION_UNSUPPORTED:${request.capability}:${request.operation}`);
42:       }
43:       const payload = requestPayload(request.payload);
44:       const workingDirectory = requireInside(payload.workingDirectory, repositoryRoots, 'LINT_WORKING_DIRECTORY');
45:       const policyPath = requireInside(payload.policyPath, policyRoots, 'LINT_POLICY_PATH');
46:       const revision = request.payload.sourceRevision;
47:       if (revision !== undefined && (typeof revision !== 'string' || !/^[a-f0-9]{40}$/u.test(revision))) throw new Error('LINT_SOURCE_REVISION_INVALID');
48:       const run = (root: string) => executeLintReport({ ...payload, workingDirectory: root, policyPath, signal });
49:       const report = revision === undefined ? await run(workingDirectory)
50:         : await withLintCandidate(workingDirectory, revision, run, signal);
51:       assertNotAborted(signal);
52:       if (!confidential) fence.assertCurrent();
53:       return { report, ...(revision === undefined ? {} : { sourceRevision: revision }) };
54:       };
55:       const pending = execute();
56:       active.add(pending);
57:       try { return await pending; } finally { active.delete(pending); }
58:     },
59:     async shutdown() {
60:       shutdown.abort(new Error('LINT_ADAPTER_SHUTDOWN'));
61:       await Promise.allSettled([...active]);
62:     },
63:   };
64: }
