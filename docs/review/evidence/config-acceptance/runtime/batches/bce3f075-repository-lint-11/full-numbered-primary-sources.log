17: export interface LintExecutionRequest {
18:   readonly signal?: AbortSignal;
19:   readonly workingDirectory: string;
20:   readonly policyPath: string;
21:   readonly policyProject: string;
22:   readonly tier: 'pre-check' | 'full';
23:   readonly project?: string;
24:   readonly modulePath?: string;
25:   readonly changedFiles?: readonly string[];
26:   readonly includeDebt?: boolean;
27:   readonly includeExperimental?: boolean;
28:   readonly kubernetes?: {
29:     readonly rawManifests: readonly string[];
30:     readonly helmCharts: readonly string[];
31:   };
32: }
33: 
34: function kubernetesInputPaths(values: readonly string[], field: string): string[] {
35:   if (values.length > 256) throw new Error(`LINT_KUBERNETES_INPUT_LIMIT:${field}`);
36:   const normalized = values.map((value) => {
37:     if (typeof value !== 'string' || value.length === 0) throw new Error(`LINT_KUBERNETES_INPUT_INVALID:${field}`);
38:     const candidate = path.posix.normalize(value.replace(/\\/gu, '/'));
39:     if (path.posix.isAbsolute(candidate) || candidate === '..' || candidate.startsWith('../')) {
40:       throw new Error(`LINT_KUBERNETES_INPUT_ESCAPE:${field}:${value}`);
41:     }
42:     return candidate;
43:   });
44:   if (new Set(normalized).size !== normalized.length) throw new Error(`LINT_KUBERNETES_INPUT_DUPLICATE:${field}`);
45:   return normalized;
46: }
47: 
48: function effectivePolicyProject(project: Record<string, any>, input: LintExecutionRequest['kubernetes']): Record<string, any> {
49:   if (input === undefined) return project;
50:   const rawManifests = kubernetesInputPaths(input.rawManifests, 'rawManifests');
51:   const helmCharts = kubernetesInputPaths(input.helmCharts, 'helmCharts');
52:   if (rawManifests.length + helmCharts.length === 0) throw new Error('LINT_KUBERNETES_INPUT_EMPTY');
53:   return {
54:     ...project,
55:     kubernetes: { ...project.kubernetes, raw_manifests: rawManifests, helm_charts: helmCharts },
56:   };
57: }
58: 
59: function normalizeModulePath(repositoryRoot: string, value: string | undefined): string | null {
60:   if (!value) return null;
61:   if (path.isAbsolute(value)) throw new Error('LINT_MODULE_PATH_ABSOLUTE');
62:   const normalized = path.normalize(value);
63:   const absolute = requireRepositoryPath(repositoryRoot, path.resolve(repositoryRoot, normalized));
64:   const relative = path.relative(repositoryRoot, absolute);
65:   if (relative.startsWith('..') || path.isAbsolute(relative)) throw new Error('LINT_MODULE_PATH_ESCAPE');
66:   return normalized;
67: }
68: 
69: function normalizeChangedFiles(repositoryRoot: string, values: readonly string[] | undefined): string[] {
70:   if (!values) return [];
71:   return values.map((value) => {
72:     if (typeof value !== 'string' || value.length === 0) throw new Error('LINT_CHANGED_FILE_INVALID');
73:     if (path.isAbsolute(value)) throw new Error('LINT_CHANGED_FILE_ABSOLUTE');
74:     const normalized = path.normalize(value);
75:     if (normalized === '..' || normalized.startsWith(`..${path.sep}`)) throw new Error('LINT_CHANGED_FILE_ESCAPE');
76:     requireRepositoryPath(repositoryRoot, path.resolve(repositoryRoot, normalized));
77:     return normalized.split(path.sep).join('/');
78:   });
79: }
80: 
81: export async function executeLintReport(request: LintExecutionRequest): Promise<Record<string, unknown>> {
82:   assertNotAborted(request.signal);
83:   const repositoryRoot = fs.realpathSync(request.workingDirectory);
84:   const policyPath = fs.realpathSync(request.policyPath);
85:   const policy = loadLintPolicy(policyPath);
86:   const policyProject = effectivePolicyProject(selectPolicyProject(policy, request.policyProject), request.kubernetes);
87:   validatePolicyTargetPaths(repositoryRoot, policy, policyProject);
88:   const modulePath = normalizeModulePath(repositoryRoot, request.modulePath);
89:   const changedFiles = normalizeChangedFiles(repositoryRoot, request.changedFiles);
90:   const { types: projectTypes } = detectProjectTypes(repositoryRoot, policyProject, policy.global_exclusions);
91:   const context: Record<string, any> = {
92:     signal: request.signal,
93:     repoRoot: repositoryRoot,
94:     modulePath,
95:     requestedModulePath: modulePath,
96:     project: request.project || path.basename(repositoryRoot),
97:     tier: request.tier,
98:     changedFiles,
99:     changedFilesRequested: changedFiles.length > 0,
100:     projectTypes,
101:     policy,
102:     policyPath,
103:     policyDigest: policyDigest(policy),
104:     policyProject,
105:     includeDebt: request.includeDebt === true,
106:     includeExperimental: request.includeExperimental === true,
107:     diagnostics: takeDiscoveryDiagnostics(),
108:     matchedBaselineKeys: new Set<string>(),
109:   };
110:   if (changedFiles.length > 0) context.changedFiles = resolveScope(context);
111:   else resolveScope(context);
112:   context.diagnostics = [
113:     ...(Array.isArray(context.diagnostics) ? context.diagnostics : []),
114:     ...takeDiscoveryDiagnostics(),
115:   ];
116:   const report = await runToolsForRegistry(context, buildToolRegistry(policy, projectTypes));
117:   assertNotAborted(request.signal);
118:   validateLintReport(report);
119:   if (request.tier === 'full' && !context.changedFilesRequested && !modulePath) {
120:     const completedTools = new Set(Object.entries((report as any).tools)
121:       .filter(([, result]: any) => result.status === 'ok')
122:       .map(([toolId]) => toolId));
123:     const stale = policy.baseline.entries
124:       .map((entry: any) => `${entry.tool}:${entry.fingerprint}`)
125:       .filter((key: string) => completedTools.has(key.slice(0, key.indexOf(':'))))
126:       .filter((key: string) => !context.matchedBaselineKeys.has(key));
127:     if (stale.length > 0) {
128:       throw Object.assign(new Error(`Lint baseline contains ${stale.length} stale fingerprint(s); prune resolved debt before accepting new changes.`), {
129:         code: 'LINT_BASELINE_STALE',
130:         stale,
131:       });
132:     }
133:   }
134:   return report as Record<string, unknown>;
135: }
