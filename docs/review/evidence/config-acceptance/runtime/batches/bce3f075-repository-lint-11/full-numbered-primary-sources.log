85: function validateExperimentalResult(value: AnyRecord, path: string, visibility: AnyRecord): void {
86:   if (!visibility.experimental) fail(`${path}.mode`, 'experimental tool cannot appear in normal output');
87:   const forbiddenTotal = value.errors + value.warnings + value.blocking_findings + value.baselined_findings;
88:   if (forbiddenTotal !== 0) fail(path, 'experimental findings cannot affect blocking or debt counts');
89:   if (value.experimental_findings < value.findings.length) fail(`${path}.experimental_findings`, 'cannot be lower than disclosed findings');
90:   if (value.findings.some((finding: AnyRecord) => finding.baseline)) fail(`${path}.findings`, 'experimental findings cannot carry suppressions');
