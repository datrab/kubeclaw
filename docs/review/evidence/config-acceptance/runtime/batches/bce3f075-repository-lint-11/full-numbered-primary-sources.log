35: async function liveMember(entry: string, group: number): Promise<boolean> {
36:   let status: string;
37:   try { status = await readFile(`/proc/${entry}/status`, 'utf8'); }
38:   catch (error) { if (vanished(error)) return false; throw error; }
39:   if (ids(status, 'NSpgid')[0] !== group) return false;
40:   const state = /^State:\s+([A-Z])/mu.exec(status)?.[1];
41:   if (!state) throw new Error('LINT_PROCESS_GROUP_STATE_INVALID');
42:   return state !== 'Z' && state !== 'X';
43: }
44: 
45: async function groupIsRunning(group: number): Promise<boolean> {
46:   const entries = (await readdir('/proc')).filter((entry) => /^\d+$/u.test(entry));
47:   // Bound concurrent file descriptors even on a busy host proc mount.
48:   for (let offset = 0; offset < entries.length; offset += 64) {
49:     if ((await Promise.all(entries.slice(offset, offset + 64).map((entry) => liveMember(entry, group)))).some(Boolean)) return true;
50:   }
51:   return false;
52: }
53: 
54: export async function waitForLinuxGroupExit(group: number, deadline: number): Promise<void> {
55:   while (await groupIsRunning(group)) {
56:     if (Date.now() >= deadline) throw new Error('LINT_PROCESS_GROUP_EXIT_TIMEOUT');
57:     await new Promise((resolve) => setTimeout(resolve, 10));
58:   }
59: }
