70: function helmLintTool() {
71:   return {
72:     id: 'helm-lint',
73:     name: 'Helm Lint',
74:     binary: 'helm',
75:     tier: 'full',
76:     detect: (ctx: any) => ctx.projectTypes.has('helm'),
77:     run: async (ctx: any) => {
78:       const chartDirs = configuredMarkerDirectories(ctx, 'Chart.yaml');
79: 
80:       const allFindings: any[] = [];
81:       for (const chartDir of chartDirs) {
82:         const findingCountBeforeChart = allFindings.length;
83:         const result = requireToolExecution(await safeExec('helm', ['lint', '--strict', chartDir], { signal: ctx.signal, cwd: ctx.repoRoot, timeout: ctx.tool.timeout_ms }), 'helm-lint');
84:         const output = result.stdout + result.stderr;
85: 
86:         // Parse helm lint output: [ERROR] or [WARNING] lines
87:         const lines = output.split('\n');
88:         for (const line of lines) {
89:           const errorMatch = line.match(/\[ERROR\]\s+(.+)/);
90:           const warnMatch = line.match(/\[WARNING\]\s+(.+)/);
91:           if (errorMatch) {
92:             allFindings.push({
93:               file: chartDir,
94:               line: null,
95:               column: null,
96:               severity: 'error',
97:               code: 'helm-lint',
98:               message: errorMatch[1],
99:             });
100:           } else if (warnMatch) {
101:             allFindings.push({
102:               file: chartDir,
103:               line: null,
104:               column: null,
105:               severity: 'warning',
106:               code: 'helm-lint',
107:               message: warnMatch[1],
108:             });
109:           }
110:         }
111:         if (result.exitCode !== 0 && allFindings.length === findingCountBeforeChart) {
112:           return failParse(ctx, 'helm-lint', { error: 'non-zero exit without parsed findings' }, result, chartDir);
113:         }
114:       }
115: 
116:       return {
117:         errors: allFindings.filter((f: any) => f.severity === 'error').length,
118:         warnings: allFindings.filter((f: any) => f.severity === 'warning').length,
119:         findings: allFindings,
120:       };
121:     },
122:   };
123: }
