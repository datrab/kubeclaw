11: function collectors(ctx: any, id: string, findings: any[], evidence: any[]) {
12:       const pushResourceFinding = (item: any) => {
13:         if (selectTruthyValue(() => (item?.status === 'statusInvalid'), () => (item?.status === 'statusError'))) {
14:           const reportedFile = typeof item.filename === 'string' ? item.filename : '';
15:           const relativeFile = path.isAbsolute(reportedFile) ? path.relative(ctx.repoRoot, reportedFile) : reportedFile;
16:           const findingFile = relativeFile && !relativeFile.startsWith('..') && !path.isAbsolute(relativeFile)
17:             ? relativeFile.split(path.sep).join('/')
18:             : '<external>';
19:           findings.push({
20:             file: findingFile,
21:             line: null,
22:             column: null,
23:             severity: 'error',
24:             code: id,
25:             message: selectDefinedValue(() => (item.msg), () => (`Invalid K8s manifest: ${findingFile}`)),
26:           });
27:         }
28:       };
29: 
30:       const recordEvidence = (kind: string, source: string, content: string) => {
31:         const bytes = Buffer.byteLength(content);
32:         evidence.push({ kind, source, sha256: crypto.createHash('sha256').update(content).digest('hex'), bytes, ...(bytes <= 262_144 ? { content } : {}) });
33:       };
34: 
35:   return { pushResourceFinding, recordEvidence };
36: }
