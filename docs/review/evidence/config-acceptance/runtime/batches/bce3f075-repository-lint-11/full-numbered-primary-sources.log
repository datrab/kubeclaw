142: function knipFindings(data: any) {
143:   const findings: any[] = [];
144:   for (const issue of data.issues) {
145:     for (const [category, label] of Object.entries(KNIP_CATEGORIES)) {
146:       for (const item of Array.isArray(issue[category]) ? issue[category] : []) {
147:         const name = typeof item === 'string' ? item : item.name;
148:         findings.push({
149:           file: category === 'files' ? name : issue.file,
150:           line: category === 'files' ? null : (item.line ?? null),
151:           column: category === 'files' ? null : (item.col ?? null),
152:           severity: 'error',
153:           code: `knip:${category}`,
154:           message: `${label}: ${name}`,
155:           fingerprint_seed: { category, file: category === 'files' ? name : issue.file, name },
156:         });
157:       }
158:     }
159:   }
160:   return findings;
161: }
