12: async function invokeRepository(
13:   invocation: AdapterInvocation,
14:   root: string,
15:   maxFileBytes: number,
16:   revisions: RevisionReader,
17: ): Promise<Readonly<Record<string, unknown>>> {
18:   const { request, signal, confidential } = invocation;
19:   if (!confidential) invocation.fence.assertCurrent();
20:   if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
21:   if (request.capability !== 'git.repository.read') {
22:     throw new Error(`REPOSITORY_OPERATION_UNSUPPORTED:${request.capability}:${request.operation}`);
23:   }
24:   const attemptId = request.attempt.attemptId;
25:   const revisionOperation = REVISION_OPERATIONS[request.operation as keyof typeof REVISION_OPERATIONS];
26:   if (revisionOperation) return revisionOperation(revisions, request, attemptId);
27:   if (request.operation !== 'read_text') {
28:     throw new Error(`REPOSITORY_OPERATION_UNSUPPORTED:${request.capability}:${request.operation}`);
29:   }
30:   const result = readRepositoryFile(root, request.resource.canonicalId, maxFileBytes);
31:   if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
32:   return result;
33: }
