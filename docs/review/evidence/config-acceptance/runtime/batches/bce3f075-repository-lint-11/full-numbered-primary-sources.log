162: async function evidenceFiles(ctx: any): Promise<readonly string[]> {
163:   const candidates = configuredTargetFilesForScope(
164:     ctx,
165:     (file: string) => /\.(js|ts|jsx|tsx|mjs|cjs|mts|cts)$/u.test(file),
166:     ['.git/**', '.swarm/**', '**/node_modules/**'],
167:   );
168:   const key = EVIDENCE_PARTITION_BY_TOOL[ctx.tool.id as keyof typeof EVIDENCE_PARTITION_BY_TOOL];
169:   return key ? (await partitionEvidenceFiles(ctx.repoRoot, candidates, ctx.signal))[key] : [];
170: }
171: 
172: async function eslintTargetFiles(ctx: any): Promise<readonly string[]> {
173:   if (ctx.tool.id.startsWith('eslint-type-evidence-')) return evidenceFiles(ctx);
174:   if (!ctx.changedFilesRequested) return configuredTargetPaths(ctx);
175:   return ctx.changedFiles
176:     .filter((file: string) => /\.(js|ts|jsx|tsx|mjs|cjs|mts|cts)$/u.test(file))
177:     .map((file: string) => path.join(ctx.repoRoot, file));
178: }
179: 
180: function normalizeEslintFindings(ctx: any, reports: readonly any[]): any[] {
181:   const findings: any[] = [];
182:   for (const report of reports) {
183:     const occurrences = new Map();
184:     for (const message of arrayValue(report.messages)) {
185:       findings.push({
186:         file: report.filePath,
187:         line: message.line,
188:         column: message.column,
189:         severity: message.severity === 2 ? 'error' : 'warning',
190:         code: selectTruthyValue(() => (message.ruleId), () => ('eslint')),
191:         message: message.message,
192:         fingerprint_seed: eslintFindingSeed(ctx, report, message, occurrences),
193:       });
194:     }
195:   }
196:   return findings;
197: }
