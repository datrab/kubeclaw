SOURCE skills/nova/plugins/lint/src/stage.ts SHA256 6ba5172934f59d7b806e90ff1ce114feb8efe386a61ccedd8b86afc46b07d864
1: import { resolveSourceRevision } from '@kubeclaw/plugin-sdk';
2: import { validateLintReport } from './engine/report-contract.ts';
3: import type { ArtifactRef, PluginInvocationContext, StageResult } from '@kubeclaw/plugin-sdk';
4: 
5: interface LintInput {
6:   readonly workingDirectory: string;
7:   readonly sourceStageId?: string;
8:   readonly revision?: string;
9:   readonly project?: string;
10:   readonly modulePath?: string;
11:   readonly changedFiles?: readonly string[];
12:   readonly kubernetes?: {
13:     readonly rawManifests: readonly string[];
14:     readonly helmCharts: readonly string[];
15:   };
16: }
17: 
18: function requiredConfig(config: Readonly<Record<string, unknown>>, key: string): string {
19:   const value = config[key];
20:   if (typeof value !== 'string' || value.length === 0) throw new Error(`lint config is invalid: ${key}`);
21:   return value;
22: }
23: 
24: export function resultForReport(
25:   report: Readonly<Record<string, unknown>>,
26:   artifact: ArtifactRef,
27: ): StageResult {
28:   const validated = validateLintReport(report);
29:   const failedTools = validated.summary.tools_failed;
30:   const blocking = validated.summary.total_blocking;
31:   if (failedTools > 0) {
32:     return {
33:       schemaVersion: 'stage-result.v2',
34:       outcome: 'blocked',
35:       reason: {
36:         code: 'lint.tool_execution_failed',
37:         message: `${failedTools} required lint tool(s) failed`,
38:       },
39:       artifacts: [artifact],
40:     };
41:   }
42:   if (blocking > 0) {
43:     return {
44:       schemaVersion: 'stage-result.v2',
45:       outcome: 'request_fix',
46:       reason: {
47:         code: 'lint.blocking_findings',
48:         message: `${blocking} blocking lint finding(s) require remediation`,
49:       },
50:       artifacts: [artifact],
51:     };
52:   }
53:   return { schemaVersion: 'stage-result.v2', outcome: 'passed', artifacts: [artifact] };
54: }
55: 
56: async function execute(
57:   input: LintInput,
58:   context: PluginInvocationContext,
59:   tier: 'pre-check' | 'full',
60: ): Promise<StageResult> {
61:   const sourceRevision = input.sourceStageId !== undefined || input.revision !== undefined
62:     ? await resolveSourceRevision(input, context) : undefined;
63:   const response = await context.invoke('lint.execute', {
64:     operation: 'run_report',
65:     resource: { type: 'lint.project', canonicalId: input.project || input.workingDirectory },
66:     payload: {
67:       workingDirectory: input.workingDirectory,
68:       ...(sourceRevision === undefined ? {} : { sourceRevision }),
69:       policyPath: requiredConfig(context.contract.config, 'policyPath'),
70:       policyProject: requiredConfig(context.contract.config, 'policyProject'),
71:       tier,
72:       ...(input.project ? { project: input.project } : {}),
73:       ...(input.modulePath ? { modulePath: input.modulePath } : {}),
74:       ...(input.changedFiles ? { changedFiles: [...input.changedFiles] } : {}),
75:       ...(input.kubernetes ? { kubernetes: {
76:         rawManifests: [...input.kubernetes.rawManifests],
77:         helmCharts: [...input.kubernetes.helmCharts],
78:       } } : {}),
79:       includeDebt: context.contract.config.includeDebt === true,
80:       includeExperimental: context.contract.config.includeExperimental === true,
81:     },
82:   });
83:   if (sourceRevision !== undefined && response.sourceRevision !== sourceRevision) throw new Error('LINT_SOURCE_REVISION_MISMATCH');
84:   const report = { ...validateLintReport(response.report), ...(sourceRevision === undefined ? {} : { sourceRevision }) };
85:   const stored = await context.invoke('artifacts.write', {
86:     operation: 'put_json',
87:     resource: { type: 'artifact.object', canonicalId: `lint:${tier}:${input.project || 'project'}` },
88:     payload: { namespace: 'kubeclaw.lint', mediaType: 'application/json', value: report },
89:   });
90:   const artifact = stored.artifact as ArtifactRef;
91:   return resultForReport(report, artifact);
92: }
93: 
94: export function executePreCheck(input: LintInput, context: PluginInvocationContext): Promise<StageResult> {
95:   return execute(input, context, 'pre-check');
96: }
97: 
98: export function executeFull(input: LintInput, context: PluginInvocationContext): Promise<StageResult> {
99:   return execute(input, context, 'full');
100: }
SOURCE skills/nova/plugins/lint/src/candidate.ts SHA256 cb87e62587a7bad9f2d63a305870e85bdbf439440e02e4dfed5d91475ba6560e
1: import fs from 'node:fs';
2: import os from 'node:os';
3: import path from 'node:path';
4: import { runProcess, assertNotAborted } from './engine/process.ts';
5: 
6: /** Give lint an isolated checkout of the selected commit, never ambient HEAD. */
7: export async function withLintCandidate<T>(repository: string, revision: string, execute: (root: string) => Promise<T>, signal?: AbortSignal): Promise<T> {
8:   assertNotAborted(signal);
9:   if (!/^[a-f0-9]{40}$/u.test(revision)) throw new Error('LINT_SOURCE_REVISION_INVALID');
10:   const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'kubeclaw-lint-candidate-'));
11:   const checkout = path.join(temporary, 'repository');
12:   const git = async (args: string[]) => {
13:     const result = await runProcess('git', ['-c', 'core.hooksPath=/dev/null', ...args], {
14:       timeout: 60000, maxBuffer: 16 * 1024 * 1024, signal,
15:     });
16:     if (!result.ok) throw Object.assign(new Error(`LINT_CANDIDATE_GIT_FAILED:${result.error ?? result.stderr}`), {
17:       code: result.timedOut ? 'LINT_CANDIDATE_TIMEOUT' : 'LINT_CANDIDATE_GIT_FAILED',
18:     });
19:     return result.stdout.trim();
20:   };
21:   try {
22:     await git(['clone', '--shared', '--no-checkout', '--quiet', '--', repository, checkout]);
23:     await git(['-C', checkout, 'checkout', '--quiet', '--detach', revision, '--']);
24:     if (await git(['-C', checkout, 'rev-parse', 'HEAD']) !== revision) throw new Error('LINT_SOURCE_REVISION_MISMATCH');
25:     return await execute(checkout);
26:   } finally { fs.rmSync(temporary, { recursive: true, force: true }); }
27: }
SOURCE skills/nova/plugins/lint/src/engine/process-termination.ts SHA256 47199969a22d1415bee97247400c9dfaf33ea843a41e5b68d13646febda59ed9
1: import type { ChildProcess } from 'node:child_process';
2: import { captureLinuxProcessGroup, waitForLinuxGroupExit } from './linux-process-group.ts';
3: 
4: /** A termination request completes only after kernel exit acknowledgement. */
5: export class ProcessTermination {
6:   readonly #child: ChildProcess;
7:   readonly failure: Promise<never>;
8:   #reject!: (error: Error) => void;
9:   #outerGroup: number | undefined;
10:   #timer: ReturnType<typeof setTimeout> | undefined;
11:   cleanup: Promise<void> | undefined;
12:   reason: string | undefined;
13:   error: Error | undefined;
14: 
15:   constructor(child: ChildProcess) {
16:     this.#child = child;
17:     this.failure = new Promise<never>((_resolve, reject) => { this.#reject = reject; });
18:   }
19: 
20:   capture(): void {
21:     if (process.platform !== 'linux' || !this.#child.pid) return;
22:     try { this.#outerGroup = captureLinuxProcessGroup(this.#child.pid); }
23:     catch (error) { this.error = error as Error; this.stop('process group inspection failed'); }
24:   }
25: 
26:   #kill(signal: NodeJS.Signals): void {
27:     try {
28:       if (this.#child.pid && process.platform !== 'win32') process.kill(-this.#child.pid, signal);
29:       else this.#child.kill(signal);
30:     } catch (error) {
31:       if ((error as NodeJS.ErrnoException).code !== 'ESRCH') this.error = error as Error;
32:     }
33:   }
34: 
35:   stop(reason: string): void {
36:     if (this.reason) return;
37:     this.reason = reason;
38:     const deadline = Date.now() + 1500;
39:     this.#timer = setTimeout(() => this.#reject(Object.assign(new Error('LINT_PROCESS_CLEANUP_FAILED'), { code: 'LINT_PROCESS_CLEANUP_FAILED' })), 1500);
40:     this.#kill('SIGTERM');
41:     // Keep escalation after leader close: descendants may close inherited FDs.
42:     this.cleanup = new Promise<void>((resolve) => setTimeout(resolve, 250)).then(async () => {
43:       this.#kill('SIGKILL');
44:       if (process.platform === 'linux' && this.#child.pid) {
45:         if (this.#outerGroup === undefined) {
46:           // A very short-lived leader/group can exit before initial capture.
47:           this.#outerGroup = captureLinuxProcessGroup(this.#child.pid);
48:         }
49:         if (this.#outerGroup !== undefined) await waitForLinuxGroupExit(this.#outerGroup, deadline);
50:       }
51:     });
52:     // Observe failure immediately even if the leader still owns inherited FDs.
53:     this.cleanup.catch((error: Error) => this.#reject(error));
54:   }
55: 
56:   async finish(closed: Promise<number | null>): Promise<number | null> {
57:     try {
58:       const status = await Promise.race([closed, this.failure]);
59:       await Promise.race([this.cleanup, this.failure]);
60:       return status;
61:     } finally { clearTimeout(this.#timer); }
62:   }
63: }
