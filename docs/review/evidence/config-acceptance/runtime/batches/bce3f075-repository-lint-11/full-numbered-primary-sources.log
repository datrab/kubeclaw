10: registerTool({
11:   id: 'mypy',
12:   name: 'mypy (Python Types)',
13:   binary: 'mypy',
14:   tier: 'full',
15:   detect: (ctx: any) => ctx.projectTypes.has('python'),
16:   run: async (ctx: any) => {
17:     const target = ctx.modulePath ? path.join(ctx.repoRoot, ctx.modulePath) : ctx.repoRoot;
18:     const args = ['--output', 'json', '--no-color-output', target];
19: 
20:     if (ctx.changedFilesRequested) {
21:       const pyFiles = ctx.changedFiles.filter((f: any) => f.endsWith('.py'));
22:       if (pyFiles.length === 0) return { errors: 0, warnings: 0, findings: [] };
23:       args.length = 0;
24:       args.push('--output', 'json', '--no-color-output', ...pyFiles.map((f: any) => path.join(ctx.repoRoot, f)));
25:     }
26: 
27:     const result = requireToolExecution(await safeExec('mypy', args, { signal: ctx.signal, cwd: ctx.repoRoot, timeout: ctx.tool.timeout_ms }), 'mypy');
28: 
29:     // mypy JSON output: one JSON object per line
30:     const findings: any[] = [];
31:     let parseFailure = null;
32:     const lines = textValue(result.stdout).split('\n').filter(Boolean);
33:     for (const line of lines) {
34:       const parsed = tryParseJson(line);
35:       if (!parsed.ok) {
36:         if (!parseFailure) parseFailure = { parsed, line };
37:         continue;
38:       }
39:       const item = parsed.data;
40:       findings.push({
41:         file: item.file,
42:         line: item.line,
43:         column: item.column,
44:         severity: item.severity === 'error' ? 'error' : 'warning',
45:         code: selectTruthyValue(() => (item.code), () => ('mypy')),
46:         message: item.message,
47:       });
48:     }
49: 
50:     if (parseFailure) {
51:       return failParse(ctx, 'mypy', parseFailure.parsed, result, target);
52:     }
53:     if (findings.length === 0 && result.exitCode !== 0) {
54:       return failParse(ctx, 'mypy', { error: 'non-zero exit without JSON findings' }, result, target);
55:     }
56: 
57:     return {
58:       errors: findings.filter((f: any) => f.severity === 'error').length,
59:       warnings: findings.filter((f: any) => f.severity === 'warning').length,
