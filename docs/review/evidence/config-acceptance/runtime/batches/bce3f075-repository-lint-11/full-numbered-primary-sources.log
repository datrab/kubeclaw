4: 
5: const DIRECTORY = fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW;
6: function forbidden(cause?: unknown): Error { return new Error('REPOSITORY_PATH_FORBIDDEN', { cause }); }
7: function inside(candidate: string, root: string): boolean { return candidate === root || candidate.startsWith(`${root}${path.sep}`); }
8: function canonicalFile(root: string, relative: string): string {
9:   if (fs.lstatSync(root).isSymbolicLink() || fs.realpathSync(root) !== root) throw forbidden();
10:   let current = root;
11:   for (const component of repositoryRelativePath(relative).split('/')) {
12:     current = path.join(current, component);
13:     let stat: fs.Stats;
14:     try { stat = fs.lstatSync(current); }
15:     catch (error) {
16:       if ((error as NodeJS.ErrnoException).code === 'ENOENT') throw new Error('REPOSITORY_FILE_NOT_FOUND', { cause: error });
17:       throw error;
18:     }
19:     try { current = fs.realpathSync(current); }
20:     catch (error) {
21:       if (stat.isSymbolicLink()) throw forbidden(error);
22:       throw error;
23:     }
24:     if (!inside(current, root)) throw forbidden();
25:   }
26:   return current;
27: }
28: function openDirectory(root: string): number {
29:   let descriptor = fs.openSync(path.parse(root).root, DIRECTORY);
30:   try {
31:     for (const component of root.split(path.sep).filter(Boolean)) {
32:       const next = fs.openSync(`/proc/self/fd/${descriptor}/${component}`, DIRECTORY);
33:       fs.closeSync(descriptor); descriptor = next;
34:     }
35:     return descriptor;
36:   } catch (error) { fs.closeSync(descriptor); throw forbidden(error); }
37: }
38: export function readRepositoryFile(root: string, relative: string, maximum: number): { content: string; sizeBytes: number; path: string } {
39:   // Resolve allowed internal links, then open the resolved path with no-follow
40:   // descriptors so a later directory-to-symlink swap cannot redirect the read.
41:   const canonical = canonicalFile(root, relative);
42:   const components = path.relative(root, canonical).split(path.sep);
43:   let directory = openDirectory(root);
44:   let descriptor: number | undefined;
45:   try {
46:     for (const component of components.slice(0, -1)) {
47:       const next = fs.openSync(`/proc/self/fd/${directory}/${component}`, DIRECTORY);
48:       fs.closeSync(directory); directory = next;
49:     }
50:     descriptor = fs.openSync(`/proc/self/fd/${directory}/${components.at(-1)}`, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
51:     const stat = fs.fstatSync(descriptor);
52:     if (!stat.isFile()) throw new Error('REPOSITORY_NOT_A_FILE');
53:     if (stat.size > maximum) throw new Error(`REPOSITORY_FILE_TOO_LARGE:${stat.size}:${maximum}`);
54:     const bytes = Buffer.alloc(stat.size);
55:     const count = fs.readSync(descriptor, bytes, 0, bytes.length, 0);
56:     if (count !== stat.size || fs.fstatSync(descriptor).size !== stat.size) throw new Error('REPOSITORY_FILE_CHANGED_DURING_READ');
57:     const content = bytes.toString('utf8');
58:     return { content, sizeBytes: Buffer.byteLength(content), path: repositoryRelativePath(relative) };
59:   } catch (error) {
60:     if (['ELOOP', 'ENOTDIR'].includes((error as NodeJS.ErrnoException).code ?? '')) throw forbidden(error);
61:     throw error;
62:   } finally { if (descriptor !== undefined) fs.closeSync(descriptor); fs.closeSync(directory); }
63: }
