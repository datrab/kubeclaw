3: import { requireToolExecution, safeExec } from './execution.ts';
4: 
5: export interface EvidenceFilePartition {
6:   readonly production: readonly string[];
7:   readonly tests: readonly string[];
8:   readonly generatedOrUntracked: readonly string[];
9: }
10: 
11: function repositoryRelative(repositoryRoot: string, file: string): string {
12:   return path.relative(repositoryRoot, file).split(path.sep).join('/');
13: }
14: 
15: function isGenerated(file: string): boolean {
16:   return /(^|\/)generated(\/|$)/u.test(file);
17: }
18: 
19: function isTestOrFixture(file: string): boolean {
20:   return /(^|\/)(?:test|tests|__tests__|fixtures)(\/|$)/u.test(file)
21:     || /\.(?:test|spec)\.[^/]+$/u.test(file);
22: }
23: 
24: async function trackedFiles(repositoryRoot: string, signal?: AbortSignal): Promise<ReadonlySet<string>> {
25:   const result = requireToolExecution(await safeExec(
26:     'git', ['ls-files', '--cached', '-z'], { cwd: repositoryRoot, signal },
27:   ), 'eslint-type-evidence-source-classification');
28:   if (result.exitCode !== 0) {
29:     throw Object.assign(new Error('Git could not enumerate tracked files for the type-evidence partition.'), {
30:       code: 'eslint-type-evidence-source-classification-failed',
31:     });
32:   }
33:   return new Set(result.stdout.split('\0').filter(Boolean));
34: }
35: 
36: export async function partitionEvidenceFiles(
37:   repositoryRoot: string,
38:   files: readonly string[],
39:   signal?: AbortSignal,
40: ): Promise<EvidenceFilePartition> {
41:   const tracked = await trackedFiles(repositoryRoot, signal);
42:   const production: string[] = [];
43:   const tests: string[] = [];
44:   const generatedOrUntracked: string[] = [];
45: 
46:   for (const file of files) {
47:     const relative = repositoryRelative(repositoryRoot, file);
48:     if (!tracked.has(relative) || isGenerated(relative)) generatedOrUntracked.push(file);
49:     else if (isTestOrFixture(relative)) tests.push(file);
50:     else production.push(file);
51:   }
52: 
53:   return Object.freeze({
54:     production: Object.freeze(production),
55:     tests: Object.freeze(tests),
56:     generatedOrUntracked: Object.freeze(generatedOrUntracked),
57:   });
58: }
