32: function metadataLines(document: any) {
33:   const metadataIndex = document.findIndex((line: any) => /^metadata:\s*$/.test(line));
34:   if (metadataIndex < 0) return [];
35:   const lines: any[] = [];
36:   for (const line of document.slice(metadataIndex + 1)) {
37:     if (line.trim() && !/^\s/.test(line)) break;
38:     lines.push(line);
39:   }
40:   return lines;
