125: function validateTool(input: unknown, field: string, policyDir: string): Record<string, any> {
126:   const tool = record(input, field);
127:   const id = text(tool.id, `${field}.id`);
128:   const languages = stringList(tool.languages, `${field}.languages`);
129:   for (const language of languages) if (!LANGUAGES.has(language)) fail(`${field}.languages`, `unknown language '${language}'`);
130:   if (typeof tool.required !== 'boolean') fail(`${field}.required`, 'required boolean');
131:   if (!Number.isSafeInteger(tool.timeout_ms) || tool.timeout_ms < 1) fail(`${field}.timeout_ms`, 'required positive integer');
132:   if (!CATEGORIES.has(tool.category)) fail(`${field}.category`, 'unknown category');
133:   if (!SCOPES.has(tool.scope)) fail(`${field}.scope`, 'unknown scope');
134:   if (!TIERS.has(tool.tier)) fail(`${field}.tier`, 'unknown tier');
135:   if (!SEVERITIES.has(tool.blocking_severity)) fail(`${field}.blocking_severity`, 'unknown severity');
136:   const configPath = tool.config_path === null || tool.config_path === undefined
137:     ? null
138:     : path.resolve(policyDir, text(tool.config_path, `${field}.config_path`));
139:   const configuredTargets = stringList(tool.targets, `${field}.targets`)
140:     .map((entry: any, index: any) => repoRelative(entry, `${field}.targets[${index}]`));
141:   return {
142:     id,
143:     required: tool.required,
144:     category: tool.category,
145:     scope: tool.scope,
146:     tier: tool.tier,
147:     timeout_ms: tool.timeout_ms,
148:     blocking_severity: tool.blocking_severity,
149:     languages,
150:     config_path: configPath,
151:     arguments: tool.arguments === undefined ? [] : stringList(tool.arguments, `${field}.arguments`),
152:     configured_targets: configuredTargets,
153:     targets: id === 'semgrep' && configuredTargets.length === 0 ? ['.'] : configuredTargets,
154:     include: stringList(tool.include, `${field}.include`),
155:     exclude: stringList(tool.exclude, `${field}.exclude`),
156:   };
