14: type DependencyGraph = Map<string, Set<string>>;
15: type ComponentState = {
16:   graph: DependencyGraph;
17:   nextIndex: number;
18:   indexes: Map<string, number>;
19:   lowLinks: Map<string, number>;
20:   stack: string[];
21:   onStack: Set<string>;
22:   components: string[][];
23: };
24: 
25: function dependencyGraph(modules: any[]): DependencyGraph {
26:   const graph: DependencyGraph = new Map();
27:   for (const module of modules) {
28:     if (typeof module.source !== 'string') continue;
29:     if (!graph.has(module.source)) graph.set(module.source, new Set());
30:     for (const dependency of Array.isArray(module.dependencies) ? module.dependencies : []) {
31:       if (typeof dependency.resolved !== 'string') continue;
32:       if (dependency.coreModule) continue;
33:       if (dependency.couldNotResolve) continue;
34:       graph.get(module.source)!.add(dependency.resolved);
35:       if (!graph.has(dependency.resolved)) graph.set(dependency.resolved, new Set());
36:     }
37:   }
38:   return graph;
39: }
40: 
41: function collectCompletedComponent(state: ComponentState, node: string): void {
42:   const component: string[] = [];
43:   while (state.stack.length > 0) {
44:     const member = state.stack.pop();
45:     if (member === undefined) throw new Error('Circular dependency component stack was unexpectedly empty.');
46:     state.onStack.delete(member);
47:     component.push(member);
48:     if (member === node) break;
49:   }
50:   component.sort();
51:   const selfCycle = state.graph.get(node)?.has(node) === true;
52:   if (component.length > 1 || selfCycle) state.components.push(component);
53: }
54: 
55: function visitDependencyNode(state: ComponentState, node: string): void {
56:   state.indexes.set(node, state.nextIndex);
57:   state.lowLinks.set(node, state.nextIndex);
58:   state.nextIndex += 1;
59:   state.stack.push(node);
60:   state.onStack.add(node);
61: 
62:   for (const dependency of [...(state.graph.get(node) ?? [])].sort()) {
63:     if (!state.indexes.has(dependency)) {
64:       visitDependencyNode(state, dependency);
65:       state.lowLinks.set(node, Math.min(state.lowLinks.get(node)!, state.lowLinks.get(dependency)!));
66:     } else if (state.onStack.has(dependency)) {
67:       state.lowLinks.set(node, Math.min(state.lowLinks.get(node)!, state.indexes.get(dependency)!));
68:     }
69:   }
70:   if (state.lowLinks.get(node) === state.indexes.get(node)) collectCompletedComponent(state, node);
71: }
72: 
73: function stronglyConnectedComponents(modules: any[]): string[][] {
74:   const graph = dependencyGraph(modules);
75:   const state: ComponentState = {
76:     graph,
77:     nextIndex: 0,
78:     indexes: new Map(),
79:     lowLinks: new Map(),
80:     stack: [],
81:     onStack: new Set(),
82:     components: [],
83:   };
84: 
85:   for (const node of [...graph.keys()].sort()) {
86:     if (!state.indexes.has(node)) visitDependencyNode(state, node);
87:   }
88:   return state.components.sort((left: any, right: any) => left[0]!.localeCompare(right[0]!));
89: }
