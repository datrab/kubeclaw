19: function indexes(resources: AnyRecord[]) {
20:   const secrets = new Map<string, Set<string>>();
21:   const configMaps = new Map<string, Set<string>>();
22:   const serviceAccounts = new Map<string, string[]>();
23:   for (const resource of resources) {
24:     const namespace = resource.value.metadata?.namespace || 'default';
25:     const name = resource.value.metadata?.name;
26:     if (!name) continue;
27:     const key = `${namespace}/${name}`;
28:     if (resource.value.kind === 'Secret') secrets.set(key, new Set([...Object.keys(resource.value.data || {}), ...Object.keys(resource.value.stringData || {})]));
29:     if (resource.value.kind === 'ConfigMap') configMaps.set(key, new Set(Object.keys(resource.value.data || {})));
30:     if (resource.value.kind === 'ServiceAccount') serviceAccounts.set(key, (resource.value.imagePullSecrets || []).map((entry: AnyRecord) => entry?.name).filter(Boolean));
31:   }
32:   return { secrets, configMaps, serviceAccounts };
33: }
34: 
35: function availableEnvironment(container: AnyRecord, namespace: string, lookup: AnyRecord): { names: Set<string>; unresolved: string[] } {
36:   const names = new Set<string>((container.env || []).map((entry: AnyRecord) => entry?.name).filter((name: unknown): name is string => typeof name === 'string' && name.length > 0));
37:   const unresolved: string[] = [];
38:   for (const source of container.envFrom || []) {
39:     const secret = source?.secretRef?.name;
40:     const configMap = source?.configMapRef?.name;
41:     const values = secret ? lookup.secrets.get(`${namespace}/${secret}`) : configMap ? lookup.configMaps.get(`${namespace}/${configMap}`) : null;
42:     if (values) for (const name of values) names.add(`${source.prefix || ''}${name}`);
43:     else unresolved.push(secret ? `Secret/${secret}` : configMap ? `ConfigMap/${configMap}` : 'unknown envFrom source');
44:   }
45:   return { names, unresolved };
46: }
47: 
48: function pullSecrets(pod: AnyRecord, namespace: string, lookup: AnyRecord): string[] {
49:   const direct = (pod.imagePullSecrets || []).map((entry: AnyRecord) => entry?.name).filter(Boolean);
50:   const serviceAccount = pod.serviceAccountName || 'default';
51:   return [...new Set([...direct, ...(lookup.serviceAccounts.get(`${namespace}/${serviceAccount}`) || [])])];
52: }
53: 
54: function environmentRule(ctx: AnyRecord): AnyRecord[] {
55:   const { resource, rule, lookup, pod, namespace, group, container, keys, label } = ctx;
56:   const results: AnyRecord[] = [];
57:       const environment = availableEnvironment(container, namespace, lookup);
58:       for (const name of rule.parameters.names) if (!environment.names.has(name)) results.push(finding(resource, rule, `${label} does not declare required environment variable ${name}${environment.unresolved.length ? `; unresolved envFrom: ${environment.unresolved.join(', ')}` : ''}.`, keys));
59: 
60:   return results;
61: }
