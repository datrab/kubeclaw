58: export function validatePolicyTargetPaths(repoRoot: string, policy: Record<string, any>, project: Record<string, any>): void {
59:   const projectRoot = requireRepositoryPath(repoRoot, path.resolve(repoRoot, project.root));
60:   for (const module of project.go.modules) {
61:     const absolute = requireRepositoryPath(repoRoot, path.resolve(projectRoot, module.mod_file));
62:     if (!fs.existsSync(absolute)) fail('policy project go module', `does not exist: ${module.mod_file}`);
63:   }
64:   for (const root of project.terraform.roots) {
65:     const absolute = requireRepositoryPath(repoRoot, path.resolve(projectRoot, root));
66:     if (!fs.existsSync(absolute)) fail('policy project terraform root', `does not exist: ${root}`);
67:   }
68:   validateKubernetesPaths(projectRoot, project);
69:   validateToolTargets(repoRoot, projectRoot, policy);
70:   for (const layer of policy.architecture.layers) {
71:     for (const root of layer.roots) {
72:       if (!fs.existsSync(requireRepositoryPath(repoRoot, path.resolve(projectRoot, root)))) fail(`policy.architecture.layers.${layer.id}.roots`, `does not exist: ${root}`);
73:     }
74:   }
75: }
