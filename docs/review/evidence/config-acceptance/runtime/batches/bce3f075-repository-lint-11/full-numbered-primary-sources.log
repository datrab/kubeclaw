193: function languageAuthority(tool: Record<string, any>, goTargets: string[], terraformTargets: string[]): string[] | null {
194:   if (tool.languages.length !== 1) return null;
195:   if (tool.languages[0] === 'go') return goTargets;
196:   if (tool.languages[0] === 'terraform') return terraformTargets;
197:   return null;
