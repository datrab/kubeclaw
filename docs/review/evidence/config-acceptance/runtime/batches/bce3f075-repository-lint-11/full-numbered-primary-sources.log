16: function validateRawManifests(projectRoot: string, project: Record<string, any>): void {
17:   const realProjectRoot = fs.realpathSync(projectRoot);
18:   for (const manifest of project.kubernetes.raw_manifests) {
19:     const absolute = path.resolve(projectRoot, manifest);
20:     const relative = path.relative(projectRoot, absolute);
21:     if (relative.startsWith('..') || path.isAbsolute(relative)) fail('policy project kubernetes raw manifest', `escapes project root: ${manifest}`);
22:     if (!fs.existsSync(absolute) || !fs.statSync(absolute).isFile()) fail('policy project kubernetes raw manifest', `does not exist: ${manifest}`);
23:     const real = fs.realpathSync(absolute);
24:     const realRelative = path.relative(realProjectRoot, real);
25:     if (realRelative.startsWith('..') || path.isAbsolute(realRelative)) fail('policy project kubernetes raw manifest', `symlink escapes project root: ${manifest}`);
26:     if (fs.statSync(absolute).size > project.kubernetes.limits.max_file_bytes) fail('policy project kubernetes raw manifest', `exceeds max_file_bytes: ${manifest}`);
27:   }
28: }
