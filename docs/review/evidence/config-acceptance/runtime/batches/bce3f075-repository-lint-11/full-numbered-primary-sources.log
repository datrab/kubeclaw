199: async function runEslint(ctx: any): Promise<Record<string, any>> {
200:   const target = ctx.modulePath ? path.join(ctx.repoRoot, ctx.modulePath) : ctx.repoRoot;
201:   const args = ['--format', 'json', '--no-error-on-unmatched-pattern', '--no-warn-ignored'];
202: 
203:   // The caller owns one exact ESLint config path. Missing config is an execution failure.
204:   const config = ctx.tool.config_path;
205:   if (!config || !fs.existsSync(config)) {
206:     failConfigMissing('eslint-config-missing', `Configured ESLint config does not exist: ${config || '<missing --eslint-config>'}`);
207:   }
208:   log('INFO', `ESLint using config: ${config}`);
209:   args.push('--config', config);
210: 
211:   const files = await eslintTargetFiles(ctx);
212:   if (files.length === 0) return EMPTY_ESLINT_RESULT;
213:   args.push(...files);
214: 
215:   const result = requireToolExecution(await safeExec('eslint', args, { signal: ctx.signal, cwd: ctx.repoRoot, timeout: ctx.tool.timeout_ms }), ctx.tool.id);
216:   const parsed = tryParseJson(result.stdout);
217:   if (!parsed.ok) return failParse(ctx, ctx.tool.id, parsed, result, target);
218:   const reports = arrayValue(parsed.data);
219:   log('INFO', `${ctx.tool.name}: ${reports.length} files scanned`);
220:   const findings = normalizeEslintFindings(ctx, reports);
221: 
222:   return {
223:     errors: findings.filter((f: any) => f.severity === 'error').length,
224:     warnings: findings.filter((f: any) => f.severity === 'warning').length,
225:     findings,
226:   };
227: }
