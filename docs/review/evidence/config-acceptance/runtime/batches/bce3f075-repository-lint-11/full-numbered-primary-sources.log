87: function validateLanguageEvidence(project: Record<string, any>, field: string, languages: string[]): Record<string, string[]> {
88:   const rawEvidence = record(project.language_evidence, `${field}.language_evidence`);
89:   const languageEvidence: Record<string, string[]> = {};
90:   for (const language of languages) {
91:     languageEvidence[language] = stringList(rawEvidence[language], `${field}.language_evidence.${language}`, { nonEmpty: true })
92:       .map((entry: any, index: any) => repoRelative(entry, `${field}.language_evidence.${language}[${index}]`));
93:   }
94:   for (const language of Object.keys(rawEvidence)) if (!languages.includes(language)) fail(`${field}.language_evidence.${language}`, 'language is not enabled for this project');
95:   return languageEvidence;
96: }
