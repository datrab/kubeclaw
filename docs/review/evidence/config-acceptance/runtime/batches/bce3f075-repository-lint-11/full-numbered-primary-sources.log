159: function validateArchitecture(input: unknown): Record<string, any> {
160:   const architecture = record(input, 'policy.architecture');
161:   if (!Array.isArray(architecture.layers) || architecture.layers.length === 0) fail('policy.architecture.layers', 'required non-empty array');
162:   const layers = architecture.layers.map((entry: any, index: any) => {
163:     const field = `policy.architecture.layers[${index}]`;
164:     const layer = record(entry, field);
165:     return {
166:       id: text(layer.id, `${field}.id`),
167:       roots: stringList(layer.roots, `${field}.roots`, { nonEmpty: true }).map((root: any, rootIndex: any) => repoRelative(root, `${field}.roots[${rootIndex}]`)),
168:       may_depend_on: stringList(layer.may_depend_on, `${field}.may_depend_on`),
169:     };
170:   });
171:   const ids = layers.map((layer: any) => layer.id);
172:   if (new Set(ids).size !== ids.length) fail('policy.architecture.layers', 'duplicate layer ids are not allowed');
173:   const known = new Set(ids);
174:   for (const layer of layers) for (const target of layer.may_depend_on) if (!known.has(target)) fail(`policy.architecture.layers.${layer.id}.may_depend_on`, `unknown layer '${target}'`);
