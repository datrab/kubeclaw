37: function buildSubprocessEnv(overrides: Record<string, unknown> = {}): Record<string, string> {
38:   const env: Record<string, string> = {};
39:   for (const key of SUBPROCESS_ENV_KEYS) {
40:     const value = process.env[key];
41:     if (value !== undefined) env[key] = value;
42:   }
43:   for (const [key, value] of Object.entries(overrides)) {
44:     if (!SUBPROCESS_ENV_KEYS.includes(key as typeof SUBPROCESS_ENV_KEYS[number])) {
45:       throw new Error(`lint subprocess env key is not allowlisted: ${key}`);
46:     }
47:     if (value === undefined || value === null) delete env[key];
48:     else env[key] = String(value);
49:   }
50:   return env;
51: }
52: const LINT_CACHE_ROOT = path.join(os.tmpdir(), 'kubeclaw-lint-cache');
53: // Every value in this map must be a directory. File-valued settings such as
54: // SEMGREP_LOG_FILE remain invocation-specific and are never created here.
55: const LINT_TOOL_CACHE_ENV = Object.freeze({
56:   GOCACHE: path.join(LINT_CACHE_ROOT, 'go-build'),
57:   GOMODCACHE: path.join(LINT_CACHE_ROOT, 'go-mod'),
58:   STATICCHECK_CACHE: path.join(LINT_CACHE_ROOT, 'staticcheck'),
59:   TRIVY_CACHE_DIR: path.join(LINT_CACHE_ROOT, 'trivy'),
60:   XDG_CACHE_HOME: path.join(LINT_CACHE_ROOT, 'xdg'),
61:   XDG_CONFIG_HOME: path.join(LINT_CACHE_ROOT, 'xdg-config'),
62: });
63: 
64: function ensureLintToolRuntimeDirectories(): void {
65:   for (const directory of Object.values(LINT_TOOL_CACHE_ENV)) {
66:     fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
67:   }
68: }
69: /** Native failures are returned; cancellation rejects the owning invocation. */
70: async function safeExec(cmd: string, args: string[], opts: any = {}) {
71:   ensureLintToolRuntimeDirectories();
72:   return runProcess(cmd, args, {
73:     timeout: opts.timeout ?? DEFAULT_TOOL_TIMEOUT,
74:     cwd: opts.cwd, signal: opts.signal, input: opts.input,
75:     env: buildSubprocessEnv({ ...LINT_TOOL_CACHE_ENV, ...opts.env }),
76:   });
77: }
