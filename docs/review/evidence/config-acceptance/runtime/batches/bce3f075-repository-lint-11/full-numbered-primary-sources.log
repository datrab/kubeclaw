175: function validateReportScope(value: AnyRecord, expected: AnyRecord): AnyRecord {
176:   for (const field of ['project', 'scope', 'timestamp', 'tier']) requireString(value[field], `report.${field}`);
177:   validateExpectedScope(value, expected);
178:   const visibility = requireRecord(value.visibility, 'report.visibility');
179:   for (const field of ['debt', 'experimental']) if (typeof visibility[field] !== 'boolean') fail(`report.visibility.${field}`, 'required boolean');
180:   if (expected.visibility !== undefined && JSON.stringify(visibility) !== JSON.stringify(expected.visibility)) fail('report.visibility', 'does not match requested visibility');
181:   validateReportLists(value, expected);
182:   return visibility;
183: }
184: 
185: function validateExpectedScope(value: AnyRecord, expected: AnyRecord): void {
186:   if (expected.tier !== undefined && value.tier !== expected.tier) fail('report.tier', `expected requested tier ${expected.tier}`);
187:   if (expected.scope !== undefined && value.scope !== expected.scope) fail('report.scope', `expected requested scope ${expected.scope}`);
188: }
189: 
190: function validateReportLists(value: AnyRecord, expected: AnyRecord): void {
191:   if (!Array.isArray(value.changed_files)) fail('report.changed_files', 'required array');
192:   value.changed_files.forEach((file: any, index: any) => requireString(file, `report.changed_files[${index}]`));
193:   if (expected.changedFiles !== undefined && JSON.stringify(value.changed_files) !== JSON.stringify(expected.changedFiles)) fail('report.changed_files', 'does not match requested changed-file scope');
194:   if (!Array.isArray(value.detected_types)) fail('report.detected_types', 'required array');
195:   if (!Array.isArray(value.diagnostics)) fail('report.diagnostics', 'required array');
196: }
197: 
198: function validateToolInventory(tools: AnyRecord, expectedIds: unknown): void {
199:   if (expectedIds === undefined) return;
200:   const actual = Object.keys(tools).sort();
201:   const expected = [...expectedIds as string[]].sort();
202:   if (JSON.stringify(actual) !== JSON.stringify(expected)) fail('report.tools', `expected exact tool inventory: ${expected.join(', ') || '<empty>'}`);
203: }
204: 
205: function reportSummary(tools: AnyRecord, expected: AnyRecord, visibility: AnyRecord): AnyRecord {
206:   const summary = createToolSummary();
207:   for (const [toolId, result] of Object.entries(tools)) {
208:     requireString(toolId, 'report.tools key');
209:     validateToolResult(result, `report.tools.${toolId}`, expected.toolPolicies || {}, visibility);
210:     accumulateToolSummary(summary, result);
211:   }
212:   return summary;
213: }
214: 
215: function validateSummary(value: unknown, expected: AnyRecord): void {
216:   const summary = requireRecord(value, 'report.summary');
217:   for (const [field, count] of Object.entries(expected)) {
218:     requireCount(summary[field], `report.summary.${field}`);
219:     if (summary[field] !== count) fail(`report.summary.${field}`, `expected ${count} from tool results`);
220:   }
221: }
222: 
223: function validateLintReport(report: unknown, expected: AnyRecord = {}): AnyRecord {
224:   const value = requireRecord(report, 'report');
225:   if (value.schema_version !== LINT_REPORT_SCHEMA_VERSION) fail('report.schema_version', `expected ${LINT_REPORT_SCHEMA_VERSION}`);
226:   validatePolicyEvidence(value, expected);
227:   const visibility = validateReportScope(value, expected);
228:   const tools = requireRecord(value.tools, 'report.tools');
229:   validateToolInventory(tools, expected.toolIds);
230:   validateSummary(value.summary, reportSummary(tools, expected, visibility));
231:   return value;
232: }
