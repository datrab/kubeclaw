205: function validateLanguageAuthorities(projects: Record<string, any>[], tools: Record<string, any>[]): void {
206:   const activeLanguages = new Set(projects.flatMap((project: any) => project.languages));
207:   const goTargets = [...new Set(projects.flatMap((project: any) => project.go.modules.map((module: Record<string, any>) => path.posix.dirname(module.mod_file))))].sort();
208:   const goPackages = [...new Set(projects.flatMap((project: any) => project.go.modules.flatMap((module: Record<string, any>) => module.packages)))].sort();
209:   const terraformTargets = [...new Set(projects.flatMap((project: any) => project.terraform.roots))].sort();
210:   for (const tool of tools) {
211:     const applicable = tool.languages.length === 0 || tool.languages.some((language: string) => activeLanguages.has(language));
212:     if (applicable && tool.targets.length === 0) fail(`policy.tools.${tool.id}.targets`, 'required non-empty array for an applicable tool');
213:     const authority = languageAuthority(tool, goTargets, terraformTargets);
214:     if (authority && JSON.stringify([...tool.targets].sort()) !== JSON.stringify(authority)) fail(`policy.tools.${tool.id}.targets`, `must match canonical ${tool.languages[0]} roots: ${authority.join(', ') || '<none>'}`);
215:     validateGoArguments(tool, goPackages);
216:   }
217: }
