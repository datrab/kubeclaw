162: /**
163:  * Find files matching a predicate, with max depth.
164:  * Lightweight alternative to glob — no dependencies.
165:  */
166: function findFiles(dir: any, predicate: any, maxDepth: any = 3, _depth: any = 0) {
167:   if (_depth > maxDepth) return [];
168:   if (!fs.existsSync(dir)) return [];
169:   const results: any[] = [];
170: 
171:   let entries;
172:   try { entries = fs.readdirSync(dir, { withFileTypes: true }); }
173:   catch (error: any) {
174:     recordDiscoveryDiagnostic({
175:       status: 'unavailable',
176:       path: dir,
177:       reason: selectTruthyValue(() => (error?.message), () => ('missing_error_message')),
178:     });
179:     return [];
180:   }
181: 
182:   for (const entry of entries) {
183:     if ([entry.name.startsWith('.'), entry.name === 'node_modules'].some(Boolean)) continue;
184:     const fullPath = path.join(dir, entry.name);
185:     if (entry.isFile() && predicate(entry.name)) {
186:       results.push(fullPath);
187:     } else if (entry.isDirectory()) {
188:       results.push(...findFiles(fullPath, predicate, maxDepth, _depth + 1));
189:     }
190:   }
191:   return results;
192: }
