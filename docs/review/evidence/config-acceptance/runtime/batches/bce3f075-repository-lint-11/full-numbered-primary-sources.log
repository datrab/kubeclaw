194: /**
195:  * Resolve the effective file scope for linting.
196:  * Priority: --changed-files > --module-path > full repo.
197:  *
198:  * @param {object} ctx - Run context
199:  * @returns {string[]} List of files to scope lint to, or empty for full scope
200:  */
201: function resolveScope(ctx: any) {
202:   if (ctx.changedFiles && ctx.changedFiles.length > 0) {
203:     // Verify files exist (forge_diff_stat may reference files that were deleted)
204:     const existing = ctx.changedFiles.filter((f: any) => {
205:       const abs = path.isAbsolute(f) ? f : path.join(ctx.repoRoot, f);
206:       requireRepositoryPath(ctx.repoRoot, abs);
207:       return fs.existsSync(abs);
208:     });
209:     log('INFO', `Scope: ${existing.length} changed files (${ctx.changedFiles.length} requested)`);
210:     return existing;
211:   }
212: 
213:   if (ctx.modulePath) {
214:     log('INFO', `Scope: module path ${ctx.modulePath}`);
215:     return []; // Tools will use modulePath as cwd/target
216:   }
217: 
218:   log('INFO', 'Scope: full repo');
219:   return [];
220: }
