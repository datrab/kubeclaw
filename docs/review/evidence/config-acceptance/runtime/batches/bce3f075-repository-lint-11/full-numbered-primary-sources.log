4: function inside(root: string, candidate: string): boolean {
5:   const relative = path.relative(root, candidate);
6:   return relative !== '..' && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative);
7: }
8: 
9: // Deleted files are legal scope inputs. Canonicalize their closest existing
10: // ancestor so a missing leaf cannot conceal an escaping parent symlink.
11: function canonicalPath(candidate: string): string {
12:   try {
13:     fs.lstatSync(candidate);
14:   } catch (error) {
15:     if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
16:     const parent = path.dirname(candidate);
17:     if (parent === candidate) throw error;
18:     return path.join(canonicalPath(parent), path.basename(candidate));
19:   }
20:   return fs.realpathSync(candidate);
21: }
22: 
23: export function requireRepositoryPath(root: string, candidate: string): string {
24:   const canonicalRoot = fs.realpathSync(root);
25:   const absolute = path.resolve(candidate);
26:   const canonical = canonicalPath(absolute);
27:   if ((!inside(path.resolve(root), absolute) && !inside(canonicalRoot, absolute)) || !inside(canonicalRoot, canonical)) {
28:     throw Object.assign(new Error(`LINT_REPOSITORY_PATH_DENIED:${absolute}`), { code: 'LINT_REPOSITORY_PATH_DENIED' });
29:   }
30:   return absolute;
31: }
32: 
33: /** Inspect native recursive targets too, including symlink entries discovery skips. */
34: export function requireRepositoryTree(root: string, target: string, excluded: (file: string) => boolean, visited = new Set<string>()): void {
35:   requireRepositoryPath(root, target);
36:   if (!fs.existsSync(target)) return;
37:   const canonical = fs.realpathSync(target);
38:   if (visited.has(canonical)) return;
39:   visited.add(canonical);
40:   if (!fs.statSync(target).isDirectory()) return;
41:   for (const entry of fs.readdirSync(target, { withFileTypes: true })) {
42:     const child = path.join(target, entry.name);
43:     if (!excluded(child)) requireRepositoryTree(root, child, excluded, visited);
44:   }
45: }
