30: function validateHelmCharts(projectRoot: string, project: Record<string, any>): void {
31:   const realProjectRoot = fs.realpathSync(projectRoot);
32:   for (const chart of project.kubernetes.helm_charts) {
33:     const absolute = path.resolve(projectRoot, chart);
34:     const relative = path.relative(projectRoot, absolute);
35:     if (relative.startsWith('..') || path.isAbsolute(relative)) fail('policy project kubernetes Helm chart', `escapes project root: ${chart}`);
36:     if (!fs.existsSync(path.join(absolute, 'Chart.yaml'))) fail('policy project kubernetes Helm chart', `Chart.yaml does not exist: ${chart}`);
37:     const real = fs.realpathSync(absolute);
38:     const realRelative = path.relative(realProjectRoot, real);
39:     if (realRelative.startsWith('..') || path.isAbsolute(realRelative)) fail('policy project kubernetes Helm chart', `symlink escapes project root: ${chart}`);
