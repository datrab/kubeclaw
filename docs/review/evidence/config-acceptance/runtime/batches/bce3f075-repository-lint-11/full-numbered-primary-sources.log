242: async function executeJscpd(ctx: any, configPath: any, targets: any, label: any) {
243:   const outputDir = fs.mkdtempSync(path.join(os.tmpdir(), `kubeclaw-jscpd-${label}-`));
244:   try {
245:     const result = requireToolExecution(await safeExec('jscpd', [
246:       '--config', configPath, '--output', outputDir, '--exit-code', '0', '--silent',
247:       '--no-colors', '--no-tips', ...targets,
248:     ], { signal: ctx.signal, cwd: ctx.repoRoot, timeout: ctx.tool.timeout_ms }), 'jscpd');
249:     const reportPath = path.join(outputDir, 'jscpd-report.json');
250:     if (!fs.existsSync(reportPath)) failParse(ctx, 'jscpd', { error: 'missing JSON report' }, result);
251:     const parsed = tryParseJson(fs.readFileSync(reportPath, 'utf8'));
252:     if (!parsed.ok) failParse(ctx, 'jscpd', parsed, result);
253:     if (!Array.isArray(parsed.data?.duplicates)) failParse(ctx, 'jscpd', { error: 'missing duplicates array' }, result);
254:     if (result.exitCode !== 0) failParse(ctx, 'jscpd', { error: 'non-zero execution status' }, result);
255:     return parsed.data.duplicates;
256:   } finally {
257:     fs.rmSync(outputDir, { recursive: true, force: true });
258:   }
259: }
