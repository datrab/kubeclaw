43: function resourceIdentity(rendered: any, lineNumber: any) {
44:   const document = documentAtLine(rendered, lineNumber);
45:   const kind = unquote(document.find((line: any) => /^kind:\s*\S+/.test(line))?.replace(/^kind:\s*/, ''));
46:   const metadata = metadataLines(document);
47:   const name = unquote(metadata.find((line: any) => /^\s+name:\s*\S+/.test(line))?.replace(/^\s+name:\s*/, ''));
48:   const namespace = unquote(metadata.find((line: any) => /^\s+namespace:\s*\S+/.test(line))?.replace(/^\s+namespace:\s*/, '')) || 'default';
49:   return kind && name ? `${kind}:${namespace}:${name}` : 'unresolved-resource';
50: }
