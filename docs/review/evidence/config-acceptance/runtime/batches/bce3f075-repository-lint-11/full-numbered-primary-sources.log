1: import crypto from 'node:crypto';
2: import fs from 'node:fs';
3: import path from 'node:path';
4: 
5: import { fail, record, repoRelative, stringList, text } from './policy-validation.ts';
6: 
7: const PACK_SCHEMA_VERSION = 'kubernetes_lint_policy_pack.v1';
8: const RULE_TYPES = new Set([
9:   'required-env',
10:   'secret-ref',
11:   'private-registry-pull-secret',
12:   'readiness-probe',
13:   'liveness-probe',
14:   'resource-limits',
15: ]);
16: const SEVERITIES = new Set(['warning', 'error']);
17: const MAX_PACK_BYTES = 1_048_576;
18: const MAX_PACK_RULES = 256;
19: 
20: type AnyRecord = Record<string, any>;
21: 
22: function exactKeys(value: AnyRecord, allowed: readonly string[], field: string): void {
23:   const known = new Set(allowed);
24:   for (const key of Object.keys(value)) if (!known.has(key)) fail(`${field}.${key}`, 'unknown field');
25: }
26: 
27: function unique(values: string[], field: string): string[] {
28:   if (new Set(values).size !== values.length) fail(field, 'duplicate values are not allowed');
29:   return values;
30: }
31: 
32: function parametersForRule(type: string, input: unknown, field: string): AnyRecord {
33:   const value = input === undefined ? {} : record(input, field);
34:   if (type === 'required-env') {
35:     exactKeys(value, ['names'], field);
36:     return { names: unique(stringList(value.names, `${field}.names`, { nonEmpty: true }), `${field}.names`) };
37:   }
38:   if (type === 'private-registry-pull-secret') {
39:     exactKeys(value, ['registries'], field);
40:     return { registries: unique(stringList(value.registries, `${field}.registries`, { nonEmpty: true }), `${field}.registries`) };
41:   }
42:   if (type === 'resource-limits') {
43:     exactKeys(value, ['cpu', 'memory'], field);
44:     const cpu = value.cpu === undefined ? true : value.cpu;
45:     const memory = value.memory === undefined ? true : value.memory;
46:     if (typeof cpu !== 'boolean') fail(`${field}.cpu`, 'required boolean');
47:     if (typeof memory !== 'boolean') fail(`${field}.memory`, 'required boolean');
48:     if (!cpu && !memory) fail(field, 'at least one resource limit must be required');
49:     return { cpu, memory };
50:   }
51:   exactKeys(value, [], field);
52:   return {};
53: }
54: 
55: function validateRule(input: unknown, field: string): AnyRecord {
56:   const rule = record(input, field);
57:   exactKeys(rule, ['id', 'type', 'severity', 'parameters'], field);
58:   const id = text(rule.id, `${field}.id`);
59:   const type = text(rule.type, `${field}.type`);
60:   const severity = text(rule.severity, `${field}.severity`);
61:   if (!/^[a-z][a-z0-9.-]{0,127}$/u.test(id)) fail(`${field}.id`, 'must use lowercase stable identifier syntax');
62:   if (!RULE_TYPES.has(type)) fail(`${field}.type`, `unsupported rule type '${type}'`);
63:   if (!SEVERITIES.has(severity)) fail(`${field}.severity`, `unsupported severity '${severity}'`);
64:   return { id, type, severity, parameters: parametersForRule(type, rule.parameters, `${field}.parameters`) };
65: }
66: 
67: function validatePackDocument(input: unknown, expected: AnyRecord, sourcePath: string): AnyRecord {
68:   const pack = record(input, `policy pack ${expected.id}`);
69:   exactKeys(pack, ['schema_version', 'id', 'version', 'rules'], `policy pack ${expected.id}`);
70:   if (pack.schema_version !== PACK_SCHEMA_VERSION) fail(`policy pack ${expected.id}.schema_version`, `expected ${PACK_SCHEMA_VERSION}`);
71:   if (text(pack.id, `policy pack ${expected.id}.id`) !== expected.id) fail(`policy pack ${expected.id}.id`, 'does not match policy reference');
72:   if (text(pack.version, `policy pack ${expected.id}.version`) !== expected.version) fail(`policy pack ${expected.id}.version`, 'does not match policy reference');
73:   if (!Array.isArray(pack.rules) || pack.rules.length === 0) fail(`policy pack ${expected.id}.rules`, 'required non-empty array');
74:   if (pack.rules.length > MAX_PACK_RULES) fail(`policy pack ${expected.id}.rules`, `must contain at most ${MAX_PACK_RULES} rules`);
75:   const rules = pack.rules.map((entry: unknown, index: number) => validateRule(entry, `policy pack ${expected.id}.rules[${index}]`));
76:   const ruleIds = rules.map((rule: AnyRecord) => rule.id);
77:   unique(ruleIds, `policy pack ${expected.id}.rules`);
78:   return Object.freeze({ schema_version: PACK_SCHEMA_VERSION, id: expected.id, version: expected.version, digest: expected.sha256, bytes: fs.statSync(sourcePath).size, path: sourcePath, rules: Object.freeze(rules) });
79: }
80: 
81: function validatePackReference(input: unknown, field: string, policyDir: string): AnyRecord {
82:   const reference = record(input, field);
83:   exactKeys(reference, ['id', 'version', 'path', 'sha256'], field);
84:   const id = text(reference.id, `${field}.id`);
85:   const version = text(reference.version, `${field}.version`);
86:   if (!/^[a-z][a-z0-9.-]{0,127}$/u.test(id)) fail(`${field}.id`, 'must use lowercase stable identifier syntax');
87:   if (!/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/u.test(version)) fail(`${field}.version`, 'required semantic version');
88:   const relativePath = repoRelative(reference.path, `${field}.path`);
89:   const sha256 = text(reference.sha256, `${field}.sha256`);
90:   if (!/^[a-f0-9]{64}$/u.test(sha256)) fail(`${field}.sha256`, 'required lowercase SHA-256');
91:   const sourcePath = path.resolve(policyDir, relativePath);
