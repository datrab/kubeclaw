19: 
20: function fail(path: string, message: string): never {
21:   throw new LintReportContractError(`${path}: ${message}`);
22: }
23: 
24: function requireRecord(value: unknown, path: string): AnyRecord {
25:   if (!value || typeof value !== 'object') fail(path, 'required object');
26:   if (Array.isArray(value)) fail(path, 'required object');
27:   return value;
28: }
29: 
30: function requireString(value: unknown, path: string): void {
31:   if (typeof value !== 'string' || !value.trim()) fail(path, 'required non-empty string');
32: }
33: 
34: function requireCount(value: unknown, path: string): void {
35:   if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) fail(path, 'required non-negative safe integer');
36: }
37: 
38: function validateFinding(finding: unknown, path: string): void {
39:   const value = requireRecord(finding, path);
40:   if (value.file !== null) requireString(value.file, `${path}.file`);
41:   if (!FINDING_SEVERITIES.has(value.severity)) fail(`${path}.severity`, 'unknown severity');
42:   requireString(value.code, `${path}.code`);
43:   requireString(value.message, `${path}.message`);
44:   requireString(value.fingerprint, `${path}.fingerprint`);
45:   if (!/^[a-f0-9]{64}$/.test(value.fingerprint)) fail(`${path}.fingerprint`, 'required lowercase SHA-256');
46:   if (value.baseline !== undefined) {
47:     const baseline = requireRecord(value.baseline, `${path}.baseline`);
48:     for (const field of ['owner', 'reason', 'created', 'expires', 'tracking', 'approved_by', 'approved_on']) requireString(baseline[field], `${path}.baseline.${field}`);
49:   }
50:   for (const coordinate of ['line', 'column']) {
51:     if (value[coordinate] !== null && value[coordinate] !== undefined) {
52:       if (!Number.isSafeInteger(value[coordinate]) || value[coordinate] < 1) {
53:         fail(`${path}.${coordinate}`, 'must be null or a positive integer');
54:       }
55:     }
56:   }
57: }
58: 
59: function validateEvidence(input: unknown, path: string): void {
60:   if (!Array.isArray(input) || input.length > 256) fail(path, 'required array with at most 256 entries');
61:   input.forEach((entry, index) => {
62:     const value = requireRecord(entry, `${path}[${index}]`);
63:     for (const field of ['kind', 'source', 'sha256']) requireString(value[field], `${path}[${index}].${field}`);
64:     if (!/^[a-f0-9]{64}$/u.test(value.sha256)) fail(`${path}[${index}].sha256`, 'required lowercase SHA-256');
65:     requireCount(value.bytes, `${path}[${index}].bytes`);
66:     if (value.bytes > 67_108_864) fail(`${path}[${index}].bytes`, 'referenced evidence exceeds 64 MiB limit');
67:     if (value.content !== undefined) {
68:       if (typeof value.content !== 'string') fail(`${path}[${index}].content`, 'required string');
69:       if (Buffer.byteLength(value.content) > 262_144) fail(`${path}[${index}].content`, 'inline evidence exceeds 256 KiB limit');
70:       if (Buffer.byteLength(value.content) !== value.bytes) fail(`${path}[${index}].content`, 'byte count mismatch');
71:       if (sha256Text(value.content) !== `sha256:${value.sha256}`) fail(`${path}[${index}].content`, 'digest mismatch');
72:     }
73:   });
