11: function resourceName(resource: AnyRecord): string {
12:   return `${resource.value.kind || 'Unknown'}/${resource.value.metadata?.name || '<unnamed>'}`;
13: }
14: 
15: function finding(resource: AnyRecord, rule: AnyRecord, message: string, keys: Array<string | number> = []): AnyRecord {
16:   return { file: resource.source, line: nodeLine(resource, keys), column: 1, severity: rule.severity, code: `kubernetes-policy/${rule.id}`, message };
17: }
