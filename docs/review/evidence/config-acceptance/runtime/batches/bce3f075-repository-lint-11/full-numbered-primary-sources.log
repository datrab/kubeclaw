66: function parseSource(content: string, source: string, sourceKind: string, limits: AnyRecord): { resources: AnyRecord[]; documentCount: number } {
67:   if (Buffer.byteLength(content) > limits.max_rendered_bytes) throw Object.assign(new Error(`${source} exceeds max_rendered_bytes`), { code: 'kubernetes-manifest-size-limit' });
68:   const lineCounter = new LineCounter();
69:   const documents = parseAllDocuments(content, { lineCounter, prettyErrors: false, strict: true });
70:   if (documents.length > limits.max_documents) throw Object.assign(new Error(`${source} exceeds max_documents`), { code: 'kubernetes-manifest-document-limit' });
71:   const resources: AnyRecord[] = [];
72:   documents.forEach((document, index) => {
73:     if (document.errors.length > 0) {
74:       const error = document.errors[0]!;
75:       throw Object.assign(new Error(`${source}: ${error.message}`), { code: 'kubernetes-manifest-yaml-invalid' });
76:     }
77:     const value = document.toJS({ maxAliasCount: 100 });
78:     if (value === null || value === undefined) return;
79:     if (!value || typeof value !== 'object' || Array.isArray(value)) throw Object.assign(new Error(`${source} document ${index + 1} is not a Kubernetes object`), { code: 'kubernetes-manifest-object-invalid' });
80:     const start = document.contents?.range?.[0] ?? 0;
81:     resources.push({
82:       value,
83:       document,
84:       lineCounter,
85:       source: sourceKind === 'helm-render' ? renderedDocumentSource(content, source, start) : source,
86:       source_kind: sourceKind,
87:       document_index: index + 1,
88:       line: lineCounter.linePos(start).line,
89:     });
90:   });
91:   return { resources, documentCount: documents.length };
92: }
93: 
94: async function loadKubernetesResources(ctx: AnyRecord): Promise<{ resources: AnyRecord[]; sources: AnyRecord[] }> {
95:   validateKubernetesInputs(ctx);
96:   const projectRoot = path.resolve(ctx.repoRoot, ctx.policyProject.root);
97:   const settings = ctx.policyProject.kubernetes;
98:   const resources: AnyRecord[] = [];
99:   const sources: AnyRecord[] = [];
100:   let documentCount = 0;
101:   for (const relative of settings.raw_manifests) {
102:     const absolute = path.resolve(projectRoot, relative);
103:     if (!inside(projectRoot, absolute)) throw Object.assign(new Error(`raw manifest escapes project root: ${relative}`), { code: 'kubernetes-manifest-path-invalid' });
104:     const content = fs.readFileSync(absolute, 'utf8');
105:     if (Buffer.byteLength(content) > settings.limits.max_file_bytes) throw Object.assign(new Error(`${relative} exceeds max_file_bytes`), { code: 'kubernetes-manifest-size-limit' });
106:     const parsed = parseSource(content, relative, 'raw', settings.limits);
107:     resources.push(...parsed.resources);
108:     documentCount += parsed.documentCount;
109:     sources.push({ kind: 'raw-manifest', source: relative, sha256: digest(content), bytes: Buffer.byteLength(content) });
110:   }
111:   for (const relative of settings.helm_charts) {
112:     const absolute = path.resolve(projectRoot, relative);
113:     if (!inside(projectRoot, absolute)) throw Object.assign(new Error(`Helm chart escapes project root: ${relative}`), { code: 'kubernetes-manifest-path-invalid' });
114:     const content = await renderChart(ctx, absolute);
115:     const parsed = parseSource(content, relative, 'helm-render', settings.limits);
116:     resources.push(...parsed.resources);
117:     documentCount += parsed.documentCount;
118:     sources.push({ kind: 'helm-render', source: relative, sha256: digest(content), bytes: Buffer.byteLength(content) });
119:   }
120:   if (documentCount > settings.limits.max_documents) throw Object.assign(new Error('combined Kubernetes inputs exceed max_documents'), { code: 'kubernetes-manifest-document-limit' });
121:   return { resources, sources };
122: }
123: 
124: function nodeLine(resource: AnyRecord, keys: Array<string | number>): number {
125:   const node = resource.document.getIn(keys, true);
126:   const offset = node?.range?.[0];
127:   return typeof offset === 'number' ? resource.lineCounter.linePos(offset).line : resource.line;
128: }
