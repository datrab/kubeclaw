234: function validateLintPolicy(input: unknown, policyPath: string, options: Record<string, any> = {}): Record<string, any> {
235:   const policy = record(input, 'policy');
236:   if (policy.schema_version !== LINT_POLICY_SCHEMA_VERSION) fail('policy.schema_version', `expected ${LINT_POLICY_SCHEMA_VERSION}`);
237:   if (!Array.isArray(policy.projects) || policy.projects.length !== 1) fail('policy.projects', 'required array with exactly one project');
238:   if (!Array.isArray(policy.tools) || policy.tools.length === 0) fail('policy.tools', 'required non-empty array');
239:   const policyDir = path.dirname(policyPath);
240:   const today = typeof options.today === 'string' ? isoDate(options.today, 'validation.today') : new Date().toISOString().slice(0, 10);
241:   const baseline = validateBaseline(policy.baseline_path, policyDir, today);
242:   const kubernetesPolicyPacks = loadKubernetesPolicyPacks(policy.kubernetes_policy_packs ?? [], policyDir);
243:   const packIds = new Set(kubernetesPolicyPacks.map((pack: Record<string, any>) => pack.id));
244:   const projects = policy.projects.map((entry: any, index: any) => validateProject(entry, `policy.projects[${index}]`, packIds));
245:   const tools = policy.tools.map((entry: any, index: any) => validateTool(entry, `policy.tools[${index}]`, policyDir));
246:   validateUniqueIds(projects, tools);
247:   applyExperimentalModes(policy, tools);
248:   const ruleAdmission = validateRuleAdmission(policy.rule_admission, tools);
249:   validateLanguageAuthorities(projects, tools);
250:   const globalExclusions = stringList(policy.global_exclusions, 'policy.global_exclusions');
251:   const architecture = validateArchitecture(policy.architecture);
252:   validateArchitectureTool(architecture, tools);
253:   validateSuppressionTools(baseline, tools);
254:   return { schema_version: LINT_POLICY_SCHEMA_VERSION, projects, tools, global_exclusions: globalExclusions, architecture, baseline, rule_admission: ruleAdmission, kubernetes_policy_packs: kubernetesPolicyPacks };
255: }
256: 
257: function loadLintPolicy(policyPath: string): Record<string, any> {
258:   if (!path.isAbsolute(policyPath)) fail('policy path', 'must be absolute');
259:   if (!fs.existsSync(policyPath)) fail('policy path', `does not exist: ${policyPath}`);
260:   let parsed: unknown;
261:   let source = '';
262:   try { source = fs.readFileSync(policyPath, 'utf8'); parsed = JSON.parse(source); }
263:   catch (error: any) { fail('policy', `invalid JSON: ${(error as Error).message}`); }
264:   const policy = validateLintPolicy(parsed, policyPath);
265:   for (const tool of policy.tools) {
266:     if (tool.config_path && tool.required && !fs.existsSync(tool.config_path)) fail(`policy.tools.${tool.id}.config_path`, `does not exist: ${tool.config_path}`);
267:   }
268:   policy.digest = crypto.createHash('sha256').update(source).digest('hex');
269:   policy.config_digests = Object.fromEntries(policy.tools
270:     .filter((tool: Record<string, any>) => tool.config_path && fs.existsSync(tool.config_path))
271:     .map((tool: Record<string, any>) => [tool.id, crypto.createHash('sha256').update(fs.readFileSync(tool.config_path)).digest('hex')]));
272:   policy.policy_pack_digests = Object.fromEntries(policy.kubernetes_policy_packs.map((pack: Record<string, any>) => [pack.id, pack.digest]));
273:   return policy;
274: }
275: 
276: function selectPolicyProject(policy: Record<string, any>, projectId: string): Record<string, any> {
277:   const project = policy.projects.find((entry: Record<string, any>) => entry.id === projectId);
278:   if (!project) fail('policy project', `unknown project '${projectId}'`);
279:   return project;
280: }
281: 
282: function policyDigest(policy: Record<string, any>): string {
283:   return text(policy.digest, 'policy.digest');
284: }
