7: function suppressionEntries(baseline: Record<string, any>, today: string): Record<string, any>[] {
8:   return baseline.groups.flatMap((entry: unknown, index: number) => {
9:     const field = `baseline.groups[${index}]`;
10:     const value = record(entry, field);
11:     const created = isoDate(value.created, `${field}.created`);
12:     const expires = isoDate(value.expires, `${field}.expires`);
13:     const approvedOn = isoDate(value.approved_on, `${field}.approved_on`);
14:     if (expires < today) fail(`${field}.expires`, `expired on ${expires}; remove or renew through explicit approval`);
15:     if (approvedOn < created) fail(`${field}.approved_on`, 'cannot precede creation date');
16:     if (expires <= created) fail(`${field}.expires`, 'must be later than creation date');
17:     const metadata = {
18:       tool: text(value.tool, `${field}.tool`), owner: text(value.owner, `${field}.owner`),
19:       reason: text(value.reason, `${field}.reason`), created, expires,
20:       tracking: text(value.tracking, `${field}.tracking`), approved_by: text(value.approved_by, `${field}.approved_by`), approved_on: approvedOn,
21:     };
22:     return stringList(value.fingerprints, `${field}.fingerprints`, { nonEmpty: true }).map((fingerprint: any, fingerprintIndex: any) => {
23:       if (!/^[a-f0-9]{64}$/.test(fingerprint)) fail(`${field}.fingerprints[${fingerprintIndex}]`, 'required lowercase SHA-256');
24:       return { ...metadata, fingerprint };
25:     });
26:   });
27: }
28: 
29: function validateBaseline(input: unknown, policyDir: string, today: string): Record<string, any> {
30:   const baselinePath = path.resolve(policyDir, text(input, 'policy.baseline_path'));
31:   if (!fs.existsSync(baselinePath)) fail('policy.baseline_path', `does not exist: ${baselinePath}`);
32:   let source = '';
33:   let parsed: unknown;
34:   try { source = fs.readFileSync(baselinePath, 'utf8'); parsed = JSON.parse(source); }
35:   catch (error: any) { fail('policy.baseline_path', `invalid JSON: ${(error as Error).message}`); }
36:   const baseline = record(parsed, 'baseline');
37:   if (baseline.schema_version !== 'pipeline_lint_baseline.v2') fail('baseline.schema_version', 'expected pipeline_lint_baseline.v2');
38:   if (!Array.isArray(baseline.groups)) fail('baseline.groups', 'required array');
39:   const entries = suppressionEntries(baseline, today);
40:   const keys = entries.map((entry: any) => `${entry.tool}:${entry.fingerprint}`);
41:   if (new Set(keys).size !== keys.length) fail('baseline.groups', 'duplicate tool fingerprints are not allowed');
42:   return { path: baselinePath, digest: crypto.createHash('sha256').update(source).digest('hex'), entries, entries_by_key: new Map(entries.map((entry: any) => [`${entry.tool}:${entry.fingerprint}`, entry])) };
43: }
44: 
45: function validateRuleAdmission(input: unknown, tools: Record<string, any>[]): Record<string, any> {
46:   const admission = record(input, 'policy.rule_admission');
47:   const historicalCommits = stringList(admission.historical_commits, 'policy.rule_admission.historical_commits', { nonEmpty: true });
48:   historicalCommits.forEach((commit: any, index: any) => {
49:     if (!/^[a-f0-9]{40}$/.test(commit)) fail(`policy.rule_admission.historical_commits[${index}]`, 'required full lowercase Git commit SHA');
50:   });
51:   if (!Array.isArray(admission.rules) || admission.rules.length === 0) fail('policy.rule_admission.rules', 'required non-empty array');
52:   const knownTools = new Set(tools.map((tool: any) => tool.id));
53:   const rules = admission.rules.map((entry: unknown, index: number) => {
54:     const field = `policy.rule_admission.rules[${index}]`;
55:     const rule = record(entry, field);
56:     const tool = text(rule.tool, `${field}.tool`);
57:     if (!knownTools.has(tool)) fail(`${field}.tool`, `unknown tool '${tool}'`);
58:     if (!Number.isSafeInteger(rule.historical_changed_sets) || rule.historical_changed_sets < 1) fail(`${field}.historical_changed_sets`, 'required positive integer');
59:     if (!Number.isSafeInteger(rule.false_positives) || rule.false_positives < 0) fail(`${field}.false_positives`, 'required non-negative integer');
60:     return { tool, code: text(rule.code, `${field}.code`), principle: text(rule.principle, `${field}.principle`), remediation: text(rule.remediation, `${field}.remediation`), historical_changed_sets: rule.historical_changed_sets, false_positives: rule.false_positives, approved_by: text(rule.approved_by, `${field}.approved_by`), approved_on: isoDate(rule.approved_on, `${field}.approved_on`) };
61:   });
62:   const keys = rules.map((rule: any) => `${rule.tool}:${rule.code}`);
63:   if (new Set(keys).size !== keys.length) fail('policy.rule_admission.rules', 'duplicate tool/rule codes are not allowed');
64:   return { historical_commits: historicalCommits, rules };
65: }
