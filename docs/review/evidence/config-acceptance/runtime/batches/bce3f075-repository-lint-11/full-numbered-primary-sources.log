111: function validateOkToolResult(value: AnyRecord, path: string, toolPolicies: AnyRecord, visibility: AnyRecord): void {
112:   for (const field of ['errors', 'warnings', 'blocking_findings', 'baselined_findings', 'experimental_findings']) requireCount(value[field], `${path}.${field}`);
113:   if (!Array.isArray(value.findings)) fail(`${path}.findings`, 'required array');
114:   validateEvidence(value.evidence, `${path}.evidence`);
115:   validateToolPolicy(value, path, expectedToolPolicy(path, toolPolicies));
116:   value.findings.forEach((finding: any, index: any) => validateFinding(finding, `${path}.findings[${index}]`));
117:   if (value.mode === 'experimental') validateExperimentalResult(value, path, visibility);
118:   else validateBlockingResult(value, path, visibility);
