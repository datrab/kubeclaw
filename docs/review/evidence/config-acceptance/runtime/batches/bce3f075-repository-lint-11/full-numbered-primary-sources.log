36:   async #start(adapterId: string): Promise<AdapterInstance> {
37:     const existing = this.#instances.get(adapterId); if (existing) return existing;
38:     if (this.#starting.has(adapterId)) throw new Error(`ADAPTER_CYCLE:${adapterId}`); this.#starting.add(adapterId);
39:     try {
40:       const entry = this.#options.runtime.granted.snapshot.adapters.get(adapterId); const activated = this.#options.runtime.activated.adapters.get(adapterId);
41:       if (!entry || !activated) throw new Error(`ADAPTER_NOT_ACTIVATED:${adapterId}`);
42:       const lifecycle = new AbortController(); this.#controllers.set(adapterId, lifecycle); this.#options.pendingControllers.set(adapterId, lifecycle);
43:       const config = this.#config(adapterId, entry.package.root, entry.registration.configSchema);
44:       await this.#dependencies(adapterId, entry.registration.requiredCapabilities);
45:       const context = this.#context(adapterId, lifecycle, entry.provenance, entry.package.manifest.id, config);
46:       const raw = await this.#activate(adapterId, lifecycle, activated.execute as AdapterFactory, context);
47:       const instance = this.#wrap(raw, lifecycle, adapterId); this.#instances.set(adapterId, instance); this.#options.pendingInstances.set(adapterId, instance);
48:       await this.#ready(adapterId, instance, lifecycle); return instance;
49:     } finally { this.#starting.delete(adapterId); }
50:   }
51: 
52:   #config(adapterId: string, root: string, schema: string): Readonly<Record<string, unknown>> {
53:     const config = this.#options.runtime.configs.get(adapterId) ?? Object.freeze({});
54:     validateReferencedValue(fs.realpathSync(path.join(root, schema)), config, this.#options.runtime.granted.snapshot.schemas); return config;
55:   }
56: 
57:   async #dependencies(adapterId: string, capabilities: readonly string[]): Promise<void> {
58:     for (const capability of capabilities) {
59:       const dependency = this.#options.runtime.granted.selectedProviders.get(capability);
60:       if (!dependency) throw new Error(`ADAPTER_DEPENDENCY_MISSING:${adapterId}:${capability}`);
61:       await this.#start(`${dependency.package.manifest.id}:${dependency.registration.id}`);
62:     }
