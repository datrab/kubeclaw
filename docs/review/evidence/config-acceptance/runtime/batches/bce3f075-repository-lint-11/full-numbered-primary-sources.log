168: function validateConfigDigests(actual: AnyRecord, expected: AnyRecord): void {
169:   const actualKeys = Object.keys(actual).sort();
170:   const expectedKeys = Object.keys(expected).sort();
171:   if (JSON.stringify(actualKeys) !== JSON.stringify(expectedKeys)) fail('report.policy.config_digests', 'keys do not match configured native configs');
172:   for (const toolId of expectedKeys) if (actual[toolId] !== expected[toolId]) fail(`report.policy.config_digests.${toolId}`, 'does not match configured native config');
173: }
