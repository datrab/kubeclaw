174: function jscpdFindings(data: any, repoRoot: any = null) {
175:   return data.duplicates.map((clone: any) => {
176:     const first = clone.firstFile;
177:     const second = clone.secondFile;
178:     const files = [first.name, second.name].sort();
179:     return {
180:       file: first.name,
181:       line: first.start,
182:       column: null,
183:       severity: 'error',
184:       code: 'duplication:structural-clone',
185:       message: `${clone.format} clone (${clone.lines} lines, ${clone.tokens} tokens): ${first.name}:${first.start} ↔ ${second.name}:${second.start}`,
186:       fingerprint_seed: {
187:         files,
188:         format: clone.format,
189:         fragment: String(clone.fragment || '').trim().replace(/\s+/g, ' '),
190:         contexts: [cloneContext(repoRoot, first), cloneContext(repoRoot, second)],
191:       },
192:     };
193:   });
194: }
