121: function validateToolResult(result: unknown, path: string, toolPolicies: AnyRecord, visibility: AnyRecord): void {
122:   const value = requireRecord(result, path);
123:   if (!TOOL_STATUSES.has(value.status)) fail(`${path}.status`, 'unknown status');
124:   requireCount(value.duration_ms, `${path}.duration_ms`);
125:   if (value.status === 'ok') validateOkToolResult(value, path, toolPolicies, visibility);
126:   else if (value.status === 'error') {
