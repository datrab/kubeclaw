19: function positiveInteger(value: unknown, field: string, maximum: number): number {
20:   if (!Number.isSafeInteger(value) || (value as number) < 1 || (value as number) > maximum) fail(field, `required integer from 1 to ${maximum}`);
21:   return value as number;
22: }
