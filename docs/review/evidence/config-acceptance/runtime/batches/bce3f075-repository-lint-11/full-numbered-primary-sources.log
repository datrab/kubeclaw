61: function positiveInteger(value: unknown, fallback: number, label: string): number {
62:   const resolved = value ?? fallback;
63:   if (!Number.isSafeInteger(resolved) || Number(resolved) <= 0) throw new Error(`${label} is invalid`);
64:   return Number(resolved);
65: }
