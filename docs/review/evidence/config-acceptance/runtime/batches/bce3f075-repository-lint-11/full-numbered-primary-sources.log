21: function documentAtLine(rendered: any, lineNumber: any) {
22:   const lines = rendered.split('\n');
23:   const lineIndex = Math.max(0, Math.min(lines.length - 1, Number(lineNumber || 1) - 1));
24:   let start = lineIndex;
25:   while (start > 0 && lines[start].trim() !== '---') start -= 1;
26:   if (lines[start].trim() === '---') start += 1;
27:   let end = lineIndex + 1;
28:   while (end < lines.length && lines[end].trim() !== '---') end += 1;
29:   return lines.slice(start, end);
