271: function govulncheckTool() {
272:   return {
273:     id: 'govulncheck',
274:     name: 'govulncheck',
275:     binary: 'govulncheck',
276:     run: async (ctx: any) => {
277:       const findings: any[] = [];
278:       const modules = affectedModuleDirectories(ctx);
279:       if (modules.length === 0) return notApplicable('No Go module is affected by the requested scope.');
280:       for (const moduleRoot of modules) {
281:         const result = requireToolExecution(await safeExec('govulncheck', ['-format', 'json', ...goBuildTagArguments(ctx, moduleRoot), ...ctx.tool.arguments], { signal: ctx.signal, cwd: moduleRoot, timeout: ctx.tool.timeout_ms }), 'govulncheck');
282:         const messages = parseJsonStream(ctx, 'govulncheck', result, moduleRoot);
283:         // Pinned govulncheck JSON mode exits 0 even when findings exist; any
284:         // nonzero exit is therefore an operational failure, not finding state.
285:         if (result.exitCode !== 0) {
286:           throw Object.assign(new Error(`govulncheck failed for ${moduleRoot}: ${commandOutput(result).split('\n')[0] || 'non-zero exit'}`), { code: 'govulncheck-execution-failed' });
287:         }
288:         findings.push(...messages.filter((item: any) => item.finding?.osv).map((item: any) => govulnFinding(item, moduleRoot)));
289:       }
290:       return findingsResult(findings);
291:     },
292:   };
293: }
294: 
295: function govulnFinding(item: any, moduleRoot: string) {
296:   const trace = Array.isArray(item.finding.trace) ? item.finding.trace : [];
297:   const position = [...trace].reverse().find((frame: any) => frame.position)?.position;
298:   return {
299:     file: position?.filename ? path.resolve(moduleRoot, position.filename) : path.join(moduleRoot, 'go.mod'),
300:     line: position?.line ?? null, column: position?.column ?? null, severity: 'error',
301:     code: item.finding.osv, message: `Reachable Go vulnerability ${item.finding.osv}`,
302:   };
303: }
