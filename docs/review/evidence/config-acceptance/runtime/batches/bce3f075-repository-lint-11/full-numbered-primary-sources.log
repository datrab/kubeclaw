185: function applyExperimentalModes(policy: Record<string, any>, tools: Record<string, any>[]): void {
186:   const experimental = stringList(policy.experimental_tools, 'policy.experimental_tools');
187:   const configured = new Set(tools.map((tool: any) => tool.id));
188:   for (const id of experimental) if (!configured.has(id)) fail('policy.experimental_tools', `unknown tool '${id}'`);
189:   const selected = new Set(experimental);
190:   for (const tool of tools) tool.mode = selected.has(tool.id) ? 'experimental' : 'blocking';
