67: function activationConfig(context: AdapterActivationContext) {
68:   const configured = context.config.repositoryRoot;
69:   if (typeof configured !== 'string' || configured.length === 0) throw new Error('repositoryRoot is required');
70:   if (fs.lstatSync(configured).isSymbolicLink() || fs.realpathSync(configured) !== path.resolve(configured)) throw new Error('REPOSITORY_PATH_FORBIDDEN');
71:   const expectedHead = context.config.expectedHead;
72:   if (expectedHead !== undefined && typeof expectedHead !== 'string') throw new Error('expectedHead is invalid');
73:   return {
74:     root: fs.realpathSync(configured),
75:     maxFileBytes: positiveInteger(context.config.maxFileBytes, 4 * 1024 * 1024, 'maxFileBytes'),
76:     maxChangedPaths: positiveInteger(context.config.maxChangedPaths, 2048, 'maxChangedPaths'),
77:     ...(expectedHead === undefined ? {} : { expectedHead }),
78:   };
79: }
80: 
81: export function activate(context: AdapterActivationContext): AdapterInstance {
82:   const { root, maxFileBytes, maxChangedPaths, expectedHead } = activationConfig(context);
83:   const revisions = new RevisionReader(root, maxFileBytes, maxChangedPaths, expectedHead);
84:   return {
85:     async ready() {
86:       if (!fs.statSync(root).isDirectory()) throw new Error('repositoryRoot is not a directory');
87:     },
88:     async invoke(invocation) { return invokeRepository(invocation, root, maxFileBytes, revisions); },
89:     async shutdown() {},
90:   };
91: }
