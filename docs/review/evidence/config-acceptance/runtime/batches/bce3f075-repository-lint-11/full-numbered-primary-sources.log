225: function validateSuppressionTools(baseline: Record<string, any>, tools: Record<string, any>[]): void {
226:   const configured = new Map(tools.map((tool: any) => [tool.id, tool]));
227:   for (const entry of baseline.entries) {
228:     const tool = configured.get(entry.tool);
229:     if (!tool) fail('baseline.groups', `unknown tool '${entry.tool}'`);
230:     if (tool.mode !== 'blocking') fail('baseline.groups', `experimental tool '${entry.tool}' cannot own suppressions`);
231:   }
232: }
