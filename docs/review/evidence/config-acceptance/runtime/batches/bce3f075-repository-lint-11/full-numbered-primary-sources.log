93: function validateBlockingResult(value: AnyRecord, path: string, visibility: AnyRecord): void {
94:   const errors = value.findings.filter((finding: AnyRecord) => !finding.baseline && finding.severity === 'error').length;
95:   const warnings = value.findings.filter((finding: AnyRecord) => !finding.baseline && finding.severity === 'warning').length;
96:   const baselined = value.findings.filter((finding: AnyRecord) => finding.baseline).length;
97:   if (errors > value.errors) fail(`${path}.errors`, `cannot be lower than ${errors} reported findings`);
98:   if (warnings > value.warnings) fail(`${path}.warnings`, `cannot be lower than ${warnings} reported findings`);
99:   if (baselined > value.baselined_findings) fail(`${path}.baselined_findings`, `cannot be lower than ${baselined} disclosed debt findings`);
100:   validateDebtVisibility(value, path, visibility, baselined);
101:   if (value.experimental_findings !== 0) fail(`${path}.experimental_findings`, 'blocking tool cannot report experimental findings');
102:   const blocking = value.blocking_severity === 'warning' ? value.errors + value.warnings : value.errors;
103:   if (value.blocking_findings !== blocking) fail(`${path}.blocking_findings`, `expected ${blocking} from findings`);
104: }
