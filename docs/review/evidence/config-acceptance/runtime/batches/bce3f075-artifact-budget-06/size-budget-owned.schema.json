{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maximumTotalBytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "maximumFileCount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    },
    "matchingFiles": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pattern",
          "maximumBytes",
          "requireMatch"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/name"
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maximumBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requireMatch": {
            "type": "boolean"
          }
        }
      }
    },
    "maximumGrowthBytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "maximumGrowthPercent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "largestFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  },
  "required": [
    "maximumTotalBytes",
    "maximumFileCount",
    "matchingFiles",
    "maximumGrowthBytes",
    "maximumGrowthPercent",
    "largestFiles"
  ],
  "description": "Proposed one complete plugin-owned businessbudget/rule/evidence policy. Explicit null inactive SIZEbounds replaces CURRENT undefined-only absence (null currently rejects), unapproved representation/loader migration. Coverage requiredminimum0 preservescurrentnogatebehavior butneverwaivesempty/malformed/digest/sourcecoverage."
}
