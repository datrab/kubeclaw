1: import { captureReviewSubject, canonicalJson, type PluginInvocationContext, type ReviewSource, type StageResult, type ArtifactRef } from '@kubeclaw/plugin-sdk';
2: import {parseDeclaration, validateDeliveryPaths, type Input} from './declarations.ts';
