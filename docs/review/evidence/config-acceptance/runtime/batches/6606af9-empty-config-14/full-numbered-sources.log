1: import path from 'node:path';
2: 
3: function unsupported(): never { throw new Error('Dockerfile path semantics cannot be determined statically.'); }
4: function instructions(source: string): string[] {
5:   let escape = '\\'; let pending = ''; const result: string[] = [];
6:   for (const line of source.split(/\r?\n/u)) {
7:     const trimmed = line.trim();
8:     if (trimmed.startsWith('#')) {
9:       const directive = /^#\s*escape\s*=\s*([\\`])\s*$/iu.exec(trimmed);
10:       if (directive && !result.length && !pending) escape = directive[1]!;
11:       continue;
12:     }
13:     if (!trimmed && !pending) continue;
14:     let trailing = 0;
15:     for (let index = line.length - 1; index >= 0 && line[index] === escape; index--) trailing++;
16:     if (trailing % 2) { pending += line.slice(0, -1); continue; }
17:     const instruction = (pending + line).trim(); pending = '';
18:     // Heredocs can contain apparent instructions; never interpret their body as COPY.
19:     if (instruction.includes('<<')) unsupported();
20:     if (instruction) result.push(instruction);
21:   }
22:   if (pending) unsupported();
23:   return result;
24: }
25: function words(source: string): string[] {
26:   const result: string[] = []; let token = ''; let started = false; let quote = '';
27:   for (let index = 0; index < source.length; index++) {
28:     const character = source[index]!;
29:     if (character === '\\') {
30:       if (index + 1 >= source.length) unsupported();
31:       token += source[++index]; started = true;
32:     } else if (quote) {
33:       if (character === quote) quote = ''; else token += character;
34:     } else if (character === '"' || character === "'") { quote = character; started = true; }
35:     else if (/\s/u.test(character)) {
36:       if (started) { result.push(token); token = ''; started = false; }
37:     } else { token += character; started = true; }
38:   }
39:   if (quote) unsupported();
40:   if (started) result.push(token);
41:   return result;
42: }
43: function copyArguments(source: string): string[] {
44:   let remaining = source.trim();
45:   while (remaining.startsWith('--')) {
46:     const flag = /^--[a-z][a-z-]*(?:=[^\s]+)?\s+/iu.exec(remaining);
47:     if (!flag) unsupported();
48:     remaining = remaining.slice(flag[0].length);
49:   }
50:   let result: unknown;
51:   if (remaining.startsWith('[')) {
52:     try { result = JSON.parse(remaining); } catch { unsupported(); }
53:   } else result = words(remaining);
54:   if (!Array.isArray(result) || result.length < 2
55:     || result.some((item) => typeof item !== 'string' || !item.length)) unsupported();
56:   return result as string[];
57: }
58: function containerPath(base: string, value: string): string {
59:   if (/[\u0000\r\n$]/u.test(value)) unsupported();
60:   return path.posix.resolve(base, value);
61: }
62: interface Stage { workdir: string; destinations: string[] }
63: 
64: function fromStage(source: string, stages: Map<string, Stage>): Stage {
65:   const from = words(source).filter((word) => !word.startsWith('--'));
66:   if (from.length !== 1 && !(from.length === 3 && from[1]!.toUpperCase() === 'AS')) unsupported();
67:   const inherited = stages.get(from[0]!.toLowerCase());
68:   const stage = { workdir: inherited?.workdir ?? '/', destinations: [...(inherited?.destinations ?? [])] };
69:   if (from[2]) stages.set(from[2].toLowerCase(), stage);
70:   return stage;
71: }
72: 
73: /** Compares lexical destinations in the final stage; this is not an image build. */
74: export function matchesStaticPath(source: string, staticPath: string): boolean {
75:   const stages = new Map<string, Stage>(); let stage: Stage | undefined; let index = 0;
76:   for (const instruction of instructions(source)) {
77:     const match = /^([A-Z]+)\s+([\s\S]+)$/iu.exec(instruction);
78:     if (!match) unsupported();
79:     const command = match[1]!.toUpperCase(); const arguments_ = match[2]!;
80:     if (command === 'FROM') {
81:       stage = fromStage(arguments_, stages);
82:       stages.set(String(index++), stage);
83:     } else if (command === 'WORKDIR') {
84:       if (!stage) unsupported();
85:       const directory = words(arguments_); if (directory.length !== 1) unsupported();
86:       stage.workdir = containerPath(stage.workdir, directory[0]!);
87:     } else if (command === 'COPY') {
88:       if (!stage) unsupported();
89:       const argumentsList = copyArguments(arguments_);
90:       stage.destinations.push(containerPath(stage.workdir, argumentsList.at(-1)!));
91:     }
92:   }
93:   if (!stage) unsupported();
94:   return stage.destinations.includes(containerPath(stage.workdir, staticPath));
95: }
