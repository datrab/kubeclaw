SOURCE skills/common/plugins/agent-observability/src/observers.ts SHA256 b52a00959c3ba7c122faf4fe364ce9ab5baf530e590df89b8f3ddc5e764b111c
1: import {
2:   redactStructuredValue,
3:   type ObserverDelivery,
4:   type PluginInvocationContext,
5: } from '@kubeclaw/plugin-sdk';
6: export function projectAgentEvent(delivery: ObserverDelivery): Readonly<Record<string, unknown>> {
7:   return Object.freeze({
8:     schemaVersion: 'agent-observability-event.v2',
9:     deliveryId: delivery.deliveryId,
10:     eventId: delivery.event.eventId,
11:     eventType: delivery.event.type,
12:     sequence: delivery.event.sequence,
13:     identity: delivery.event.identity,
14:     occurredAt: delivery.event.occurredAt,
15:     payload: redactStructuredValue(delivery.event.payload),
16:   });
17: }
18: export async function ingest(delivery: ObserverDelivery, context: PluginInvocationContext): Promise<void> {
19:   await context.invoke('telemetry.emit', {
20:     operation: 'append',
21:     resource: { type: 'telemetry.event', canonicalId: delivery.event.type },
22:     payload: projectAgentEvent(delivery),
23:   });
24: }
25: export async function recordEvidence(delivery: ObserverDelivery, context: PluginInvocationContext): Promise<void> {
26:   await context.invoke('artifacts.write', {
27:     operation: 'put_json',
28:     resource: { type: 'artifact.object', canonicalId: `agent-evidence:${delivery.event.eventId}` },
29:     payload: {
30:       namespace: 'kubeclaw.agent-observability-evidence',
31:       mediaType: 'application/json',
32:       value: projectAgentEvent(delivery),
33:     },
34:   });
35: }
