SOURCE skills/nova/plugins/delivery-lint/src/stage.ts SHA256 b8f849c5d228713dd73ab7a47e73ef5be9ee5fd07af39e4276c483a3555ac862
1: import { matchesStaticPath } from './dockerfile.ts';
2: import type {
3:   ArtifactRef,
4:   PluginInvocationContext,
5:   StageResult,
6: } from '@kubeclaw/plugin-sdk';
7: 
8: interface DeliveryLintInput {
9:   readonly moduleId: string;
10:   readonly dockerfile: string | null;
11:   readonly staticPath: string | null;
12: }
13: 
14: interface Failure {
15:   readonly code: string;
16:   readonly message: string;
17:   readonly nextStep: string;
18: }
19: 
20: function safeRepositoryPath(value: string, field: string): string {
21:   if (value.includes('\0') || /[\r\n]/.test(value)) throw new Error(`${field} contains forbidden characters`);
22:   if (value.startsWith('/') || value.split(/[\\/]+/).includes('..')) {
23:     throw new Error(`${field} must be repository-relative without parent traversal`);
24:   }
25:   return value.replaceAll('\\', '/');
26: }
27: 
28: function safeContainerPath(value: string): string {
29:   if (value.includes('\0') || /[\r\n]/.test(value)) throw new Error('staticPath contains forbidden characters');
30:   if (value.split(/[\\/]+/).includes('..')) throw new Error('staticPath must not contain parent traversal');
31:   return value.replaceAll('\\', '/');
32: }
33: 
34: 
35: function artifactRef(value: Readonly<Record<string, unknown>>): ArtifactRef {
36:   const artifact = value.artifact;
37:   if (!artifact || typeof artifact !== 'object') throw new Error('artifact adapter returned no artifact reference');
38:   return artifact as ArtifactRef;
39: }
40: 
41: async function writeReport(
42:   context: PluginInvocationContext,
43:   input: DeliveryLintInput,
44:   failures: readonly Failure[],
45: ): Promise<ArtifactRef> {
46:   const result = await context.invoke('artifacts.write', {
47:     operation: 'put_json',
48:     resource: {
49:       type: 'artifact.object',
50:       canonicalId: `delivery-lint:${input.moduleId}`,
51:     },
52:     payload: {
53:       namespace: 'kubeclaw.delivery-lint',
54:       mediaType: 'application/json',
55:       value: { moduleId: input.moduleId, passed: failures.length === 0, failures },
56:     },
57:   });
58:   return artifactRef(result);
59: }
60: 
61: async function failureResult(
62:   context: PluginInvocationContext,
63:   input: DeliveryLintInput,
64:   failure: Failure,
65:   outcome: 'blocked' | 'request_fix',
66: ): Promise<StageResult> {
67:   const artifact = await writeReport(context, input, [failure]);
68:   return {
69:     schemaVersion: 'stage-result.v2', outcome,
70:     reason: { code: failure.code, message: failure.message }, artifacts: [artifact],
71:   };
72: }
73: 
74: async function readDockerfile(
75:   context: PluginInvocationContext,
76:   dockerfilePath: string,
77: ): Promise<string> {
78:   const response = await context.invoke('git.repository.read', {
79:     operation: 'read_text',
80:     resource: { type: 'git.repository.path', canonicalId: dockerfilePath },
81:     payload: {},
82:   });
83:   if (typeof response.content !== 'string') throw new Error('repository adapter returned non-text content');
84:   return response.content;
85: }
86: 
87: function staticPathFailures(content: string, staticPath: string | null): readonly Failure[] {
88:   if (staticPath === null) return [];
89:   try {
90:     if (matchesStaticPath(content, staticPath)) return [];
91:   } catch (error) {
92:     return [{ code: 'delivery_lint.static_path_unverifiable',
93:       message: error instanceof Error ? error.message : String(error),
94:       nextStep: 'Use literal COPY destinations and WORKDIR paths that can be checked statically.' }];
95:   }
96:   return [{
97:     code: 'delivery_lint.static_path_mismatch',
98:     message: `No Dockerfile COPY destination matches '${staticPath}'.`,
99:     nextStep: `Align a COPY destination with '${staticPath}'.`,
100:   }];
101: }
102: 
103: export async function execute(
104:   input: DeliveryLintInput,
105:   context: PluginInvocationContext,
106: ): Promise<StageResult> {
107:   if (input.dockerfile === null) {
108:     const artifact = await writeReport(context, input, []);
109:     return { schemaVersion: 'stage-result.v2', outcome: 'passed', artifacts: [artifact] };
110:   }
111:   let dockerfilePath: string;
112:   let staticPath: string | null;
113:   try {
114:     dockerfilePath = safeRepositoryPath(input.dockerfile, 'dockerfile');
115:     staticPath = input.staticPath === null ? null : safeContainerPath(input.staticPath);
116:   } catch (error) {
117:     const failure = {
118:       code: 'delivery_lint.path_invalid',
119:       message: error instanceof Error ? error.message : String(error),
120:       nextStep: 'Use repository-relative paths without traversal.',
121:     };
122:     return failureResult(context, input, failure, 'blocked');
123:   }
124:   let content: string;
125:   try {
126:     content = await readDockerfile(context, dockerfilePath);
127:   } catch (error) {
128:     const failure = {
129:       code: 'delivery_lint.dockerfile_unavailable',
130:       message: error instanceof Error ? error.message : String(error),
131:       nextStep: `Create a readable Dockerfile at ${dockerfilePath}.`,
132:     };
133:     return failureResult(context, input, failure, 'request_fix');
134:   }
135:   const failures = staticPathFailures(content, staticPath);
136:   const artifact = await writeReport(context, input, failures);
137:   if (failures.length > 0) {
138:     return {
139:       schemaVersion: 'stage-result.v2',
140:       outcome: 'request_fix',
141:       reason: { code: failures[0]!.code, message: failures[0]!.message },
142:       artifacts: [artifact],
143:     };
144:   }
145:   return { schemaVersion: 'stage-result.v2', outcome: 'passed', artifacts: [artifact] };
146: }
