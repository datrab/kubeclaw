SOURCE skills/common/plugins/telemetry-observer/src/observer.ts SHA256 21abca7f49d39ccb085bac5aa152c3e2fd7b5b477d7fbc897785a8750854b71c
1: import {
2:   redactStructuredValue,
3:   type ObserverDelivery,
4:   type PluginInvocationContext,
5: } from '@kubeclaw/plugin-sdk';
6: 
7: export function telemetryEnvelope(delivery: ObserverDelivery): Readonly<Record<string, unknown>> {
8:   return Object.freeze({
9:     schemaVersion: 'telemetry-envelope.v2',
10:     deliveryId: delivery.deliveryId,
11:     observer: delivery.observer,
12:     event: Object.freeze({
13:       eventId: delivery.event.eventId,
14:       sequence: delivery.event.sequence,
15:       type: delivery.event.type,
16:       identity: redactStructuredValue(delivery.event.identity),
17:       occurredAt: delivery.event.occurredAt,
18:       causationId: delivery.event.causationId,
19:       payload: redactStructuredValue(delivery.event.payload),
20:     }),
21:   });
22: }
23: 
24: export async function observe(delivery: ObserverDelivery, context: PluginInvocationContext): Promise<void> {
25:   await context.invoke('telemetry.emit', {
26:     operation: 'append',
27:     resource: { type: 'telemetry.event', canonicalId: delivery.event.type },
28:     payload: telemetryEnvelope(delivery),
29:   });
30: }
