61:     && Boolean(registration) && options.registry.grants.has(delivery.observerId) && Boolean(event) && event!.identity.runId === delivery.runId
62:     && event!.sequence === delivery.eventSequence && registration!.registration.subscriptions.includes(event!.type)
63:     && Number.isSafeInteger(delivery.attemptNumber) && delivery.attemptNumber >= 1;
