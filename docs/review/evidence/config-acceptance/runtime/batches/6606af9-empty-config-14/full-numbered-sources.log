22: function validateEvents(options: ObserverRuntimeOptions): Map<string, CanonicalEvent> {
23:   const events = new Map<string, CanonicalEvent>(); const sequence = new Map<string, number>();
24:   for (const { entry } of options.events.records()) {
25:     if (events.has(entry.eventId)) throw new Error(`OBSERVER_EVENT_ID_DUPLICATE:${entry.eventId}`);
26:     const prior = sequence.get(entry.identity.runId) ?? 0;
27:     if (entry.sequence <= prior) throw new Error(`OBSERVER_EVENT_ORDER_INVALID:${entry.identity.runId}:${entry.eventId}`);
28:     sequence.set(entry.identity.runId, entry.sequence); events.set(entry.eventId, entry);
29:   }
30:   return events;
31: }
