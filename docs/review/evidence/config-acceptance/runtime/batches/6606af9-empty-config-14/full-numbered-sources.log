1: import type {PluginInvocationContext,StageResult} from '@kubeclaw/plugin-sdk';
2: import {NAMESPACE,object,exact,text,select,ref} from './protocol.ts';
3: export async function execute(value:unknown,context:PluginInvocationContext):Promise<StageResult> {
4:   try {
5:     const input=object(value);exact(input,['candidateStageId']);const candidate=select(context,text(input.candidateStageId),NAMESPACE);
6:     const result=await context.invoke('demo.handoff',{operation:'deliver',resource:{type:'demo.candidate',canonicalId:candidate.artifactId},payload:{namespace:NAMESPACE,candidate}});
7:     const stored=await context.invoke('artifacts.write',{operation:'put_json',resource:{type:'artifact.object',canonicalId:`demo-delivery:${context.contract.lease.attempt.runId}`},payload:{namespace:NAMESPACE,mediaType:'application/json',value:result}});
8:     return {schemaVersion:'stage-result.v2',outcome:'passed',artifacts:[ref(stored.artifact)]};
9:   }catch(error){return {schemaVersion:'stage-result.v2',outcome:'blocked',reason:{code:'demo.delivery_unresolved',message:error instanceof Error?error.message:String(error)},artifacts:[]};}
10: }
SOURCE skills/nova/plugins/demo-handoff/src/controller-client.ts SHA256 bee2a2f89be6489a9e26af5fd53193191057ec0c061497f2b7a0b49dbaebe315
1: import fs from 'node:fs/promises';
2: import {constants} from 'node:fs';
3: import https from 'node:https';
4: import {sha256Text} from '@kubeclaw/plugin-sdk';
5: import {object,exact,text,retention,type Value} from './protocol.ts';
6: export interface ClientConfig {readonly endpoint:string;readonly tokenPath:string;readonly caPath:string;}
7: async function boundedFile(file:string,limit:number,signal:AbortSignal):Promise<Buffer> {
8:   signal.throwIfAborted();
9:   const handle=await fs.open(file,constants.O_RDONLY|constants.O_NONBLOCK);
10:   try {const stat=await handle.stat();signal.throwIfAborted();if(!stat.isFile()||stat.size<1||stat.size>limit)throw new Error('DEMO_READY_CREDENTIAL_FILE_INVALID');
11:     const buffer=Buffer.alloc(limit+1);let size=0;
12:     while(size<buffer.length){signal.throwIfAborted();const read=await handle.read(buffer,size,buffer.length-size,null);if(read.bytesRead===0)break;size+=read.bytesRead;}
13:     signal.throwIfAborted();if(size>limit)throw new Error('DEMO_READY_CREDENTIAL_FILE_INVALID');return buffer.subarray(0,size);
14:   }finally{await handle.close();}
15: }
16: export async function post(config:ClientConfig,body:string,status:boolean,signal:AbortSignal):Promise<Value> {
17:   if(Buffer.byteLength(body)>16384)throw new Error('DEMO_READY_REQUEST_TOO_LARGE');
18:   const ca=await boundedFile(config.caPath,1024**2,signal),token=(await boundedFile(config.tokenPath,16384,signal)).toString('utf8').trim();
19:   if(!token||/[\s\u0000-\u001f]/u.test(token))throw new Error('DEMO_READY_TOKEN_INVALID');
20:   const url=new URL(config.endpoint);if(status)url.pathname+='/status';
21:   return new Promise((resolve,reject)=>{
22:     const request=https.request(url,{method:'POST',ca,signal,headers:{authorization:`Bearer ${token}`,'content-type':'application/json','content-length':Buffer.byteLength(body)}},response=>{
23:       const chunks:Buffer[]=[];let size=0;
24:       response.on('data',(chunk:Buffer)=>{size+=chunk.length;if(size>16384){request.destroy(new Error('DEMO_READY_RESPONSE_TOO_LARGE'));return;}chunks.push(chunk);});
25:       response.on('error',()=>reject(new Error('DEMO_READY_RESPONSE_UNRESOLVED')));
26:       response.on('end',()=>{
27:         if(signal.aborted){reject(new Error('DEMO_READY_CANCELLED'));return;}
28:         if(response.statusCode!==200){reject(new Error(`DEMO_READY_HTTP_${response.statusCode??0}:unresolved`));return;}
29:         try{resolve(object(JSON.parse(Buffer.concat(chunks).toString('utf8'))));}catch{reject(new Error('DEMO_READY_RESPONSE_INVALID'));}
30:       });
31:     });
32:     request.on('error',()=>reject(new Error('DEMO_READY_TRANSPORT_UNRESOLVED')));request.end(body);
33:   });
34: }
35: export function validateResponse(value:Value,request:Value,body:string):Value {
36:   exact(value,['schemaVersion','leaseName','leaseUID','requestId','state','readyAt','expiresAt','requestDigest','retentionSeconds']);
37:   const ready=Date.parse(text(value.readyAt)),expires=Date.parse(text(value.expiresAt));
38:   if(value.schemaVersion!=='demo-ready-response.v1'||value.state!=='ready-for-acceptance'||value.requestDigest!==sha256Text(body)
39:     ||['leaseName','leaseUID','requestId'].some(key=>value[key]!==request[key])||!Number.isFinite(ready)||value.retentionSeconds!==retention(request.retentionSeconds)||expires!==ready+retention(request.retentionSeconds)*1000
40:     ||expires<=Date.now()||ready<Date.parse(text(request.observedAt)))throw new Error('DEMO_READY_RESPONSE_UNBOUND');
41:   return value;
42: }
