52: function assertCheckpointEvent(observerId: string, checkpoint: ObserverCheckpoint, event: CanonicalEvent | undefined, subscriptions: readonly string[]): void {
53:   if (!event || event.identity.runId !== checkpoint.runId || event.sequence !== checkpoint.sequence || !subscriptions.includes(event.type)) {
54:     throw new Error(`OBSERVER_CHECKPOINT_EVENT_INVALID:${observerId}:${String(checkpoint.eventId)}`);
