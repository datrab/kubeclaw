2: import {canonicalJson,sha256Text,type AdapterActivationContext,type AdapterInstance,type EffectRequest} from '@kubeclaw/plugin-sdk';
3: import {FileDurableRecordStore} from '@kubeclaw/plugin-foundation/observability/durable-records';
4: import {NAMESPACE,exact,object,text,target,ref,type Value,type Reader} from './protocol.ts';
5: import {bind,delivered,deliveryArtifact,requestBody,type BindingConfig,type Binding} from './binding.ts';
6: import {post,validateResponse,type ClientConfig} from './controller-client.ts';
7: interface Config extends BindingConfig,ClientConfig {readonly stateRoot:string;readonly timeoutMs:number;}
8: function configuration(value:Value):Config {
9:   exact(value,['candidateStageId','deliveryStageId','readyStageId','manifestStageId','operatorTarget','endpoint','tokenPath','caPath','stateRoot','timeoutMs']);
10:   const endpoint=new URL(text(value.endpoint));
11:   if(endpoint.protocol!=='https:'||endpoint.pathname!=='/v1/demo-ready'||endpoint.search||endpoint.hash||endpoint.username||endpoint.password||endpoint.href!==value.endpoint)throw new Error('DEMO_READY_ENDPOINT_INVALID');
12:   const absolute=(item:unknown)=>{const result=text(item);if(!path.isAbsolute(result)||path.normalize(result)!==result)throw new Error('DEMO_READY_PATH_INVALID');return result;};
13:   const timeoutMs=Number(value.timeoutMs);if(!Number.isSafeInteger(timeoutMs)||timeoutMs<100||timeoutMs>60000)throw new Error('DEMO_READY_DEADLINE_INVALID');
14:   return {candidateStageId:text(value.candidateStageId),deliveryStageId:text(value.deliveryStageId),readyStageId:text(value.readyStageId),manifestStageId:text(value.manifestStageId),
15:     operatorTarget:target(value.operatorTarget),endpoint:endpoint.href,tokenPath:absolute(value.tokenPath),caPath:absolute(value.caPath),stateRoot:absolute(value.stateRoot),timeoutMs};
16: }
17: function assertRequest(request:EffectRequest,config:Config):void {
18:   if(request.capability!=='demo.handoff'||!['deliver','commit'].includes(request.operation)||request.resource.type!=='demo.candidate'||request.payload.namespace!==NAMESPACE)throw new Error('DEMO_HANDOFF_OPERATION_INVALID');
19:   exact(request.payload,request.operation==='deliver'?['namespace','candidate']:['namespace','candidate','delivery']);
20:   if(request.attempt.stageId!==(request.operation==='deliver'?config.deliveryStageId:config.readyStageId))throw new Error('DEMO_HANDOFF_PRODUCER_DENIED');
21:   if(request.resource.canonicalId!==ref(request.payload.candidate).artifactId)throw new Error('DEMO_HANDOFF_RESOURCE_INVALID');
22: }
23: async function lookup(context:Reader,bound:Binding,config:Config):Promise<Value> {
24:   return object(await context.invoke('operator.receipt',{operation:'lookup',resource:{type:'operator.target',canonicalId:config.operatorTarget},
25:     payload:{deliveryId:bound.deliveryId,stageId:config.deliveryStageId,payload:bound.payload}}));
26: }
27: async function commit(records:FileDurableRecordStore,config:Config,body:string,signal:AbortSignal,recovery:boolean):Promise<Value|undefined> {
28:   const request=object(JSON.parse(body)),key=text(request.requestId),stream='demo-ready/intents';
29:   let previous=(await records.read<Value>(stream)).find(entry=>entry.idempotencyKey===key);
30:   if(previous&&previous.payload.body!==body)throw new Error('DEMO_READY_INTENT_CONFLICT');
31:   if(!previous&&recovery)return undefined;
32:   let first=false;
33:   if(!previous){const admitted=await records.append(stream,key,{schemaVersion:'demo-ready-intent.v1',body});previous=admitted.record;first=admitted.appended;}
34:   signal.throwIfAborted();
