4: interface SourceInput {
5:   readonly source: ReviewSource;
6:   readonly contract: {
7:     readonly projectId: string;
8:     readonly baseRevision: string;
9:     readonly requiredFiles: readonly string[];
10:     readonly modules: readonly Input[];
11:     readonly policy: Readonly<Record<string, unknown>>;
12:   };
13: }
14: 
15: function blueprintFiles(module: Input): readonly {path: string; substep: string | null}[] {
16:   return module.substeps ? module.substeps.map(substep => ({path:`${module.modulePath}/${substep}/FORGE.md`,substep}))
17:     : [{path:`${module.modulePath}/FORGE.md`,substep:null}];
18: }
19: 
20: export async function execute(input: SourceInput, context: PluginInvocationContext): Promise<StageResult> {
21:   try {
22:     const paths = [...new Set([...input.contract.requiredFiles, ...input.contract.modules.flatMap(module => blueprintFiles(module).map(file => file.path))])].sort();
23:     if (input.source.projectId !== input.contract.projectId || canonicalJson([...input.source.paths].sort()) !== canonicalJson(paths)) throw new Error('SOURCE_PREFLIGHT_PATHS_MISMATCH');
24:     const subject = await captureReviewSubject(input.source, input.contract, context);
25:     if (subject.sourceRevision !== input.contract.baseRevision) throw new Error('SOURCE_PREFLIGHT_BASELINE_CHANGED');
26:     for (const module of input.contract.modules) {
27:       const declarations = blueprintFiles(module).flatMap(file => {
28:         const content = subject.files.find(entry => entry.path === file.path)?.content;
29:         if (content === undefined) throw new Error('SOURCE_PREFLIGHT_BLUEPRINT_MISSING');
30:         return parseDeclaration(module.moduleId, file.substep, content);
31:       });
32:       const failures = validateDeliveryPaths(module, declarations);
33:       if (failures.length) throw new Error(`SOURCE_PREFLIGHT_DELIVERY_REQUIRED:${canonicalJson(failures)}`);
34:     }
35:     const stored = await context.invoke('artifacts.write', {operation:'put_json',resource:{type:'artifact.object',canonicalId:'source-preflight'},
36:       payload:{...(subject?.identityEncoding ? {encoding:subject.identityEncoding} : {}), namespace:'kubeclaw.preflight-contract',mediaType:'application/json',value:{schemaVersion:'source-preflight.v1',outcome:'passed',contract:input.contract,subject}}});
37:     return {schemaVersion:'stage-result.v2',outcome:'passed',artifacts:[stored.artifact as ArtifactRef]};
38:   } catch (error) {
39:     return {schemaVersion:'stage-result.v2',outcome:'blocked',artifacts:[],reason:{code:'source_preflight.invalid',message:error instanceof Error ? error.message : String(error)}};
40:   }
41: }
SOURCE skills/nova/plugins/preflight-contract/src/stage.ts SHA256 75da42cf49cb7a655e9edb4e4928bd3e708ece30f592cb5a14aa2627ce3fc4ef
1: import { parseDeclaration, validateDeliveryPaths, type Input, type Failure } from './declarations.ts';
2: import type { ArtifactRef, PluginInvocationContext, StageResult } from '@kubeclaw/plugin-sdk';
3: 
4: function safePath(value: string, label: string): string {
5:   if (
6:     value.length === 0
7:     || value.includes('\0')
8:     || /[\r\n]/.test(value)
9:     || value.startsWith('/')
10:     || /^[A-Za-z]:[\\/]/.test(value)
11:     || value.split(/[\\/]+/).includes('..')
12:   ) throw new Error(`${label} must be a non-empty repository-relative path without traversal`);
13:   return value.replaceAll('\\', '/').replace(/\/+$/, '');
14: }
15: 
16: async function readText(context: PluginInvocationContext, file: string): Promise<string> {
17:   const response = await context.invoke('git.repository.read', {
18:     operation: 'read_text',
19:     resource: { type: 'git.repository.path', canonicalId: file },
20:     payload: {},
21:   });
22:   if (typeof response.content !== 'string') throw new Error('repository adapter returned non-text content');
23:   return response.content;
24: }
25: 
26: async function readBlueprint(input: Input, context: PluginInvocationContext): Promise<readonly string[]> {
27:   const moduleRoot = safePath(input.modulePath, 'modulePath');
28:   if (input.substeps !== undefined) {
29:     if (input.substeps.length === 0) throw new Error('FORGE_SUBSTEP_INVALID:at least one substep is required');
30:     const parts: string[] = [];
31:     for (const raw of input.substeps) {
32:       const substep = safePath(raw, 'substep');
33:       try {
34:         parts.push(...parseDeclaration(input.moduleId, substep, await readText(context, `${moduleRoot}/${substep}/FORGE.md`)));
35:       } catch (error) {
36:         throw new Error(`FORGE_BLUEPRINT_MISSING:${substep}:${error instanceof Error ? error.message : String(error)}`);
37:       }
38:     }
39:     return parts;
40:   }
41:   try {
42:     return parseDeclaration(input.moduleId, null, await readText(context, `${moduleRoot}/FORGE.md`));
43:   } catch (error) {
44:     throw new Error(`FORGE_BLUEPRINT_MISSING:${error instanceof Error ? error.message : String(error)}`);
45:   }
46: }
47: 
48: async function report(
49:   context: PluginInvocationContext,
50:   input: Input,
51:   failures: readonly Failure[],
52: ): Promise<ArtifactRef> {
53:   const stored = await context.invoke('artifacts.write', {
54:     operation: 'put_json',
55:     resource: { type: 'artifact.object', canonicalId: `preflight-contract:${input.moduleId}` },
56:     payload: {
57:       namespace: 'kubeclaw.preflight-contract',
58:       mediaType: 'application/json',
59:       value: { moduleId: input.moduleId, passed: failures.length === 0, failures },
60:     },
61:   });
62:   return stored.artifact as ArtifactRef;
63: }
64: 
65: export async function execute(input: Input, context: PluginInvocationContext): Promise<StageResult> {
66:   let failures: readonly Failure[];
67:   try {
68:     failures = validateDeliveryPaths(input, await readBlueprint(input, context));
69:   } catch (error) {
70:     const message = error instanceof Error ? error.message : String(error);
71:     const code = message.includes('FORGE_DECLARATION_INVALID') ? 'preflight_contract.declaration_invalid'
72:       : message.startsWith('FORGE_SUBSTEP_INVALID')
73:       ? 'preflight_contract.substep_invalid'
74:       : message.includes('must be a non-empty repository-relative')
75:         ? 'preflight_contract.path_invalid'
76:         : 'preflight_contract.blueprint_missing';
77:     const failure = { code, message, nextStep: 'Provide readable, repository-local Forge blueprint files.' };
78:     return {
79:       schemaVersion: 'stage-result.v2',
80:       outcome: 'blocked',
81:       reason: { code, message },
82:       artifacts: [await report(context, input, [failure])],
83:     };
84:   }
85:   const artifact = await report(context, input, failures);
86:   if (failures.length > 0) return {
87:     schemaVersion: 'stage-result.v2',
88:     outcome: 'request_fix',
89:     reason: { code: failures[0]!.code, message: failures[0]!.message },
90:     artifacts: [artifact],
91:   };
92:   return { schemaVersion: 'stage-result.v2', outcome: 'passed', artifacts: [artifact] };
93: }
SOURCE skills/nova/plugins/preflight-contract/src/declarations.ts SHA256 deb342dd39f6612567e5d67fc708a02a0db42ae9ff20027bb448a594c7cee309
1: export interface Input {
2:   readonly moduleId: string;
3:   readonly modulePath: string;
4:   readonly substeps?: readonly string[];
5:   readonly ownedPaths: readonly string[];
6:   readonly serveDockerfile: string | null;
7:   readonly apiSpecFile: string | null;
8: }
9: export interface Failure { readonly code: string; readonly message: string; readonly nextStep: string; }
10: 
11: function invalid(reason: string): never { throw new Error(`FORGE_DECLARATION_INVALID:${reason}`); }
12: 
13: /** Paths are canonical repository-relative identities, never basenames or suffixes. */
14: function deliveryPath(value: unknown): string {
15:   if (typeof value !== 'string' || value.trim() !== value || /[\\\x00-\x1f:]/u.test(value)
16:     || value.split('/').some(part => !part || part === '.' || part === '..')) invalid('path');
17:   return value;
18: }
19: 
20: function declarationBlock(content: string): string {
21:   const blocks: string[] = []; let fence = ''; let tagged = false; let lines: string[] = [];
22:   for (const line of content.split(/\r?\n/u)) {
23:     const marker = /^( {0,3})(`{3,}|~{3,})(.*)$/u.exec(line);
24:     if (!fence && marker) {
25:       fence = marker[2]!; tagged = marker[3] === 'kubeclaw-deliverables'; lines = [];
26:     } else if (fence && marker && marker[2]![0] === fence[0]
27:       && marker[2]!.length >= fence.length && !marker[3]!.trim()) {
28:       if (tagged) blocks.push(lines.join('\n'));
29:       fence = ''; tagged = false;
30:     } else if (fence && tagged) lines.push(line);
31:   }
32:   if (tagged || blocks.length !== 1) invalid('exactly_one_complete_block_required');
33:   return blocks[0]!;
34: }
35: 
36: export function parseDeclaration(moduleId: string, substep: string | null, content: string): readonly string[] {
37:   let value;
38:   try { value = JSON.parse(declarationBlock(content)); } catch { invalid('block_or_json'); }
39:   if (!value || typeof value !== 'object' || Array.isArray(value)
40:     || Object.keys(value).sort().join(',') !== 'deliverables,moduleId,schemaVersion,substep'
41:     || value.schemaVersion !== 'forge-deliverables.v1' || value.moduleId !== moduleId
42:     || value.substep !== substep || !Array.isArray(value.deliverables)) invalid('identity_or_shape');
43:   const paths = value.deliverables.map(deliveryPath) as string[];
44:   if (new Set(paths).size !== paths.length) invalid('duplicate_path');
45:   return paths;
46: }
47: 
48: export function validateDeliveryPaths(input: Input, declarations: readonly string[]): readonly Failure[] {
49:   const failures: Failure[] = [];
50:   const owned = input.ownedPaths.map(value => deliveryPath(value.replace(/\/$/u, '')));
51:   const owns = (file: string) => owned.some(prefix => file === prefix || file.startsWith(`${prefix}/`));
52:   if (new Set(declarations).size !== declarations.length) invalid('duplicate_substep_assignment');
53:   for (const [kind, raw] of [['serve_dockerfile', input.serveDockerfile], ['api_spec', input.apiSpecFile]] as const) {
54:     if (raw === null) continue;
55:     const file = deliveryPath(raw);
56:     if (kind === 'serve_dockerfile' && !owns(file)) continue;
57:     if (!declarations.includes(file)) failures.push({code: `preflight_contract.${kind}_not_declared`,
58:       message: `Required deliverable '${file}' is not explicitly declared in this module's Forge blueprint.`,
59:       nextStep: `Declare the exact repository-relative path '${file}' in the owning blueprint's kubeclaw-deliverables block.`});
60:   }
61:   return failures;
62: }
SOURCE skills/nova/core/telemetry/observers.ts SHA256 b46b9a70b190bf8541d96188221a63acc1e9c03ff6204a9e94b37c944306aafd
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import type { LifecycleEvent, ObserverCheckpoint, PluginDomainEvent } from '@kubeclaw/plugin-sdk';
4: import type { ActivatedRegistry } from '@kubeclaw/plugin-foundation/registry/activation';
5: import type { GrantedRegistry } from '@kubeclaw/plugin-foundation/registry/capabilities';
6: import { validateReferencedValue } from '@kubeclaw/plugin-foundation/registry/schema';
7: import { FrozenMap } from '@kubeclaw/plugin-foundation/registry/frozen-map';
8: import type { AdapterRuntime } from '../execution/adapters.ts';
9: import type { FileJournal} from '../state/journal.ts';
10: import { type JournalRecord } from '../state/journal.ts';
11: import { deliverObserver } from './observer-delivery.ts';
12: import { checkpointKey, deliveryKey, recoverObservers } from './observer-recovery.ts';
13: 
14: export type CanonicalEvent = LifecycleEvent | PluginDomainEvent;
15: export interface ObserverFailure { readonly observerId: string; readonly eventId: string; readonly error: string }
16: export interface ObserverDrainResult { readonly delivered: number; readonly failures: readonly ObserverFailure[] }
17: export interface ObserverDeliveryRecord {
18:   readonly schemaVersion: 'observer-delivery-record.v2'; readonly deliveryId: string; readonly observerId: string; readonly runId: string;
19:   readonly eventId: string; readonly eventSequence: number; readonly attemptNumber: number; readonly status: 'started' | 'completed' | 'failed';
20:   readonly recordedAt: string; readonly error: string | null;
21: }
22: export interface ObserverRuntimeOptions {
23:   readonly registry: GrantedRegistry; readonly activated: ActivatedRegistry; readonly adapters: AdapterRuntime; readonly events: FileJournal<CanonicalEvent>;
24:   readonly checkpoints: FileJournal<ObserverCheckpoint>; readonly deliveries: FileJournal<ObserverDeliveryRecord>;
25:   readonly configs: ReadonlyMap<string, Readonly<Record<string, unknown>>>; readonly now?: () => Date; readonly wait?: (milliseconds: number) => Promise<void>;
26: }
27: function globalId(pluginId: string, localId: string): string { return `${pluginId}:${localId}`; }
28: function errorText(error: unknown): string { return error instanceof Error ? error.message : String(error); }
29: export function isObserverDeliveryInput(event: CanonicalEvent): boolean {
30:   return !(event.schemaVersion === 'lifecycle-event.v2' && event.type.startsWith('effect.')
31:     && typeof event.identity.attemptId === 'string' && event.identity.attemptId.startsWith('observer:'));
32: }
33: 
34: export class ObserverRuntime {
35:   readonly #options: ObserverRuntimeOptions; readonly #now: () => Date; readonly #wait: (milliseconds: number) => Promise<void>;
36:   readonly #checkpoints: Map<string, ObserverCheckpoint>; readonly #attempts: Map<string, number>; readonly #completed: Set<string>;
37:   constructor(options: ObserverRuntimeOptions) {
38:     this.#options = options; this.#now = options.now ?? (() => new Date());
39:     this.#wait = options.wait ?? ((milliseconds) => new Promise((resolve) => { const timer = setTimeout(resolve, milliseconds); timer.unref(); }));
40:     const recovered = recoverObservers(options); this.#checkpoints = recovered.checkpoints; this.#attempts = recovered.attempts; this.#completed = recovered.completed;
41:   }
42: 
43:   #recordDelivery(observerId: string, event: CanonicalEvent, attemptNumber: number, status: ObserverDeliveryRecord['status'], error: string | null): void {
44:     this.#options.deliveries.append({ schemaVersion: 'observer-delivery-record.v2', deliveryId: `delivery:${observerId}:${event.eventId}`,
45:       observerId, runId: event.identity.runId, eventId: event.eventId, eventSequence: event.sequence, attemptNumber, status,
46:       recordedAt: this.#now().toISOString(), error });
47:     const key = deliveryKey(observerId, event.eventId); this.#attempts.set(key, Math.max(this.#attempts.get(key) ?? 0, attemptNumber));
48:     if (status === 'completed') this.#completed.add(key);
49:   }
50: 
51:   #commitCheckpoint(observerId: string, event: CanonicalEvent): boolean {
52:     const entry = this.#options.registry.snapshot.observers.get(observerId); if (!entry) throw new Error(`OBSERVER_NOT_REGISTERED:${observerId}`);
53:     const key = checkpointKey(observerId, event.identity.runId); const checkpoint: ObserverCheckpoint = { schemaVersion: 'observer-checkpoint.v2',
54:       observer: entry.provenance, runId: event.identity.runId, sequence: event.sequence, eventId: event.eventId, updatedAt: this.#now().toISOString() };
55:     validateReferencedValue(fs.realpathSync(path.join(entry.package.root, entry.registration.checkpointSchema)), { sequence: checkpoint.sequence, eventId: checkpoint.eventId }, this.#options.registry.snapshot.schemas);
56:     const appended = this.#options.checkpoints.transact((records, append) => this.#appendCheckpoint(records, append, observerId, event, checkpoint));
57:     this.#checkpoints.set(key, checkpoint); return appended;
58:   }
59: 
60:   #appendCheckpoint(records: readonly JournalRecord<ObserverCheckpoint>[], append: (entry: ObserverCheckpoint) => JournalRecord<ObserverCheckpoint>, observerId: string, event: CanonicalEvent, checkpoint: ObserverCheckpoint): boolean {
61:     const latest = records.map(({ entry }) => entry).filter((candidate) => globalId(candidate.observer.package.package.pluginId, candidate.observer.registrationId) === observerId
62:       && candidate.runId === event.identity.runId).at(-1);
63:     if (latest && latest.sequence > event.sequence) throw new Error(`OBSERVER_CHECKPOINT_REGRESSION:${observerId}:${event.identity.runId}`);
64:     if (latest && latest.sequence === event.sequence) {
65:       if (latest.eventId !== event.eventId) throw new Error(`OBSERVER_CHECKPOINT_CONFLICT:${observerId}:${event.identity.runId}`); return false;
66:     }
67:     append(checkpoint); return true;
68:   }
69: 
70:   async drain(): Promise<ObserverDrainResult> {
71:     let delivered = 0; const failures: ObserverFailure[] = [];
72:     const events = [...this.#options.events.refresh()].filter(({ entry }) => isObserverDeliveryInput(entry));
73:     for (const [observerId, entry] of new FrozenMap([...this.#options.registry.snapshot.observers])) {
74:       if (!this.#options.registry.grants.has(observerId)) continue;
75:       delivered += await this.#drainObserver(observerId, entry.registration.subscriptions, entry.registration.failurePolicy, events, failures);
76:     }
77:     return Object.freeze({ delivered, failures: Object.freeze(failures) });
78:   }
79: 
80:   async #drainObserver(observerId: string, subscriptions: readonly string[], policy: { readonly maxAttempts: number; readonly backoffMs: number; readonly mode: string }, events: readonly JournalRecord<CanonicalEvent>[], failures: ObserverFailure[]): Promise<number> {
81:     let delivered = 0; const blockedRuns = new Set<string>();
82:     for (const record of events) {
83:       const event = record.entry;
84:       if (!subscriptions.includes(event.type) || blockedRuns.has(event.identity.runId)) continue;
85:       if ((this.#checkpoints.get(checkpointKey(observerId, event.identity.runId))?.sequence ?? 0) >= event.sequence) continue;
86:       const error = await this.#attemptDelivery(observerId, record, policy);
87:       if (error) { const failure = { observerId, eventId: event.eventId, error }; failures.push(failure);
88:         if (policy.mode === 'required') throw new Error(`REQUIRED_OBSERVER_DELIVERY_FAILED:${observerId}:${event.eventId}:${error}`);
89:         blockedRuns.add(event.identity.runId); continue; }
90:       if (this.#commitCheckpoint(observerId, event)) delivered += 1;
91:     }
92:     return delivered;
93:   }
94: 
95:   async #attemptDelivery(observerId: string, record: JournalRecord<CanonicalEvent>, policy: { readonly maxAttempts: number; readonly backoffMs: number }): Promise<string | undefined> {
96:     const event = record.entry; const key = deliveryKey(observerId, event.eventId);
97:     if (this.#completed.has(key)) return undefined;
98:     const prior = this.#attempts.get(key) ?? 0;
99:     if (prior >= policy.maxAttempts) return 'OBSERVER_DELIVERY_ATTEMPTS_EXHAUSTED';
100:     let error: unknown;
101:     for (let attempt = prior + 1; attempt <= policy.maxAttempts; attempt += 1) { this.#recordDelivery(observerId, event, attempt, 'started', null);
102:       try { await deliverObserver(this.#options, this.#now, observerId, record, attempt); this.#recordDelivery(observerId, event, attempt, 'completed', null); return undefined; }
103:       catch (caught) { error = caught; this.#recordDelivery(observerId, event, attempt, 'failed', errorText(caught));
104:         if (attempt < policy.maxAttempts && policy.backoffMs > 0) await this.#wait(policy.backoffMs); }
105:     }
106:     return errorText(error);
107:   }
108: }
