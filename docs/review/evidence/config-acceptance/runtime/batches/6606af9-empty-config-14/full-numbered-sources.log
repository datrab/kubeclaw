SOURCE skills/nova/plugins/blueprint-sync/src/stage.ts SHA256 77735e30c7109aee73cd6c396fe11858275935df1f251aae77d582ed4a7f2765
1: import { approvedSource, type SourceBinding, type ArtifactRef, type PluginInvocationContext, type StageResult } from '@kubeclaw/plugin-sdk';
2: interface Input {
3:   readonly sourceBinding?: SourceBinding;
4:   readonly blueprintId: string;
5:   readonly repositoryRoot: string;
6:   readonly branchRef: string;
7:   readonly controlPaths: readonly string[];
8: }
9: export function validateInput(input: Input): void {
10:   if (!input.blueprintId || !input.repositoryRoot || !input.branchRef) throw new Error('BLUEPRINT_SYNC_INPUT_INVALID');
11:   if (!Array.isArray(input.controlPaths) || input.controlPaths.length === 0) throw new Error('BLUEPRINT_SYNC_PATHS_REQUIRED');
12:   if (new Set(input.controlPaths).size !== input.controlPaths.length) throw new Error('BLUEPRINT_SYNC_PATHS_DUPLICATE');
13: }
14: function validateApprovedInput(input: Input, approval: Awaited<ReturnType<typeof approvedSource>>): void {
15:   if (approval && (input.repositoryRoot !== approval.subject.repositoryRoot || input.branchRef !== approval.subject.architectureRef
16:     || input.controlPaths.some(file => !approval.subject.paths.includes(file)))) throw new Error('SOURCE_APPROVAL_SYNC_INPUT_MISMATCH');
17: }
18: export async function execute(input: Input, context: PluginInvocationContext): Promise<StageResult> {
19:   validateInput(input);
20:   const approval = await approvedSource(context, input.sourceBinding);
21:   validateApprovedInput(input, approval);
22:   const sync = await context.invoke('git.sync', {
23:     operation: 'sync_paths',
24:     resource: { type: 'git.repository', canonicalId: input.repositoryRoot },
25:     payload: { ref: approval?.subject.architectureRevision ?? input.branchRef, paths: input.controlPaths, ...(approval ? { approvedSource: approval } : {}) },
26:   });
27:   const synced = Array.isArray(sync.synced) ? sync.synced : [];
28:   const missing = Array.isArray(sync.missing) ? sync.missing : [];
29:   let sourceRevision = approval?.sourceRevision;
30:   if (synced.length > 0) {
31:     const committed = await context.invoke('git.commit', {
32:       operation: 'commit', resource: { type: 'git.repository', canonicalId: input.repositoryRoot },
33:       payload: {
34:         paths: synced.map((entry) => (entry as Record<string, unknown>).path),
35:         message: `[blueprint-sync] Sync ${synced.length} control file(s) from architecture`,
36:         ...(approval ? { approvedSource: approval } : {}),
37:       },
38:     });
39:     if (approval) {
40:       if (typeof committed.sourceRevision !== 'string') throw new Error('SOURCE_APPROVAL_SYNC_REVISION_MISSING');
41:       sourceRevision = committed.sourceRevision;
42:     }
43:   }
44:   const summary = { blueprintId: input.blueprintId, branchRef: input.branchRef, synced, missing,
45:     ...(approval ? { subjectDigest: approval.subject.digest, repositoryRoot: input.repositoryRoot,
46:       architectureRevision: approval.subject.architectureRevision, sourceBefore: approval.subject.sourceRevision, sourceRevision } : {}) };
47:   await context.invoke('state.append', {
48:     operation: 'append', resource: { type: 'state.namespace', canonicalId: 'kubeclaw.blueprint-sync' },
49:     payload: { type: 'blueprint.controls.synced', ...summary },
50:   });
51:   const stored = await context.invoke('artifacts.write', {
52:     operation: 'put_json', resource: { type: 'artifact.object', canonicalId: `blueprint-sync:${input.blueprintId}` },
53:     payload: { ...(approval?.subject.identityEncoding ? {encoding:approval.subject.identityEncoding} : {}), namespace: 'kubeclaw.blueprint-sync', mediaType: 'application/json', value: summary },
54:   });
55:   const artifacts = [stored.artifact as ArtifactRef];
56:   if (missing.length > 0) {
57:     return {
58:       schemaVersion: 'stage-result.v2', outcome: 'request_fix',
59:       reason: { code: 'blueprint.control_files_missing', message: `${missing.length} declared control file(s) are absent`, details: { missing } },
60:       artifacts,
61:     };
62:   }
63:   return { schemaVersion: 'stage-result.v2', outcome: 'passed', artifacts };
64: }
