SOURCE skills/nova/plugins/human-approval/src/approval.ts SHA256 5798d5bddb20d62a320114387f3f8df4275b83972f1cb41d9e4a823e92fee99d
1: import type { StageResult, WaitRequest } from '@kubeclaw/plugin-sdk';
2: 
3: export const APPROVAL_SIGNAL_TYPE = 'approval.resolved' as const;
4: export const DEFAULT_APPROVAL_TIMEOUT_MINUTES = 60;
5: const MAX_APPROVAL_TIMEOUT_MINUTES = 525_600;
6: 
7: type UnknownRecord = Readonly<Record<string, unknown>>;
8: 
9: export interface ApprovalInput {
10:   readonly summary: string;
11: }
12: 
13: export interface ApprovalConfig {
14:   readonly target: string;
15:   readonly issuerId: string;
16:   readonly timeoutMinutes: number;
17: }
18: 
19: interface ApprovalIssuer {
20:   readonly type: 'operator';
21:   readonly id: string;
22: }
23: 
24: export type ApprovalGuidance =
25:   | { readonly decision: 'pending' }
26:   | {
27:       readonly decision: 'approved' | 'rejected';
28:       readonly issuer: ApprovalIssuer;
29:       readonly reason?: string;
30:     };
31: 
32: function record(value: unknown, label: string): UnknownRecord {
33:   if (!value || typeof value !== 'object' || Array.isArray(value)) {
34:     throw new Error(`APPROVAL_${label}_INVALID`);
35:   }
36:   return value as UnknownRecord;
37: }
38: 
39: function exactKeys(value: UnknownRecord, allowed: readonly string[], label: string): void {
40:   const allowedKeys = new Set(allowed);
41:   const unknown = Object.keys(value).find((key) => !allowedKeys.has(key));
42:   if (unknown) throw new Error(`APPROVAL_${label}_UNKNOWN_FIELD:${unknown}`);
43: }
44: 
45: function requiredText(value: unknown, label: string, maximum: number): string {
46:   if (typeof value !== 'string') throw new Error(`APPROVAL_${label}_INVALID`);
47:   const normalized = value.trim();
48:   if (
49:     normalized.length === 0
50:     || normalized.length > maximum
51:     || normalized.includes('\0')
52:     || /[\r\n]/.test(normalized)
53:   ) {
54:     throw new Error(`APPROVAL_${label}_INVALID`);
55:   }
56:   return normalized;
57: }
58: 
59: export function parseApprovalInput(value: unknown): ApprovalInput {
60:   const input = record(value, 'INPUT');
61:   exactKeys(input, ['summary'], 'INPUT');
62:   return Object.freeze({
63:     summary: requiredText(input.summary, 'SUMMARY', 10_000),
64:   });
65: }
66: 
67: export function parseApprovalConfig(value: unknown): ApprovalConfig {
68:   const config = record(value, 'CONFIG');
69:   exactKeys(config, ['target', 'issuerId', 'timeoutMinutes'], 'CONFIG');
70:   const timeout = config.timeoutMinutes ?? DEFAULT_APPROVAL_TIMEOUT_MINUTES;
71:   if (
72:     !Number.isSafeInteger(timeout)
73:     || Number(timeout) < 1
74:     || Number(timeout) > MAX_APPROVAL_TIMEOUT_MINUTES
75:   ) {
76:     throw new Error('APPROVAL_TIMEOUT_MINUTES_INVALID');
77:   }
78:   return Object.freeze({
79:     target: requiredText(config.target, 'TARGET', 1_024),
80:     issuerId: requiredText(config.issuerId, 'ISSUER_ID', 1_024),
81:     timeoutMinutes: Number(timeout),
82:   });
83: }
84: 
85: function parseIssuer(value: unknown, expectedIssuerId: string): ApprovalIssuer {
86:   const issuer = record(value, 'ISSUER');
87:   exactKeys(issuer, ['type', 'id'], 'ISSUER');
88:   if (issuer.type !== 'operator') throw new Error('APPROVAL_ISSUER_TYPE_INVALID');
89:   const id = requiredText(issuer.id, 'ISSUER_ID', 1_024);
90:   if (id !== expectedIssuerId) throw new Error('APPROVAL_ISSUER_DENIED');
91:   return Object.freeze({ type: 'operator', id });
92: }
93: 
94: export function parseApprovalGuidance(
95:   value: unknown,
96:   expectedIssuerId: string,
97: ): ApprovalGuidance {
98:   if (value === undefined) return Object.freeze({ decision: 'pending' });
99:   const guidance = record(value, 'GUIDANCE');
100:   const decision = guidance.decision;
101:   if (decision === 'pending') {
102:     exactKeys(guidance, ['decision'], 'GUIDANCE');
103:     return Object.freeze({ decision });
104:   }
105:   if (decision !== 'approved' && decision !== 'rejected') {
106:     throw new Error('APPROVAL_DECISION_INVALID');
107:   }
108:   exactKeys(guidance, ['decision', 'issuer', 'reason'], 'GUIDANCE');
109:   const issuer = parseIssuer(guidance.issuer, expectedIssuerId);
110:   const reason = guidance.reason === undefined
111:     ? undefined
112:     : requiredText(guidance.reason, 'REASON', 4_096);
113:   return Object.freeze({
114:     decision,
115:     issuer,
116:     ...(reason === undefined ? {} : { reason }),
117:   });
118: }
119: 
120: export function calculateApprovalExpiresAt(
121:   now: Date,
122:   timeoutMinutes: number,
123: ): string {
124:   if (Number.isNaN(now.getTime())) throw new Error('APPROVAL_CLOCK_INVALID');
125:   if (
126:     !Number.isSafeInteger(timeoutMinutes)
127:     || timeoutMinutes < 1
128:     || timeoutMinutes > MAX_APPROVAL_TIMEOUT_MINUTES
129:   ) {
130:     throw new Error('APPROVAL_TIMEOUT_MINUTES_INVALID');
131:   }
132:   return new Date(now.getTime() + timeoutMinutes * 60_000).toISOString();
133: }
134: 
135: export function resultForApprovalGuidance(
136:   guidance: Exclude<ApprovalGuidance, { readonly decision: 'pending' }>,
137: ): StageResult {
138:   if (guidance.decision === 'approved') {
139:     return {
140:       schemaVersion: 'stage-result.v2',
141:       outcome: 'passed',
142:       artifacts: [],
143:     };
144:   }
145:   if (guidance.decision !== 'rejected') throw new Error('APPROVAL_DECISION_INVALID');
146:   return {
147:     schemaVersion: 'stage-result.v2',
148:     outcome: 'blocked',
149:     reason: {
150:       code: 'approval.rejected',
151:       message: guidance.reason ?? 'Approval was rejected.',
152:       details: {
153:         issuer: guidance.issuer.id,
154:       },
155:     },
156:     artifacts: [],
157:   };
158: }
159: 
160: export function validateCreatedWait(
161:   value: unknown,
162:   expected: {
163:     readonly issuerId: string;
164:     readonly expiresAt: string;
165:     readonly summary: string;
166:   },
167: ): WaitRequest {
168:   const response = record(value, 'WAIT_RESPONSE');
169:   exactKeys(response, ['created', 'wait'], 'WAIT_RESPONSE');
170:   if (typeof response.created !== 'boolean') throw new Error('APPROVAL_WAIT_CREATED_INVALID');
171:   const wait = record(response.wait, 'WAIT_RESPONSE');
172:   exactKeys(
173:     wait,
174:     ['schemaVersion', 'waitId', 'kind', 'signalType', 'authorizedIssuer', 'expiresAt', 'request'],
175:     'WAIT_RESPONSE',
176:   );
177:   if (wait.schemaVersion !== 'wait-request.v2') throw new Error('APPROVAL_WAIT_SCHEMA_INVALID');
178:   const waitId = requiredText(wait.waitId, 'WAIT_ID', 2_048);
179:   if (wait.kind !== 'signal') throw new Error('APPROVAL_WAIT_KIND_INVALID');
180:   if (wait.signalType !== APPROVAL_SIGNAL_TYPE) throw new Error('APPROVAL_WAIT_SIGNAL_INVALID');
181:   const issuer = parseIssuer(wait.authorizedIssuer, expected.issuerId);
182:   if (wait.expiresAt !== expected.expiresAt) throw new Error('APPROVAL_WAIT_EXPIRY_INVALID');
183:   const request = record(wait.request, 'WAIT_REQUEST');
184:   exactKeys(request, ['summary'], 'WAIT_REQUEST');
185:   if (request.summary !== expected.summary) throw new Error('APPROVAL_WAIT_REQUEST_INVALID');
186:   return Object.freeze({
187:     schemaVersion: 'wait-request.v2',
188:     waitId,
189:     kind: 'signal',
190:     signalType: APPROVAL_SIGNAL_TYPE,
191:     authorizedIssuer: issuer,
192:     expiresAt: expected.expiresAt,
193:     request: Object.freeze({ summary: expected.summary }),
194:   });
195: }
196: 
197: export function pendingApprovalResult(wait: WaitRequest): StageResult {
198:   return {
199:     schemaVersion: 'stage-result.v2',
200:     outcome: 'wait',
201:     reason: {
202:       code: 'approval.pending',
203:       message: 'Waiting for approval.',
204:     },
205:     artifacts: [],
206:     wait,
207:   };
208: }
SOURCE skills/nova/plugins/human-approval/src/architecture-approval.ts SHA256 3a6073a7c6ef98ba417ed1b38827c15b3449e70ac89b8a126b7ad14f380e304b
1: import {verifiedArtifactJsonText} from '@kubeclaw/plugin-sdk';
2: import { canonicalJson, sha256Text, verifyReviewSubject, type ArtifactRef, type PluginInvocationContext, type StageResult } from '@kubeclaw/plugin-sdk';
3: import { execute as executeApproval } from './stage.ts';
4: 
5: interface ArchitectureApprovalInput {
6:   readonly summary: string;
7:   readonly artifactId: string;
8:   readonly namespace: string;
9: }
10: 
11: function requiredText(value: unknown, label: string, maximum: number): string {
12:   if (typeof value !== 'string') throw new Error(`ARCHITECTURE_APPROVAL_${label}_INVALID`);
13:   const normalized = value.trim();
14:   if (!normalized || normalized.length > maximum || normalized.includes('\0') || /[\r\n]/u.test(normalized)) {
15:     throw new Error(`ARCHITECTURE_APPROVAL_${label}_INVALID`);
16:   }
17:   return normalized;
18: }
19: 
20: function parseInput(value: unknown): ArchitectureApprovalInput {
21:   if (!value || typeof value !== 'object' || Array.isArray(value)) {
22:     throw new Error('ARCHITECTURE_APPROVAL_INPUT_INVALID');
23:   }
24:   const input = value as Record<string, unknown>;
25:   const allowed = new Set(['summary', 'artifactId', 'namespace']);
26:   const unknown = Object.keys(input).find((key) => !allowed.has(key));
27:   if (unknown) throw new Error(`ARCHITECTURE_APPROVAL_INPUT_UNKNOWN_FIELD:${unknown}`);
28:   return Object.freeze({
29:     summary: requiredText(input.summary, 'SUMMARY', 4_096),
30:     artifactId: requiredText(input.artifactId, 'ARTIFACT_ID', 2_048),
31:     namespace: requiredText(input.namespace, 'NAMESPACE', 1_024),
32:   });
33: }
34: 
35: function reportText(value: unknown, label: string, maximum: number): string {
36:   if (typeof value !== 'string' || value.includes('\0')) {
37:     throw new Error(`ARCHITECTURE_APPROVAL_${label}_INVALID`);
38:   }
39:   const normalized = value.replace(/\s+/gu, ' ').trim();
40:   if (!normalized || normalized.length > maximum) {
41:     throw new Error(`ARCHITECTURE_APPROVAL_${label}_INVALID`);
42:   }
43:   return normalized;
44: }
45: 
46: function findingSummary(value: unknown, maximum: number): string {
47:   if (!value || typeof value !== 'object' || Array.isArray(value)) {
48:     throw new Error('ARCHITECTURE_APPROVAL_ARTIFACT_INVALID');
49:   }
50:   const findings = (value as Record<string, unknown>).findings;
51:   if (!Array.isArray(findings)) throw new Error('ARCHITECTURE_APPROVAL_FINDINGS_INVALID');
52:   if (findings.length === 0) return '';
53:   const fragments = findings.map((entry, index) => {
54:     if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {
55:       throw new Error(`ARCHITECTURE_APPROVAL_FINDING_INVALID:${index}`);
56:     }
57:     const finding = entry as Record<string, unknown>;
58:     if (finding.severity === 'blocking') throw new Error('ARCHITECTURE_APPROVAL_BLOCKING_FINDING');
59:     if (!['error', 'warn', 'info'].includes(String(finding.severity))) {
60:       throw new Error('ARCHITECTURE_APPROVAL_FINDING_SEVERITY_INVALID');
61:     }
62:     return [
63:       reportText(finding.severity, `FINDING_${index}_SEVERITY`, 32).toUpperCase(),
64:       reportText(finding.id, `FINDING_${index}_ID`, 256),
65:       reportText(finding.explanation, `FINDING_${index}_EXPLANATION`, 8_192),
66:       `Remediation: ${reportText(finding.remediation, `FINDING_${index}_REMEDIATION`, 8_192)}`,
67:     ].join(' · ');
68:   });
69:   const prefix = `${findings.length} architecture finding${findings.length === 1 ? '' : 's'}: `;
70:   let rendered = prefix;
71:   for (const [index, fragment] of fragments.entries()) {
72:     const separator = index === 0 ? '' : ' | ';
73:     const remaining = maximum - rendered.length - separator.length;
74:     if (remaining <= 0) break;
75:     if (fragment.length <= remaining) {
76:       rendered += `${separator}${fragment}`;
77:       continue;
78:     }
79:     const suffix = ' … Full details remain in the architecture artifact.';
80:     const available = Math.max(0, remaining - suffix.length);
81:     rendered += `${separator}${fragment.slice(0, available).trimEnd()}${suffix}`;
82:     break;
83:   }
84:   return rendered.slice(0, maximum).trimEnd();
85: }
86: 
87: async function approvalReport(
88:   rawInput: unknown,
89:   context: PluginInvocationContext,
90: ) {
91:   const input = parseInput(rawInput);
92:   const candidates = context.contract.artifacts.filter((artifact) =>
93:     artifact.artifactId === input.artifactId && artifact.namespace === input.namespace
94:     && artifact.producer.runId === context.contract.lease.attempt.runId);
95:   const producers = new Set(candidates.map((artifact) => artifact.producer.stageId));
96:   const latest = Math.max(...candidates.map((artifact) => artifact.producer.attemptNumber));
97:   const selected = candidates.filter((artifact) => artifact.producer.attemptNumber === latest);
98:   if (producers.size !== 1 || selected.length !== 1) throw new Error('ARCHITECTURE_APPROVAL_REFERENCE_MISSING_OR_AMBIGUOUS');
99:   const artifact = selected[0]!;
100:   if (artifact.mediaType !== 'application/json' || !Number.isSafeInteger(artifact.sizeBytes)
101:     || artifact.sizeBytes < 1 || artifact.sizeBytes > 256 * 1024) throw new Error('ARCHITECTURE_APPROVAL_REFERENCE_INVALID');
102:   const response = await context.invoke('artifacts.read', {
103:     operation: 'get_json_bytes',
104:     resource: { type: 'artifact.object', canonicalId: artifact.artifactId },
105:     payload: { namespace: artifact.namespace, digest: artifact.digest, reference: artifact },
106:   });
107:   const serialized = verifiedArtifactJsonText(response, artifact);
108:   if (response.digest !== artifact.digest || response.sizeBytes !== artifact.sizeBytes
109:     || sha256Text(serialized) !== artifact.digest || Buffer.byteLength(serialized) !== artifact.sizeBytes) {
110:     throw new Error('ARCHITECTURE_APPROVAL_CONTENT_INVALID');
111:   }
112:   const report = response.value as { verdict?: unknown; subject?: unknown } | null;
113:   if (!report || report.verdict !== 'passed') throw new Error('ARCHITECTURE_APPROVAL_REPORT_NOT_PASSED');
114:   return { input, artifact, report };
115: }
116: 
117: export async function execute(rawInput: unknown, context: PluginInvocationContext): Promise<StageResult> {
118:   const { input, artifact, report } = await approvalReport(rawInput, context);
119:   const subject = report.subject === undefined ? undefined : await verifyReviewSubject(report.subject, context);
120:   const approvalPrefix = `${input.summary} Evidence: ${artifact.digest}. Findings: `;
121:   const findings = findingSummary(report, 10_000 - approvalPrefix.length);
122:   if (findings && context.contract.guidance?.decision === 'approved') {
123:     const reason = context.contract.guidance.reason;
124:     if (typeof reason !== 'string' || !reason.trim()) throw new Error('ARCHITECTURE_APPROVAL_REASON_REQUIRED');
125:   }
126:   const result = findings ? await executeApproval({ summary: `${approvalPrefix}${findings}` }, context) : {
127:       schemaVersion: 'stage-result.v2',
128:       outcome: 'passed',
129:       artifacts: [],
130:     } as StageResult;
131:   if (result.outcome !== 'passed') return result;
132:   if (subject) await verifyReviewSubject(subject, context);
133:   const stored = await context.invoke('artifacts.write', {
134:     operation: 'put_json', resource: { type: 'artifact.object', canonicalId: 'architecture-approval' },
135:     payload: { ...(subject?.identityEncoding ? {encoding:subject.identityEncoding} : {}), namespace: 'kubeclaw.human-approval', mediaType: 'application/json', value: {
136:       decision: 'approved', subject: subject ?? null, reportDigest: artifact.digest, reportStageId: artifact.producer.stageId,
137:       guidance: context.contract.guidance ?? null, clean: !findings,
138:     } },
139:   });
140:   return { ...result, artifacts: [stored.artifact as ArtifactRef] };
141: }
SOURCE skills/nova/plugins/human-approval/src/stage.ts SHA256 9e54e56d6b5acc631985cc2de9e9be943f3e8cdeaa09835dfdc1e402d67da8fd
1: import type { PluginInvocationContext, StageResult } from '@kubeclaw/plugin-sdk';
2: import {
3:   APPROVAL_SIGNAL_TYPE,
4:   calculateApprovalExpiresAt,
5:   parseApprovalConfig,
6:   parseApprovalGuidance,
7:   parseApprovalInput,
8:   pendingApprovalResult,
9:   resultForApprovalGuidance,
10:   validateCreatedWait,
11: } from './approval.ts';
12: 
13: export async function execute(
14:   rawInput: unknown,
15:   context: PluginInvocationContext,
16: ): Promise<StageResult> {
17:   const input = parseApprovalInput(rawInput);
18:   const config = parseApprovalConfig(context.contract.config);
19:   const guidance = parseApprovalGuidance(context.contract.guidance, config.issuerId);
20:   if (guidance.decision !== 'pending') return resultForApprovalGuidance(guidance);
21: 
22:   const attempt = context.contract.lease.attempt;
23:   const approvalId = `approval:${attempt.runId}:${attempt.stageId}`;
24:   const expiresAt = calculateApprovalExpiresAt(new Date(), config.timeoutMinutes);
25:   const response = await context.invoke('signal.wait', {
26:     operation: 'create',
27:     resource: { type: 'signal.wait', canonicalId: approvalId },
28:     payload: {
29:       kind: 'signal',
30:       signalType: APPROVAL_SIGNAL_TYPE,
31:       authorizedIssuer: { type: 'operator', id: config.issuerId },
32:       expiresAt,
33:       request: { summary: input.summary },
34:     },
35:   });
36:   const wait = validateCreatedWait(response, {
37:     issuerId: config.issuerId,
38:     expiresAt,
39:     summary: input.summary,
40:   });
41:   await context.invoke('operator.request', {
42:     operation: 'publish',
43:     resource: { type: 'operator.target', canonicalId: config.target },
44:     payload: {
45:       type: 'approval.requested',
46:       approvalId,
47:       waitId: wait.waitId,
48:       summary: input.summary,
49:       signalType: APPROVAL_SIGNAL_TYPE,
50:       authorizedIssuer: { type: 'operator', id: config.issuerId },
51:       expiresAt,
52:     },
53:   });
54:   return pendingApprovalResult(wait);
55: }
