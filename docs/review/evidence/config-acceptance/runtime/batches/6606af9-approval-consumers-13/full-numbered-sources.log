SOURCE skills/nova/plugins/prism-design/src/architecture.ts SHA256 bb4fab2431b51d68a787fefdaec95649678e86ede9961bc2fb1ad168b7eed10f
1: import {canonicalJson, portableJson, PORTABLE_JSON_ENCODING, sha256Text, type ArtifactRef} from '@kubeclaw/plugin-sdk';
2: 
3: /** The expected Core reference owns the codec; it does not change the read effect. */
4: export function assertArchitectureReferenceEncoding(expected: ArtifactRef): string {
5:   // Validate descriptors/JSON domain before any getter-prone property access.
6:   const reference = portableJson(expected);
7:   if (Object.hasOwn(expected, 'encoding') && expected.encoding !== PORTABLE_JSON_ENCODING) {
8:     throw new Error('PRISM_DESIGN_ARCHITECTURE_ENCODING_INVALID');
9:   }
10:   return reference;
11: }
12: 
13: /** Verify an original get_json result, including a previously completed receipt. */
14: export function verifiedArchitectureValue(response: unknown, expected: ArtifactRef): unknown {
15:   const reference = assertArchitectureReferenceEncoding(expected);
16:   portableJson(response);
17:   if (!response || typeof response !== 'object' || Array.isArray(response)) throw new Error('PRISM_DESIGN_VALUE_INVALID');
18:   const result = response as Record<string, unknown>;
19:   if (['artifact', 'digest', 'sizeBytes', 'value'].some(key => !Object.hasOwn(result, key))) throw new Error('PRISM_DESIGN_ARCHITECTURE_PROOF_INVALID');
20:   if (portableJson(result.artifact) !== reference) throw new Error('PRISM_DESIGN_ARCHITECTURE_REFERENCE_INVALID');
21:   // Untagged historical values retain precisely the old verifier and fail closed
22:   // on cross-locale mismatch. Never guess a collator or infer a run profile.
23:   const bytes = Object.hasOwn(expected, 'encoding') ? portableJson(result.value) : canonicalJson(result.value);
24:   if (result.digest !== expected.digest || result.sizeBytes !== expected.sizeBytes
25:     || sha256Text(bytes) !== expected.digest || Buffer.byteLength(bytes) !== expected.sizeBytes) {
26:     throw new Error('PRISM_DESIGN_ARCHITECTURE_PROOF_INVALID');
27:   }
28:   return result.value;
29: }
SOURCE skills/nova/plugins/prism-design/src/archive.ts SHA256 8875fcaa4c6efafa2f231c8e3fcc522dcd1ae1f23850a4d8941a89358726383e
1: import { validatePrism } from '@kubeclaw/prism-contracts-v1';
2: import { BASELINE_V1, BASELINE_V2, BASELINE_CHECKSUM_ENCODING, baselineChecksumDigest, assertBaselineChecksumDocument } from '@kubeclaw/prism-contracts-v1/baseline-archive';
3: import { sha256Bytes, sha256Text } from '@kubeclaw/plugin-sdk';
4: 
5: const digest = (bytes: string | Buffer) => typeof bytes === 'string' ? sha256Text(bytes) : sha256Bytes(bytes);
6: const maximumBytes = 32 * 1024 * 1024;
7: function object(value: unknown): Record<string, any> {
8:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('PRISM_ARCHIVE_OBJECT_INVALID');
9:   return value as Record<string, any>;
10: }
11: function filePath(value: string): void {
12:   if (!value || value.startsWith('/') || value.includes('\\') || value.includes('\0')
13:     || value.split('/').some(part => !part || part === '.' || part === '..')) throw new Error('PRISM_ARCHIVE_PATH_INVALID');
14: }
15: function base64(value: unknown): Buffer {
16:   if (typeof value !== 'string' || value.length > Math.ceil(maximumBytes / 3) * 4) throw new Error('PRISM_ARCHIVE_SIZE_EXCEEDED');
17:   const bytes = Buffer.from(value, 'base64');
18:   if (bytes.length > maximumBytes || bytes.toString('base64') !== value) throw new Error('PRISM_ARCHIVE_ENCODING_INVALID');
19:   return bytes;
20: }
21: 
22: function archiveManifest(archive: Record<string, any>, approvedDigest: string, projectId: string) {
23:   if (archive.schema !== BASELINE_V1 && archive.schema !== BASELINE_V2) throw new Error('PRISM_ARCHIVE_SCHEMA_INVALID');
24:   const manifest = object(archive.manifest);
25:   const manifestSchema = archive.schema === BASELINE_V1 ? 'prism.baseline-bundle.v1' : 'prism.baseline-bundle.v2';
26:   if (manifest.schema !== manifestSchema || manifest.digest !== approvedDigest || manifest.projectId !== projectId
27:     || (archive.schema === BASELINE_V2 && manifest.checksumEncoding !== BASELINE_CHECKSUM_ENCODING)) throw new Error('PRISM_ARCHIVE_MANIFEST_MISMATCH');
28:   validatePrism('baselineManifest', manifest);
29:   return manifest;
30: }
31: function archiveFiles(archive: Record<string, any>, manifest: Record<string, any>, approvedDigest: string) {
32:   const textFiles = object(archive.textFiles);
33:   const binaryFiles = object(archive.binaryFiles);
34:   const names = [...Object.keys(textFiles), ...Object.keys(binaryFiles)];
35:   if (names.length > 4096 || new Set(names).size !== names.length) throw new Error('PRISM_ARCHIVE_FILE_SET_INVALID');
36:   const checksumDocument = object(JSON.parse(textFiles['checksums.json']));
37:   assertBaselineChecksumDocument(checksumDocument, archive.schema);
38:   const checksums = object(checksumDocument.files);
39:   const expected = names.filter(name => name !== 'manifest.json' && name !== 'checksums.json').sort();
40:   if (JSON.stringify(Object.keys(checksums).sort()) !== JSON.stringify(expected)) throw new Error('PRISM_ARCHIVE_CHECKSUM_SET_INVALID');
41:   let totalBytes = 0;
42:   for (const name of names) {
43:     filePath(name);
44:     const content = Object.hasOwn(textFiles, name) ? textFiles[name] : base64(binaryFiles[name]);
45:     if (typeof content !== 'string' && !Buffer.isBuffer(content)) throw new Error('PRISM_ARCHIVE_FILE_INVALID');
46:     totalBytes += Buffer.byteLength(content);
47:     if (totalBytes > maximumBytes) throw new Error('PRISM_ARCHIVE_SIZE_EXCEEDED');
48:     if (Object.hasOwn(checksums, name) && digest(content) !== checksums[name]) throw new Error(`PRISM_ARCHIVE_FILE_DIGEST_MISMATCH:${name}`);
49:   }
50:   if (baselineChecksumDigest(checksums, archive.schema) !== approvedDigest) throw new Error('PRISM_ARCHIVE_BUNDLE_DIGEST_MISMATCH');
51:   if (JSON.stringify(JSON.parse(textFiles['manifest.json'])) !== JSON.stringify(manifest)) throw new Error('PRISM_ARCHIVE_MANIFEST_MISMATCH');
52:   return { textFiles, checksums };
53: }
54: function manifestMembers(manifest: Record<string, any>, checksums: Record<string, any>): void {
55:   for (const key of ['designDocument', 'designSpecification', 'acceptanceCriteria', 'previews']) {
56:     const name = object(manifest[key]).path;
57:     if (typeof name !== 'string' || !Object.hasOwn(checksums, name)) throw new Error('PRISM_ARCHIVE_REQUIRED_FILE_MISSING');
58:   }
59:   for (const asset of Object.values(object(manifest.assets))) {
60:     const item = object(asset);
61:     if (typeof item.path !== 'string' || checksums[item.path] !== item.digest) throw new Error('PRISM_ARCHIVE_ASSET_MISMATCH');
62:   }
63: }
64: function archiveDocuments(manifest: Record<string, any>, textFiles: Record<string, any>, checksums: Record<string, any>, projectId: string): void {
65:   const document = object(validatePrism('designDocument', JSON.parse(textFiles[manifest.designDocument.path])));
66:   if (document.meta.projectId !== projectId || document.meta.revision !== manifest.revision
67:     || manifest.designDocument.revision !== manifest.revision) throw new Error('PRISM_ARCHIVE_DOCUMENT_MISMATCH');
68:   validatePrism('acceptanceCriteria', JSON.parse(textFiles[manifest.acceptanceCriteria.path]));
69:   const previews = object(validatePrism('previewIndex', JSON.parse(textFiles[manifest.previews.path])));
70:   if (!previews.previews.length) throw new Error('PRISM_ARCHIVE_PREVIEWS_MISSING');
71:   for (const preview of previews.previews) {
72:     if (checksums[preview.path] !== preview.digest || checksums[preview.ariaPath] !== preview.ariaDigest
73:       || !document.views[preview.view]?.states[preview.state]) throw new Error('PRISM_ARCHIVE_PREVIEW_MISMATCH');
74:   }
75: }
76: 
77: /** Verify the actual content-addressed archive before publishing a Nova handoff. */
78: export function verifyBaselineArchive(response: unknown, approvedDigest: string, projectId: string) {
79:   const result = object(response);
80:   if (result.bundleDigest !== approvedDigest) throw new Error('PRISM_DESIGN_APPROVED_BUNDLE_MISMATCH');
81:   const bytes = base64(result.archiveBase64);
82:   if (result.artifactId !== `artifact:${digest(bytes)}`) throw new Error('PRISM_ARCHIVE_DIGEST_MISMATCH');
83:   const archive = object(JSON.parse(bytes.toString('utf8')));
84:   const manifest = archiveManifest(archive, approvedDigest, projectId);
85:   const { textFiles, checksums } = archiveFiles(archive, manifest, approvedDigest);
86:   manifestMembers(manifest, checksums);
87:   archiveDocuments(manifest, textFiles, checksums, projectId);
88:   return { artifactId: result.artifactId as string, bundleDigest: approvedDigest, archive };
89: }
SOURCE skills/nova/plugins/prism-design/src/stage.ts SHA256 20bee389c4868070dc7450d366b85745c2f26acb88e8d526463c3cb5a599db88
1: import { verifyBaselineArchive } from './archive.ts';
2: import { assertArchitectureReferenceEncoding, verifiedArchitectureValue } from './architecture.ts';
3: import { type ArtifactRef, type PluginInvocationContext, type StageResult, type WaitRequest } from "@kubeclaw/plugin-sdk";
4: type Input={runId:string;projectId:string;architectureArtifact:{artifactId:string;contentDigest:string;revision:number};requiresDesign:boolean};
5: type Config={agent:"prism";target:string;issuerId:string;timeoutMinutes:number};
6: const record=(value:unknown):Record<string,unknown>=>{if(!value||typeof value!=="object"||Array.isArray(value))throw new Error("PRISM_DESIGN_VALUE_INVALID");return value as Record<string,unknown>;};
7: function config(value:unknown):Config{const item=record(value);if(item.agent!=="prism"||typeof item.target!=="string"||typeof item.issuerId!=="string"||!Number.isSafeInteger(item.timeoutMinutes)||Number(item.timeoutMinutes)<1)return (()=>{throw new Error("PRISM_DESIGN_CONFIG_INVALID");})();return item as unknown as Config;}
8: function approval(value:unknown,issuerId:string,architectureDigest:string):{approvalId:string;bundleDigest:string}|undefined{if(value===undefined)return undefined;const item=record(value);const issuer=record(item.issuer);if(item.decision!=="approved"||issuer.type!=="operator"||issuer.id!==issuerId||typeof item.approvalId!=="string"||!item.approvalId||item.architectureDigest!==architectureDigest||typeof item.bundleDigest!=="string"||!/^sha256:[a-f0-9]{64}$/u.test(item.bundleDigest))return (()=>{throw new Error("PRISM_DESIGN_APPROVAL_INVALID");})();return {approvalId:item.approvalId,bundleDigest:item.bundleDigest};}
9: export function waitFrom(value:unknown,expected:{issuerId:string;expiresAt:string;projectId:string}):WaitRequest{const item=record(value);const wait=record(item.wait);const issuer=record(wait.authorizedIssuer);const request=record(wait.request);if(typeof item.created!=="boolean"||wait.schemaVersion!=="wait-request.v2"||typeof wait.waitId!=="string"||!/^wait:[a-f0-9]{64}$/u.test(wait.waitId)||wait.kind!=="signal"||wait.signalType!=="prism.approval.resolved"||issuer.type!=="operator"||issuer.id!==expected.issuerId||wait.expiresAt!==expected.expiresAt||request.projectId!==expected.projectId)throw new Error("PRISM_DESIGN_WAIT_INVALID");return wait as unknown as WaitRequest;}
10: export async function execute(input:Input,context:PluginInvocationContext):Promise<StageResult>{
11:   if(!input.requiresDesign)return {schemaVersion:"stage-result.v2",outcome:"passed",artifacts:[]};
12:   input={...input,runId:context.contract.lease.attempt.runId};
13:   const settings=config(context.contract.config);const approved=approval(context.contract.guidance,settings.issuerId,input.architectureArtifact.contentDigest);
14:   try{
15:     const architectureRef=context.artifact(input.architectureArtifact.artifactId);
16:     if(architectureRef)assertArchitectureReferenceEncoding(architectureRef);
17:     if(!architectureRef||architectureRef.producer.runId!==input.runId||architectureRef.mediaType!=="application/json"||architectureRef.sizeBytes>256*1024||architectureRef.digest!==input.architectureArtifact.contentDigest)throw new Error("PRISM_DESIGN_ARCHITECTURE_REFERENCE_INVALID");
18:     const architectureResponse=await context.invoke("artifacts.read",{operation:"get_json",resource:{type:"artifact.object",canonicalId:architectureRef.artifactId},payload:{namespace:architectureRef.namespace,digest:architectureRef.digest}});
19:     const architectureContent=verifiedArchitectureValue(architectureResponse,architectureRef);
20:     const request={schema:"prism.design-request.v1",projectId:input.projectId,architecture:input.architectureArtifact,architectureContent,...approved?{approvalId:approved.approvalId}:{}};
21:     const phase=approved?`approved:${approved.approvalId}:${input.architectureArtifact.contentDigest}`:"request";
22:     const response=await context.invoke("runtime.dispatch",withRuntimeDispatchProfile({operation:"dispatch",resource:{type:"runtime.agent",canonicalId:settings.agent},payload:{request,idempotencyKey:`${input.runId}:prism:${input.architectureArtifact.contentDigest}:${phase}`}},context.contract.runtimeDispatchProfile));const result=response.result as Record<string,unknown>;
23:     if(!approved){
24:       const waitId=`prism:${input.runId}:${input.projectId}`;const expiresAt=new Date(Date.now()+settings.timeoutMinutes*60_000).toISOString();
25: 
26:       const created=await context.invoke("signal.wait",{operation:"create",resource:{type:"signal.wait",canonicalId:waitId},payload:{kind:"signal",signalType:"prism.approval.resolved",authorizedIssuer:{type:"operator",id:settings.issuerId},expiresAt,request:{projectId:input.projectId}}});
27:       const wait=waitFrom(created,{issuerId:settings.issuerId,expiresAt,projectId:input.projectId});
28:       await context.invoke("operator.request",{operation:"publish",resource:{type:"operator.target",canonicalId:settings.target},payload:{type:"prism.approval.requested",projectId:input.projectId,waitId:wait.waitId,architectureDigest:input.architectureArtifact.contentDigest,signalType:"prism.approval.resolved",authorizedIssuer:{type:"operator",id:settings.issuerId},expiresAt}});
29:       return {schemaVersion:"stage-result.v2",outcome:"wait",reason:{code:"prism_design.approval_pending",message:"Waiting for an approved Prism Baseline Bundle."},artifacts:[],wait};
30:     }
31:     const imported=verifyBaselineArchive(result,approved.bundleDigest,input.projectId);
32:     const stored=await context.invoke("artifacts.write",{operation:"put_json",resource:{type:"artifact.object",canonicalId:`prism-baseline:${input.projectId}:${result.bundleDigest}`},payload:{namespace:"kubeclaw.prism",mediaType:"application/json",value:{...imported,designRequest:request,approvedArchitectureDigest:input.architectureArtifact.contentDigest}}});
33:     return {schemaVersion:"stage-result.v2",outcome:"passed",artifacts:[stored.artifact as ArtifactRef]};
34:   }catch(error){return {schemaVersion:"stage-result.v2",outcome:"blocked",reason:{code:"prism_design.dispatch_failed",message:error instanceof Error?error.message:String(error)},artifacts:[]};}
35: }
36: import { withRuntimeDispatchProfile } from '@kubeclaw/plugin-sdk';