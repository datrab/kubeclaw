SOURCE skills/nova/plugins/pipeline-review/src/evidence-adapter.ts SHA256 477c0a5349d80816ab5af7dd06abbdeec3bf62ab94fe25ea88159d3f1b74293c
1: import {verifiedArtifactJsonText} from '@kubeclaw/plugin-sdk';
2: import { readRunEvidence } from '@kubeclaw/nova-core';
3: import { canonicalJson, sha256Text, type AdapterActivationContext, type AdapterInstance, type AdapterInvocation, type ArtifactRef } from '@kubeclaw/plugin-sdk';
4: import { assertEvidenceSelection, verifySelectedArtifacts, sourceFact, buildEvidenceBundle, type EvidenceSelection } from './evidence-bundle.ts';
5: 
6: async function readArtifact(context: AdapterActivationContext, invocation: AdapterInvocation, ref: ArtifactRef) {
7:   const response = await context.invoke('artifacts.read', { operation: 'get_json_bytes', resource: { type: 'artifact.object', canonicalId: ref.artifactId }, payload: { namespace: ref.namespace, digest: ref.digest, reference: ref } }, { signal: invocation.signal });
8:   const bytes = verifiedArtifactJsonText(response, ref);
9:   if (canonicalJson(response.artifact) !== canonicalJson(ref) || response.digest !== ref.digest || sha256Text(bytes) !== ref.digest
10:     || response.sizeBytes !== ref.sizeBytes || Buffer.byteLength(bytes) !== ref.sizeBytes) throw new Error('REPORT_ARTIFACT_INTEGRITY_INVALID');
11:   return response.value;
12: }
13: function artifactBudget(ref: ArtifactRef, total: number, maximum: number): void {
14:   if (ref.mediaType !== 'application/json' || !Number.isSafeInteger(total) || total > maximum) throw new Error('REPORT_ARTIFACT_BUDGET_EXCEEDED');
15: }
16: export function activate(context: AdapterActivationContext): AdapterInstance {
17:   const storageRoot = context.config.storageRoot;
18:   const orchestratorIssuerId = context.config.orchestratorIssuerId;
19:   const maximumJournalBytes = context.config.maximumJournalBytes;
20:   const maximumArtifactBytes = context.config.maximumArtifactBytes;
21:   const maximumBundleBytes = context.config.maximumBundleBytes;
22:   if (typeof storageRoot !== 'string' || typeof orchestratorIssuerId !== 'string' || !orchestratorIssuerId
23:     || [maximumJournalBytes, maximumArtifactBytes, maximumBundleBytes].some(value => !Number.isSafeInteger(value) || Number(value) < 1)) throw new Error('REPORT_READER_CONFIG_INVALID');
24:   let stopped = false;
25:   async function invoke(invocation: AdapterInvocation) {
26:     if (!invocation.confidential) invocation.fence.assertCurrent();
27:     if (stopped || invocation.signal.aborted) throw new Error('REPORT_READER_CANCELLED');
28:     const request = invocation.request;
29:     if (request.capability !== 'report.evidence.read' || request.operation !== 'snapshot' || request.resource.type !== 'pipeline.run') throw new Error('REPORT_READER_OPERATION_INVALID');
30:     const selection = structuredClone(request.payload) as unknown as EvidenceSelection;
31:     assertEvidenceSelection(selection);
32:     if (request.resource.canonicalId !== selection.runId) throw new Error('REPORT_READER_RUN_MISMATCH');
33:     const options = { storageRoot: storageRoot as string, orchestratorIssuerId: orchestratorIssuerId as string, maximumBytes: Number(maximumJournalBytes) };
34:     const projection = readRunEvidence(selection, options);
35:     verifySelectedArtifacts(projection, selection);
36:     let total = 0; const facts = [];
37:     for (const ref of selection.artifacts) {
38:       total += ref.sizeBytes;
39:       artifactBudget(ref,total,Number(maximumArtifactBytes));
40:       facts.push(sourceFact(ref, await readArtifact(context,invocation,ref), selection, projection));
41:     }
42:     if(canonicalJson(readRunEvidence(selection, options))!==canonicalJson(projection))throw new Error('REPORT_SOURCE_CHANGED');
43:     if (invocation.signal.aborted || stopped) throw new Error('REPORT_READER_CANCELLED');
44:     const bundle = buildEvidenceBundle(projection, selection, facts);
45:     if (Buffer.byteLength(canonicalJson(bundle)) > Number(maximumBundleBytes)) throw new Error('REPORT_BUNDLE_BUDGET_EXCEEDED');
46:     return { bundle };
47:   }
48:   return { async ready() {}, invoke, async shutdown() { stopped = true; } };
49: }
SOURCE skills/nova/plugins/pipeline-review/src/evidence-bundle.ts SHA256 ca3db15dbc1f008f690b79df3f4cb94143b924631b11711fb935f4ee3ccda7dd
1: import { canonicalJson, sha256Text, type ArtifactRef } from '@kubeclaw/plugin-sdk';
2: import { parseGateDecision } from '@kubeclaw/pipeline-test-gate-contract';
3: import type { RunEvidenceProjection, RunEvidenceSelection } from '@kubeclaw/nova-core';
4: 
5: export interface EvidenceSelection extends RunEvidenceSelection {
6:   readonly sourceStageId: string;
7:   readonly sourceRevision: string;
8:   readonly artifacts: readonly ArtifactRef[];
9: }
10: export function assertEvidenceSelection(value: EvidenceSelection): void {
11:   if (!value || Object.keys(value).sort().join(',') !== 'artifacts,journalHead,runId,snapshotDigest,sourceRevision,sourceStageId'
12:     || typeof value.runId !== 'string' || !value.runId || typeof value.sourceStageId !== 'string' || !value.sourceStageId
13:     || !/^(?:[a-f0-9]{40}|[a-f0-9]{64})$/u.test(value.sourceRevision)
14:     || !Array.isArray(value.artifacts) || !value.artifacts.length || value.artifacts.length > 128
15:     || new Set(value.artifacts.map(ref => canonicalJson(ref))).size !== value.artifacts.length) throw new Error('REPORT_SOURCE_SELECTION_INVALID');
16: }
17: export function verifySelectedArtifacts(projection: RunEvidenceProjection, selection: EvidenceSelection): void {
18:   for (const ref of selection.artifacts) {
19:     if (!projection.artifacts.some(candidate => canonicalJson(candidate) === canonicalJson(ref))) throw new Error('REPORT_ARTIFACT_NOT_IN_RUN');
20:     const stage = projection.stages.find(stage => stage.stageId === ref.producer.stageId);
21:     if (!stage || ref.producer.attemptNumber !== stage.attempts) throw new Error('REPORT_ARTIFACT_STALE_ATTEMPT');
22:   }
23: }
24: function record(value: unknown): Record<string, any> {
25:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('REPORT_SOURCE_CONTENT_INVALID');
26:   return value as Record<string, any>;
27: }
28: function count(value: unknown): number {
29:   if (!Number.isSafeInteger(value) || Number(value) < 0) throw new Error('REPORT_SOURCE_COUNT_INVALID');
30:   return Number(value);
31: }
32: function testFact(ref: ArtifactRef, value: Record<string, any>, selection: EvidenceSelection, evidenceId: string) {
33:     const decision = parseGateDecision(value);
34:     if (decision.runId !== selection.runId || decision.coverage?.sourceRevision !== `git:${selection.sourceRevision}`
35:       || decision.coverage.pipelineStageId !== ref.producer.stageId) throw new Error('REPORT_GATE_SOURCE_MISMATCH');
36:     return { evidenceId, kind: 'tests', sourceRevision: selection.sourceRevision, state: decision.state,
37:       nodes: decision.nodes.map(node => ({ nodeId: node.nodeId, effect: node.effect })),
38:       coverage: decision.coverage.checks.map(check => ({ checkId: check.checkId, state: check.state })) };
39: }
40: export function sourceFact(ref: ArtifactRef, raw: unknown, selection: EvidenceSelection, projection: RunEvidenceProjection) {
41:   const value = record(raw); const evidenceId = sha256Text(canonicalJson(ref));
42:   const stage = projection.stages.find(stage => stage.stageId === ref.producer.stageId)!;
43:   if (ref.namespace === 'kubeclaw.implementation-agent' && ref.producer.stageId === selection.sourceStageId
44:     && stage.stageType === 'kubeclaw.agent.implementation') {
45:     if (value.sourceRevision !== selection.sourceRevision || value.status !== 'ready_for_testing') throw new Error('REPORT_SOURCE_REVISION_MISMATCH');
46:     return { evidenceId, kind: 'source', sourceRevision: selection.sourceRevision };
47:   }
48:   if (ref.namespace === 'kubeclaw.lint' && stage.stageType.startsWith('kubeclaw.lint.')) {
49:     if (value.sourceRevision !== selection.sourceRevision) throw new Error('REPORT_SOURCE_REVISION_MISMATCH');
50:     const summary = record(value.summary);
51:     return { evidenceId, kind: 'lint', sourceRevision: selection.sourceRevision, toolsFailed: count(summary.tools_failed), blocking: count(summary.total_blocking) };
52:   }
53:   if (ref.namespace === 'kubeclaw.buster-quality-gate' && stage.stageType === 'kubeclaw.test.quality-evaluation' && ref.artifactId.includes(':decision:')) {
54:     return testFact(ref, value, selection, evidenceId);
55:   }
56:   throw new Error('REPORT_SOURCE_KIND_UNSUPPORTED');
57: }
58: export function buildEvidenceBundle(projection: RunEvidenceProjection, selection: EvidenceSelection, facts: readonly ReturnType<typeof sourceFact>[]) {
59:   if (facts.filter(fact => fact.kind === 'source').length !== 1) throw new Error('REPORT_SOURCE_ARTIFACT_REQUIRED');
60:   const value = { schemaVersion: 'report-source-bundle.v1', target: { runId: selection.runId, journalHead: selection.journalHead,
61:     snapshotDigest: selection.snapshotDigest, sourceStageId: selection.sourceStageId, sourceRevision: selection.sourceRevision },
62:     pipelineId: projection.pipelineId, terminal: projection.terminal, eventCount: projection.eventCount, effectsHead:projection.effectsHead,
63:     stages: projection.stages, attempts: projection.attempts, evidence: selection.artifacts.map(ref => ({ evidenceId: sha256Text(canonicalJson(ref)), artifact: ref })), facts,
64:     coverage: { selectedArtifacts: selection.artifacts.length, totalCompletedArtifacts: projection.artifacts.length,
65:       omittedArtifacts: projection.artifacts.filter(ref => !selection.artifacts.some(selected => canonicalJson(selected) === canonicalJson(ref)))
66:         .map(ref => ({ artifact: ref, reason: 'not-selected' })),
67:       omittedContentClasses: ['raw-logs', 'checkpoint-only-artifacts', 'prompts', 'registry-configuration', 'effect-payloads', 'credentials', 'unstructured-agent-claims'],
68:       omissionEffect: 'not-exported-in-this-bundle; original-records-retained' }, narrativeStatus: 'draft-not-entailment-verified' };
69:   return { ...value, digest: sha256Text(canonicalJson(value)) };
70: }
