23: interface PinnedPackage { readonly package: { readonly packageVersion: string; readonly contentDigest: string } }
24: type PackageUpgrade = NonNullable<Extract<AdministrativeReopenDecision, { continuation: 'retry' | 'cancel' }>['packageUpgrades']>[number];
25: export function recordedPackageUpgrades(decisions: readonly AdministrativeReopenDecision[]): readonly PackageUpgrade[] {
26:   return decisions.flatMap((decision) => decision.continuation === 'retry' ? decision.packageUpgrades ?? [] : []);
27: }
28: export function verifyPinnedPackages(runRoot: string, runtime: PreparedRuntime, upgrades: readonly PackageUpgrade[] = []): void {
29:   const stored = readRunSnapshot(runRoot).registry as unknown;
30:   if (!stored || typeof stored !== 'object' || (stored as Record<string, unknown>).dependencyIdentityVersion !== 'parent-invocation.v1') throw new Error('RECOVERY_DEPENDENCY_IDENTITY_MISMATCH:drain existing runs with their original runtime; automatic migration is unsupported');
31:   const packages = stored && typeof stored === 'object' && !Array.isArray(stored) ? (stored as { packages?: unknown }).packages : undefined;
32:   if (!Array.isArray(packages)) throw new Error('RECOVERY_REGISTRY_SNAPSHOT_INVALID');
33:   if (canonicalJson((stored as Record<string, unknown>).configuration) !== canonicalJson(runtime.configuration)) throw new Error('RECOVERY_RUNTIME_CONFIGURATION_MISMATCH');
34:   const pinned = new Map<string, PinnedPackage>(); packages.forEach((value) => addPinnedPackage(value, pinned));
35:   if (canonicalJson([...runtime.snapshot.packages.keys()].sort()) !== canonicalJson([...pinned.keys()].sort())) throw new Error('RECOVERY_PINNED_PACKAGE_SET_MISMATCH');
36:   for (const pluginId of new Set(upgrades.map(({ pluginId }) => pluginId))) {
37:     if (!pinned.has(pluginId)) throw new Error(`RECOVERY_PACKAGE_UPGRADE_UNKNOWN:${pluginId}`);
38:   }
39:   for (const [pluginId, provenance] of pinned) assertPinnedPackage(pluginId, provenance, runtime,
40:     upgrades.filter((upgrade) => upgrade.pluginId === pluginId));
41: }
