68: export function verifyPinnedGraph(runRoot: string, definition: PipelineDefinition): ExecutionGraphSnapshot {
69:   const stored = readRunSnapshot(runRoot).graph as ExecutionGraphSnapshot; const current = graphSnapshot(definition, stored.schemaVersion);
70:   if (!['execution-graph-snapshot.v2', 'execution-graph-snapshot.v3'].includes(stored.schemaVersion)) throw new Error('RECOVERY_GRAPH_SNAPSHOT_INVALID');
71:   if (stored.pipelineId !== current.pipelineId) throw new Error(`RECOVERY_PIPELINE_ID_MISMATCH:${stored.pipelineId}:${current.pipelineId}`);
72:   if (stored.digest !== current.digest) throw new Error(`RECOVERY_GRAPH_DIGEST_MISMATCH:${stored.digest}:${current.digest}`); return current;
73: }
