15: interface StartupOptions {
16:   readonly runtime: AdapterRuntimeOptions; readonly invocationContext: AsyncLocalStorage<AdapterInvocationOwner>;
17:   readonly stopping: () => boolean; readonly pendingControllers: Map<string, AbortController>; readonly pendingInstances: Map<string, AdapterInstance>;
18:   readonly shutdown: (instance: AdapterInstance, signal: AbortSignal) => Promise<void>;
19: }
20: export interface StartedAdapters { readonly instances: Map<string, AdapterInstance>; readonly controllers: Map<string, AbortController> }
21: 
22: export class AdapterStarter {
23:   readonly #options: StartupOptions; readonly #instances = new Map<string, AdapterInstance>(); readonly #controllers = new Map<string, AbortController>(); readonly #starting = new Set<string>();
24:   constructor(options: StartupOptions) { this.#options = options; }
25: 
26:   async startAll(): Promise<StartedAdapters> {
27:     try {
28:       for (const [id] of this.#options.runtime.granted.snapshot.adapters) {
29:         if (this.#options.runtime.granted.enabledRegistrations.has(id)) await this.#start(id);
30:       }
31:       if (this.#options.stopping()) throw new Error('ADAPTER_RUNTIME_STOPPING');
32:       return { instances: this.#instances, controllers: this.#controllers };
33:     } catch (error) { await this.#rollback(); throw error; }
34:   }
35: 
36:   async #start(adapterId: string): Promise<AdapterInstance> {
37:     const existing = this.#instances.get(adapterId); if (existing) return existing;
38:     if (this.#starting.has(adapterId)) throw new Error(`ADAPTER_CYCLE:${adapterId}`); this.#starting.add(adapterId);
39:     try {
40:       const entry = this.#options.runtime.granted.snapshot.adapters.get(adapterId); const activated = this.#options.runtime.activated.adapters.get(adapterId);
41:       if (!entry || !activated) throw new Error(`ADAPTER_NOT_ACTIVATED:${adapterId}`);
42:       const lifecycle = new AbortController(); this.#controllers.set(adapterId, lifecycle); this.#options.pendingControllers.set(adapterId, lifecycle);
43:       const config = this.#config(adapterId, entry.package.root, entry.registration.configSchema);
44:       await this.#dependencies(adapterId, entry.registration.requiredCapabilities);
45:       const context = this.#context(adapterId, lifecycle, entry.provenance, entry.package.manifest.id, config);
46:       const raw = await this.#activate(adapterId, lifecycle, activated.execute as AdapterFactory, context);
47:       const instance = this.#wrap(raw, lifecycle, adapterId); this.#instances.set(adapterId, instance); this.#options.pendingInstances.set(adapterId, instance);
48:       await this.#ready(adapterId, instance, lifecycle); return instance;
49:     } finally { this.#starting.delete(adapterId); }
50:   }
51: 
52:   #config(adapterId: string, root: string, schema: string): Readonly<Record<string, unknown>> {
53:     const config = this.#options.runtime.configs.get(adapterId) ?? Object.freeze({});
54:     validateReferencedValue(fs.realpathSync(path.join(root, schema)), config, this.#options.runtime.granted.snapshot.schemas); return config;
55:   }
56: 
57:   async #dependencies(adapterId: string, capabilities: readonly string[]): Promise<void> {
58:     for (const capability of capabilities) {
59:       const dependency = this.#options.runtime.granted.selectedProviders.get(capability);
60:       if (!dependency) throw new Error(`ADAPTER_DEPENDENCY_MISSING:${adapterId}:${capability}`);
61:       await this.#start(`${dependency.package.manifest.id}:${dependency.registration.id}`);
62:     }
63:   }
64: 
65:   #context(adapterId: string, lifecycle: AbortController, registration: AdapterActivationContext['registration'], pluginId: string, config: Readonly<Record<string, unknown>>): AdapterActivationContext {
66:     const active = (): void => { if (lifecycle.signal.aborted) throw new Error(`ADAPTER_CONTEXT_REVOKED:${adapterId}`); };
67:     const selectedWait = this.#options.runtime.granted.selectedProviders.get('signal.wait');
68:     return Object.freeze({ registration, config,
69:       ...(adapterId === 'kubeclaw.wait-store:waits' && selectedWait?.package.manifest.id === 'kubeclaw.wait-store'
70:         && selectedWait.registration.id === 'waits' && this.#options.runtime.resolveRetainedWait ? {
71:         resolveRetainedWait: (source: RetainedWaitSource) => {
72:           active();
73:           const wait = this.#options.runtime.resolveRetainedWait!(structuredClone(source));
74:           active();
75:           return wait;
76:         },
77:       } : {}),
78:       emit: async (type: string, identity: EventIdentity, payload: Readonly<Record<string, unknown>>) => { active(); if (!type.startsWith(`plugin.${pluginId}.`)) throw new Error(`PLUGIN_EVENT_NAMESPACE_DENIED:${type}`);
79:         await this.#options.runtime.emitDomainEvent(registration, type, identity, payload); active(); },
80:       invoke: (capability: string, request: CapabilityInvocation, options?: AdapterDependencyOptions) => this.#invokeDependency(adapterId, lifecycle, active, capability, request, false, options),
81:       invokeConfidential: (capability: string, request: CapabilityInvocation, options?: AdapterDependencyOptions) => this.#invokeDependency(adapterId, lifecycle, active, capability, request, true, options),
82:       withCleanup: <T>(operation: (context: AdapterCleanupContext) => Promise<T>) => this.#cleanup(adapterId, lifecycle, active, operation),
83:     });
84:   }
85: 
86:   async #invokeDependency(adapterId: string, lifecycle: AbortController, active: () => void, capability: string, request: CapabilityInvocation, confidential: boolean, options?: AdapterDependencyOptions): Promise<Readonly<Record<string, unknown>>> {
87:     portableJson(request);
88:     request = structuredClone(request);
89:     if (runtimeDispatchProfileFields(request, capability).runtimeDispatchProfile) validateContractValue('capabilityInvocation', request);
90:     active(); const parent = this.#options.invocationContext.getStore();
91:     parent?.phase.assertActive();
92:     const deliveryId = dependencyDeliveryId(options, parent);
93:     const signal = AbortSignal.any([lifecycle.signal, ...(parent ? [parent.signal] : []), ...(options?.signal ? [options.signal] : [])]);
94:     if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
95:     const grant = this.#options.runtime.granted.grants.get(adapterId)?.find((candidate) => candidate.capability === capability);
96:     if (!grant) throw new Error(`ADAPTER_CAPABILITY_DENIED:${adapterId}:${capability}`); authorizeCapabilityInvocation(grant, request);
97:     const dependency = this.#options.runtime.granted.selectedProviders.get(capability); if (!dependency) throw new Error(`ADAPTER_CAPABILITY_DENIED:${adapterId}:${capability}`);
98:     const dependencyId = `${dependency.package.manifest.id}:${dependency.registration.id}`; const adapter = await this.#start(dependencyId);
99:     const invocation = dependencyInvocation(adapterId, capability, request, parent, deliveryId);
100:     const result = confidential || isConfidentialCapability(capability)
101:       ? await this.#options.runtime.effects.invokeConfidential(adapter, adapterOwner(this.#options.runtime, dependencyId), invocation, signal)
102:       : await this.#durable(adapter, dependencyId, invocation, signal);
103:     active(); return result;
104:   }
105: 
106:   async #durable(adapter: AdapterInstance, dependencyId: string, invocation: Parameters<AdapterRuntimeOptions['effects']['invoke']>[2], signal: AbortSignal): Promise<Readonly<Record<string, unknown>>> {
107:     const receipt = await this.#options.runtime.effects.invoke(adapter, adapterOwner(this.#options.runtime, dependencyId), invocation, signal);
108:     if (receipt.status !== 'completed') throw new Error(receipt.error?.message ?? 'adapter dependency failed'); return receipt.result ?? {};
109:   }
110: 
111:   async #activate(adapterId: string, lifecycle: AbortController, factory: AdapterFactory, context: AdapterActivationContext): Promise<AdapterInstance> {
112:     const operation = Promise.resolve().then(() => factory(context)); let timedOut = false;
113:     try { return await withAdapterStartupTimeout(adapterId, 'activate', this.#options.runtime.shutdownTimeoutMs, () => operation, (error) => { timedOut = true; lifecycle.abort(error); }); }
114:     catch (error) { if (timedOut) void operation.then((late) => shutdownLateAdapter(late, this.#options.runtime.shutdownTimeoutMs), () => undefined); throw error; }
115:   }
116: 
117:   #wrap(raw: AdapterInstance, lifecycle: AbortController, adapterId: string): AdapterInstance {
118:     return { ready: () => raw.ready(), invoke: async (invocation) => {
119:       const signal = AbortSignal.any([invocation.signal, lifecycle.signal]);
120:       const phase = new AdapterInvocationPhase(lifecycle.signal, this.#options.runtime.shutdownTimeoutMs);
121:       const request = structuredClone(invocation.request);
122:       try {
123:         return await this.#options.invocationContext.run({ adapterId, phase, signal, request, confidential: invocation.confidential === true, attempt: request.attempt, executionKey: request.idempotencyKey },
124:         () => raw.invoke({ ...invocation, signal }));
125:       } finally { phase.close(); }
126:     }, ...(raw.receipt ? { receipt: async (request) => {
127:       request = structuredClone(request);
128:       const phase = new AdapterInvocationPhase(lifecycle.signal, this.#options.runtime.shutdownTimeoutMs);
129:       try {
130:         phase.assertActive();
131:         const result = await this.#options.invocationContext.run({ adapterId, phase, signal: lifecycle.signal, request, confidential: false, attempt: request.attempt, executionKey: request.idempotencyKey },
132:           () => raw.receipt!(structuredClone(request)));
133:         phase.assertActive();return result;
134:       } finally { phase.close(); }
135:     } } : {}), shutdown: (signal) => raw.shutdown(signal) };
136:   }
137: 
138:   async #cleanup<T>(adapterId: string, lifecycle: AbortController, active: () => void,
139:     operation: (context: AdapterCleanupContext) => Promise<T>): Promise<T> {
140:     active();
141:     const parent = this.#options.invocationContext.getStore();
142:     if (!parent || parent.adapterId !== adapterId) throw new Error('ADAPTER_CLEANUP_INVOCATION_REQUIRED');
143:     return parent.phase.cleanup(signal => {
144:       const owner = { ...parent, signal };
145:       const invoke = (capability: string, request: CapabilityInvocation, confidential: boolean, options?: AdapterDependencyOptions) =>
146:         this.#options.invocationContext.run(owner, () => this.#invokeDependency(adapterId, lifecycle, active, capability, request, confidential, options));
147:       const context: AdapterCleanupContext = Object.freeze({ signal,
148:         invoke: (capability: string, request: CapabilityInvocation, options?: AdapterDependencyOptions) => invoke(capability, request, false, options),
149:         invokeConfidential: (capability: string, request: CapabilityInvocation, options?: AdapterDependencyOptions) => invoke(capability, request, true, options),
150:       });
151:       return this.#options.invocationContext.run(owner, () => operation(context));
152:     });
153:   }
154: 
155:   async #ready(adapterId: string, instance: AdapterInstance, lifecycle: AbortController): Promise<void> {
156:     if (this.#options.stopping() || lifecycle.signal.aborted) throw new Error('ADAPTER_RUNTIME_STOPPING');
157:     try { await withAdapterStartupTimeout(adapterId, 'ready', this.#options.runtime.shutdownTimeoutMs, () => instance.ready(), (error) => lifecycle.abort(error)); }
158:     catch (error) { await this.#teardownFailed(adapterId, instance, lifecycle, error); }
159:     if (this.#options.stopping() || lifecycle.signal.aborted) throw new Error('ADAPTER_RUNTIME_STOPPING');
160:   }
161: 
162:   async #teardownFailed(adapterId: string, instance: AdapterInstance, lifecycle: AbortController, error: unknown): Promise<never> {
163:     lifecycle.abort(error); this.#instances.delete(adapterId); this.#controllers.delete(adapterId); this.#options.pendingInstances.delete(adapterId); this.#options.pendingControllers.delete(adapterId);
164:     const controller = new AbortController(); const timer = setTimeout(() => controller.abort(), this.#options.runtime.shutdownTimeoutMs);
165:     try { await this.#options.shutdown(instance, controller.signal); }
166:     catch { /* INTENTIONAL_NONCRITICAL(readiness_teardown_failed): Preserve the readiness failure after bounded teardown. */ }
167:     finally { clearTimeout(timer); }
168:     throw error;
169:   }
170: 
171:   async #rollback(): Promise<void> {
172:     this.#controllers.forEach((controller) => controller.abort(new Error('ADAPTER_ACTIVATION_ROLLED_BACK')));
173:     const controller = new AbortController(); const timer = setTimeout(() => controller.abort(), this.#options.runtime.shutdownTimeoutMs);
174:     try { for (const instance of [...this.#instances.values()].reverse()) { try { await this.#options.shutdown(instance, controller.signal); }
175:       catch { /* INTENTIONAL_NONCRITICAL(adapter_rollback_failed): Preserve activation failure while attempting rollback. */ } } }
176:     finally { clearTimeout(timer); this.#starting.clear(); for (const id of this.#controllers.keys()) { this.#options.pendingControllers.delete(id); this.#options.pendingInstances.delete(id); } }
177:   }
178: }
179: 
180: function dependencyDeliveryId(options: AdapterDependencyOptions | undefined, parent: AdapterInvocationOwner | undefined): string | undefined {
181:   const value = options?.deliveryId;
182:   if (value !== undefined && (typeof value !== 'string' || !value.trim() || value.length > 512 || !parent)) throw new Error('ADAPTER_DELIVERY_OWNER_REQUIRED');
183:   return value;
184: }
185: 
186: function dependencyInvocation(adapterId: string, capability: string, request: CapabilityInvocation, parent: AdapterInvocationOwner | undefined, deliveryId: string | undefined) {
187:   const attempt = parent?.attempt ?? { runId: `adapter:${adapterId}`, stageId: 'adapter-activation', attemptId: `adapter:${adapterId}`, attemptNumber: 1 };
188:   const owner = parent ? `:parent:${requestDigest({ operation: 'owner', resource: { type: 'effect.key', canonicalId: parent.executionKey }, payload: { attempt: parent.attempt } })}` : '';
189:   const dependencyParent = parent ? {request: parent.request, confidential: parent.confidential} : undefined;
190:   const {key: idempotencyKey, scope} = portableDependencyKey(adapterId, capability, request, dependencyParent, deliveryId);
191:   return { idempotencyKey, dependencyIdentity: {prefix: `adapter:${adapterId}:${capability}:`, suffix: owner, scope, currentKey: idempotencyKey,
192:     ...(dependencyParent ? {parent: dependencyParent} : {})}, attempt, capability,
193:     operation: request.operation, resource: request.resource, payload: request.payload, ...runtimeDispatchProfileFields(request), ...(deliveryId === undefined ? {} : { deliveryId }) };
194: }
