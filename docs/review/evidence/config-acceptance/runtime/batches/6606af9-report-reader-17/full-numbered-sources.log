197: /** Bounded, read-only projection of the original completed journal. Never repairs a tail. */
198: export function readRunEvidence(input: RunEvidenceSelection, configured: ReadOptions): RunEvidenceProjection {
199:   const selection = { runId: input.runId, journalHead: input.journalHead, snapshotDigest: input.snapshotDigest };
200:   const options = structuredClone(configured);
201:   validateSelection(selection,options);
202:   directories(options.storageRoot);
203:   const root = runRoot(options.storageRoot, selection.runId, { maximumLegacyBytes: options.maximumBytes });
204:   const pinned = directories(root);
205:   const eventsFile = path.join(root, 'events.jsonl'); const snapshotFile = path.join(root, 'run-snapshot.json');
206:   const events = readFile(eventsFile, options.maximumBytes);
207:   const snapshotRead = readFile(snapshotFile, options.maximumBytes - events.bytes.length);
208:   const snapshot = JSON.parse(snapshotRead.bytes.toString()) as RunSnapshot; assertRunSnapshot(snapshot);
209:   if(snapshot.registry.effectAuditVersion!=='coordinator-mode.v1')throw new Error('RUN_EVIDENCE_EFFECT_MODE_UNVERIFIABLE:historical snapshot predates coordinator mode evidence; automatic migration is unsupported');
210:   if (snapshot.digest !== selection.snapshotDigest) throw new Error('RUN_EVIDENCE_SNAPSHOT_MISMATCH');
211:   const records: JournalRecord<LifecycleEvent | PluginDomainEvent>[] = [];
212:   parseJournalRecords(events.bytes, records, eventsFile);
213:   if (!records.length || records.at(-1)!.hash !== selection.journalHead) throw new Error('RUN_EVIDENCE_HEAD_MISMATCH');
214:   const terminal = records.filter(({ entry }) => entry.schemaVersion === 'lifecycle-event.v2' && entry.type.startsWith('run.')).at(-1)?.entry.type;
215:   if (!terminal || !['run.succeeded', 'run.failed', 'run.cancelled'].includes(terminal)) throw new Error('RUN_EVIDENCE_NOT_COMPLETED');
216:   const definition: PipelineDefinition = { schemaVersion: 'pipeline-definition.v2', id: snapshot.graph.pipelineId,
217:     maxConcurrency: snapshot.graph.maxConcurrency, stages: [...snapshot.graph.nodes] as PipelineDefinition['stages'] };
218:   validateContractValue('pipelineDefinition', definition);
219:   const states = recoverStageStates(definition, records, selection.runId, options.orchestratorIssuerId);
220:   const sources = attemptArtifacts(records, selection.runId);
221:   if (!sameFile(events.stat, fs.lstatSync(eventsFile)) || !sameFile(snapshotRead.stat, fs.lstatSync(snapshotFile))) throw new Error('RUN_EVIDENCE_CHANGED');
222:   verifyDirectories(pinned);
223:   const effectsFile=path.join(root,'effects.jsonl');
224:   const effectsHead=inspectEffects(effectsFile,records,options.maximumBytes-events.bytes.length-snapshotRead.bytes.length,snapshot.registry);
225:   if (!sameFile(events.stat, fs.lstatSync(eventsFile)) || !sameFile(snapshotRead.stat, fs.lstatSync(snapshotFile))) throw new Error('RUN_EVIDENCE_CHANGED');
226:   verifyDirectories(pinned);
227:   return structuredClone({ schemaVersion: 'run-evidence-projection.v1', ...selection, pipelineId: definition.id, terminal,
228:     eventCount: records.length, effectsHead, stages: definition.stages.map(stage => ({ stageId: stage.id, stageType: stage.type,
229:       status: states.get(stage.id)!.status, attempts: states.get(stage.id)!.attemptNumber })), ...sources });
230: }
