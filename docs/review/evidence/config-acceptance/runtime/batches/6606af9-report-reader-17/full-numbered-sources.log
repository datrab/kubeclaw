1: import type {
2:   LifecycleEvent,
3:   PipelineDefinition,
4:   PluginDomainEvent,
5: } from '@kubeclaw/plugin-sdk';
6: import type { JournalRecord } from '../state/journal.ts';
7: import type { StageRuntimeState } from './reducer.ts';
8: import { FrozenMap } from '@kubeclaw/plugin-foundation/registry/frozen-map';
9: import { applyRecoveryEvent, initialStageStates, resetInterruptedStages } from './recovery-state.ts';
10: import { repairIdentityContexts } from './repair-projection.ts';
11: 
12: function deepFreeze<T>(value: T): T {
13:   if (!value || typeof value !== 'object' || Object.isFrozen(value)) return value;
14:   for (const nested of Object.values(value as Record<string, unknown>)) deepFreeze(nested);
15:   return Object.freeze(value);
16: }
17: 
18: export function recoverStageStates(
19:   definition: PipelineDefinition,
20:   records: readonly JournalRecord<LifecycleEvent | PluginDomainEvent>[],
21:   runId: string,
22:   orchestratorIssuerId: string,
23: ): ReadonlyMap<string, StageRuntimeState> {
24:   const states = initialStageStates(definition);
25:   const identities = repairIdentityContexts(records, runId);
26:   for (const record of records) {
27:     const event = record.entry;
28:     if (event.schemaVersion !== 'lifecycle-event.v2' || event.identity.runId !== runId) continue;
29:     applyRecoveryEvent(definition, states, event, orchestratorIssuerId, identities.get(event));
30:   }
31:   resetInterruptedStages(states);
32:   return new FrozenMap(
33:     [...states].map(([stageId, state]) => [stageId, deepFreeze(structuredClone(state))]),
34:   );
35: }
