75: interface RunSnapshotBase { readonly graph: ExecutionGraphSnapshot; readonly registry: Readonly<Record<string, unknown>>; readonly digest: string }
76: export type RunSnapshot = RunSnapshotBase & (
77:   { readonly schemaVersion: 'run-snapshot.v1' | 'run-snapshot.v2'; readonly runtimeDispatchProfile?: never; readonly reviewCacheProfile?: never }
78:   | { readonly schemaVersion: 'run-snapshot.v3'; readonly runtimeDispatchProfile: RuntimeDispatchProfile; readonly reviewCacheProfile?: never }
79:   | { readonly schemaVersion: 'run-snapshot.v4'; readonly runtimeDispatchProfile: RuntimeDispatchProfile; readonly reviewCacheProfile: ReviewCacheProfile }
80: );
81: function snapshotDigest(value: unknown, version: RunSnapshot['schemaVersion']): string {
82:   if (!['run-snapshot.v1', 'run-snapshot.v2', 'run-snapshot.v3', 'run-snapshot.v4'].includes(version)) throw new Error('RUN_SNAPSHOT_VERSION_INVALID');
83:   return `sha256:${crypto.createHash('sha256').update(version === 'run-snapshot.v1' ? canonicalJson(value) : portableJson(value)).digest('hex')}`;
84: }
85: export function assertRunSnapshot(snapshot: RunSnapshot): void {
86:   const { digest, ...unsigned } = snapshot;
87:   if (!['run-snapshot.v1', 'run-snapshot.v2', 'run-snapshot.v3', 'run-snapshot.v4'].includes(snapshot.schemaVersion)
88:     || !['execution-graph-snapshot.v2', 'execution-graph-snapshot.v3'].includes(snapshot.graph?.schemaVersion)
89:     || digest !== snapshotDigest(unsigned, snapshot.schemaVersion)) throw new Error('RUN_SNAPSHOT_INTEGRITY_INVALID');
90:   if (snapshot.schemaVersion === 'run-snapshot.v4') {
91:     parseRuntimeDispatchProfile(snapshot.runtimeDispatchProfile); parseReviewCacheProfile(snapshot.reviewCacheProfile);
92:     validateContractValue('runtimeRunSnapshotV4', snapshot);
93:   }
94:   else if (snapshot.schemaVersion === 'run-snapshot.v3') {
95:     parseRuntimeDispatchProfile(snapshot.runtimeDispatchProfile); validateContractValue('runtimeRunSnapshot', snapshot);
96:   }
97:   else if (Object.hasOwn(snapshot, 'runtimeDispatchProfile')) throw new Error('RUN_SNAPSHOT_LEGACY_PROFILE_INVALID');
98:   if (snapshot.schemaVersion !== 'run-snapshot.v4' && Object.hasOwn(snapshot, 'reviewCacheProfile')) throw new Error('RUN_SNAPSHOT_LEGACY_CACHE_PROFILE_INVALID');
99: }
100: export function readRunSnapshot(runRoot: string): RunSnapshot {
101:   const snapshot = JSON.parse(fs.readFileSync(path.join(runRoot, 'run-snapshot.json'), 'utf8')) as RunSnapshot;
102:   assertRunSnapshot(snapshot);
103:   return snapshot;
104: }
105: export function writeRunSnapshots(runRoot: string, graph: ExecutionGraphSnapshot, registry: Readonly<Record<string, unknown>>): void {
106:   if (['run-snapshot.json', 'graph-snapshot.json', 'registry-snapshot.json'].some((name) => fs.existsSync(path.join(runRoot, name)))) throw new Error(`RUN_ALREADY_EXISTS:${runRoot}`);
107:   const unsigned = { schemaVersion: 'run-snapshot.v4' as const, graph, registry, runtimeDispatchProfile: CURRENT_RUNTIME_DISPATCH_PROFILE, reviewCacheProfile: CURRENT_REVIEW_CACHE_PROFILE };
108:   const snapshot = { ...unsigned, digest: snapshotDigest(unsigned, unsigned.schemaVersion) };
109:   assertRunSnapshot(snapshot);
110:   const file = path.join(runRoot, 'run-snapshot.json');
111:   const temporary = path.join(runRoot, `.snapshot-${crypto.randomUUID()}.tmp`);
112:   const descriptor = fs.openSync(temporary, 'wx', 0o600);
113:   try { fs.writeFileSync(descriptor, JSON.stringify(snapshot)); fs.fsyncSync(descriptor); }
114:   finally { fs.closeSync(descriptor); }
115:   try {
116:     // Atomic no-replace publication: readers can never see half a snapshot pair.
117:     fs.linkSync(temporary, file);
118:     const directory = fs.openSync(runRoot, 'r');
119:     try { fs.fsyncSync(directory); } finally { fs.closeSync(directory); }
120:   } finally { fs.unlinkSync(temporary); }
121: }
