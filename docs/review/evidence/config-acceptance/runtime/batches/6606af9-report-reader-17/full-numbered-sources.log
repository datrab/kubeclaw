SOURCE skills/nova/core/state/read-run-evidence.ts SHA256 bd33a3503d61236a03fcd19ae61fc3fde838d0dfefacacb7c1e75ff820444065
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import { canonicalJson, type ArtifactRef, type AttemptIdentity, type EffectRequest, type EffectReceipt, type RegistrationProvenance, type LifecycleEvent, type PipelineDefinition, type PluginDomainEvent, type StageAttempt, type StageResult } from '@kubeclaw/plugin-sdk';
4: import { validateContractValue } from '@kubeclaw/plugin-foundation/registry/schema';
5: import { validEffectIdentity } from '../effects/identity.ts';
6: import { runRoot } from '../execution/run-root.ts';
7: import { assertRunSnapshot, type RunSnapshot } from '../execution/engine-snapshots.ts';
8: import { recoverStageStates } from '../lifecycle/recovery.ts';
9: import { parseJournalRecords, type JournalRecord } from './journal.ts';
10: 
11: export interface RunEvidenceSelection {
12:   readonly runId: string;
13:   readonly journalHead: string;
14:   readonly snapshotDigest: string;
15: }
16: export interface RunEvidenceProjection extends RunEvidenceSelection {
17:   readonly schemaVersion: 'run-evidence-projection.v1';
18:   readonly pipelineId: string;
19:   readonly terminal: string;
20:   readonly eventCount: number;
21:   readonly effectsHead: string | null;
22:   readonly stages: readonly { readonly stageId: string; readonly stageType: string; readonly status: string; readonly attempts: number }[];
23:   readonly attempts: readonly { readonly identity: AttemptIdentity; readonly outcome: StageResult['outcome']; readonly eventHash: string }[];
24:   readonly artifacts: readonly ArtifactRef[];
25: }
26: interface ReadOptions {
27:   readonly storageRoot: string;
28:   readonly maximumBytes: number;
29:   readonly orchestratorIssuerId: string;
30: }
31: function sameFile(a: fs.Stats, b: fs.Stats): boolean {
32:   return a.dev === b.dev && a.ino === b.ino && a.size === b.size && a.mtimeMs === b.mtimeMs && a.ctimeMs === b.ctimeMs;
33: }
34: function readFile(file: string, maximumBytes: number): { bytes: Buffer; stat: fs.Stats } {
35:   const descriptor = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
36:   try {
37:     const stat = fs.fstatSync(descriptor);
38:     if (!stat.isFile() || stat.size > maximumBytes) throw new Error('RUN_EVIDENCE_FILE_OR_BUDGET_INVALID');
39:     const bytes = Buffer.alloc(stat.size + 1);
40:     let total = 0;
41:     while (total < bytes.length) {
42:       const count = fs.readSync(descriptor, bytes, total, bytes.length - total, total);
43:       if (!count) break;
44:       total += count;
45:     }
46:     if (total !== stat.size || !sameFile(stat, fs.fstatSync(descriptor))) throw new Error('RUN_EVIDENCE_CHANGED');
47:     return { bytes: bytes.subarray(0, total), stat };
48:   } finally { fs.closeSync(descriptor); }
49: }
50: function directories(root: string): Map<string, fs.Stats> {
51:   const pinned = new Map<string, fs.Stats>();
52:   let cursor = path.parse(root).root;
53:   for (const component of root.slice(cursor.length).split(path.sep).filter(Boolean)) {
54:     cursor = path.join(cursor, component);
55:     const stat = fs.lstatSync(cursor);
56:     if (!stat.isDirectory() || stat.isSymbolicLink()) throw new Error('RUN_EVIDENCE_ROOT_INVALID');
57:     pinned.set(cursor, stat);
58:   }
59:   return pinned;
60: }
61: function checkedAttempt(entry: LifecycleEvent, runId: string, open: Map<string,AttemptIdentity>): StageAttempt {
62:   const attempt=entry.payload.attempt as StageAttempt;
63:   validateContractValue('stageAttempt',attempt);
64:   if (attempt.identity.attemptId !== entry.identity.attemptId || attempt.identity.runId !== runId
65:     || attempt.identity.stageId !== entry.identity.stageId || open.has(attempt.identity.attemptId)) throw new Error('RUN_EVIDENCE_ATTEMPT_INVALID');
66:   return attempt;
67: }
68: interface EffectEvidence { request: EffectRequest; accepted: boolean; receipt?: EffectReceipt }
69: function effectRecords(file: string, maximumBytes: number) {
70:   const read=readFile(file,maximumBytes);
71:   const records: JournalRecord<{type:string;request?:EffectRequest;receipt?:EffectReceipt}>[]=[];
72:   parseJournalRecords(read.bytes,records,file);
73:   const effects=new Map<string,EffectEvidence>();
74:   for(const {entry} of records) {
75:     if(entry.type==='requested') {
76:       const request=entry.request!; if(request.schemaVersion!=='effect-request.v2'||!validEffectIdentity(request))throw new Error('RUN_EVIDENCE_EFFECT_INVALID');
77:       if(effects.has(request.idempotencyKey))throw new Error('RUN_EVIDENCE_EFFECT_INVALID');
78:       effects.set(request.idempotencyKey,{request,accepted:false});
79:     } else completeEffectEntry(effects,entry);
80:   }
81:   if([...effects.values()].some(effect=>!effect.receipt))throw new Error('RUN_EVIDENCE_EFFECT_UNRESOLVED');
82:   return {...read,head:records.at(-1)?.hash??null,effects};
83: }
84: function completeEffectEntry(effects: Map<string,EffectEvidence>, entry: {type:string;request?:EffectRequest;receipt?:EffectReceipt}): void {
85:   const key=entry.request?.idempotencyKey??entry.receipt?.idempotencyKey;
86:   const effect=effects.get(key!);
87:   if(!effect||effect.receipt)throw new Error('RUN_EVIDENCE_EFFECT_INVALID');
88:   if(entry.type==='accepted') {
89:     if(effect.accepted||canonicalJson(entry.request)!==canonicalJson(effect.request))throw new Error('RUN_EVIDENCE_EFFECT_INVALID');
90:     effect.accepted=true;return;
91:   }
92:   if(!['completed','completed-reference'].includes(entry.type)||!effect.accepted)throw new Error('RUN_EVIDENCE_EFFECT_INVALID');
93:   validateContractValue('effectReceipt',entry.receipt);
94:   if(entry.receipt!.effectId!==effect.request.effectId)throw new Error('RUN_EVIDENCE_EFFECT_INVALID');
95:   effect.receipt=entry.receipt!;
96: }
97: function matchesAudit(event: LifecycleEvent, effect: EffectEvidence): boolean {
98:   const request=effect.request;
99:   if(event.payload.executionMode!=='durable')return false;
100:   if(event.identity.runId!==request.attempt.runId||event.identity.stageId!==request.attempt.stageId
101:     ||event.identity.attemptId!==request.attempt.attemptId)return false;
102:   if(event.type==='effect.requested')return canonicalJson(event.payload)===canonicalJson({executionMode:'durable',capability:request.capability,operation:request.operation,resource:request.resource});
103:   if(event.type==='effect.accepted')return effect.accepted;
104:   const expected=effect.receipt!.status==='completed'?'effect.completed':'effect.failed';
105:   return event.type===expected&&canonicalJson(event.payload.adapter)===canonicalJson(effect.receipt!.adapter);
106: }
107: function pinnedConfidentialProvider(requested: LifecycleEvent, completed: LifecycleEvent, registry: RunSnapshot['registry']): boolean {
108:   const capability=requested.payload.capability;
109:   if(typeof capability!=='string'||!Array.isArray(registry.selectedProviders))return false;
110:   const selected=registry.selectedProviders as {capability:string;provider:RegistrationProvenance}[];
111:   const provider=selected.find(entry=>entry.capability===capability)?.provider;
112:   if(!provider)return false;
113:   return canonicalJson(completed.payload.adapter)===canonicalJson({...provider.package.package,registrationId:provider.registrationId});
114: }
115: function confidentialAudit(events: readonly LifecycleEvent[], registry: RunSnapshot['registry']): boolean {
116:   const requested=events.find(event=>event.type==='effect.requested');
117:   const accepted=events.find(event=>event.type==='effect.accepted');
118:   const completed=events.find(event=>event.type==='effect.completed'||event.type==='effect.failed');
119:   if(events.length!==3||!requested||!accepted||!completed)return false;
120:   if(events[0]!==requested||events[1]!==accepted||events[2]!==completed
121:     ||events.some(event=>event.payload.executionMode!=='confidential'||canonicalJson(event.identity)!==canonicalJson(requested.identity)))return false;
122:   if(!pinnedConfidentialProvider(requested,completed,registry))return false;
123:   const resource=requested.payload.resource as Record<string,unknown>;
124:   const result=completed.payload.result as Record<string,unknown>|undefined;
125:   const error=completed.payload.error as Record<string,unknown>|undefined;
126:   return resource?.canonicalId==='[confidential]'&&(result?.confidential===true||error?.code==='adapter.confidential_effect_failed');
127: }
128: function reconcileEffects(records: readonly JournalRecord<LifecycleEvent | PluginDomainEvent>[], effects: Map<string,EffectEvidence>, registry: RunSnapshot['registry']): void {
129:   const byId=new Map([...effects.values()].map(effect=>[effect.request.effectId,effect]));
130:   if(byId.size!==effects.size)throw new Error('RUN_EVIDENCE_EFFECT_INVALID');
131:   const audit=new Map<string,LifecycleEvent[]>();
132:   for(const {entry} of records) {
133:     if(entry.schemaVersion!=='lifecycle-event.v2'||!entry.type.startsWith('effect.'))continue;
134:     const id=entry.identity.effectId!;
135:     audit.set(id,[...(audit.get(id)??[]),entry]);
136:   }
137:   for(const [id,events] of audit) {
138:     const effect=byId.get(id);
139:     if(!effect) {
140:       if(!confidentialAudit(events,registry))throw new Error('RUN_EVIDENCE_EFFECT_AUDIT_MISMATCH');
141:     } else if(events.some(event=>!matchesAudit(event,effect)))throw new Error('RUN_EVIDENCE_EFFECT_AUDIT_MISMATCH');
142:   }
143:   for(const effect of effects.values()) {
144:     if(effect.request.attempt.attemptId.startsWith('observer:'))continue;
145:     const events=audit.get(effect.request.effectId)??[];
146:     if(!events.some(event=>event.type==='effect.requested')||!events.some(event=>event.type==='effect.completed'||event.type==='effect.failed'))throw new Error('RUN_EVIDENCE_EFFECT_AUDIT_MISMATCH');
147:   }
148: }
149: function inspectEffects(file: string, records: readonly JournalRecord<LifecycleEvent | PluginDomainEvent>[], maximumBytes: number, registry: RunSnapshot['registry']) {
150:   if(!fs.existsSync(file)) {
151:     reconcileEffects(records,new Map(),registry);return null;
152:   }
153:   const effects=effectRecords(file,maximumBytes);
154:   reconcileEffects(records,effects.effects,registry);
155:   if(!sameFile(effects.stat,fs.lstatSync(file)))throw new Error('RUN_EVIDENCE_CHANGED');
156:   return effects.head;
157: }
158: function validateSelection(selection: RunEvidenceSelection, options: ReadOptions): void {
159:   if (!Number.isSafeInteger(options.maximumBytes) || options.maximumBytes < 1) throw new Error('RUN_EVIDENCE_BUDGET_INVALID');
160:   if (!path.isAbsolute(options.storageRoot) || !/^sha256:[a-f0-9]{64}$/u.test(selection.journalHead)
161:     || !/^sha256:[a-f0-9]{64}$/u.test(selection.snapshotDigest)) throw new Error('RUN_EVIDENCE_SELECTION_INVALID');
162: }
163: function verifyDirectories(pinned: Map<string,fs.Stats>): void {
164:   for (const [directory, stat] of pinned) {
165:     const current = fs.lstatSync(directory);
166:     if (!current.isDirectory() || stat.dev !== current.dev || stat.ino !== current.ino) throw new Error('RUN_EVIDENCE_CHANGED');
167:   }
168: }
169: function attemptArtifacts(records: readonly JournalRecord<LifecycleEvent | PluginDomainEvent>[], runId: string) {
170:   const open = new Map<string, AttemptIdentity>();
171:   const attempts: RunEvidenceProjection['attempts'][number][] = [];
172:   const artifacts: ArtifactRef[] = [];
173:   for (const { entry, hash } of records) {
174:     if (entry.identity.runId !== runId) throw new Error('RUN_EVIDENCE_RUN_MISMATCH');
175:     if (entry.schemaVersion !== 'lifecycle-event.v2') continue;
176:     validateContractValue('lifecycleEvent', entry);
177:     if (entry.type === 'attempt.created') {
178:       const attempt = checkedAttempt(entry,runId,open);
179:       open.set(attempt.identity.attemptId, attempt.identity);
180:     }
181:     if (!['attempt.completed', 'attempt.cancelled', 'attempt.timed_out'].includes(entry.type)) continue;
182:     const identity = open.get(entry.identity.attemptId!);
183:     if (!identity || identity.stageId !== entry.identity.stageId) throw new Error('RUN_EVIDENCE_ATTEMPT_INVALID');
184:     const result = entry.payload.result as StageResult;
185:     validateContractValue('stageResult', result);
186:     for (const artifact of result.artifacts) {
187:       if (canonicalJson(artifact.producer) !== canonicalJson(identity)) throw new Error('RUN_EVIDENCE_ARTIFACT_OWNER_INVALID');
188:       if (!artifacts.some(ref => canonicalJson(ref) === canonicalJson(artifact))) artifacts.push(artifact);
189:     }
190:     attempts.push({ identity, outcome: result.outcome, eventHash: hash });
191:     open.delete(identity.attemptId);
192:   }
193:   if (open.size) throw new Error('RUN_EVIDENCE_ATTEMPT_UNFINISHED');
194:   return { attempts, artifacts };
195: }
