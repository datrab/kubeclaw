1: import type {StageDefinition} from '@kubeclaw/plugin-sdk';
2: import {validatePipelineTestGateContract,resolvedTestPlanDigest,type ResolvedTestPlanV1} from '@kubeclaw/pipeline-test-gate-contract';
3: export interface Demo {readonly authNodeId:string;readonly protocol:'json-session.v1';readonly operatorTarget:string;readonly retentionSeconds:number;}
4: function configuration(value:unknown):Demo {
5:   if(!value||typeof value!=='object'||Array.isArray(value))throw new Error('PROJECT_DEMO_INVALID');
6:   const record=value as Record<string,unknown>;
7:   if(Object.keys(record).some(key=>!['authNodeId','protocol','operatorTarget','retentionSeconds'].includes(key))
8:     ||typeof record.authNodeId!=='string'||!record.authNodeId||record.authNodeId.length>2048||record.protocol!=='json-session.v1'
9:     ||typeof record.operatorTarget!=='string'||!/^[a-z0-9][a-z0-9._:-]{0,127}$/u.test(record.operatorTarget))throw new Error('PROJECT_DEMO_INVALID');
10:   const seconds=retention(record.retentionSeconds);
11:   return {authNodeId:record.authNodeId,protocol:record.protocol,operatorTarget:record.operatorTarget,retentionSeconds:seconds};
12: }
13: function retention(value:unknown):number {
14:   const seconds=value===undefined?604800:value;
15:   if(typeof seconds!=='number'||!Number.isSafeInteger(seconds)||seconds<1||seconds>9223372036)throw new Error('PROJECT_DEMO_RETENTION_INVALID');return seconds;
16: }
17: function validatePlan(value:unknown,demo:Demo):void {
18:   validatePipelineTestGateContract('resolvedTestPlan',value);const plan=value as ResolvedTestPlanV1;
19:   const {planDigest,...unsigned}=plan;if(resolvedTestPlanDigest(unsigned)!==planDigest)throw new Error('PROJECT_DEMO_PLAN_DIGEST_MISMATCH');
20:   const auth=plan.nodes.find(node=>node.id===demo.authNodeId);
21:   assertAuthentication(auth,plan,demo);
22:   const incoming=(nodeId:string,input:string)=>{const links=plan.links.filter(link=>link.to.nodeId===nodeId&&link.to.input===input);
23:     if(links.length!==1)throw new Error('PROJECT_DEMO_SOURCE_LINK_REQUIRED');const link=links[0]!,node=plan.nodes.find(item=>item.id===link.from.nodeId);
24:     if(!node||node.skipReason!==null)throw new Error('PROJECT_DEMO_SOURCE_NODE_REQUIRED');return {link,node};};
25:   const deployment=incoming(demo.authNodeId,'deployment'),credentials=incoming(demo.authNodeId,'credentials'),exposure=incoming(demo.authNodeId,'exposure');
26:   assertFixtures(deployment,credentials,exposure);
27:   const source=incoming(exposure.node.id,'deployment');if(source.node.id!==deployment.node.id||source.link.from.output!==deployment.link.from.output)throw new Error('PROJECT_DEMO_EXPOSURE_BINDING_REQUIRED');
28:   const image=incoming(deployment.node.id,'image'),manifest=incoming(deployment.node.id,'checked-manifest');
29:   if(image.node.provider.packageId!=='kubeclaw.container-build'||image.link.kind!=='value'||image.link.schemaId!=='kubeclaw.container-image@1'
30:     ||manifest.link.kind!=='artifact'||manifest.link.mediaType!=='application/vnd.kubeclaw.checked-kubernetes-yaml')throw new Error('PROJECT_DEMO_SOURCE_BUILD_REQUIRED');
31: }
32: export function normalizeDemo(value:unknown):Demo|undefined {return value===undefined?undefined:configuration(value);}
33: export function demoStages(value:unknown,plan:unknown):StageDefinition[] {
34:   if(value===undefined)return [];
35:   const demo=configuration(value);validatePlan(plan,demo);
36:   const execution={maxAttempts:2,maxRemediationCycles:0,maxTechnicalRetries:1,timeoutMs:120000};
37:   return [{id:'demo-candidate',type:'kubeclaw.demo.candidate',dependsOn:['project-summary'],config:{},input:{manifestStageId:'project-summary',...demo},execution},
38:     {id:'demo-delivery',type:'kubeclaw.demo.delivery',dependsOn:['demo-candidate'],config:{},input:{candidateStageId:'demo-candidate'},execution},
39:     {id:'demo-ready',type:'kubeclaw.demo.ready',dependsOn:['demo-delivery'],config:{},input:{candidateStageId:'demo-candidate',deliveryStageId:'demo-delivery'},execution}];
40: }
