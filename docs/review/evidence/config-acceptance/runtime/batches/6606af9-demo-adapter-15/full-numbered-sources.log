SOURCE skills/nova/plugins/demo-handoff/src/delivery.ts SHA256 a1dfb3d6fef144d5f11e3546039ba4a291c97ad4f5fcf7ee0279b83fdfadaff7
1: import type {PluginInvocationContext,StageResult} from '@kubeclaw/plugin-sdk';
2: import {NAMESPACE,object,exact,text,select,ref} from './protocol.ts';
3: export async function execute(value:unknown,context:PluginInvocationContext):Promise<StageResult> {
4:   try {
5:     const input=object(value);exact(input,['candidateStageId']);const candidate=select(context,text(input.candidateStageId),NAMESPACE);
6:     const result=await context.invoke('demo.handoff',{operation:'deliver',resource:{type:'demo.candidate',canonicalId:candidate.artifactId},payload:{namespace:NAMESPACE,candidate}});
7:     const stored=await context.invoke('artifacts.write',{operation:'put_json',resource:{type:'artifact.object',canonicalId:`demo-delivery:${context.contract.lease.attempt.runId}`},payload:{namespace:NAMESPACE,mediaType:'application/json',value:result}});
8:     return {schemaVersion:'stage-result.v2',outcome:'passed',artifacts:[ref(stored.artifact)]};
9:   }catch(error){return {schemaVersion:'stage-result.v2',outcome:'blocked',reason:{code:'demo.delivery_unresolved',message:error instanceof Error?error.message:String(error)},artifacts:[]};}
10: }
SOURCE skills/nova/plugins/demo-handoff/src/controller-client.ts SHA256 bee2a2f89be6489a9e26af5fd53193191057ec0c061497f2b7a0b49dbaebe315
1: import fs from 'node:fs/promises';
2: import {constants} from 'node:fs';
3: import https from 'node:https';
4: import {sha256Text} from '@kubeclaw/plugin-sdk';
5: import {object,exact,text,retention,type Value} from './protocol.ts';
6: export interface ClientConfig {readonly endpoint:string;readonly tokenPath:string;readonly caPath:string;}
7: async function boundedFile(file:string,limit:number,signal:AbortSignal):Promise<Buffer> {
8:   signal.throwIfAborted();
9:   const handle=await fs.open(file,constants.O_RDONLY|constants.O_NONBLOCK);
10:   try {const stat=await handle.stat();signal.throwIfAborted();if(!stat.isFile()||stat.size<1||stat.size>limit)throw new Error('DEMO_READY_CREDENTIAL_FILE_INVALID');
11:     const buffer=Buffer.alloc(limit+1);let size=0;
12:     while(size<buffer.length){signal.throwIfAborted();const read=await handle.read(buffer,size,buffer.length-size,null);if(read.bytesRead===0)break;size+=read.bytesRead;}
13:     signal.throwIfAborted();if(size>limit)throw new Error('DEMO_READY_CREDENTIAL_FILE_INVALID');return buffer.subarray(0,size);
14:   }finally{await handle.close();}
15: }
16: export async function post(config:ClientConfig,body:string,status:boolean,signal:AbortSignal):Promise<Value> {
17:   if(Buffer.byteLength(body)>16384)throw new Error('DEMO_READY_REQUEST_TOO_LARGE');
18:   const ca=await boundedFile(config.caPath,1024**2,signal),token=(await boundedFile(config.tokenPath,16384,signal)).toString('utf8').trim();
19:   if(!token||/[\s\u0000-\u001f]/u.test(token))throw new Error('DEMO_READY_TOKEN_INVALID');
20:   const url=new URL(config.endpoint);if(status)url.pathname+='/status';
21:   return new Promise((resolve,reject)=>{
22:     const request=https.request(url,{method:'POST',ca,signal,headers:{authorization:`Bearer ${token}`,'content-type':'application/json','content-length':Buffer.byteLength(body)}},response=>{
23:       const chunks:Buffer[]=[];let size=0;
24:       response.on('data',(chunk:Buffer)=>{size+=chunk.length;if(size>16384){request.destroy(new Error('DEMO_READY_RESPONSE_TOO_LARGE'));return;}chunks.push(chunk);});
25:       response.on('error',()=>reject(new Error('DEMO_READY_RESPONSE_UNRESOLVED')));
26:       response.on('end',()=>{
27:         if(signal.aborted){reject(new Error('DEMO_READY_CANCELLED'));return;}
28:         if(response.statusCode!==200){reject(new Error(`DEMO_READY_HTTP_${response.statusCode??0}:unresolved`));return;}
29:         try{resolve(object(JSON.parse(Buffer.concat(chunks).toString('utf8'))));}catch{reject(new Error('DEMO_READY_RESPONSE_INVALID'));}
30:       });
31:     });
32:     request.on('error',()=>reject(new Error('DEMO_READY_TRANSPORT_UNRESOLVED')));request.end(body);
33:   });
34: }
35: export function validateResponse(value:Value,request:Value,body:string):Value {
36:   exact(value,['schemaVersion','leaseName','leaseUID','requestId','state','readyAt','expiresAt','requestDigest','retentionSeconds']);
37:   const ready=Date.parse(text(value.readyAt)),expires=Date.parse(text(value.expiresAt));
38:   if(value.schemaVersion!=='demo-ready-response.v1'||value.state!=='ready-for-acceptance'||value.requestDigest!==sha256Text(body)
39:     ||['leaseName','leaseUID','requestId'].some(key=>value[key]!==request[key])||!Number.isFinite(ready)||value.retentionSeconds!==retention(request.retentionSeconds)||expires!==ready+retention(request.retentionSeconds)*1000
40:     ||expires<=Date.now()||ready<Date.parse(text(request.observedAt)))throw new Error('DEMO_READY_RESPONSE_UNBOUND');
41:   return value;
42: }
SOURCE skills/nova/plugins/demo-handoff/src/adapter.ts SHA256 245bff96d5198426aa2bc73739fdc4976fb632b0a4737b923594efa052af0855
1: import path from 'node:path';
2: import {canonicalJson,sha256Text,type AdapterActivationContext,type AdapterInstance,type EffectRequest} from '@kubeclaw/plugin-sdk';
3: import {FileDurableRecordStore} from '@kubeclaw/plugin-foundation/observability/durable-records';
4: import {NAMESPACE,exact,object,text,target,ref,type Value,type Reader} from './protocol.ts';
5: import {bind,delivered,deliveryArtifact,requestBody,type BindingConfig,type Binding} from './binding.ts';
6: import {post,validateResponse,type ClientConfig} from './controller-client.ts';
7: interface Config extends BindingConfig,ClientConfig {readonly stateRoot:string;readonly timeoutMs:number;}
8: function configuration(value:Value):Config {
9:   exact(value,['candidateStageId','deliveryStageId','readyStageId','manifestStageId','operatorTarget','endpoint','tokenPath','caPath','stateRoot','timeoutMs']);
10:   const endpoint=new URL(text(value.endpoint));
11:   if(endpoint.protocol!=='https:'||endpoint.pathname!=='/v1/demo-ready'||endpoint.search||endpoint.hash||endpoint.username||endpoint.password||endpoint.href!==value.endpoint)throw new Error('DEMO_READY_ENDPOINT_INVALID');
12:   const absolute=(item:unknown)=>{const result=text(item);if(!path.isAbsolute(result)||path.normalize(result)!==result)throw new Error('DEMO_READY_PATH_INVALID');return result;};
13:   const timeoutMs=Number(value.timeoutMs);if(!Number.isSafeInteger(timeoutMs)||timeoutMs<100||timeoutMs>60000)throw new Error('DEMO_READY_DEADLINE_INVALID');
14:   return {candidateStageId:text(value.candidateStageId),deliveryStageId:text(value.deliveryStageId),readyStageId:text(value.readyStageId),manifestStageId:text(value.manifestStageId),
15:     operatorTarget:target(value.operatorTarget),endpoint:endpoint.href,tokenPath:absolute(value.tokenPath),caPath:absolute(value.caPath),stateRoot:absolute(value.stateRoot),timeoutMs};
16: }
17: function assertRequest(request:EffectRequest,config:Config):void {
18:   if(request.capability!=='demo.handoff'||!['deliver','commit'].includes(request.operation)||request.resource.type!=='demo.candidate'||request.payload.namespace!==NAMESPACE)throw new Error('DEMO_HANDOFF_OPERATION_INVALID');
19:   exact(request.payload,request.operation==='deliver'?['namespace','candidate']:['namespace','candidate','delivery']);
20:   if(request.attempt.stageId!==(request.operation==='deliver'?config.deliveryStageId:config.readyStageId))throw new Error('DEMO_HANDOFF_PRODUCER_DENIED');
21:   if(request.resource.canonicalId!==ref(request.payload.candidate).artifactId)throw new Error('DEMO_HANDOFF_RESOURCE_INVALID');
22: }
23: async function lookup(context:Reader,bound:Binding,config:Config):Promise<Value> {
24:   return object(await context.invoke('operator.receipt',{operation:'lookup',resource:{type:'operator.target',canonicalId:config.operatorTarget},
25:     payload:{deliveryId:bound.deliveryId,stageId:config.deliveryStageId,payload:bound.payload}}));
26: }
27: async function commit(records:FileDurableRecordStore,config:Config,body:string,signal:AbortSignal,recovery:boolean):Promise<Value|undefined> {
28:   const request=object(JSON.parse(body)),key=text(request.requestId),stream='demo-ready/intents';
29:   let previous=(await records.read<Value>(stream)).find(entry=>entry.idempotencyKey===key);
30:   if(previous&&previous.payload.body!==body)throw new Error('DEMO_READY_INTENT_CONFLICT');
31:   if(!previous&&recovery)return undefined;
32:   let first=false;
33:   if(!previous){const admitted=await records.append(stream,key,{schemaVersion:'demo-ready-intent.v1',body});previous=admitted.record;first=admitted.appended;}
34:   signal.throwIfAborted();
35:   const statusBody=JSON.stringify({schemaVersion:'demo-ready-status-request.v1',leaseName:request.leaseName,leaseUID:request.leaseUID,requestId:request.requestId});
36:   let response:Value;
37:   if(first){try{response=await post(config,body,false,signal);}catch{signal.throwIfAborted();response=await post(config,statusBody,true,signal);}}
38:   else response=await post(config,statusBody,true,signal);
39:   signal.throwIfAborted();const accepted=validateResponse(response,request,body);
40:   await records.append('demo-ready/receipts',key,{schemaVersion:'demo-ready-commit.v1',requestDigest:sha256Text(body),response:accepted});
41:   signal.throwIfAborted();return {schemaVersion:'demo-ready-commit.v1',candidateDigest:request.candidateDigest,requestDigest:sha256Text(body),response:accepted};
42: }
43: export function activate(context:AdapterActivationContext):AdapterInstance {
44:   const config=configuration(context.config),stopping=new AbortController();
45:   const records=new FileDurableRecordStore(config.stateRoot,{maximumRecords:10000,maximumBytes:64*1024**2,maximumRecordBytes:65536});
46:   const execute=async(request:EffectRequest,signal:AbortSignal,recovery:boolean):Promise<Value|undefined>=>{
47:     assertRequest(request,config);signal.throwIfAborted();
48:     const reader:Reader={invoke:(capability,invocation)=>context.invoke(capability,invocation,{signal})};
49:     const bound=await bind(reader,ref(request.payload.candidate),request.attempt.runId,config);
50:     if(request.operation==='deliver') {
51:       const receipt=recovery?await lookup(reader,bound,config):object(await context.invoke('operator.request',{operation:'publish',resource:{type:'operator.target',canonicalId:config.operatorTarget},payload:bound.payload},{signal,deliveryId:bound.deliveryId}));
52:       // Even a returned completion is checked against the original durable request and receipt.
53:       const authoritative=await lookup(reader,bound,config);
54:       if(canonicalJson(receipt)!==canonicalJson(authoritative))throw new Error('DEMO_DELIVERY_RECEIPT_CHANGED');return deliveryArtifact(bound,authoritative);
55:     }
56:     const receipt=await delivered(reader,bound,ref(request.payload.delivery),request.attempt.runId,config);
57:     const body=requestBody(bound,receipt);if(Buffer.byteLength(body)>16384)throw new Error('DEMO_READY_REQUEST_TOO_LARGE');
58:     return commit(records,config,body,signal,recovery);
59:   };
60:   return {async ready(){stopping.signal.throwIfAborted();},async invoke(invocation){
61:     if(!invocation.confidential)invocation.fence.assertCurrent();
62:     const signal=AbortSignal.any([invocation.signal,stopping.signal,AbortSignal.timeout(config.timeoutMs)]);
63:     const value=await execute(invocation.request,signal,false);signal.throwIfAborted();return value!;
64:   },async receipt(request){
65:     const signal=AbortSignal.any([stopping.signal,AbortSignal.timeout(config.timeoutMs)]);
66:     const result=await execute(request,signal,true);signal.throwIfAborted();return result;
67:   },async shutdown(){stopping.abort(new Error('DEMO_HANDOFF_SHUTDOWN'));}};
68: }
