42: function assertAuthentication(auth:ResolvedTestPlanV1['nodes'][number]|undefined,plan:ResolvedTestPlanV1,demo:Demo):void {
43:   if(!auth||auth.kind!=='test'||auth.mode!=='blocking'||auth.skipReason!==null||auth.provider.packageId!=='kubeclaw.demo-auth-smoke'
44:     ||auth.provider.contractId!=='kubeclaw.demo-auth-smoke@1'||auth.configuration.values.protocol!==demo.protocol
45:     ||!plan.coverage?.policy.requiredChecks.some(check=>check.nodeIds.includes(auth.id)))throw new Error('PROJECT_DEMO_BLOCKING_AUTH_REQUIRED');
46: }
