SOURCE cmd/buster-namespace-controller/demo-retention.go SHA256 4a173d7f2012e8c9d58a0c2f93ceda77629bacac384e5f56fdbec9c459a7c2a7
1: package main
2: 
3: import (
4: 	"encoding/json"
5: 	"errors"
6: 	"time"
7: )
8: 
9: const defaultDemoRetentionSeconds int64 = 604800
10: 
11: // Technical arithmetic bound only; this is not an operational retention policy.
12: const maximumDemoRetentionSeconds int64 = (1<<63 - 1) / int64(time.Second)
13: 
14: func parseDemoRetention(raw json.RawMessage) (int64, error) {
15: 	if len(raw) == 0 {
16: 		return defaultDemoRetentionSeconds, nil
17: 	}
18: 	var seconds int64
19: 	if string(raw) == "null" || json.Unmarshal(raw, &seconds) != nil || seconds < 1 || seconds > maximumDemoRetentionSeconds {
20: 		return 0, errors.New("DEMO_READY_RETENTION_INVALID")
21: 	}
22: 	return seconds, nil
23: }
24: 
25: func storedDemoRetention(state map[string]interface{}) (int64, error) {
26: 	value, exists := state["retentionSeconds"]
27: 	if state["schemaVersion"] == "demo-readiness.v1" && !exists {
28: 		// Only the actual historical schema has implicit seven-day retention.
29: 		return defaultDemoRetentionSeconds, nil
30: 	}
31: 	if state["schemaVersion"] != "demo-readiness.v2" || !exists {
32: 		return 0, errors.New("DEMO_READY_RETENTION_INVALID")
33: 	}
34: 	raw, err := json.Marshal(value)
35: 	if err != nil {
36: 		return 0, errors.New("DEMO_READY_RETENTION_INVALID")
37: 	}
38: 	return parseDemoRetention(raw)
39: }
40: 
41: func demoRetentionDeadline(ready time.Time, seconds int64) (time.Time, error) {
42: 	if seconds < 1 || seconds > maximumDemoRetentionSeconds {
43: 		return time.Time{}, errors.New("DEMO_READY_RETENTION_INVALID")
44: 	}
45: 	expires := ready.Add(time.Duration(seconds) * time.Second)
46: 	if ready.Year() < 1 || ready.Year() > 9999 || expires.Year() < 1 || expires.Year() > 9999 {
47: 		return time.Time{}, errors.New("DEMO_READY_RETENTION_INVALID")
48: 	}
49: 	return expires, nil
50: }