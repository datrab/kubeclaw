SOURCE skills/nova/plugins/demo-handoff/src/binding.ts SHA256 6b7065fbfafb91cb4caf987c3f0391121515c9ff0e84d90039dae9948cf9ec91
1: import {canonicalJson,sha256Text,type ArtifactRef} from '@kubeclaw/plugin-sdk';
2: import {discordWebhookPayload} from '@kubeclaw/plugin-operator-messaging/src/discord-payload.ts';
3: import {NAMESPACE,object,exact,text,target,ref,read,evidence,deliveryIdentity,retention,type Reader,type Value} from './protocol.ts';
4: export interface BindingConfig {readonly candidateStageId:string;readonly deliveryStageId:string;readonly readyStageId:string;readonly manifestStageId:string;readonly operatorTarget:string;}
5: export async function bind(context:Reader,reference:ArtifactRef,runId:string,config:BindingConfig) {
6:   const candidate=await read(context,reference,runId,config.candidateStageId,NAMESPACE);
7:   exact(candidate,['schemaVersion','runId','manifest','authNodeId','protocol','operatorTarget','retentionSeconds','evidence']);
8:   if(candidate.schemaVersion!=='demo-candidate.v1'||candidate.runId!==runId||candidate.protocol!=='json-session.v1'||target(candidate.operatorTarget)!==config.operatorTarget)throw new Error('DEMO_CANDIDATE_BINDING_INVALID');
9:   retention(candidate.retentionSeconds);
10:   const manifest=ref(candidate.manifest);if(manifest.producer.stageId!==config.manifestStageId||manifest.producer.runId!==runId)throw new Error('DEMO_MANIFEST_OWNER_INVALID');
11:   const verified=await evidence(context,manifest,text(candidate.authNodeId));
12:   if(canonicalJson(verified)!==canonicalJson(candidate.evidence)||verified.runId!==runId)throw new Error('DEMO_CANDIDATE_SOURCE_CHANGED');
13:   const authentication=object(verified.authentication),credentials=object(object(verified.credentials).values);
14:   const url=text(authentication.url);const parsed=new URL(url);
15:   if(parsed.protocol!=='https:'||parsed.href!==url||parsed.username||parsed.password||parsed.search||parsed.hash)throw new Error('DEMO_PUBLIC_HTTPS_URL_REQUIRED');
