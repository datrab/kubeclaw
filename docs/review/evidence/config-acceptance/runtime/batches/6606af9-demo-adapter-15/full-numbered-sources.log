2: import { canonicalJson, sha256Text, type ArtifactRef, type PluginInvocationContext, type AdapterActivationContext } from '@kubeclaw/plugin-sdk';
3: import { validateContractValue } from '@kubeclaw/plugin-foundation/registry/schema';
4: export const NAMESPACE='kubeclaw.demo-handoff';
5: export type Value=Readonly<Record<string,unknown>>;
6: export type Reader=Pick<AdapterActivationContext,'invoke'>;
7: export function object(value:unknown):Value {
8:   if(!value||typeof value!=='object'||Array.isArray(value))throw new Error('DEMO_HANDOFF_OBJECT_INVALID');
9:   return value as Value;
10: }
11: export function text(value:unknown,maximum=2048):string {
12:   if(typeof value!=='string'||!value||value.length>maximum||/[\u0000-\u001f\u007f]/u.test(value))throw new Error('DEMO_HANDOFF_TEXT_INVALID');
13:   return value;
14: }
15: export function exact(value:Value,keys:readonly string[]):void {
16:   if(Object.keys(value).some(key=>!keys.includes(key))||keys.some(key=>value[key]===undefined))throw new Error('DEMO_HANDOFF_FIELDS_INVALID');
17: }
18: export function ref(value:unknown):ArtifactRef {validateContractValue('artifactRef',value);return value as ArtifactRef;}
19: export function select(context:PluginInvocationContext,stageId:string,namespace:string):ArtifactRef {
20:   const candidates=context.contract.artifacts.filter(item=>item.producer.runId===context.contract.lease.attempt.runId&&item.producer.stageId===stageId&&item.namespace===namespace);
21:   const latest=Math.max(...candidates.map(item=>item.producer.attemptNumber));
22:   const matches=candidates.filter(item=>item.producer.attemptNumber===latest);
23:   if(matches.length!==1)throw new Error('DEMO_HANDOFF_REFERENCE_AMBIGUOUS');return matches[0]!;
24: }
25: export async function read(context:Reader,reference:ArtifactRef,runId:string,stageId:string,namespace:string):Promise<Value> {
26:   if(reference.producer.runId!==runId||reference.producer.stageId!==stageId||reference.namespace!==namespace||reference.mediaType!=='application/json'
27:     ||reference.sizeBytes<1||reference.sizeBytes>8*1024**2)throw new Error('DEMO_HANDOFF_ARTIFACT_OWNER_INVALID');
28:   const response=await context.invoke('artifacts.read',{operation:'get_latest_json_bytes',resource:{type:'artifact.object',canonicalId:reference.artifactId},payload:{namespace,digest:reference.digest}});
29:   if(canonicalJson(response.artifact)!==canonicalJson(reference))throw new Error('DEMO_HANDOFF_ARTIFACT_CHANGED');
30:   const bytes=verifiedArtifactJsonText(response, reference);
31:   if(response.digest!==reference.digest||response.sizeBytes!==reference.sizeBytes
32:     ||Buffer.byteLength(bytes)!==reference.sizeBytes||sha256Text(bytes)!==reference.digest)throw new Error('DEMO_HANDOFF_ARTIFACT_CHANGED');
33:   return object(response.value);
34: }
35: export function target(value:unknown):string {const result=text(value,128);if(!/^[a-z0-9][a-z0-9._:-]*$/u.test(result))throw new Error('DEMO_HANDOFF_TARGET_INVALID');return result;}
36: export function deliveryIdentity(candidate:ArtifactRef,operatorTarget:string):string {
37:   return `demo:${sha256Text(canonicalJson({runId:candidate.producer.runId,candidateDigest:candidate.digest,target:operatorTarget})).slice(7)}`;
38: }
39: export async function evidence(context:Reader,manifest:ArtifactRef,authNodeId:string):Promise<Value> {
40:   return object(await context.invoke('test.plan.evidence',{operation:'demo',resource:{type:'test.plan.evidence',canonicalId:manifest.artifactId},payload:{namespace:manifest.namespace,manifest,authNodeId}}));
41: }
42: 
43: export function retention(value:unknown=604800):number {
44:   if(typeof value!=='number'||!Number.isSafeInteger(value)||value<1||value>9223372036)throw new Error('DEMO_RETENTION_INVALID');return value;
45: }
SOURCE skills/nova/plugins/demo-handoff/src/candidate.ts SHA256 0706b62469c38751d1b22fdc0486e66915cda45077b315b144ef8a4ec641eff3
1: import type {PluginInvocationContext,StageResult} from '@kubeclaw/plugin-sdk';
2: import {NAMESPACE,object,exact,text,target,select,evidence,ref,retention} from './protocol.ts';
3: export async function execute(value:unknown,context:PluginInvocationContext):Promise<StageResult> {
4:   try {
5:     const input=object(value);exact(input,['manifestStageId','authNodeId','protocol','operatorTarget','retentionSeconds']);
6:     if(input.protocol!=='json-session.v1')throw new Error('DEMO_HANDOFF_PROTOCOL_UNSUPPORTED');
7:     const manifest=select(context,text(input.manifestStageId),'kubeclaw.project-summary');
8:     const authNodeId=text(input.authNodeId),operatorTarget=target(input.operatorTarget);
9:     const verified=await evidence(context,manifest,authNodeId);
10:     const candidate={schemaVersion:'demo-candidate.v1',runId:context.contract.lease.attempt.runId,manifest,authNodeId,protocol:input.protocol,operatorTarget,retentionSeconds:retention(input.retentionSeconds),evidence:verified};
11:     const stored=await context.invoke('artifacts.write',{operation:'put_json',resource:{type:'artifact.object',canonicalId:`demo-candidate:${candidate.runId}`},payload:{namespace:NAMESPACE,mediaType:'application/json',value:candidate}});
12:     return {schemaVersion:'stage-result.v2',outcome:'passed',artifacts:[ref(stored.artifact)]};
13:   }catch(error){return {schemaVersion:'stage-result.v2',outcome:'blocked',reason:{code:'demo.candidate_invalid',message:error instanceof Error?error.message:String(error)},artifacts:[]};}
14: }
