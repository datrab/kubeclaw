{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workers",
    "timeoutMs",
    "minimumExecutedTests",
    "requiredTests"
  ],
  "properties": {
    "workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 3600000
    },
    "minimumExecutedTests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "requiredTests": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Proposed complete one playwright businessowner schema, no task duplicatebudget/preset/builtins/defaults. Full real runtime/role/renderer/tool/grants/source/baseline and semantic refs/coverage constraints separate; not implemented productive loader."
}
