{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "runs",
    "timeoutMs",
    "settings",
    "selectedProfile",
    "selectedBudget",
    "acceptances"
  ],
  "properties": {
    "purpose": {
      "enum": [
        "performance",
        "seo",
        "best-practices"
      ]
    },
    "runs": {
      "enum": [
        1,
        3,
        5
      ]
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 180000
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profiles",
        "budgets"
      ],
      "properties": {
        "schemaVersion": {
          "const": "kubeclaw.lighthouse-settings.v1"
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "formFactor",
              "screen",
              "throttling"
            ],
            "properties": {
              "formFactor": {
                "enum": [
                  "desktop",
                  "mobile"
                ]
              },
              "screen": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "width",
                  "height",
                  "deviceScaleFactor",
                  "mobile"
                ],
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 3840
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 2160
                  },
                  "deviceScaleFactor": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 4
                  },
                  "mobile": {
                    "type": "boolean"
                  }
                }
              },
              "throttling": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rttMs",
                  "throughputKbps",
                  "cpuSlowdownMultiplier"
                ],
                "properties": {
                  "rttMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5000
                  },
                  "throughputKbps": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "cpuSlowdownMultiplier": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 32
                  }
                }
              }
            }
          }
        },
        "budgets": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimumScore",
              "maximumLcpMs",
              "maximumCls",
              "maximumTbtMs"
            ],
            "properties": {
              "minimumScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "maximumLcpMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 120000
              },
              "maximumCls": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "maximumTbtMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 120000
              }
            }
          }
        }
      }
    },
    "selectedProfile": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "selectedBudget": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptances": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audit",
          "route",
          "reason",
          "expiresAt"
        ],
        "properties": {
          "audit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "route": {
            "type": "string",
            "pattern": "^/(?!/)[^?#\\r\\n]*$",
            "maxLength": 1024
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Proposed complete one lighthouse businessowner schema, no task duplicatebudget/preset/builtins/defaults. Full real runtime/role/renderer/tool/grants/source/baseline and semantic refs/coverage constraints separate; not implemented productive loader."
}
