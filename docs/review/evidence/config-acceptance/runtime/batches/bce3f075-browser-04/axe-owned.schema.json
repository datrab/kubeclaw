{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profiles",
    "selectedProfiles",
    "tags",
    "exclude",
    "acceptances",
    "timeoutMs"
  ],
  "properties": {
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "browser",
          "viewport",
          "colorScheme",
          "reducedMotion",
          "locale",
          "timezoneId",
          "hasTouch",
          "isMobile",
          "deviceScaleFactor"
        ],
        "properties": {
          "browser": {
            "enum": [
              "chromium",
              "firefox",
              "webkit"
            ]
          },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2160
              }
            }
          },
          "colorScheme": {
            "enum": [
              "light",
              "dark",
              "no-preference"
            ]
          },
          "reducedMotion": {
            "enum": [
              "reduce",
              "no-preference"
            ]
          },
          "locale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "timezoneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "hasTouch": {
            "type": "boolean"
          },
          "isMobile": {
            "type": "boolean"
          },
          "deviceScaleFactor": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 4
          }
        }
      }
    },
    "selectedProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
        "maxLength": 64
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "exclude": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "acceptances": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "route",
          "selector",
          "reason",
          "expiresAt"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "route": {
            "type": "string",
            "pattern": "^/(?!/)[^?#\\r\\n]*$",
            "maxLength": 1024
          },
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Proposed complete one axe businessowner schema, no task duplicatebudget/preset/builtins/defaults. Full real runtime/role/renderer/tool/grants/source/baseline and semantic refs/coverage constraints separate; not implemented productive loader."
}
