{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profiles",
    "comparison",
    "masks",
    "timeoutMs"
  ],
  "properties": {
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "browser",
          "viewport",
          "colorScheme",
          "reducedMotion",
          "locale",
          "timezoneId",
          "hasTouch",
          "isMobile",
          "deviceScaleFactor"
        ],
        "properties": {
          "browser": {
            "enum": [
              "chromium",
              "firefox",
              "webkit"
            ]
          },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 2160
              }
            }
          },
          "colorScheme": {
            "enum": [
              "light",
              "dark",
              "no-preference"
            ]
          },
          "reducedMotion": {
            "enum": [
              "reduce",
              "no-preference"
            ]
          },
          "locale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "timezoneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "hasTouch": {
            "type": "boolean"
          },
          "isMobile": {
            "type": "boolean"
          },
          "deviceScaleFactor": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 4
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumDifferencePercent",
        "pixelThreshold",
        "uncertaintyMarginPercent"
      ],
      "properties": {
        "maximumDifferencePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pixelThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertaintyMarginPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "masks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "selectors"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Proposed complete one visual businessowner schema, no task duplicatebudget/preset/builtins/defaults. Full real runtime/role/renderer/tool/grants/source/baseline and semantic refs/coverage constraints separate; not implemented productive loader."
}
