+```sh
+python3 docs/review/evidence/config-acceptance/runtime/batches/bce3f075-security-02/build.py
+node docs/review/evidence/config-acceptance/runtime/batches/bce3f075-security-02/check.mjs
+python3 docs/review/evidence/config-acceptance/runtime/batches/bce3f075-security-02/integrate.py
+python3 docs/review/evidence/config-acceptance/runtime/batches/bce3f075-security-02/define-owned-policy.py
+node docs/review/evidence/config-acceptance/runtime/batches/bce3f075-security-02/check-owned-policy.mjs
+python3 docs/review/evidence/config-acceptance/runtime/batches/bce3f075-security-02/supplement.py
+python3 docs/review/evidence/config-acceptance/runtime/batches/bce3f075-security-02/candidate-dispositions.py
+python3 docs/review/evidence/config-acceptance/runtime/batches/bce3f075-security-02/record.py
