SOURCE skills/nova/plugins/case-study/src/protocol.ts SHA256 3ff3c3dc70f2967d194896205cb1c7a2f7226d84de2a042f6c7bae46a25588c6
1: import { canonicalJson, sha256Text, type ArtifactRef, type AttemptIdentity } from '@kubeclaw/plugin-sdk';
2: export interface ReportSource {
3:   readonly runId: string; readonly journalHead: string; readonly snapshotDigest: string;
4:   readonly sourceStageId: string; readonly sourceRevision: string; readonly artifacts: readonly ArtifactRef[];
5: }
6: export interface SourceBundle {
7:   readonly schemaVersion: 'report-source-bundle.v1'; readonly digest: string;
8:   readonly target: Omit<ReportSource, 'artifacts'>; readonly pipelineId: string;
9:   readonly evidence: readonly { readonly evidenceId: string; readonly artifact: ArtifactRef }[];
10:   readonly facts: readonly Readonly<Record<string, unknown>>[];
11:   readonly [key: string]: unknown;
12: }
13: export function validateBundle(value: unknown, source: ReportSource): SourceBundle {
14:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('REPORT_BUNDLE_INVALID');
15:   const bundle = value as SourceBundle; const { digest, ...unsigned } = bundle;
16:   const { artifacts, ...target } = source;
17:   if (bundle.schemaVersion !== 'report-source-bundle.v1' || digest !== sha256Text(canonicalJson(unsigned))
18:     || canonicalJson(bundle.target) !== canonicalJson(target) || !Array.isArray(bundle.evidence)
19:     || canonicalJson(bundle.evidence.map(item => item.artifact)) !== canonicalJson(artifacts)) throw new Error('REPORT_BUNDLE_BINDING_INVALID');
20:   return bundle;
21: }
22: function citations(value: unknown, bundle: SourceBundle): readonly string[] {
23:   if (!Array.isArray(value) || !value.length || value.length > 128 || new Set(value).size !== value.length
24:     || value.some(id => typeof id !== 'string' || !bundle.evidence.some(item => item.evidenceId === id))) throw new Error('REPORT_CITATIONS_INVALID');
25:   return value as string[];
26: }
27: export interface CaseStudyInput { readonly task:string; readonly source:ReportSource }
28: export interface CaseStudy { readonly status:'generated'; readonly projectId:string; readonly runId:string; readonly markdown:string;
29:   readonly execution:AttemptIdentity; readonly reportTarget:SourceBundle['target']; readonly evidenceStatus:'verified-source-bundle';
30:   readonly narrativeStatus:'draft-not-entailment-verified'; readonly sourceBundle:SourceBundle; readonly evidenceIds:readonly string[] }
31: export const requiredSections=['Context','Challenge','Approach','Implementation','Verification','Outcome'] as const;
32: export function buildRequest(agent:string,input:CaseStudyInput,execution:AttemptIdentity,bundle:SourceBundle):Readonly<Record<string,unknown>>{
33:   return {protocol:'kubeclaw.case-study.v4',agent,identity:execution,reportTarget:bundle.target,evidenceStatus:'verified-source-bundle',narrativeStatus:'draft-not-entailment-verified',
34:     task:[input.task,'Return only the agent-owned output object described by outputContract.','Do not copy protocol, agent, identity, task, facts, requiredSections, groundingRules, or outputContract into the output.','Execution identity comes from the active Core lease. reportTarget identifies the requested project/run, which may be historical. SourceBundle contains verified structured source facts and explicit omissions. Cite supplied evidence IDs. Generated Markdown remains a draft, not proof of entailment or publication readiness.'].join('\n\n'),
35:     sourceBundle:bundle,requiredSections,groundingRules:['Use only supplied source facts; include evidenceIds for sources cited in Markdown.','Do not invent metrics, quotes, dates, or outcomes. Each returned evidenceId must appear in Markdown as [evidence:ID].'],
36:     outputContract:{type:'object',additionalProperties:false,required:['status','markdown','evidenceIds'],properties:{status:{const:'generated'},markdown:{type:'string'},evidenceIds:{type:'array',minItems:1,items:{type:'string'}}}}};
37: }
38: export function parseCaseStudy(value:unknown,input:CaseStudyInput,execution:AttemptIdentity,bundle:SourceBundle):CaseStudy{
39:   if(!value||typeof value!=='object'||Array.isArray(value)) throw new Error('case study must be an object');
40:   const source=value as Record<string,unknown>;
41:   if(Object.keys(source).some((key)=>!['status','markdown','evidenceIds'].includes(key))||source.status!=='generated') throw new Error('case study shape is invalid');
42:   if(typeof source.markdown!=='string'||source.markdown.length<1||source.markdown.length>131072||/[\0\r]/u.test(source.markdown)) throw new Error('case study Markdown is invalid');
43:   let previous=-1;
44:   for(const section of requiredSections){
45:     const marker=`## ${section}`; const first=source.markdown.indexOf(marker);
46:     if(first<0||first<=previous||source.markdown.indexOf(marker,first+1)>=0) throw new Error(`case study section ${section} is missing, duplicated, or out of order`);
47:     previous=first;
48:   }
49:   const evidenceIds=citations(source.evidenceIds,bundle);
50:   if(evidenceIds.some(id=>!String(source.markdown).includes(`[evidence:${id}]`)))throw new Error('REPORT_MARKDOWN_CITATION_MISSING');
51:   return {status:'generated',projectId:bundle.pipelineId,runId:execution.runId,execution:{...execution},reportTarget:bundle.target,evidenceStatus:'verified-source-bundle',narrativeStatus:'draft-not-entailment-verified',sourceBundle:structuredClone(bundle),evidenceIds,markdown:source.markdown};
52: }
SOURCE skills/nova/plugins/case-study/src/stage.ts SHA256 a537e4028ddc30ea19ae7fa18e828c10745f08f14b0cf16e534ee8b42ea720b9
1: import { canonicalJson, sha256Text, type AttemptIdentity } from '@kubeclaw/plugin-sdk';
2: import type{ArtifactRef,PluginInvocationContext,StageResult}from'@kubeclaw/plugin-sdk';
3: import{buildRequest,parseCaseStudy,validateBundle,type CaseStudyInput}from'./protocol.ts';
4: export async function execute(input:CaseStudyInput,context:PluginInvocationContext):Promise<StageResult>{
5:   const agent=context.contract.config.agent;if(typeof agent!=='string'||!agent.trim())throw new Error('case study agent is not configured');
6:   const execution={...context.contract.lease.attempt};
7:   let study;
8:   try{const resolved=await context.invoke('report.evidence.read',{operation:'snapshot',resource:{type:'pipeline.run',canonicalId:input.source.runId},payload:{...input.source}});
9:     const bundle=validateBundle(resolved.bundle,input.source);
10:     const response=await context.invoke('runtime.dispatch',withRuntimeDispatchProfile({operation:'dispatch',resource:{type:'runtime.agent',canonicalId:agent},payload:buildRequest(agent,input,execution,bundle)},context.contract.runtimeDispatchProfile));
11:     study=parseCaseStudy(response.result,input,execution,bundle);
12:   }catch(error){return{schemaVersion:'stage-result.v2',outcome:'blocked',reason:{code:'case_study.invalid_output',message:error instanceof Error?error.message:String(error)},artifacts:[]};}
13:   const artifactId=`case-study:${sha256Text(canonicalJson(execution)).slice(7)}`;
14:   const stored=await context.invoke('artifacts.write',{operation:'put_json',resource:{type:'artifact.object',canonicalId:artifactId},
15:     payload:{namespace:'kubeclaw.case-study',mediaType:'application/json',value:study}});
16:   assertReportArtifact(stored.artifact,artifactId,study,execution);
17:   return{schemaVersion:'stage-result.v2',outcome:'passed',artifacts:[stored.artifact as ArtifactRef]};
18: }
19: 
20: /** Verify the original store response against the bytes and active producer being committed. */
21: export function assertReportArtifact(value:unknown,artifactId:string,report:unknown,execution:AttemptIdentity):asserts value is ArtifactRef {
22:   if(!value || typeof value!=='object')throw new Error('REPORT_ARTIFACT_INVALID');
23:   const artifact=value as ArtifactRef;
24:   const bytes=canonicalJson(report);
25:   if(artifact.artifactId!==artifactId || artifact.namespace!=='kubeclaw.case-study' || artifact.mediaType!=='application/json'
26:     || artifact.digest!==sha256Text(bytes) || artifact.sizeBytes!==Buffer.byteLength(bytes)
27:     || canonicalJson(artifact.producer)!==canonicalJson(execution))throw new Error('REPORT_ARTIFACT_BINDING_MISMATCH');
28: }
29: import { withRuntimeDispatchProfile } from '@kubeclaw/plugin-sdk';
