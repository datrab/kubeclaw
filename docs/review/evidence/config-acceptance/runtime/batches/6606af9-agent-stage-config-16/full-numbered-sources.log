SOURCE skills/nova/plugins/implementation-agent/src/repair-evidence.ts SHA256 0ba38e4004d0b9c3058fdce363611beeb6170ee3cb37424da599eb3757fa5c99
1: import {verifiedArtifactJsonText} from '@kubeclaw/plugin-sdk';
2: import { canonicalJson, sha256Text, type ArtifactRef, type PluginInvocationContext } from '@kubeclaw/plugin-sdk';
3: 
4: const MAXIMUM_ARTIFACTS = 32;
5: const MAXIMUM_BYTES = 256 * 1024;
6: 
7: /** Only core-issued repair requests may select evidence; never agent-supplied paths. */
8: export async function repairEvidence(context: PluginInvocationContext): Promise<string | undefined> {
9:   const request = context.contract.guidance?.repairRequest;
10:   if (request === undefined) return undefined;
11:   const value = request as Record<string, any>;
12:   const attempt = context.contract.lease.attempt;
13:   if (!value || value.schemaVersion !== 'repair-request.v1' || value.targetStageId !== attempt.stageId
14:     || typeof value.requesterStageId !== 'string' || !Number.isSafeInteger(value.generation) || value.generation < 1
15:     || value.requesterResult?.outcome !== 'request_fix' || !Array.isArray(value.requesterResult.artifacts)) {
16:     throw new Error('REPAIR_EVIDENCE_REQUEST_INVALID');
17:   }
18:   const refs = value.requesterResult.artifacts as ArtifactRef[];
19:   if (refs.length > MAXIMUM_ARTIFACTS) throw new Error('REPAIR_EVIDENCE_LIMIT_EXCEEDED');
20:   let bytes = Buffer.byteLength(canonicalJson(request));
21:   const seen = new Set<string>();
22:   for (const ref of refs) {
23:     if (ref.producer.runId !== attempt.runId || ref.producer.stageId !== value.requesterStageId
24:       || ref.mediaType !== 'application/json' || !Number.isSafeInteger(ref.sizeBytes) || ref.sizeBytes < 0
25:       || !/^sha256:[a-f0-9]{64}$/u.test(ref.digest)) throw new Error('REPAIR_EVIDENCE_REFERENCE_INVALID');
26:     const key = `${ref.namespace}\0${ref.artifactId}\0${ref.digest}`;
27:     if (seen.has(key)) throw new Error('REPAIR_EVIDENCE_REFERENCE_DUPLICATE');
28:     seen.add(key); bytes += ref.sizeBytes;
29:   }
30:   if (bytes > MAXIMUM_BYTES) throw new Error('REPAIR_EVIDENCE_LIMIT_EXCEEDED');
31:   const evidence: { artifact: ArtifactRef; content: unknown }[] = [];
32:   for (const ref of refs) {
33:     const response = await context.invoke('artifacts.read', {
34:       operation: 'get_json_bytes', resource: { type: 'artifact.object', canonicalId: ref.artifactId },
35:       payload: { namespace: ref.namespace, digest: ref.digest, reference: ref },
36:     });
37:     const content = verifiedArtifactJsonText(response, ref);
38:     if (response.digest !== ref.digest || response.sizeBytes !== ref.sizeBytes
39:       || Buffer.byteLength(content) !== ref.sizeBytes || sha256Text(content) !== ref.digest) {
40:       throw new Error('REPAIR_EVIDENCE_CONTENT_INVALID');
41:     }
42:     evidence.push({ artifact: ref, content: response.value });
43:   }
44:   const serialized = canonicalJson({ request, evidence });
45:   if (Buffer.byteLength(serialized) > MAXIMUM_BYTES) throw new Error('REPAIR_EVIDENCE_LIMIT_EXCEEDED');
46:   return serialized;
47: }
