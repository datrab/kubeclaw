18:   }
19: }
SOURCE skills/nova/plugins/buster-quality-gate/src/protocol.ts SHA256 9f85b213f272e143dbc7a9736666054941b4d21c231afdbfc07b8e539c907711
1: import type { GateCoverageV1 } from '@kubeclaw/pipeline-test-gate-contract';
2: export interface ProviderPlanInput{readonly revision?:string;readonly sourceStageId?:string;readonly repositoryRoot:string;readonly repositoryId:string;readonly plan:Readonly<Record<string,unknown>>;readonly grants:Readonly<Record<string,readonly string[]>>;readonly maximumConcurrency:number;readonly submittedAt:string;readonly timeoutMs:number}
3: export interface GateInput {
4:  readonly expectedCoverage?: GateCoverageV1;
5:  readonly gateId: string;
6:  readonly task: string;
7:  readonly providerPlan: ProviderPlanInput;
8: }
9: export interface JudgedGateInput {
10:  readonly runId: string;
11:  readonly gateId: string;
12:  readonly attempt: number;
13:  readonly task: string;
14:  readonly suiteEvidence: readonly { readonly suite: string; readonly passed: boolean; readonly summary: string }[];
15: }
16: type GateOutcome='passed'|'request_fix'|'blocked';
17: export interface GateVerdict{readonly outcome:GateOutcome;readonly runId:string;readonly gateId:string;readonly attempt:number;readonly summary:string;readonly failureClass:'none'|'test_failure'|'contract'|'configuration'|'infrastructure'|'rate_limit'|'timeout';readonly findings:readonly string[]}
18: export function buildRequest(agent:string,input:JudgedGateInput):Readonly<Record<string,unknown>>{
19:  const failureClasses=['none','test_failure','contract','configuration','infrastructure','rate_limit','timeout'];
20:  return{protocol:'kubeclaw.buster-quality-gate.v2',agent,identity:{runId:input.runId,gateId:input.gateId,attempt:input.attempt},
21:   task:[input.task,'Return only the agent-owned output object described by outputContract.','Do not copy protocol, agent, identity, task, suiteEvidence, allowedOutcomes, failureClasses, or outputContract into the output.','Runtime/core bind run, gate, and attempt identity.'].join('\n\n'),suiteEvidence:input.suiteEvidence,
22:   allowedOutcomes:['passed','request_fix','blocked'],failureClasses,
23:   outputContract:{type:'object',additionalProperties:false,required:['outcome','summary','failureClass','findings'],properties:{outcome:{enum:['passed','request_fix','blocked']},summary:{type:'string'},failureClass:{enum:failureClasses},findings:{type:'array',items:{type:'string'}}}}};
24: }
25: function verdictSource(value:unknown):Record<string,unknown>{
26:  if(!value||typeof value!=='object'||Array.isArray(value))throw new Error('gate verdict must be an object');
27:  const source=value as Record<string,unknown>;
28:  const outcomes=['passed','request_fix','blocked'];const classes=['none','test_failure','contract','configuration','infrastructure','rate_limit','timeout'];
29:  if(Object.keys(source).some((key)=>!['outcome','summary','failureClass','findings'].includes(key)))throw new Error('gate verdict shape is invalid');
30:  if(!outcomes.includes(String(source.outcome))||!classes.includes(String(source.failureClass)))throw new Error('gate verdict shape is invalid');
31:  if(typeof source.summary!=='string'||!source.summary.trim()||source.summary.length>8192)throw new Error('gate summary is invalid');
32:  if(!Array.isArray(source.findings)||source.findings.length>128||source.findings.some((item)=>typeof item!=='string'||!item.trim()||item.length>4096))throw new Error('gate findings are invalid');
33:  return source;
34: }
35: function assertVerdictConsistency(source:Record<string,unknown>,input:JudgedGateInput):void{
36:  const findings=source.findings as unknown[];
37:  if(source.outcome==='passed'&&(source.failureClass!=='none'||findings.length>0||input.suiteEvidence.some((suite)=>!suite.passed)))throw new Error('passed verdict contradicts evidence');
38:  if(source.outcome!=='passed'&&(source.failureClass==='none'||findings.length===0))throw new Error('non-passing verdict requires a failure class and findings');
39: }
40: export function parseVerdict(value:unknown,input:JudgedGateInput):GateVerdict{
41:  const source=verdictSource(value);
42:  assertVerdictConsistency(source,input);
43:  return{outcome:source.outcome as GateOutcome,runId:input.runId,gateId:input.gateId,attempt:input.attempt,summary:source.summary as string,
44:   failureClass:source.failureClass as GateVerdict['failureClass'],findings:source.findings as string[]};
45: }
SOURCE skills/nova/plugins/buster-quality-gate/src/stage.ts SHA256 3b58135f8f95a089a7776ca76152d51ae394627f13ce0da1f362c90ab7b1ea76
1: import { assertCoveragePlan, assertCoverageExecution, type ResolvedTestPlanV1 } from '@kubeclaw/pipeline-test-gate-contract';
2: import { resolveSourceRevision } from '@kubeclaw/plugin-sdk';
3: import { parseGateDecision, gateDecisionEvidence, gateDecisionStageResult } from '@kubeclaw/pipeline-test-gate-contract/gate-decision';
4: import type { ArtifactRef, PluginInvocationContext, StageResult } from '@kubeclaw/plugin-sdk';
5: import { buildRequest, parseVerdict, type GateInput } from './protocol.ts';
6: 
7: function coveragePlan(input: GateInput): ResolvedTestPlanV1 {
8:   const plan = input.providerPlan.plan as unknown as ResolvedTestPlanV1;
9:   if (plan.coverage && !input.expectedCoverage) throw new Error('QUALITY_EXPECTED_COVERAGE_REQUIRED');
10:   if (input.expectedCoverage) assertCoveragePlan(plan, input.expectedCoverage);
11:   return plan;
12: }
13: 
14: export async function execute(input: GateInput, context: PluginInvocationContext): Promise<StageResult> {
15:   const agent = context.contract.config.agent;
16:   const testAgentEnabled = context.contract.config.testAgentEnabled !== false;
17:   if (testAgentEnabled && (typeof agent !== 'string' || !agent.trim())) throw new Error('quality evaluator agent is not configured');
18:   // Only a verified remote import may supply gate evidence.
19:   if (!input.providerPlan) throw new Error('QUALITY_PROVIDER_PLAN_REQUIRED');
20:   const plan = coveragePlan(input);
21:   const sourceRevision = await resolveSourceRevision(input.providerPlan, context);
22:   const execution = await context.invoke('test.plan.execute', {
23:     operation: 'run', resource: { type: 'test.resolved-plan', canonicalId: input.providerPlan.repositoryRoot },
24:     payload: { ...input.providerPlan, revision: sourceRevision, gateId: input.gateId,
25:       ...(input.expectedCoverage ? { expectedCoverage: input.expectedCoverage } : {}) },
26:   });
27:   const decision = parseGateDecision(execution);
28:   if (decision.runId !== context.contract.lease.attempt.runId) throw new Error('QUALITY_GATE_RUN_MISMATCH');
29:   if (input.expectedCoverage) assertCoverageExecution(plan, decision, input.expectedCoverage, sourceRevision, context.contract.lease.attempt.stageId);
30:   const nativeResult = gateDecisionStageResult(decision);
31:   const storedDecision = await context.invoke('artifacts.write', {
32:     operation: 'put_json', resource: { type: 'artifact.object', canonicalId: `buster-quality:${input.gateId}:decision:${context.contract.lease.attempt.attemptNumber}` },
33:     payload: { namespace: 'kubeclaw.buster-quality-gate', mediaType: 'application/json', value: decision },
34:   });
35:   const artifacts = [storedDecision.artifact as ArtifactRef];
36:   if (decision.state !== 'passed') return { ...nativeResult, artifacts };
37:   if (!testAgentEnabled) {
38:     const stored = await context.invoke('artifacts.write', {
39:       operation: 'put_json', resource: { type: 'artifact.object', canonicalId: `buster-quality:${input.gateId}:${context.contract.lease.attempt.attemptNumber}` },
40:       payload: { namespace: 'kubeclaw.buster-quality-gate', mediaType: 'application/json', value: {
41:         testAgent: { enabled: false }, nativeOutcome: decision.state, sourceRevision, decisionDigest: decision.decisionDigest,
42:       } },
43:     });
44:     return { ...nativeResult, artifacts: [...artifacts, stored.artifact as ArtifactRef] };
45:   }
46:   const judgedInput = {
47:     gateId: input.gateId, task: input.task,
48:     runId: context.contract.lease.attempt.runId, attempt: context.contract.lease.attempt.attemptNumber,
49:     suiteEvidence: gateDecisionEvidence(decision),
50:   };
51:   // Invocation failures retain the core's external-effect reconciliation policy.
52:   const response = await context.invoke('runtime.dispatch', withRuntimeDispatchProfile({
53:     operation: 'dispatch', resource: { type: 'runtime.agent', canonicalId: agent as string },
54:     payload: buildRequest(agent as string, judgedInput),
55:   }, context.contract.runtimeDispatchProfile));
56:   let verdict;
57:   try { verdict = parseVerdict(response.result, judgedInput); }
58:   catch (error) {
59:     return { schemaVersion: 'stage-result.v2', outcome: 'blocked', artifacts,
60:       reason: { code: 'buster_quality.invalid_verdict', message: error instanceof Error ? error.message : String(error) } };
61:   }
62:   const stored = await context.invoke('artifacts.write', {
63:     operation: 'put_json', resource: { type: 'artifact.object', canonicalId: `buster-quality:${input.gateId}:${judgedInput.attempt}` },
64:     payload: { namespace: 'kubeclaw.buster-quality-gate', mediaType: 'application/json', value: { testAgent: { enabled: true }, verdict, sourceRevision, decisionDigest: decision.decisionDigest, suiteEvidence: judgedInput.suiteEvidence } },
65:   });
66:   artifacts.push(stored.artifact as ArtifactRef);
67:   if (verdict.outcome === 'passed') return { ...nativeResult, artifacts };
68:   return { schemaVersion: 'stage-result.v2', outcome: verdict.outcome, artifacts,
69:     reason: { code: `buster_quality.${verdict.failureClass}`, message: verdict.summary, details: { findings: verdict.findings, decisionDigest: decision.decisionDigest } } };
70: }
71: import { withRuntimeDispatchProfile } from '@kubeclaw/plugin-sdk';
