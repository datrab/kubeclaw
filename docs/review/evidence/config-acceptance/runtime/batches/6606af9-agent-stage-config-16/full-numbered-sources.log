SOURCE skills/nova/plugins/project-summary/src/summary.ts SHA256 bb82063929e9100dd42c3dff541eca77be2cfa624f8b5fd8733e773acb7ce7c5
1: import {verifiedArtifactJsonText, portableJson, PORTABLE_JSON_ENCODING} from '@kubeclaw/plugin-sdk';
2: import { summaryReviewSemanticEncoding, summaryReviewBundleDigest,
3:   type SummaryReviewSemanticEncoding } from './review-semantics.ts';
4: import { assertCoverageDecision, coveragePassed, coverageReviewPrefixes, coverageReviewRequirements, validatePipelineTestGateContract, type GateCoverageV1 } from '@kubeclaw/pipeline-test-gate-contract';
5: import { parseGateDecision } from '@kubeclaw/pipeline-test-gate-contract/gate-decision';
6: import { canonicalJson, sha256Text, resolveSourceRevision, type ArtifactRef, type PluginInvocationContext } from '@kubeclaw/plugin-sdk';
7: import { createDeliveryManifestV3, DELIVERY_MANIFEST_ENCODING,
8:   type DeliveryManifestEncoding } from '@kubeclaw/delivery-manifest-contract';
9: 
10: export interface GateBinding {
11:   readonly reviewSemanticEncoding?: SummaryReviewSemanticEncoding;
12:   readonly reviewArtifactEncoding?: typeof PORTABLE_JSON_ENCODING;
13:   readonly sourceStageId: string;
14:   readonly lintStageId: string;
15:   readonly reviewStageId?: string;
16:   readonly expectedCoverage: GateCoverageV1;
17:   readonly testStageId: string;
18: }
19: export interface SummaryInput {
20:   readonly projectId: string;
21:   readonly modules: readonly { readonly moduleId: string; readonly sourceStageId: string; readonly testStageId: string; readonly expectedCoverage: GateCoverageV1 }[];
22:   readonly final: GateBinding;
23: }
24: 
25: function validateCoverageInput(input: SummaryInput): void {
26:   portableJson(input);
27:   summaryReviewSemanticEncoding(input.final as unknown as Record<string, unknown>);
28:   if (!input.projectId?.trim() || !Array.isArray(input.modules) || input.modules.length < 1
29:     || input.modules.length > 128 || new Set(input.modules.map(module => module.moduleId)).size !== input.modules.length
30:     || new Set(input.modules.map(module => module.sourceStageId)).size !== input.modules.length
31:     || new Set(input.modules.map(module => module.testStageId)).size !== input.modules.length
32:     || !input.modules.some(module => module.sourceStageId === input.final?.sourceStageId)) {
33:     throw new Error('DELIVERY_INPUT_INVALID');
34:   }
35:   validatePipelineTestGateContract('gateCoverage', input.final.expectedCoverage);
36:   if (input.final.expectedCoverage.kind !== 'cumulative' || input.final.expectedCoverage.projectId !== input.projectId) throw new Error('DELIVERY_CUMULATIVE_COVERAGE_REQUIRED');
37:   const expectedModules = input.modules.map(module => {
38:     validatePipelineTestGateContract('gateCoverage', module.expectedCoverage);
39:     if (module.expectedCoverage.kind !== 'module' || module.expectedCoverage.modules[0]?.moduleId !== module.moduleId
40:       || module.expectedCoverage.projectId !== input.projectId) throw new Error('DELIVERY_MODULE_COVERAGE_MISMATCH');
41:     return module.expectedCoverage.modules[0]!;
42:   }).sort((left, right) => left.moduleId < right.moduleId ? -1 : left.moduleId > right.moduleId ? 1 : 0);
43:   if (canonicalJson(expectedModules) !== canonicalJson(input.final.expectedCoverage.modules)) throw new Error('DELIVERY_CUMULATIVE_MODULES_MISMATCH');
44: }
45: 
46: type ReadEvidence = (stageId: string, namespace: string, select?: (ref: ArtifactRef) => boolean,
47:   encoding?: typeof PORTABLE_JSON_ENCODING) => Promise<Record<string, any>>;
48: type JsonArtifactRef = ArtifactRef & { readonly mediaType: 'application/json' };
49: 
50: function validateReviewCoverage(review: Record<string, any>, bundle: Record<string, any>,
51:   bundleDigest: string, sourceRevision: string, policy: GateCoverageV1): void {
52:   const coverageEvidence = Array.isArray(bundle.evidence) ? bundle.evidence.filter((item: any) => item.kind === 'gate-coverage') : [];
53:   if (review.revision?.head !== sourceRevision || review.revision?.base !== policy.baseRevision
54:     || canonicalJson(review.revision) !== canonicalJson(bundle.revisions)
55:     || review.outcome !== 'passed' || review.bundleDigest !== bundleDigest
56:     || coverageEvidence.length !== 1 || coverageEvidence[0].content !== canonicalJson(policy)
57:     || canonicalJson(bundle.requirements) !== canonicalJson(coverageReviewRequirements(policy))
58:     || canonicalJson(bundle.scope?.allowedPrefixes) !== canonicalJson(coverageReviewPrefixes(policy))) throw new Error('DELIVERY_FINAL_REVIEW_COVERAGE_MISMATCH');
59: }
60: 
61: async function verifyFinalReview(input: SummaryInput, sourceRevision: string, read: ReadEvidence,
62:   deliveryManifestEncoding?: DeliveryManifestEncoding): Promise<void> {
63:   const semantic = summaryReviewSemanticEncoding(input.final as unknown as Record<string, unknown>);
64:   const artifactEncoding = input.final.reviewArtifactEncoding;
65:   if (input.final.reviewStageId) {
66:     // Preserve the historical v2 semantic-mode implication. V3 carries the
67:     // independently compiled outer-artifact expectation explicitly.
68:     const encoding = deliveryManifestEncoding === undefined
69:       ? (semantic === undefined ? undefined : PORTABLE_JSON_ENCODING)
70:       : artifactEncoding;
71:     const review = await read(input.final.reviewStageId, 'kubeclaw.review', ref => ref.artifactId.startsWith('review-report:'), encoding);
72:     const bundle = await read(input.final.reviewStageId, 'kubeclaw.review', ref => ref.artifactId.startsWith('review-bundle:'), encoding);
73:     const bundleDigest = summaryReviewBundleDigest(review, bundle, semantic);
74:     validateReviewCoverage(review, bundle, bundleDigest, sourceRevision, input.final.expectedCoverage);
75:   }
76: }
77: 
78: function validateReviewMode(input: SummaryInput, deliveryManifestEncoding?: DeliveryManifestEncoding): void {
79:   const hasReview = input.final.reviewStageId !== undefined;
80:   const hasArtifactEncoding = Object.hasOwn(input.final, 'reviewArtifactEncoding');
81:   const hasSemanticEncoding = Object.hasOwn(input.final, 'reviewSemanticEncoding');
82:   if (deliveryManifestEncoding === undefined) {
83:     if (hasArtifactEncoding) throw new Error('DELIVERY_REVIEW_ARTIFACT_MODE_INVALID');
84:     return;
85:   }
86:   if ((hasArtifactEncoding && (!hasReview || input.final.reviewArtifactEncoding !== PORTABLE_JSON_ENCODING))
87:     || (hasSemanticEncoding && !hasArtifactEncoding)) throw new Error('DELIVERY_REVIEW_ARTIFACT_MODE_INVALID');
88: }
89: 
90: function validateReadBytes(response: Record<string, any>, ref: ArtifactRef, bytes: string): void {
91:   if (response.digest !== ref.digest || response.sizeBytes !== ref.sizeBytes || sha256Text(bytes) !== ref.digest
92:     || Buffer.byteLength(bytes) !== ref.sizeBytes) throw new Error('DELIVERY_EVIDENCE_CORRUPT');
93: }
94: 
95: function evidenceReader(context: PluginInvocationContext, evidence: JsonArtifactRef[]): ReadEvidence {
96:   const runId = context.contract.lease.attempt.runId;
97:   let totalBytes = 0;
98:   async function read(stageId: string, namespace: string, select: (ref: ArtifactRef) => boolean = () => true,
99:     encoding?: typeof PORTABLE_JSON_ENCODING) {
100:     const candidates = context.contract.artifacts.filter(ref => ref.producer.runId === runId
101:       && ref.producer.stageId === stageId && ref.namespace === namespace);
102:     const attempt = Math.max(...candidates.map(ref => ref.producer.attemptNumber));
103:     const latest = candidates.filter(ref => ref.producer.attemptNumber === attempt && select(ref));
104:     if (latest.length !== 1) throw new Error(`DELIVERY_EVIDENCE_MISSING_OR_AMBIGUOUS:${stageId}`);
105:     const ref = latest[0]!;
106:     if (encoding !== undefined && ref.encoding !== encoding) throw new Error('DELIVERY_REVIEW_ARTIFACT_ENCODING_REQUIRED');
107:     if (ref.mediaType !== 'application/json' || !Number.isSafeInteger(ref.sizeBytes) || ref.sizeBytes < 1
108:       || (totalBytes += ref.sizeBytes) > 8 * 1024 * 1024) throw new Error('DELIVERY_EVIDENCE_LIMIT_EXCEEDED');
109:     const response = await context.invoke('artifacts.read', { operation: 'get_json_bytes',
110:       resource: { type: 'artifact.object', canonicalId: ref.artifactId }, payload: { namespace, digest: ref.digest, reference: ref } });
111:     const bytes = verifiedArtifactJsonText(response, ref);
112:     validateReadBytes(response, ref, bytes);
113:     evidence.push(ref as JsonArtifactRef);
114:     if (!response.value || typeof response.value !== 'object' || Array.isArray(response.value)) throw new Error('DELIVERY_EVIDENCE_INVALID');
115:     return response.value as Record<string, any>;
116:   }
117:   return read;
118: }
119: 
120: /** Delivery is derived from core-supplied, immutable evidence, never caller-owned counts. */
121: export async function buildSummary(input: SummaryInput, context: PluginInvocationContext,
122:   deliveryManifestEncoding?: DeliveryManifestEncoding) {
123:   if (deliveryManifestEncoding !== undefined && deliveryManifestEncoding !== DELIVERY_MANIFEST_ENCODING) {
124:     throw new Error('DELIVERY_MANIFEST_ENCODING_INVALID');
125:   }
126:   validateCoverageInput(input);
127:   validateReviewMode(input, deliveryManifestEncoding);
128:   const runId = context.contract.lease.attempt.runId;
129:   const evidence: JsonArtifactRef[] = [];
130:   const read = evidenceReader(context, evidence);
131:   async function verify<T extends { readonly sourceStageId: string; readonly testStageId: string;
132:     readonly expectedCoverage: GateCoverageV1 }>(binding: T) {
133:     const revision = await resolveSourceRevision({ sourceStageId: binding.sourceStageId }, context);
134:     await read(binding.sourceStageId, 'kubeclaw.implementation-agent', ref => ref.artifactId.startsWith('implementation:'));
135:     const decision = parseGateDecision(await read(binding.testStageId, 'kubeclaw.buster-quality-gate', ref => ref.artifactId.includes(':decision:')));
136:     const quality = await read(binding.testStageId, 'kubeclaw.buster-quality-gate', ref => !ref.artifactId.includes(':decision:'));
137:     if (quality.sourceRevision !== revision) {
138:       throw new Error(`DELIVERY_CANDIDATE_MISMATCH:${binding.sourceStageId}`);
139:     }
140:     assertCoverageDecision(decision, binding.expectedCoverage, revision, binding.testStageId);
141:     const qualityPassed = quality.testAgent?.enabled === false ? quality.nativeOutcome === 'passed' : quality.verdict?.outcome === 'passed';
142:     if (decision.state !== 'passed' || !coveragePassed(decision.coverage!) || decision.runId !== runId || !qualityPassed
143:       || quality.decisionDigest !== decision.decisionDigest || typeof decision.resultDigest !== 'string'
144:       || decision.coverage === undefined) throw new Error(`DELIVERY_GATE_NOT_PASSED:${binding.sourceStageId}`);
145:     const { decisionDigest, resultDigest, coverage } = decision;
146:     return { ...binding, sourceRevision: revision, decisionDigest, resultDigest, coverage };
147:   }
148:   const modules = [];
149:   for (const module of input.modules) modules.push(await verify(module));
150:   const final = await verify(input.final);
151:   const lint = await read(input.final.lintStageId, 'kubeclaw.lint');
152:   if (lint.sourceRevision !== final.sourceRevision) throw new Error('DELIVERY_FINAL_CANDIDATE_MISMATCH');
153:   if (lint.summary?.tools_failed !== 0 || lint.summary?.total_blocking !== 0) throw new Error('DELIVERY_FINAL_GATE_NOT_PASSED');
154:   await verifyFinalReview(input, final.sourceRevision, read, deliveryManifestEncoding);
155:   const manifest = { schemaVersion: 'delivery-manifest.v2', projectId: input.projectId, runId,
156:     sourceRevision: final.sourceRevision, modules, final, evidence };
157:   if (deliveryManifestEncoding === undefined) return { ...manifest, digest: sha256Text(canonicalJson(manifest)) };
158:   const { reviewStageId, reviewArtifactEncoding, reviewSemanticEncoding, ...finalBase } = final;
159:   const v3Final = reviewStageId === undefined ? finalBase
160:     : reviewArtifactEncoding === undefined ? { ...finalBase, reviewStageId }
161:       : reviewSemanticEncoding === undefined ? { ...finalBase, reviewStageId, reviewArtifactEncoding }
162:         : { ...finalBase, reviewStageId, reviewArtifactEncoding, reviewSemanticEncoding };
163:   return createDeliveryManifestV3({ ...manifest, schemaVersion: 'delivery-manifest.v3', final: v3Final });
164: }
SOURCE skills/nova/plugins/project-summary/src/review-semantics.ts SHA256 a14a5e8039d481063d2439a8c1060ca414012f7ba55b73ee153d2317effc2104
1: import { canonicalJson, portableJson, sha256Text } from '@kubeclaw/plugin-sdk';
2: 
3: /** Bounded cross-consumer mapping; no private Review package import. */
4: export const SUMMARY_REVIEW_SEMANTIC_ENCODING = 'review-semantics.utf16-v1' as const;
5: export type SummaryReviewSemanticEncoding = typeof SUMMARY_REVIEW_SEMANTIC_ENCODING;
6: 
7: export function summaryReviewSemanticEncoding(final: Readonly<Record<string, unknown>>): SummaryReviewSemanticEncoding | undefined {
8:   portableJson(final);
9:   if (!Object.hasOwn(final, 'reviewSemanticEncoding')) return undefined;
10:   if (final.reviewSemanticEncoding !== SUMMARY_REVIEW_SEMANTIC_ENCODING || typeof final.reviewStageId !== 'string') {
11:     throw new Error('DELIVERY_REVIEW_SEMANTIC_MODE_INVALID');
12:   }
13:   return SUMMARY_REVIEW_SEMANTIC_ENCODING;
14: }
15: 
16: function record(value: unknown): Readonly<Record<string, unknown>> {
17:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('DELIVERY_REVIEW_SEMANTIC_PAIR_INVALID');
18:   return value as Readonly<Record<string, unknown>>;
19: }
20: 
21: function validateGovernor(report: Readonly<Record<string, unknown>>, governor: Readonly<Record<string, unknown>>,
22:   serialize: typeof portableJson): void {
23:   const baseline = record(governor.baseline), current = record(governor.current), revision = record(report.revision);
24:   if (governor.baselineId !== sha256Text(serialize({ schemaVersion: governor.schemaVersion, baseline }))
25:     || baseline.base !== revision.base || baseline.policyDigest !== report.policyDigest
26:     || current.head !== revision.head || current.changedManifestDigest !== revision.changedManifestDigest) {
27:     throw new Error('DELIVERY_REVIEW_GOVERNOR_IDENTITY_INVALID');
28:   }
29: }
30: 
31: export function summaryReviewBundleDigest(reportValue: unknown, bundleValue: unknown,
32:   expected?: SummaryReviewSemanticEncoding): `sha256:${string}` {
33:   if (expected !== undefined && expected !== SUMMARY_REVIEW_SEMANTIC_ENCODING) throw new Error('DELIVERY_REVIEW_SEMANTIC_MODE_INVALID');
34:   portableJson(reportValue); portableJson(bundleValue);
35:   const report = record(reportValue), bundle = record(bundleValue);
36:   // The original Summary API accepted this exact unversioned pair. It is not
37:   // an assertion that Review's actual producer emitted unversioned reports.
38:   if (expected === undefined && !Object.hasOwn(report, 'schemaVersion') && !Object.hasOwn(bundle, 'schemaVersion')) {
39:     return sha256Text(canonicalJson(bundle));
40:   }
41:   const portable = expected !== undefined;
42:   const governor = record(report.governor);
43:   if (bundle.schemaVersion !== (portable ? 'review-bundle.v2' : 'review-bundle.v1')
44:     || report.schemaVersion !== (portable ? 'review-report.v3' : 'review-report.v2')
45:     || governor.schemaVersion !== (portable ? 'review-governor.v2' : 'review-governor.v1')) {
46:     throw new Error('DELIVERY_REVIEW_SEMANTIC_PAIR_INVALID');
47:   }
48:   const serialize = portable ? portableJson : canonicalJson;
49:   validateGovernor(report, governor, serialize);
50:   return sha256Text(serialize(bundle));
51: }
SOURCE skills/nova/plugins/project-summary/src/stage.ts SHA256 b16533ade1d6bbf08c53d3c31bbe7102f5b67b785b1f928524ca9879a99a4fee
1: import {portableJson,type ArtifactRef,type PluginInvocationContext,type StageResult} from '@kubeclaw/plugin-sdk';
2: import {DELIVERY_MANIFEST_ENCODING,type DeliveryManifestEncoding} from '@kubeclaw/delivery-manifest-contract';
3: import {buildSummary,type SummaryInput} from './summary.ts';
4: export async function execute(input:SummaryInput,context:PluginInvocationContext):Promise<StageResult>{
5:   portableJson(context.contract.config);
6:   const keys=Object.keys(context.contract.config);
7:   if(keys.some(key=>!['agentRole','deliveryManifestEncoding'].includes(key)))throw new Error('DELIVERY_MANIFEST_CONFIG_INVALID');
8:   const deliveryManifestEncoding:DeliveryManifestEncoding|undefined=Object.hasOwn(context.contract.config,'deliveryManifestEncoding')
9:     ? context.contract.config.deliveryManifestEncoding as DeliveryManifestEncoding:undefined;
10:   if(deliveryManifestEncoding!==undefined&&deliveryManifestEncoding!==DELIVERY_MANIFEST_ENCODING)throw new Error('DELIVERY_MANIFEST_CONFIG_INVALID');
11:   let summary;
12:   try{summary=await buildSummary(input,context,deliveryManifestEncoding);}catch(error){
13:     return {schemaVersion:'stage-result.v2',outcome:'blocked',reason:{code:'project_summary.invalid_evidence',message:error instanceof Error?error.message:String(error)},artifacts:[]};
14:   }
15:   const stored=await context.invoke('artifacts.write',{operation:'put_json',resource:{type:'artifact.object',canonicalId:`project-summary:${summary.runId}`},
16:     payload:{namespace:'kubeclaw.project-summary',mediaType:'application/json',value:summary,
17:       ...(deliveryManifestEncoding===undefined?{}:{encoding:'kubeclaw-json.utf16.v1'})}});
18:   return {schemaVersion:'stage-result.v2',outcome:'passed',artifacts:[stored.artifact as ArtifactRef]};
19: }