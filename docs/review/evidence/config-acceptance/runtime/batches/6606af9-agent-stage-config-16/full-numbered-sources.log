1: import type { RuntimeWorkspaceReference, SourceBinding } from '@kubeclaw/plugin-sdk';
2: export interface ImplementationInput {
3:   readonly sourceBinding?: SourceBinding;
4:   readonly runId: string;
5:   readonly moduleId: string;
6:   readonly attempt: number;
7:   readonly task: string;
8:   readonly headBefore: string;
9:   readonly workspaceReference?: RuntimeWorkspaceReference;
10:   readonly workspace?: {
11:     readonly repositoryRoot: string;
12:     readonly workspacePath: string;
13:     readonly branch: string;
14:     readonly baseRef: string;
15:     readonly mergeTarget: string;
16:     readonly commitMessage: string;
17:   };
18: }
19: export interface ImplementationCompletion {
20:   readonly status: 'ready_for_testing' | 'blocked';
21:   readonly runId: string;
22:   readonly moduleId: string;
23:   readonly attempt: number;
24:   readonly summary: string;
25:   readonly changedPaths: readonly string[];
26:   readonly checks: readonly { readonly name: string; readonly passed: boolean }[];
27:   readonly session: {
28:     readonly sessionId: string;
29:     readonly startedAt: string;
30:     readonly completedAt: string;
31:     readonly transcriptDigest: string;
32:     readonly handoffs: number;
33:     readonly termination: 'completed' | 'blocked' | 'cancelled';
34:   };
35: }
36: const text = (value: unknown, name: string, max = 32768): string => {
37:   if (typeof value !== 'string' || value.length < 1 || value.length > max || /[\0\r]/u.test(value)) throw new Error(`${name} is invalid`);
38:   return value;
39: };
40: export function buildRequest(agent: string, input: ImplementationInput, helperPrompt?: string): Readonly<Record<string, unknown>> {
41:   return {
42:     protocol: 'kubeclaw.implementation.v2', agent,
43:     identity: { runId: input.runId, moduleId: input.moduleId, attempt: input.attempt },
44:     headBefore: input.headBefore,
45:     ...(input.workspaceReference ? { workspaceReference: input.workspaceReference } : {}),
46:     task: [
47:       input.task,
48:       helperPrompt?.trim() || 'No additional implementation guidance was supplied.',
49:       'Return only the agent-owned output object described by outputContract.',
50:       'Do not copy protocol, agent, identity, headBefore, task, or outputContract into the output.',
51:       'Runtime/core attach invocation identity and session evidence.',
52:     ].join('\n\n'),
53:     outputContract: {
54:       type: 'object',
55:       additionalProperties: false,
56:       required: ['status', 'summary', 'changedPaths', 'checks'],
57:       properties: {
58:         status: { enum: ['ready_for_testing', 'blocked'] },
59:         summary: { type: 'string' },
60:         changedPaths: {
61:           type: 'array',
62:           description: 'Changed file paths relative to the Git repository root, never relative to a nested project or current working directory.',
63:           items: { type: 'string' },
64:         },
65:         checks: {
66:           type: 'array',
67:           items: {
68:             type: 'object',
69:             additionalProperties: false,
70:             required: ['name', 'passed'],
71:             properties: { name: { type: 'string' }, passed: { type: 'boolean' } },
72:           },
73:         },
74:       },
75:     },
76:   };
77: }
78: function parseChangedPaths(value: unknown): readonly string[] {
79:   if (!Array.isArray(value) || value.length > 512) throw new Error('changedPaths is invalid');
80:   return value.map((item) => {
81:     const changedPath = text(item, 'changed path', 512);
82:     if (changedPath.startsWith('/') || changedPath.split('/').includes('..')) {
83:       throw new Error('changed path escapes the repository');
84:     }
85:     return changedPath;
86:   });
87: }
88: 
89: function parseChecks(value: unknown): readonly { readonly name: string; readonly passed: boolean }[] {
90:   if (!Array.isArray(value) || value.length > 128) throw new Error('checks is invalid');
91:   return value.map((item) => {
92:     if (!item || typeof item !== 'object' || Array.isArray(item)) throw new Error('check is invalid');
93:     const check = item as Record<string, unknown>;
94:     if (Object.keys(check).some((key) => !['name', 'passed'].includes(key))
95:       || typeof check.passed !== 'boolean') throw new Error('check is invalid');
96:     return { name: text(check.name, 'check name', 256), passed: check.passed };
97:   });
98: }
99: 
100: function parseSession(value: unknown): ImplementationCompletion['session'] {
101:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('session evidence is invalid');
102:   const source = value as Record<string, unknown>;
103:   if (Object.keys(source).some((key) => !['sessionId', 'startedAt', 'completedAt', 'transcriptDigest', 'handoffs', 'termination'].includes(key))) {
104:     throw new Error('session evidence has unknown fields');
105:   }
106:   const startedAt = text(source.startedAt, 'session startedAt', 64);
107:   const completedAt = text(source.completedAt, 'session completedAt', 64);
108:   if (!Number.isFinite(Date.parse(startedAt)) || !Number.isFinite(Date.parse(completedAt)) || Date.parse(completedAt) < Date.parse(startedAt)) throw new Error('session timestamps are invalid');
109:   if (typeof source.transcriptDigest !== 'string' || !/^[a-f0-9]{64}$/u.test(source.transcriptDigest)) throw new Error('transcript digest is invalid');
110:   if (!Number.isSafeInteger(source.handoffs) || Number(source.handoffs) < 0) throw new Error('session handoffs are invalid');
111:   if (!['completed', 'blocked', 'cancelled'].includes(String(source.termination))) throw new Error('session termination is invalid');
112:   return {
113:     sessionId: text(source.sessionId, 'session id', 512), startedAt, completedAt,
114:     transcriptDigest: source.transcriptDigest, handoffs: Number(source.handoffs),
115:     termination: source.termination as 'completed' | 'blocked' | 'cancelled',
116:   };
117: }
118: 
119: function assertCompletionConsistency(
120:   status: ImplementationCompletion['status'],
121:   changedPaths: readonly string[],
122:   checks: readonly { readonly passed: boolean }[],
123:   session: ImplementationCompletion['session'],
124: ): void {
125:   if (status === 'ready_for_testing' && session.termination !== 'completed') throw new Error('ready completion requires a completed session');
126:   if (status === 'blocked' && session.termination === 'completed') throw new Error('blocked completion contradicts session evidence');
127:   if (status === 'ready_for_testing' && (changedPaths.length === 0 || checks.length === 0 || checks.some((check) => !check.passed))) throw new Error('ready completion requires changed paths and successful checks');
128:   if (status === 'blocked' && (changedPaths.length > 0 || checks.some((check) => check.passed))) throw new Error('blocked completion contradicts implementation evidence');
129: }
130: export function parseCompletion(value: unknown, input: ImplementationInput): ImplementationCompletion {
131:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('completion must be an object');
132:   const source = value as Record<string, unknown>;
133:   const allowed = new Set(['status', 'summary', 'changedPaths', 'checks', 'session']);
134:   if (Object.keys(source).some((key) => !allowed.has(key))) throw new Error('completion has unknown fields');
135:   const status = source.status;
136:   if (status !== 'ready_for_testing' && status !== 'blocked') throw new Error('completion status is invalid');
137:   const changedPaths = parseChangedPaths(source.changedPaths);
138:   const checks = parseChecks(source.checks);
139:   const summary = text(source.summary, 'summary', 8192);
140:   const session = parseSession(source.session);
141:   assertCompletionConsistency(status, changedPaths, checks, session);
142:   return { status, runId: input.runId, moduleId: input.moduleId, attempt: input.attempt, summary, changedPaths, checks, session };
143: }
SOURCE skills/nova/plugins/implementation-agent/src/workspace.ts SHA256 14cdeb066a35cbb2564928ca8ff8f4fa5ce2bd95a36c3607bda011f9c0e79c34
1: import { runtimeWorkspaceGeneration, type AttemptIdentity } from '@kubeclaw/plugin-sdk';
2: import type { ImplementationInput } from './protocol.ts';
3: 
4: export function attemptWorkspace(input: ImplementationInput, owner: AttemptIdentity): ImplementationInput {
5:   if (!input.workspace) return input;
6:   const generation = runtimeWorkspaceGeneration(owner, input.workspace);
7:   return { ...input, workspace: { ...input.workspace,
8:     workspacePath: `${input.workspace.workspacePath}-g-${generation}`,
9:     branch: `${input.workspace.branch}-g-${generation}`,
10:   } };
11: }
SOURCE skills/nova/plugins/implementation-agent/src/stage.ts SHA256 4f2057feef1fdd4c81bbb90ae203564cd0ab3922a9fd44b098a1a99558da4870
1: import {PORTABLE_JSON_ENCODING} from '@kubeclaw/plugin-sdk';
2: import { repairEvidence } from './repair-evidence.ts';
3: import { approvedSource, parseRuntimeWorkspace, type RuntimeWorkspaceReference } from '@kubeclaw/plugin-sdk';
4: import { attemptWorkspace } from './workspace.ts';
5: import type { ArtifactRef, PluginInvocationContext, StageResult } from '@kubeclaw/plugin-sdk';
6: import {
7:   buildRequest,
8:   parseCompletion,
9:   type ImplementationCompletion,
10:   type ImplementationInput,
11: } from './protocol.ts';
12: 
13: async function createWorkspace(input: ImplementationInput, context: PluginInvocationContext, approval: Awaited<ReturnType<typeof approvedSource>>): Promise<RuntimeWorkspaceReference | undefined> {
14:   if (!input.workspace) {
15:     if (approval) throw new Error('SOURCE_APPROVAL_WORKSPACE_REQUIRED');
16:     return undefined;
17:   }
18:   const created = await context.invoke('git.workspace.create', {
19:     operation: 'create', resource: { type: 'git.repository', canonicalId: input.workspace.repositoryRoot },
20:     payload: {
21:       repositoryRoot: input.workspace.repositoryRoot, workspacePath: input.workspace.workspacePath,
22:       branch: input.workspace.branch, baseRef: context.contract.guidance?.repairRequest ? 'HEAD' : input.workspace.baseRef,
23:       ...(approval ? { approvedSource: approval } : {}),
24:     },
25:   });
26:   if (typeof created.sourceRevision !== 'string' || !/^[a-f0-9]{40}$/u.test(created.sourceRevision)) throw new Error('IMPLEMENTATION_SOURCE_REVISION_INVALID');
27:   const ref = parseRuntimeWorkspace(created.workspaceReference, context.contract.lease.attempt);
28:   if (ref.repositoryRoot !== input.workspace.repositoryRoot || ref.workspacePath !== input.workspace.workspacePath
29:     || ref.branch !== input.workspace.branch || ref.sourceRevision !== created.sourceRevision) throw new Error('IMPLEMENTATION_WORKSPACE_REFERENCE_MISMATCH');
30:   return ref;
31: }
32: 
33: async function dispatchImplementation(
34:   agent: string, input: ImplementationInput, context: PluginInvocationContext, evidence: string | undefined,
35: ): Promise<ImplementationCompletion> {
36:   const response = await context.invoke('runtime.dispatch', withRuntimeDispatchProfile({
37:     operation: 'dispatch', resource: { type: 'runtime.agent', canonicalId: agent },
38:     payload: buildRequest(agent, input, [context.contract.guidance?.helperPrompt, evidence].filter(Boolean).join('\n\n')),
39:   }, context.contract.runtimeDispatchProfile));
40:   return parseCompletion(response.result, input);
41: }
42: 
43: async function integrateWorkspace(
44:   input: ImplementationInput, completion: ImplementationCompletion, context: PluginInvocationContext,
45:   approval: Awaited<ReturnType<typeof approvedSource>>,
46: ): Promise<string | undefined> {
47:   if (!input.workspace || completion.status !== 'ready_for_testing') return undefined;
48:   const committed = await context.invoke('git.commit', {
49:     operation: 'commit', resource: { type: 'git.workspace', canonicalId: input.workspace.workspacePath },
50:     payload: { paths: completion.changedPaths, message: input.workspace.commitMessage, workspaceReference: input.workspaceReference,
51:       expectedParent: input.workspaceReference?.sourceRevision },
52:   });
53:   if (typeof committed.sourceRevision !== 'string' || !/^[a-f0-9]{40}$/u.test(committed.sourceRevision)) throw new Error('IMPLEMENTATION_SOURCE_REVISION_INVALID');
54:   const merged = await context.invoke('git.merge', {
55:     operation: 'merge', resource: { type: 'git.repository', canonicalId: input.workspace.mergeTarget },
56:     payload: { sourceRef: input.workspace.branch, sourceRevision: committed.sourceRevision, workspaceReference: input.workspaceReference, ...(approval ? { approvedSource: approval } : {}) },
57:   });
58:   if (typeof merged.sourceRevision !== 'string' || !/^[a-f0-9]{40}$/u.test(merged.sourceRevision)) throw new Error('IMPLEMENTATION_SOURCE_REVISION_INVALID');
59:   return merged.sourceRevision;
60: }
61: 
62: async function removeWorkspace(input: ImplementationInput, context: PluginInvocationContext): Promise<void> {
63:   if (!input.workspace) return;
64:   await context.invoke('git.workspace.remove', {
65:     operation: 'remove', resource: { type: 'git.repository', canonicalId: input.workspace.repositoryRoot },
66:     payload: {
67:       repositoryRoot: input.workspace.repositoryRoot, workspacePath: input.workspace.workspacePath,
68:       branch: input.workspace.branch,
69:       workspaceReference: input.workspaceReference,
70:     },
71:   });
72: }
73: 
74: function blockedFailure(error: Error | undefined, input: ImplementationInput, retained: boolean): StageResult {
75:   return { schemaVersion: 'stage-result.v2', outcome: 'blocked',
76:     reason: { code: error?.message.startsWith('EFFECT_') ? 'implementation.effect_reconciliation_required' : 'implementation.invalid_completion',
77:       message: error?.message ?? 'implementation completion missing',
78:       ...(retained && input.workspace ? { details: { retainedWorkspace: input.workspace.workspacePath, branch: input.workspace.branch, headBefore: input.headBefore, workspaceReference: input.workspaceReference } } : {}) }, artifacts: [] };
79: }
80: 
81: export async function execute(input: ImplementationInput, context: PluginInvocationContext): Promise<StageResult> {
82:   input = { ...input, runId: context.contract.lease.attempt.runId, attempt: context.contract.lease.attempt.attemptNumber };
83:   input = attemptWorkspace(input, context.contract.lease.attempt);
84: 
85:   const agent = context.contract.config.agent;
86:   if (typeof agent !== 'string' || !agent.trim()) throw new Error('implementation agent is not configured');
87:   let completion;
88:   let workspaceCreated = false;
89:   let workspaceIntegrated: string | undefined;
90:   let workspaceFailure: Error | undefined;
91:   let cleanupFailure: Error | undefined;
92:   let subjectDigest: string | undefined;
93:   try {
94:     const evidence = await repairEvidence(context);
95:     const approval = await approvedSource(context, input.sourceBinding);
96:     subjectDigest = approval?.subject.digest;
97:     const workspaceReference = await createWorkspace(input, context, approval);
98:     workspaceCreated = workspaceReference !== undefined;
99:     if (workspaceReference) input = { ...input, headBefore: workspaceReference.sourceRevision, workspaceReference };
100:     completion = await dispatchImplementation(agent, input, context, evidence);
101:     workspaceIntegrated = await integrateWorkspace(input, completion, context, approval);
102:   } catch (error) {
103:     workspaceFailure = error instanceof Error ? error : new Error(String(error));
104:   } finally {
105:     if (input.workspace && workspaceIntegrated) {
106:       try {
107:         await removeWorkspace(input, context);
108:       } catch (error) {
109:         const failure = error instanceof Error ? error : new Error(String(error));
110:         cleanupFailure = failure;
111:       }
112:     }
113:   }
114:   if (workspaceFailure || !completion) return blockedFailure(workspaceFailure, input, workspaceCreated && !workspaceIntegrated);
115:   return storeCompletion(input, completion, context, workspaceCreated, workspaceIntegrated, cleanupFailure, subjectDigest);
116: }
117: 
118: async function storeCompletion(
119:   input: ImplementationInput, completion: ImplementationCompletion, context: PluginInvocationContext,
120:   workspaceCreated: boolean, workspaceIntegrated: string | undefined, cleanupFailure: Error | undefined,
121:   subjectDigest?: string,
122: ): Promise<StageResult> {
123:   const stored = await context.invoke('artifacts.write', {
124:     operation: 'put_json', resource: { type: 'artifact.object', canonicalId: `implementation:${input.moduleId}:${input.attempt}` },
125:     payload: { namespace: 'kubeclaw.implementation-agent', encoding: PORTABLE_JSON_ENCODING, mediaType: 'application/json', value: { ...completion, sourceRevision: workspaceIntegrated ?? null, headBefore: input.headBefore, ...(subjectDigest ? { subjectDigest } : {}),
126:       ...(workspaceCreated && !workspaceIntegrated && input.workspace ? { retainedWorkspace: input.workspace.workspacePath, branch: input.workspace.branch, workspaceReference: input.workspaceReference } : {}) } },
127:   });
128:   const artifacts = [stored.artifact as ArtifactRef];
129:   if (cleanupFailure) {
130:     const cleanup = await context.invoke('artifacts.write', {
131:       operation: 'put_json',
132:       resource: { type: 'artifact.object', canonicalId: `implementation-cleanup:${input.moduleId}:${input.attempt}` },
133:       payload: {
134:         namespace: 'kubeclaw.implementation-agent',
135:         mediaType: 'application/json',
136:         value: {
137:           schemaVersion: 'implementation-cleanup.v1',
138:           status: 'failed',
139:           message: cleanupFailure.message,
140:           workspaceReference: input.workspaceReference,
141:           sourceRevision: workspaceIntegrated,
142:         },
143:       },
144:     });
145:     artifacts.push(cleanup.artifact as ArtifactRef);
146:   }
147:   return completion.status === 'ready_for_testing'
148:     ? { schemaVersion: 'stage-result.v2', outcome: 'passed', artifacts, ...(workspaceIntegrated ? { facts: { 'implementation.source_revision': workspaceIntegrated } } : {}) }
149:     : { schemaVersion: 'stage-result.v2', outcome: 'blocked',
150:         reason: { code: 'implementation.blocked', message: completion.summary }, artifacts };
151: }
