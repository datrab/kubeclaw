SOURCE skills/nova/plugins/architecture-validator/src/output.ts SHA256 8b6ee1fe1f98b019f0fda4eb52f4f3786863885f52c67f9db3e7d667416d93ea
1: export interface ArchitectureOutput {
2:   readonly verdict: 'passed' | 'blocked';
3:   readonly summary: string;
4:   readonly findings: readonly ArchitectureFinding[];
5:   readonly checkedFiles: readonly string[];
6: }
7: 
8: interface ArchitectureFinding {
9:   readonly id: string;
10:   readonly severity: 'blocking' | 'error' | 'warn' | 'info';
11:   readonly scope: 'domain_model' | 'integration_boundary';
12:   readonly paths: readonly string[];
13:   readonly explanation: string;
14:   readonly remediation: string;
15: }
16: 
17: function strings(value: unknown, label: string): readonly string[] {
18:   if (!Array.isArray(value)) throw new Error(`${label} must be an array`);
19:   return value.map((entry) => {
20:     if (typeof entry !== 'string' || !entry.trim()) throw new Error(`${label} entries must be non-empty strings`);
21:     return entry.trim();
22:   });
23: }
24: 
25: function nonEmpty(value: unknown, label: string, max = 8192): string {
26:   if (typeof value !== 'string' || !value.trim() || value.length > max || /[\0\r]/u.test(value)) {
27:     throw new Error(`${label} must be a non-empty safe string`);
28:   }
29:   return value.trim();
30: }
31: 
32: function findings(value: unknown): readonly ArchitectureFinding[] {
33:   if (!Array.isArray(value)) throw new Error('findings must be an array');
34:   if (value.length > 128) throw new Error('findings exceeds the maximum item count');
35:   return value.map((entry, index) => {
36:     if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {
37:       throw new Error(`findings[${index}] must be an object`);
38:     }
39:     const finding = entry as Record<string, unknown>;
40:     const allowed = new Set(['id', 'severity', 'scope', 'paths', 'explanation', 'remediation']);
41:     for (const key of Object.keys(finding)) {
42:       if (!allowed.has(key)) throw new Error(`findings[${index}] contains unknown field: ${key}`);
43:     }
44:     if (!['blocking', 'error', 'warn', 'info'].includes(String(finding.severity))) {
45:       throw new Error(`findings[${index}] severity is invalid`);
46:     }
47:     if (!['domain_model', 'integration_boundary'].includes(String(finding.scope))) {
48:       throw new Error(`findings[${index}] scope is invalid`);
49:     }
50:     return {
51:       id: nonEmpty(finding.id, `findings[${index}].id`, 256),
52:       severity: finding.severity as ArchitectureFinding['severity'],
53:       scope: finding.scope as ArchitectureFinding['scope'],
54:       paths: strings(finding.paths, `findings[${index}].paths`),
55:       explanation: nonEmpty(finding.explanation, `findings[${index}].explanation`),
56:       remediation: nonEmpty(finding.remediation, `findings[${index}].remediation`),
57:     };
58:   });
59: }
60: 
61: export function parseArchitectureOutput(response: Readonly<Record<string, unknown>>): ArchitectureOutput {
62:   const raw = response.result;
63:   if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('architecture response result must be an object');
64:   const value = raw as Record<string, unknown>;
65:   const allowed = new Set(['verdict', 'summary', 'findings', 'checkedFiles']);
66:   for (const key of Object.keys(value)) if (!allowed.has(key)) throw new Error(`architecture response contains unknown field: ${key}`);
67:   if (!['passed', 'blocked'].includes(String(value.verdict))) throw new Error('architecture verdict is invalid');
68:   if (typeof value.summary !== 'string' || !value.summary.trim()) throw new Error('architecture summary is required');
69:   const output: ArchitectureOutput = {
70:     verdict: value.verdict as ArchitectureOutput['verdict'],
71:     summary: value.summary.trim(),
72:     findings: findings(value.findings),
73:     checkedFiles: strings(value.checkedFiles, 'checkedFiles'),
74:   };
75:   if (output.verdict === 'passed' && output.checkedFiles.length === 0) throw new Error('passed verdict requires checked files');
76:   if (output.verdict === 'passed' && output.findings.some((finding) => finding.severity === 'blocking')) {
77:     throw new Error('passed verdict contradicts blocking findings');
78:   }
79:   if (output.verdict === 'blocked' && !output.findings.some((finding) => finding.severity === 'blocking')) {
80:     throw new Error('blocked verdict requires a blocking finding');
81:   }
82:   return output;
83: }
SOURCE skills/nova/plugins/architecture-validator/src/protocol.ts SHA256 46c3f8894c19ac12c8ca5c35493ef47ace66a8d8092056e102d513c93f29b07a
1: import type { ReviewSource, ReviewSubject, SourceBinding } from '@kubeclaw/plugin-sdk';
2: 
3: export interface ArchitectureInput {
4:   readonly task: string;
5:   readonly architecture?: Readonly<Record<string, unknown>>;
6:   readonly source?: ReviewSource;
7:   readonly subject?: ReviewSubject;
8:   readonly sourceBinding?: SourceBinding;
9: }
10: export function buildArchitectureRequest(agent: string, input: ArchitectureInput, guidance: unknown): Readonly<Record<string, unknown>> {
11:   return Object.freeze({
12:     protocol: 'kubeclaw.architecture-validation.v2',
13:     agent,
14:     task: [
15:       '# KubeClaw architecture validation v2', input.task,
16:       'Validate feasibility, component boundaries, dependency direction, deployment truth, and explicit requirements.',
17:       'Judge only software architecture: domain models and integration boundaries. Generic graph validity, required-file presence, runtime configuration, and execution bookkeeping are validated by core and deterministic preflight stages.',
18:       'Use passed when validation completed, including when advisory, error, warning, or informational findings require operator review. Use blocked only when a blocking constraint prevents the workflow from continuing. Never return request_fix.',
19:       typeof guidance === 'string' && guidance.trim() ? guidance.trim() : 'No additional guidance.',
20:       'Return raw JSON only: {"verdict":"passed|blocked","summary":"string","findings":[{"id":"string","severity":"blocking|error|warn|info","scope":"domain_model|integration_boundary","paths":["string"],"explanation":"string","remediation":"string"}],"checkedFiles":["string"]}.',
21:       'Return only the agent-owned output object described by outputContract. Do not copy protocol, agent, task, architecture, or outputContract into the output.',
22:     ].join('\n\n'),
23:     architecture: input.architecture ?? {},
24:     ...(input.subject ? { reviewSubject: input.subject } : {}),
25:     outputContract: {
26:       type: 'object',
27:       additionalProperties: false,
28:       required: ['verdict', 'summary', 'findings', 'checkedFiles'],
29:       properties: {
30:         verdict: { enum: ['passed', 'blocked'] },
31:         summary: { type: 'string' },
32:         findings: {
33:           type: 'array',
34:           items: {
35:             type: 'object',
36:             additionalProperties: false,
37:             required: ['id', 'severity', 'scope', 'paths', 'explanation', 'remediation'],
38:             properties: {
39:               id: { type: 'string' },
40:               severity: { enum: ['blocking', 'error', 'warn', 'info'] },
41:               scope: { enum: ['domain_model', 'integration_boundary'] },
42:               paths: { type: 'array', items: { type: 'string' } },
43:               explanation: { type: 'string' },
44:               remediation: { type: 'string' },
45:             },
46:           },
47:         },
48:         checkedFiles: { type: 'array', items: { type: 'string' } },
49:       },
50:     },
51:   });
52: }
SOURCE skills/nova/plugins/architecture-validator/src/stage.ts SHA256 1d078730d6c276cba32fbdded3b289bff155638490e7a5d191750732e13565bc
1: import { sourcePreflight, captureReviewSubject, verifyReviewSubject, type ArtifactRef, type PluginInvocationContext, type ReviewSubject, type StageResult } from '@kubeclaw/plugin-sdk';
2: import { buildArchitectureRequest, type ArchitectureInput } from './protocol.ts';
3: import { parseArchitectureOutput } from './output.ts';
4: async function reviewedInput(input: ArchitectureInput, context: PluginInvocationContext): Promise<ArchitectureInput> {
5:   if (input.sourceBinding) {
6:     const bound = await sourcePreflight(input.sourceBinding, context);
7:     return {...input,subject:bound.subject,architecture:bound.contract};
8:   }
9:   const subject = input.source ? await captureReviewSubject(input.source, {task:input.task,architecture:input.architecture ?? {}}, context) : undefined;
10:   return {...input,...(subject ? {subject}:{})};
11: }
12: export async function execute(input: ArchitectureInput, context: PluginInvocationContext): Promise<StageResult> {
13:   const agent = context.contract.config.agent;
14:   if (typeof agent !== 'string' || !agent.trim()) throw new Error('architecture validator agent is not configured');
15:   let output: ReturnType<typeof parseArchitectureOutput>;
16:   let subject: ReviewSubject | undefined;
17:   try {
18:     input = await reviewedInput(input, context);
19:     subject = input.subject;
20:     if (subject) await verifyReviewSubject(subject, context);
21:     output = parseArchitectureOutput(await context.invoke('runtime.dispatch', withRuntimeDispatchProfile({
22:       operation: 'dispatch', resource: { type: 'runtime.agent', canonicalId: agent },
23:       payload: buildArchitectureRequest(agent, { ...input, ...(subject ? { subject } : {}) }, context.contract.guidance?.helperPrompt),
24:     }, context.contract.runtimeDispatchProfile)));
25:     if (subject) {
26:       if (subject.paths.some(file => !output.checkedFiles.includes(file))) throw new Error('REVIEW_SUBJECT_COVERAGE_MISSING');
27:       await verifyReviewSubject(subject, context);
28:     }
29:   } catch (error) {
30:     return {
31:       schemaVersion: 'stage-result.v2', outcome: 'blocked',
32:       reason: { code: 'architecture.invalid_output', message: error instanceof Error ? error.message : String(error) },
33:       artifacts: [],
34:     };
35:   }
36:   const report = await context.invoke('artifacts.write', {
37:     operation: 'put_json', resource: { type: 'artifact.object', canonicalId: 'architecture-validation' },
38:     payload: { ...(subject?.identityEncoding ? {encoding:subject.identityEncoding} : {}), namespace: 'kubeclaw.architecture-validator', mediaType: 'application/json', value: { ...output, ...(subject ? { subject } : {}) } },
39:   });
40:   const artifacts = [report.artifact as ArtifactRef];
41:   if (output.verdict === 'passed') {
42:     return {
43:       schemaVersion: 'stage-result.v2',
44:       outcome: 'passed',
45:       artifacts,
46:       facts: {
47:         'architecture.review': output.findings.length > 0 ? 'approval_required' : 'clean',
48:       },
49:     };
50:   }
51:   return {
52:     schemaVersion: 'stage-result.v2', outcome: 'blocked',
53:     reason: {
54:       code: 'architecture.blocked',
55:       message: output.summary, details: { findings: output.findings, checkedFiles: output.checkedFiles },
56:     },
57:     artifacts,
58:   };
59: }
60: import { withRuntimeDispatchProfile } from '@kubeclaw/plugin-sdk';
