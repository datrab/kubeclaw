78:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes);
79:       assertDurableRecordReplay(state);
80:       const duplicate = existingRecord(state, stream, idempotencyKey, digest, snapshot, owner);
81:       if (duplicate) return { appended: false, record: duplicate };
82:       if (state.records.length >= this.#limits.maximumRecords)
83:         throw new Error("DURABLE_RECORD_STORE_FULL");
84:       const record: DurableRecord<T> = {
85:         schemaVersion: owner === undefined ? "pipeline-durable-record.v1" : "pipeline-durable-record.v2",
86:         ...(owner === undefined ? {} : { owner }),
87:         stream,
88:         sequence: state.records.filter((entry) => entry.stream === stream).length + (state.tombstones?.filter(entry => entry.stream === stream).length ?? 0) + 1,
89:         idempotencyKey,
90:         committedAt: new Date().toISOString(),
91:         payloadDigest: digest,
92:         payload: snapshot,
93:       };
94:       const candidate: DurableRecordState = owner === undefined ? { ...state, records: [...state.records, record] }
