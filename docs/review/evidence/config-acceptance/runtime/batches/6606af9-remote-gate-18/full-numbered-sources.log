63: function auditResult(result: Readonly<Record<string, unknown>>): Readonly<Record<string, unknown>> {
64:   const serialized = Buffer.from(JSON.stringify(result));
65:   if (serialized.length <= 16 * 1024) return result;
66:   const contentDigest = `sha256:${crypto.createHash('sha256').update(serialized).digest('hex')}`;
67:   return Object.freeze({
68:     schemaVersion: 'effect-result-summary.v1',
69:     contentDigest,
70:     artifactRef: `effect-result:${contentDigest}`,
71:     bytes: serialized.length,
72:     externalized: true,
73:   });
74: }
