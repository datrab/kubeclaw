96: export class FileNovaGateImportStore {
97:   readonly #records: FileDurableRecordStore;
98:   readonly #blobs: FileDurableBlobStore;
99:   constructor(root: string, options: { recordLimits: DurableRecordLimits; maximumEvidenceStoreBytes: number }) {
100:     this.#records = new FileDurableRecordStore(root, options.recordLimits);
101:     // The importer enforces the per-job evidence limit; no blob can exceed the
102:     // store quota, and the third argument enforces that quota across all jobs.
103:     this.#blobs = new FileDurableBlobStore(root, options.maximumEvidenceStoreBytes, options.maximumEvidenceStoreBytes);
104:   }
105:   /** Read only a completed import under an exact caller-independent execution binding. */
106:   async readVerifiedResult(binding: { readonly jobId: string; readonly runId: string; readonly pipelineStageId: string;
107:     readonly sourceRevision: string; readonly decisionDigest: string; readonly resultDigest: string }) {
108:     const record = (await this.#records.read<StoredGateImportV2>('remote-gate-imports'))
109:       .find(item => item.idempotencyKey === binding.jobId);
110:     return validateVerifiedOutput(record?.payload, binding);
111:   }
112: 
113:   /** Retain this original import and every referenced blob under its writer fence.
114:    * The caller holds the run fence and may acquire only the distinct dispatch
115:    * store next. It must not reenter this import store from operation. */
116:   async withRetainedImport<T>(inputJob: RemotePlanJobV1, expectedPayloadDigest: string,
117:     operation: (authority: { readonly payloadDigest: string; readonly resultDigest: string;
118:       readonly decisionDigest: string; readonly decision: GateDecisionV1 }) => Promise<T>): Promise<T> {
119:     const job = structuredClone(inputJob);
120:     validatePipelineTestGateContract('remotePlanJob', job);
121:     return this.#records.withRecords<StoredGateImportV2, T>('remote-gate-imports', async records => {
122:       const record = records.find(item => item.idempotencyKey === job.jobId);
123:       const stored = record?.payload;
124:       if (!record || record.payloadDigest !== expectedPayloadDigest || !stored) {
125:         throw new Error('NOVA_DISPATCH_RETENTION_IMPORT_REQUIRED');
126:       }
127:       const result = retainedResult(stored, job);
128:       verifyResult(job, result);
129:       const decision = decideResult(job, result);
130:       if (!same(decision, stored.decision) || decision.state === 'review_required') {
131:         throw new Error('NOVA_DISPATCH_RETENTION_DECISION_INCOMPLETE');
132:       }
133:       const referenced = artifacts(result);
134:       if (!same(stored.evidenceDigests, referenced.map(item => item.contentDigest).sort())) {
135:         throw new Error('NOVA_DISPATCH_RETENTION_EVIDENCE_MISMATCH');
136:       }
137:       for (const artifact of referenced) {
138:         const bytes = await this.#blobs.get(artifact.contentDigest);
139:         if (bytes.byteLength !== artifact.sizeBytes) throw new Error('NOVA_DISPATCH_RETENTION_EVIDENCE_MISMATCH');
140:       }
141:       return operation({ payloadDigest: record.payloadDigest, resultDigest: result.resultDigest,
142:         decisionDigest: decision.decisionDigest, decision: structuredClone(decision) });
143:     });
144:   }
