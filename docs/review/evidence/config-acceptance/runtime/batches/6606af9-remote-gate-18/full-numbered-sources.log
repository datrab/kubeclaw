186: function dependencyInvocation(adapterId: string, capability: string, request: CapabilityInvocation, parent: AdapterInvocationOwner | undefined, deliveryId: string | undefined) {
187:   const attempt = parent?.attempt ?? { runId: `adapter:${adapterId}`, stageId: 'adapter-activation', attemptId: `adapter:${adapterId}`, attemptNumber: 1 };
188:   const owner = parent ? `:parent:${requestDigest({ operation: 'owner', resource: { type: 'effect.key', canonicalId: parent.executionKey }, payload: { attempt: parent.attempt } })}` : '';
189:   const dependencyParent = parent ? {request: parent.request, confidential: parent.confidential} : undefined;
190:   const {key: idempotencyKey, scope} = portableDependencyKey(adapterId, capability, request, dependencyParent, deliveryId);
191:   return { idempotencyKey, dependencyIdentity: {prefix: `adapter:${adapterId}:${capability}:`, suffix: owner, scope, currentKey: idempotencyKey,
192:     ...(dependencyParent ? {parent: dependencyParent} : {})}, attempt, capability,
193:     operation: request.operation, resource: request.resource, payload: request.payload, ...runtimeDispatchProfileFields(request), ...(deliveryId === undefined ? {} : { deliveryId }) };
194: }
