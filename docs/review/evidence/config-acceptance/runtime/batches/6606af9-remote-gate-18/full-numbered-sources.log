101: function remotePlanEndpoint(value: string): URL {
102:   const endpoint = new URL(value);
103:   if (!['http:', 'https:'].includes(endpoint.protocol) || endpoint.username || endpoint.password) {
104:     throw new Error('NOVA_REMOTE_PLAN_ENDPOINT_INVALID');
105:   }
106:   return endpoint;
107: }
