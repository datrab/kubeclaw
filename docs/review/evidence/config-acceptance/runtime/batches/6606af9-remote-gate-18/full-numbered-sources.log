146:   async readExecutionGraphs(): Promise<readonly NovaTestExecutionGraphV1[]> {
147:     return (await this.#records.read<StoredGateImportV2>('remote-gate-imports'))
148:       .filter(record => record.payload.state === 'complete')
149:       .map(({ payload }) => {
150:         if (payload.schemaVersion !== 'nova-test-gate-import.v2') throw new Error('NOVA_REMOTE_IMPORT_SCHEMA_UNSUPPORTED');
151:         return executionGraph(payload.source, payload.remoteResult, payload.decision);
152:       });
153:   }
154:   async record(job: RemotePlanJobV1, status: RemotePlanStatusV1, remoteResult: RemotePlanResultV1 | null,
155:     decision: GateDecisionV1,
156:     evidence: readonly { artifact: ArtifactRefV1; bytes: Uint8Array }[], signal?: AbortSignal): Promise<GateDecisionV1> {
157:     checkGateSignal(signal);
158:     const digests = evidence.map((item) => item.artifact.contentDigest).sort();
159:     const pending: StoredGateImportV2 = { schemaVersion: 'nova-test-gate-import.v2', jobId: job.jobId, source: importSource(job),
160:       requestDigest: job.requestDigest, remoteResultDigest: remoteResult?.resultDigest ?? null,
161:       remoteResult: remoteResult ? structuredClone(remoteResult) : null,
162:       evidenceDigests: digests, decision, state: 'pending_evidence' };
163:     let appended;
164:     try {
165:       appended = await this.#records.append('remote-gate-imports', job.jobId, pending);
166:       checkGateSignal(signal);
167:     } catch (error) {
168:       if (!(error instanceof Error) || error.message !== 'DURABLE_RECORD_IDEMPOTENCY_CONFLICT') throw error;
169:       const record = (await this.#records.read<StoredGateImportV2>('remote-gate-imports'))
170:         .find((item) => item.idempotencyKey === job.jobId);
171:       if (!record) throw error;
172:       checkGateSignal(signal);
173:       const existing = record.payload;
174:       assertSameImport(existing, pending);
175:       if (existing.state === 'complete') {
176:         return structuredClone(existing.decision);
177:       }
178:       appended = { appended: false, record };
179:     }
180:     const existing = appended.record.payload as StoredGateImportV2;
181:     assertSameImport(existing, pending);
182:     if (existing.state === 'complete') {
183:       return structuredClone(existing.decision);
184:     }
185:     for (const item of evidence) {
186:       checkGateSignal(signal);
187:       const stored = await this.#blobs.put(item.bytes);
188:       if (stored.digest !== item.artifact.contentDigest || stored.sizeBytes !== item.artifact.sizeBytes) {
189:         throw new Error('NOVA_REMOTE_EVIDENCE_STORE_MISMATCH');
190:       }
191:     }
192:     checkGateSignal(signal);
193:     const complete: StoredGateImportV2 = { ...pending, state: 'complete' };
194:     const stored = await this.#records.transition('remote-gate-imports', job.jobId, appended.record.payloadDigest, complete);
195:     checkGateSignal(signal);
196:     return structuredClone((stored.payload as StoredGateImportV2).decision);
197:   }
198: }
