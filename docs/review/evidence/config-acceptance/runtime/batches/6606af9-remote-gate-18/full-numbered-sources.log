50: export class ProductionNovaTestGate {
51:   readonly #remote: NovaRemoteTestGate;
52:   readonly #sourceAuthority: string;
53:   readonly #sourceAttestationPrivateKey: string | Buffer;
54:   readonly #maximumArchiveBytes: number;
55:   constructor(options: { remote: NovaRemoteTestGate; sourceAuthority: string;
56:     sourceAttestationPrivateKey: string | Buffer; maximumArchiveBytes: number }) {
57:     this.#remote = options.remote;
58:     this.#sourceAuthority = options.sourceAuthority;
59:     this.#sourceAttestationPrivateKey = options.sourceAttestationPrivateKey;
60:     this.#maximumArchiveBytes = options.maximumArchiveBytes;
61:   }
62:   async execute(input: ProductionNovaTestGateExecutionInput) {
63:     const deadline = new GateDeadline(input.timeoutMs, input.signal);
64:     try {
65:       deadline.check();
66:       const source = await buildCommittedSourceSnapshot({ repositoryRoot: input.repositoryRoot,
67:         repositoryId: input.repositoryId, pipelineStageId: input.pipelineStageId,
68:         creatorAuthority: this.#sourceAuthority,
69:         attestationPrivateKey: this.#sourceAttestationPrivateKey,
70:         maximumArchiveBytes: this.#maximumArchiveBytes, timeoutMs: deadline.remaining(), signal: deadline.signal,
71:         ...(input.revision ? { revision: input.revision } : {}) });
72:       deadline.check();
73:       const job = createRemotePlanJob({ idempotencyKey: input.idempotencyKey,
74:         pipelineStageId: input.pipelineStageId, plan: input.plan, sourceSnapshot: source.sourceSnapshot,
75:         repositoryArchive: source.repositoryArchive, grants: input.grants,
76:         maximumConcurrency: input.maximumConcurrency, submittedAt: input.submittedAt });
77:       const result = await this.#remote.execute(job, { timeoutMs: deadline.remaining(), signal: deadline.signal });
78:       deadline.check();
79:       return { remote: result } as const;
80:     } finally { deadline.dispose(); }
81:   }
82: }
