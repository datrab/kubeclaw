109: export class HttpRemotePlanTransport implements RemotePlanTransport {
110:   readonly #endpoint: string;
111:   readonly #token: string | undefined;
112:   readonly #maximumResponseBytes: number;
113:   readonly #maximumResultBytes: number;
114: 
115:   constructor(options: { readonly endpoint: string; readonly token?: string; readonly authentication?: 'bearer' | 'spiffe-proxy'; readonly maximumResponseBytes: number;
116:     readonly maximumResultBytes?: number }) {
117:     const endpoint = remotePlanEndpoint(options.endpoint);
118:     const authentication = options.authentication ?? 'bearer';
119:     if (authentication === 'bearer' && (!options.token || options.token.length < 32)) {
120:       throw new Error('NOVA_REMOTE_PLAN_TOKEN_INVALID');
121:     }
122:     if (authentication === 'spiffe-proxy'
123:       && !isSpiffeProxyLoopback(endpoint)) {
124:       throw new Error('NOVA_REMOTE_PLAN_SPIFFE_PROXY_NOT_LOOPBACK');
125:     }
126:     if (!Number.isSafeInteger(options.maximumResponseBytes) || options.maximumResponseBytes < 1) {
127:       throw new Error('NOVA_REMOTE_PLAN_RESPONSE_LIMIT_INVALID');
128:     }
129:     this.#endpoint = endpoint.href.replace(/\/+$/u, '');
130:     this.#token = authentication === 'bearer' ? options.token : undefined;
131:     this.#maximumResponseBytes = options.maximumResponseBytes;
132:     this.#maximumResultBytes = options.maximumResultBytes ?? options.maximumResponseBytes;
133:     if (!Number.isSafeInteger(this.#maximumResultBytes) || this.#maximumResultBytes < 1) {
134:       throw new Error('NOVA_REMOTE_RESULT_LIMIT_INVALID');
135:     }
136:   }
137: 
138:   async #request(method: string, suffix: string, body?: unknown, signal?: AbortSignal): Promise<RemotePlanStatusV1> {
139:     const { response, bytes } = await remoteBytes(`${this.#endpoint}${suffix}`, {
140:       method, headers: { ...(this.#token ? { authorization: `Bearer ${this.#token}` } : {}), ...(body === undefined ? {} : { 'content-type': 'application/json' }) },
141:       ...(body === undefined ? {} : { body: JSON.stringify(body) }), redirect: 'error', ...(signal ? { signal } : {}),
142:     }, this.#maximumResponseBytes, 'NOVA_REMOTE_PLAN_RESPONSE', true);
143:     let parsed: unknown;
144:     try { parsed = JSON.parse(bytes.toString('utf8')); }
145:     catch (error) { throw new Error('NOVA_REMOTE_PLAN_RESPONSE_INVALID', { cause: error }); }
146:     if (!response.ok) {
147:       const message = parsed && typeof parsed === 'object' && 'error' in parsed ? String(parsed.error) : response.statusText;
148:       throw new RemotePlanTransportError(
149:         `NOVA_REMOTE_PLAN_HTTP_${response.status}:${message}`,
150:         retryableStatus(response.status),
151:       );
152:     }
153:     validatePipelineTestGateContract('remotePlanStatus', parsed);
154:     return parsed as RemotePlanStatusV1;
155:   }
156: 
157:   submit(job: RemotePlanJobV1, signal?: AbortSignal): Promise<RemotePlanStatusV1> {
158:     return this.#request('POST', '/v1/plan-jobs', job, signal);
159:   }
160: 
161:   status(jobId: string, signal?: AbortSignal): Promise<RemotePlanStatusV1> {
162:     return this.#request('GET', `/v1/plan-jobs/${encodeURIComponent(jobId)}`, undefined, signal);
163:   }
164: 
165:   cancel(jobId: string, signal?: AbortSignal): Promise<RemotePlanStatusV1> {
166:     return this.#request('DELETE', `/v1/plan-jobs/${encodeURIComponent(jobId)}`, undefined, signal);
167:   }
168: 
169:   async evidence(jobId: string, contentDigest: string, maximumBytes: number, signal?: AbortSignal): Promise<Buffer> {
170:     if (!/^sha256:[a-f0-9]{64}$/u.test(contentDigest)) throw new Error('NOVA_REMOTE_EVIDENCE_DIGEST_INVALID');
171:     if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 0) throw new Error('NOVA_REMOTE_EVIDENCE_LIMIT_INVALID');
172:     const responseLimit = Math.min(this.#maximumResponseBytes, maximumBytes);
173:     const { bytes } = await remoteBytes(`${this.#endpoint}/v1/plan-jobs/${encodeURIComponent(jobId)}/evidence/${encodeURIComponent(contentDigest)}`, {
174:       headers: this.#token ? { authorization: `Bearer ${this.#token}` } : {}, redirect: 'error', ...(signal ? { signal } : {}),
175:     }, responseLimit, 'NOVA_REMOTE_EVIDENCE');
176:     if (`sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}` !== contentDigest) {
177:       throw new Error('NOVA_REMOTE_EVIDENCE_DIGEST_MISMATCH');
178:     }
179:     return bytes;
180:   }
181: 
182:   async result(jobId: string, contentDigest: string, maximumBytes: number, signal?: AbortSignal): Promise<RemotePlanResultV1> {
183:     if (!/^sha256:[a-f0-9]{64}$/u.test(contentDigest)) throw new Error('NOVA_REMOTE_RESULT_DIGEST_INVALID');
184:     if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 1) throw new Error('NOVA_REMOTE_RESULT_LIMIT_INVALID');
185:     const responseLimit = Math.min(this.#maximumResultBytes, maximumBytes);
186:     const { bytes } = await remoteBytes(`${this.#endpoint}/v1/plan-jobs/${encodeURIComponent(jobId)}/results/${encodeURIComponent(contentDigest)}`, {
187:       headers: this.#token ? { authorization: `Bearer ${this.#token}` } : {}, redirect: 'error', ...(signal ? { signal } : {}),
188:     }, responseLimit, 'NOVA_REMOTE_RESULT');
189:     const byteDigest = `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}`;
190:     if (byteDigest !== contentDigest) throw new Error('NOVA_REMOTE_RESULT_CONTENT_DIGEST_MISMATCH');
191:     let parsed: unknown;
192:     try { parsed = JSON.parse(bytes.toString('utf8')); }
193:     catch (error) { throw new Error('NOVA_REMOTE_RESULT_INVALID', { cause: error }); }
194:     validatePipelineTestGateContract('remotePlanResult', parsed);
195:     return parsed as RemotePlanResultV1;
196:   }
197: }
