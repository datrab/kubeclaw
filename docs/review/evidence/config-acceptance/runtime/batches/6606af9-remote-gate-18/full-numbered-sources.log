SOURCE skills/nova/core/test-gates/secure-endpoint.ts SHA256 788109a387b6dd67fad7e5695312198a6b65ca3c0bd43ce7deaf416a2d75ac5a
1: /** Hosts explicitly permitted for the local SPIFFE proxy; URL canonicalizes IPv6. */
2: export function isSpiffeProxyLoopback(endpoint: URL): boolean {
3:   return ['127.0.0.1', 'localhost', '[::1]'].includes(endpoint.hostname);
4: }
5: 
6: export function assertSecureRemoteEndpoint(value: string): URL {
7:   const endpoint = new URL(value);
8:   if (!['http:', 'https:'].includes(endpoint.protocol) || endpoint.username || endpoint.password) {
9:     throw new Error('NOVA_REMOTE_PLAN_ENDPOINT_INVALID');
10:   }
11:   const host = endpoint.hostname.toLowerCase();
12:   const loopback = host === 'localhost' || host === '[::1]' || /^127(?:\.\d{1,3}){3}$/u.test(host);
13:   if (endpoint.protocol === 'http:' && !loopback) throw new Error('NOVA_REMOTE_PLAN_PLAINTEXT_NON_LOOPBACK');
14:   return endpoint;
15: }
