1: import { assertDemoSourceLinks } from './demo-source-links.ts';
2: import { canonicalJson, sha256Text } from '@kubeclaw/plugin-sdk';
3: import type { FileNovaGateImportStore } from '@kubeclaw/nova-core';
4: 
5: type Verified = Awaited<ReturnType<FileNovaGateImportStore['readVerifiedResult']>>;
6: type ObjectValue = Record<string, any>;
7: function object(value: unknown): ObjectValue {
8:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('DEMO_EVIDENCE_INVALID');
9:   return value as ObjectValue;
10: }
11: function terminal(verified: Verified, nodeId: string) {
12:   const node = verified.source.plan.nodes.find(item => item.id === nodeId);
13:   const result = verified.result.nodes.find(item => item.nodeId === nodeId);
14:   const attempt = verified.result.attempts.find(item => item.attemptId === result?.finalAttemptId);
15:   if (!node || !result || !attempt || result.outcome !== 'passed' || result.state !== 'completed'
16:     || attempt.nodeId !== nodeId || attempt.executionState !== 'completed' || attempt.outcome !== 'passed'
17:     || canonicalJson(node.provider) !== canonicalJson(attempt.provider)) throw new Error('DEMO_EVIDENCE_NATIVE_ATTEMPT_REQUIRED');
18:   return { node, attempt };
19: }
20: function output(verified: Verified, nodeId: string, name: string, schema: string) {
21:   const { node, attempt } = terminal(verified,nodeId);
22:   const outputs = attempt.outputs.filter(item => item.name === name);
23:   if (outputs.length !== 1 || outputs[0]?.kind !== 'value' || outputs[0].schemaId !== schema) throw new Error('DEMO_EVIDENCE_OUTPUT_REQUIRED');
24:   return {node,attempt,value:object(outputs[0].value)};
25: }
26: 
27: /** Product semantics are projected from the completed native import; none are supplied as value inputs. */
28: export function projectDemoEvidence(verified: Verified, authNodeId: string) {
29:   const auth = output(verified,authNodeId,'authentication','kubeclaw.demo-auth-evidence@1');
30:   if (auth.node.provider.packageId !== 'kubeclaw.demo-auth-smoke' || auth.node.provider.contractId !== 'kubeclaw.demo-auth-smoke@1'
31:     || auth.node.provider.registrationId !== 'session' || auth.node.configuration.values.protocol !== 'json-session.v1' || auth.node.mode !== 'blocking' || !verified.decision.coverage?.checks.some(check => check.nodeId === authNodeId && check.state === 'passed')) throw new Error('DEMO_EVIDENCE_MANDATORY_AUTH_REQUIRED');
32:   const linked = (input: string, schema: string, packageId: string) => {
33:     const links = verified.source.plan.links.filter(link => link.to.nodeId === authNodeId && link.to.input === input);
34:     if (links.length !== 1 || links[0]?.kind !== 'value' || links[0].schemaId !== schema) throw new Error('DEMO_EVIDENCE_NATIVE_LINK_REQUIRED');
35:     const result = output(verified,links[0].from.nodeId,links[0].from.output,schema);
36:     if (result.node.provider.packageId !== packageId || result.node.kind !== 'fixture') throw new Error('DEMO_EVIDENCE_FIXTURE_PRODUCER_INVALID');
37:     return result;
38:   };
39:   const deployment = linked('deployment','kubeclaw.kubernetes-deployment-fixture@1','kubeclaw.kubernetes-fixture');
40:   const credentials = linked('credentials','kubeclaw.generated-demo-credentials@1','kubeclaw.kubernetes-fixture');
41:   const exposure = linked('exposure','kubeclaw.public-endpoint-fixture@1','kubeclaw.tailscale-exposure');
42:   const exposureLinks = verified.source.plan.links.filter(link => link.to.nodeId === exposure.node.id && link.to.input === 'deployment');
43:   if (exposureLinks.length !== 1 || exposureLinks[0]?.from.nodeId !== deployment.node.id || exposureLinks[0].from.output !== 'deployment') throw new Error('DEMO_EVIDENCE_EXPOSURE_LINK_MISMATCH');
44:   if (deployment.attempt.attemptId !== credentials.attempt.attemptId) throw new Error('DEMO_EVIDENCE_FIXTURE_ATTEMPT_MISMATCH');
45:   const value = auth.value, source = object(credentials.value.source), handoff = object(exposure.value.handoff);
46:   assertDemoSourceLinks(verified,deployment.node.id,credentials.value.immutableImage,credentials.value.manifestDigest);
47:   const expected = {schemaVersion:'demo-auth-evidence.v1',runId:verified.source.plan.runId,planId:verified.source.plan.planId,nodeId:authNodeId,
48:     attemptId:auth.attempt.attemptId,attemptNumber:auth.attempt.attemptNumber,protocolDigest:sha256Text(canonicalJson(auth.node.configuration.values)),
49:     leaseName:credentials.value.leaseName,leaseUID:source.leaseUID,namespace:credentials.value.namespace,immutableImage:credentials.value.immutableImage,
50:     manifestDigest:credentials.value.manifestDigest,credentialDigest:source.credentialDigest,secretUID:source.secretUID,
51:     url:exposure.value.url,exposureOwner:handoff.owner,exposureGeneration:handoff.exposureGeneration,expiresAt:exposure.value.expiresAt};
52:   assertSource(value,expected,source,credentials.value,deployment.value,handoff,auth.attempt.completedAt);
53:   return {schemaVersion:'verified-demo-evidence.v1',runId:verified.source.plan.runId,sourceRevision:verified.source.sourceRevision,
54:     jobId:verified.source.jobId,planDigest:verified.source.plan.planDigest,decisionDigest:verified.decision.decisionDigest,
55:     resultDigest:verified.result.resultDigest,authentication:structuredClone(value),deployment:deployment.value,
56:     credentials:credentials.value,exposure:exposure.value};
57: }
58: 
59: function assertSource(value:ObjectValue,expected:ObjectValue,source:ObjectValue,credentials:ObjectValue,deployment:ObjectValue,handoff:ObjectValue,completedAt:string) {
60:   if (Object.entries(expected).some(([key,item]) => item === undefined || value[key] !== item)
61:     || source.credentialDigest !== sha256Text(canonicalJson(credentials.values))
62:     || deployment.manifestDigest !== value.manifestDigest || deployment.immutableImage !== value.immutableImage
63:     || handoff.leaseUID !== value.leaseUID || handoff.immutableImage !== value.immutableImage || handoff.manifestDigest !== value.manifestDigest
64:     || !Number.isSafeInteger(handoff.exposureGeneration) || handoff.exposureGeneration < 1
65:     || handoff.phase !== 'awaiting-readiness' || !Number.isFinite(Date.parse(value.observedAt))
66:     || Date.parse(value.observedAt) > Date.parse(completedAt)) throw new Error('DEMO_EVIDENCE_SOURCE_MISMATCH');
67: }
