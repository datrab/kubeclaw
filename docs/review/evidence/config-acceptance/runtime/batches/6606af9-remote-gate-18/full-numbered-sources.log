58:     || existing.requestDigest !== pending.requestDigest || existing.remoteResultDigest !== pending.remoteResultDigest
59:     || existing.decision.decisionDigest !== pending.decision.decisionDigest || !same(existing.evidenceDigests, pending.evidenceDigests)) {
