11: export class FileNovaRemotePlanStore {
12:   readonly #records: FileDurableRecordStore;
13:   readonly #blobs: FileDurableBlobStore;
14:   readonly #maximumArchiveBytes: number;
15: 
16:   constructor(root: string, options: {
17:     readonly recordLimits: DurableRecordLimits;
18:     readonly maximumArchiveBytes: number;
19:     readonly maximumArchiveStoreBytes: number;
20:   }) {
21:     if (!Number.isSafeInteger(options.maximumArchiveBytes) || options.maximumArchiveBytes < 1) {
22:       throw new Error('NOVA_REMOTE_PLAN_ARCHIVE_LIMIT_INVALID');
23:     }
24:     this.#records = new FileDurableRecordStore(root, options.recordLimits);
25:     this.#blobs = new FileDurableBlobStore(root, options.maximumArchiveBytes, options.maximumArchiveStoreBytes);
26:     this.#maximumArchiveBytes = options.maximumArchiveBytes;
27:   }
28: 
29:   async persistBeforeDispatch(job: RemotePlanJobV1, signal?: AbortSignal): Promise<RemotePlanJobV1> {
30:     checkGateSignal(signal);
31:     const maximumEncodedBytes = Math.ceil(this.#maximumArchiveBytes / 3) * 4;
32:     if (
33:       job.repositoryArchive.sizeBytes > this.#maximumArchiveBytes
34:       || job.repositoryArchive.data.length > maximumEncodedBytes
35:     ) throw new Error('NOVA_REMOTE_PLAN_ARCHIVE_SIZE_EXCEEDED');
36:     validatePipelineTestGateContract('remotePlanJob', job);
37:     const archive = repositoryArchiveBytes(job.repositoryArchive);
38:     if (archive.byteLength > this.#maximumArchiveBytes) throw new Error('NOVA_REMOTE_PLAN_ARCHIVE_SIZE_EXCEEDED');
39:     const payload: FullDispatchJob = {
40:       schemaVersion: 'nova-remote-plan-dispatch.v1',
41:       job: structuredClone(job),
42:     };
43:     try { await this.#records.append('remote-plan-jobs', job.idempotencyKey, payload); }
44:     catch (error) {
45:       if (!(error instanceof Error) || error.message !== 'DURABLE_RECORD_IDEMPOTENCY_CONFLICT') throw error;
46:       const existing = await this.load(job.jobId, signal);
47:       if (dispatchProjectionDigest(existing) !== dispatchProjectionDigest(job)) throw error;
48:       return existing;
49:     }
50:     checkGateSignal(signal);
51:     const stored = await this.#blobs.put(archive);
52:     if (stored.digest !== job.repositoryArchive.contentDigest || stored.sizeBytes !== archive.byteLength) {
53:       throw new Error('NOVA_REMOTE_PLAN_ARCHIVE_STORE_MISMATCH');
54:     }
55:     checkGateSignal(signal);
56:     return this.load(job.jobId, signal);
57:   }
58: 
59:   async recordInterruption(outcome: RemoteInterruption): Promise<void> {
60:     await this.#records.append('remote-plan-interruptions', `interruption:${crypto.randomUUID()}`, outcome);
61:   }
62:   async interruptions(): Promise<readonly RemoteInterruption[]> {
63:     return (await this.#records.read<RemoteInterruption>('remote-plan-interruptions')).map(({ payload }) => payload);
64:   }
65: 
66:   async load(jobId: string, signal?: AbortSignal): Promise<RemotePlanJobV1> {
67:     checkGateSignal(signal);
68:     const records = await this.#records.read<StoredDispatchJob>('remote-plan-jobs');
69:     const record = records.find((record) => record.payload.job?.jobId === jobId);
70:     if (!record) {
71:       throw new Error('NOVA_REMOTE_PLAN_JOB_NOT_FOUND');
72:     }
73:     const job = await this.#restore(record.payload, true, signal);
74:     if (record.idempotencyKey !== job.idempotencyKey) throw new Error('NOVA_DISPATCH_PROJECTION_INVALID');
75:     return job;
76:   }
77: 
78:   async #restore(payload: StoredDispatchJob, repairLegacy: boolean, signal?: AbortSignal): Promise<RemotePlanJobV1> {
79:     if (!payload || !['nova-remote-plan-dispatch.v1', 'nova-remote-plan-dispatch-projected.v1'].includes(payload.schemaVersion)) {
80:       throw new Error('NOVA_REMOTE_PLAN_JOB_SCHEMA_UNSUPPORTED');
81:     }
82:     if (payload.schemaVersion === 'nova-remote-plan-dispatch.v1') {
83:       if (Object.keys(payload).sort().join(',') !== 'job,schemaVersion') throw new Error('NOVA_DISPATCH_PROJECTION_INVALID');
84:       validatePipelineTestGateContract('remotePlanJob', payload.job);
85:       const recordedArchive = repositoryArchiveBytes(payload.job.repositoryArchive);
86:       if (recordedArchive.byteLength > this.#maximumArchiveBytes) throw new Error('NOVA_REMOTE_PLAN_ARCHIVE_SIZE_EXCEEDED');
87:       if (repairLegacy) await this.#blobs.put(recordedArchive);
88:     }
89:     checkGateSignal(signal);
90:     const archive = await this.#blobs.get(payload.job.repositoryArchive.contentDigest);
91:     if (archive.byteLength > this.#maximumArchiveBytes) throw new Error('NOVA_REMOTE_PLAN_ARCHIVE_SIZE_EXCEEDED');
92:     const job: RemotePlanJobV1 = {
93:       ...structuredClone(payload.job),
94:       repositoryArchive: { ...payload.job.repositoryArchive, data: archive.toString('base64') },
95:     };
96:     validatePipelineTestGateContract('remotePlanJob', job);
97:     if (payload.schemaVersion === 'nova-remote-plan-dispatch-projected.v1') assertProjectedDispatch(payload, job);
98:     checkGateSignal(signal);
99:     return Object.freeze(job);
100:   }
101: 
102:   /** Read-only operator selection: unlike legacy load, never repairs a blob. */
103:   async projectionCandidate(jobId: string): Promise<{ readonly job: RemotePlanJobV1; readonly payloadDigest: string }> {
104:     const record = (await this.#records.read<StoredDispatchJob>('remote-plan-jobs')).find(item => item.payload.job?.jobId === jobId);
105:     if (!record) throw new Error('NOVA_REMOTE_PLAN_JOB_NOT_FOUND');
106:     const job = await this.#restore(record.payload, false);
107:     if (record.idempotencyKey !== job.idempotencyKey) throw new Error('NOVA_DISPATCH_PROJECTION_INVALID');
108:     return { job, payloadDigest: record.payloadDigest };
109:   }
110: 
111:   /** Caller holds the distinct run/import fences. This retains every logical job field. */
112:   async compactImportedArchive(input: DispatchProjectionIntent,
113:     authority: { readonly payloadDigest: string; readonly resultDigest: string; readonly decisionDigest: string },
114:     authorize: () => void): Promise<{ readonly newlyProjected: boolean; readonly releasedBytes: number; readonly receipt: DispatchProjectionReceipt }> {
115:     const intent = structuredClone(input);
116:     assertDispatchProjectionIntent(intent);
117:     if (authority.payloadDigest !== intent.importPayloadDigest) throw new Error('NOVA_DISPATCH_RETENTION_IMPORT_REQUIRED');
118:     const record = (await this.#records.read<StoredDispatchJob>('remote-plan-jobs')).find(item => item.payload.job?.jobId === intent.jobId);
119:     if (!record) throw new Error('NOVA_REMOTE_PLAN_JOB_NOT_FOUND');
120:     const job = await this.#restore(record.payload, false);
121:     if (record.idempotencyKey !== job.idempotencyKey || job.plan.runId !== intent.runId || job.requestDigest !== intent.requestDigest) {
122:       throw new Error('NOVA_DISPATCH_RETENTION_JOB_MISMATCH');
123:     }
124:     if (record.payload.schemaVersion === 'nova-remote-plan-dispatch-projected.v1') {
125:       const receipt = record.payload.projection;
126:       if (receipt.intentDigest !== dispatchProjectionDigest(intent) || receipt.resultDigest !== authority.resultDigest
127:         || receipt.decisionDigest !== authority.decisionDigest) throw new Error('NOVA_DISPATCH_RETENTION_CONFLICT');
128:       return this.#records.withRecords<StoredDispatchJob, { newlyProjected: false; releasedBytes: number; receipt: DispatchProjectionReceipt }>(
129:         'remote-plan-jobs', async current => {
130:           if (current.find(item => item.idempotencyKey === record.idempotencyKey)?.payloadDigest !== record.payloadDigest) {
131:             throw new Error('NOVA_DISPATCH_RETENTION_RECORD_CHANGED');
132:           }
133:           if (authorize() !== undefined) throw new Error('DURABLE_RECORD_AUTHORIZATION_NOT_SYNCHRONOUS');
134:           return { newlyProjected: false, releasedBytes: 0, receipt: structuredClone(receipt) };
135:         });
136:     }
137:     if (record.payloadDigest !== intent.expectedPayloadDigest) throw new Error('NOVA_DISPATCH_RETENTION_RECORD_CHANGED');
138:     const { data: _data, ...archive } = job.repositoryArchive;
139:     const projection: DispatchProjectionReceipt = { schemaVersion: 'nova-dispatch-projection-receipt.v1',
140:       intent, intentDigest: dispatchProjectionDigest(intent), resultDigest: authority.resultDigest,
141:       decisionDigest: authority.decisionDigest, releasedBytesHex: '0000000000000000' };
142:     const next: ProjectedDispatchJob = { schemaVersion: 'nova-remote-plan-dispatch-projected.v1',
143:       job: { ...job, repositoryArchive: archive }, projection };
144:     const releasedBytes = Buffer.byteLength(canonicalJson(record.payload)) - Buffer.byteLength(canonicalJson(next))
145:       + Buffer.byteLength(record.committedAt) - 24;
146:     if (releasedBytes < 1) throw new Error('NOVA_DISPATCH_RETENTION_NO_SAVING');
147:     const payload: ProjectedDispatchJob = { ...next, projection: { ...projection, releasedBytesHex: releasedBytes.toString(16).padStart(16, '0') } };
148:     assertProjectedDispatch(payload, job);
149:     await this.#records.transition('remote-plan-jobs', record.idempotencyKey, record.payloadDigest, payload, authorize);
150:     return { newlyProjected: true, releasedBytes, receipt: structuredClone(payload.projection) };
151:   }
152: }
