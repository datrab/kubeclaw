53: function resolvePaths(config: PlatformConfig, directory: string): PlatformConfig {
54:   return deepFreeze({
55:     ...config,
56:     installationRoots: config.installationRoots.map((value) => path.resolve(directory, value)),
57:     trustedBuiltinRoots: config.trustedBuiltinRoots.map((value) => path.resolve(directory, value)),
58:     storageRoot: path.resolve(directory, config.storageRoot),
59:     ...(config.isolation ? { isolation: { cgroupRoot: path.resolve(directory, config.isolation.cgroupRoot) } } : {}),
60:   });
61: }
