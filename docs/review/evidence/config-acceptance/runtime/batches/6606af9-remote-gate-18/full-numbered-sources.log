47: function deepFreeze<T>(value: T): T {
48:   if (!value || typeof value !== 'object' || Object.isFrozen(value)) return value;
49:   for (const child of Object.values(value as Record<string, unknown>)) deepFreeze(child);
50:   return Object.freeze(value);
51: }
