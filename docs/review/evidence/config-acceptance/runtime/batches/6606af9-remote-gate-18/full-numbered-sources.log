84: /**
85:  * Build the one production authority path for resolved test plans.
86:  *
87:  * This composition keeps durable dispatch, terminal reconnect, verified import,
88:  * evidence transfer, gate policy, and legacy authority selection together.
89:  */
90: export function createProductionNovaTestGate(
91:   options: ProductionNovaTestGateOptions,
92: ): ProductionNovaTestGate {
93:   if (!path.isAbsolute(options.stateRoot)) throw new Error('NOVA_REMOTE_STATE_ROOT_NOT_ABSOLUTE');
94:   const endpoint = assertSecureRemoteEndpoint(options.endpoint);
95:   const transport = new HttpRemotePlanTransport({
96:     endpoint: endpoint.href,
97:     ...(options.token ? { token: options.token } : {}),
98:     ...(options.authentication ? { authentication: options.authentication } : {}),
99:     maximumResponseBytes: options.maximumResponseBytes,
100:     maximumResultBytes: options.maximumResultBytes,
101:   });
102:   const dispatcher = new NovaRemotePlanDispatcher({
103:     store: new FileNovaRemotePlanStore(path.join(options.stateRoot, 'dispatch'), {
104:       recordLimits: options.recordLimits,
105:       maximumArchiveBytes: options.maximumArchiveBytes,
106:       maximumArchiveStoreBytes: options.maximumArchiveStoreBytes,
107:     }),
108:     transport,
109:     pollMilliseconds: options.pollMilliseconds,
110:   });
111:   const importer = new NovaRemoteGateImporter({
112:     store: new FileNovaGateImportStore(path.join(options.stateRoot, 'imports'), {
113:       recordLimits: options.recordLimits,
114:       maximumEvidenceStoreBytes: options.maximumEvidenceStoreBytes,
115:     }),
116:     evidence: transport,
117:     results: transport,
118:     maximumEvidenceBytes: options.maximumEvidenceBytes,
119:     maximumResultBytes: options.maximumResultBytes,
120:   });
121:   const remote = new NovaRemoteTestGate({ dispatcher, importer });
122:   return new ProductionNovaTestGate({ remote, sourceAuthority: options.sourceAuthority,
123:     sourceAttestationPrivateKey: options.sourceAttestationPrivateKey,
124:     maximumArchiveBytes: options.maximumArchiveBytes });
125: }
