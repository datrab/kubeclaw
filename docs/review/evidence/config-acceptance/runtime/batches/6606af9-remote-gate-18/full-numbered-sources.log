117:   #wrap(raw: AdapterInstance, lifecycle: AbortController, adapterId: string): AdapterInstance {
118:     return { ready: () => raw.ready(), invoke: async (invocation) => {
119:       const signal = AbortSignal.any([invocation.signal, lifecycle.signal]);
120:       const phase = new AdapterInvocationPhase(lifecycle.signal, this.#options.runtime.shutdownTimeoutMs);
121:       const request = structuredClone(invocation.request);
122:       try {
123:         return await this.#options.invocationContext.run({ adapterId, phase, signal, request, confidential: invocation.confidential === true, attempt: request.attempt, executionKey: request.idempotencyKey },
124:         () => raw.invoke({ ...invocation, signal }));
125:       } finally { phase.close(); }
126:     }, ...(raw.receipt ? { receipt: async (request) => {
127:       request = structuredClone(request);
128:       const phase = new AdapterInvocationPhase(lifecycle.signal, this.#options.runtime.shutdownTimeoutMs);
129:       try {
130:         phase.assertActive();
131:         const result = await this.#options.invocationContext.run({ adapterId, phase, signal: lifecycle.signal, request, confidential: false, attempt: request.attempt, executionKey: request.idempotencyKey },
132:           () => raw.receipt!(structuredClone(request)));
133:         phase.assertActive();return result;
134:       } finally { phase.close(); }
135:     } } : {}), shutdown: (signal) => raw.shutdown(signal) };
136:   }
137: 
138:   async #cleanup<T>(adapterId: string, lifecycle: AbortController, active: () => void,
139:     operation: (context: AdapterCleanupContext) => Promise<T>): Promise<T> {
140:     active();
141:     const parent = this.#options.invocationContext.getStore();
142:     if (!parent || parent.adapterId !== adapterId) throw new Error('ADAPTER_CLEANUP_INVOCATION_REQUIRED');
143:     return parent.phase.cleanup(signal => {
144:       const owner = { ...parent, signal };
145:       const invoke = (capability: string, request: CapabilityInvocation, confidential: boolean, options?: AdapterDependencyOptions) =>
146:         this.#options.invocationContext.run(owner, () => this.#invokeDependency(adapterId, lifecycle, active, capability, request, confidential, options));
147:       const context: AdapterCleanupContext = Object.freeze({ signal,
148:         invoke: (capability: string, request: CapabilityInvocation, options?: AdapterDependencyOptions) => invoke(capability, request, false, options),
149:         invokeConfidential: (capability: string, request: CapabilityInvocation, options?: AdapterDependencyOptions) => invoke(capability, request, true, options),
150:       });
151:       return this.#options.invocationContext.run(owner, () => operation(context));
152:     });
153:   }
154: 
155:   async #ready(adapterId: string, instance: AdapterInstance, lifecycle: AbortController): Promise<void> {
156:     if (this.#options.stopping() || lifecycle.signal.aborted) throw new Error('ADAPTER_RUNTIME_STOPPING');
157:     try { await withAdapterStartupTimeout(adapterId, 'ready', this.#options.runtime.shutdownTimeoutMs, () => instance.ready(), (error) => lifecycle.abort(error)); }
158:     catch (error) { await this.#teardownFailed(adapterId, instance, lifecycle, error); }
159:     if (this.#options.stopping() || lifecycle.signal.aborted) throw new Error('ADAPTER_RUNTIME_STOPPING');
160:   }
161: 
162:   async #teardownFailed(adapterId: string, instance: AdapterInstance, lifecycle: AbortController, error: unknown): Promise<never> {
163:     lifecycle.abort(error); this.#instances.delete(adapterId); this.#controllers.delete(adapterId); this.#options.pendingInstances.delete(adapterId); this.#options.pendingControllers.delete(adapterId);
164:     const controller = new AbortController(); const timer = setTimeout(() => controller.abort(), this.#options.runtime.shutdownTimeoutMs);
165:     try { await this.#options.shutdown(instance, controller.signal); }
166:     catch { /* INTENTIONAL_NONCRITICAL(readiness_teardown_failed): Preserve the readiness failure after bounded teardown. */ }
167:     finally { clearTimeout(timer); }
168:     throw error;
169:   }
170: 
171:   async #rollback(): Promise<void> {
172:     this.#controllers.forEach((controller) => controller.abort(new Error('ADAPTER_ACTIVATION_ROLLED_BACK')));
173:     const controller = new AbortController(); const timer = setTimeout(() => controller.abort(), this.#options.runtime.shutdownTimeoutMs);
174:     try { for (const instance of [...this.#instances.values()].reverse()) { try { await this.#options.shutdown(instance, controller.signal); }
175:       catch { /* INTENTIONAL_NONCRITICAL(adapter_rollback_failed): Preserve activation failure while attempting rollback. */ } } }
176:     finally { clearTimeout(timer); this.#starting.clear(); for (const id of this.#controllers.keys()) { this.#options.pendingControllers.delete(id); this.#options.pendingInstances.delete(id); } }
177:   }
178: }
