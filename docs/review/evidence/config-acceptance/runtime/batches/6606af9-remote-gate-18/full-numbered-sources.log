36:     node.id,
37:     [...(input.grants.get(node.id) ?? [])].sort(),
38:   ]));
39:   const unsigned = {
40:     schemaVersion: 'buster-plan-job.v1' as const,
41:     jobId: remotePlanJobId(input.idempotencyKey),
42:     idempotencyKey: input.idempotencyKey,
43:     pipelineStageId: input.pipelineStageId,
44:     plan: structuredClone(input.plan),
45:     sourceSnapshot: structuredClone(input.sourceSnapshot),
46:     repositoryArchive: repositoryArchive(input.repositoryArchive),
47:     grants,
48:     maximumConcurrency: input.maximumConcurrency,
49:     submittedAt: input.submittedAt,
50:   };
51:   const job: RemotePlanJobV1 = { ...unsigned, requestDigest: remotePlanJobDigest(unsigned) };
52:   validatePipelineTestGateContract('remotePlanJob', job);
53:   return Object.freeze(job);
54: }
