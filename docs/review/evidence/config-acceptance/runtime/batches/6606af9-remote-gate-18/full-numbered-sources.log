70: export class NovaRemotePlanDispatcher {
71:   readonly #store: FileNovaRemotePlanStore;
72:   readonly #transport: RemotePlanTransport;
73:   readonly #pollMilliseconds: number;
74:   readonly #cleanupMilliseconds: number;
75: 
76:   constructor(options: {
77:     readonly store: FileNovaRemotePlanStore;
78:     readonly transport: RemotePlanTransport;
79:     readonly pollMilliseconds: number;
80:     readonly cleanupMilliseconds?: number;
81:   }) {
82:     if (!Number.isSafeInteger(options.pollMilliseconds) || options.pollMilliseconds < 10) {
83:       throw new Error('NOVA_REMOTE_PLAN_POLL_INVALID');
84:     }
85:     this.#store = options.store;
86:     this.#transport = options.transport;
87:     this.#pollMilliseconds = options.pollMilliseconds;
88:     this.#cleanupMilliseconds = options.cleanupMilliseconds ?? 10_000;
89:     if (!Number.isSafeInteger(this.#cleanupMilliseconds) || this.#cleanupMilliseconds < 1) throw new Error('NOVA_REMOTE_CLEANUP_TIMEOUT_INVALID');
90:   }
91: 
92:   async dispatch(job: RemotePlanJobV1, options: {
93:     readonly timeoutMs: number;
94:     readonly signal?: AbortSignal;
95:   }): Promise<RemotePlanStatusV1> {
96:     return dispatchOperation({ store: this.#store, transport: this.#transport, pollMilliseconds: this.#pollMilliseconds,
97:       cleanupMilliseconds: this.#cleanupMilliseconds }, job, options);
98:   }
99: }
