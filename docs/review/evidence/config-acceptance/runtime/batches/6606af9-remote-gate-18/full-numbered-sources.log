103:   async read<T>(stream: string): Promise<ReadonlyArray<DurableRecord<T>>> {
104:     return this.withRecords<T, ReadonlyArray<DurableRecord<T>>>(stream, async records => records);
105:   }
106: 
107:   /** Domain owners may inspect records while holding this store's writer fence.
108:    * Never reenter this store from operation; acquire other stores in a fixed order. */
109:   async withRecords<T, R>(stream: string, operation: (records: ReadonlyArray<DurableRecord<T>>) => Promise<R>): Promise<R> {
110:     identity(stream, "DURABLE_RECORD_STREAM_INVALID");
111:     return this.#serial(async () => operation(await readStoreRecords<T>(this.#file, this.#limits.maximumBytes, stream)));
112:   }
113: 
114:   async retirements(stream: string): Promise<readonly RecordRetirement[]> {
