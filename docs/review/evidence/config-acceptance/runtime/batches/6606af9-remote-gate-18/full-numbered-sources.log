6: import type { AdapterActivationContext, AdapterInstance, AdapterInvocation } from '@kubeclaw/plugin-sdk';
7: 
8: function canonicalDirectory(value: unknown, code: string): string {
9:   if (typeof value !== 'string' || !path.isAbsolute(value)) throw new Error(code);
10:   const canonical = fs.realpathSync(value);
11:   if (!fs.statSync(canonical).isDirectory()) throw new Error(code);
12:   return canonical;
13: }
14: 
15: function string(value: unknown, code: string): string {
16:   if (typeof value !== 'string' || value.length === 0) throw new Error(code);
17:   return value;
18: }
19: 
20: function positiveInteger(value: unknown, maximum: number, code: string): number {
21:   if (!Number.isSafeInteger(value) || Number(value) < 1 || Number(value) > maximum) throw new Error(code);
22:   return Number(value);
23: }
24: 
25: async function secret(context: AdapterActivationContext, name: string): Promise<string> {
26:   const result = await context.invokeConfidential('secrets.read', {
27:     operation: 'resolve', resource: { type: 'secret.name', canonicalId: name }, payload: {},
28:   });
29:   return string(result.value, 'REMOTE_TEST_GATE_SECRET_UNAVAILABLE');
30: }
31: 
32: function grants(value: unknown, plan: ResolvedTestPlanV1): ReadonlyMap<string, readonly string[]> {
33:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('REMOTE_TEST_GATE_GRANTS_INVALID');
34:   const source = value as Record<string, unknown>;
35:   const expected = [...plan.nodes.map((node) => node.id)].sort();
36:   if (JSON.stringify(Object.keys(source).sort()) !== JSON.stringify(expected)) throw new Error('REMOTE_TEST_GATE_GRANTS_INVALID');
37:   return new Map(expected.map((nodeId) => {
38:     const item = source[nodeId];
39:     if (!Array.isArray(item) || item.some((capability) => typeof capability !== 'string')) {
40:       throw new Error('REMOTE_TEST_GATE_GRANTS_INVALID');
41:     }
42:     return [nodeId, Object.freeze([...new Set(item)].sort())] as const;
43:   }));
44: }
45: 
46: function parseConfig(context: AdapterActivationContext) {
47:   const endpoint = new URL(string(context.config.endpoint, 'REMOTE_TEST_GATE_CONFIG_INVALID'));
48:   if (!['http:', 'https:'].includes(endpoint.protocol)) throw new Error('REMOTE_TEST_GATE_PROTOCOL_INVALID');
49:   const stateRoot = path.resolve(string(context.config.stateRoot, 'REMOTE_TEST_GATE_CONFIG_INVALID'));
50:   const roots = (context.config.allowedRepositoryRoots as unknown[]).map((root) => canonicalDirectory(root,
51:     'REMOTE_TEST_GATE_CONFIG_INVALID'));
52:   const authentication = context.config.authentication === 'spiffe-proxy' ? 'spiffe-proxy' : 'bearer';
53:   if (authentication === 'spiffe-proxy' && !isSpiffeProxyLoopback(endpoint)) {
54:     throw new Error('REMOTE_TEST_GATE_SPIFFE_PROXY_NOT_LOOPBACK');
55:   }
56:   return Object.freeze({ endpoint: endpoint.href, stateRoot, roots,
57:     authentication,
58:     tokenSecret: authentication === 'bearer'
59:       ? string(context.config.tokenSecret, 'REMOTE_TEST_GATE_CONFIG_INVALID') : undefined,
60:     privateKeySecret: string(context.config.sourcePrivateKeySecret, 'REMOTE_TEST_GATE_CONFIG_INVALID'),
61:     sourceAuthority: string(context.config.sourceAuthority, 'REMOTE_TEST_GATE_CONFIG_INVALID') });
62: }
63: 
64: async function execute(context: AdapterActivationContext, config: ReturnType<typeof parseConfig>, invocation: AdapterInvocation) {
65:   const { request, signal } = invocation;
66:   if (request.capability !== 'test.plan.execute' || request.operation !== 'run'
67:     || request.resource.type !== 'test.resolved-plan') throw new Error('REMOTE_TEST_GATE_OPERATION_UNSUPPORTED');
68:   const repositoryRoot = canonicalDirectory(request.payload.repositoryRoot, 'REMOTE_TEST_GATE_REPOSITORY_INVALID');
69:   if (!config.roots.some((root) => repositoryRoot === root || repositoryRoot.startsWith(`${root}${path.sep}`))) {
70:     throw new Error('REMOTE_TEST_GATE_REPOSITORY_DENIED');
71:   }
72:   validatePipelineTestGateContract('resolvedTestPlan', request.payload.plan);
73:   const plan = request.payload.plan as ResolvedTestPlanV1;
74:   if (plan.runId !== request.attempt.runId) throw new Error('REMOTE_TEST_GATE_RUN_MISMATCH');
75:   const expectedCoverage = request.payload.expectedCoverage as GateCoverageV1 | undefined;
76:   if (plan.coverage && !expectedCoverage) throw new Error('REMOTE_EXPECTED_COVERAGE_REQUIRED');
77:   if (expectedCoverage) {
78:     assertCoveragePlan(plan, expectedCoverage);
79:     if (request.payload.gateId !== request.attempt.stageId) throw new Error('REMOTE_TEST_GATE_STAGE_MISMATCH');
80:   }
81:   const token = config.tokenSecret ? await secret(context, config.tokenSecret) : undefined;
82:   const privateKey = await secret(context, config.privateKeySecret);
83:   const gate = createProductionNovaTestGate({ stateRoot: config.stateRoot, endpoint: config.endpoint,
84:     ...(token ? { token } : {}), authentication: config.authentication,
85:     sourceAuthority: config.sourceAuthority, sourceAttestationPrivateKey: privateKey,
86:     pollMilliseconds: 500, maximumResponseBytes: 64 * 1024 * 1024,
87:     maximumResultBytes: 64 * 1024 * 1024, maximumArchiveBytes: 64 * 1024 * 1024,
88:     maximumArchiveStoreBytes: 1024 * 1024 * 1024, maximumEvidenceBytes: 64 * 1024 * 1024,
89:     maximumEvidenceStoreBytes: 1024 * 1024 * 1024,
90:     recordLimits: { maximumRecords: 10_000, maximumBytes: 1024 * 1024 * 1024,
91:       maximumRecordBytes: 64 * 1024 * 1024 } });
92:   const result = await gate.execute({ idempotencyKey: request.idempotencyKey,
93:     pipelineStageId: request.attempt.stageId, plan, repositoryRoot,
94:     revision: string(request.payload.revision, 'REMOTE_TEST_GATE_REVISION_REQUIRED'),
95:     repositoryId: string(request.payload.repositoryId, 'REMOTE_TEST_GATE_REPOSITORY_ID_INVALID'),
96:     grants: grants(request.payload.grants, plan),
97:     maximumConcurrency: positiveInteger(request.payload.maximumConcurrency, 64, 'REMOTE_TEST_GATE_CONCURRENCY_INVALID'),
98:     submittedAt: string(request.payload.submittedAt, 'REMOTE_TEST_GATE_SUBMITTED_AT_INVALID'),
99:     timeoutMs: positiveInteger(request.payload.timeoutMs, 7_200_000, 'REMOTE_TEST_GATE_TIMEOUT_INVALID'), signal });
100:   if (expectedCoverage) assertCoverageExecution(plan, result.remote.decision, expectedCoverage,
101:     string(request.payload.revision, 'REMOTE_TEST_GATE_REVISION_REQUIRED'), request.attempt.stageId);
102:   return Object.freeze({ ...result.remote.decision });
103: }
104: 
105: export function activate(context: AdapterActivationContext): AdapterInstance {
106:   const config = parseConfig(context);
107:   let stopping = false;
108:   return {
109:     async ready() { if (stopping) throw new Error('ADAPTER_SHUTTING_DOWN'); },
110:     async invoke(invocation) {
111:       if (!invocation.confidential) invocation.fence.assertCurrent();
112:       if (stopping) throw new Error('ADAPTER_SHUTTING_DOWN');
113:       if (invocation.signal.aborted) throw new Error('ADAPTER_CANCELLED');
114:       return execute(context, config, invocation);
115:     },
116:     async shutdown() { stopping = true; },
117:   };
118: }
