45: function enabledRegistrations(platform: PlatformConfig, definition: PipelineDefinition, snapshot: ReturnType<typeof buildRegistry>): Set<string> {
46:   const enabled = new Set<string>(Object.keys(platform.observers)); platform.activeAdapters.forEach((id) => enabled.add(id));
47:   for (const stage of definition.stages) {
48:     const owner = snapshot.stages.get(stage.type); if (!owner) throw new Error(`PIPELINE_STAGE_OWNER_MISSING:${stage.type}`);
49:     enabled.add(`${owner.package.manifest.id}:${owner.registration.id}`);
50:   }
51:   return enabled;
52: }
