63: export function loadPlatformConfig(file: string): PlatformConfig {
64:   const canonical = fs.realpathSync(file);
65:   const value = JSON.parse(fs.readFileSync(canonical, 'utf8')) as unknown;
66:   if (!validate(value)) {
67:     throw new Error(`PLATFORM_CONFIG_INVALID:${canonical}:${JSON.stringify(validate.errors ?? [])}`);
68:   }
69:   return resolvePaths(value as PlatformConfig, path.dirname(canonical));
70: }
