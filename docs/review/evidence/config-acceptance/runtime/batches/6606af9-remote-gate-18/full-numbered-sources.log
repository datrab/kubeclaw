70:         && selectedWait.registration.id === 'waits' && this.#options.runtime.resolveRetainedWait ? {
71:         resolveRetainedWait: (source: RetainedWaitSource) => {
72:           active();
73:           const wait = this.#options.runtime.resolveRetainedWait!(structuredClone(source));
74:           active();
75:           return wait;
76:         },
77:       } : {}),
78:       emit: async (type: string, identity: EventIdentity, payload: Readonly<Record<string, unknown>>) => { active(); if (!type.startsWith(`plugin.${pluginId}.`)) throw new Error(`PLUGIN_EVENT_NAMESPACE_DENIED:${type}`);
79:         await this.#options.runtime.emitDomainEvent(registration, type, identity, payload); active(); },
80:       invoke: (capability: string, request: CapabilityInvocation, options?: AdapterDependencyOptions) => this.#invokeDependency(adapterId, lifecycle, active, capability, request, false, options),
81:       invokeConfidential: (capability: string, request: CapabilityInvocation, options?: AdapterDependencyOptions) => this.#invokeDependency(adapterId, lifecycle, active, capability, request, true, options),
82:       withCleanup: <T>(operation: (context: AdapterCleanupContext) => Promise<T>) => this.#cleanup(adapterId, lifecycle, active, operation),
83:     });
84:   }
85: 
86:   async #invokeDependency(adapterId: string, lifecycle: AbortController, active: () => void, capability: string, request: CapabilityInvocation, confidential: boolean, options?: AdapterDependencyOptions): Promise<Readonly<Record<string, unknown>>> {
87:     portableJson(request);
88:     request = structuredClone(request);
89:     if (runtimeDispatchProfileFields(request, capability).runtimeDispatchProfile) validateContractValue('capabilityInvocation', request);
90:     active(); const parent = this.#options.invocationContext.getStore();
91:     parent?.phase.assertActive();
92:     const deliveryId = dependencyDeliveryId(options, parent);
93:     const signal = AbortSignal.any([lifecycle.signal, ...(parent ? [parent.signal] : []), ...(options?.signal ? [options.signal] : [])]);
94:     if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
95:     const grant = this.#options.runtime.granted.grants.get(adapterId)?.find((candidate) => candidate.capability === capability);
96:     if (!grant) throw new Error(`ADAPTER_CAPABILITY_DENIED:${adapterId}:${capability}`); authorizeCapabilityInvocation(grant, request);
97:     const dependency = this.#options.runtime.granted.selectedProviders.get(capability); if (!dependency) throw new Error(`ADAPTER_CAPABILITY_DENIED:${adapterId}:${capability}`);
98:     const dependencyId = `${dependency.package.manifest.id}:${dependency.registration.id}`; const adapter = await this.#start(dependencyId);
