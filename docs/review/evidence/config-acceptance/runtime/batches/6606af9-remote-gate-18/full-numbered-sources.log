200: export class NovaRemoteGateImporter {
201:   readonly #store: FileNovaGateImportStore;
202:   readonly #evidence: RemotePlanEvidenceTransport;
203:   readonly #results: RemotePlanResultTransport;
204:   readonly #maximumEvidenceBytes: number;
205:   readonly #maximumResultBytes: number;
206:   constructor(options: { store: FileNovaGateImportStore; evidence: RemotePlanEvidenceTransport;
207:     results: RemotePlanResultTransport; maximumEvidenceBytes: number; maximumResultBytes: number }) {
208:     if (!Number.isSafeInteger(options.maximumEvidenceBytes) || options.maximumEvidenceBytes < 1) throw new Error('NOVA_REMOTE_EVIDENCE_LIMIT_INVALID');
209:     if (!Number.isSafeInteger(options.maximumResultBytes) || options.maximumResultBytes < 1) throw new Error('NOVA_REMOTE_RESULT_LIMIT_INVALID');
210:     this.#store = options.store; this.#evidence = options.evidence; this.#results = options.results;
211:     this.#maximumEvidenceBytes = options.maximumEvidenceBytes; this.#maximumResultBytes = options.maximumResultBytes;
212:   }
213:   async import(job: RemotePlanJobV1, status: RemotePlanStatusV1, signal?: AbortSignal): Promise<GateDecisionV1> {
214:     checkGateSignal(signal);
215:     validatePipelineTestGateContract('remotePlanJob', job);
216:     validatePipelineTestGateContract('remotePlanStatus', status);
217:     if (status.jobId !== job.jobId || status.requestDigest !== job.requestDigest
218:       || !['completed', 'failed', 'cancelled'].includes(status.state)) throw new Error('NOVA_REMOTE_IMPORT_STATUS_INVALID');
219:     const result = status.state === 'completed' && status.result
220:       ? await this.#results.result(job.jobId, status.result.contentDigest,
221:         Math.min(status.result.sizeBytes, this.#maximumResultBytes), signal)
222:       : null;
223:     checkGateSignal(signal);
224:     if (status.state === 'completed') {
225:       if (!result) throw new Error('NOVA_REMOTE_RESULT_MISSING');
226:       verifyCompletedResult(job, status, result);
227:     }
228:     const decision = decide(job, status, result);
229:     const source = artifacts(result);
230:     let total = 0;
231:     const evidence: Array<{ artifact: ArtifactRefV1; bytes: Buffer }> = [];
232:     for (const artifact of source) {
233:       checkGateSignal(signal);
234:       total += artifact.sizeBytes;
235:       if (!Number.isSafeInteger(total) || total > this.#maximumEvidenceBytes) throw new Error('NOVA_REMOTE_EVIDENCE_TOTAL_EXCEEDED');
236:       const bytes = await this.#evidence.evidence(
237:         job.jobId, artifact.contentDigest, Math.min(artifact.sizeBytes, this.#maximumEvidenceBytes - (total - artifact.sizeBytes)), signal,
238:       );
239:       if (bytes.byteLength !== artifact.sizeBytes
240:         || `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}` !== artifact.contentDigest) {
241:         throw new Error('NOVA_REMOTE_EVIDENCE_INVALID');
242:       }
243:       checkGateSignal(signal);
244:       evidence.push({ artifact, bytes });
245:     }
246:     checkGateSignal(signal);
247:     return this.#store.record(job, status, result, decision, evidence, signal);
248:   }
249: }
250: 
251: export interface RemotePlanTerminalDispatcher {
252:   dispatch(job: RemotePlanJobV1, options: { timeoutMs: number; signal?: AbortSignal }): Promise<RemotePlanStatusV1>;
253: }
254: 
255: export class NovaRemoteTestGate {
256:   readonly #dispatcher: RemotePlanTerminalDispatcher;
257:   readonly #importer: NovaRemoteGateImporter;
258:   constructor(options: { dispatcher: RemotePlanTerminalDispatcher; importer: NovaRemoteGateImporter }) {
259:     this.#dispatcher = options.dispatcher;
260:     this.#importer = options.importer;
261:   }
262:   async execute(job: RemotePlanJobV1, options: { timeoutMs: number; signal?: AbortSignal }): Promise<{
263:     status: RemotePlanStatusV1; decision: GateDecisionV1; stageResult: StageResult;
264:   }> {
265:     const deadline = new GateDeadline(options.timeoutMs, options.signal);
266:     try {
267:       deadline.check();
268:       const status = await this.#dispatcher.dispatch(job, { timeoutMs: deadline.remaining(), signal: deadline.signal });
269:       deadline.check();
270:       const decision = await this.#importer.import(job, status, deadline.signal).catch((error: unknown) => {
271:         deadline.check(); throw error;
272:       });
273:       deadline.check();
274:       return { status, decision, stageResult: gateDecisionStageResult(decision) };
275:     } finally { deadline.dispose(); }
276:   }
277: }
