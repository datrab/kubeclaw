   25     this.#remediationOnlyTargets = built.remediationOnly;
   26     this.#stages = new FrozenMap([...built.stages].sort(([left], [right]) => left.localeCompare(right)));
   27     this.#dependents = new FrozenMap([...built.dependents].sort(([left], [right]) => left.localeCompare(right)).map(([id, values]) => [id, Object.freeze([...values].sort())]));
   28     this.#ordinaryEdges = Object.freeze(built.ordinaryEdges.sort((left, right) => left.from.localeCompare(right.from) || left.to.localeCompare(right.to)));
