   21 
   22 function validateEvents(options: ObserverRuntimeOptions): Map<string, CanonicalEvent> {
   23   const events = new Map<string, CanonicalEvent>(); const sequence = new Map<string, number>();
   24   for (const { entry } of options.events.records()) {
   25     if (events.has(entry.eventId)) throw new Error(`OBSERVER_EVENT_ID_DUPLICATE:${entry.eventId}`);
   26     const prior = sequence.get(entry.identity.runId) ?? 0;
   27     if (entry.sequence <= prior) throw new Error(`OBSERVER_EVENT_ORDER_INVALID:${entry.identity.runId}:${entry.eventId}`);
   28     sequence.set(entry.identity.runId, entry.sequence); events.set(entry.eventId, entry);
   29   }
   30   return events;
   31 }
   32 
   33 function recoverCheckpoints(options: ObserverRuntimeOptions, events: ReadonlyMap<string, CanonicalEvent>): Map<string, ObserverCheckpoint> {
   34   const checkpoints = new Map<string, ObserverCheckpoint>();
   35   for (const { entry: checkpoint } of options.checkpoints.records()) {
   36     const observerId = globalId(checkpoint.observer.package.package.pluginId, checkpoint.observer.registrationId);
   37     const registration = options.registry.snapshot.observers.get(observerId);
   38     if (!registration || !options.registry.grants.has(observerId)) throw new Error(`OBSERVER_CHECKPOINT_OWNER_INVALID:${observerId}`);
   39     if (checkpoint.observer.package.package.contentDigest !== registration.provenance.package.package.contentDigest
   40       || checkpoint.observer.package.package.packageVersion !== registration.provenance.package.package.packageVersion) throw new Error(`OBSERVER_CHECKPOINT_PROVENANCE_MISMATCH:${observerId}`);
   41     if (typeof checkpoint.eventId !== 'string') throw new Error(`OBSERVER_CHECKPOINT_EVENT_INVALID:${observerId}:<missing>`);
   42     const event = events.get(checkpoint.eventId);
   43     assertCheckpointEvent(observerId, checkpoint, event, registration.registration.subscriptions);
   44     const key = checkpointKey(observerId, checkpoint.runId); const current = checkpoints.get(key);
   45     if (current && checkpoint.sequence < current.sequence) throw new Error(`OBSERVER_CHECKPOINT_REGRESSION:${observerId}:${checkpoint.runId}`);
   46     if (current && checkpoint.sequence === current.sequence && checkpoint.eventId !== current.eventId) throw new Error(`OBSERVER_CHECKPOINT_CONFLICT:${observerId}:${checkpoint.runId}`);
   47     if (!current || checkpoint.sequence > current.sequence) checkpoints.set(key, checkpoint);
   48   }
   49   return checkpoints;
   50 }
   51 
   52 function assertCheckpointEvent(observerId: string, checkpoint: ObserverCheckpoint, event: CanonicalEvent | undefined, subscriptions: readonly string[]): void {
   53   if (!event || event.identity.runId !== checkpoint.runId || event.sequence !== checkpoint.sequence || !subscriptions.includes(event.type)) {
   54     throw new Error(`OBSERVER_CHECKPOINT_EVENT_INVALID:${observerId}:${String(checkpoint.eventId)}`);
   55   }
   56 }
   57 
   58 function validDelivery(options: ObserverRuntimeOptions, events: ReadonlyMap<string, CanonicalEvent>, delivery: ObserverDeliveryRecord): boolean {
   59   const registration = options.registry.snapshot.observers.get(delivery.observerId); const event = events.get(delivery.eventId);
   60   return delivery.schemaVersion === 'observer-delivery-record.v2' && delivery.deliveryId === `delivery:${delivery.observerId}:${delivery.eventId}`
   61     && Boolean(registration) && options.registry.grants.has(delivery.observerId) && Boolean(event) && event!.identity.runId === delivery.runId
