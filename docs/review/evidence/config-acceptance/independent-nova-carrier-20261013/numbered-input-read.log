PATH skills/nova/core/state/json-value.ts SHA256 c99b7a8c16e3c8c6860e7e469d9feb454448fab311f8d5f7bbf6dd690e59a58b
    1 import { types } from 'node:util';
    2 
    3 type CopyTask = { input: unknown; target: object; key: string };
    4 type Task = CopyTask | { finish: object; source: object };
    5 
    6 function objectProperties(input: object, output: object, array: boolean): CopyTask[] {
    7   const properties: CopyTask[] = [];
    8   for (const key of Reflect.ownKeys(input)) {
    9     if (array && key === 'length') continue;
   10     const property = Object.getOwnPropertyDescriptor(input, key)!;
   11     if (typeof key !== 'string' || !property.enumerable || !('value' in property)) throw new Error('JOURNAL_VALUE_NOT_JSON');
   12     if (array && (!/^(0|[1-9]\d*)$/.test(key) || Number(key) >= (input as unknown[]).length)) throw new Error('JOURNAL_VALUE_NOT_JSON');
   13     if (!array && property.value === undefined) continue;
   14     properties.push({ input: property.value, target: output, key });
   15   }
   16   if (array && properties.length !== (input as unknown[]).length) throw new Error('JOURNAL_VALUE_NOT_JSON');
   17   return properties;
   18 }
   19 
   20 function copyObject(input: unknown, ancestors: Set<object>, pending: Task[]): object {
   21   if (typeof input !== 'object' || input === null || types.isProxy(input)) throw new Error('JOURNAL_VALUE_NOT_JSON');
   22   if (ancestors.has(input)) throw new Error('JOURNAL_VALUE_CIRCULAR');
   23   const array = Array.isArray(input);
   24   const prototype = Object.getPrototypeOf(input);
   25   if (!array && prototype !== Object.prototype && prototype !== null) throw new Error('JOURNAL_VALUE_NOT_JSON');
   26   const output: object = array ? [] : {};
   27   const properties = objectProperties(input, output, array);
   28   ancestors.add(input);
   29   pending.push({ finish: output, source: input });
   30   // Reverse work order so object key insertion order and journal hashes stay stable.
   31   for (let index = properties.length - 1; index >= 0; index--) pending.push(properties[index]!);
   32   return output;
   33 }
   34 
   35 /** Own an immutable JSON snapshot, without invoking caller serialization hooks.
   36  * Undefined object properties are omitted, preserving optional-field behavior.
   37  */
   38 export function snapshotJson<T>(value: T): T {
   39   const ancestors = new Set<object>();
   40   const root: { value?: unknown } = {};
   41   const pending: Task[] = [{ input: value, target: root, key: 'value' }];
   42   while (pending.length) {
   43     const task = pending.pop()!;
   44     if ('finish' in task) { Object.freeze(task.finish); ancestors.delete(task.source); continue; }
   45     const { input, target, key } = task;
   46     let result: unknown;
   47     if (input === null || typeof input === 'string' || typeof input === 'boolean') result = input;
   48     else if (typeof input === 'number' && Number.isFinite(input)) result = Object.is(input, -0) ? 0 : input;
   49     else result = copyObject(input, ancestors, pending);
   50     Object.defineProperty(target, key, { value: result, enumerable: true, writable: true, configurable: true });
   51   }
   52   return root.value as T;
   53 }

PATH skills/common/plugin-runtime/foundation/observability/hash-journal.ts SHA256 b00c2271bb662055d7250ca193f842d1e6346edf22dfa713b33df1b637ce957a
    1 import {createHash} from 'node:crypto';
    2 
    3 export interface HashJournalRecord<T> {
    4   readonly sequence: number;
    5   readonly previousHash: string | null;
    6   readonly hash: string;
    7   readonly entry: T;
    8 }
    9 
   10 /** The original append-journal wire hash. Parsing does not repair or write. */
   11 export function hashJournalRecord(sequence:number, previousHash:string|null, entry:unknown):string {
   12   return `sha256:${createHash('sha256').update(JSON.stringify({sequence,previousHash,entry})).digest('hex')}`;
   13 }
   14 
   15 export function parseHashJournal<T>(buffer:Buffer, file:string, precedingSequence=0, precedingHash:string|null=null):HashJournalRecord<T>[] {
   16   if (!buffer.length) return [];
   17   const text=buffer.toString('utf8');
   18   if(!text.endsWith('\n'))throw new Error(`JOURNAL_RECORD_INCOMPLETE:${file}`);
   19   const records:HashJournalRecord<T>[]=[];
   20   for(const line of text.slice(0,-1).split('\n')) {
   21     const sequence=precedingSequence+records.length+1;
   22     if(!line.length)throw new Error(`JOURNAL_RECORD_EMPTY:${file}:${sequence}`);
   23     const record=JSON.parse(line) as HashJournalRecord<T>;
   24     const previousHash=records.at(-1)?.hash??precedingHash;
   25     if(record.sequence!==sequence || record.previousHash!==previousHash)throw new Error(`JOURNAL_CHAIN_INVALID:${file}:${sequence}`);
   26     if(record.hash!==hashJournalRecord(sequence,previousHash,record.entry))throw new Error(`JOURNAL_HASH_INVALID:${file}:${sequence}`);
   27     records.push(record);
   28   }
   29   return records;
   30 }

PATH skills/nova/core/effects/locks.ts SHA256 7ca675286800ee88314919f7c0d524c7b5cde99928b9e93c8036e566ecc4b793
    1 import crypto from 'node:crypto';
    2 import fs from 'node:fs';
    3 import path from 'node:path';
    4 import type { ResourceLock } from '@kubeclaw/plugin-sdk';
    5 import { FileJournal } from '../state/journal.ts';
    6 import { FileMutex } from '../state/file-mutex.ts';
    7 
    8 interface LockOwner {
    9   readonly pid: number;
   10   readonly contract: ResourceLock;
   11 }
   12 
   13 function isLockOwner(value: unknown): value is LockOwner {
   14   if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
   15   const candidate = value as { pid?: unknown; contract?: unknown };
   16   if (!Number.isSafeInteger(candidate.pid) || Number(candidate.pid) < 1) return false;
   17   if (!candidate.contract || typeof candidate.contract !== 'object' || Array.isArray(candidate.contract)) {
   18     return false;
   19   }
   20   const contract = candidate.contract as Partial<ResourceLock>;
   21   return [contract.schemaVersion === 'resource-lock.v2', typeof contract.lockId === 'string',
   22     typeof contract.ownerLeaseId === 'string', typeof contract.expiresAt === 'string' && Number.isFinite(Date.parse(contract.expiresAt)),
   23     Number.isSafeInteger(contract.fencingToken) && contract.fencingToken! >= 1, contract.status === 'active',
   24     Boolean(contract.resource), typeof contract.resource?.type === 'string', typeof contract.resource?.canonicalId === 'string'].every(Boolean);
   25 }
   26 
   27 function processAlive(pid: number): boolean {
   28   try {
   29     process.kill(pid, 0);
   30     return true;
   31   } catch (error) {
   32     return (error as NodeJS.ErrnoException).code === 'EPERM';
   33   }
   34 }
   35 
   36 function resourceKey(resource: ResourceLock['resource']): string {
   37   return crypto.createHash('sha256')
   38     .update(`${resource.type}\u0000${resource.canonicalId}`)
   39     .digest('hex');
   40 }
   41 
   42 export class FileResourceLockManager {
   43   readonly #root: string;
   44   readonly #journal: FileJournal<ResourceLock>;
   45   readonly #now: () => Date;
   46   readonly #provisionalTtlMs = 60_000;
   47   readonly #metadataMutex: FileMutex;
   48 
   49   constructor(root: string, now: () => Date = () => new Date()) {
   50     this.#root = path.resolve(root);
   51     this.#now = now;
   52     fs.mkdirSync(this.#root, { recursive: true });
   53     this.#journal = new FileJournal(path.join(this.#root, 'locks.jsonl'));
   54     this.#metadataMutex = new FileMutex(path.join(this.#root, 'metadata.guard'), 5_000, 'RESOURCE_LOCK_METADATA_TIMEOUT');
   55   }
   56 
   57   acquire(
   58     resource: ResourceLock['resource'],
   59     ownerLeaseId: string,
   60     ttlMs: number,
   61   ): ResourceLock {
   62     return this.#metadataMutex.withLock(
   63       () => this.#acquire(resource, ownerLeaseId, ttlMs),
   64     );
   65   }
   66 
   67   #acquire(
   68     resource: ResourceLock['resource'],
   69     ownerLeaseId: string,
   70     ttlMs: number,
   71   ): ResourceLock {
   72     if (!Number.isSafeInteger(ttlMs) || ttlMs < 1) throw new Error('RESOURCE_LOCK_TTL_INVALID');
   73     const key = resourceKey(resource);
   74     const lockDirectory = path.join(this.#root, `${key}.active`);
   75     const ownerFile = path.join(lockDirectory, 'owner.json');
   76     const claimFile = path.join(lockDirectory, 'claim.json');
   77     const claimToken = crypto.randomUUID();
   78     this.#claim(resource, ownerLeaseId, lockDirectory, ownerFile, claimFile, claimToken);
   79     try { return this.#commitClaim(resource, ownerLeaseId, ttlMs, ownerFile); }
   80     catch (error) { this.#cleanupClaim(lockDirectory, claimFile, claimToken); throw error; }
   81   }
   82 
   83   #claim(resource: ResourceLock['resource'], ownerLeaseId: string, lockDirectory: string, ownerFile: string, claimFile: string, claimToken: string): void {
   84     for (;;) {
   85       try {
   86         fs.mkdirSync(lockDirectory);
   87         fs.writeFileSync(claimFile, `${JSON.stringify({ token: claimToken, pid: process.pid })}\n`, { flag: 'wx', mode: 0o600 });
   88         return;
   89       } catch (error) {
   90         if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
   91         const owner = this.#owner(ownerFile);
   92         if (!owner && this.#now().getTime() - fs.statSync(lockDirectory).mtimeMs < this.#provisionalTtlMs) throw new Error(`RESOURCE_LOCK_PROVISIONING:${resource.canonicalId}`);
   93         this.#assertOwnerAvailable(owner, ownerLeaseId, resource.canonicalId);
   94         if (!this.#expire(lockDirectory, owner)) continue;
   95       }
   96     }
   97   }
   98 
   99   #assertOwnerAvailable(owner: LockOwner | undefined, ownerLeaseId: string, resourceId: string): void {
  100     if (!owner || !processAlive(owner.pid)) return;
  101     if (owner.contract.ownerLeaseId === ownerLeaseId) throw new Error(`RESOURCE_LOCK_REENTRANT_DENIED:${resourceId}`);
  102     throw new Error(`RESOURCE_LOCKED:${resourceId}`);
  103   }
  104 
  105   #owner(ownerFile: string): LockOwner | undefined {
  106     try { const parsed = JSON.parse(fs.readFileSync(ownerFile, 'utf8')) as unknown; return isLockOwner(parsed) ? parsed : undefined; }
  107     catch {
  108       // INTENTIONAL_NONCRITICAL(invalid_lock_metadata): Missing or torn owner metadata is treated as absent.
  109       return undefined;
  110     }
  111   }
  112 
  113   #expire(lockDirectory: string, owner: LockOwner | undefined): boolean {
  114     const tombstone = `${lockDirectory}.expired-${crypto.randomUUID()}`;
  115     try { fs.renameSync(lockDirectory, tombstone); }
  116     catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false; throw error; }
  117     try { if (owner) this.#journal.append(Object.freeze({ ...owner.contract, status: 'expired' })); }
  118     finally { fs.rmSync(tombstone, { recursive: true, force: true }); }
  119     return true;
  120   }
  121 
  122   #commitClaim(resource: ResourceLock['resource'], ownerLeaseId: string, ttlMs: number, ownerFile: string): ResourceLock {
  123     const prior = [...this.#journal.refresh()].reverse()
  124       .find(({ entry }) => entry.resource.type === resource.type
  125         && entry.resource.canonicalId === resource.canonicalId);
  126     const fencingToken = (prior?.entry.fencingToken ?? 0) + 1;
  127     const now = this.#now();
  128     const contract: ResourceLock = Object.freeze({
  129       schemaVersion: 'resource-lock.v2',
  130       lockId: `lock:${crypto.randomUUID()}`,
  131       resource,
  132       ownerLeaseId,
  133       fencingToken,
  134       status: 'active',
  135       acquiredAt: now.toISOString(),
  136       expiresAt: new Date(now.getTime() + ttlMs).toISOString(),
  137     });
  138     fs.writeFileSync(
  139       ownerFile,
  140       `${JSON.stringify({ pid: process.pid, contract } satisfies LockOwner)}\n`,
  141       { flag: 'wx', mode: 0o600 },
  142     );
  143     this.#journal.append(contract);
  144     return contract;
  145   }
  146 
  147   #cleanupClaim(lockDirectory: string, claimFile: string, token: string): void {
  148     try {
  149       const claim = JSON.parse(fs.readFileSync(claimFile, 'utf8')) as { token?: unknown };
  150       if (claim.token !== token) return;
  151       const tombstone = `${lockDirectory}.failed-${token}`; fs.renameSync(lockDirectory, tombstone); fs.rmSync(tombstone, { recursive: true, force: true });
  152     } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
  153   }
  154 
  155   renew(lockId: string, ownerLeaseId: string, ttlMs: number): ResourceLock {
  156     return this.#metadataMutex.withLock(() => this.#renew(lockId, ownerLeaseId, ttlMs));
  157   }
  158 
  159   #renew(lockId: string, ownerLeaseId: string, ttlMs: number): ResourceLock {
  160     if (!Number.isSafeInteger(ttlMs) || ttlMs < 1) throw new Error('RESOURCE_LOCK_TTL_INVALID');
  161     const active = [...this.#journal.refresh()].reverse()
  162       .find(({ entry }) => entry.lockId === lockId)?.entry;
  163     if (!active) throw new Error(`RESOURCE_LOCK_UNKNOWN:${lockId}`);
  164     if (active.ownerLeaseId !== ownerLeaseId) throw new Error(`RESOURCE_LOCK_OWNER_DENIED:${lockId}`);
  165     const lockDirectory = path.join(this.#root, `${resourceKey(active.resource)}.active`);
  166     const ownerFile = path.join(lockDirectory, 'owner.json');
  167     const owner = JSON.parse(fs.readFileSync(ownerFile, 'utf8')) as LockOwner;
  168     if (owner.contract.lockId !== lockId) throw new Error(`RESOURCE_LOCK_FENCED:${lockId}`);
  169     const renewed: ResourceLock = Object.freeze({
  170       ...active,
  171       status: 'active',
  172       expiresAt: new Date(this.#now().getTime() + ttlMs).toISOString(),
  173     });
  174     const temporary = path.join(lockDirectory, `owner.${crypto.randomUUID()}.tmp`);
  175     fs.writeFileSync(
  176       temporary,
  177       `${JSON.stringify({ pid: process.pid, contract: renewed } satisfies LockOwner)}\n`,
  178       { flag: 'wx', mode: 0o600 },
  179     );
  180     fs.renameSync(temporary, ownerFile);
  181     this.#journal.append(renewed);
  182     return renewed;
  183   }
  184 
  185   release(lockId: string, ownerLeaseId: string): ResourceLock {
  186     return this.#metadataMutex.withLock(() => this.#release(lockId, ownerLeaseId));
  187   }
  188 
  189   assertCurrent(lockId: string, ownerLeaseId: string): ResourceLock {
  190     return this.#metadataMutex.withLock(() => {
  191       const active = [...this.#journal.refresh()].reverse()
  192         .find(({ entry }) => entry.lockId === lockId)?.entry;
  193       if (!active) throw new Error(`RESOURCE_LOCK_UNKNOWN:${lockId}`);
  194       if (active.ownerLeaseId !== ownerLeaseId) {
  195         throw new Error(`RESOURCE_LOCK_OWNER_DENIED:${lockId}`);
  196       }
  197       if (active.status !== 'active' || Date.parse(active.expiresAt) <= this.#now().getTime()) {
  198         throw new Error(`RESOURCE_LOCK_EXPIRED:${lockId}`);
  199       }
  200       const ownerFile = path.join(
  201         this.#root,
  202         `${resourceKey(active.resource)}.active`,
  203         'owner.json',
  204       );
  205       const owner = JSON.parse(fs.readFileSync(ownerFile, 'utf8')) as unknown;
  206       if (!isLockOwner(owner) || owner.contract.lockId !== lockId) {
  207         throw new Error(`RESOURCE_LOCK_FENCED:${lockId}`);
  208       }
  209       return active;
  210     });
  211   }
  212 
  213   #release(lockId: string, ownerLeaseId: string): ResourceLock {
  214     const active = [...this.#journal.refresh()].reverse()
  215       .find(({ entry }) => entry.lockId === lockId)?.entry;
  216     if (!active) throw new Error(`RESOURCE_LOCK_UNKNOWN:${lockId}`);
  217     if (active.ownerLeaseId !== ownerLeaseId) throw new Error(`RESOURCE_LOCK_OWNER_DENIED:${lockId}`);
  218     if (active.status !== 'active') return active;
  219     const lockDirectory = path.join(this.#root, `${resourceKey(active.resource)}.active`);
  220     const ownerFile = path.join(lockDirectory, 'owner.json');
  221     const current = JSON.parse(fs.readFileSync(ownerFile, 'utf8')) as LockOwner;
  222     if (current.contract.lockId !== lockId) throw new Error(`RESOURCE_LOCK_FENCED:${lockId}`);
  223     const released: ResourceLock = Object.freeze({
  224       ...active,
  225       status: 'released',
  226       releasedAt: this.#now().toISOString(),
  227     });
  228     this.#journal.append(released);
  229     const tombstone = `${lockDirectory}.released-${crypto.randomUUID()}`;
  230     fs.renameSync(lockDirectory, tombstone);
  231     fs.rmSync(tombstone, { recursive: true, force: true });
  232     return released;
  233   }
  234 }

