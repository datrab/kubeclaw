   41     if (!Number.isInteger(maxConcurrency) || maxConcurrency < 1) throw new Error('GRAPH_CONCURRENCY_INVALID');
   42     if (!['execution-graph-snapshot.v2', 'execution-graph-snapshot.v3'].includes(version)) throw new Error('GRAPH_SNAPSHOT_VERSION_INVALID');
   43     const portable = version === 'execution-graph-snapshot.v3';
