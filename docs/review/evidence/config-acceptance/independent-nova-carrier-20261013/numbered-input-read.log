   66 function validTransition(delivery: ObserverDeliveryRecord, prior: ObserverDeliveryRecord['status'] | undefined): boolean {
   67   return !((delivery.status === 'started' && prior !== undefined) || (delivery.status !== 'started' && prior !== 'started')
   68     || (delivery.status !== 'failed' && delivery.error !== null) || (delivery.status === 'failed' && typeof delivery.error !== 'string'));
   69 }
   70 
   71 function recoverDeliveries(options: ObserverRuntimeOptions, events: ReadonlyMap<string, CanonicalEvent>): Pick<ObserverRecovery, 'attempts' | 'completed'> {
   72   const completed = new Set<string>();
   73   const attempts = new Map<string, number>(); const states = new Map<string, ObserverDeliveryRecord['status']>();
   74   for (const { entry: delivery } of options.deliveries.records()) {
   75     if (!validDelivery(options, events, delivery)) throw new Error(`OBSERVER_DELIVERY_RECORD_INVALID:${delivery.observerId}:${delivery.eventId}`);
   76     const key = attemptKey(delivery.observerId, delivery.eventId, delivery.attemptNumber); const prior = states.get(key);
   77     if (!validTransition(delivery, prior)) throw new Error(`OBSERVER_DELIVERY_TRANSITION_INVALID:${delivery.observerId}:${delivery.eventId}:${delivery.attemptNumber}`);
   78     states.set(key, delivery.status); const deliveryIdentity = deliveryKey(delivery.observerId, delivery.eventId);
   79     attempts.set(deliveryIdentity, Math.max(attempts.get(deliveryIdentity) ?? 0, delivery.attemptNumber));
   80     if (delivery.status === 'completed') completed.add(deliveryIdentity);
   81   }
   82   return { attempts, completed };
