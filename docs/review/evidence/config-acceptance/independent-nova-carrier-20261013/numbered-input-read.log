PATH skills/nova/core/execution/run-mutation.ts SHA256 9acd2187077eca9fed18bb73b512cbda72aead9be9d92083438af5305cd7092d
    1 import crypto from 'node:crypto';
    2 import fs from 'node:fs';
    3 import path from 'node:path';
    4 import { FileResourceLockManager } from '../effects/locks.ts';
    5 
    6 const active = new Set<string>();
    7 export async function withRunMutationLock<T>(runRoot: string, operation: (signal: AbortSignal) => Promise<T>): Promise<T> {
    8   const key = path.resolve(runRoot); if (active.has(key)) throw new Error(`PIPELINE_RUN_MUTATION_LOCKED:${key}`); active.add(key);
    9   let locks: FileResourceLockManager | undefined; let owner: string | undefined;
   10   let lock: ReturnType<FileResourceLockManager['acquire']> | undefined; let renewal: NodeJS.Timeout | undefined;
   11   let renewalError: unknown; const controller = new AbortController();
   12   try {
   13     fs.mkdirSync(path.dirname(key), { recursive: true }); locks = new FileResourceLockManager(path.join(path.dirname(key), '.run-mutation-locks'));
   14     owner = `mutation:${process.pid}:${crypto.randomUUID()}`; lock = locks.acquire({ type: 'pipeline.run', canonicalId: key }, owner, 60_000);
   15     renewal = setInterval(() => { try { lock = locks!.renew(lock!.lockId, owner!, 60_000); } catch (error) { renewalError = error; controller.abort(error); } }, 20_000); renewal.unref();
   16     const result = await operation(controller.signal); if (renewalError) throw renewalError; return result;
   17   } finally {
   18     if (renewal) clearInterval(renewal);
   19     try { if (locks && lock && owner) locks.release(lock.lockId, owner); } finally { active.delete(key); }
   20   }
   21 }

PATH skills/nova/core/state/file-mutex.ts SHA256 d6d347d6b615796ff761c0c608ed6a4d9f4f834bea92ddd2870d2312b5d04c7c
    1 import fs from 'node:fs';
    2 import { spawnSync } from 'node:child_process';
    3 
    4 /** Synchronous, non-reentrant Linux flock over a stable inode. Never unlink it. */
    5 export class FileMutex {
    6   readonly #file: string; readonly #timeoutMs: number; readonly #timeoutCode: string;
    7   constructor(file: string, timeoutMs: number, timeoutCode: string) { this.#file = file; this.#timeoutMs = timeoutMs; this.#timeoutCode = timeoutCode; }
    8   withLock<T>(operation: () => T): T {
    9     const descriptor = fs.openSync(this.#file, 'a', 0o600);
   10     try {
   11       // fd 3 shares the parent's open file description. The kernel lock remains
   12       // held after flock exits and is released when the parent closes its fd.
   13       const acquired = spawnSync('/usr/bin/flock', ['--exclusive', '--timeout', String(this.#timeoutMs / 1000), '--conflict-exit-code', '75', '3'], {
   14         stdio: ['ignore', 'ignore', 'pipe', descriptor],
   15       });
