   13 export interface ExecutionGraphSnapshot {
   14   readonly schemaVersion: 'execution-graph-snapshot.v2' | 'execution-graph-snapshot.v3'; readonly pipelineId: string; readonly maxConcurrency: number;
   15   readonly nodes: readonly StageDefinition[]; readonly ordinaryEdges: readonly Readonly<{ readonly from: string; readonly to: string }>[];
   16   readonly remediationEdges: readonly Readonly<{ readonly from: string; readonly to: string }>[]; readonly digest: string;
   17 }
   18 
   19 export class ExecutionGraph {
   20   readonly #stages: ReadonlyMap<string, StageDefinition>; readonly #dependents: ReadonlyMap<string, readonly string[]>;
   21   readonly #ordinaryEdges: ExecutionGraphSnapshot['ordinaryEdges']; readonly #remediationEdges: ExecutionGraphSnapshot['remediationEdges'];
   22   readonly #remediationOnlyTargets: ReadonlySet<string>;
   23   constructor(stages: readonly StageDefinition[]) {
