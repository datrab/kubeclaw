   44   const execution = { maxAttempts: 2, maxRemediationCycles: 0, maxTechnicalRetries: 1, timeoutMs: 1_800_000 };
   45   const stages: StageDefinition[] = [{ id: 'final-lint', type: 'kubeclaw.lint.full',
   46     dependsOn: modules.map(module => `test-${module.id}`), config: final.lint,
   47     input: { workingDirectory: project.repositoryRoot, project: project.id, sourceStageId }, execution }];
   48   if (final.review) stages.push({ id: 'final-review', type: 'kubeclaw.decision.review', dependsOn: ['final-lint'],
   49     config: projectReviewConfig(final.review, reportArtifactEncoding, reviewSemanticMode),
