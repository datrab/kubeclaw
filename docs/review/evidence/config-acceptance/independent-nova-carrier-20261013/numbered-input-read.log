
PATH docs/review/evidence/config-acceptance/author/NOVA-MODULE-CARRIER-PROPOSAL-20261013.md SHA256 293416f321fc421d62401aa872b538530b0fcb4a8b253fc564bcdf68d122b1f8
    1 # Nova module membership and persistence seam — bounded C0 proposal
    2 
    3 **Unaccepted, incomplete definition proposal. No C1/C5 implementation.** Read with
    4 [the source constraints](NOVA-MODULE-BINDING-CONSTRAINTS-20261013.md). This document
    5 narrows membership and first-acceptance persistence; it does not supply unresolved
    6 owner-domain, payload/quota, external profile or grant contracts.
    7 
    8 ## Membership must come from the real producer
    9 
   10 | Current producer | Exact stage membership | Proposed acceptance unit |
   11 |---|---|---|
   12 | `project/compiler.ts::moduleStages` | `implement-${module.id}`, `lint-${module.id}`, optional `review-${module.id}`, `test-${module.id}`; lint/review/test `request_fix` targets that same implementation | One implementation module, including technical retries, category repairs, rechecks and original cleanup |
   13 | `project/source.ts::sourceStages` | `source-preflight`, optional `architecture-review` and `architecture-approval`, `blueprint-sync` | Run-foundation admission group, not permission to reselect graph/architecture foundations mid-run |
   14 | `project/coverage.ts::cumulativeStages` | `final-lint`, optional `final-review`, `final-test`, `project-summary` | Separate integrated final group; references original completed module evidence, cannot rebind those modules |
   15 | `project/demo.ts::demoStages` | Optional `demo-candidate`, `demo-delivery`, `demo-ready` | Separate delivery group, retaining the original final-test fixture/credential/exposure dependency closure |
   16 | Explicit `pipeline-definition.v2` graph | Arbitrary registered stage IDs/types and remediation links | Requires authored/validated exact membership; stage-name prefixes never constitute membership |
   17 
   18 The project compiler currently returns only a `pipeline-definition.v2` graph,
   19 not this membership declaration. A future compiler-generated immutable record
   20 must enumerate actual stage IDs, remediation links, group kind and task-intent
   21 digest, and validate every executable stage against exactly one group. A graph
   22 with cross-group remediation must either supply an explicit compatible original
   23 relationship or reject before activation; it cannot infer ownership from a name.
   24 Run-scoped adapters remain R-scoped even when observing M-scoped stages. Standalone
   25 Prism and Buster units require their separately defined order/plan memberships.
   26 
   27 ## Exact existing persistence constraints
   28 
   29 The current run event carrier is `<runRoot>/events.jsonl`, constructed by
   30 `engine-run.ts` and passed to `PipelineRunner`. `FileJournal.transact` takes an
   31 append mutex, refreshes committed records and fsyncs each appended JSON line.
   32 It is **synchronous exclusion, not a rollback transaction**. If a callback appends
   33 one record then throws, that record persists. An unterminated tail is truncated
   34 on reopening; complete records are hash-verified by the existing hash-journal
   35 parser. Escaped append callbacks reject after transaction closure.
   36 
   37 [The real local reader/writer check](check-nova-journal-binding-seam.mjs) exercised
   38 seven narrow controls, with [raw output](nova-journal-binding-seam-attempt1-20261013.log).
   39 Two journal objects refreshed/deduplicated one specimen, but this is not a
   40 multi-process contention or process-kill proof. The specimen is deliberately not
   41 a current SDK lifecycle event. No new event is accepted by current production.
   42 
   43 ## Proposed generated carrier and order
   44 
   45 Propose one versioned `module.binding.accepted` entry in the **existing run event
   46 journal**, using an explicitly evolved SDK event contract rather than a second
   47 editable config index or a side-channel observer event. Its required typed
   48 content is: run ID, exact group ID/kind, membership digest, run-foundation digest,
   49 immutable selected generation/owner-instance-profile identities, field
   50 applicability-map identity, effective consumer-profile closure, delivery/code/role
   51 identities, original grant/secret-reference/store/quota identities, original
   52 budget-ledger references, fixed-Eval mode/identity, canonical encoding identity
   53 and digest of the complete unsigned binding. No secret values are included.
   54 
   55 This field list is a **proposed required contract**, not a permissive schema and
   56 not a claim that referenced manifests currently exist. Exact external references,
   57 payload shape/bounds and schema producer/readers must be resolved before acceptance.
   58 The current graph captures full copied stage config/execution/input; its existing
   59 v2/v3/v4 snapshots must not be silently reinterpreted as task-only graphs. A new
   60 snapshot/graph representation requires reviewed task/operator partition maps,
   61 versioned codec and legacy dispatch before selecting a version number.
   62 
   63 Proposed first acceptance uses the existing run-mutation exclusion and the
   64 journal's synchronous `transact(records, append)`:
   65 
   66 1. Resolve an immutable candidate generation from the sole system entry. Read,
   67    parse, strictly validate and fully materialize outside the journal callback;
   68    no package activation, observer delivery, business action or async work in it.
   69 2. Validate exact membership, original run foundations, retained R/S/H dependencies,
   70    role/grant/secret references, physical delivery and budget/store compatibility.
   71    Validate the complete encoded carrier and its original accounting limits before
   72    append. The metadata/store accounting contract remains an explicit open input.
   73 3. Under the run lock and synchronized journal transaction, reject inconsistent
   74    existing membership/history; if an original binding already exists, return it
   75    without selecting B. Otherwise append **one complete** binding record. No
   76    partial binding followed by a second commit record and no `await` in callback.
   77 4. Only after the durable append returns, publish the corresponding observer view,
   78    then permit the first stage transition, executor/effect or skip notification of
   79    that group. A crash after binding but before `stage.started` retains that binding.
   80 5. All retries/repairs/waits/cleanup resolve the original journal binding; absence
   81    after any prior business action blocks for reconciliation, never latest/default.
   82 
   83 Ordinary next-module publication can change only validated M-applicable values.
   84 Started A remains A; a genuinely unstarted second group may accept B. Final/demo
   85 groups retain original resource dependencies and cannot use their later start to
   86 replace grants or fixture provenance. Fixed Eval resolves the recorded explicit
   87 generation. Counters/claims/deadlines/uncertain effects and historical task intent
   88 are preserved, not recreated from the selected profile.
   89 
   90 ## Still open, not waived by this proposal
   91 
   92 - Exact strict schema, canonical member/effective-profile partition and compatible
   93   snapshot evolution, including explicit arbitrary-graph memberships.
   94 - Complete per-owner scope maps and real immutable manifest materialization,
   95   metadata/store/physical accounting, authentic grants and external profile data.
   96 - Compatibility before `prepareRuntime` activation, original recovery lookup and
   97   administrative-version transitions at all actual run/resume/repair paths.
   98 - Concrete executable future cases with complete profiles, hashes and commands for
   99   concurrency, process-kill windows, stage skips, malformed history, fixed Eval,
  100   next-module B, incompatible R/H and original cleanup across every reader.
  101 - Independent definition review and ultimately whole C0 acceptance. Seven current
  102   journal controls do not satisfy those future cases or global F-BIND.

PATH docs/review/evidence/config-acceptance/author/NOVA-MODULE-BINDING-CONSTRAINTS-20261013.md SHA256 e71981f37555bcb12644ee3e7c15d42389fba510868fe9d5fce976e29e737038
    1 # Nova module binding: source constraints and unresolved target carrier
    2 
    3 **Not an accepted universal binding/grant/cleanup contract.** This document records
    4 the consequences of the [primary-source map](nova-current-binding-seam-map-20261013.json)
    5 for D20/D21. No production code, SDK contract, lifecycle event or new config index
    6 has been implemented. These unresolved contracts cannot be supplied to another
    7 owner as an independently accepted alias merely by assigning an ID.
    8 
    9 ## Existing bindings must be preserved
   10 
   11 `writeRunSnapshots` already publishes a no-replace, fsynced `run-snapshot.v4` with
   12 the whole graph and registry. The graph includes full StageDefinition configs,
   13 input and execution policy, not only dependencies. Recovery checks the original
   14 configuration, package identities and graph digest. Explicit administrative
   15 decisions/package upgrades are distinct from ordinary profile publication.
   16 SDK runtime dispatch/review cache profiles and historical snapshot encodings are
   17 protocol identities, not tuning selectors. A target must neither mutate that old
   18 graph in place nor claim current binding is universally absent.
   19 
   20 Current `prepareRuntime` activates registry packages before the run lock and
   21 before recovery checks the original snapshot. Therefore the target original
   22 generation must be resolved and its foundations/delivery verified before any
   23 incompatible activation, not merely checked afterward. Source inspection alone
   24 does not prove which package activations currently perform external effects.
   25 
   26 ## First business-module acceptance, not every stage/retry
   27 
   28 The compiler emits implementation, lint, optional review and test stages for one
   29 logical module. The loop persists `stage.started` before flushing observers and
   30 calling the executor. That event is per stage/attempt and carries no current typed
   31 module generation closure. Do not infer module membership only from stage-name
   32 prefixes or treat every repair/retry/test stage as a new module start.
   33 
   34 A concrete target must define a compiler-generated immutable membership record
   35 linking each exact module/gate to its exact member stages and original task intent,
   36 tied to the graph. It must define one original binding **before the first stage
   37 start/observer flush or other business action of that group**. A crash after
   38 binding but before the first stage event must still retain that binding; later
   39 lint/review/tests, repairs, retries, cleanup and reconciliation cannot select B.
   40 Actual carrier/schema/hash/transaction boundaries remain to be completed.
   41 
   42 ## D20 dynamic selection without changing foundations
   43 
   44 Before a not-yet-started module, resolve one newly published complete owner
   45 generation from the sole system entry. Settings stay at their component authors;
   46 the entry is not a second copy. Validate owner, instance, profile, schema, delivery,
   47 real consumer scopes and compatibility with the run's original graph/permissions
   48 and actual runtime instance before accepting work. Incompatible new selection
   49 rejects explicitly; it does not silently fall back to A, regrant permissions or
   50 repurpose an SDK codec/profile field.
   51 
   52 Graph task intent, grants and recovery foundations remain original; field-specific
   53 M/J/R/S/H scope matters. R/S/H policy changes cannot become arbitrary M tuning.
   54 Fixed Eval resolves a specified immutable generation, not the current publication.
   55 New selection never resets consumed budgets, clears uncertain outcomes, invents an
   56 administrative override or changes recorded historical acceptance.
   57 
   58 The current graph pins copied operator values alongside task input. A target must
   59 **explicitly** justify the new task/operator separation and graph/snapshot carrier
   60 evolution, with exact schema/producers/readers and legacy rules. Merely placing a
   61 profile reference in a file does not resolve this incompatibility. No snapshot
   62 version is selected or silently reinterpreted by this constraints document.
   63 
   64 ## Original cleanup and grants
   65 
   66 Every actual worker/provider/adapter must join its accepted task/plan/attempt to
   67 the original module binding plus its R/S/H dependencies and actual grant/store
   68 references. Original claim, deadlines, resource/retry budgets, input/output/store
   69 ownership and uncertain effects remain retained. Cleanup uses original references
   70 and constraints, not latest B. Secret references/revisions belong in the binding;
   71 secret values do not. A declared hash or synthetic fixture is not installed code,
   72 an authentic grant, a physical quota or a deployed role.
   73 
   74 Missing historical closure cannot acquire a new profile/default. Completed
   75 historical result replay authorizes no new business action. Pending or uncertain
   76 legacy work requires its original compatible runtime or explicit reconciliation;
   77 the exact safe migration/drain behavior must be specified, not waived. A completed
   78 or partly consumed module cannot be restarted as "unstarted" by publication.
   79 
   80 ## Still required before this can close C0
   81 
   82 - Exact physical generated carrier, schema, membership/source producer and atomic
   83   first acceptance/lookup/hash rules, using existing run state where suitable.
   84 - Complete correlated owner profiles and field applicability/compatibility maps;
   85   current copied graph values versus future task-only/reference representation.
   86 - Explicit captured foundations, runtime/delivery/role/grant/secret-reference and
   87   store/quota dependencies, including original cleanup and legitimate administrative
   88   rules, without a second editable author or a large config-server mechanism.
   89 - Concrete same-run A-started/B-next-unstarted, first-bind crash, incompatible-R,
   90   stage/repair/retry/recheck, uncertainty, cleanup, legacy missing closure, fixed Eval
   91   and existing snapshot-version cases with exact inputs and durable oracles.
   92 - Fresh independent definition review. No future runtime implementation or real
   93   physical fixture execution is claimed by these source constraints.

PATH docs/review/evidence/config-acceptance/author/check-nova-journal-binding-seam.mjs SHA256 0a53f348e71abe3af81ad0422591b62bb9b4e955c5c5f7d566a2669ca547a3f6
    1 import assert from 'node:assert/strict';
    2 import fs from 'node:fs';
    3 import os from 'node:os';
    4 import path from 'node:path';
    5 import crypto from 'node:crypto';
    6 import { FileJournal } from '../../../../../skills/nova/core/state/journal.ts';
    7 
    8 // Actual existing persistence reader/writer in an owned temporary directory.
    9 // This does NOT implement a module binding or exercise the future SDK schema.
   10 const root = fs.mkdtempSync(path.join(os.tmpdir(), 'kubeclaw-c0-journal-seam-'));
   11 const file = path.join(root, 'events.jsonl');
   12 const observations = [];
   13 function check(id, operation) { operation(); observations.push({ id, result: 'passed' }); }
   14 try {
   15   const first = new FileJournal(file);
   16   const specimen = { schemaVersion: 'c0-definition-specimen.v1', moduleId: 'module-a', bindingDigest: 'sha256:' + 'a'.repeat(64) };
   17   const capture = journal => journal.transact((records, append) => {
   18     const original = records.find(record => record.entry.moduleId === specimen.moduleId);
   19     if (original) { assert.deepEqual(original.entry, specimen); return original; }
   20     return append(specimen);
   21   });
   22   check('CURRENT-JOURNAL-CAPTURE', () => assert.equal(capture(first).sequence, 1));
   23   check('CURRENT-JOURNAL-REOPEN', () => assert.deepEqual(new FileJournal(file).records()[0].entry, specimen));
   24   check('CURRENT-JOURNAL-TWO-OBJECT-DEDUP', () => {
   25     const second = new FileJournal(file); capture(second); capture(first);
   26     assert.equal(new FileJournal(file).records().length, 1);
   27   });
   28   check('CURRENT-JOURNAL-CONFLICT-BEFORE-APPEND', () => {
   29     const prior = fs.readFileSync(file);
   30     assert.throws(() => first.transact((records, append) => {
   31       if (records.some(record => record.entry.moduleId === specimen.moduleId)) throw new Error('C0_SPECIMEN_CONFLICT');
   32       append({ ...specimen, bindingDigest: 'sha256:' + 'b'.repeat(64) });
   33     }), /C0_SPECIMEN_CONFLICT/);
   34     assert.deepEqual(fs.readFileSync(file), prior);
   35   });
   36   check('CURRENT-JOURNAL-INCOMPLETE-TAIL-RECOVERY', () => {
   37     const prior = fs.readFileSync(file); fs.appendFileSync(file, '{incomplete');
   38     assert.equal(new FileJournal(file).records().length, 1);
   39     assert.deepEqual(fs.readFileSync(file), prior);
   40   });
   41   check('CURRENT-JOURNAL-APPENDED-RECORD-NOT-ROLLBACK', () => {
   42     assert.throws(() => first.transact((_records, append) => {
   43       append({ schemaVersion: 'c0-definition-specimen.v1', moduleId: 'module-b' });
   44       throw new Error('C0_AFTER_APPEND');
   45     }), /C0_AFTER_APPEND/);
   46     assert.equal(new FileJournal(file).records().length, 2);
   47   });
   48   check('CURRENT-JOURNAL-CALLBACK-CANNOT-ESCAPE', () => {
   49     let escaped; first.transact((_records, append) => { escaped = append; });
   50     assert.throws(() => escaped(specimen), /JOURNAL_TRANSACTION_CLOSED/);
   51   });
   52   const bytes = fs.readFileSync(file);
   53   console.log(JSON.stringify({ scope: 'current FileJournal local persistence only', observations,
   54     fixtureBytes: bytes.length, fixtureSha256: crypto.createHash('sha256').update(bytes).digest('hex'),
   55     limitations: ['specimen is not a current LifecycleEvent', 'no true multi-process contention or process-kill crash exercised',
   56       'transact is synchronous exclusion, not multi-record rollback; no await inside callback',
   57       'no proposed module binding, observer, SDK, capacity or deployed-host acceptance'] }, null, 2));
   58 } finally { fs.rmSync(root, { recursive: true, force: true }); }

PATH skills/nova/project/compiler.ts SHA256 9d8ccdb3a1ccc56c58c1ec510aed54473f7db6d4135d28b2e265bbf90d7f1ef5
    1 import {demoStages,normalizeDemo} from './demo.ts';
    2 import {sourceStages} from './source.ts';
    3 import { cumulativeStages, projectCoverage, testConfiguration } from './coverage.ts';
    4 import { assertProjectReviewModes, projectReviewConfig, type ProjectReviewSemanticMode } from './review-semantics.ts';
    5 import path from 'node:path';
    6 import { PORTABLE_JSON_ENCODING, canonicalJson, sha256Text, type SourceBinding, type PipelineDefinition, type StageDefinition } from '@kubeclaw/plugin-sdk';
    7 import { validateContractValue } from '@kubeclaw/plugin-foundation/registry/schema';
    8 import { coverageReviewPrefixes, coverageReviewRequirements, validatePipelineTestGateContract, resolvedTestPlanDigest, type ResolvedTestPlanV1 } from '@kubeclaw/pipeline-test-gate-contract';
    9 import { assertProjectDeliveryManifestMode, type ProjectDeliveryManifestMode } from './delivery-manifest.ts';
   10 
   11 type ObjectValue = Record<string, any>;
   12 function object(value: unknown, fields: string[], label: string): ObjectValue {
   13   if (!value || typeof value !== 'object' || Array.isArray(value)
   14     || Object.keys(value).some(key => !fields.includes(key))) throw new Error(`PROJECT_OBJECT_INVALID:${label}`);
   15   return value as ObjectValue;
   16 }
   17 function text(value: unknown, label: string): string {
   18   if (typeof value !== 'string' || !value.trim()) throw new Error(`PROJECT_TEXT_REQUIRED:${label}`);
   19   return value;
   20 }
   21 function id(value: unknown): string {
   22   const result = text(value, 'id');
   23   if (!/^[a-z][a-z0-9-]{0,47}$/u.test(result)) throw new Error(`PROJECT_ID_INVALID:${result}`);
   24   return result;
   25 }
   26 function absolute(value: unknown, label: string): string {
   27   const result = text(value, label);
   28   if (!path.isAbsolute(result) || path.normalize(result) !== result) throw new Error(`PROJECT_ABSOLUTE_PATH_REQUIRED:${label}`);
   29   return result;
   30 }
   31 function strings(value: unknown, label: string, allowEmpty = false): string[] {
   32   if (!Array.isArray(value) || (!allowEmpty && value.length === 0)
   33     || value.some(item => typeof item !== 'string' || !item.trim()) || new Set(value).size !== value.length) throw new Error(`PROJECT_LIST_INVALID:${label}`);
   34   return [...value];
   35 }
   36 function relative(value: string): string {
   37   if (path.posix.isAbsolute(value) || value.includes('\\') || value.split('/').some(part => !part || part === '.' || part === '..')) throw new Error(`PROJECT_OWNERSHIP_INVALID:${value}`);
   38   return value;
   39 }
   40 function agent(value: unknown): ObjectValue {
   41   const config = object(value, ['agent', 'agentRole'], 'agent');
   42   text(config.agent, 'agent');
   43   if (config.agentRole !== undefined) text(config.agentRole, 'agentRole');
   44   return config;
   45 }
   46 
   47 interface ModuleContext { readonly reviewSemanticMode: ProjectReviewSemanticMode; readonly reportArtifactEncoding: 'legacy' | typeof PORTABLE_JSON_ENCODING; readonly sourceBinding: SourceBinding; readonly projectId: string; readonly runId: string; readonly repository: string; readonly workspaces: string; readonly baseline: string; readonly previousGate: string | undefined; }
   48 function moduleStages(module: ObjectValue, context: ModuleContext): StageDefinition[] {
   49   const { projectId, runId, repository, workspaces, baseline, previousGate } = context;
   50   const runNamespace = sha256Text(runId).slice(7, 23);
   51   const stages: StageDefinition[] = [];
   52   const implementationId = `implement-${module.id}`;
   53   const lintId = `lint-${module.id}`;
   54   const reviewId = `review-${module.id}`;
   55   const testId = `test-${module.id}`;
   56   const evidence = { projectId, moduleId: module.id, baseRevision: baseline, requirements: module.requirements };
   57   const expectedCoverage = projectCoverage(projectId, baseline, [module], module.test);
   58   const categories = { lint: 2, ...(module.review ? { review: 2 } : {}), test: 2 };
   59   const repairBudget = { categories, maximumOrchestratorOrders: 1 };
   60   // The former maxAttempts:2 allowed one technical retry. Preserve that
   61   // allowance independently of initial work, repair orders and rechecks.
   62   const maxTechnicalRetries = 1;
   63   const maximumOrders = Object.values(categories).reduce((sum, limit) => sum + limit, 0) + 1;
   64   const execution = { maxAttempts: 1 + maximumOrders + maxTechnicalRetries,
   65     maxRemediationCycles: maximumOrders, maxTechnicalRetries, timeoutMs: 1_800_000 };
   66   stages.push({ id: implementationId, type: 'kubeclaw.agent.implementation',
   67     dependsOn: [...new Set([...(previousGate ? [previousGate] : []), ...module.dependsOn.map((dependency: string) => `test-${dependency}`)])].sort(),
   68     config: module.implementation, input: { runId, moduleId: module.id, attempt: 1, headBefore: baseline, sourceBinding: context.sourceBinding,
   69       task: `${module.task}\n\nRead the source-bound Forge blueprint(s) under ${module.blueprint.modulePath}${module.blueprint.substeps ? ` in substeps ${module.blueprint.substeps.join(', ')}` : ''}.\nOwned paths: ${module.ownedPaths.join(', ')}\nRequirements:\n${canonicalJson(module.requirements)}`,
   70       workspace: { repositoryRoot: repository, workspacePath: path.join(workspaces, runNamespace, module.id),
   71         branch: `nova/${projectId}/${runNamespace}/${module.id}`, baseRef: 'HEAD', mergeTarget: repository,
   72         commitMessage: `[forge:${module.id}] ${projectId}` } }, execution: { ...execution, repairBudget } });
   73   stages.push({ id: lintId, type: 'kubeclaw.lint.full', dependsOn: [implementationId], config: module.lint,
   74     input: { workingDirectory: repository, project: projectId, sourceStageId: implementationId }, execution: { ...execution, repairCategory: 'lint' }, on: { request_fix: implementationId } });
   75   if (module.review) stages.push({ id: reviewId, type: 'kubeclaw.decision.review', dependsOn: [lintId],
   76     config: projectReviewConfig(module.review, context.reportArtifactEncoding, context.reviewSemanticMode),
   77     input: { task: { id: module.id, statement: module.task }, revisions: { sourceStageId: implementationId },
   78       scope: { allowedPrefixes: coverageReviewPrefixes(expectedCoverage), ownershipPrefixes: coverageReviewPrefixes(expectedCoverage) }, requirements: coverageReviewRequirements(expectedCoverage),
   79       evidence: [{ kind: 'project-requirements', digest: sha256Text(canonicalJson(evidence)), content: evidence }, { kind: 'gate-coverage', digest: sha256Text(canonicalJson(expectedCoverage)), content: expectedCoverage }], contextCandidates: [] },
   80     execution: { ...execution, repairCategory: 'review' }, on: { request_fix: implementationId } });
   81   stages.push({ id: testId, type: 'kubeclaw.test.quality-evaluation', dependsOn: [module.review ? reviewId : lintId],
   82     config: testConfiguration(module.test),
   83     input: { gateId: testId, task: module.task, expectedCoverage,
   84       providerPlan: { ...module.test.providerPlan, repositoryRoot: repository, sourceStageId: implementationId } },
   85     execution: { ...execution, repairCategory: 'test' }, on: { request_fix: implementationId } });
   86   return stages;
   87 }
   88 
   89 function validateRequirements(module: ObjectValue, moduleId: string): void {
   90   if (!Array.isArray(module.requirements) || !module.requirements.length) throw new Error(`PROJECT_REQUIREMENTS_REQUIRED:${moduleId}`);
   91   const requirementIds = new Set<string>();
   92   for (const requirement of module.requirements) {
   93     const r = object(requirement, ['id', 'statement'], 'requirement');
   94     text(r.id, 'requirement.id'); text(r.statement, 'requirement.statement');
   95     if (requirementIds.has(r.id)) throw new Error('PROJECT_REQUIREMENT_DUPLICATE');
   96     requirementIds.add(r.id);
   97   }
   98 }
   99 
  100 function validateModuleRuntime(module: ObjectValue, moduleId: string, runId: string, projectId: string): void {
  101   agent(module.implementation);
  102   if (module.review !== undefined) { object(module.review, ['agent'], 'review'); text(module.review.agent, 'review.agent'); }
  103   const lint = object(module.lint, ['policyPath', 'policyProject'], 'lint');
  104   absolute(lint.policyPath, 'lint.policyPath'); text(lint.policyProject, 'lint.policyProject');
  105   const test = object(module.test, ['agent', 'agentRole', 'testAgentEnabled', 'requiredChecks', 'providerPlan'], 'test');
  106   testConfiguration(test);
  107   const provider = object(test.providerPlan, ['repositoryId', 'plan', 'grants', 'maximumConcurrency', 'submittedAt', 'timeoutMs'], 'providerPlan');
  108   validatePipelineTestGateContract('resolvedTestPlan', provider.plan);
  109   const plan = provider.plan as ResolvedTestPlanV1;
  110   const { planDigest, ...unsigned } = plan;
  111   if (resolvedTestPlanDigest(unsigned) !== planDigest) throw new Error('PROJECT_PLAN_DIGEST_MISMATCH');
  112   if (plan.runId !== runId || plan.project !== projectId || plan.scope.moduleId !== moduleId || plan.scope.gateId !== null) throw new Error(`PROJECT_PLAN_SCOPE_MISMATCH:${moduleId}`);
  113   if (!plan.nodes.some(node => node.kind === 'test' && node.mode === 'blocking' && node.skipReason === null)) throw new Error(`PROJECT_BLOCKING_TEST_REQUIRED:${moduleId}`);
  114 }
  115 
  116 function projectModules(project: ObjectValue, runId: string, projectId: string): Map<string, ObjectValue> {
  117   if (!Array.isArray(project.modules) || !project.modules.length || project.modules.length > 128) throw new Error('PROJECT_MODULES_INVALID');
  118   const modules = new Map<string, ObjectValue>();
  119   const owned: { module: string; prefix: string }[] = [];
  120   for (const value of project.modules) {
  121     const module = object(value, ['id', 'dependsOn', 'task', 'ownedPaths', 'requirements', 'implementation', 'lint', 'review', 'test', 'blueprint'], 'module');
  122     const moduleId = id(module.id);
  123     if (modules.has(moduleId)) throw new Error(`PROJECT_MODULE_DUPLICATE:${moduleId}`);
  124     text(module.task, 'task');
  125     strings(module.dependsOn, 'dependsOn', true).forEach(id);
