  116   }
  117 
  118   async #execute(runId: string, definition: StageDefinition): Promise<CompletedStageDecision> {
  119     const current = this.#states.get(definition.id)!; const override = this.#services.overrides.delete(definition.id);
  120     if (current.attemptsUsed >= definition.execution.maxAttempts && !override) return { definition, administrativeOverride: false, decision: {
  121       state: { ...current, status: 'blocked' }, action: { type: 'stop' }, result: { schemaVersion: 'stage-result.v2', outcome: 'blocked',
  122         reason: { code: 'core.attempt_budget_exhausted', message: `Attempt budget exhausted for ${definition.id}` }, artifacts: [] },
  123     } };
  124     this.#states.set(definition.id, { ...current, status: 'running' });
  125     this.#services.append('stage.started', { runId, stageId: definition.id }, { stageType: definition.type,
  126       ...(typeof definition.config.agentRole === 'string' ? { agentRole: definition.config.agentRole } : {}), ...(override ? { administrativeOverride: true } : {}) });
  127     await this.#services.flush();
  128     const decision = await this.#services.executor.execute(runId, current, current.continuationGuidance ?? this.#services.options.resumeGuidance?.get(definition.id));
  129     return { definition, decision, administrativeOverride: override };
  130   }
  131 
  132   async #terminal(identity: PipelineRunIdentity, status: 'failed' | 'blocked' | 'cancelled'): Promise<PipelineRunResult> {
  133     this.#services.append(`run.${status}` as LifecycleEvent['type'], { runId: identity.runId }); await this.#services.flush();
  134     return this.#services.result(identity, status, this.#states);
  135   }
  136 
  137   async #finalize(identity: PipelineRunIdentity): Promise<PipelineRunResult> {
  138     const statuses = [...this.#states.values()].map(({ status }) => status);
  139     const complete = [...this.#states].every(([id, state]) => state.status === 'succeeded' || state.status === 'skipped'
  140       || (state.status === 'pending' && this.#services.graph.isRemediationOnlyTarget(id) && !state.remediationReturnTo));
  141     const status: PipelineRunResult['status'] = complete ? 'succeeded' : ['failed', 'blocked', 'cancelled', 'waiting'].find((candidate) => statuses.includes(candidate as StageRuntimeState['status'])) as PipelineRunResult['status'] ?? 'failed';
  142     if (status !== 'waiting') this.#services.append(`run.${status}` as LifecycleEvent['type'], { runId: identity.runId });
  143     await this.#services.flush(); return this.#services.result(identity, status, this.#states);
  144   }
  145 
  146   #force(stageId: string): void { if (!this.#forcedIds.has(stageId)) { this.#forcedIds.add(stageId); this.#forced.push(stageId); } }
  147   #nextForced(): string | undefined { const id = this.#forced.shift(); if (id) this.#forcedIds.delete(id); return id; }
  148 }

PATH skills/nova/core/state/journal.ts SHA256 25be25a991c93c0e523178e3c45e2f7fb15ecad6e1a03566fca241d6b27f40bf
    1 import {hashJournalRecord as recordHash, parseHashJournal} from '@kubeclaw/plugin-foundation/observability/hash-journal';
    2 import fs from 'node:fs';
    3 import path from 'node:path';
    4 import { FileMutex } from './file-mutex.ts';
    5 import { snapshotJson } from './json-value.ts';
    6 
    7 export interface JournalRecord<T> {
    8   readonly sequence: number;
    9   readonly previousHash: string | null;
   10   readonly hash: string;
   11   readonly entry: T;
   12 }
   13 
   14 export function parseJournalRecords<T>(buffer: Buffer, records: JournalRecord<T>[], file: string): void {
   15     for (const record of parseHashJournal<T>(buffer,file,records.length,records.at(-1)?.hash??null)) {
   16       records.push(snapshotJson(record));
   17     }
   18   }
   19 
   20 
   21 export class FileJournal<T> {
   22   readonly #file: string;
   23   readonly #mutex: FileMutex;
   24   #records: JournalRecord<T>[];
   25   #offset: number;
   26   #identity: string | undefined;
   27   #mtimeMs: number | undefined;
   28   #ctimeMs: number | undefined;
   29 
   30   constructor(file: string, appendLockTimeoutMs = 5_000) {
   31     if (!Number.isSafeInteger(appendLockTimeoutMs) || appendLockTimeoutMs < 1) {
   32       throw new Error('JOURNAL_APPEND_LOCK_TIMEOUT_INVALID');
   33     }
   34     this.#file = path.resolve(file);
   35     fs.mkdirSync(path.dirname(this.#file), { recursive: true });
   36     this.#mutex = new FileMutex(`${this.#file}.append-lock`, appendLockTimeoutMs, `JOURNAL_APPEND_LOCK_TIMEOUT:${this.#file}`);
   37     const loaded = this.#mutex.withLock(() => this.#load());
   38     this.#records = loaded.records;
   39     this.#offset = loaded.offset;
   40     this.#identity = loaded.identity;
   41     this.#mtimeMs = loaded.mtimeMs;
   42     this.#ctimeMs = loaded.ctimeMs;
   43   }
   44 
   45   #fileState(): { identity: string; size: number; mtimeMs: number; ctimeMs: number } | undefined {
   46     try {
   47       const stat = fs.statSync(this.#file);
   48       return { identity: `${stat.dev}:${stat.ino}`, size: stat.size, mtimeMs: stat.mtimeMs, ctimeMs: stat.ctimeMs };
   49     } catch (error) {
   50       if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined;
   51       throw error;
   52     }
   53   }
   54 
   55   #parse(buffer: Buffer, records: JournalRecord<T>[]): void {
   56     parseJournalRecords(buffer, records, this.#file);
   57   }
   58 
   59   #recoverIncompleteTail(buffer: Buffer): Buffer {
   60     if (buffer.length === 0 || buffer.at(-1) === 0x0a) return buffer;
   61     const committedBytes = buffer.lastIndexOf(0x0a) + 1;
   62     const descriptor = fs.openSync(this.#file, 'r+');
   63     try {
   64       fs.ftruncateSync(descriptor, committedBytes);
   65       fs.fsyncSync(descriptor);
   66     } finally {
   67       fs.closeSync(descriptor);
   68     }
   69     return buffer.subarray(0, committedBytes);
   70   }
   71 
   72   #load(): { records: JournalRecord<T>[]; offset: number; identity: string | undefined; mtimeMs: number | undefined; ctimeMs: number | undefined } {
   73     if (!fs.existsSync(this.#file)) return { records: [], offset: 0, identity: undefined, mtimeMs: undefined, ctimeMs: undefined };
   74     const buffer = this.#recoverIncompleteTail(fs.readFileSync(this.#file));
   75     const records: JournalRecord<T>[] = [];
   76     this.#parse(buffer, records);
   77     const state = this.#fileState();
   78     if (!state || state.size !== buffer.length) throw new Error(`JOURNAL_CHANGED_DURING_READ:${this.#file}`);
   79     return { records, offset: buffer.length, identity: state.identity, mtimeMs: state.mtimeMs, ctimeMs: state.ctimeMs };
   80   }
   81 
   82   #adoptReloaded(loaded: { records: JournalRecord<T>[]; offset: number; identity: string | undefined; mtimeMs: number | undefined; ctimeMs: number | undefined }): void {
   83     if (loaded.records.length < this.#records.length
   84       || this.#records.some((record, index) => loaded.records[index]?.hash !== record.hash)) {
   85       throw new Error(`JOURNAL_REWIND_OR_DIVERGENCE:${this.#file}`);
   86     }
   87     this.#records = loaded.records;
   88     this.#offset = loaded.offset;
   89     this.#identity = loaded.identity;
   90     this.#mtimeMs = loaded.mtimeMs;
   91     this.#ctimeMs = loaded.ctimeMs;
   92   }
   93 
   94   #synchronize(): void {
   95     const state = this.#fileState();
   96     if (state === undefined) {
   97       if (this.#offset !== 0 || this.#records.length !== 0) throw new Error(`JOURNAL_REMOVED:${this.#file}`);
   98       return;
   99     }
  100     if (state.identity !== this.#identity || state.size < this.#offset
  101       || (state.size === this.#offset && (state.mtimeMs !== this.#mtimeMs || state.ctimeMs !== this.#ctimeMs))) {
  102       this.#adoptReloaded(this.#load());
  103       return;
  104     }
  105     if (state.size === this.#offset) return;
  106     const length = state.size - this.#offset;
  107     const descriptor = fs.openSync(this.#file, 'r');
  108     try {
  109       const buffer = Buffer.allocUnsafe(length);
  110       const read = fs.readSync(descriptor, buffer, 0, length, this.#offset);
  111       if (read !== length) throw new Error(`JOURNAL_TAIL_READ_INCOMPLETE:${this.#file}`);
  112       if (buffer.at(-1) !== 0x0a) {
  113         this.#adoptReloaded(this.#load());
  114         return;
  115       }
  116       this.#parse(buffer, this.#records);
  117       this.#offset = state.size;
  118       this.#mtimeMs = state.mtimeMs;
  119       this.#ctimeMs = state.ctimeMs;
  120     } finally {
  121       fs.closeSync(descriptor);
  122     }
  123   }
  124 
  125   #appendUnlocked(entry: T): JournalRecord<T> {
  126     entry = snapshotJson(entry);
  127     const sequence = this.#records.length + 1;
  128     const previousHash = this.#records.at(-1)?.hash ?? null;
  129     const record: JournalRecord<T> = Object.freeze({
  130       sequence,
  131       previousHash,
  132       hash: recordHash(sequence, previousHash, entry),
  133       entry,
  134     });
  135     const serialized = Buffer.from(`${JSON.stringify(record)}\n`);
  136     const descriptor = fs.openSync(this.#file, 'a');
  137     try {
  138       let written = 0;
  139       while (written < serialized.length) {
  140         const count = fs.writeSync(descriptor, serialized, written, serialized.length - written);
  141         if (count < 1) throw new Error(`JOURNAL_APPEND_WRITE_INCOMPLETE:${this.#file}`);
  142         written += count;
  143       }
  144       fs.fsyncSync(descriptor);
  145     } finally {
  146       fs.closeSync(descriptor);
  147     }
  148     this.#records.push(record);
  149     this.#offset += serialized.length;
  150     const state = this.#fileState();
  151     if (!state || state.size !== this.#offset) throw new Error(`JOURNAL_APPEND_SIZE_MISMATCH:${this.#file}`);
  152     this.#identity = state.identity;
  153     this.#mtimeMs = state.mtimeMs;
  154     this.#ctimeMs = state.ctimeMs;
  155     return record;
  156   }
  157 
  158   transact<R>(
  159     operation: (
  160       records: readonly JournalRecord<T>[],
  161       append: (entry: T) => JournalRecord<T>,
  162     ) => R,
  163   ): R {
  164     return this.#mutex.withLock(() => {
  165       this.#synchronize();
  166       let active = true;
  167       try {
  168         return operation(
  169           Object.freeze([...this.#records]),
  170           (entry) => {
  171             if (!active) throw new Error('JOURNAL_TRANSACTION_CLOSED');
  172             return this.#appendUnlocked(entry);
  173           },
  174         );
  175       } finally { active = false; }
  176     });
  177   }
  178 
  179   append(entry: T): JournalRecord<T> {
  180     return this.transact((_records, append) => append(entry));
  181   }
  182 
  183   appendSequenced<U extends T>(create: (sequence: number) => U): JournalRecord<U> {
  184     return this.transact((records, append) => append(create(records.length + 1))) as JournalRecord<U>;
  185   }
  186 
  187   records(): readonly JournalRecord<T>[] {
  188     return Object.freeze([...this.#records]);
  189   }
  190 
  191   refresh(): readonly JournalRecord<T>[] {
  192     return this.#mutex.withLock(() => {
  193       this.#synchronize();
  194       return this.records();
  195     });
  196   }
  197 }

