    4 type ObjectValue = Record<string, any>;
    5 function object(value: unknown, fields: string[], label: string): ObjectValue {
    6   if (!value || typeof value !== 'object' || Array.isArray(value)
    7     || Object.keys(value).some(key => !fields.includes(key))) throw new Error(`PROJECT_SOURCE_INVALID:${label}`);
    8   return value as ObjectValue;
