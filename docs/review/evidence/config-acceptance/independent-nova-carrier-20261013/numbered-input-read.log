    8 function withTimeout<T>(promise: Promise<T>, milliseconds: number, onTimeout: () => void): Promise<T> {
    9   return new Promise<T>((resolve, reject) => {
   10     const timer = setTimeout(() => { onTimeout(); reject(new Error('OBSERVER_DELIVERY_TIMEOUT')); }, milliseconds); timer.unref();
   11     promise.then((value) => { clearTimeout(timer); resolve(value); }, (error: unknown) => { clearTimeout(timer); reject(error); });
   12   });
   13 }
   14 
   15 export async function deliverObserver(options: ObserverRuntimeOptions, now: () => Date, observerId: string, record: JournalRecord<CanonicalEvent>, deliveryAttempt: number): Promise<void> {
   16   const entry = options.registry.snapshot.observers.get(observerId); const activated = options.activated.observers.get(observerId);
   17   if (!entry || !activated) throw new Error(`OBSERVER_NOT_ACTIVATED:${observerId}`);
   18   const event = record.entry; const attempt: AttemptIdentity = { runId: event.identity.runId, stageId: entry.registration.id,
   19     attemptId: `observer:${observerId}:${event.eventId}`, attemptNumber: 1 };
   20   const timeoutMs = entry.registration.failurePolicy.timeoutMs; const timestamp = now();
   21   const leaseContract = { schemaVersion: 'invocation-lease.v2' as const, leaseId: `lease:${crypto.randomUUID()}`, attempt,
   22     registration: entry.provenance, status: 'active' as const, grants: [...(options.registry.grants.get(observerId) ?? [])],
   23     limits: { wallTimeMs: timeoutMs, memoryBytes: 256 * 1024 * 1024, cpuMillis: timeoutMs }, issuedAt: timestamp.toISOString(),
   24     expiresAt: new Date(timestamp.getTime() + timeoutMs).toISOString() };
   25   const lease = new RevocableLease(leaseContract, now); const controller = new AbortController();
   26   const delivery: ObserverDelivery = { schemaVersion: 'observer-delivery.v2', deliveryId: `delivery:${observerId}:${event.eventId}`,
   27     observer: entry.provenance, attemptNumber: deliveryAttempt, event, deliveredAt: now().toISOString() };
   28   const contract: PluginContext = { schemaVersion: 'plugin-context.v2', lease: leaseContract, config: options.configs.get(observerId) ?? {}, input: { delivery }, artifacts: [] };
   29   let sequence = 0;
   30   const context = createPluginInvocationContext(contract, lease, { invoke: async (_leaseId, capability, operation, resource, payload, runtimeDispatchProfile) => {
   31     sequence += 1;
   32     const stableKey = `${delivery.deliveryId}:${sequence}`;
   33     const provider = options.registry.selectedProviders.get(capability);
   34     const supported = capability === 'operator.request' && provider?.package.manifest.id === 'kubeclaw.operator-messaging';
   35     const executionAttempt = supported ? { ...attempt, attemptId: `${attempt.attemptId}:execution:${deliveryAttempt}`, attemptNumber: deliveryAttempt } : attempt;
   36     return options.adapters.invoke(capability, executionAttempt, supported ? `${stableKey}:execution:${deliveryAttempt}` : stableKey,
   37       { operation, resource, payload, ...(runtimeDispatchProfile === undefined ? {} : { runtimeDispatchProfile }) }, controller.signal, supported ? stableKey : undefined);
   38   } }, { append: async (_leaseId, type, identity, payload) => { options.events.appendSequenced((eventSequence) => ({
   39     schemaVersion: 'plugin-domain-event.v2', eventId: `event:${crypto.randomUUID()}`, sequence: eventSequence,
   40     type, producer: entry.provenance, identity, occurredAt: now().toISOString(), causationId: delivery.deliveryId, payload,
   41   })); } });
   42   try { await withTimeout(activated.execute(delivery, context, controller.signal) as Promise<void>, timeoutMs, () => controller.abort(new Error('OBSERVER_DELIVERY_TIMEOUT'))); }
   43   finally { controller.abort(new Error('OBSERVER_DELIVERY_COMPLETED')); lease.revoke({ code: 'core.observer_delivery_completed' }, now()); }
   44 }

