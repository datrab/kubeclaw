PATH skills/common/plugin-runtime/contracts/plugin-system/v2/plugin-system-v2.schema.json
    1 {
    2   "$schema": "https://json-schema.org/draft/2020-12/schema",
    3   "$id": "https://kubeclaw.dev/contracts/plugin-system/v2/plugin-system-v2.schema.json",
    4   "title": "KubeClaw plugin system v2 contracts",
    5   "$defs": {
    6     "reviewCacheProfile": {
    7       "description": "Explicit immutable run-owned review cache producer profile. Historical absence preserves review-content-cache.v1 and its original effect operations.",
    8       "const": { "schemaVersion": "review-cache-profile.v1", "recordVersion": "review-content-cache.v2", "encoding": "json-utf16-v1" }
    9     },
   10     "runtimeDispatchProfile": {
   11       "description": "Explicit current runtime transport producer profile. Absence in historical contexts preserves the legacy producer; no profile is inferred from another digest version.",
   12       "const": { "schemaVersion": "runtime-dispatch-profile.v1", "encoding": "json-utf16-v1" }
   13     },
   14     "capabilityInvocation": {
   15       "type": "object", "additionalProperties": false,
   16       "required": ["operation", "resource", "payload"],
   17       "properties": {
   18         "operation": { "type": "string", "minLength": 1 },
   19         "resource": { "$ref": "#/$defs/resourceIdentity" },
   20         "payload": { "$ref": "#/$defs/jsonObject" },
   21         "runtimeDispatchProfile": { "$ref": "#/$defs/runtimeDispatchProfile" }
   22       },
   23       "allOf": [{
   24         "if": { "properties": { "runtimeDispatchProfile": true }, "required": ["runtimeDispatchProfile"] },
   25         "then": { "properties": { "operation": { "const": "dispatch" }, "resource": { "type": "object", "properties": { "type": { "const": "runtime.agent" } } } } }
   26       }]
   27     },
   28     "runtimeRunGraph": {
   29       "type": "object", "additionalProperties": false,
   30       "required": ["schemaVersion", "pipelineId", "maxConcurrency", "nodes", "ordinaryEdges", "remediationEdges", "digest"],
   31       "properties": {
   32         "schemaVersion": { "enum": ["execution-graph-snapshot.v2", "execution-graph-snapshot.v3"] },
   33         "pipelineId": { "$ref": "#/$defs/opaqueId" },
   34         "maxConcurrency": { "type": "integer", "minimum": 1 },
   35         "nodes": { "type": "array", "items": { "$ref": "#/$defs/jsonObject" } },
   36         "ordinaryEdges": { "type": "array", "items": { "$ref": "#/$defs/runtimeRunEdge" } },
   37         "remediationEdges": { "type": "array", "items": { "$ref": "#/$defs/runtimeRunEdge" } },
   38         "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
   39       }
   40     },
   41     "runtimeRunEdge": {
   42       "type": "object", "additionalProperties": false, "required": ["from", "to"],
   43       "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
   44     },
   45     "runtimeRunSnapshot": {
   46       "type": "object", "additionalProperties": false,
   47       "required": ["schemaVersion", "graph", "registry", "digest", "runtimeDispatchProfile"],
   48       "properties": {
   49         "schemaVersion": { "const": "run-snapshot.v3" },
   50         "graph": { "$ref": "#/$defs/runtimeRunGraph" },
   51         "registry": { "$ref": "#/$defs/jsonObject" },
   52         "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
   53         "runtimeDispatchProfile": { "$ref": "#/$defs/runtimeDispatchProfile" }
   54       }
   55     },
   56     "runtimeRunSnapshotV4": {
   57       "type": "object", "additionalProperties": false,
   58       "required": ["schemaVersion", "graph", "registry", "digest", "runtimeDispatchProfile", "reviewCacheProfile"],
   59       "properties": {
   60         "schemaVersion": { "const": "run-snapshot.v4" },
   61         "graph": { "$ref": "#/$defs/runtimeRunGraph" },
   62         "registry": { "$ref": "#/$defs/jsonObject" },
   63         "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
   64         "runtimeDispatchProfile": { "$ref": "#/$defs/runtimeDispatchProfile" },
   65         "reviewCacheProfile": { "$ref": "#/$defs/reviewCacheProfile" }
   66       }
   67     },
   68     "namespacedId": {
   69       "type": "string",
   70       "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
   71       "maxLength": 160
   72     },
   73     "localId": {
   74       "type": "string",
   75       "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
   76       "maxLength": 96
   77     },
   78     "opaqueId": {
   79       "type": "string",
   80       "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
   81     },
   82     "effectIdempotencyKey": {
   83       "description": "Existing opaque keys, plus the exact historical adapter dependency producer grammar. Package/capability names retain their 160-character bounds and registration its 96-character bound. New dependency keys are compact opaque IDs.",
   84       "anyOf": [
   85         { "$ref": "#/$defs/opaqueId" },
   86         {
   87           "type": "string",
   88           "pattern": "^adapter:(?=[^:]{1,160}:)[a-z0-9]+(?:[._-][a-z0-9]+)+:(?=[^:]{1,96}:)[a-z0-9]+(?:[._-][a-z0-9]+)*:(?=[^:]{1,160}:)[a-z0-9]+(?:[._-][a-z0-9]+)+:[a-f0-9]{64}(?::parent:[a-f0-9]{64})?$"
   89         }
   90       ]
   91     },
   92     "resourceIdentity": {
   93       "description": "Capability-owned resource names include URLs, absolute paths, dot and catalog keys. Capability implementations retain their own URL, path and authorization constraints.",
   94       "type": "object",
   95       "additionalProperties": false,
   96       "required": ["type", "canonicalId"],
   97       "properties": {
   98         "type": { "$ref": "#/$defs/namespacedId" },
   99         "canonicalId": { "type": "string", "minLength": 1 }
  100       }
  101     },
  102     "effectDeliveryId": {
  103       "description": "The original public adapter dependency delivery token: nonblank and at most 512 characters. Observer delivery contracts remain opaque IDs.",
  104       "type": "string",
  105       "minLength": 1,
  106       "maxLength": 512,
  107       "pattern": "\\S"
  108     },
  109     "effectAttemptIdentity": {
  110       "anyOf": [
  111         { "$ref": "#/$defs/attemptIdentity" },
  112         {
  113           "description": "Exact historical adapter-activation producer domain. Core additionally checks equal runId and attemptId against the actual activation owner.",
  114           "type": "object",
  115           "additionalProperties": false,
  116           "required": ["runId", "stageId", "attemptId", "attemptNumber"],
  117           "properties": {
  118             "runId": { "$ref": "#/$defs/adapterActivationId" },
  119             "stageId": { "const": "adapter-activation" },
  120             "attemptId": { "$ref": "#/$defs/adapterActivationId" },
  121             "attemptNumber": { "const": 1 }
  122           }
  123         }
  124       ]
  125     },
  126     "adapterActivationId": {
  127       "type": "string",
  128       "pattern": "^adapter:(?=[^:]{1,160}:)[a-z0-9]+(?:[._-][a-z0-9]+)+:(?=[^:]{1,96}$)[a-z0-9]+(?:[._-][a-z0-9]+)*$",
  129       "maxLength": 265
  130     },
  131     "relativeModulePath": {
  132       "type": "string",
  133       "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:mjs|mts|js|ts)$",
  134       "maxLength": 512
  135     },
  136     "relativeSchemaPath": {
  137       "type": "string",
  138       "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$",
  139       "maxLength": 512
  140     },
  141     "testContractId": {
  142       "type": "string",
  143       "pattern": "^[a-z0-9][a-z0-9._/-]*@[1-9][0-9]*$",
  144       "maxLength": 256
  145     },
  146     "jsonObject": {
  147       "type": "object"
  148     },
  149     "reason": {
  150       "type": "object",
  151       "additionalProperties": false,
  152       "required": ["code"],
  153       "properties": {
  154         "code": { "$ref": "#/$defs/namespacedId" },
  155         "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
  156         "details": { "$ref": "#/$defs/jsonObject" }
  157       }
  158     },
  159     "packageIdentity": {
  160       "type": "object",
  161       "additionalProperties": false,
  162       "required": ["pluginId", "apiVersion", "packageVersion", "contentDigest"],
  163       "properties": {
  164         "pluginId": { "$ref": "#/$defs/namespacedId" },
