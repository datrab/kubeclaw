   51       revisions: { sourceStageId, base: project.baseRevision },
   52       scope: { allowedPrefixes: coverageReviewPrefixes(coverage), ownershipPrefixes: coverageReviewPrefixes(coverage) },
   53       requirements: coverageReviewRequirements(coverage), evidence: [{ kind: 'gate-coverage', digest: sha256Text(canonicalJson(coverage)), content: coverage }], contextCandidates: [] }, execution });
   54   stages.push({ id: 'final-test', type: 'kubeclaw.test.quality-evaluation', dependsOn: [final.review ? 'final-review' : 'final-lint'],
   55     config: testConfiguration(final.test), input: { gateId: 'final-test', task: 'Test the complete integrated project, including declared interactions.',
   56       expectedCoverage: coverage, providerPlan: { ...final.test.providerPlan, repositoryRoot: project.repositoryRoot, sourceStageId } }, execution });
   57   stages.push({ id: 'project-summary', type: 'kubeclaw.report.project-summary', dependsOn: ['final-test'],
   58     config: deliveryManifestEncoding === 'legacy' ? {} : { deliveryManifestEncoding: DELIVERY_MANIFEST_ENCODING }, input: {
   59     projectId: project.id, modules: modules.map(module => ({ moduleId: module.id, sourceStageId: `implement-${module.id}`,
   60       testStageId: `test-${module.id}`, expectedCoverage: projectCoverage(project.id, project.baseRevision, [module], module.test) })),
   61     final: { sourceStageId, lintStageId: 'final-lint', ...(final.review ? { reviewStageId: 'final-review' } : {}),
   62       ...(deliveryManifestEncoding !== 'legacy' && final.review && reportArtifactEncoding !== 'legacy'
   63         ? { reviewArtifactEncoding: reportArtifactEncoding } : {}),
   64       ...(final.review && reviewSemanticMode !== 'legacy' ? { reviewSemanticEncoding: reviewSemanticMode } : {}),
   65       testStageId: 'final-test', expectedCoverage: coverage },
   66   }, execution });
   67   return stages;
   68 }

