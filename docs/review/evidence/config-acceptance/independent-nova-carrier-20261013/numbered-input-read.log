   16 
   17 function stagesById(stages: readonly StageDefinition[]): Map<string, StageDefinition> {
   18   const result = new Map<string, StageDefinition>();
   19   for (const candidate of stages) {
   20     const stage = freeze(structuredClone(candidate));
   21     if (result.has(stage.id)) throw new Error(`GRAPH_DUPLICATE_STAGE:${stage.id}`);
   22     validateExecution(stage); result.set(stage.id, stage);
   23   }
   24   if (result.size === 0) throw new Error('GRAPH_EMPTY');
   25   return result;
   26 }
   27 
   28 function addDependencies(stage: StageDefinition, stages: ReadonlyMap<string, StageDefinition>, dependents: Map<string, string[]>, edges: Edge[]): void {
   29   if (new Set(stage.dependsOn).size !== stage.dependsOn.length) throw new Error(`GRAPH_DUPLICATE_DEPENDENCY:${stage.id}`);
   30   for (const dependency of stage.dependsOn) {
   31     if (!stages.has(dependency)) throw new Error(`GRAPH_DEPENDENCY_MISSING:${stage.id}:${dependency}`);
   32     if (dependency === stage.id) throw new Error(`GRAPH_SELF_DEPENDENCY:${stage.id}`);
   33     dependents.set(dependency, [...(dependents.get(dependency) ?? []), stage.id]); edges.push(Object.freeze({ from: dependency, to: stage.id }));
   34   }
   35 }
   36 
   37 function addRemediation(stage: StageDefinition, stages: ReadonlyMap<string, StageDefinition>, requesters: Map<string, string>, edges: Edge[]): void {
   38   if (stage.activation && !stages.has(stage.activation.sourceStage)) throw new Error(`GRAPH_ACTIVATION_SOURCE_MISSING:${stage.id}:${stage.activation.sourceStage}`);
   39   if (stage.activation?.sourceStage === stage.id) throw new Error(`GRAPH_SELF_ACTIVATION:${stage.id}`);
   40   const target = stage.on?.request_fix;
   41   if (target !== undefined && !stages.has(target)) throw new Error(`GRAPH_REMEDIATION_MISSING:${stage.id}:${target}`);
   42   if (target === stage.id) throw new Error(`GRAPH_SELF_REMEDIATION:${stage.id}`);
   43   if (target === undefined) return;
   44   requesters.set(target, stage.id); edges.push(Object.freeze({ from: stage.id, to: target }));
   45 }
   46 
   47 function assertAcyclic(stages: ReadonlyMap<string, StageDefinition>): void {
   48   const visiting = new Set<string>(); const visited = new Set<string>();
   49   const visit = (id: string): void => {
   50     if (visiting.has(id)) throw new Error(`GRAPH_CYCLE:${id}`); if (visited.has(id)) return;
   51     visiting.add(id); for (const dependency of stages.get(id)?.dependsOn ?? []) visit(dependency);
   52     visiting.delete(id); visited.add(id);
   53   };
   54   for (const id of stages.keys()) visit(id);
   55 }
   56 
   57 function ancestry(stages: ReadonlyMap<string, StageDefinition>): (stage: string, ancestor: string, seen?: Set<string>) => boolean {
   58   const depends = (stage: string, ancestor: string, seen = new Set<string>()): boolean => {
   59     if (seen.has(stage)) return false; seen.add(stage);
   60     return (stages.get(stage)?.dependsOn ?? []).some((dependency) => dependency === ancestor || depends(dependency, ancestor, seen));
   61   };
   62   return depends;
   63 }
   64 
   65 function validateRemediation(stages: ReadonlyMap<string, StageDefinition>, edges: readonly Edge[], depends: ReturnType<typeof ancestry>): void {
   66   for (const left of edges) for (const right of edges) assertOrderedRequesters(left, right, depends);
   67   for (const { from, to } of edges) {
   68     if (from !== to && !stages.get(to)?.dependsOn.includes(from) && !depends(from, to)) throw new Error(`GRAPH_REMEDIATION_TARGET_UNORDERED:${from}:${to}`);
   69     for (const prerequisite of stages.get(to)?.dependsOn ?? []) {
   70       if (prerequisite !== from && depends(prerequisite, from)) throw new Error(`GRAPH_REMEDIATION_PREREQUISITE_DEADLOCK:${from}:${to}:${prerequisite}`);
   71     }
   72   }
   73 }
   74 
   75 function assertOrderedRequesters(left: Edge, right: Edge, depends: ReturnType<typeof ancestry>): void {
   76   if (left.to === right.to && left.from !== right.from && !depends(left.from, right.from) && !depends(right.from, left.from)) {
   77     throw new Error(`GRAPH_SHARED_REMEDIATION_TARGET:${left.to}:${left.from}:${right.from}`);
   78   }
   79 }
   80 
   81 function validateActivations(stages: ReadonlyMap<string, StageDefinition>, requesters: ReadonlyMap<string, string>, depends: ReturnType<typeof ancestry>): void {
   82   for (const stage of stages.values()) {
   83     if (stage.activation && !depends(stage.id, stage.activation.sourceStage)) throw new Error(`GRAPH_ACTIVATION_SOURCE_NOT_ANCESTOR:${stage.id}:${stage.activation.sourceStage}`);
   84     if (stage.activation && requesters.has(stage.id)) throw new Error(`GRAPH_ACTIVATION_ON_REMEDIATION_TARGET:${stage.id}`);
   85   }
   86 }
   87 
   88 export function buildGraph(input: readonly StageDefinition[]): BuiltGraph {
   89   const stages = stagesById(input); const dependents = new Map<string, string[]>(); const requesters = new Map<string, string>();
   90   validateRepairBudgets(stages);
   91   const ordinaryEdges: Edge[] = []; const remediationEdges: Edge[] = [];
   92   for (const stage of stages.values()) { addDependencies(stage, stages, dependents, ordinaryEdges); addRemediation(stage, stages, requesters, remediationEdges); }
   93   assertAcyclic(stages); const depends = ancestry(stages); validateRemediation(stages, remediationEdges, depends); validateActivations(stages, requesters, depends);
   94   const remediationOnly = new Set(remediationEdges.filter(({ from, to }) => stages.get(to)?.dependsOn.includes(from)).map(({ to }) => to));
   95   for (const target of remediationOnly) { const downstream = dependents.get(target) ?? []; if (downstream.length > 0) throw new Error(`GRAPH_REMEDIATION_TARGET_NOT_LEAF:${target}:${[...downstream].sort().join(',')}`); }
   96   return { stages, dependents, ordinaryEdges, remediationEdges, remediationOnly };
   97 }

