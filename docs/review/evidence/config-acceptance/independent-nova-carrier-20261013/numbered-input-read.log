   10 import { repairIdentityContexts } from './repair-projection.ts';
   11 
   12 function deepFreeze<T>(value: T): T {
   13   if (!value || typeof value !== 'object' || Object.isFrozen(value)) return value;
   14   for (const nested of Object.values(value as Record<string, unknown>)) deepFreeze(nested);
   15   return Object.freeze(value);
   16 }
   17 
   18 export function recoverStageStates(
   19   definition: PipelineDefinition,
   20   records: readonly JournalRecord<LifecycleEvent | PluginDomainEvent>[],
   21   runId: string,
   22   orchestratorIssuerId: string,
   23 ): ReadonlyMap<string, StageRuntimeState> {
   24   const states = initialStageStates(definition);
   25   const identities = repairIdentityContexts(records, runId);
   26   for (const record of records) {
   27     const event = record.entry;
   28     if (event.schemaVersion !== 'lifecycle-event.v2' || event.identity.runId !== runId) continue;
   29     applyRecoveryEvent(definition, states, event, orchestratorIssuerId, identities.get(event));
   30   }
   31   resetInterruptedStages(states);
   32   return new FrozenMap(
   33     [...states].map(([stageId, state]) => [stageId, deepFreeze(structuredClone(state))]),
   34   );
   35 }
   36 
   37 /** A wait projection may be missing after a committed attempt result. Fold the
   38  * same reducer to recover its authoritative creation record and timestamp. */
   39 export function recoverWaitCreation(
   40   definition: PipelineDefinition,
   41   records: readonly JournalRecord<LifecycleEvent | PluginDomainEvent>[],
   42   runId: string,
   43   orchestratorIssuerId: string,
   44   waitId: string,
   45 ): JournalRecord<LifecycleEvent | PluginDomainEvent> | undefined {
   46   const states = initialStageStates(definition);
   47   const identities = repairIdentityContexts(records, runId);
   48   let created: JournalRecord<LifecycleEvent | PluginDomainEvent> | undefined;
   49   for (const record of records) {
   50     const event = record.entry;
   51     if (event.schemaVersion !== 'lifecycle-event.v2' || event.identity.runId !== runId) continue;
   52     const stageId = event.identity.stageId;
   53     const previous = stageId ? states.get(stageId)?.wait?.waitId : undefined;
   54     applyRecoveryEvent(definition, states, event, orchestratorIssuerId, identities.get(event));
   55     if (stageId && previous !== waitId && states.get(stageId)?.wait?.waitId === waitId) created = record;
   56   }
   57   return created;
   58 }

