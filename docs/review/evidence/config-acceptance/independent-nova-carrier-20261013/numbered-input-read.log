    8 type ObjectValue = Record<string, any>;
    9 const compare = (left: string, right: string): number => left < right ? -1 : left > right ? 1 : 0;
   10 
   11 export function projectCoverage(projectId: string, baseRevision: string, modules: readonly ObjectValue[],
   12   test: ObjectValue, integrationRequirements: unknown[] = [], kind: 'module' | 'cumulative' = 'module'): GateCoverageV1 {
   13   const unsigned = { schemaVersion: 'gate-coverage.v1' as const, projectId, kind, baseRevision,
   14     modules: modules.map(module => ({ moduleId: module.id, ownedPaths: [...module.ownedPaths].sort(),
   15       requirements: [...module.requirements].sort((a, b) => compare(String(a.id), String(b.id))) }))
   16       .sort((a, b) => compare(a.moduleId, b.moduleId)),
   17     integrationRequirements, requiredChecks: test.requiredChecks,
   18   };
   19   const coverage = { ...unsigned, policyDigest: gateCoverageDigest(unsigned as Omit<GateCoverageV1, 'policyDigest'>) };
   20   validatePipelineTestGateContract('gateCoverage', coverage);
