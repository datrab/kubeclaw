   35   reviewSemanticMode: ProjectReviewSemanticMode = 'legacy',
   36   deliveryManifestEncoding: ProjectDeliveryManifestMode = 'legacy'): StageDefinition[] {
   37   // Historical archived compilers call this current helper without a fourth arg.
   38   assertProjectReviewModes(reportArtifactEncoding, reviewSemanticMode);
   39   assertProjectDeliveryManifestMode(deliveryManifestEncoding);
