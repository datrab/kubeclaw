  152 /** Product-owned compiler; the lifecycle core remains independent of stage names.
  153  * A project is a single repository publication lane. Explicit pipeline graphs
  154  * retain their existing concurrency semantics.
  155  */
  156 export function compileProject(value: unknown, sourceIdentity: 'legacy' | typeof PORTABLE_JSON_ENCODING = PORTABLE_JSON_ENCODING,
  157   reportArtifactEncoding: 'legacy' | typeof PORTABLE_JSON_ENCODING = PORTABLE_JSON_ENCODING,
  158   reviewSemanticMode: ProjectReviewSemanticMode = 'legacy',
  159   deliveryManifestEncoding: ProjectDeliveryManifestMode = 'legacy'): { runId: string; definition: PipelineDefinition } {
