   75 interface RunSnapshotBase { readonly graph: ExecutionGraphSnapshot; readonly registry: Readonly<Record<string, unknown>>; readonly digest: string }
   76 export type RunSnapshot = RunSnapshotBase & (
   77   { readonly schemaVersion: 'run-snapshot.v1' | 'run-snapshot.v2'; readonly runtimeDispatchProfile?: never; readonly reviewCacheProfile?: never }
