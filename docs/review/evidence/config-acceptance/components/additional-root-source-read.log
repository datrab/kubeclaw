96: export function configuredWorkerRuntime(options: TestPlanRunnerOptions,
97:   workerLocalRuntime: LocalWorkerRuntimePolicy, now: () => Date): WorkerAttemptRuntime {
98:     if (options.workerRuntime) {
99:       return options.workerRuntime;
100:     } else {
101:       const runtime = new LocalWorkerRuntime({
102:         workerId: "worker:buster:local",
103:         workerType: "buster",
104:         coreVersion: "1.0.0",
105:         protocolVersions: ["worker-protocol.v1"],
106:         profiles: createBusterWorkerProfiles(
107:           options.plan,
108:           options.registry,
109:           options.grants,
110:         ),
111:         capacity: options.maximumConcurrency,
112:         drainTimeoutMs: workerLocalRuntime.drainTimeoutMs,
113:         cancellationTimeoutMs: workerLocalRuntime.cancellationTimeoutMs,
114:         replayLimit: workerLocalRuntime.replayLimit,
115:         now,
116:       });
117:       runtime.markReady();
118:       return runtime;
119:     }
120: }

