SOURCE contracts/pipeline-worker-core/v1/src/trust.ts SHA256 c650fdbe7f43b422f36d050df291d2a00fdd4bc694a1dae5d6236b4814743cd5
1: import crypto from 'node:crypto';
2: import { canonicalJson } from './digest.ts';
3: import type { WorkerTrustEnvelopeV1 } from './types.ts';
4: 
5: export type UnsignedWorkerTrustEnvelopeV1 = Omit<WorkerTrustEnvelopeV1, 'algorithm' | 'signature'>;
6: 
7: function signingMessage(value: UnsignedWorkerTrustEnvelopeV1 | WorkerTrustEnvelopeV1): Buffer {
8:   const { algorithm: _algorithm, signature: _signature, ...unsigned } = value as WorkerTrustEnvelopeV1;
9:   return Buffer.from(`kubeclaw-worker-trust-v1\0${canonicalJson(unsigned)}`, 'utf8');
10: }
11: 
12: export function signWorkerTrustEnvelope(
13:   value: UnsignedWorkerTrustEnvelopeV1,
14:   privateKey: crypto.KeyLike,
15: ): WorkerTrustEnvelopeV1 {
16:   const key = privateKey instanceof crypto.KeyObject ? privateKey : crypto.createPrivateKey(privateKey);
17:   if (key.asymmetricKeyType !== 'ed25519') throw new Error('WORKER_TRUST_PRIVATE_KEY_INVALID');
18:   return Object.freeze({
19:     ...value,
20:     algorithm: 'ed25519',
21:     signature: crypto.sign(null, signingMessage(value), key).toString('base64'),
22:   });
23: }
24: 
25: export function verifyWorkerTrustEnvelope(
26:   value: WorkerTrustEnvelopeV1,
27:   publicKey: crypto.KeyLike,
28:   expected: Readonly<{ issuer: string; audience: string; purpose: string }>,
29:   now = Date.now(),
30: ): boolean {
31:   const issuedAt = Date.parse(value.issuedAt);
32:   const expiresAt = Date.parse(value.expiresAt);
33:   if (value.schemaVersion !== 'worker-trust-envelope.v1' || value.algorithm !== 'ed25519'
34:     || value.issuer !== expected.issuer || value.audience !== expected.audience
35:     || value.purpose !== expected.purpose || !Number.isFinite(issuedAt) || !Number.isFinite(expiresAt)
36:     || expiresAt <= issuedAt || issuedAt > now || expiresAt <= now) return false;
37:   try {
38:     const key = publicKey instanceof crypto.KeyObject ? publicKey : crypto.createPublicKey(publicKey);
39:     return key.asymmetricKeyType === 'ed25519'
40:       && crypto.verify(null, signingMessage(value), key, Buffer.from(value.signature, 'base64'));
41:   } catch {
42:     return false;
43:   }
44: }

