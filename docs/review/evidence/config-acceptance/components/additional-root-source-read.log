144: function preflightJson(value: unknown, byteLimit: number, prefix: string): void {
145:   const pending: Array<{ value: unknown; depth: number }> = [{ value, depth: 0 }];
146:   const seen = new WeakSet<object>();
147:   let bytes = 0;
148:   let nodes = 0;
149:   while (pending.length > 0) {
150:     const current = pending.pop()!;
151:     nodes += 1;
152:     if (nodes > MAX_ATTEMPT_VALUE_NODES) throw new Error(`${prefix}_NODE_LIMIT`);
153:     if (current.depth > MAX_ATTEMPT_VALUE_DEPTH) throw new Error(`${prefix}_DEPTH_LIMIT`);
154:     if (typeof current.value === 'string') bytes += jsonStringBytes(current.value);
155:     else if (current.value === null) bytes += 4;
156:     else if (typeof current.value === 'number' || typeof current.value === 'boolean') {
157:       const encoded = JSON.stringify(current.value);
158:       if (encoded === undefined) throw new Error(`${prefix}_TYPE_INVALID`);
159:       bytes += Buffer.byteLength(encoded);
160:     }
161:     else if (typeof current.value === 'object') {
162:       if (seen.has(current.value)) throw new Error(`${prefix}_CYCLE`);
163:       seen.add(current.value);
164:       if (Array.isArray(current.value)) {
165:         bytes += 2 + Math.max(0, current.value.length - 1);
166:         for (const child of current.value) pending.push({ value: child, depth: current.depth + 1 });
167:       } else {
168:         const prototype = Object.getPrototypeOf(current.value);
169:         if (prototype !== Object.prototype && prototype !== null) throw new Error(`${prefix}_TYPE_INVALID`);
170:         const keys = Reflect.ownKeys(current.value);
171:         bytes += 2 + Math.max(0, keys.length - 1);
172:         for (const key of keys) {
173:           if (typeof key !== 'string') throw new Error(`${prefix}_TYPE_INVALID`);
174:           const descriptor = Object.getOwnPropertyDescriptor(current.value, key);
175:           if (!descriptor?.enumerable || !('value' in descriptor)) throw new Error(`${prefix}_TYPE_INVALID`);
176:           bytes += jsonStringBytes(key) + 1;
177:           pending.push({ value: descriptor.value, depth: current.depth + 1 });
178:         }
179:       }
180:     } else {
181:       throw new Error(`${prefix}_TYPE_INVALID`);
182:     }
183:     if (bytes > byteLimit) throw new Error(`${prefix}_BYTE_LIMIT`);
184:   }
185: }
