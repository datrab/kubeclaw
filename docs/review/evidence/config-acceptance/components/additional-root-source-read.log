25:     "timestamp": {
26:       "type": "string",
27:       "format": "date-time"
28:     },
29:     "protocolVersion": {
30:       "const": "worker-protocol.v1"
31:     },
32:     "supportedProtocolVersion": {
33:       "type": "string",
34:       "pattern": "^worker-protocol\\.v[1-9][0-9]*$",
35:       "maxLength": 64
36:     },
37:     "jsonValue": {
38:       "oneOf": [
39:         { "type": "null" },
40:         { "type": "boolean" },
41:         { "type": "number" },
42:         { "type": "string" },
43:         {
44:           "type": "array",
45:           "maxItems": 1024,
46:           "items": { "$ref": "#/$defs/jsonValue" }
47:         },
48:         {
49:           "type": "object",
50:           "maxProperties": 256,
51:           "additionalProperties": { "$ref": "#/$defs/jsonValue" }
52:         }
53:       ]
54:     },
55:     "jsonObject": {
56:       "type": "object",
57:       "maxProperties": 256,
58:       "additionalProperties": { "$ref": "#/$defs/jsonValue" }
59:     },
60:     "workerLifecycleState": {
61:       "enum": ["starting", "ready", "draining", "stopped", "unhealthy"]
62:     },
63:     "workerTrustEnvelope": {
64:       "type": "object",
65:       "additionalProperties": false,
66:       "required": ["schemaVersion", "kind", "issuer", "audience", "purpose", "subjectDigest", "contextDigest", "issuedAt", "expiresAt", "nonce", "keyId", "algorithm", "signature"],
67:       "properties": {
68:         "schemaVersion": { "const": "worker-trust-envelope.v1" },
69:         "kind": { "enum": ["request", "artifact"] },
70:         "issuer": { "type": "string", "pattern": "^spiffe://[a-z0-9.-]+/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$", "maxLength": 512 },
71:         "audience": { "type": "string", "pattern": "^spiffe://[a-z0-9.-]+/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$", "maxLength": 512 },
72:         "purpose": { "$ref": "#/$defs/stableId" },
73:         "subjectDigest": { "$ref": "#/$defs/digest" },
74:         "contextDigest": { "$ref": "#/$defs/digest" },
75:         "issuedAt": { "$ref": "#/$defs/timestamp" },
76:         "expiresAt": { "$ref": "#/$defs/timestamp" },
77:         "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$" },
78:         "keyId": { "$ref": "#/$defs/stableId" },
79:         "algorithm": { "const": "ed25519" },
80:         "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
