122: function jsonStringBytes(value: string): number {
123:   let bytes = 2;
124:   for (let index = 0; index < value.length; index += 1) {
125:     const unit = value.charCodeAt(index);
126:     if (unit === 0x22 || unit === 0x5c || unit === 0x08 || unit === 0x09 || unit === 0x0a
127:       || unit === 0x0c || unit === 0x0d) {
128:       bytes += 2;
129:     } else if (unit <= 0x1f) {
130:       bytes += 6;
131:     } else if (unit >= 0xd800 && unit <= 0xdbff && index + 1 < value.length
132:       && value.charCodeAt(index + 1) >= 0xdc00 && value.charCodeAt(index + 1) <= 0xdfff) {
133:       bytes += 4;
134:       index += 1;
135:     } else if (unit >= 0xd800 && unit <= 0xdfff) {
136:       bytes += 6;
137:     } else {
138:       bytes += Buffer.byteLength(value[index]!);
139:     }
140:   }
141:   return bytes;
142: }
