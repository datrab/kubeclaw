1: {
2:   "$schema": "https://json-schema.org/draft/2020-12/schema",
3:   "$id": "https://kubeclaw.dev/contracts/pipeline-worker-core/v1/schema.json",
4:   "title": "KubeClaw pipeline worker-core contracts v1",
5:   "$defs": {
