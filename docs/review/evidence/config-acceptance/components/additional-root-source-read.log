91: export class LocalWorkerRuntime {
92:   readonly #options: Readonly<ResolvedLocalWorkerRuntimeOptions>;
93:   readonly #profiles: readonly WorkerProfileV1[];
94:   readonly #protocolVersions: readonly WorkerProtocolVersion[];
95:   readonly #profileDigests: ReadonlySet<string>;
96:   readonly #now: () => Date;
97:   readonly #startedAt: string;
98:   readonly #active = new Map<string, ActiveAttempt>();
99:   readonly #acceptedAttemptIds = new Map<string, number>();
100:   #state: WorkerLifecycleState = 'starting';
101:   #healthSequence = 0;
102:   #draining: Promise<void> | null = null;
103: 
104:   constructor(options: LocalWorkerRuntimeOptions) {
105:     if (!Number.isSafeInteger(options.capacity) || options.capacity < 1 || options.capacity > 4096) {
106:       throw new Error('WORKER_LOCAL_CAPACITY_INVALID');
107:     }
108:     const { drainTimeoutMs, cancellationTimeoutMs, replayLimit } = validateLocalWorkerRuntimePolicy(options);
109:     this.#profiles = freeze(structuredClone([...options.profiles]));
110:     this.#protocolVersions = freeze([...new Set(options.protocolVersions)].sort());
111:     this.#profileDigests = new Set(this.#profiles.map((profile) => profile.profileDigest));
112:     this.#now = options.now ?? (() => new Date());
