111: export async function readDurableState<T>(
112:   file: string,
113:   fallback: T,
114:   maximumBytes?: number,
115: ): Promise<T> {
116:   try {
117:     if (maximumBytes === undefined) return JSON.parse(await fs.readFile(file, "utf8")) as T;
118:     return JSON.parse(await readBoundedSnapshot(file, maximumBytes)) as T;
119:   } catch (error) {
120:     if ((error as NodeJS.ErrnoException).code === "ENOENT")
121:       return structuredClone(fallback);
122:     throw error;
123:   }
124: }
125: async function syncDirectory(directory: string): Promise<void> {
126:   const handle = await fs.open(directory, "r");
127:   try {
128:     await handle.sync();
129:   } finally {
130:     await handle.close();
131:   }
132: }
133: export async function ensureDirectoryDurable(directory: string): Promise<void> {
134:   const resolved = path.resolve(directory);
135:   const root = path.parse(resolved).root;
136:   const parts = path.relative(root, resolved).split(path.sep).filter(Boolean);
137:   let current = root;
138:   for (const part of parts) {
139:     current = path.join(current, part);
140:     try {
141:       const stat = await fs.lstat(current);
142:       if (stat.isSymbolicLink())
143:         throw new Error("OBSERVABILITY_STORE_PATH_SYMLINK");
144:       if (!stat.isDirectory())
145:         throw new Error("OBSERVABILITY_STORE_PATH_NOT_DIRECTORY");
146:     } catch (error) {
147:       if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
148:       try {
149:         await fs.mkdir(current);
150:       } catch (mkdirError) {
151:         if ((mkdirError as NodeJS.ErrnoException).code !== "EEXIST")
152:           throw mkdirError;
153:       }
154:       const created = await fs.lstat(current);
155:       if (created.isSymbolicLink())
156:         throw new Error("OBSERVABILITY_STORE_PATH_SYMLINK");
157:       if (!created.isDirectory())
158:         throw new Error("OBSERVABILITY_STORE_PATH_NOT_DIRECTORY");
159:       await syncDirectory(path.dirname(current));
160:     }
161:   }
162: }
163: export async function writeDurableState(
164:   file: string,
165:   value: unknown,
166: ): Promise<void> {
167:   await ensureDirectoryDurable(path.dirname(file));
168:   const temporary = `${file}.${process.pid}.${randomUUID()}.tmp`;
169:   let renamed = false;
170:   try {
171:     const handle = await fs.open(temporary, "wx", 0o600);
172:     try {
173:       await handle.writeFile(canonicalJson(value));
174:       await handle.sync();
175:     } finally {
176:       await handle.close();
177:     }
178:     await fs.rename(temporary, file);
179:     renamed = true;
180:     await syncDirectory(path.dirname(file));
181:   } finally {
182:     if (!renamed) await fs.unlink(temporary).catch(() => undefined);
183:   }
184: }
185: async function acquireKernelLock(
186:   lockFile: string,
187: ): Promise<() => Promise<void>> {
188:   const child = spawn(
189:     "/usr/bin/flock",
190:     [
191:       "--exclusive",
192:       "--timeout",
193:       "5",
194:       lockFile,
195:       "/bin/sh",
196:       "-c",
197:       "printf 'locked\\n'; exec /bin/cat >/dev/null",
198:     ],
199:     { stdio: ["pipe", "pipe", "pipe"] },
200:   );
201:   let error = "";
202:   child.stderr?.on("data", (chunk: Buffer) => {
203:     error += chunk.toString("utf8");
204:   });
205:   const exited = new Promise<number | null>((resolve, reject) => {
206:     child.once("error", reject);
207:     child.once("exit", resolve);
208:   });
209:   await new Promise<void>((resolve, reject) => {
210:     let output = "";
211:     child.stdout?.on("data", (chunk: Buffer) => {
212:       output += chunk.toString("utf8");
213:       if (output.includes("locked\n")) resolve();
214:     });
215:     child.once("error", reject);
216:     child.once("exit", (code) => {
217:       if (!output.includes("locked\n"))
218:         reject(new Error(`OBSERVABILITY_STORE_LOCKED:${code}:${error.trim()}`));
219:     });
220:   });
221:   return async () => {
222:     child.stdin?.end();
223:     const code = await exited;
224:     if (code !== 0)
225:       throw new Error(
226:         `OBSERVABILITY_STORE_UNLOCK_FAILED:${code}:${error.trim()}`,
227:       );
228:   };
229: }
230: async function cleanupCrashArtifacts(
231:   directory: string,
232:   file: string,
233: ): Promise<void> {
234:   const basename = path.basename(file);
235:   for (const entry of await fs.readdir(directory, { withFileTypes: true })) {
236:     if (
237:       entry.isFile() &&
238:       entry.name.startsWith(`${basename}.`) &&
239:       entry.name.endsWith(".tmp")
240:     )
241:       await fs.unlink(path.join(directory, entry.name)).catch(() => undefined);
242:   }
243: }
244: export async function withDurableStoreLock<T>(
245:   file: string,
246:   operation: () => Promise<T>,
247: ): Promise<T> {
248:   const directory = path.dirname(file);
249:   await ensureDirectoryDurable(directory);
250:   const lockFile = path.join(directory, ".write-lock");
251:   const handle = await fs.open(lockFile, "a+", 0o600);
252:   try {
253:     const stat = await handle.stat();
254:     if (!stat.isFile() || stat.nlink !== 1)
255:       throw new Error("OBSERVABILITY_STORE_LOCK_FILE_INVALID");
256:   } finally {
257:     await handle.close();
258:   }
259:   let release: () => Promise<void>;
260:   try {
261:     release = await acquireKernelLock(lockFile);
262:   } catch (error) {
263:     throw new Error(
264:       `OBSERVABILITY_STORE_LOCK_FAILED:${file}:${error instanceof Error ? error.message : String(error)}`,
265:     );
266:   }
267:   try {
268:     await cleanupCrashArtifacts(directory, file);
269:     return await operation();
270:   } finally {
271:     await release();
272:   }
273: }
274: function keyOf(record: ProducerRecordV1): string {
275:   return [
276:     record.producer.producerId,
277:     record.producer.bootId,
278:     record.producer.producerType,
279:     record.correlation.pipelineRunId,
280:     String(record.sequence),
281:   ].join("|");
282: }
283: function validLimit(value: number): boolean {
284:   return Number.isSafeInteger(value) && value > 0;
285: }
286: function validIdentityPart(value: unknown): value is string {
287:   return (
288:     typeof value === "string" &&
289:     value.length >= 1 &&
290:     value.length <= 256 &&
291:     /^[A-Za-z0-9][A-Za-z0-9._:-]*$/.test(value)
292:   );
293: }
294: function quarantineAttribution(
295:   raw: Uint8Array | string,
296: ): AdmissionState["unresolvedItems"][number] | null {
297:   try {
298:     const bytes = Buffer.from(raw);
299:     const decoded = JSON.parse(bytes.toString("utf8")) as {
300:       producer?: Record<string, unknown>;
301:       correlation?: { pipelineRunId?: string };
302:       recordId?: string;
303:     };
304:     if (
305:       !decoded.producer ||
306:       !validIdentityPart(decoded.producer.producerId) ||
307:       !validIdentityPart(decoded.producer.bootId) ||
308:       !validIdentityPart(decoded.producer.producerType) ||
309:       !validIdentityPart(decoded.correlation?.pipelineRunId)
310:     )
311:       return null;
312:     const producer = {
313:       producerId: decoded.producer.producerId,
314:       bootId: decoded.producer.bootId,
315:       producerType: decoded.producer.producerType,
316:     };
317:     const rawDigest = createHash("sha256").update(bytes).digest("hex");
318:     return {
319:       itemId: `quarantine:${rawDigest}`,
320:       kind: "quarantined-record",
321:       producer,
322:       subjectId: validIdentityPart(decoded.recordId)
323:         ? decoded.recordId
324:         : `record:${rawDigest}`,
325:       reasonCode: "record-quarantined",
326:       pipelineRunId: decoded.correlation.pipelineRunId,
327:     };
328:   } catch {
329:     return null;
330:   }
331: }
