615:   async #terminate(operation: WorkerAttemptOperation<E>, timeoutMs: number): Promise<string | null> {
616:     let timer: NodeJS.Timeout | undefined;
617:     try {
618:       return await Promise.race([
619:         Promise.resolve().then(() => operation.terminate()).then(() => null, (error: unknown) => detail(error)),
620:         new Promise<string>((resolve) => {
621:           timer = setTimeout(() => resolve('WORKER_TERMINATION_TIMEOUT'), timeoutMs);
622:         }),
623:       ]);
624:     } finally {
625:       if (timer) clearTimeout(timer);
626:     }
627:   }
