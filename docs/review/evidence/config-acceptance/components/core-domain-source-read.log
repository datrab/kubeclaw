31: export interface WorkerOwnershipRecord {
32:   readonly identity: WorkerOwnershipIdentity;
33:   readonly scopeName: string;
34:   readonly revision: number;
35:   readonly phase: WorkerOwnershipPhase;
36:   readonly binding: WorkerScopeBinding | null;
37:   readonly diagnosis: string | null;
38:   readonly finalObservation: NativeWorkerResourceObservation | null;
39:   readonly topology: WorkerScopeTopology;
40: }
