37: /** Build a closed child environment from the startup snapshot, never process.env. */
38: export function nativePrismCommand(native: ReturnType<typeof nativePrismSupervisorConfig>, config: ReturnType<typeof loadWorkerConfig>) {
39:   return { launcher: native.launcher, uid: native.uid, gid: native.gid, executable: process.execPath,
40:     arguments: [fileURLToPath(new URL('./native-worker-host.ts', import.meta.url))], cwd: process.cwd(),
41:     environment: { PATH: '/usr/local/bin:/usr/bin:/bin', HOME: '/tmp', NODE_ENV: 'production',
42:       PRISM_ENGINE_CONTENT_DIGEST: native.engineContentDigest,
43:       PLAYWRIGHT_BROWSERS_PATH: native.browserPath, PRISM_CONTROL_INTERNAL_URL: config.controlInternalUrl.toString(),
44:       PRISM_WORKER_SECRET: config.workerSecret, WORKER_TRUST_SPIFFE_ENABLED: String(config.spiffeEnabled),
45:       PRISM_NATIVE_ASSIGNED_INPUT_BYTES: String(native.maximumInputBytes) },
46:   };
47: }

SOURCE skills/prism/server/native-worker-host.ts SHA256 485118712479bd2991724c4787acb4bf111ddd56866d0d584f608482a3b4ba34
1: import { WorkerAttemptExecutor } from '@kubeclaw/worker-core';
2: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { PrismEngine, DeterministicDesignProvider } from '../engine/index.ts';
4: import { WorkerArtifactClient } from './worker-artifacts.ts';
5: import { nativeOperationFor } from './worker-operation.ts';
6: import { nativePrismHostConfig } from '../config/native-worker.ts';
7: 
8: const cancellation = new AbortController();
9: const cancel = () => cancellation.abort(new Error('WORKER_ATTEMPT_CANCELLED'));
10: process.once('SIGTERM', cancel); process.once('SIGINT', cancel);
11: 
12: async function main(): Promise<void> {
13: const config = nativePrismHostConfig();
14: const chunks: Buffer[] = [];
15: let bytes = 0;
16: for await (const chunk of process.stdin) {
17:   bytes += chunk.length;
18:   if (bytes > config.maximumInputBytes) throw new Error('PRISM_NATIVE_INPUT_LIMIT');
19:   chunks.push(Buffer.from(chunk));
20: }
21: const envelope = JSON.parse(Buffer.concat(chunks).toString('utf8')) as WorkerAttemptEnvelopeV3;
22: validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
23: const artifacts = new WorkerArtifactClient(config.controlInternalUrl, config.workerSecret, config.spiffeEnabled);
24: const engine = new PrismEngine(new DeterministicDesignProvider());
25: const result = await new WorkerAttemptExecutor({ envelope, signal: cancellation.signal,
26:   operation: nativeOperationFor(envelope, engine, artifacts, config.scope), receiptNamespace: 'prism-native-provisional',
27:   storeFullLog(attemptId, content, { signal }) {
28:     if (attemptId !== envelope.attemptId) throw new Error('Prism log attempt identity mismatch');
29:     return artifacts.upload('prism-full-log', 'log', 'text/plain', Buffer.from(content), signal);
30:   },
31: }).execute();
32: // Closing stdout is not the completion boundary: the supervisor drains the tree and reseals.
33: process.stdout.write(JSON.stringify(result));
34: }
35: try { await main(); }
36: finally { process.removeListener('SIGTERM', cancel); process.removeListener('SIGINT', cancel); }

