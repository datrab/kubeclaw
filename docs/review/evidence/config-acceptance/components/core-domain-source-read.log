15: export interface DurableRecordLimits {
16:   readonly maximumRecords: number;
17:   readonly maximumBytes: number;
18:   readonly maximumRecordBytes: number;
19: }
20: 
21: export interface DurableRecordStore {
22:   append<T>(stream: string, idempotencyKey: string, payload: T, owner?: string): Promise<{
23:     readonly appended: boolean;
24:     readonly record: DurableRecord<T>;
25:   }>;
26:   transition<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string, payload: T): Promise<DurableRecord<T>>;
27:   read<T>(stream: string): Promise<ReadonlyArray<DurableRecord<T>>>;
28: }
29: 
30: const EMPTY_STATE: DurableRecordState = {
31:   schemaVersion: "pipeline-durable-record-store.v1",
32:   records: [],
33: };
34: const IDENTITY = /^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$/;
35: const DIGEST = /^sha256:[a-f0-9]{64}$/;
36: 
37: function positiveInteger(value: number, code: string): void {
38:   if (!Number.isSafeInteger(value) || value < 1) throw new Error(code);
39: }
40: 
41: function identity(value: string, code: string): void {
42:   if (!IDENTITY.test(value)) throw new Error(code);
43: }
44: 
45: 
46: export class FileDurableRecordStore implements DurableRecordStore {
47:   readonly #file: string;
48:   readonly #limits: DurableRecordLimits;
49:   #queue: Promise<unknown> = Promise.resolve();
50: 
51:   constructor(root: string, limits: DurableRecordLimits) {
52:     positiveInteger(limits.maximumRecords, "DURABLE_RECORD_LIMIT_INVALID");
53:     positiveInteger(limits.maximumBytes, "DURABLE_RECORD_LIMIT_INVALID");
54:     positiveInteger(limits.maximumRecordBytes, "DURABLE_RECORD_LIMIT_INVALID");
55:     this.#file = path.join(path.resolve(root), "records", "store.json");
56:     this.#limits = limits;
57:   }
58: 
59:   #serial<T>(operation: () => Promise<T>): Promise<T> {
60:     const locked = () => withDurableStoreLock(this.#file, operation);
61:     const result = this.#queue.then(locked, locked);
62:     this.#queue = result.then(() => undefined, () => undefined);
63:     return result;
64:   }
65: 
66:   async append<T>(stream: string, idempotencyKey: string, payload: T, owner?: string): Promise<{
67:     readonly appended: boolean;
68:     readonly record: DurableRecord<T>;
69:   }> {
70:     identity(stream, "DURABLE_RECORD_STREAM_INVALID");
71:     identity(idempotencyKey, "DURABLE_RECORD_IDEMPOTENCY_KEY_INVALID");
72:     if (owner !== undefined && !ownerValid(owner)) throw new Error("DURABLE_RECORD_OWNER_INVALID");
73:     const snapshot = JSON.parse(canonicalJson(payload)) as T;
74:     const digest = payloadDigest(snapshot);
75:     if (Buffer.byteLength(canonicalJson(snapshot)) > this.#limits.maximumRecordBytes)
76:       throw new Error("DURABLE_RECORD_SIZE_EXCEEDED");
77:     return this.#serial(async () => {
78:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes);
79:       assertDurableRecordReplay(state);
80:       const duplicate = existingRecord(state, stream, idempotencyKey, digest, snapshot, owner);
81:       if (duplicate) return { appended: false, record: duplicate };
82:       if (state.records.length >= this.#limits.maximumRecords)
83:         throw new Error("DURABLE_RECORD_STORE_FULL");
84:       const record: DurableRecord<T> = {
85:         schemaVersion: owner === undefined ? "pipeline-durable-record.v1" : "pipeline-durable-record.v2",
86:         ...(owner === undefined ? {} : { owner }),
87:         stream,
88:         sequence: state.records.filter((entry) => entry.stream === stream).length + (state.tombstones?.filter(entry => entry.stream === stream).length ?? 0) + 1,
89:         idempotencyKey,
90:         committedAt: new Date().toISOString(),
91:         payloadDigest: digest,
92:         payload: snapshot,
93:       };
94:       const candidate: DurableRecordState = owner === undefined ? { ...state, records: [...state.records, record] }
95:         : { ...state, schemaVersion: 'pipeline-durable-record-store.v2', records: [...state.records, record], tombstones: state.tombstones ?? [], retirements: state.retirements ?? [] };
96:       if (Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes)
97:         throw new Error("DURABLE_RECORD_STORE_FULL");
98:       await writeDurableState(this.#file, candidate);
99:       return { appended: true, record: structuredClone(record) };
100:     });
101:   }
102: 
103:   async read<T>(stream: string): Promise<ReadonlyArray<DurableRecord<T>>> {
104:     return this.withRecords<T, ReadonlyArray<DurableRecord<T>>>(stream, async records => records);
105:   }
106: 
107:   /** Domain owners may inspect records while holding this store's writer fence.
108:    * Never reenter this store from operation; acquire other stores in a fixed order. */
109:   async withRecords<T, R>(stream: string, operation: (records: ReadonlyArray<DurableRecord<T>>) => Promise<R>): Promise<R> {
110:     identity(stream, "DURABLE_RECORD_STREAM_INVALID");
111:     return this.#serial(async () => operation(await readStoreRecords<T>(this.#file, this.#limits.maximumBytes, stream)));
112:   }
113: 
114:   async retirements(stream: string): Promise<readonly RecordRetirement[]> {
115:     identity(stream, 'DURABLE_RECORD_STREAM_INVALID');
116:     return this.#serial(async () => {
117:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes); assertDurableRecordReplay(state);
118:       return structuredClone((state.retirements ?? []).filter(entry => entry.intent.stream === stream));
119:     });
120:   }
121: 
122:   /** Caller holds its domain fence; authorize runs again inside the real store writer fence. */
123:   async retire(intentInput: RecordRetirementIntent, authorize: (records: readonly DurableRecord[]) => Promise<void>): Promise<RecordRetirement & { readonly newlyRetired: boolean; readonly releasedBytes: number }> {
124:     const intent = JSON.parse(canonicalJson(intentInput)) as RecordRetirementIntent; assertRetirementIntent(intent);
125:     const intentDigest = payloadDigest(intent);
126:     return this.#serial(async () => {
127:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes); assertDurableRecordReplay(state);
128:       const previous = state.retirements?.find(item => item.intent.operationId === intent.operationId);
129:       if (previous) {
130:         if (previous.intentDigest !== intentDigest) throw new Error('DURABLE_RETIREMENT_CONFLICT');
131:         await authorize([]);
132:         return { ...structuredClone(previous), newlyRetired: false, releasedBytes: Number.parseInt(previous.releasedBytesHex,16) };
133:       }
134:       const selected = intent.records.map(item => {
135:         const record = state.records.find(entry => entry.stream === intent.stream && entry.idempotencyKey === item.idempotencyKey);
136:         if (!record || record.schemaVersion !== 'pipeline-durable-record.v2' || record.owner !== intent.owner
137:           || record.payloadDigest !== item.payloadDigest) throw new Error('DURABLE_RETIREMENT_RECORD_CHANGED');
138:         return record;
139:       });
140:       await authorize(structuredClone(selected));
141:       const selectedIds = new Set(selected.map(record => record.idempotencyKey));
142:       const retirement = { intent, intentDigest, releasedBytesHex: '0000000000000000' };
143:       const candidate: DurableRecordState = {
144:         schemaVersion: 'pipeline-durable-record-store.v2',
145:         records: state.records.filter(record => record.stream !== intent.stream || !selectedIds.has(record.idempotencyKey)),
146:         tombstones: [...state.tombstones ?? [], ...selected.map(record => {
147:           const { payload: _payload, ...header } = record; return { ...header, retirementId: intent.operationId };
148:         })], retirements: [...state.retirements ?? [], retirement],
149:       };
150:       const before = Buffer.byteLength(canonicalJson(state));
151:       // Fixed-width hex avoids a self-referential decimal digit-count equation.
152:       const releasedBytes = before - Buffer.byteLength(canonicalJson(candidate));
153:       if (releasedBytes < 1) throw new Error('DURABLE_RETIREMENT_NO_SAVING');
154:       retirement.releasedBytesHex = releasedBytes.toString(16).padStart(16,'0');
155:       assertDurableRecordReplay(candidate);
156:       if (Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes) throw new Error('DURABLE_RECORD_STORE_FULL');
157:       await writeDurableState(this.#file, candidate);
158:       return { ...structuredClone(retirement), newlyRetired: true, releasedBytes };
159:     });
160:   }
161: 
162:   async transition<T>(
163:     stream: string,
164:     idempotencyKey: string,
165:     expectedPayloadDigest: string,
166:     payload: T,
167:     authorize?: (records: ReadonlyArray<DurableRecord>) => void,
168:   ): Promise<DurableRecord<T>> {
169:     const { snapshot, digest } = this.#transitionCandidate(stream, idempotencyKey, expectedPayloadDigest, payload);
170:     return this.#serial(() => this.#transitionLocked(stream, idempotencyKey, expectedPayloadDigest, snapshot, digest, authorize));
171:   }
172: 
173:   /** Hold the owner writer before its retained dependency writer through the
174:    * original durable transition. Domain callers must use one fixed store order. */
175:   async transitionWithRetainedStore<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string,
176:     payload: T, retained: FileDurableRecordStore, retainedStream: string,
177:     authorize: (records: ReadonlyArray<DurableRecord>, retainedRecords: ReadonlyArray<DurableRecord>) => void,
178:   ): Promise<DurableRecord<T>> {
179:     const { snapshot, digest } = this.#transitionCandidate(stream, idempotencyKey, expectedPayloadDigest, payload);
180:     return this.#withRetainedStore(retained, retainedStream, retainedRecords =>
181:       this.#transitionLocked(stream, idempotencyKey, expectedPayloadDigest, snapshot, digest,
182:         records => authorize(records, retainedRecords)));
183:   }
184: 
185:   /** Read-owned snapshots with the same fixed two-store fence as a retained transition. */
186:   async withRetainedRecords<T, R>(stream: string, retained: FileDurableRecordStore, retainedStream: string,
187:     operation: (records: readonly DurableRecord<T>[], retainedRecords: readonly DurableRecord[]) => Promise<R>,
188:   ): Promise<R> {
189:     identity(stream, 'DURABLE_RECORD_STREAM_INVALID');
190:     return this.#withRetainedStore(retained, retainedStream, async records =>
191:       operation(await readStoreRecords<T>(this.#file, this.#limits.maximumBytes, stream), records));
192:   }
193: 
194:   #withRetainedStore<R>(retained: FileDurableRecordStore, stream: string, operation: (records: readonly DurableRecord[]) => Promise<R>): Promise<R> {
195:     identity(stream, 'DURABLE_RECORD_STREAM_INVALID');
196:     return withRetainedStoreFence({ ownerFile: this.#file, retainedFile: retained.#file,
197:       owner: callback => this.#serial(callback), retained: callback => retained.withRecords(stream, callback) }, operation);
198:   }
199: 
200:   #transitionCandidate<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string, payload: T): { snapshot: T; digest: string } {
201:     identity(stream, "DURABLE_RECORD_STREAM_INVALID");
202:     identity(idempotencyKey, "DURABLE_RECORD_IDEMPOTENCY_KEY_INVALID");
203:     if (!DIGEST.test(expectedPayloadDigest)) throw new Error("DURABLE_RECORD_DIGEST_INVALID");
204:     const snapshot = JSON.parse(canonicalJson(payload)) as T;
205:     const digest = payloadDigest(snapshot);
206:     if (Buffer.byteLength(canonicalJson(snapshot)) > this.#limits.maximumRecordBytes)
207:       throw new Error("DURABLE_RECORD_SIZE_EXCEEDED");
208:     return { snapshot, digest };
209:   }
210: 
211:   async #transitionLocked<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string,
212:     snapshot: T, digest: string, authorize?: (records: ReadonlyArray<DurableRecord>) => void,
213:   ): Promise<DurableRecord<T>> {
214:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes);
215:       assertDurableRecordReplay(state);
216:       const index = state.records.findIndex(
217:         (record) => record.stream === stream && record.idempotencyKey === idempotencyKey,
218:       );
219:       if (index < 0) {
220:         if (state.tombstones?.some(record => record.stream === stream && record.idempotencyKey === idempotencyKey)) throw new Error('DURABLE_RECORD_RETIRED');
221:         throw new Error("DURABLE_RECORD_NOT_FOUND");
222:       }
223:       const existing = state.records[index];
224:       if (!existing) throw new Error("DURABLE_RECORD_NOT_FOUND");
225:       if (existing.payloadDigest !== expectedPayloadDigest)
226:         throw new Error("DURABLE_RECORD_TRANSITION_CONFLICT");
227:       const record: DurableRecord<T> = {
228:         ...existing,
229:         committedAt: new Date().toISOString(),
230:         payloadDigest: digest,
231:         payload: snapshot,
232:       };
233:       const next = [...state.records];
234:       next[index] = record;
235:       const candidate: DurableRecordState = { ...state, records: next };
236:       if (Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes)
237:         throw new Error("DURABLE_RECORD_STORE_FULL");
238:       // The domain fence is already held; the final check must not yield or
239:       // reenter this store between its CAS comparison and durable write.
240:       if (authorize?.(structuredClone(state.records)) !== undefined) throw new Error('DURABLE_RECORD_AUTHORIZATION_NOT_SYNCHRONOUS');
241:       await writeDurableState(this.#file, candidate);
242:       return structuredClone(record);
243: 
244:   }
245: }
246: 

