247:       // use is authoritative here; calling the adapter would violate that rule.
248:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_QUEUE_DEADLINE_EXPIRED'), null, [], {
249:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
250:       }, { state: 'not_required', summary: null });
251:     }
252:     if (started.getTime() >= Date.parse(envelope.claim.expiresAt)) {
