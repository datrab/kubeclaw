646:       specialistResult: fault ? null : operationResult?.specialistResult ?? null,
647:       error: fault ? { code: fault.code, message: boundedText(fault.message, fault.code) } : null,
648:       evidence: [...evidence],
649:       resources,
650:       cleanup: {
651:         state: cleanup.state,
652:         summary: cleanup.summary === null ? null : boundedText(cleanup.summary, 'Cleanup failed.'),
653:       },
654:       exitCode: fault ? null : operationResult?.exitCode ?? null,
655:       signal: fault ? null : (typeof operationResult?.signal === 'string' && operationResult.signal.length > 0
