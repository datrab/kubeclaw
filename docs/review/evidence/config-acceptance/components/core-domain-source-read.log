1: import fs from 'node:fs';
2: import { execFileSync } from 'node:child_process';
3: import { pathToFileURL } from 'node:url';
4: import path from 'node:path';
5: 
6: const root = '/sys/fs/cgroup/kubeclaw.slice/kubeclaw-native-pools.service';
7: const read = file => fs.readFileSync(file, 'utf8').trim();
8: const required = ['cpu', 'memory', 'pids'];
9: 
10: function configuration(file) {
11:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
12:   try {
13:     const stat = fs.fstatSync(fd);
14:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || stat.size > 65536) throw new Error('NATIVE_SETUP_POLICY_NOT_TRUSTED');
15:     const policy = JSON.parse(fs.readFileSync(fd, 'utf8'));
16:     if (policy.schemaVersion !== 1 || policy.nodeVersion !== process.versions.node
17:       || Object.keys(policy.pools ?? {}).sort().join(',') !== 'buster,prism') throw new Error('NATIVE_SETUP_POLICY_RUNTIME_INVALID');
18:     for (const pool of Object.values(policy.pools)) validatePool(pool);
19:     return policy;
20:   } finally { fs.closeSync(fd); }
21: }
22: 
23: function validatePool(pool) {
24:   for (const key of ['memoryBytes', 'tasks', 'cpuQuotaMicroseconds', 'cpuPeriodMicroseconds']) {
25:     if (!Number.isSafeInteger(pool[key]) || pool[key] < 1) throw new Error('NATIVE_SETUP_LIMIT_INVALID');
26:   }
27:   if (pool.memoryBytes % 4096 || pool.cpuPeriodMicroseconds < 1000 || pool.cpuPeriodMicroseconds > 1000000
28:     || pool.cpuQuotaMicroseconds < 1000) throw new Error('NATIVE_SETUP_LIMIT_INVALID');
29: }
30: 
31: function controls(pool) {
32:   return { 'memory.max': String(pool.memoryBytes), 'memory.swap.max': '0',
33:     'pids.max': String(pool.tasks), 'cpu.max': `${pool.cpuQuotaMicroseconds} ${pool.cpuPeriodMicroseconds}` };
34: }
35: 
36: function verifyExisting(role, pool) {
37:   const directory = `${root}/${role}`;
38:   if (!fs.existsSync(directory)) return false;
39:   if (!fs.lstatSync(directory).isDirectory() || fs.statfsSync(directory).type !== 0x63677270
40:     || read(`${directory}/cgroup.procs`)) throw new Error('NATIVE_SETUP_EXISTING_POOL_INVALID');
41:   for (const [file, expected] of Object.entries(controls(pool))) {
42:     if (read(`${directory}/${file}`) !== expected) throw new Error('NATIVE_SETUP_POOL_CHANGE_REQUIRES_MAINTENANCE');
43:   }
44:   if (!required.every(controller => read(`${directory}/cgroup.subtree_control`).split(/\s+/).includes(controller))) {
45:     throw new Error('NATIVE_SETUP_EXISTING_POOL_NOT_DELEGATED');
46:   }
47:   return true;
48: }
49: 
50: function identity() {
51:   const machineId = read('/etc/machine-id');
52:   if (!/^[a-f0-9]{32}$/.test(machineId)) throw new Error('NATIVE_SETUP_MACHINE_ID_INVALID');
53:   const file = '/etc/kubeclaw/native-node-id';
54:   if (fs.existsSync(file)) {
55:     const stat = fs.lstatSync(file);
56:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || read(file) !== machineId) throw new Error('NATIVE_SETUP_NODE_IDENTITY_CONFLICT');
57:     return;
58:   }
59:   const fd = fs.openSync(file, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL, 0o444);
60:   try { fs.writeFileSync(fd, `${machineId}\n`); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
61:   const parent = fs.openSync('/etc/kubeclaw', fs.constants.O_RDONLY);
62:   try { fs.fsyncSync(parent); } finally { fs.closeSync(parent); }
63: }
64: 
65: function runtimeIdentity() {
66:   const own = fs.statSync('/proc/self/ns/cgroup', { bigint: true });
67:   const host = fs.statSync('/proc/1/ns/cgroup', { bigint: true });
68:   if (own.dev !== host.dev || own.ino !== host.ino) throw new Error('NATIVE_SETUP_HOST_NAMESPACE_REQUIRED');
69:   const value = { schemaVersion: 1, bootId: read('/proc/sys/kernel/random/boot_id'),
70:     cgroupNamespace: { device: String(own.dev), inode: String(own.ino) } };
71:   const file = '/etc/kubeclaw/native-runtime-identity.json';
72:   if (fs.existsSync(file)) {
73:     const stat = fs.lstatSync(file);
74:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || stat.size > 4096) throw new Error('NATIVE_SETUP_RUNTIME_IDENTITY_NOT_TRUSTED');
75:     const previous = JSON.parse(read(file));
76:     if (previous.bootId === value.bootId) {
77:       if (JSON.stringify(previous) !== JSON.stringify(value)) throw new Error('NATIVE_SETUP_RUNTIME_IDENTITY_CONFLICT');
78:       return;
79:     }
80:   }
81:   const temporary = `${file}.${process.pid}.pending`;
82:   const fd = fs.openSync(temporary, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL, 0o444);
83:   try { fs.writeFileSync(fd, `${JSON.stringify(value)}\n`); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
84:   fs.renameSync(temporary, file);
85:   const parent = fs.openSync('/etc/kubeclaw', fs.constants.O_RDONLY);
86:   try { fs.fsyncSync(parent); } finally { fs.closeSync(parent); }
87: }
88: 
89: function prepare(policy) {
90:   if (process.getuid() !== 0 || fs.statfsSync(root).type !== 0x63677270
91:     || !read('/proc/self/cgroup').split('\n').includes(`0::${root.slice('/sys/fs/cgroup'.length)}/setup`)
92:     || read(`${root}/cgroup.procs`)) throw new Error('NATIVE_SETUP_DELEGATED_UNIT_REQUIRED');
93:   const available = read(`${root}/cgroup.controllers`).split(/\s+/);
94:   if (!required.every(controller => available.includes(controller))) throw new Error('NATIVE_SETUP_CONTROLLERS_UNAVAILABLE');
95:   const unknown = fs.readdirSync(root, { withFileTypes: true }).filter(entry => entry.isDirectory()
96:     && !['setup', 'buster', 'prism'].includes(entry.name));
97:   if (unknown.length) throw new Error('NATIVE_SETUP_UNKNOWN_SUBTREE');
98:   // Inspect all existing role limits before creating or changing anything.
99:   const existing = new Set(Object.entries(policy.pools).filter(([role, pool]) => verifyExisting(role, pool)).map(([role]) => role));
100:   identity();
101:   runtimeIdentity();
102:   fs.writeFileSync(`${root}/cgroup.subtree_control`, required.map(controller => `+${controller}`).join(' '));
103:   for (const [role, pool] of Object.entries(policy.pools)) {
104:     if (existing.has(role)) continue;
105:     const directory = `${root}/${role}`;
106:     fs.mkdirSync(directory);
107:     for (const [file, value] of Object.entries(controls(pool))) fs.writeFileSync(`${directory}/${file}`, value);
108:     fs.writeFileSync(`${directory}/cgroup.subtree_control`, required.map(controller => `+${controller}`).join(' '));
109:     verifyExisting(role, pool);
110:   }
111:   prepareBrowser();
112:   process.stdout.write('NATIVE_HOST_POOLS_PREPARED_NODE_CAPACITY_PREFLIGHT_REQUIRED\n');
113: }
114: 
115: function prepareBrowser() {
116:   // Browser delegation must never chown the role pool itself: its limits and
117:   // ownership belong to the host. Descendants remain bounded by that pool.
118:   const browser = `${root}/buster/browser`;
119:   if (!fs.existsSync(browser)) fs.mkdirSync(browser);
120:   if (fs.lstatSync(browser).isSymbolicLink() || fs.statfsSync(browser).type !== 0x63677270
121:     || read(`${browser}/cgroup.procs`)) throw new Error('NATIVE_BROWSER_SUBTREE_INVALID');
122:   fs.writeFileSync(`${browser}/cgroup.subtree_control`, required.map(controller => `+${controller}`).join(' '));
123: }
124: 
125: export function requireRunningPoolService(facts) {
126:   if (facts.uid !== 0 || facts.subState !== 'running'
127:     || facts.controlGroup !== root.slice('/sys/fs/cgroup'.length)
128:     || !Number.isSafeInteger(facts.mainPid) || facts.mainPid <= 0
129:     || !facts.mainCgroup.split('\n').includes(`0::${root.slice('/sys/fs/cgroup'.length)}/setup`)
130:     || !facts.hostNamespaceMatches) throw new Error('NATIVE_BROWSER_RUNNING_POOL_REQUIRED');
131: }
132: 
133: function prepareBrowserOnly(policy) {
134:   const show = key => execFileSync('systemctl', ['show', 'kubeclaw-native-pools.service', '-p', key, '--value'], {encoding:'utf8'}).trim();
135:   const mainPid = Number(show('MainPID'));
136:   if (!Number.isSafeInteger(mainPid) || mainPid <= 0) throw new Error('NATIVE_BROWSER_RUNNING_POOL_REQUIRED');
137:   const own = fs.statSync('/proc/self/ns/cgroup', {bigint:true});
138:   const host = fs.statSync('/proc/1/ns/cgroup', {bigint:true});
139:   requireRunningPoolService({uid:process.getuid(), subState:show('SubState'), controlGroup:show('ControlGroup'),
140:     mainPid, mainCgroup:read(`/proc/${mainPid}/cgroup`), hostNamespaceMatches:own.dev===host.dev && own.ino===host.ino});
141:   // Never call prepare(): an administrator shell is intentionally not inside
142:   // the service's setup subgroup. Inspect existing pools without rewriting them.
143:   if (fs.statfsSync(root).type !== 0x63677270 || fs.realpathSync(root)!==root
144:     || read(`${root}/cgroup.procs`)) throw new Error('NATIVE_BROWSER_RUNNING_POOL_REQUIRED');
145:   for (const [role,pool] of Object.entries(policy.pools)) {
146:     if (!verifyExisting(role,pool)) throw new Error('NATIVE_BROWSER_EXISTING_POOL_REQUIRED');
147:   }
148:   prepareBrowser();
149:   process.stdout.write('NATIVE_BROWSER_SUBTREE_PREPARED_EXISTING_POOLS_UNCHANGED\n');
150: }
151: 
152: if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
153: const serve = process.argv.length === 4 && process.argv[3] === '--serve';
154: const browserOnly = process.argv.length === 4 && process.argv[3] === '--browser-only';
155: if (process.argv.length !== 3 && !serve && !browserOnly) throw new Error('Usage: prepare-native-worker-pools.mjs ROOT_OWNED_GENERATED_POLICY_JSON [--serve|--browser-only]');
156: const selected = configuration(process.argv[2]);
157: if (browserOnly) prepareBrowserOnly(selected);
158: else prepare(selected);
159: if (serve) {
160:   // RemainAfterExit retains the unit state, not an empty delegated cgroup.
161:   // Keep the setup subgroup populated for the entire pool lifetime. Notify only
162:   // after both pools and their identities have been successfully verified.
163:   execFileSync('/usr/bin/systemd-notify', ['--ready', '--status=Native worker pools prepared; capacity preflight still required'], { stdio: 'inherit' });
164:   setInterval(() => {}, 60_000);
165: }
166: }

