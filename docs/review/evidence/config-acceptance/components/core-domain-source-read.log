13: export interface WorkerOwnershipIdentity {
14:   readonly workerId: string;
15:   readonly attemptId: string;
16:   readonly claimId: string;
17:   readonly generation: number;
18:   readonly profileDigest: string;
19:   readonly attemptSpecDigest: string;
20: }
21: 
22: export type WorkerOwnershipPhase = 'reserved' | 'allocated' | 'running' | 'quiescing' | 'empty' | 'disposed' | 'unresolved' | 'abandoned';
23: 
24: export interface WorkerScopeBinding {
25:   readonly scopeName: string;
26:   readonly bootId: string;
27:   readonly device: number;
28:   readonly inode: number;
29: }
