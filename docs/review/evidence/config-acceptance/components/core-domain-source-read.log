2: import { validateTopology } from './ownership-children.ts';
3: import { sha256Digest } from './digest.ts';
4: import { validateNativeWorkerResourceObservation } from './native-resource-observation.ts';
5: 
6: export const maximumOwnershipDiagnosisUnits = 4096;
7: export const maximumOwnershipHostIdentityCharacters = 256;
8: 
9: export function validateOwnershipHostIdentity(value: unknown): asserts value is string {
10:   if (typeof value !== 'string' || value.length > maximumOwnershipHostIdentityCharacters
11:     || !/^[A-Za-z0-9][A-Za-z0-9:._-]*$/u.test(value)) throw new Error('WORKER_OWNERSHIP_HOST_IDENTITY_INVALID');
12: }
13: 
14: export interface WorkerOwnershipState {
15:   schemaVersion: 'worker-ownership-store.v3';
16:   hostIdentity: string | null;
17:   records: WorkerOwnershipRecord[];
18: }
19: 
20: export const transitions: Record<WorkerOwnershipPhase, readonly WorkerOwnershipPhase[]> = {
21:   reserved: ['allocated', 'unresolved', 'abandoned'],
22:   allocated: ['running', 'quiescing', 'unresolved', 'abandoned'],
23:   running: ['quiescing', 'unresolved', 'abandoned'],
24:   quiescing: ['empty', 'unresolved', 'abandoned'],
25:   empty: ['empty', 'disposed', 'unresolved', 'abandoned'],
26:   disposed: [],
27:   unresolved: ['quiescing', 'abandoned'],
28:   abandoned: [],
29: };
30: 
31: export function exact(value: unknown, keys: readonly string[]): asserts value is Record<string, unknown> {
32:   if (!value || typeof value !== 'object' || Array.isArray(value)
33:     || Object.keys(value).length !== keys.length || keys.some(key => !Object.hasOwn(value, key))) {
34:     throw new Error('WORKER_OWNERSHIP_RECORD_INVALID');
35:   }
36: }
37: 
38: export function identityValid(identity: unknown): asserts identity is WorkerOwnershipIdentity {
39:   exact(identity, ['workerId', 'attemptId', 'claimId', 'generation', 'profileDigest', 'attemptSpecDigest']);
40:   for (const key of ['workerId', 'attemptId', 'claimId']) {
41:     const value = identity[key];
42:     if (typeof value !== 'string' || value.length < 1 || value.length > 512 || value !== value.toWellFormed()) {
43:       throw new Error('WORKER_OWNERSHIP_IDENTITY_INVALID');
44:     }
45:   }
46:   if (!Number.isSafeInteger(identity.generation) || Number(identity.generation) < 1) {
47:     throw new Error('WORKER_OWNERSHIP_GENERATION_INVALID');
48:   }
49:   for (const key of ['profileDigest', 'attemptSpecDigest']) {
50:     if (typeof identity[key] !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(identity[key])) {
51:       throw new Error('WORKER_OWNERSHIP_DIGEST_INVALID');
52:     }
53:   }
54: }
55: 
56: function bindingValid(binding: unknown, scopeName: string): asserts binding is WorkerScopeBinding {
57:   exact(binding, ['scopeName', 'bootId', 'device', 'inode']);
58:   if (binding.scopeName !== scopeName || typeof binding.bootId !== 'string'
59:     || !/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u.test(binding.bootId)
60:     || !Number.isSafeInteger(binding.device) || Number(binding.device) < 0
61:     || !Number.isSafeInteger(binding.inode) || Number(binding.inode) < 1) {
62:     throw new Error('WORKER_OWNERSHIP_BINDING_INVALID');
63:   }
64: }
65: 
66: export function validateRecord(record: unknown): asserts record is WorkerOwnershipRecord {
67:   exact(record, ['identity', 'scopeName', 'revision', 'phase', 'binding', 'diagnosis', 'finalObservation', 'topology']);
68:   identityValid(record.identity);
69:   if (typeof record.scopeName !== 'string' || !/^worker-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u.test(record.scopeName)
70:     || !Number.isSafeInteger(record.revision) || Number(record.revision) < 1
71:     || typeof record.phase !== 'string' || !Object.hasOwn(transitions, record.phase)) {
72:     throw new Error('WORKER_OWNERSHIP_RECORD_INVALID');
73:   }
74:   validateRecordBinding(record);
75:   validateTopology(record.topology, record.binding as WorkerScopeBinding | null);
76:   validateDiagnosis(record);
77:   if (record.finalObservation !== null) {
78:     validateNativeWorkerResourceObservation(record.finalObservation);
79:     if (record.finalObservation.populated || !['empty', 'disposed', 'unresolved'].includes(String(record.phase))) {
80:       throw new Error('WORKER_OWNERSHIP_FINAL_OBSERVATION_INVALID');
81:     }
82:   }
83: }
84: 
85: function validateRecordBinding(record: Record<string, unknown>): void {
86:   if (record.binding !== null) bindingValid(record.binding, String(record.scopeName));
87:   if (!['reserved', 'unresolved', 'abandoned'].includes(String(record.phase)) && record.binding === null) {
88:     throw new Error('WORKER_OWNERSHIP_BINDING_REQUIRED');
89:   }
90:   if (record.phase === 'reserved' && record.binding !== null) throw new Error('WORKER_OWNERSHIP_RESERVED_BINDING');
91: }
92: 
93: function validateDiagnosis(record: Record<string, unknown>): void {
94:   if (record.diagnosis !== null && (typeof record.diagnosis !== 'string' || record.diagnosis.length < 1
95:     || record.diagnosis.length > maximumOwnershipDiagnosisUnits)) throw new Error('WORKER_OWNERSHIP_DIAGNOSIS_INVALID');
96:   if (['unresolved', 'abandoned'].includes(String(record.phase)) && record.diagnosis === null) throw new Error('WORKER_OWNERSHIP_DIAGNOSIS_REQUIRED');
97: }
98: 
99: export function key(identity: WorkerOwnershipIdentity): string {
100:   return sha256Digest([identity.workerId, identity.attemptId, identity.generation]);
101: }
102: 
103: export function decodeOwnershipState(value: unknown, maximumRecords: number): WorkerOwnershipState {
104:   const { records, hostIdentity } = statePayload(value);
105:   if (records.length > maximumRecords) throw new Error('WORKER_OWNERSHIP_CAPACITY_EXCEEDED');
106:   const keys = new Set<string>();
107:   const scopes = new Set<string>();
108:   for (const record of records) {
109:     validateRecord(record);
110:     const identityKey = key(record.identity);
111:     if (keys.has(identityKey) || scopes.has(record.scopeName)) throw new Error('WORKER_OWNERSHIP_DUPLICATE');
112:     keys.add(identityKey); scopes.add(record.scopeName);
113:   }
114:   return { schemaVersion: 'worker-ownership-store.v3', hostIdentity, records } as WorkerOwnershipState;
115: }
116: 
117: function statePayload(value: unknown) {
118:   const legacy = typeof value === 'object' && value !== null && 'schemaVersion' in value && value.schemaVersion === 'worker-ownership-store.v1';
119:   exact(value, legacy ? ['schemaVersion', 'records'] : ['schemaVersion', 'hostIdentity', 'records']);
120:   if (!['worker-ownership-store.v1', 'worker-ownership-store.v2', 'worker-ownership-store.v3'].includes(String(value.schemaVersion)) || !Array.isArray(value.records)) {
121:     throw new Error('WORKER_OWNERSHIP_STORE_INVALID');
122:   }
123:   const records = legacy ? value.records.map(record => {
124:     exact(record, ['identity', 'scopeName', 'revision', 'phase', 'binding', 'diagnosis']);
125:     return { ...record, finalObservation: null };
126:   }) : value.records;
127:   const hostIdentity = legacy ? null : value.hostIdentity;
128:   if (hostIdentity !== null) validateOwnershipHostIdentity(hostIdentity);
129:   const upgraded = value.schemaVersion === 'worker-ownership-store.v3' ? records : records.map(record => {
130:     exact(record, ['identity', 'scopeName', 'revision', 'phase', 'binding', 'diagnosis', 'finalObservation']);
131:     return { ...record, topology: { kind: 'legacy-leaf', children: [] } };
132:   });
133:   return { records: upgraded, hostIdentity };
134: }

