681:     try {
682:       if(result.schemaVersion==='worker-attempt-result.v3')validateWorkerResourceContractV3('workerAttemptResult',result);
683:       else if(result.schemaVersion==='worker-attempt-result.v2')validateWorkerResourceContractV2('workerAttemptResult',result);
684:       else validatePipelineWorkerCoreContract('workerAttemptResult', result);
685:       const frozenResult = freeze(result);
686:       if (!fault && this.#now().getTime() >= Date.parse(envelope.claim.expiresAt)) {
687:         return this.#result(started, this.#now(), new AttemptFault('interrupted', 'WORKER_CLAIM_EXPIRED'), null, evidence, resources, cleanup);
688:       }
689:       return frozenResult;
690:     } catch (error) {
691:       if (fault?.code === 'WORKER_OPERATION_RESULT_INVALID') throw error;
692:       return this.#result(started, completed,
693:         new AttemptFault('errored', 'WORKER_OPERATION_RESULT_INVALID', 'Specialist operation returned an invalid result.'),
694:         null, [], {
695:           ...resources,
696:           logBytes: resources.logBytes,
697:           resultBytes: 0,
698:           evidenceBytes: 0,
699:         }, cleanup.state === 'failed'
700:           ? { state: 'failed', summary: boundedText(cleanup.summary, 'Cleanup failed.') }
701:           : cleanup);
702:     }
703:   }
704: }

SOURCE skills/worker/core/worker/log-decoder.ts SHA256 7f777b5cd5f9544c6eb2f5933613d8d8379633742edf45cd235428805e7dea88
1: /** Byte accounting precedes streaming UTF-8 decoding, independently per log stream. */
2: export class WorkerLogDecoder {
3:   readonly #decoders = new Map<string, TextDecoder>();
4:   #bytes = 0;
5:   readonly maximumBytes: number;
6:   constructor(maximumBytes: number) { this.maximumBytes = maximumBytes; }
7:   decode(stream: string, value: string | Uint8Array): string {
8:     this.#bytes += typeof value === 'string' ? Buffer.byteLength(value) : value.byteLength;
9:     if (this.#bytes > this.maximumBytes) throw new Error('WORKER_LOG_LIMIT');
10:     let decoder = this.#decoders.get(stream);
11:     if (!decoder) { decoder = new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }); this.#decoders.set(stream, decoder); }
12:     try {
13:       return typeof value === 'string' ? decoder.decode() + value.toWellFormed() : decoder.decode(value, { stream: true });
14:     } catch (cause) { throw new Error('WORKER_LOG_UTF8_INVALID', { cause }); }
15:   }
16:   finish(): void {
17:     try { for (const decoder of this.#decoders.values()) decoder.decode(); }
18:     catch (cause) { throw new Error('WORKER_LOG_UTF8_INVALID', { cause }); }
19:   }
20: }

SOURCE skills/worker/core/worker/native-attempt-executor.ts SHA256 bddc68aa370648c86e7b7301f4f31a083504217dd89bac7694c36c344a8e23a3
1: import {
2:   validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3,
3: } from '@kubeclaw/pipeline-worker-core-contract';
4: import { runNativeWorkerProcess, type NativeWorkerProcessOptions } from './native-worker-process.ts';
5: import { NativeWorkerAttemptBusy, type NativeAttemptJournal } from './native-attempt-journal.ts';
6: import { NativeWorkerOutputSpool } from './native-output-spool.ts';
7: import { journalIdentity } from './native-journal-state.ts';
8: import { finalizeNativeWorkerResult, interruptedNativeWorkerResult } from './native-result.ts';
9: import { recoverNativeAttempt } from './native-attempt-recovery.ts';
10: import { NativeWorkerCapacityExceeded } from './resource-reservations.ts';
11: 
12: export interface NativeWorkerAttemptExecutorOptions {
13:   readonly envelope: WorkerAttemptEnvelopeV3;
14:   readonly journal: NativeAttemptJournal;
15:   readonly process: Omit<NativeWorkerProcessOptions, 'identity' | 'input' | 'outputCapture'>;
16: }
17: 
18: class NativeAdmissionRejected extends Error {}
19: 
20: /** A fsynced identity precedes launch; a fsynced sealed receipt precedes delivery. */
21: export async function executeNativeWorkerAttempt(options: NativeWorkerAttemptExecutorOptions): Promise<WorkerAttemptResultV3> {
22:   validateWorkerResourceContractV3('workerAttemptEnvelope', options.envelope);
23:   try {
24:     const result = await options.journal.withAttempt(options.envelope, async context => {
25:       const envelope = context.envelope;
26:       const cached = await options.journal.readResult(envelope);
27:       if (cached) return cached;
28:       const started = new Date(context.acceptedAt);
29:       const recovered = await recoverNativeAttempt(options.journal, options.process.owner, envelope, started, context.newlyAccepted);
30:       if (recovered) return options.journal.seal(envelope, recovered);
31:       const limits = launchLimits(options, envelope);
32:       if (limits instanceof NativeAdmissionRejected) {
33:         // Admission was persisted, but the claim expired before launch. The
34:         // ownership lookup above proved that no process crossed that boundary.
35:         return options.journal.seal(envelope, interruptedNativeWorkerResult(envelope, started, limits.message, null, true));
36:       }
37:       const spool = await NativeWorkerOutputSpool.create(context.outputRoot, limits.maximumOutputBytes);
38:       try {
39:         const process = await runNativeWorkerProcess({ ...options.process, limits, outputCapture: spool,
40:           identity: journalIdentity(envelope), input: Buffer.from(JSON.stringify(envelope)) });
41:         const completed = new Date();
42:         await spool.flush();
43:         await options.journal.recordProcess(envelope, process, completed);
44:         return await options.journal.seal(envelope, finalizeNativeWorkerResult(envelope, process, started, completed));
45:       } catch (error) {
46:         if (!(error instanceof NativeWorkerCapacityExceeded)) throw error;
47:         if (await options.process.owner.record(journalIdentity(envelope))) throw new Error('WORKER_NATIVE_CAPACITY_REJECTION_OWNERSHIP_CONFLICT');
48:         // Aggregate admission rejected before the durable owner reservation.
49:         // Preserve this accepted attempt as an explicit never-launched failure.
50:         return await options.journal.seal(envelope, interruptedNativeWorkerResult(envelope, started, error.message, null, true));
51:       } finally { await spool.close(); }
52:     }, envelope => { acceptedLimits(options, envelope, new Date()); });
53:     if (result.cleanup.state === 'failed') options.process.owner.fenceAdmission();
54:     return result;
55:   } catch (error) {
56:     if (error instanceof NativeWorkerAttemptBusy || error instanceof NativeAdmissionRejected) throw error;
57:     // Persistence or ownership uncertainty cannot permit a later admission.
58:     options.process.owner.fenceAdmission();
59:     throw error;
60:   }
61: }
62: 
63: function launchLimits(options: NativeWorkerAttemptExecutorOptions, envelope: WorkerAttemptEnvelopeV3) {
64:   try { return acceptedLimits(options, envelope, new Date()); }
65:   catch (error) { if (error instanceof NativeAdmissionRejected) return error; throw error; }
66: }
67: 
68: function acceptedLimits(options: NativeWorkerAttemptExecutorOptions, envelope: WorkerAttemptEnvelopeV3, started: Date) {
69:   const limits = options.process.limits;
70:   const accepted = { cpuTimeMs: limits.cpuTimeMs, maximumMemoryBytes: limits.memoryBytes, maximumTasks: limits.tasks };
71:   for (const [metric, maximum] of Object.entries(accepted)) {
72:     const budget = envelope.resourceBudgets[metric as keyof typeof accepted];
73:     if (budget.state !== 'requested' || budget.limit !== maximum) throw new NativeAdmissionRejected('WORKER_NATIVE_ACCEPTED_LIMIT_MISMATCH');
74:   }
75:   const claimRemaining = Date.parse(envelope.claim.expiresAt) - started.getTime();
76:   if (started.getTime() < Date.parse(envelope.claim.claimedAt) || claimRemaining <= 0
77:     || started.getTime() >= Date.parse(envelope.queueDeadline)) throw new NativeAdmissionRejected('WORKER_NATIVE_CLAIM_NOT_ACTIVE');
78:   return { ...limits, timeoutMs: Math.min(limits.timeoutMs, claimRemaining) };
79: }

SOURCE skills/worker/core/worker/native-attempt-journal.ts SHA256 4c63283eb753d9840c4a6fce4126404a86df2e33dc357166531550059a57acf5
1: import fs from 'node:fs/promises';
2: import path from 'node:path';
3: import { FileDurableRecordStore, FileDurableBlobStore, type DurableRecord } from '@kubeclaw/plugin-foundation/observability/durable-records';
4: import { ensureDirectoryDurable, withDurableStoreLock } from '@kubeclaw/plugin-foundation/observability/durable-delivery';
5: import { canonicalJson, sha256Digest, checkWorkerNativeResultBinding, validateWorkerResourceContractV3,
6:   type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
7: import { readNativeWorkerOutput } from './native-output-spool.ts';
8: import type { NativeWorkerProcessResult } from './native-worker-process.ts';
9: import { journalIdentity, journalKey, validateJournalState, usedJournalBytes,
10:   type NativeAttemptJournalLimits, type NativeAttemptJournalState } from './native-journal-state.ts';
11: 
12: import { nativeJournalStream, nativeJournalMaximumRecordBytes, reserveNativeJournalMetadata } from './native-journal-capacity.ts';
13: 
14: export type { NativeAttemptJournalLimits } from './native-journal-state.ts';
15: const stream = nativeJournalStream;
16: export class NativeWorkerAttemptBusy extends Error {
17:   constructor() { super('WORKER_NATIVE_ATTEMPT_BUSY'); }
18: }
19: 
20: /** Accepted identity, original output and sealed result outlive the serving process. */
21: export class NativeAttemptJournal {
22:   readonly #root: string;
23:   readonly #limits: NativeAttemptJournalLimits;
24:   readonly #records: FileDurableRecordStore;
25:   readonly #blobs: FileDurableBlobStore;
26: 
27:   constructor(root: string, limits: NativeAttemptJournalLimits) {
28:     if (!path.isAbsolute(root) || Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1)) {
29:       throw new Error('WORKER_NATIVE_JOURNAL_CONFIG_INVALID');
30:     }
31:     this.#root = path.resolve(root); this.#limits = { ...limits };
32:     this.#records = new FileDurableRecordStore(path.join(this.#root, 'metadata'), {
33:       maximumRecords: limits.maximumRecords, maximumBytes: limits.maximumStateBytes, maximumRecordBytes: nativeJournalMaximumRecordBytes,
34:     });
35:     this.#blobs = new FileDurableBlobStore(path.join(this.#root, 'data'), Math.max(limits.maximumInputBytes, limits.maximumResultBytes), limits.maximumTotalBytes);
36:   }
37: 
38:   async withAttempt<T>(input: WorkerAttemptEnvelopeV3,
39:     operation: (context: { envelope: WorkerAttemptEnvelopeV3; newlyAccepted: boolean; acceptedAt: string; outputRoot: string }) => Promise<T>,
40:     validateNewAdmission: (envelope: WorkerAttemptEnvelopeV3) => void = () => {}): Promise<T> {
41:     const envelope = structuredClone(input);
42:     validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
43:     const bytes = Buffer.from(canonicalJson(envelope));
44:     if (bytes.byteLength > this.#limits.maximumInputBytes) throw new Error('WORKER_NATIVE_JOURNAL_INPUT_LIMIT');
45:     await this.#initialize();
46:     const key = journalKey(envelope);
47:     // 256 fixed lock stripes bound rejected-request lock metadata. Equal claims
48:     // serialize across real processes; unrelated stripes can execute together.
49:     let entered = false;
50:     try {
51:       return await withDurableStoreLock(path.join(this.#root, 'fences', key.slice(-2), 'lifetime'), async () => {
52:         entered = true;
53:         const reserved = await this.#reserve(envelope, bytes, validateNewAdmission);
54:         return operation({ envelope, newlyAccepted: reserved.newlyAccepted, acceptedAt: reserved.record.payload.acceptedAt,
55:           outputRoot: this.outputRoot(envelope) });
56:       });
57:     } catch (error) {
58:       if (!entered && error instanceof Error && error.message.startsWith('OBSERVABILITY_STORE_LOCK_FAILED:')
59:         && error.message.endsWith(':OBSERVABILITY_STORE_LOCKED:1:')) throw new NativeWorkerAttemptBusy();
60:       throw error;
61:     }
62:   }
63: 
64:   outputRoot(envelope: WorkerAttemptEnvelopeV3): string { return path.join(this.#root, 'outputs', journalKey(envelope).slice(7)); }
65: 
66:   async *acceptedEnvelopes(): AsyncGenerator<WorkerAttemptEnvelopeV3> {
67:     await this.#initialize();
68:     for (const record of await this.#all()) {
69:       const bytes = await this.#blobs.get(record.payload.envelope.digest);
70:       if (bytes.byteLength !== record.payload.envelope.sizeBytes) throw new Error('WORKER_NATIVE_JOURNAL_ENVELOPE_SIZE_CHANGED');
71:       const envelope = JSON.parse(bytes.toString('utf8')) as WorkerAttemptEnvelopeV3;
72:       validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
73:       if (journalKey(envelope) !== record.idempotencyKey || sha256Digest(envelope) !== record.payload.envelopeDigest
74:         || canonicalJson(journalIdentity(envelope)) !== canonicalJson(record.payload.identity)) throw new Error('WORKER_NATIVE_JOURNAL_IDENTITY_CONFLICT');
75:       yield envelope;
76:     }
77:   }
78: 
79:   async hasAttempt(envelope: WorkerAttemptEnvelopeV3): Promise<boolean> { return (await this.#lookup(envelope)) !== undefined; }
80: 
81:   async readResult(envelope: WorkerAttemptEnvelopeV3): Promise<WorkerAttemptResultV3 | null> {
82:     const record = await this.#lookup(envelope);
83:     if (!record?.payload.result) return null;
84:     const bytes = await this.#blobs.get(record.payload.result.digest);
85:     if (bytes.byteLength !== record.payload.result.sizeBytes) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_SIZE_CHANGED');
86:     const result = JSON.parse(bytes.toString('utf8')) as WorkerAttemptResultV3;
87:     if (!checkWorkerNativeResultBinding(envelope, result).ok) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_BINDING_INVALID');
88:     return result;
89:   }
90: 
91:   async readProcess(envelope: WorkerAttemptEnvelopeV3): Promise<{ process: NativeWorkerProcessResult; completedAt: string } | null> {
92:     const record = await this.#lookup(envelope);
93:     const process = record?.payload.process;
94:     if (!process) return null;
95:     const output = await readNativeWorkerOutput(this.outputRoot(envelope), this.#limits.maximumOutputBytes);
96:     for (const channel of ['stdout', 'stderr'] as const) {
97:       if (output[channel].digest !== process[channel].digest || output[channel].sizeBytes !== process[channel].sizeBytes) {
98:         throw new Error('WORKER_NATIVE_JOURNAL_OUTPUT_CHANGED');
99:       }
100:     }
101:     return { process: { ...process, stdout: output.stdout.bytes, stderr: output.stderr.bytes }, completedAt: record!.payload.processCompletedAt! };
102:   }
103: 
104:   async recordProcess(envelope: WorkerAttemptEnvelopeV3, input: NativeWorkerProcessResult, completedAt: Date): Promise<void> {
105:     const process = structuredClone(input);
106:     const timestamp = completedAt.toISOString();
107:     const record = await this.#required(envelope);
108:     if (record.payload.result || record.payload.process) throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_ALREADY_RECORDED');
109:     const output = await readNativeWorkerOutput(this.outputRoot(envelope), this.#limits.maximumOutputBytes);
110:     if (!output.stdout.bytes.equals(Buffer.from(process.stdout)) || !output.stderr.bytes.equals(Buffer.from(process.stderr))) {
111:       throw new Error('WORKER_NATIVE_JOURNAL_OUTPUT_INCOMPLETE');
112:     }
113:     const reference = (channel: 'stdout' | 'stderr') => ({ digest: output[channel].digest, sizeBytes: output[channel].sizeBytes });
114:     const payload = { ...record.payload, processCompletedAt: timestamp, process: { ...process, stdout: reference('stdout'), stderr: reference('stderr') } };
115:     validateJournalState(payload);
116:     await this.#records.transition(stream, record.idempotencyKey, record.payloadDigest, payload);
117:   }
118: 
119:   async seal(envelope: WorkerAttemptEnvelopeV3, input: WorkerAttemptResultV3): Promise<WorkerAttemptResultV3> {
120:     const result = structuredClone(input);
121:     if (!checkWorkerNativeResultBinding(envelope, result).ok) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_BINDING_INVALID');
122:     const bytes = Buffer.from(canonicalJson(result));
123:     if (bytes.byteLength > this.#limits.maximumResultBytes) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_LIMIT');
124:     return withDurableStoreLock(path.join(this.#root, 'admission', 'lifetime'), async () => {
125:       const record = await this.#required(envelope);
126:       if (record.payload.result) {
127:         if (record.payload.result.digest !== sha256Digest(result)) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_ALREADY_SEALED');
128:         return result;
129:       }
130:       const reference = await this.#blobs.put(bytes);
131:       await this.#records.transition(stream, record.idempotencyKey, record.payloadDigest, { ...record.payload, result: reference });
132:       return result;
133:     });
134:   }
135: 
136:   async #initialize(): Promise<void> {
137:     await ensureDirectoryDurable(path.dirname(this.#root));
138:     try { await fs.mkdir(this.#root, { mode: 0o700 }); }
139:     catch (error) { if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error; }
140:     const stat = await fs.lstat(this.#root);
141:     if (!stat.isDirectory() || stat.uid !== process.getuid!() || (stat.mode & 0o077) !== 0) throw new Error('WORKER_NATIVE_JOURNAL_NOT_PRIVATE');
142:   }
143: 
144:   async #all(): Promise<readonly DurableRecord<NativeAttemptJournalState>[]> {
145:     const records = await this.#records.read<NativeAttemptJournalState>(stream);
146:     for (const record of records) validateJournalState(record.payload);
147:     return records;
148:   }
149: 
150:   async #lookup(envelope: WorkerAttemptEnvelopeV3): Promise<DurableRecord<NativeAttemptJournalState> | undefined> {
151:     await this.#initialize();
152:     const record = (await this.#all()).find(record => record.idempotencyKey === journalKey(envelope));
153:     if (record && (record.payload.envelopeDigest !== sha256Digest(envelope)
154:       || canonicalJson(record.payload.identity) !== canonicalJson(journalIdentity(envelope)))) throw new Error('WORKER_NATIVE_JOURNAL_IDENTITY_CONFLICT');
155:     return record;
156:   }
157: 
158:   async #required(envelope: WorkerAttemptEnvelopeV3): Promise<DurableRecord<NativeAttemptJournalState>> {
159:     const record = await this.#lookup(envelope);
160:     if (!record) throw new Error('WORKER_NATIVE_JOURNAL_RESERVATION_REQUIRED');
161:     return record;
162:   }
163: 
164:   async #reserve(envelope: WorkerAttemptEnvelopeV3, bytes: Buffer, validateNewAdmission: (envelope: WorkerAttemptEnvelopeV3) => void) {
165:     return withDurableStoreLock(path.join(this.#root, 'admission', 'lifetime'), async () => {
166:       const existing = await this.#lookup(envelope);
167:       if (existing) return { newlyAccepted: false, record: existing };
168:       // Reject expired or unsupported new work under the admission lock, before
169:       // retaining input or accepting an identity. Historical replay bypasses it.
170:       validateNewAdmission(envelope);
171:       const reservationBytes = bytes.byteLength + this.#limits.maximumOutputBytes + this.#limits.maximumResultBytes + 65536;
172:       const records = await this.#all();
173:       const pending = records.filter(record => record.payload.result === null).reduce((sum, record) => sum + record.payload.reservationBytes, 0);
174:       const requested = await usedJournalBytes(this.#root) + pending + reservationBytes + 2 * this.#limits.maximumStateBytes;
175:       if (!Number.isSafeInteger(requested) || requested > this.#limits.maximumTotalBytes) throw new Error('WORKER_NATIVE_JOURNAL_CAPACITY_EXCEEDED');
176:       const payload: NativeAttemptJournalState = { schemaVersion: 'native-attempt-journal.v1', identity: journalIdentity(envelope),
177:         envelopeDigest: sha256Digest(envelope), envelope: { digest: sha256Digest(envelope), sizeBytes: bytes.byteLength },
178:         acceptedAt: new Date().toISOString(), reservationBytes, process: null, processCompletedAt: null, result: null };
179:       const owner = `native-worker:${sha256Digest(envelope.claim.workerId).slice(7)}`;
180:       await reserveNativeJournalMetadata(path.join(this.#root, 'metadata', 'records', 'store.json'),
181:         payload, journalKey(envelope), owner, this.#limits);
182:       // The global admission lock holds the checked disk reservation while the
183:       // input is fsynced. A crash can leave an unreferenced original blob, which
184:       // remains counted, but never an accepted identity with no recoverable input.
185:       await this.#blobs.put(bytes);
186:       const appended = await this.#records.append(stream, journalKey(envelope), payload, owner);
187:       return { newlyAccepted: true, record: appended.record };
188:     });
189:   }
190: }

SOURCE skills/worker/core/worker/native-journal-capacity.ts SHA256 a0369d6ac33fa5607b03125d52e50aa8172e0b338c528c90b4e1e13fac47b65a
1: import { canonicalJson } from '@kubeclaw/pipeline-worker-core-contract';
2: import { assertDurableRecordReplay, type DurableRecord, type DurableRecordState } from '@kubeclaw/plugin-foundation/observability/durable-records';
3: import { readDurableState } from '@kubeclaw/plugin-foundation/observability/durable-delivery';
4: import { nativeJournalMaximumDiagnosticUnits, validateJournalState, type NativeAttemptJournalLimits, type NativeAttemptJournalState } from './native-journal-state.ts';
5: 
6: export const nativeJournalStream = 'native-worker-attempts.v1';
7: export const nativeJournalMaximumRecordBytes = 65536;
8: const maximumInteger = Number.MAX_SAFE_INTEGER;
9: const maximumDate = '+275760-09-13T00:00:00.000Z';
10: const digest = `sha256:${'0'.repeat(64)}`;
11: const diagnostic = '\u0000'.repeat(nativeJournalMaximumDiagnosticUnits);
12: 
13: function futurePayload(payload: NativeAttemptJournalState, limits: NativeAttemptJournalLimits) {
14:   if (payload.result !== null) return payload;
15:   // Per-field envelopes intentionally allow both output references their full
16:   // limit; no synthetic output, observations or diagnostics are ever persisted.
17:   const output = { digest, sizeBytes: limits.maximumOutputBytes };
18:   return { ...payload, process: payload.process ?? {
19:     schemaVersion: 'worker-native-process-result.v1', stdout: output, stderr: output,
20:     exitCode: null, signal: diagnostic, fault: diagnostic,
21:     resources: { unit: 'linux-tasks', cpuTimeMicroseconds: maximumInteger,
22:       maximumMemoryBytes: maximumInteger, maximumTasks: maximumInteger,
23:       populated: false, oomKills: maximumInteger, taskLimitHits: maximumInteger },
24:   }, processCompletedAt: payload.processCompletedAt ?? maximumDate,
25:   result: { digest, sizeBytes: limits.maximumResultBytes } };
26: }
27: 
28: function futureRecordBytes(record: DurableRecord, limits: NativeAttemptJournalLimits): number {
29:   const actual = Buffer.byteLength(canonicalJson(record));
30:   if (record.stream !== nativeJournalStream) return actual;
31:   validateJournalState(record.payload);
32:   if (record.payload.result !== null) return actual;
33:   const payload = futurePayload(record.payload, limits);
34:   if (Buffer.byteLength(canonicalJson(payload)) > nativeJournalMaximumRecordBytes) {
35:     throw new Error('WORKER_NATIVE_JOURNAL_METADATA_CAPACITY_EXCEEDED');
36:   }
37:   return Math.max(actual, Buffer.byteLength(canonicalJson({ ...record,
38:     committedAt: maximumDate, payloadDigest: digest, payload })));
39: }
40: 
41: /** Real durable-store framing, including retained foreign rows/retirement data.
42:  * Caller holds the journal admission fence; serialize only one projected row at
43:  * a time and stop at the existing ceiling. Historical rows are not rewritten. */
44: export function nativeJournalTerminalMetadataBytes(state: DurableRecordState,
45:   limits: NativeAttemptJournalLimits): number {
46:   let total = Buffer.byteLength(canonicalJson({ ...state, records: [] }));
47:   for (const [index, record] of state.records.entries()) {
48:     const bytes = futureRecordBytes(record, limits) + (index === 0 ? 0 : 1);
49:     if (bytes > limits.maximumStateBytes - total) throw new Error('WORKER_NATIVE_JOURNAL_METADATA_CAPACITY_EXCEEDED');
50:     total += bytes;
51:   }
52:   if (total > limits.maximumStateBytes) throw new Error('WORKER_NATIVE_JOURNAL_METADATA_CAPACITY_EXCEEDED');
53:   return total;
54: }
55: 
56: /** Check before the journal writes an input blob or accepts a new identity. */
57: export async function reserveNativeJournalMetadata(file: string, payload: NativeAttemptJournalState,
58:   idempotencyKey: string, owner: string, limits: NativeAttemptJournalLimits): Promise<void> {
59:   const state = await readDurableState<DurableRecordState>(file,
60:     { schemaVersion: 'pipeline-durable-record-store.v1', records: [] }, limits.maximumStateBytes);
61:   assertDurableRecordReplay(state);
62:   const sequence = state.records.filter(row => row.stream === nativeJournalStream).length
63:     + (state.tombstones?.filter(row => row.stream === nativeJournalStream).length ?? 0) + 1;
64:   const record: DurableRecord = { schemaVersion: 'pipeline-durable-record.v2', owner,
65:     stream: nativeJournalStream, sequence, idempotencyKey, committedAt: maximumDate,
66:     payloadDigest: digest, payload };
67:   nativeJournalTerminalMetadataBytes({ ...state, schemaVersion: 'pipeline-durable-record-store.v2',
68:     records: [...state.records, record], tombstones: state.tombstones ?? [], retirements: state.retirements ?? [] }, limits);
69: }

SOURCE skills/worker/core/worker/native-journal-state.ts SHA256 ae5cca21eb24261fa5389c7081bc3534e8e12b411d5bda0e97a69a94ead424d2
1: import fs from 'node:fs/promises';
2: import path from 'node:path';
3: import { sha256Digest, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
4: import type { WorkerOwnershipIdentity } from './ownership-store.ts';
5: import type { NativeWorkerProcessResult } from './native-worker-process.ts';
