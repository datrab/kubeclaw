302:       try { text = decoder.decode(stream, value); }
303:       catch (error) { logFault = new AttemptFault('errored', detail(error)); controller.abort(logFault); void terminate(); return; }
304:       if (!text && typeof value !== 'string') return;
305:       let offset = 0;
306:       do {
307:         if (logPartCount >= MAX_ATTEMPT_LOG_PARTS) {
