1: import fs from 'node:fs/promises';
2: import path from 'node:path';
3: import { WorkerAttemptExecutor, observeNativeWorkerResources, nativeSourceCleanupResultSchema,
4:   sha256Digest, type WorkerAttemptOperation } from '@kubeclaw/worker-core';
5: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
6: import { validateBusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
7: import { assertPreparationCleanupEffects, type PreparationCleanupEffects } from './preparation-cleanup-binding.ts';
8: import { preparationSourceDirectory } from './preparation-source.ts';
9: 
10: function assigned(name: string): string {
11:   const value = process.env[name];
12:   if (!value) throw new Error(`BUSTER_PREPARATION_ASSIGNED_ENV_REQUIRED:${name}`);
13:   return value;
14: }
15: 
16: async function readEnvelope(maximumBytes: number): Promise<WorkerAttemptEnvelopeV3> {
17:   const chunks: Buffer[] = [];
18:   let bytes = 0;
19:   for await (const chunk of process.stdin) {
20:     bytes += chunk.byteLength;
21:     if (bytes > maximumBytes) throw new Error('BUSTER_PREPARATION_ENVELOPE_LIMIT');
22:     chunks.push(Buffer.from(chunk));
23:   }
24:   const value: unknown = JSON.parse(Buffer.concat(chunks, bytes).toString('utf8'));
25:   validateWorkerResourceContractV3('workerAttemptEnvelope', value);
26:   return value as WorkerAttemptEnvelopeV3;
27: }
28: 
29: async function removeOwnedData(root: string, effects: PreparationCleanupEffects, signal: AbortSignal): Promise<void> {
30:   const directory = preparationSourceDirectory(root, effects.admissionId);
31:   const gate = path.dirname(directory);
32:   const stat = await fs.lstat(gate);
33:   if (!stat.isDirectory() || stat.uid !== 0 || stat.gid !== effects.gate.preparationUid
34:     || (stat.mode & 0o7777) !== 0o1770 || stat.dev !== effects.gate.device || stat.ino !== effects.gate.inode) {
35:     throw new Error('BUSTER_PREPARATION_CLEANUP_GATE_CHANGED');
36:   }
37:   let data;
38:   try { data = await fs.lstat(directory); }
39:   catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
40:   if (data) {
41:     if (!effects.data || !data.isDirectory() || data.dev !== effects.data.device
42:       || data.ino !== effects.data.inode || data.uid !== effects.data.uid) {
43:       throw new Error('BUSTER_PREPARATION_CLEANUP_SOURCE_CHANGED');
44:     }
45:     signal.throwIfAborted();
46:     await fs.rm(directory, { recursive: true });
47:   }
48:   // Absence is valid only under the durable association for this exact gate/effect.
49:   // The parent independently verifies the sealed result before removing its marker.
50:   const handle = await fs.open(gate, 'r');
51:   try { await handle.sync(); } finally { await handle.close(); }
52:   signal.throwIfAborted();
53: }
54: 
55: async function main(): Promise<void> {
56:   const maximumBytes = Number(assigned('BUSTER_PREPARATION_ASSIGNED_INPUT_BYTES'));
57:   if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 1) throw new Error('BUSTER_PREPARATION_ENVELOPE_LIMIT');
58:   const encoded = assigned('BUSTER_PREPARATION_ASSIGNED_CLEANUP');
59:   if (Buffer.byteLength(encoded) > maximumBytes) throw new Error('BUSTER_PREPARATION_ENVELOPE_LIMIT');
60:   const association = JSON.parse(encoded) as { effects: PreparationCleanupEffects; settings: unknown };
61:   if (Object.keys(association).sort().join(',') !== 'effects,settings') throw new Error('BUSTER_PREPARATION_CLEANUP_ASSOCIATION_INVALID');
62:   assertPreparationCleanupEffects(association.effects);
63:   validateBusterPreparationSettings(association.settings);
64:   const effects = association.effects;
65:   if (process.getuid?.() !== effects.gate.preparationUid || process.getgid?.() !== effects.gate.preparationUid) {
66:     throw new Error('BUSTER_PREPARATION_SLOT_INVALID');
67:   }
68:   const envelope = await readEnvelope(maximumBytes);
69:   if (envelope.operation.contractId !== 'kubeclaw.native-source-cleanup@1'
70:     || envelope.operation.values.effectsDigest !== sha256Digest(effects)) throw new Error('BUSTER_PREPARATION_CLEANUP_ASSOCIATION_INVALID');
71:   const cancellation = new AbortController();
72:   const cancel = () => cancellation.abort(new Error('BUSTER_PREPARATION_CANCELLED'));
73:   process.once('SIGINT', cancel);
74:   process.once('SIGTERM', cancel);
75:   let finished = false;
76:   const operation: WorkerAttemptOperation<WorkerAttemptEnvelopeV3> = {
77:     prepare() { return undefined; },
78:     async execute(context) {
79:       await removeOwnedData(assigned('BUSTER_PREPARATION_ASSIGNED_SOURCE_ROOT'), effects,
80:         AbortSignal.any([context.signal, cancellation.signal]));
81:       finished = true;
82:       return { summary: 'Owned unpublished source cleanup completed', evidence: [], exitCode: 0, signal: null,
83:         specialistResult: { ...nativeSourceCleanupResultSchema,
84:           values: { reconciliationDigest: sha256Digest(envelope.operation.values) } } };
85:     },
86:     async terminate() { cancel(); },
87:     async cleanup() { if (!finished) throw new Error('BUSTER_PREPARATION_SOURCE_RECONCILIATION_REQUIRED'); },
88:     async measure() {
89:       const resources = observeNativeWorkerResources(assigned('KUBECLAW_NATIVE_SCOPE'));
90:       return { cpuTimeMs: { status: 'observed', value: Math.ceil(resources.cpuTimeMicroseconds / 1000) },
91:         maximumMemoryBytes: { status: 'observed', value: resources.maximumMemoryBytes },
92:         maximumTasks: { status: 'observed', value: resources.maximumTasks } };
93:     },
94:   };
95:   try {
96:     const result = await new WorkerAttemptExecutor({ envelope, operation, signal: cancellation.signal,
97:       retainLogs: false, receiptNamespace: 'buster-source-cleanup-provisional' }).execute();
98:     process.stdout.write(JSON.stringify(result));
99:   } finally {
100:     process.removeListener('SIGINT', cancel);
101:     process.removeListener('SIGTERM', cancel);
102:   }
103: }
104: 
105: await main();

