9: export const nativeJournalMaximumDiagnosticUnits = 4096;
10: 
11: export interface NativeAttemptJournalLimits {
12:   readonly maximumRecords: number;
13:   readonly maximumStateBytes: number;
14:   readonly maximumTotalBytes: number;
15:   readonly maximumInputBytes: number;
16:   readonly maximumOutputBytes: number;
17:   readonly maximumResultBytes: number;
18: }
19: 
20: interface BlobReference { readonly digest: string; readonly sizeBytes: number }
21: type ProcessRecord = Omit<NativeWorkerProcessResult, 'stdout' | 'stderr'> & { stdout: BlobReference; stderr: BlobReference };
22: export interface NativeAttemptJournalState {
23:   readonly schemaVersion: 'native-attempt-journal.v1';
24:   readonly identity: WorkerOwnershipIdentity;
25:   readonly envelopeDigest: string;
26:   readonly envelope: BlobReference;
27:   readonly acceptedAt: string;
28:   readonly reservationBytes: number;
29:   readonly process: ProcessRecord | null;
30:   readonly processCompletedAt: string | null;
31:   readonly result: BlobReference | null;
32: }
33: 
34: export function journalIdentity(envelope: WorkerAttemptEnvelopeV3): WorkerOwnershipIdentity {
35:   return { workerId: envelope.claim.workerId, attemptId: envelope.attemptId, claimId: envelope.claim.claimId,
36:     generation: envelope.claim.generation, profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest };
37: }
38: 
39: export function journalKey(envelope: WorkerAttemptEnvelopeV3): string {
40:   return sha256Digest([envelope.claim.workerId, envelope.attemptId, envelope.claim.generation]);
41: }
42: 
43: function blobReference(value: unknown): void {
44:   exact(value, ['digest', 'sizeBytes']);
45:   if (typeof value.digest !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(value.digest)
46:     || !Number.isSafeInteger(value.sizeBytes) || Number(value.sizeBytes) < 0) throw new Error('WORKER_NATIVE_JOURNAL_BLOB_INVALID');
47: }
48: 
49: export function validateJournalState(value: unknown): asserts value is NativeAttemptJournalState {
50:   exact(value, ['schemaVersion', 'identity', 'envelopeDigest', 'envelope', 'acceptedAt', 'reservationBytes', 'process', 'processCompletedAt', 'result']);
51:   if (value.schemaVersion !== 'native-attempt-journal.v1' || typeof value.acceptedAt !== 'string'
52:     || !Number.isFinite(Date.parse(value.acceptedAt)) || !Number.isSafeInteger(value.reservationBytes) || Number(value.reservationBytes) < 1) {
53:     throw new Error('WORKER_NATIVE_JOURNAL_STATE_INVALID');
54:   }
55:   identityValid(value.identity);
56:   blobReference(value.envelope);
57:   if (value.envelopeDigest !== (value.envelope as BlobReference).digest) throw new Error('WORKER_NATIVE_JOURNAL_ENVELOPE_DIGEST_INVALID');
58:   if (value.result !== null) blobReference(value.result);
59:   if (value.process !== null) {
60:     validateProcess(value.process);
61:     if (typeof value.processCompletedAt !== 'string' || !Number.isFinite(Date.parse(value.processCompletedAt))) throw new Error('WORKER_NATIVE_JOURNAL_COMPLETION_TIME_INVALID');
62:   } else if (value.processCompletedAt !== null) throw new Error('WORKER_NATIVE_JOURNAL_COMPLETION_TIME_INVALID');
63: }
64: 
65: function validateProcess(value: unknown): void {
66:   exact(value, ['schemaVersion', 'stdout', 'stderr', 'exitCode', 'signal', 'fault', 'resources']);
67:   if (value.schemaVersion !== 'worker-native-process-result.v1') throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_INVALID');
68:   blobReference(value.stdout); blobReference(value.stderr);
69:   validateNativeWorkerResourceObservation(value.resources);
70:   if (value.resources.populated) throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_NOT_QUIESCENT');
71:   if (value.exitCode !== null && (!Number.isInteger(value.exitCode) || Number(value.exitCode) < 0 || Number(value.exitCode) > 255)) throw new Error('WORKER_NATIVE_JOURNAL_EXIT_INVALID');
72:   if (value.exitCode !== 0 && value.fault === null) throw new Error('WORKER_NATIVE_JOURNAL_MISSING_PROCESS_FAILURE');
73:   for (const key of ['signal', 'fault']) {
74:     if (value[key] !== null && (typeof value[key] !== 'string' || value[key].length < 1 || value[key].length > nativeJournalMaximumDiagnosticUnits)) throw new Error('WORKER_NATIVE_JOURNAL_FAULT_INVALID');
75:   }
76: }
77: 
78: /** Count actual retained bytes, including crash leftovers, before new admission. */
79: export async function usedJournalBytes(root: string): Promise<number> {
80:   let total = 0;
81:   const pending = [root];
82:   while (pending.length) {
83:     const directory = pending.pop()!;
84:     for (const entry of await fs.readdir(directory, { withFileTypes: true })) {
85:       const file = path.join(directory, entry.name);
86:       if (entry.isDirectory()) { pending.push(file); continue; }
87:       if (!entry.isFile()) throw new Error('WORKER_NATIVE_JOURNAL_PATH_INVALID');
88:       total += await retainedFileSize(file);
89:       if (!Number.isSafeInteger(total)) throw new Error('WORKER_NATIVE_JOURNAL_CAPACITY_EXCEEDED');
90:     }
91:   }
92:   return total;
93: }
94: 
95: async function retainedFileSize(file: string): Promise<number> {
96:   try { return (await fs.lstat(file)).size; }
97:   catch (error) {
98:     // Atomic durable writes may unlink their temporary name during this scan.
99:     if ((error as NodeJS.ErrnoException).code === 'ENOENT') return 0;
100:     throw error;
101:   }
102: }

SOURCE skills/worker/core/worker/native-node-identity.ts SHA256 6ea78a96f82fa25ad27b26a2a48911e1e7a625fe9c0b25db76af39f49f2394f3
1: import fs from 'node:fs';
2: import path from 'node:path';
3: 
4: /** Root-managed host identity, mounted read-only by trusted deployment setup. */
5: export function readNativeWorkerNodeIdentity(file: string): string {
6:   if (!path.isAbsolute(file)) throw new Error('WORKER_NATIVE_NODE_IDENTITY_PATH_REQUIRED');
7:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
8:   try {
9:     const stat = fs.fstatSync(fd);
10:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || stat.size < 1 || stat.size > 128) {
11:       throw new Error('WORKER_NATIVE_NODE_IDENTITY_NOT_TRUSTED');
12:     }
13:     const identity = fs.readFileSync(fd, 'utf8').trim();
14:     if (!/^(?:[a-f0-9]{32}|[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12})$/u.test(identity)) {
15:       throw new Error('WORKER_NATIVE_NODE_IDENTITY_INVALID');
16:     }
17:     return `native-node:${identity}`;
18:   } finally { fs.closeSync(fd); }
19: }

SOURCE skills/worker/core/worker/native-pool-policy.ts SHA256 3b64878629a5ee897e8dd71ae6b592bc1c89df36677fc2860f8d7f4bb4227307
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import type { NativeWorkerPoolLimits } from './native-resource-pool.ts';
4: 
5: export interface NativeWorkerPoolPolicy {
6:   readonly schemaVersion: 1;
7:   readonly role: string;
8:   readonly nodeName: string;
9:   readonly policyDigest: string;
10:   readonly cgroupRoot: string;
11:   readonly ownershipRoot: string;
12:   readonly nodeIdentityFile: string;
13:   readonly runtimeIdentityFile: string;
14:   readonly maximumActiveScopes: number;
15:   readonly limits: NativeWorkerPoolLimits;
16: }
17: 
18: /** Generated by host preparation; no envelope or mutable worker environment defines aggregate capacity. */
19: export function readNativeWorkerPoolPolicy(file: string, role: string): NativeWorkerPoolPolicy {
20:   if (!path.isAbsolute(file)) throw new Error('WORKER_NATIVE_POOL_POLICY_PATH_REQUIRED');
21:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
22:   try {
23:     const stat = fs.fstatSync(fd);
24:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || stat.size < 1 || stat.size > 65536) {
25:       throw new Error('WORKER_NATIVE_POOL_POLICY_NOT_TRUSTED');
26:     }
27:     const value = JSON.parse(fs.readFileSync(fd, 'utf8')) as NativeWorkerPoolPolicy;
28:     validate(value, role);
29:     return Object.freeze({ ...value, limits: Object.freeze({ ...value.limits }) });
30:   } finally { fs.closeSync(fd); }
31: }
32: 
33: function validate(value: NativeWorkerPoolPolicy, role: string): void {
34:   if (value?.schemaVersion !== 1 || value.role !== role || typeof value.nodeName !== 'string' || !value.nodeName
35:     || typeof value.policyDigest !== 'string' || !/^[a-f0-9]{64}$/u.test(value.policyDigest)) throw new Error('WORKER_NATIVE_POOL_POLICY_INVALID');
36:   validatePaths(value);
37:   validateLimits(value);
38: }
39: 
40: function validatePaths(value: NativeWorkerPoolPolicy): void {
41:   for (const location of [value.cgroupRoot, value.ownershipRoot, value.nodeIdentityFile, value.runtimeIdentityFile]) {
42:     if (typeof location !== 'string' || !path.isAbsolute(location) || location === '/' || path.resolve(location) !== location) {
43:       throw new Error('WORKER_NATIVE_POOL_POLICY_PATH_INVALID');
44:     }
45:   }
46: }
47: 
48: function validateLimits(value: NativeWorkerPoolPolicy): void {
49:   for (const number of [value.maximumActiveScopes, value.limits?.memoryBytes, value.limits?.tasks,
50:     value.limits?.cpuQuotaMicroseconds, value.limits?.cpuPeriodMicroseconds]) {
51:     if (!Number.isSafeInteger(number) || number < 1) throw new Error('WORKER_NATIVE_POOL_POLICY_LIMIT_INVALID');
52:   }
53: }

SOURCE skills/worker/core/worker/native-resource-scope.ts SHA256 f10a3700c82322b4f426f520c8bd01dde8bdbd45678f36fa7b88292f1f419e0c
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import { requireHierarchicalCgroupEvents } from './native-hierarchy-events.ts';
4: import { randomUUID } from 'node:crypto';
5: import type { WorkerOwnedChild } from './ownership-children.ts';
6: import { aggregateChildLimits, configureNativeLimits, createNativeChild, verifyNativeChild, verifyNativeChildren } from './native-owned-children.ts';
7: import { setTimeout as delay } from 'node:timers/promises';
8: import { performance } from 'node:perf_hooks';
9: import { observeNativeWorkerResources, type NativeWorkerResourceObservation } from './native-resource-observation.ts';
10: import type { WorkerScopeBinding } from './ownership-store.ts';
11: 
12: export interface NativeWorkerScopeLimits {
13:   readonly memoryBytes: number;
14:   readonly tasks: number;
15: }
16: 
17: const scopeNamePattern = /^worker-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u;
18: 
19: function delegatedRoot(rootValue: string): string {
20:   if (!path.isAbsolute(rootValue)) throw new Error('WORKER_NATIVE_ROOT_INVALID');
21:   const root = fs.realpathSync(rootValue);
22:   if (root === '/' || root === '/sys/fs/cgroup' || fs.statfsSync(root).type !== 0x63677270) {
23:     throw new Error('WORKER_NATIVE_ROOT_INVALID');
24:   }
25:   if (fs.readFileSync(path.join(root, 'cgroup.procs'), 'utf8').trim()) {
26:     throw new Error('WORKER_NATIVE_ROOT_POPULATED');
27:   }
28:   const controllers = fs.readFileSync(path.join(root, 'cgroup.subtree_control'), 'utf8').trim().split(/\s+/u);
29:   if (!['cpu', 'memory', 'pids'].every(controller => controllers.includes(controller))) {
30:     throw new Error('WORKER_NATIVE_ROOT_NOT_DELEGATED');
31:   }
32:   return root;
33: }
34: 
35: function bootId(): string {
36:   return fs.readFileSync('/proc/sys/kernel/random/boot_id', 'utf8').trim();
37: }
38: 
39: function positive(value: number): void {
40:   if (!Number.isSafeInteger(value) || value < 1) throw new Error('WORKER_NATIVE_LIMIT_INVALID');
41: }
42: 
43: /** A kernel scope, not an attempt/fixture registry or a process launcher. */
44: export class NativeWorkerResourceScope {
45:   readonly #path: string;
46:   readonly #device: number;
47:   readonly #inode: number;
48:   readonly #aggregate: boolean;
49:   #disposed = false;
50:   #quiescing = false;
51: 
52:   private constructor(scope: string, aggregate: boolean) {
53:     this.#aggregate = aggregate;
54:     this.#path = scope;
55:     const stat = fs.statSync(scope);
56:     this.#device = stat.dev;
57:     this.#inode = stat.ino;
58:   }
59: 
60:   /** The root is chosen by deployment, never by an attempt envelope. */
61:   static create(rootValue: string, limits: NativeWorkerScopeLimits): NativeWorkerResourceScope {
62:     positive(limits.memoryBytes);
63:     positive(limits.tasks);
64:     const root = delegatedRoot(rootValue);
65:     requireHierarchicalCgroupEvents(root);
66:     // Existing roots are never chmod/chowned, remounted or reconfigured here.
67:     const scope = path.join(root, `worker-${randomUUID()}`);
68:     fs.mkdirSync(scope);
69:     return NativeWorkerResourceScope.#configure(scope, limits);
70:   }
71: 
72:   /** Reservation is persisted before mkdir; no process may enter before binding is durable. */
73:   static createReserved(rootValue: string, scopeName: string, limits: NativeWorkerScopeLimits): NativeWorkerResourceScope {
74:     positive(limits.memoryBytes);
75:     positive(limits.tasks);
76:     if (!scopeNamePattern.test(scopeName)) throw new Error('WORKER_NATIVE_SCOPE_NAME_INVALID');
77:     const root = delegatedRoot(rootValue);
78:     requireHierarchicalCgroupEvents(root);
79:     const scope = path.join(root, scopeName);
80:     fs.mkdirSync(scope); // Exclusive. Never adopt a pre-existing directory during admission.
81:     return NativeWorkerResourceScope.#configure(scope, limits);
82:   }
83: 
84:   static #configure(scope: string, limits: NativeWorkerScopeLimits): NativeWorkerResourceScope {
85:     try {
86:       configureNativeLimits(scope, limits);
87:       fs.writeFileSync(path.join(scope, 'cgroup.subtree_control'), '+cpu +memory +pids');
88:       const enabled = fs.readFileSync(path.join(scope, 'cgroup.subtree_control'), 'utf8').trim().split(/\s+/u);
89:       if (!['cpu', 'memory', 'pids'].every(name => enabled.includes(name))) throw new Error('WORKER_NATIVE_CONTROLLERS_MISSING');
90:       fs.accessSync(path.join(scope, 'cgroup.kill'), fs.constants.W_OK);
91:       const owner = new NativeWorkerResourceScope(scope, true);
92:       if (owner.observe().populated) throw new Error('WORKER_NATIVE_SCOPE_NOT_EMPTY');
93:       return owner;
94:     } catch (cause) {
95:       try { fs.rmdirSync(scope); }
96:       catch (cleanup) { throw new AggregateError([cause, cleanup], 'WORKER_NATIVE_SETUP_CLEANUP_FAILED'); }
97:       throw cause;
98:     }
99:   }
100: 
101:   static inventory(rootValue: string): readonly string[] {
102:     return fs.readdirSync(delegatedRoot(rootValue), { withFileTypes: true })
103:       .filter(entry => entry.isDirectory()).map(entry => entry.name).sort();
104:   }
105: 
106:   /** Recovery before the durable launch fence: only an empty reservation can be adopted. */
107:   static recoverEmptyReservation(rootValue: string, scopeName: string, aggregate = false): NativeWorkerResourceScope {
108:     if (!scopeNamePattern.test(scopeName)) throw new Error('WORKER_NATIVE_SCOPE_NAME_INVALID');
109:     const scope = path.join(delegatedRoot(rootValue), scopeName);
110:     if (!fs.lstatSync(scope).isDirectory()) throw new Error('WORKER_NATIVE_SCOPE_BINDING_CHANGED');
111:     const owner = new NativeWorkerResourceScope(scope, aggregate);
112:     if (owner.observe().populated) throw new Error('WORKER_NATIVE_UNBOUND_SCOPE_POPULATED');
113:     return owner;
114:   }
115: 
116:   /** An inode alone can be reused across boots. Both identities must match. */
117:   static reopen(rootValue: string, binding: WorkerScopeBinding, aggregate = false): NativeWorkerResourceScope {
118:     if (!scopeNamePattern.test(binding.scopeName) || binding.bootId !== bootId()) {
119:       throw new Error('WORKER_NATIVE_SCOPE_BINDING_CHANGED');
120:     }
121:     const scope = path.join(delegatedRoot(rootValue), binding.scopeName);
122:     const stat = fs.lstatSync(scope);
123:     if (!stat.isDirectory() || stat.dev !== binding.device || stat.ino !== binding.inode) {
124:       throw new Error('WORKER_NATIVE_SCOPE_BINDING_CHANGED');
125:     }
126:     return new NativeWorkerResourceScope(scope, aggregate);
127:   }
128: 
129:   binding(): WorkerScopeBinding {
130:     this.#checkIdentity();
131:     return { scopeName: path.basename(this.#path), bootId: bootId(), device: this.#device, inode: this.#inode };
132:   }
133: 
134:   childLimits(requested?: NativeWorkerScopeLimits): NativeWorkerScopeLimits {
135:     this.#checkIdentity();
136:     return aggregateChildLimits(this.#path, requested);
137:   }
138: 
139:   createChild(child: WorkerOwnedChild): WorkerScopeBinding {
140:     this.#checkIdentity();
141:     if (this.#quiescing) throw new Error('WORKER_NATIVE_SCOPE_QUIESCING');
142:     return createNativeChild(this.#path, this.binding(), child);
143:   }
144: 
145:   /** The caller must persist the returned child binding before obtaining launch arguments. */
146:   childLaunchArguments(child: WorkerOwnedChild): readonly string[] {
147:     this.#checkIdentity();
148:     if (this.#quiescing) throw new Error('WORKER_NATIVE_SCOPE_QUIESCING');
149:     if (!child.binding) throw new Error('WORKER_NATIVE_CHILD_BINDING_REQUIRED');
150:     const target = verifyNativeChild(this.#path, this.binding(), child);
151:     return [target, String(this.#device), String(this.#inode), String(child.binding.device), String(child.binding.inode)];
152:   }
153: 
154:   verifyChildren(children: readonly WorkerOwnedChild[], removalStarted: boolean): void {
155:     this.#checkIdentity();
156:     verifyNativeChildren(this.#path, this.binding(), children, removalStarted);
157:   }
158: 
159:   disposeChildren(children: readonly WorkerOwnedChild[]): void {
160:     this.#checkIdentity();
161:     if (!this.#quiescing || this.observe().populated) throw new Error('WORKER_NATIVE_SCOPE_NOT_QUIESCENT');
162:     for (const target of verifyNativeChildren(this.#path, this.binding(), children, true)) fs.rmdirSync(target);
163:   }
164: 
165:   observe(): NativeWorkerResourceObservation {
166:     this.#checkIdentity();
167:     return observeNativeWorkerResources(this.#path);
168:   }
169: 
170:   /** Keep cumulative counters available until the caller seals its result. */
171:   async terminateAndDrain(timeoutMs: number, signal?: AbortSignal): Promise<NativeWorkerResourceObservation> {
172:     positive(timeoutMs);
173:     signal?.throwIfAborted();
174:     this.#checkIdentity();
175:     this.#quiescing = true;
176:     fs.writeFileSync(path.join(this.#path, 'cgroup.kill'), '1');
177:     const deadline = performance.now() + timeoutMs;
178:     for (;;) {
179:       signal?.throwIfAborted();
180:       const observation = this.observe();
181:       if (!observation.populated) return observation;
182:       const remaining = deadline - performance.now();
183:       if (remaining <= 0) throw new Error('WORKER_NATIVE_DRAIN_TIMEOUT');
184:       await delay(Math.min(10, remaining), undefined, signal ? { signal } : undefined);
185:     }
186:   }
187: 
188:   /** Disposal cannot stand in for confirmed termination or erase a live scope. */
189:   dispose(): void {
190:     if (this.#disposed) return;
191:     if (!this.#quiescing || this.observe().populated) throw new Error('WORKER_NATIVE_SCOPE_NOT_QUIESCENT');
192:     fs.rmdirSync(this.#path);
193:     this.#disposed = true;
194:   }
195: 
196:   #checkIdentity(): void {
197:     if (this.#disposed) throw new Error('WORKER_NATIVE_SCOPE_DISPOSED');
198:     if (this.#aggregate) requireHierarchicalCgroupEvents(this.#path);
199:     const stat = fs.lstatSync(this.#path);
200:     if (!stat.isDirectory() || stat.dev !== this.#device || stat.ino !== this.#inode) {
201:       throw new Error('WORKER_NATIVE_SCOPE_IDENTITY_CHANGED');
202:     }
203:   }
204: }

SOURCE skills/worker/core/worker/native-runtime-identity.ts SHA256 4bb8600bf48477411e75148e6edbd0dae345809316d60a3d3cd4b8ad6f8a057e
1: import fs from 'node:fs';
2: import path from 'node:path';
3: 
4: interface RuntimeIdentity {
5:   schemaVersion: 1;
6:   bootId: string;
7:   cgroupNamespace: { device: string; inode: string };
8: }
9: 
10: /** Compare the actual namespace with root-managed host evidence; never enter a namespace here. */
11: export function requireNativeWorkerRuntimeIdentity(file: string): void {
12:   if (!path.isAbsolute(file)) throw new Error('WORKER_NATIVE_RUNTIME_IDENTITY_PATH_REQUIRED');
13:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
14:   try {
15:     const stat = fs.fstatSync(fd);
16:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || stat.size < 1 || stat.size > 4096) {
17:       throw new Error('WORKER_NATIVE_RUNTIME_IDENTITY_NOT_TRUSTED');
18:     }
19:     const identity = JSON.parse(fs.readFileSync(fd, 'utf8')) as RuntimeIdentity;
20:     const bootId = fs.readFileSync('/proc/sys/kernel/random/boot_id', 'utf8').trim();
21:     const namespace = fs.statSync('/proc/self/ns/cgroup', { bigint: true });
22:     if (identity?.schemaVersion !== 1 || identity.bootId !== bootId
23:       || identity.cgroupNamespace?.device !== String(namespace.dev)
24:       || identity.cgroupNamespace?.inode !== String(namespace.ino)) {
25:       throw new Error('WORKER_NATIVE_HOST_CGROUP_NAMESPACE_REQUIRED');
26:     }
27:   } finally { fs.closeSync(fd); }
28: }

