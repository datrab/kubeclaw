138:     const { workerResult, workerRuntimeFault } = await executeRunnerAttempt({
139:       options: this.#options, workerRuntime: this.#workerRuntime, now: this.#now,
140:       id: this.#id, authorityId: this.#authorityId, completion: this.#completionOwner(),
141:     }, workerEnvelope, operation, stagingBase);
142:     return finalizeRunnerAttempt({ options: this.#options, now: this.#now, id: this.#id,
143:       authorityId: this.#authorityId, cleanupErrors: this.#cleanupErrors,
144:       cleanupProvider: (next, instance, value, log) => this.#cleanupProvider(next, instance, value, log),
145:     }, { prepared, state, node, attemptNumber, issuedAt, busterLog, workerResult, workerRuntimeFault });
146:   }
147: 
148:   #completionOwner(): CompletionOwner {
149:     return { options: this.#options, attemptStore: this.#durableAttemptStore,
150:       admissionStore: this.#observabilityAdmissionStore, authorityId: this.#authorityId, now: this.#now };
151:   }
152: 
153:   #context(
154:     signal: AbortSignal,
155:     log: TestProviderExecutionContext["log"],
156:     granted: ReadonlySet<string>,
157:     inputs: readonly ResolvedInputV1[],
158:   ): TestProviderExecutionContext {
159:     return Object.freeze({
160:       signal,
161:       workspaceRoot: this.#workspaceRoot,
162:       log,
163:       invoke: async (
164:         capability: string,
165:         request: TestProviderCapabilityRequest,
166:         invocationSignal?: AbortSignal,
167:       ) => {
168:         if (!granted.has(capability))
169:           throw new Error(`TEST_PROVIDER_CAPABILITY_DENIED:${capability}`);
170:         if (!this.#options.capabilityInvoker)
171:           throw new Error(`TEST_PROVIDER_CAPABILITY_UNAVAILABLE:${capability}`);
172:         return this.#options.capabilityInvoker.invoke(
173:           capability,
174:           request,
175:           invocationSignal ? AbortSignal.any([signal, invocationSignal]) : signal,
176:           inputs,
177:         );
178:       },
179:     });
180:   }
181: 
182:   async #collectEvidence(
183:     entry: TestProviderRegistryEntry,
184:     attemptId: string,
185:     evidenceDirectory: string,
186:     declarations: readonly DeclaredEvidenceV1[],
187:     maximumFiles: number,
188:     maximumBytes: number,
189:     signal: AbortSignal,
190:   ): Promise<EvidenceRefV1[]> {
191:     signal.throwIfAborted();
192:     if (declarations.length > maximumFiles)
193:       throw new Error("TEST_PROVIDER_ARTIFACT_FILE_LIMIT");
194:     const ids = new Set<string>();
195:     const files = new Set<string>();
196:     const evidence: EvidenceRefV1[] = [];
197:     let total = 0;
198:     for (const declaration of declarations) {
199:       signal.throwIfAborted();
200:       if (ids.has(declaration.evidenceId) || files.has(declaration.file))
201:         throw new Error(
202:           `TEST_PROVIDER_EVIDENCE_DUPLICATE:${declaration.evidenceId}`,
203:         );
204:       ids.add(declaration.evidenceId);
205:       files.add(declaration.file);
206:       if (!entry.registration.evidenceTypes.includes(declaration.type))
207:         throw new Error(
208:           `TEST_PROVIDER_EVIDENCE_TYPE_INVALID:${declaration.type}`,
209:         );
210:       const stored = await this.#store.store(
211:         attemptId,
212:         evidenceDirectory,
213:         declaration,
214:         maximumBytes - total,
215:         signal,
216:       );
217:       signal.throwIfAborted();
218:       total += stored.artifact.sizeBytes;
219:       if (total > maximumBytes)
220:         throw new Error("TEST_PROVIDER_ARTIFACT_BYTE_LIMIT");
221:       evidence.push(
222:         Object.freeze({
223:           evidenceId: declaration.evidenceId,
224:           type: declaration.type,
225:           artifact: stored.artifact,
226:         }),
227:       );
228:     }
229:     return evidence;
230:   }
231: 
232:   #fixtureOwner(): FixtureOwner {
233:     return { workspaceRoot: this.#workspaceRoot, cleanupErrors: this.#cleanupErrors,
234:       cleanupTimeoutMs: () => this.#options.executionPolicy.provider.cleanupTimeoutMs,
235:       context: (signal, log, grants, inputs) => this.#context(signal, log, grants, inputs) };
236:   }
237: 
238:   #cleanupProvider(node: ResolvedPlanNodeV1, instance: LoadedTestProvider,
239:     invocation: ProviderInvocationV1, log: TestProviderExecutionContext['log']): Promise<boolean> {
240:     return cleanupRetainedProvider(this.#fixtureOwner(), node, instance, invocation, log, 'incomplete');
241:   }
242: 
243:   #cleanupFixtures(): Promise<void> {
244:     return cleanupRetainedFixtures(this.#fixtureOwner(), this.#retainedFixtures);
245:   }
246: }

SOURCE skills/prism/config/native-worker.ts SHA256 c2a0722a4a938830529d5f60ff5fb4533984a0f8e38c37c693be79c0674141a6
1: import path from 'node:path';
2: import { requirePrismResourcePoolCapacity } from './resource-policy.ts';
3: import type { loadWorkerConfig } from '../server/worker-config.ts';
4: import { readNativeWorkerNodeIdentity, readNativeWorkerPoolPolicy, requireNativeWorkerRuntimeIdentity } from '@kubeclaw/worker-core';
5: 
6: /** Image identity shared by producer and worker. */
7: export function prismEngineContentDigest(environment: NodeJS.ProcessEnv = process.env): string | undefined {
8:   const digest = environment.PRISM_ENGINE_CONTENT_DIGEST?.trim();
9:   if (environment.NODE_ENV === 'production' && !/^sha256:[a-f0-9]{64}$/u.test(digest ?? '')) {
10:     throw new Error('PRISM_NATIVE_ENGINE_CONTENT_IDENTITY_REQUIRED');
11:   }
12:   return digest;
13: }
14: 
15: export function nativePrismHostConfig(environment: NodeJS.ProcessEnv = process.env) {
16:   const scope = environment.KUBECLAW_NATIVE_SCOPE;
17:   if (!scope) throw new Error('PRISM_NATIVE_PREEXEC_MEMBERSHIP_REQUIRED');
18:   if (environment.PRISM_NATIVE_MAXIMUM_INPUT_BYTES !== undefined) throw new Error('SWARM_CONFIG_LEGACY_OVERRIDE:PRISM_NATIVE_MAXIMUM_INPUT_BYTES');
19:   const maximumInputBytes = Number(environment.PRISM_NATIVE_ASSIGNED_INPUT_BYTES);
20:   if (!Number.isSafeInteger(maximumInputBytes) || maximumInputBytes < 1 || maximumInputBytes > 2_147_483_647) throw new Error('PRISM_NATIVE_INPUT_LIMIT_REQUIRED');
21:   const controlInternalUrl = new URL(environment.PRISM_CONTROL_INTERNAL_URL!);
22:   const workerSecret = environment.PRISM_WORKER_SECRET ?? '';
23:   const spiffeEnabled = environment.WORKER_TRUST_SPIFFE_ENABLED === 'true';
24:   if (!spiffeEnabled && !workerSecret) throw new Error('PRISM_NATIVE_ARTIFACT_AUTH_REQUIRED');
25:   return Object.freeze({ scope, maximumInputBytes, controlInternalUrl, workerSecret, spiffeEnabled });
26: }
27: 
28: export function nativePrismSupervisorConfig(config: ReturnType<typeof loadWorkerConfig>, environment: NodeJS.ProcessEnv = process.env) {
29:   const root = (name: string) => {
30:     const value = environment[name];
31:     if (!value || !path.isAbsolute(value) || path.resolve(value) !== value || value === '/') throw new Error(`PRISM_NATIVE_PATH_REQUIRED:${name}`);
32:     return value;
33:   };
34:   const engineContentDigest = prismEngineContentDigest(environment);
35:   if (!/^sha256:[a-f0-9]{64}$/u.test(engineContentDigest ?? '')) throw new Error('PRISM_NATIVE_ENGINE_CONTENT_IDENTITY_REQUIRED');
36:   const pool = readNativeWorkerPoolPolicy(root('PRISM_NATIVE_POOL_POLICY_FILE'), 'prism');
37:   requirePrismResourcePoolCapacity(config.native.resourcePolicy, pool.limits);
38:   requireNativeWorkerRuntimeIdentity(pool.runtimeIdentityFile);
39:   return Object.freeze({
40:     ...prismSupervisorSettings(config),
41:     engineContentDigest: engineContentDigest!,
42:     cgroupRoot: pool.cgroupRoot, ownershipRoot: pool.ownershipRoot,
43:     poolLimits: pool.limits, nodeIdentity: readNativeWorkerNodeIdentity(pool.nodeIdentityFile),
44:     launcher: root('PRISM_NATIVE_LAUNCHER'),
45:     maximumActiveScopes: pool.maximumActiveScopes,
46:     browserPath: environment.PLAYWRIGHT_BROWSERS_PATH ?? '/ms-playwright',
47:   });
48: }
49: 
50: /** Numeric startup snapshot; host authority is validated separately before composition. */
51: export function prismSupervisorSettings(config: ReturnType<typeof loadWorkerConfig>) {
52:   const supervisor = config.native.supervisor;
53:   return Object.freeze({
54:     policy: config.native.resourcePolicy,
55:     uid: supervisor.uid, gid: supervisor.gid,
56:     maximumRecords: supervisor.maximumOwnershipRecords,
57:     maximumBytes: supervisor.maximumOwnershipBytes,
58:     maximumInputBytes: config.ingress.maximumInputBytes,
59:     maximumOutputBytes: supervisor.maximumOutputBytes,
60:     maximumResultBytes: config.native.maximumResultBytes,
61:     maximumJournalBytes: supervisor.maximumJournalBytes,
62:     pollIntervalMs: supervisor.pollIntervalMs,
63:     drainTimeoutMs: supervisor.drainTimeoutMs,
64:     closeTimeoutMs: supervisor.closeTimeoutMs,
65:   });
66: }

SOURCE skills/prism/config/resource-policy.ts SHA256 46d4daca088d7f716a202abc5e94794830d601db47518479da19056ed5fc652f
1: import type { WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
2: import type { PrismResourcePolicy } from '../../common/plugin-runtime/foundation/config/swarm.ts';
3: 
4: /** Cumulative CPU time is not comparable to the pool's CPU quota/rate. */
5: export function requirePrismResourcePoolCapacity(policy: PrismResourcePolicy, pool: { memoryBytes: number; tasks: number }): void {
6:   for (const metric of ['memoryBytes', 'tasks'] as const) {
7:     if (policy[metric] > pool[metric]) throw new Error(`PRISM_NATIVE_POLICY_EXCEEDS_POOL:${metric}`);
8:   }
9: }
10: 
11: /** Admit new budgets against the startup policy; preserve already accepted identities. */
12: export function prismAttemptResourceLimits(envelope: WorkerAttemptEnvelopeV3, policy: PrismResourcePolicy, recovered: boolean) {
13:   const requested = (metric: 'cpuTimeMs' | 'maximumMemoryBytes' | 'maximumTasks', maximum: number) => {
14:     const budget = envelope.resourceBudgets[metric];
15:     if (budget.state !== 'requested' || (!recovered && budget.limit > maximum)) throw new Error(`PRISM_NATIVE_BUDGET_NOT_ACCEPTED:${metric}`);
16:     return budget.limit;
17:   };
18:   return { cpuTimeMs: requested('cpuTimeMs', policy.cpuTimeMs),
19:     memoryBytes: requested('maximumMemoryBytes', policy.memoryBytes), tasks: requested('maximumTasks', policy.tasks) };
20: }

SOURCE skills/prism/control/agent-jobs.ts SHA256 ff62ef04432ebb67c700c4a25103a0477096f588c2cc3f34f3fab0b776860334
1: import { checkWorkerResourceResultBinding,type WorkerAttemptEnvelopeV2,type WorkerAttemptResultV2 } from '@kubeclaw/pipeline-worker-core-contract';
2: import { agentAttempt } from '../server/agent-attempt.ts';
3: import { randomUUID } from 'node:crypto';
4: import { sha256Digest } from '@kubeclaw/worker-core';
5: import { inTransaction, type Database, type Queryable } from '../storage/index.ts';
6: import { agentSessionKey } from '../server/agent-session.ts';
7: 
8: export type AgentJob = Record<string,unknown> & {
9:   id:string; project_id:string; operation:'design-set'|'revise'; session_key:string;
10:   request_digest:string; request:Record<string,unknown>; state:'accepted'|'running'|'completed'|'needs_nova'|'superseded';
11:   attempt_envelope:WorkerAttemptEnvelopeV2|null; fence:string|null; result:unknown; result_digest:string|null;
12: };
13: export type AgentCompletion = {jobId:string; fence:string; payload:unknown};
14: 
15: /** Called only by authenticated Control admission paths, never from project-authored bridge input. */
16: export async function enqueueAgentJob(db: Database, namespace:string, projectId:string, operation:AgentJob['operation'], input:Record<string,unknown> & {preferences:{generationId:string}}) {
17:   return inTransaction(db,connection=>insertAgentJob(connection,namespace,projectId,operation,input));
18: }
19: 
20: export async function insertAgentJob(connection:Queryable,namespace:string,projectId:string,operation:AgentJob['operation'],input:Record<string,unknown> & {preferences:{generationId:string}}) {
21:     const generation=await connection.query<{project_id:string}>("SELECT g.project_id FROM prism.preference_generation g JOIN prism.project p ON p.id=g.project_id WHERE g.id=$1 AND p.external_id=$2 FOR SHARE OF g",[input.preferences.generationId,projectId]);
22:     if(!generation.rows[0])throw new Error('agent job generation does not belong to project');
23:     input={...input,preferences:Object.fromEntries(Object.entries(input.preferences).filter(([key])=>key!=='result')) as {generationId:string}};
24:     const requestDigest=sha256Digest({operation,input});
25:     await connection.query("INSERT INTO prism.agent_job(id,project_id,operation,session_namespace,session_key,request_digest,request) VALUES($1,$2,$3,$4,$5,$6,$7::jsonb) ON CONFLICT(id) DO NOTHING",[input.preferences.generationId,generation.rows[0].project_id,operation,namespace,agentSessionKey(namespace,projectId),requestDigest,JSON.stringify(input)]);
26:     const job=await agentJob(connection,input.preferences.generationId);
27:     if(job.request_digest!==requestDigest)throw new Error('agent job generation conflicts with recorded request');
28:     return job;
29: }
30: 
31: export async function agentJob(db:Queryable,id:string):Promise<AgentJob> {
32:   await db.query("UPDATE prism.agent_job SET state='needs_nova',outcome=jsonb_build_object('reason','external agent outcome unresolved after claim expiry'),updated_at=clock_timestamp() WHERE state='running' AND expires_at<=clock_timestamp() AND session_key=(SELECT session_key FROM prism.agent_job WHERE id=$1)",[id]);
33:   const row=await db.query<AgentJob>("SELECT j.*,(SELECT blocked.id FROM prism.agent_job blocked WHERE blocked.session_key=j.session_key AND blocked.state='needs_nova' ORDER BY blocked.created_at,blocked.id LIMIT 1) AS blocked_by FROM prism.agent_job j WHERE j.id=$1",[id]);
34:   if(!row.rows[0])throw new Error('persisted Prism agent job not found');
35:   return row.rows[0];
36: }
37: 
38: /** Only accepted work can cross the external-action boundary. Running work is never requeued. */
39: export async function claimAgentJob(db:Database,runnerId:string) {
40:   if(!runnerId || runnerId.length>160)throw new Error('agent runner identity is required');
41:   return inTransaction(db,async connection=>{
42:     await connection.query("SELECT pg_advisory_xact_lock(hashtextextended('prism-agent-admission',0))");
43:     await connection.query("UPDATE prism.agent_job SET state='needs_nova',outcome=jsonb_build_object('reason','external agent outcome unresolved after claim expiry'),updated_at=clock_timestamp() WHERE state='running' AND expires_at<=clock_timestamp()");
44:     await connection.query("UPDATE prism.agent_job j SET state='superseded',outcome=jsonb_build_object('reason','source changed before external action started'),updated_at=clock_timestamp() WHERE j.state='accepted' AND ((j.operation='design-set' AND NOT EXISTS (SELECT 1 FROM prism.design_round round JOIN prism.design_request request ON request.id=round.design_request_id WHERE round.id=j.id AND request.status='active' AND request.current_round_id=round.id)) OR (j.operation='revise' AND NOT EXISTS (SELECT 1 FROM prism.design_document document JOIN prism.design_revision revision ON revision.id=document.current_revision_id WHERE document.id::text=j.request->>'documentId' AND revision.revision::text=j.request->>'expectedRevision'))) ");
45:     const rows=await connection.query<AgentJob>("SELECT j.* FROM prism.agent_job j WHERE j.state='accepted' AND NOT EXISTS (SELECT 1 FROM prism.agent_job active WHERE active.session_key=j.session_key AND active.state IN ('running','needs_nova')) ORDER BY j.created_at,j.id LIMIT 1 FOR UPDATE OF j");
46:     if(!rows.rows[0])return null;
47:     const source=rows.rows[0];const fence=randomUUID();
48:     const deadline=await connection.query<{expires_at:Date|string}>("SELECT clock_timestamp()+interval '16 minutes' AS expires_at");
49:     const expiresAt=deadline.rows[0]!.expires_at;
50:     const envelope=await agentAttempt({...source,fence,expires_at:expiresAt},runnerId);
51:     const claimed=await connection.query<AgentJob>("UPDATE prism.agent_job SET state='running',fence=$2,runner_id=$3,expires_at=$4,attempt_envelope=$5::jsonb,updated_at=clock_timestamp() WHERE id=$1 AND state='accepted' RETURNING *",[source.id,fence,runnerId,expiresAt,JSON.stringify(envelope)]);
52:     return claimed.rows[0]!;
53:   });
54: }
55: 
56: export async function finishAgentRun(db:Database,id:string,fence:string,outcome:Record<string,unknown>) {
57:   return inTransaction(db,async connection=>{
58:     const rows=await connection.query<AgentJob>('SELECT * FROM prism.agent_job WHERE id=$1 FOR UPDATE',[id]);
59:     const job=rows.rows[0];
60:     if(!job || job.fence!==fence)throw new Error('agent job fence conflict');
61:     validateAgentOutcome(job,outcome);
62:     if(job.state==='completed' || job.state==='needs_nova')return job;
63:     const completed=outcome.schemaVersion==='worker-attempt-result.v2' && outcome.state==='completed' && job.result!==null;
64:     await connection.query("UPDATE prism.agent_job SET state=$2,outcome=$3::jsonb,updated_at=clock_timestamp() WHERE id=$1",[id,completed?'completed':'needs_nova',JSON.stringify(outcome)]);
65:     return agentJob(connection,id);
66:   });
67: }
68: 
69: /** Peer authentication never replaces binding the received receipt to Control's accepted policy. */
70: function validateAgentOutcome(job:AgentJob,outcome:Record<string,unknown>) {
71:   if(!job.attempt_envelope)throw new Error('agent accepted attempt envelope is missing');
72:   const accepted=job.attempt_envelope;
73:   if(accepted.attemptId!==job.fence || accepted.claim.claimId!==job.fence || accepted.executionId!==job.id)throw new Error('agent persisted attempt identity conflict');
74:   if(outcome.schemaVersion==='worker-attempt-result.v2'){
75:     const checked=checkWorkerResourceResultBinding(accepted,outcome as unknown as WorkerAttemptResultV2);
76:     if(!checked.ok)throw new Error(`agent outcome binding failed: ${checked.errors.join('; ')}`);
77:     return;
78:   }
79:   if(outcome.state==='errored' && typeof outcome.error==='string' && outcome.error.length>0
80:     && Object.keys(outcome).every(key=>key==='state' || key==='error'))return;
81:   throw new Error('agent outcome requires a bound V2 receipt; startup diagnostics may only report errored');
82: }
83: 
84: /** Hold this row lock through the actual document transaction, including its durable result receipt. */
85: export async function lockAgentResult(db:Queryable,identity:AgentCompletion,generationId:string) {
86:   if(identity.jobId!==generationId || !identity.fence)throw new Error('agent result job identity is required');
87:   const rows=await db.query<AgentJob & {live:boolean}>('SELECT *,expires_at>clock_timestamp() AS live FROM prism.agent_job WHERE id=$1 FOR UPDATE',[identity.jobId]);
88:   const job=rows.rows[0];
89:   if(!job || job.fence!==identity.fence)throw new Error('agent result fence conflict');
90:   if(job.result_digest){
91:     if(job.result_digest!==sha256Digest(identity.payload))throw new Error('agent result conflicts with committed payload');
92:     return job.result;
93:   }
94:   if(job.state!=='running'||!job.live)throw new Error('agent action is unresolved; NeedsNova reconciliation is required');
95:   return null;
96: }
97: 
98: export async function recordAgentResult(db:Queryable,identity:AgentCompletion,result:unknown) {
99:   await db.query('UPDATE prism.agent_job SET result_digest=$2,result=$3::jsonb,updated_at=clock_timestamp() WHERE id=$1',[identity.jobId,sha256Digest(identity.payload),JSON.stringify(result)]);
100: }

SOURCE skills/prism/control/native-operation-store.ts SHA256 da764d081570b56a5579652033f4cbc0e2623ced3d1b62e0dc8945978f1e77a9
1: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
2: import { canonicalJson } from '@kubeclaw/worker-core';
3: import { inTransaction, type Database, type Queryable } from '../storage/index.ts';
4: import { prismRequestDigest } from '../engine/worker-envelope.ts';
5: import { acceptedCachedResult, boundWorkerResult, type PrismWorkerResult, type StoredWorkerResult } from './worker-results.ts';
6: 
7: type Row = Record<string, unknown> & { request_digest: string | null; attempt_id: string;
8:   operation: string; attempt: WorkerAttemptEnvelopeV3 | null; result: StoredWorkerResult | null };
9: 
10: function requestIdentity(attempt: WorkerAttemptEnvelopeV3): string {
11:   validateWorkerResourceContractV3('workerAttemptEnvelope', attempt);
12:   const input = attempt.inputs.find(item => item.name === attempt.operation.values.inputName);
13:   if (!input || input.kind !== 'artifact') throw new Error('PRISM_NATIVE_OPERATION_INPUT_REQUIRED');
14:   return prismRequestDigest(attempt.operation, input.artifact.contentDigest);
15: }
16: 
17: async function lock(connection: Queryable, key: string): Promise<void> {
18:   await connection.query('SELECT pg_advisory_xact_lock(hashtextextended($1,0))', [key]);
19: }
20: 
21: async function read(connection: Queryable, key: string): Promise<Row | undefined> {
22:   return (await connection.query<Row>('SELECT request_digest,attempt_id,operation,attempt,result FROM prism.engine_operation WHERE idempotency_key=$1', [key])).rows[0];
23: }
24: 
25: /** A committed original envelope survives Control death before, during or after dispatch. */
26: export async function reserveNativePrismOperation(database: Database, key: string,
27:   proposed: WorkerAttemptEnvelopeV3): Promise<{ attempt: WorkerAttemptEnvelopeV3; result: StoredWorkerResult | null }> {
28:   const attempt = structuredClone(proposed); const requestDigest = requestIdentity(attempt);
29:   return inTransaction(database, async connection => {
30:     await lock(connection, key);
31:     const previous = await read(connection, key);
32:     if (previous) {
33:       if (previous.request_digest !== requestDigest) throw new Error('PRISM_OPERATION_IDEMPOTENCY_CONFLICT');
34:       if (previous.result && !previous.attempt) return { attempt, result: acceptedCachedResult(previous.result, requestDigest, previous.attempt_id) };
35:       if (!previous.attempt) throw new Error('PRISM_NATIVE_LEGACY_PENDING_RECONCILIATION_REQUIRED');
36:       if (requestIdentity(previous.attempt) !== requestDigest || previous.attempt.executionId !== previous.attempt_id
37:         || previous.operation !== String(previous.attempt.operation.values.operation)) throw new Error('PRISM_NATIVE_OPERATION_BINDING_INVALID');
38:       if (previous.result && canonicalJson(previous.result.attempt) !== canonicalJson(previous.attempt)) throw new Error('PRISM_NATIVE_OPERATION_BINDING_INVALID');
39:       return { attempt: previous.attempt, result: previous.result ? acceptedCachedResult(previous.result, requestDigest, previous.attempt_id) : null };
40:     }
41:     await connection.query('INSERT INTO prism.engine_operation(idempotency_key,attempt_id,operation,request_digest,attempt) VALUES($1,$2,$3,$4,$5::jsonb)',
42:       [key, attempt.executionId, String(attempt.operation.values.operation), requestDigest, JSON.stringify(attempt)]);
43:     return { attempt, result: null };
44:   });
45: }
46: 
47: /** Preserve a bound terminal receipt before hydration; failed hydration cannot cause another execution. */
48: export async function recordNativePrismResult(database: Database, key: string,
49:   attempt: WorkerAttemptEnvelopeV3, raw: unknown): Promise<PrismWorkerResult> {
50:   const captured = structuredClone(attempt); const result = boundWorkerResult(captured, raw);
51:   const stored = structuredClone({ attempt: captured, workerResult: result });
52:   return inTransaction(database, async connection => {
53:     await lock(connection, key);
54:     const current = await read(connection, key);
55:     if (!current?.attempt || canonicalJson(current.attempt) !== canonicalJson(captured)) throw new Error('PRISM_NATIVE_OPERATION_BINDING_INVALID');
56:     if (current.result) {
57:       if (canonicalJson(current.result) !== canonicalJson(stored)) throw new Error('PRISM_NATIVE_OPERATION_RESULT_CONFLICT');
58:       return current.result.workerResult;
59:     }
60:     await connection.query('UPDATE prism.engine_operation SET result=$2::jsonb WHERE idempotency_key=$1', [key, JSON.stringify(stored)]);
61:     return stored.workerResult;
62:   });
63: }
64: 
65: export async function completeNativePrismOperation(database: Database, key: string, executionId: string): Promise<void> {
66:   const changed = await database.query("UPDATE prism.engine_operation SET completed_at=COALESCE(completed_at,now()) WHERE idempotency_key=$1 AND attempt_id=$2 AND result->'workerResult'->>'state'='completed' RETURNING idempotency_key", [key, executionId]);
67:   if (changed.rows.length !== 1) throw new Error('PRISM_NATIVE_OPERATION_COMPLETION_CONFLICT');
68: }

SOURCE skills/prism/control/native-operation.ts SHA256 1c394e56baaddf1a338f4194e26391333a490f53278e12aeda70a1924a4486ac
1: import { requestWorkerResult } from './worker-operation-transport.ts';
2: import type { ContentAddressedArtifactStore, Database } from '../storage/index.ts';
3: import { prismNativeAttempt } from '../engine/worker-envelope.ts';
4: import type { EngineOperation } from '../engine/index.ts';
5: import type { loadControlServerConfig } from '../server/control-config.ts';
6: import { WorkerArtifactClient } from '../server/worker-artifacts.ts';
7: import { hydrateWorkerResult } from './worker-evidence.ts';
