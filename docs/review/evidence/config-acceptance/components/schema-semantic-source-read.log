676:     const result: WorkerAttemptResult = {
677:       ...unsigned,
678:       resultDigest,
679:       receipt: receipt(namespace, this.#id(), resultDigest),
680:     };
681:     try {
682:       if(result.schemaVersion==='worker-attempt-result.v3')validateWorkerResourceContractV3('workerAttemptResult',result);
683:       else if(result.schemaVersion==='worker-attempt-result.v2')validateWorkerResourceContractV2('workerAttemptResult',result);
684:       else validatePipelineWorkerCoreContract('workerAttemptResult', result);
685:       const frozenResult = freeze(result);
686:       if (!fault && this.#now().getTime() >= Date.parse(envelope.claim.expiresAt)) {
687:         return this.#result(started, this.#now(), new AttemptFault('interrupted', 'WORKER_CLAIM_EXPIRED'), null, evidence, resources, cleanup);
688:       }
689:       return frozenResult;
690:     } catch (error) {
691:       if (fault?.code === 'WORKER_OPERATION_RESULT_INVALID') throw error;
692:       return this.#result(started, completed,
693:         new AttemptFault('errored', 'WORKER_OPERATION_RESULT_INVALID', 'Specialist operation returned an invalid result.'),
694:         null, [], {
695:           ...resources,
696:           logBytes: resources.logBytes,
697:           resultBytes: 0,
698:           evidenceBytes: 0,
699:         }, cleanup.state === 'failed'
700:           ? { state: 'failed', summary: boundedText(cleanup.summary, 'Cleanup failed.') }
701:           : cleanup);
702:     }
703:   }
704: }

