219: 
220:   constructor(options: WorkerAttemptExecutorOptions<E>) {
221:     preflightJson(options.envelope, MAX_ATTEMPT_ENVELOPE_BYTES, 'WORKER_ATTEMPT_INPUT');
222:     const envelope = freeze(structuredClone(options.envelope));
223:     validateEnvelopeDigests(envelope);
224:     if (envelope.limits.logBytes > MAX_ATTEMPT_LOG_BYTES) throw new Error('WORKER_LOG_LIMIT_INVALID');
225:     if (options.receiptNamespace !== undefined
226:       && (options.receiptNamespace.length === 0 || options.receiptNamespace.length > 4096
227:         || options.receiptNamespace !== options.receiptNamespace.toWellFormed())) {
228:       throw new Error('WORKER_RECEIPT_NAMESPACE_INVALID');
229:     }
230:     this.#options = { ...options, envelope };
231:     this.#accounting=envelope.schemaVersion==='worker-attempt-envelope.v3'?initialWorkerNativeResourceAccounting(envelope)
232:       :envelope.schemaVersion==='worker-attempt-envelope.v2'?initialWorkerResourceAccounting(envelope):undefined;
