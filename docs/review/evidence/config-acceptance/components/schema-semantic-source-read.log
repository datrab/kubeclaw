295:       void terminate();
296:     };
297:     this.#options.signal?.addEventListener('abort', abort, { once: true });
298:     if (this.#options.signal?.aborted) abort();
299:     const log: WorkerAttemptContext['log'] = (stream, value) => {
300:       if (logClosed || logFault) return;
301:       let text: string;
302:       try { text = decoder.decode(stream, value); }
303:       catch (error) { logFault = new AttemptFault('errored', detail(error)); controller.abort(logFault); void terminate(); return; }
304:       if (!text && typeof value !== 'string') return;
305:       let offset = 0;
306:       do {
307:         if (logPartCount >= MAX_ATTEMPT_LOG_PARTS) {
308:           logFault = new AttemptFault('errored', 'WORKER_LOG_LIMIT');
309:           controller.abort(logFault);
310:           void terminate();
311:           return;
312:         }
