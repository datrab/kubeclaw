1: import { randomBytes } from 'node:crypto';
2: import { nativeSourceCleanupOperation, workerAttemptSpecDigest, workerProfileDigest } from '@kubeclaw/worker-core';
3: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3,
4:   type WorkerAttemptResultV3, type WorkerProfileV3 } from '@kubeclaw/pipeline-worker-core-contract';
5: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
6: import { preparationEnvelope, preparationProfile } from './preparation-envelope.ts';
7: import { preparationDigest } from './preparation-header.ts';
8: import { assertPreparationCleanupEffects, type PreparationCleanupEffects } from './preparation-cleanup-binding.ts';
9: 
10: export function preparationCleanupProfile(engineContentDigest: string): WorkerProfileV3 {
11:   const base = preparationProfile(engineContentDigest);
12:   const profile = { ...base, profileId: 'buster-native-source-cleanup-v1',
13:     engine: { ...base.engine, engineId: 'buster-native-source-cleanup', contractId: 'kubeclaw.native-source-cleanup@1' } };
14:   return { ...profile, profileDigest: workerProfileDigest(profile) };
15: }
16: 
17: /** A fresh attempt has fresh claim identity, while the original effect and receipt stay exact. */
18: export function preparationCleanupEnvelope(original: WorkerAttemptEnvelopeV3, result: WorkerAttemptResultV3,
19:   effects: PreparationCleanupEffects, settings: BusterPreparationSettings, engineContentDigest: string): WorkerAttemptEnvelopeV3 {
20:   assertPreparationCleanupEffects(effects);
21:   const base = preparationEnvelope(randomBytes(16).toString('hex'), preparationCleanupProfile(engineContentDigest),
22:     settings, new Date(), effects.gate.preparationUid, { kind: 'stage' });
23:   const unsigned = { ...base, nodeId: 'cleanup-source',
24:     operation: nativeSourceCleanupOperation(original, result, preparationDigest(effects)) };
25:   const envelope = { ...unsigned, attemptSpecDigest: workerAttemptSpecDigest(unsigned) };
26:   validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
27:   return envelope;
28: }

