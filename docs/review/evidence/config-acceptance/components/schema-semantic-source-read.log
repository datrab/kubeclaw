187: function validateEnvelopeDigests(envelope: WorkerAttemptEnvelope): void {
188:   if(envelope.schemaVersion==='worker-attempt-envelope.v3')validateWorkerResourceContractV3('workerAttemptEnvelope',envelope);
189:   else if(envelope.schemaVersion==='worker-attempt-envelope.v2')validateWorkerResourceContractV2('workerAttemptEnvelope',envelope);
190:   else validatePipelineWorkerCoreContract('workerAttemptEnvelope', envelope);
191: }
