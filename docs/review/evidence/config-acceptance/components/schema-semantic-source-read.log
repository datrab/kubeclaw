1: import type { ProviderInvocationV1, ResolvedPlanNodeV1 } from '@kubeclaw/pipeline-test-gate-contract';
2: import type { WorkerAttemptEnvelopeV1 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { sha256Digest, workerAttemptSpecDigest, type WorkerAttemptOperation } from '@kubeclaw/worker-core';
4: import { createBusterWorkerProfile } from './runner-worker-profile.ts';
5: import type { TestPlanRunnerOptions } from './runner-types.ts';
6: interface EnvelopeInput {
7:  readonly options: TestPlanRunnerOptions;
8:  readonly node: ResolvedPlanNodeV1;
9:  readonly attemptId: string;
10:  readonly attemptNumber: number;
11:  readonly granted: readonly string[];
12:  readonly cleanupTimeoutMs: number;
13:  readonly providerResultLimit: number;
14:  readonly invocation: ProviderInvocationV1;
15:  readonly operation: WorkerAttemptOperation;
16:  readonly issuedAt: Date;
17: }
18: function envelopeLimits(node: ResolvedPlanNodeV1, cleanupTimeoutMs: number, providerResultLimit: number, reportResultLimit: number, workerResultWrapperBytes: number) {
19:  return {
20:         timeoutMs: node.timeoutMs,
21:         cleanupTimeoutMs,
22:         cpuMillis: node.limits.cpuMillis,
23:         memoryBytes: node.limits.memoryBytes,
24:         processes: node.limits.processes,
25:         logBytes: node.limits.logBytes,
26:         resultBytes: providerResultLimit + reportResultLimit + workerResultWrapperBytes,
27:         evidenceBytes: node.limits.artifactBytes,
28:         evidenceFiles: node.limits.artifactFiles,
29:       };
30: }
31: function envelopeOperation(invocation: ProviderInvocationV1) {
32:  return {
33:         contractId: "kubeclaw.buster-provider-attempt@1",
34:         inputSchemaId: "kubeclaw.buster-provider-attempt.v1",
35:         inputSchemaDigest: sha256Digest({
36:           schemaId: "kubeclaw.buster-provider-attempt.v1",
37:         }),
38:         values: { invocation: structuredClone(invocation) } as never,
39:       };
40: }
41: export function createRunnerEnvelope(input: EnvelopeInput): WorkerAttemptEnvelopeV1 {
42:  const { options, node, attemptId, attemptNumber, granted, cleanupTimeoutMs, providerResultLimit,
43:    invocation, operation, issuedAt } = input;
44:     const profile = createBusterWorkerProfile(options.registry, granted);
45:     const completionPhases = 3 + Number(Boolean(operation.cleanup)) + Number(Boolean(operation.collectEvidence)) + Number(Boolean(operation.finalizeResult));
46:     const claimWindowMs = node.timeoutMs + completionPhases * cleanupTimeoutMs + options.executionPolicy.provider.claimGraceMs;
47:     const envelopeBase = {
48:       schemaVersion: "worker-attempt-envelope.v1" as const,
49:       protocolVersion: "worker-protocol.v1" as const,
50:       pipelineRunId: options.plan.runId,
51:       moduleId: options.plan.scope.moduleId,
52:       gateId: options.plan.scope.gateId,
53:       planId: options.plan.planId,
54:       nodeId: node.id,
55:       executionId: node.executionId,
56:       attemptId,
57:       attemptNumber,
58:       claim: {
59:         schemaVersion: "attempt-claim.v1" as const,
60:         claimId: `claim:${attemptId}`,
61:         attemptId,
62:         generation: 1,
63:         workerId: "worker:buster:local",
64:         claimedAt: issuedAt.toISOString(),
65:         expiresAt: new Date(issuedAt.getTime() + claimWindowMs).toISOString(),
66:       },
67:       profile,
68:       packages: [
69:         {
70:           packageId: node.provider.packageId,
71:           packageVersion: node.provider.packageVersion,
72:           contentDigest: node.provider.contentDigest,
73:         },
74:       ],
75:       grantedCapabilities: [...granted],
76:       limits: envelopeLimits(node, cleanupTimeoutMs, providerResultLimit, options.executionPolicy.reports.maximumAggregateResultBytes, options.executionPolicy.provider.workerResultWrapperBytes),
77:       inputs: [],
78:       operation: envelopeOperation(invocation),
79:       cancellationId: `cancel:${attemptId}`,
80:       issuedAt: issuedAt.toISOString(),
81:       queueDeadline: new Date(issuedAt.getTime() + options.executionPolicy.provider.queueTimeoutMs).toISOString(),
82:     };
83:     const workerEnvelope: WorkerAttemptEnvelopeV1 = {
84:       ...envelopeBase,
85:       attemptSpecDigest: workerAttemptSpecDigest({
86:         ...envelopeBase,
87:         attemptSpecDigest: "",
88:       }),
89:     };
90:  return workerEnvelope;
91: }

SOURCE skills/buster/engine/test-gates/runner-attempt-execution.ts SHA256 9012607f67aeb7abe5aa29ae6687ea1e43b091b3bea3c1b57b0ed9d01fa6c705
1: import fs from 'node:fs';
2: import { WorkerAttemptExecutor, type WorkerAttemptOperation } from '@kubeclaw/worker-core';
3: import type { WorkerAttemptEnvelopeV1, WorkerAttemptResultV1 } from '@kubeclaw/pipeline-worker-core-contract';
4: import type { TestPlanRunnerOptions, WorkerAttemptRuntime } from './runner-types.ts';
5: import { canonical } from './canonical-value.ts';
6: import { detail } from './runner-values.ts';
7: import { persistRunnerCompletion, type CompletionOwner } from './runner-completion.ts';
8: interface ExecutionOwner {
9:  readonly options: TestPlanRunnerOptions;
10:  readonly workerRuntime: WorkerAttemptRuntime;
11:  readonly now: () => Date;
12:  readonly id: () => string;
13:  readonly authorityId: string;
14:  readonly completion: CompletionOwner;
15: }
16: export async function executeRunnerAttempt(owner: ExecutionOwner, workerEnvelope: WorkerAttemptEnvelopeV1,
17:   operation: WorkerAttemptOperation, stagingBase: string) {
18:     let workerResult: WorkerAttemptResultV1 | null = null;
19:     let completedWorkerResult: WorkerAttemptResultV1 | null = null;
20:     let workerRuntimeFault: string | null = null;
21:     try {
22:       workerResult = await owner.workerRuntime.runAttempt(
23:         workerEnvelope,
24:         async (workerSignal) => {
25:           const signals = [
26:             workerSignal,
27:             ...(owner.options.signal ? [owner.options.signal] : []),
28:           ];
29:           const signal =
30:             signals.length === 1 ? workerSignal : AbortSignal.any(signals);
31:           completedWorkerResult = await new WorkerAttemptExecutor({
32:             envelope: workerEnvelope,
33:             operation,
34:             signal,
35:             retainLogs: false,
36:             now: owner.now,
37:             id: owner.id,
38:             receiptNamespace: owner.authorityId,
39:           }).execute();
40:           return completedWorkerResult;
41:         },
42:       );
43:       if (
44:         !workerResult ||
45:         !completedWorkerResult ||
46:         canonical(workerResult) !== canonical(completedWorkerResult)
47:       )
48:         throw new Error("WORKER_RUNTIME_RESULT_MISMATCH");
49:       // The authoritative completion intent remains durable even if admission is pending.
50:       workerResult = await persistRunnerCompletion(owner.completion, workerEnvelope, workerResult);
51:       completedWorkerResult = workerResult;
52:     } catch (error) {
53:       workerRuntimeFault = detail(error);
54:       workerResult = completedWorkerResult;
55:     } finally {
56:       await fs.promises.rm(stagingBase, { recursive: true, force: true });
57:     }
58:     return { workerResult, workerRuntimeFault };
59: }

SOURCE skills/buster/engine/test-gates/runner-worker-profile.ts SHA256 4e7cc1f1206047bf768b1826d979fc5384fe1edc7e3e4fa9bb71e24e5d31a648
1: import crypto from 'node:crypto';
2: import type { ResolvedPlanNodeV1, ResolvedTestPlanV1 } from '@kubeclaw/pipeline-test-gate-contract';
3: import type { RegistrySnapshot, TestProviderRegistryEntry } from '@kubeclaw/plugin-foundation/registry/types';
4: import type { WorkerProfileV1 } from '@kubeclaw/pipeline-worker-core-contract';
5: import { workerProfileDigest } from '@kubeclaw/worker-core';
6: import { compareText } from './runner-values.ts';
7: export function providerEntry(
8:   registry: RegistrySnapshot,
9:   node: ResolvedPlanNodeV1,
10: ): TestProviderRegistryEntry {
11:   const entry = registry.testProviderContracts.get(node.provider.contractId);
12:   if (!entry)
13:     throw new Error(`TEST_PROVIDER_MISSING:${node.provider.contractId}`);
14:   return entry;
15: }
16: 
17: function registrationGrants(grants: ReadonlyMap<string, readonly string[]> | undefined,
18:   registrationId: string): readonly string[] {
19:   const selected = grants?.get(registrationId);
20:   return selected === undefined || selected === null ? [] : selected;
21: }
22: 
23: export function grantedCapabilities(
24:   options: {
25:     readonly registry: RegistrySnapshot;
26:     readonly grants: ReadonlyMap<string, readonly string[]> | undefined;
27:   },
28:   node: ResolvedPlanNodeV1,
29: ): string[] {
30:   const entry = providerEntry(options.registry, node);
31:   const registrationId = `${entry.registration.package.packageId}:${entry.registration.registrationId}`;
32:   const nodeGrants = options.grants?.get(node.id);
33:   const configured = new Set(nodeGrants !== undefined && nodeGrants !== null
34:     ? nodeGrants
35:     : registrationGrants(options.grants, registrationId));
36:   return entry.registration.capabilities
37:     .filter((capability) => configured.has(capability))
38:     .sort();
39: }
40: 
41: export function createBusterWorkerProfile(
42:   registry: RegistrySnapshot,
43:   granted: readonly string[],
44: ): WorkerProfileV1 {
45:   const capabilities = [...new Set(["provider.execute", ...granted])].sort();
46:   const capabilityKey = crypto.createHash('sha256').update(capabilities.join('\0')).digest('hex').slice(0, 16);
47:   const base = {
48:     schemaVersion: "worker-profile.v1" as const,
49:     profileId: `buster.local.${capabilityKey}`,
50:     workerType: "buster",
51:     coreContractId: "kubeclaw.worker-core@1",
52:     engine: {
53:       engineId: "buster-test-engine",
54:       contractId: "kubeclaw.buster-engine@1",
55:       engineVersion: "1.0.0",
56:       contentDigest: registry.snapshotDigest,
57:     },
58:     capabilities,
59:   };
60:   return { ...base, profileDigest: workerProfileDigest(base) };
61: }
62: 
63: export function createBusterWorkerProfiles(
64:   plan: ResolvedTestPlanV1,
65:   registry: RegistrySnapshot,
66:   grants?: ReadonlyMap<string, readonly string[]>,
67: ): WorkerProfileV1[] {
68:   const profiles = new Map<string, WorkerProfileV1>();
69:   for (const node of plan.nodes) {
70:     const granted = grantedCapabilities({ registry, grants }, node);
71:     const profile = createBusterWorkerProfile(registry, granted);
72:     profiles.set(profile.profileDigest, profile);
73:   }
74:   return [...profiles.values()].sort((left, right) =>
75:     compareText(left.profileDigest, right.profileDigest),
76:   );
77: }
78: 

