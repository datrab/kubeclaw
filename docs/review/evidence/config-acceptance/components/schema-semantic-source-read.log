193: function receipt(namespace: string, nonce: string, resultDigest: string) {
194:   const receiptId = `receipt:${crypto.createHash('sha256').update(`${namespace}:${nonce}:${resultDigest}`).digest('hex')}`;
195:   return { receiptId, receiptDigest: sha256Digest({ namespace, receiptId, resultDigest }) };
196: }
