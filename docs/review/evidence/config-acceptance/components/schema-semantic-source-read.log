590:   #progress(state: AttemptProgressEventV1['state'], message: string): void {
591:     if (!this.#options.onProgress) return;
592:     const { envelope } = this.#options;
593:     const event = freeze({
594:       schemaVersion: 'attempt-progress-event.v1' as const,
595:       protocolVersion: envelope.protocolVersion,
596:       attemptId: envelope.attemptId,
597:       claimId: envelope.claim.claimId,
598:       claimGeneration: envelope.claim.generation,
599:       workerId: envelope.claim.workerId,
600:       sequence: this.#progressSequence++,
601:       state,
602:       message,
603:       progressPercent: null,
604:       details: {} as Record<string, JsonValue>,
605:       sentAt: this.#now().toISOString(),
606:     });
