18: /** Root-owned metadata. Failed or uncertain lifetimes keep their full reservation. */
19: export class PreparationSourceLedger {
20:   readonly #file: string;
21:   readonly #settings: BusterPreparationSettings;
22: 
23:   constructor(root: string, settings: BusterPreparationSettings) {
24:     this.#file = path.join(root, 'source-ledger', 'state.json');
25:     this.#settings = structuredClone(settings);
26:   }
27: 
28:   async reserve(admissionId: string, profile: WorkerProfileV3, now: Date): Promise<WorkerAttemptEnvelopeV3> {
29:     profile = structuredClone(profile);
30:     now = new Date(now);
31:     if (!/^[a-f0-9]{32}$/u.test(admissionId)) throw new Error('BUSTER_PREPARATION_RESERVATION_INVALID');
32:     return withDurableStoreLock(this.#file, async () => {
33:       const state = await this.#read();
34:       const existing = state.reservations.find(item => item.admissionId === admissionId);
35:       if (existing) return structuredClone(existing.envelope);
36:       const occupied = new Set(state.reservations.filter(item => !item.slotReleased).map(item => item.slot));
37:       const slot = preparationSlots.slice(0, this.#settings.maximumActivePreparations).find(candidate => !occupied.has(candidate));
38:       if (slot === undefined) throw new Error('BUSTER_PREPARATION_SLOT_CAPACITY');
39:       const envelope = preparationEnvelope(admissionId, profile, this.#settings, now, slot, { kind: 'stage' });
40:       const reservation = initialSourceReservation(admissionId, envelope, slot, gateReservation(this.#settings));
41:       await this.#write({ ...state, reservations: [...state.reservations, reservation] });
42:       return structuredClone(envelope);
43:     });
44:   }
45: 
46:   async reserveHistorical(importId: string, profile: WorkerProfileV3, now: Date,
47:     descriptor: HistoricalImportDescriptor): Promise<WorkerAttemptEnvelopeV3> {
48:     descriptor = structuredClone(descriptor);
49:     profile = structuredClone(profile);
50:     now = new Date(now);
51:     assertHistoricalImportDescriptor(descriptor);
52:     return withDurableStoreLock(this.#file, async () => {
53:       const state = await this.#read();
54:       const existing = state.reservations.find(item => item.admissionId === importId);
55:       if (existing) {
56:         if (preparationDigest(existing.historicalDescriptor) !== preparationDigest(descriptor)) {
57:           throw new Error('BUSTER_PREPARATION_RESERVATION_CONFLICT');
58:         }
59:         return structuredClone(existing.envelope);
60:       }
61:       const occupied = new Set(state.reservations.filter(item => !item.slotReleased).map(item => item.slot));
62:       const slot = preparationSlots.slice(0, this.#settings.maximumActivePreparations).find(value => !occupied.has(value));
63:       if (slot === undefined) throw new Error('BUSTER_PREPARATION_SLOT_CAPACITY');
64:       const envelope = preparationEnvelope(importId, profile, this.#settings, now, slot,
65:         { kind: 'historical', descriptor: structuredClone(descriptor) });
66:       const reservation: SourceReservation = {
67:         ...initialSourceReservation(importId, envelope, slot, gateReservation(this.#settings)),
68:         phase: 'historical-reserved',
69:         historicalDescriptor: structuredClone(descriptor),
70:       };
71:       await this.#write({ ...state, reservations: [...state.reservations, reservation] });
72:       return structuredClone(envelope);
73:     });
74:   }
75: 
76:   async reserveHistoricalStorage(importId: string, required: {
77:     bytes: number; entries: number; metadataBytes: number; records: number;
78:   }): Promise<void> {
79:     required = structuredClone(required);
80:     if (!Object.values(required).every(value => Number.isSafeInteger(value) && value >= 0)) {
81:       throw new Error('BUSTER_PREPARATION_RESERVATION_INVALID');
82:     }
83:     await this.#transition(importId, current => {
84:       if (current.phase !== 'historical-reserved' || current.slotReleased
85:         || required.bytes < current.bytes || required.entries < current.entries
86:         || required.metadataBytes < current.groupMetadataBytes || required.records < current.groupRecords) {
87:         throw new Error('BUSTER_PREPARATION_RESERVATION_CONFLICT');
88:       }
89:       return { ...current, bytes: required.bytes, entries: required.entries,
90:         groupMetadataBytes: required.metadataBytes, groupRecords: required.records };
91:     });
92:   }
93: 
94:   async retainedHistorical(importId: string, groupReceiptDigest: string): Promise<void> {
95:     if (!/^sha256:[a-f0-9]{64}$/u.test(groupReceiptDigest)) throw new Error('BUSTER_PREPARATION_GROUP_RECEIPT_INVALID');
96:     await this.#transition(importId, current => {
97:       if (!['historical-reserved', 'retained-historical'].includes(current.phase) || !current.gate
98:         || (current.groupReceiptDigest !== null && current.groupReceiptDigest !== groupReceiptDigest)) {
99:         throw new Error('BUSTER_PREPARATION_GROUP_RECEIPT_INVALID');
100:       }
101:       return { ...current, phase: 'retained-historical', slotReleased: true, groupReceiptDigest };
102:     });
103:   }
104: 
105:   /** Reserve the exact durable wire before the host is allowed to write it. */
106:   async stageInput(staged: StagedAdmission): Promise<void> {
107:     staged = structuredClone(staged);
108:     assertStagedInput(staged.input, staged.job);
109:     await this.#transition(staged.input.admissionId, current => {
110:       if (current.phase !== 'staging' || current.attemptSpecDigest !== staged.input.attemptSpecDigest
111:         || current.slot !== staged.input.preparationUid || !current.gate
112:         || (current.input && preparationDigest(current.input) !== preparationDigest(staged))) {
113:         throw new Error('BUSTER_PREPARATION_INPUT_BINDING_INVALID');
114:       }
115:       return { ...current, input: structuredClone(staged), ...stagedInputReservation(staged, this.#settings) };
116:     });
117:   }
118: 
119:   /** Caller has verified the successful native result and revoked the now-quiescent gate. */
120:   async retainInput(staged: StagedAdmission): Promise<void> {
121:     staged = structuredClone(staged);
122:     await this.#transition(staged.input.admissionId, current => {
123:       if (!['staging', 'retained-input'].includes(current.phase) || !current.gate
124:         || preparationDigest(current.input) !== preparationDigest(staged)) {
125:         throw new Error('BUSTER_PREPARATION_INPUT_BINDING_INVALID');
126:       }
127:       return { ...current, phase: 'retained-input', slotReleased: true };
128:     });
129:   }
130: 
131:   /** Replay the current extraction; only a positively released generation permits its successor. */
132:   async reserveExtraction(admissionId: string, staged: BusterStagedAdmission,
133:     profile: WorkerProfileV3, now: Date): Promise<WorkerAttemptEnvelopeV3> {
134:     staged = structuredClone(staged);
135:     profile = structuredClone(profile);
136:     now = new Date(now);
137:     assertBusterInput(staged.input, staged.job);
138:     return withDurableStoreLock(this.#file, async () => {
139:       const state = await this.#read();
140:       const key = preparationDigest(staged.input);
141:       await this.#validateRetainedInput(state, staged);
142:       const generations = state.reservations.filter(item => item.parentInputId === key);
143:       const existing = generations.sort((a, b) => b.extractionGeneration - a.extractionGeneration)[0];
144:       if (existing && existing.phase !== 'released') return structuredClone(existing.envelope);
145:       if (state.reservations.some(item => item.admissionId === admissionId)) {
146:         throw new Error('BUSTER_PREPARATION_RESERVATION_CONFLICT');
147:       }
148:       const occupied = new Set(state.reservations.filter(item => !item.slotReleased).map(item => item.slot));
149:       const slot = preparationSlots.slice(0, this.#settings.maximumActivePreparations).find(value => !occupied.has(value));
150:       if (slot === undefined) throw new Error('BUSTER_PREPARATION_SLOT_CAPACITY');
151:       const envelope = preparationEnvelope(admissionId, profile, this.#settings, now, slot,
152:         { kind: 'extract', input: structuredClone(staged.input) });
153:       const reservation: SourceReservation = {
154:         ...initialSourceReservation(admissionId, envelope, slot, extractedSourceReservation(staged, this.#settings)),
155:         phase: 'reserved',
156:         parentInputId: key,
157:         extractionGeneration: (existing?.extractionGeneration ?? 0) + 1,
158:         previousExtractionDigest: existing ? preparationDigest(existing.envelope) : null,
159:       };
160:       await this.#write({ ...state, reservations: [...state.reservations, reservation] });
161:       return structuredClone(envelope);
162:     });
163:   }
164: 
165:   async #validateRetainedInput(state: SourceLedger, staged: BusterStagedAdmission): Promise<void> {
166:     const inputReference = staged.input;
167:     if (inputReference.schemaVersion === 'buster-historical-input.v1') {
168:       const group = state.reservations.find(item => item.admissionId === inputReference.importId);
169:       if (group?.phase !== 'retained-historical' || !group.slotReleased || !group.groupReceiptDigest) {
170:         throw new Error('BUSTER_PREPARATION_RETAINED_INPUT_REQUIRED');
171:       }
172:       await resolveHistoricalInput(path.dirname(path.dirname(this.#file)),
173:         staged as HistoricalStagedAdmission, this.#settings.maximumMetadataBytes, group.groupReceiptDigest);
174:     } else {
175:       const input = state.reservations.find(item => item.admissionId === inputReference.admissionId);
176:       if (input?.phase !== 'retained-input' || !input.slotReleased
177:         || preparationDigest(input.input) !== preparationDigest(staged)) {
178:         throw new Error('BUSTER_PREPARATION_RETAINED_INPUT_REQUIRED');
179:       }
180:     }
181:   }
182: 
183:   /** Bind positive no-source terminal evidence before removing even root-only metadata. */
184:   async beginEmptyGateReclaim(admissionId: string, resultDigest: string): Promise<void> {
185:     if (!/^sha256:[a-f0-9]{64}$/u.test(resultDigest)) throw new Error('BUSTER_PREPARATION_EMPTY_GATE_PROOF_INVALID');
186:     await this.#transition(admissionId, current => {
187:       if (!['staging', 'reserved', 'empty-gate-reclaiming'].includes(current.phase)
188:         || current.source !== null || !current.gate
189:         || (current.emptyGateResultDigest !== null && current.emptyGateResultDigest !== resultDigest)) {
190:         throw new Error('BUSTER_PREPARATION_EMPTY_GATE_PROOF_INVALID');
191:       }
192:       return { ...current, phase: 'empty-gate-reclaiming', emptyGateResultDigest: resultDigest };
193:     });
194:   }
195: 
196:   /** Publication intent never releases the identity; call after quiescence and durable gate revocation. */
197:   async releasePublishedSlot(source: PreparedSourceReference): Promise<void> {
198:     source = structuredClone(source);
199:     await this.#transition(source.admissionId, current => {
200:       if (current.phase !== 'published' || JSON.stringify(current.source) !== JSON.stringify(source)) {
201:         throw new Error('BUSTER_PREPARATION_SLOT_RELEASE_INVALID');
202:       }
203:       return { ...current, slotReleased: true };
204:     });
205:   }
206: 
207:   async bindGate(admissionId: string, binding: PreparationGateBinding): Promise<void> {
208:     binding = structuredClone(binding);
209:     await this.#transition(admissionId, current => {
210:       if (current.gate !== null && JSON.stringify(current.gate) !== JSON.stringify(binding)) {
211:         throw new Error('BUSTER_PREPARATION_GATE_CONFLICT');
212:       }
213:       return { ...current, gate: structuredClone(binding) };
214:     });
215:   }
216: 
217:   async published(source: PreparedSourceReference): Promise<void> {
218:     source = structuredClone(source);
219:     await this.#transition(source.admissionId, current => {
220:       if (!current.gate || !['prepared', 'published'].includes(current.phase)
221:         || JSON.stringify(current.source) !== JSON.stringify(source)) throw new Error('BUSTER_PREPARATION_PUBLICATION_INVALID');
222:       return { ...current, phase: 'published' };
223:     });
224:   }
225: 
226:   async prepared(source: PreparedSourceReference): Promise<void> {
227:     source = structuredClone(source);
228:     await this.#transition(source.admissionId, current => {
229:       if (current.attemptSpecDigest !== source.attemptSpecDigest) throw new Error('BUSTER_PREPARATION_RESERVATION_CONFLICT');
230:       if (current.phase !== 'reserved') {
231:         if (JSON.stringify(current.source) !== JSON.stringify(source)) throw new Error('BUSTER_PREPARATION_RESERVATION_CONFLICT');
232:         return current;
233:       }
234:       return { ...current, source: structuredClone(source), phase: 'prepared' };
235:     });
236:   }
237: 
238:   /** Caller must first verify the exact native cleanup receipt and retained archive identity. */
239:   async repositoryReleased(admissionId: string, archiveBytes: number, metadataBytes: number): Promise<void> {
240:     if (![archiveBytes, metadataBytes].every(value => Number.isSafeInteger(value) && value >= 0)) {
241:       throw new Error('BUSTER_PREPARATION_RELEASE_INVALID');
242:     }
243:     await this.#transition(admissionId, current => {
244:       if (!current.source || current.source.archiveBytes !== archiveBytes || current.phase === 'released') {
245:         throw new Error('BUSTER_PREPARATION_RELEASE_INVALID');
246:       }
247:       const bytes = archiveBytes + metadataBytes + 6 * this.#settings.sourceEntryReservationBytes;
248:       if (bytes > current.bytes) throw new Error('BUSTER_PREPARATION_RELEASE_INVALID');
249:       return { ...current, phase: 'repository-released', bytes, entries: 6 };
250:     });
251:   }
252: 
253:   /** Never called merely because a child exited; exact quiescence and owned absence are prerequisites. */
254:   async released(admissionId: string): Promise<void> {
255:     await this.#transition(admissionId, current => ({ ...current, phase: 'released', slotReleased: true, bytes: 0, entries: 0 }));
256:   }
257: 
258:   /** The association is fsynced before any cleanup process can remove owned source. */
259:   async reserveCleanup(admissionId: string, association: PreparationCleanupAssociation): Promise<void> {
260:     association = structuredClone(association);
261:     await this.#transition(admissionId, current => {
262:       if (current.slotReleased || !['staging', 'reserved'].includes(current.phase) || !current.gate) {
263:         throw new Error('BUSTER_PREPARATION_CLEANUP_INELIGIBLE');
264:       }
265:       const existing = current.cleanup.find(item => item.envelope.attemptId === association.envelope.attemptId);
266:       if (existing) {
267:         if (preparationDigest(existing) !== preparationDigest(association)) throw new Error('BUSTER_PREPARATION_CLEANUP_CONFLICT');
268:         return current;
269:       }
270:       return { ...current, cleanup: [...current.cleanup, association] };
271:     });
272:   }
273: 
274:   /** A result digest is write-once. Failed predecessor receipts remain bound on retry. */
275:   async recordCleanupResult(admissionId: string, envelopeDigest: string, resultDigest: string): Promise<void> {
276:     await this.#transition(admissionId, current => {
277:       const index = current.cleanup.findIndex(item => preparationDigest(item.envelope) === envelopeDigest);
278:       const association = current.cleanup[index];
279:       if (!association || (association.resultDigest !== null && association.resultDigest !== resultDigest)) {
280:         throw new Error('BUSTER_PREPARATION_CLEANUP_CONFLICT');
281:       }
282:       const cleanup = [...current.cleanup];
283:       cleanup[index] = { ...association, resultDigest };
284:       return { ...current, cleanup };
285:     });
286:   }
287: 
288:   async reservations(): Promise<readonly SourceReservation[]> {
289:     return withDurableStoreLock(this.#file, async () => structuredClone((await this.#read()).reservations));
290:   }
291: 
292:   async #transition(admissionId: string, update: (value: SourceReservation) => SourceReservation): Promise<void> {
293:     await withDurableStoreLock(this.#file, async () => {
294:       const state = await this.#read();
295:       const index = state.reservations.findIndex(item => item.admissionId === admissionId);
296:       if (index < 0) throw new Error('BUSTER_PREPARATION_RESERVATION_MISSING');
297:       const reservations = [...state.reservations];
298:       reservations[index] = update(reservations[index]!);
299:       await this.#write({ ...state, reservations });
300:     });
301:   }
302: 
303:   async #read(): Promise<SourceLedger> {
304:     const state = await readDurableState<SourceLedger>(this.#file, empty, this.#settings.maximumMetadataBytes);
305:     validateSourceLedger(state);
306:     return state;
307:   }
308: 
309: 
310:   async #write(state: SourceLedger): Promise<void> {
311:     validateSourceLedger(state);
312:     const bytes = state.reservations.reduce((sum, item) => sum + item.bytes, 0);
313:     const entries = state.reservations.reduce((sum, item) => sum + item.entries, 0);
314:     // Every admitted slot reserves its future terminal reference before native launch.
315:     const metadata = Math.max(Buffer.byteLength(canonicalJson(state)), Buffer.byteLength(canonicalJson({ ...state,
316:       reservations: state.reservations.map(terminalMetadataProjection) })))
317:       + state.reservations.filter(item => item.phase === 'staging' && item.input === null).length
318:         * (this.#settings.maximumHeaderBytes + this.#settings.maximumInputBytes)
319:       + state.reservations.reduce((sum, item) => sum + item.groupMetadataBytes, 0)
320:       + state.reservations.filter(item => !item.slotReleased).length
321:         * preparationCleanupMetadataCapacity(this.#settings.maximumInputBytes);
322:     if (state.reservations.length + state.reservations.reduce((sum, item) => sum + item.groupRecords + item.cleanup.length
323:       + (item.slotReleased ? 0 : 1), 0) > this.#settings.maximumRecords || metadata > this.#settings.maximumMetadataBytes
324:       || !Number.isSafeInteger(bytes) || bytes > this.#settings.maximumSourceBytes
325:       || !Number.isSafeInteger(entries) || entries > this.#settings.maximumSourceEntries) {
326:       throw new Error('BUSTER_PREPARATION_SOURCE_CAPACITY');
327:     }
328:     await writeDurableState(this.#file, state);
329:   }
330: }

SOURCE skills/buster/engine/test-gates/preparation-native-phase.ts SHA256 20362a6d9a4147be607c1006cd42a33465d5b56b7df5acfef04562009abba179
1: import { historicalChannelLimits } from './preparation-historical-channel.ts';
2: import { assertHistoricalImportDescriptor, type HistoricalImportDescriptor } from './preparation-historical-reference.ts';
3: import { validateBusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
4: import { executeNativeWorkerAttempt, type NativeWorkerControlChannel } from '@kubeclaw/worker-core';
5: import type { WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
6: import { assertPreparationSlot } from './preparation-slots.ts';
7: import { preparationCommand } from './preparation-command.ts';
8: import { preparationHostChannelLimits } from './preparation-host-channel.ts';
9: import type { PreparationExecutionOptions } from './preparation-execution.ts';
10: 
11: /** Both source phases use the same native owner, journal and quiescence requirement. */
12: export async function runPreparationPhase(options: PreparationExecutionOptions,
13:   envelope: WorkerAttemptEnvelopeV3, signal: AbortSignal,
14:   exchange: (channel: NativeWorkerControlChannel, cancelled: AbortSignal) => Promise<void>) {
15:   const { owner, journal } = options;
16:   const settings = validateBusterPreparationSettings(envelope.operation.values.settings);
17:   const slot = envelope.operation.values.preparationUid;
18:   const admissionId = envelope.operation.values.admissionId;
19:   assertPreparationSlot(slot);
20:   if (typeof admissionId !== 'string') throw new Error('BUSTER_PREPARATION_ADMISSION_ID_INVALID');
21:   const phase = envelope.operation.values.phase as { kind?: unknown; descriptor?: unknown };
22:   const historical = phase?.kind === 'historical';
23:   if (historical) assertHistoricalImportDescriptor(phase.descriptor);
24:   const channelLimits = historical
25:     ? historicalChannelLimits(phase.descriptor as HistoricalImportDescriptor, settings)
26:     : preparationHostChannelLimits(settings);
27:   const result = await executeNativeWorkerAttempt({ envelope, journal, process: {
28:     owner, signal, command: preparationCommand(admissionId, settings, options.command, slot, historical ? 'historical' : 'prepare'),
29:     limits: { cpuTimeMs: settings.resourcePolicy.cpuTimeMs, memoryBytes: settings.resourcePolicy.memoryBytes,
30:       tasks: settings.resourcePolicy.tasks, timeoutMs: settings.timeoutMs + 8 * settings.cleanupTimeoutMs,
31:       maximumInputBytes: settings.maximumInputBytes, maximumOutputBytes: settings.maximumOutputBytes,
32:       pollIntervalMs: settings.pollIntervalMs, closeTimeoutMs: settings.closeTimeoutMs },
33:     control: { limits: channelLimits, run: exchange },
34:   } });
35:   if (result.state !== 'completed' || result.cleanup.state !== 'completed') {
36:     throw new Error(result.error?.code ?? 'BUSTER_PREPARATION_FAILED');
37:   }
38:   const ownership = await owner.record({ workerId: envelope.claim.workerId, attemptId: envelope.attemptId,
39:     claimId: envelope.claim.claimId, generation: envelope.claim.generation,
40:     profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest });
41:   if (ownership?.phase !== 'disposed' || ownership.finalObservation?.populated !== false) {
42:     throw new Error('BUSTER_PREPARATION_PUBLICATION_QUIESCENCE_UNPROVEN');
43:   }
44:   return result;
45: }

