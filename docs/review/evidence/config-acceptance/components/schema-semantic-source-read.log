9: export function preparationProfile(engineContentDigest: string): WorkerProfileV3 {
10:   if (!/^sha256:[a-f0-9]{64}$/u.test(engineContentDigest)) throw new Error('BUSTER_PREPARATION_ENGINE_IDENTITY_REQUIRED');
11:   const profile = {
12:     schemaVersion: 'worker-profile.v3' as const,
13:     profileId: 'buster-native-preparation-v1', workerType: 'buster',
14:     coreContractId: 'kubeclaw.pipeline-worker-core@1',
15:     engine: { engineId: 'buster-native-preparation', contractId: 'kubeclaw.buster-preparation@1',
16:       engineVersion: '1.0.0', contentDigest: engineContentDigest },
17:     resourceCapabilities: {
18:       schemaVersion: 'worker-resource-capabilities.v2' as const,
19:       cpuTimeMs: { scope: 'native-attempt-tree' as const, unit: 'milliseconds' as const, measurement: 'measured' as const },
20:       maximumMemoryBytes: { scope: 'native-attempt-tree' as const, unit: 'bytes' as const, measurement: 'measured' as const },
21:       maximumTasks: { scope: 'native-attempt-tree' as const, unit: 'linux-tasks' as const, measurement: 'measured' as const },
22:     },
23:     capabilities: [],
24:   };
25:   return { ...profile, profileDigest: workerProfileDigest(profile) };
26: }
27: 
28: export type PreparationPhase = { readonly kind: 'historical'; readonly descriptor: HistoricalImportDescriptor }
29:   | { readonly kind: 'stage' }
30:   | { readonly kind: 'extract'; readonly input: BusterInputReference };
31: 
32: /** Parent-generated upload identity is durable before any request bytes reach the host. */
33: export function preparationEnvelope(admissionId: string, profile: WorkerProfileV3,
34:   settings: BusterPreparationSettings, now: Date, preparationUid: PreparationSlot, phase: PreparationPhase): WorkerAttemptEnvelopeV3 {
35:   if (!/^[a-f0-9]{32}$/u.test(admissionId)) throw new Error('BUSTER_PREPARATION_ADMISSION_ID_INVALID');
36:   assertPreparationSlot(preparationUid);
37:   const issuedAt = now.toISOString();
38:   const expiresAt = new Date(now.getTime() + settings.timeoutMs + 8 * settings.cleanupTimeoutMs).toISOString();
39:   const attemptId = `prepare-${admissionId}`;
40:   const unsigned = {
41:     schemaVersion: 'worker-attempt-envelope.v3' as const, protocolVersion: 'worker-protocol.v1' as const,
42:     pipelineRunId: attemptId, moduleId: null, gateId: null, planId: attemptId,
43:     nodeId: 'prepare-source', executionId: attemptId, attemptId, attemptNumber: 1,
44:     claim: { schemaVersion: 'attempt-claim.v1' as const, claimId: `claim-${admissionId}`, attemptId,
45:       generation: 1, workerId: 'buster-preparation', claimedAt: issuedAt, expiresAt },
46:     profile, packages: [], grantedCapabilities: [],
47:     limits: { timeoutMs: settings.timeoutMs, cleanupTimeoutMs: settings.cleanupTimeoutMs,
48:       logBytes: 1, resultBytes: settings.maximumResultBytes,
49:       evidenceBytes: 1, evidenceFiles: 1 },
50:     resourceBudgets: {
51:       schemaVersion: 'worker-resource-budgets.v2' as const,
52:       cpuTimeMs: { state: 'requested' as const, limit: settings.resourcePolicy.cpuTimeMs },
53:       maximumMemoryBytes: { state: 'requested' as const, limit: settings.resourcePolicy.memoryBytes },
54:       maximumTasks: { state: 'requested' as const, limit: settings.resourcePolicy.tasks },
55:     },
56:     inputs: [],
57:     operation: { contractId: 'kubeclaw.buster-preparation@1', inputSchemaId: 'buster-preparation-input.v1',
58:       inputSchemaDigest: sha256Digest({ schemaVersion: 'buster-preparation-input.v1', fields: ['admissionId', 'settings', 'preparationUid', 'phase'] }),
59:       values: { admissionId, preparationUid, settings: JSON.parse(JSON.stringify(settings)),
60:         phase: JSON.parse(JSON.stringify(phase)) } },
61:     cancellationId: `cancel-${admissionId}`, issuedAt, queueDeadline: expiresAt,
62:   };
63:   const envelope = { ...unsigned, attemptSpecDigest: workerAttemptSpecDigest(unsigned) };
64:   validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
65:   return envelope;
66: }

