29: async function previousQuiescent(options: PreparationExecutionOptions, association: PreparationCleanupAssociation,
30:   result: WorkerAttemptResultV3): Promise<void> {
31:   const envelope = association.envelope;
32:   const owner = await options.owner.record({ workerId: envelope.claim.workerId, attemptId: envelope.attemptId,
33:     claimId: envelope.claim.claimId, generation: envelope.claim.generation,
34:     profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest });
35:   if (owner?.phase === 'disposed' && owner.binding && owner.finalObservation?.populated === false) return;
36:   const notLaunched = !owner || (['disposed', 'abandoned'].includes(owner.phase)
37:     && ['WORKER_NATIVE_ALLOCATION_NOT_LAUNCHED', 'WORKER_NATIVE_RESERVATION_NOT_LAUNCHED'].includes(owner.diagnosis ?? ''));
38:   if (notLaunched && result.cleanup.state === 'not_required') return;
39:   throw new Error('BUSTER_PREPARATION_CLEANUP_PREDECESSOR_NOT_QUIESCENT');
40: }
41: 
42: async function releaseSource(options: PreparationExecutionOptions, record: SourceReservation,
43:   association: PreparationCleanupAssociation): Promise<WorkerAttemptEnvelopeV3> {
44:   await verifyNativeSourceCleanupResult(options.journal, options.owner, association.envelope);
45:   await removeEmptyPreparationGate(options.command.sourceRoot, record.admissionId, association.effects.gate);
46:   await options.ledger.released(record.admissionId);
47:   return association.envelope;
48: }
49: 
50: function bindOriginal(association: PreparationCleanupAssociation, original: WorkerAttemptEnvelopeV3,
51:   result: WorkerAttemptResultV3): void {
52:   const expected = nativeSourceCleanupOperation(original, result, preparationDigest(association.effects));
53:   if (preparationDigest(association.envelope.operation) !== preparationDigest(expected)) {
54:     throw new Error('BUSTER_PREPARATION_CLEANUP_ORIGINAL_CHANGED');
55:   }
56: }
57: 
58: async function reconcileSource(options: PreparationExecutionOptions, original: WorkerAttemptEnvelopeV3,
59:   result: WorkerAttemptResultV3): Promise<WorkerAttemptEnvelopeV3 | null> {
60:   const record = (await options.ledger.reservations()).find(item => preparationDigest(item.envelope) === preparationDigest(original));
61:   if (!record || !record.gate || !['staging', 'reserved', 'released'].includes(record.phase)) return null;
62:   let previous = record.cleanup.at(-1);
63:   if (previous) {
64:     bindOriginal(previous, original, result);
65:     const recovered = await recoverPreparationCleanup(options, previous);
66:     if (!recovered) {
67:       await executePreparationCleanup(options, previous);
68:       return releaseSource(options, record, previous);
69:     }
70:     await options.ledger.recordCleanupResult(record.admissionId, preparationDigest(previous.envelope), recovered.resultDigest);
71:     previous = { ...previous, resultDigest: recovered.resultDigest };
72:     if (recovered.state === 'completed' && recovered.cleanup.state === 'completed') {
73:       return releaseSource(options, record, previous);
74:     }
75:     await previousQuiescent(options, previous, recovered);
76:   }
77:   if (record.slotReleased) return null;
78:   const effects = previous?.effects ?? await sourceEffects(options, record);
79:   const settings = structuredClone(options.settings);
80:   const association: PreparationCleanupAssociation = {
81:     envelope: preparationCleanupEnvelope(original, result, effects, settings, options.engineContentDigest),
82:     settings, effects, previousEnvelopeDigest: previous ? preparationDigest(previous.envelope) : null,
83:     previousResultDigest: previous?.resultDigest ?? null, resultDigest: null,
84:   };
85:   await options.ledger.reserveCleanup(record.admissionId, association);
86:   await executePreparationCleanup(options, association);
87:   return releaseSource(options, record, association);
88: }
89: 
90: /** Startup only, while the root parent lifetime fence excludes publication and manual mutation. */
91: export function preparationCleanupReconciliation(options: PreparationExecutionOptions): NativeCleanupReconciliation {
92:   return { journal: options.journal,
93:     cleanupProfileDigest: preparationCleanupProfile(options.engineContentDigest).profileDigest,
94:     reconcile: ({ envelope, result }) => reconcileSource(options, envelope, result),
95:     async resolveFailedCleanup({ envelope }) {
96:       for (const record of await options.ledger.reservations()) {
97:         const predecessor = record.cleanup.find(item => preparationDigest(item.envelope) === preparationDigest(envelope));
98:         const successful = record.cleanup.at(-1);
99:         if (!predecessor || !successful || record.phase !== 'released') continue;
100:         if (preparationDigest(predecessor.effects) !== preparationDigest(successful.effects)) {
101:           throw new Error('BUSTER_PREPARATION_CLEANUP_ORIGINAL_CHANGED');
102:         }
103:         return { original: record.envelope, successfulCleanup: successful.envelope };
104:       }
105:       return null;
106:     } };
107: }

