4: import { ensureDirectoryDurable, withDurableStoreLock } from '@kubeclaw/plugin-foundation/observability/durable-delivery';
5: import { canonicalJson, sha256Digest, checkWorkerNativeResultBinding, validateWorkerResourceContractV3,
6:   type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
7: import { readNativeWorkerOutput } from './native-output-spool.ts';
8: import type { NativeWorkerProcessResult } from './native-worker-process.ts';
9: import { journalIdentity, journalKey, validateJournalState, usedJournalBytes,
10:   type NativeAttemptJournalLimits, type NativeAttemptJournalState } from './native-journal-state.ts';
11: 
12: import { nativeJournalStream, nativeJournalMaximumRecordBytes, reserveNativeJournalMetadata } from './native-journal-capacity.ts';
13: 
14: export type { NativeAttemptJournalLimits } from './native-journal-state.ts';
15: const stream = nativeJournalStream;
16: export class NativeWorkerAttemptBusy extends Error {
17:   constructor() { super('WORKER_NATIVE_ATTEMPT_BUSY'); }
18: }
19: 
20: /** Accepted identity, original output and sealed result outlive the serving process. */
21: export class NativeAttemptJournal {
22:   readonly #root: string;
23:   readonly #limits: NativeAttemptJournalLimits;
24:   readonly #records: FileDurableRecordStore;
25:   readonly #blobs: FileDurableBlobStore;
26: 
27:   constructor(root: string, limits: NativeAttemptJournalLimits) {
28:     if (!path.isAbsolute(root) || Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1)) {
29:       throw new Error('WORKER_NATIVE_JOURNAL_CONFIG_INVALID');
30:     }
31:     this.#root = path.resolve(root); this.#limits = { ...limits };
32:     this.#records = new FileDurableRecordStore(path.join(this.#root, 'metadata'), {
33:       maximumRecords: limits.maximumRecords, maximumBytes: limits.maximumStateBytes, maximumRecordBytes: nativeJournalMaximumRecordBytes,
34:     });
35:     this.#blobs = new FileDurableBlobStore(path.join(this.#root, 'data'), Math.max(limits.maximumInputBytes, limits.maximumResultBytes), limits.maximumTotalBytes);
36:   }
37: 
38:   async withAttempt<T>(input: WorkerAttemptEnvelopeV3,
39:     operation: (context: { envelope: WorkerAttemptEnvelopeV3; newlyAccepted: boolean; acceptedAt: string; outputRoot: string }) => Promise<T>,
40:     validateNewAdmission: (envelope: WorkerAttemptEnvelopeV3) => void = () => {}): Promise<T> {
41:     const envelope = structuredClone(input);
42:     validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
43:     const bytes = Buffer.from(canonicalJson(envelope));
44:     if (bytes.byteLength > this.#limits.maximumInputBytes) throw new Error('WORKER_NATIVE_JOURNAL_INPUT_LIMIT');
45:     await this.#initialize();
46:     const key = journalKey(envelope);
47:     // 256 fixed lock stripes bound rejected-request lock metadata. Equal claims
48:     // serialize across real processes; unrelated stripes can execute together.
49:     let entered = false;
50:     try {
51:       return await withDurableStoreLock(path.join(this.#root, 'fences', key.slice(-2), 'lifetime'), async () => {
52:         entered = true;
53:         const reserved = await this.#reserve(envelope, bytes, validateNewAdmission);
54:         return operation({ envelope, newlyAccepted: reserved.newlyAccepted, acceptedAt: reserved.record.payload.acceptedAt,
55:           outputRoot: this.outputRoot(envelope) });
56:       });
57:     } catch (error) {
58:       if (!entered && error instanceof Error && error.message.startsWith('OBSERVABILITY_STORE_LOCK_FAILED:')
59:         && error.message.endsWith(':OBSERVABILITY_STORE_LOCKED:1:')) throw new NativeWorkerAttemptBusy();
60:       throw error;
61:     }
62:   }
63: 
64:   outputRoot(envelope: WorkerAttemptEnvelopeV3): string { return path.join(this.#root, 'outputs', journalKey(envelope).slice(7)); }
65: 
66:   async *acceptedEnvelopes(): AsyncGenerator<WorkerAttemptEnvelopeV3> {
67:     await this.#initialize();
68:     for (const record of await this.#all()) {
69:       const bytes = await this.#blobs.get(record.payload.envelope.digest);
70:       if (bytes.byteLength !== record.payload.envelope.sizeBytes) throw new Error('WORKER_NATIVE_JOURNAL_ENVELOPE_SIZE_CHANGED');
71:       const envelope = JSON.parse(bytes.toString('utf8')) as WorkerAttemptEnvelopeV3;
72:       validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
73:       if (journalKey(envelope) !== record.idempotencyKey || sha256Digest(envelope) !== record.payload.envelopeDigest
74:         || canonicalJson(journalIdentity(envelope)) !== canonicalJson(record.payload.identity)) throw new Error('WORKER_NATIVE_JOURNAL_IDENTITY_CONFLICT');
75:       yield envelope;
76:     }
77:   }
78: 
79:   async hasAttempt(envelope: WorkerAttemptEnvelopeV3): Promise<boolean> { return (await this.#lookup(envelope)) !== undefined; }
80: 
81:   async readResult(envelope: WorkerAttemptEnvelopeV3): Promise<WorkerAttemptResultV3 | null> {
82:     const record = await this.#lookup(envelope);
83:     if (!record?.payload.result) return null;
84:     const bytes = await this.#blobs.get(record.payload.result.digest);
85:     if (bytes.byteLength !== record.payload.result.sizeBytes) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_SIZE_CHANGED');
86:     const result = JSON.parse(bytes.toString('utf8')) as WorkerAttemptResultV3;
87:     if (!checkWorkerNativeResultBinding(envelope, result).ok) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_BINDING_INVALID');
88:     return result;
89:   }
90: 
91:   async readProcess(envelope: WorkerAttemptEnvelopeV3): Promise<{ process: NativeWorkerProcessResult; completedAt: string } | null> {
92:     const record = await this.#lookup(envelope);
93:     const process = record?.payload.process;
94:     if (!process) return null;
95:     const output = await readNativeWorkerOutput(this.outputRoot(envelope), this.#limits.maximumOutputBytes);
96:     for (const channel of ['stdout', 'stderr'] as const) {
97:       if (output[channel].digest !== process[channel].digest || output[channel].sizeBytes !== process[channel].sizeBytes) {
98:         throw new Error('WORKER_NATIVE_JOURNAL_OUTPUT_CHANGED');
99:       }
100:     }
101:     return { process: { ...process, stdout: output.stdout.bytes, stderr: output.stderr.bytes }, completedAt: record!.payload.processCompletedAt! };
102:   }
103: 
104:   async recordProcess(envelope: WorkerAttemptEnvelopeV3, input: NativeWorkerProcessResult, completedAt: Date): Promise<void> {
105:     const process = structuredClone(input);
106:     const timestamp = completedAt.toISOString();
107:     const record = await this.#required(envelope);
108:     if (record.payload.result || record.payload.process) throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_ALREADY_RECORDED');
109:     const output = await readNativeWorkerOutput(this.outputRoot(envelope), this.#limits.maximumOutputBytes);
110:     if (!output.stdout.bytes.equals(Buffer.from(process.stdout)) || !output.stderr.bytes.equals(Buffer.from(process.stderr))) {
111:       throw new Error('WORKER_NATIVE_JOURNAL_OUTPUT_INCOMPLETE');
112:     }
113:     const reference = (channel: 'stdout' | 'stderr') => ({ digest: output[channel].digest, sizeBytes: output[channel].sizeBytes });
114:     const payload = { ...record.payload, processCompletedAt: timestamp, process: { ...process, stdout: reference('stdout'), stderr: reference('stderr') } };
115:     validateJournalState(payload);
116:     await this.#records.transition(stream, record.idempotencyKey, record.payloadDigest, payload);
117:   }
118: 
119:   async seal(envelope: WorkerAttemptEnvelopeV3, input: WorkerAttemptResultV3): Promise<WorkerAttemptResultV3> {
120:     const result = structuredClone(input);
121:     if (!checkWorkerNativeResultBinding(envelope, result).ok) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_BINDING_INVALID');
122:     const bytes = Buffer.from(canonicalJson(result));
123:     if (bytes.byteLength > this.#limits.maximumResultBytes) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_LIMIT');
124:     return withDurableStoreLock(path.join(this.#root, 'admission', 'lifetime'), async () => {
125:       const record = await this.#required(envelope);
126:       if (record.payload.result) {
127:         if (record.payload.result.digest !== sha256Digest(result)) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_ALREADY_SEALED');
128:         return result;
129:       }
130:       const reference = await this.#blobs.put(bytes);
131:       await this.#records.transition(stream, record.idempotencyKey, record.payloadDigest, { ...record.payload, result: reference });
132:       return result;
133:     });
134:   }
135: 
136:   async #initialize(): Promise<void> {
137:     await ensureDirectoryDurable(path.dirname(this.#root));
138:     try { await fs.mkdir(this.#root, { mode: 0o700 }); }
139:     catch (error) { if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error; }
140:     const stat = await fs.lstat(this.#root);
141:     if (!stat.isDirectory() || stat.uid !== process.getuid!() || (stat.mode & 0o077) !== 0) throw new Error('WORKER_NATIVE_JOURNAL_NOT_PRIVATE');
142:   }
143: 
144:   async #all(): Promise<readonly DurableRecord<NativeAttemptJournalState>[]> {
145:     const records = await this.#records.read<NativeAttemptJournalState>(stream);
146:     for (const record of records) validateJournalState(record.payload);
147:     return records;
148:   }
149: 
150:   async #lookup(envelope: WorkerAttemptEnvelopeV3): Promise<DurableRecord<NativeAttemptJournalState> | undefined> {
151:     await this.#initialize();
152:     const record = (await this.#all()).find(record => record.idempotencyKey === journalKey(envelope));
153:     if (record && (record.payload.envelopeDigest !== sha256Digest(envelope)
154:       || canonicalJson(record.payload.identity) !== canonicalJson(journalIdentity(envelope)))) throw new Error('WORKER_NATIVE_JOURNAL_IDENTITY_CONFLICT');
155:     return record;
156:   }
157: 
158:   async #required(envelope: WorkerAttemptEnvelopeV3): Promise<DurableRecord<NativeAttemptJournalState>> {
159:     const record = await this.#lookup(envelope);
160:     if (!record) throw new Error('WORKER_NATIVE_JOURNAL_RESERVATION_REQUIRED');
161:     return record;
162:   }
163: 
164:   async #reserve(envelope: WorkerAttemptEnvelopeV3, bytes: Buffer, validateNewAdmission: (envelope: WorkerAttemptEnvelopeV3) => void) {
165:     return withDurableStoreLock(path.join(this.#root, 'admission', 'lifetime'), async () => {
166:       const existing = await this.#lookup(envelope);
167:       if (existing) return { newlyAccepted: false, record: existing };
168:       // Reject expired or unsupported new work under the admission lock, before
169:       // retaining input or accepting an identity. Historical replay bypasses it.
170:       validateNewAdmission(envelope);
171:       const reservationBytes = bytes.byteLength + this.#limits.maximumOutputBytes + this.#limits.maximumResultBytes + 65536;
172:       const records = await this.#all();
173:       const pending = records.filter(record => record.payload.result === null).reduce((sum, record) => sum + record.payload.reservationBytes, 0);
174:       const requested = await usedJournalBytes(this.#root) + pending + reservationBytes + 2 * this.#limits.maximumStateBytes;
175:       if (!Number.isSafeInteger(requested) || requested > this.#limits.maximumTotalBytes) throw new Error('WORKER_NATIVE_JOURNAL_CAPACITY_EXCEEDED');
176:       const payload: NativeAttemptJournalState = { schemaVersion: 'native-attempt-journal.v1', identity: journalIdentity(envelope),
177:         envelopeDigest: sha256Digest(envelope), envelope: { digest: sha256Digest(envelope), sizeBytes: bytes.byteLength },
178:         acceptedAt: new Date().toISOString(), reservationBytes, process: null, processCompletedAt: null, result: null };
179:       const owner = `native-worker:${sha256Digest(envelope.claim.workerId).slice(7)}`;
180:       await reserveNativeJournalMetadata(path.join(this.#root, 'metadata', 'records', 'store.json'),
181:         payload, journalKey(envelope), owner, this.#limits);
182:       // The global admission lock holds the checked disk reservation while the
183:       // input is fsynced. A crash can leave an unreferenced original blob, which
184:       // remains counted, but never an accepted identity with no recoverable input.
185:       await this.#blobs.put(bytes);
186:       const appended = await this.#records.append(stream, journalKey(envelope), payload, owner);
187:       return { newlyAccepted: true, record: appended.record };
188:     });
189:   }
190: }

SOURCE skills/worker/core/worker/native-attempt-recovery.ts SHA256 f6cef5767983497edd3865667a6b480e8ea75ed34b847bc4f44e8fae02d807bc
1: import { canonicalJson, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
2: import type { WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import type { NativeAttemptJournal } from './native-attempt-journal.ts';
4: import type { NativeWorkerOwnership } from './native-worker-ownership.ts';
5: import { journalIdentity } from './native-journal-state.ts';
6: import { finalizeNativeWorkerResult, interruptedNativeWorkerResult } from './native-result.ts';
7: import { reconcileNativeCleanup, resolveFailedNativeCleanup, type NativeCleanupReconciliation } from './native-cleanup-reconciliation.ts';
8: 
9: /** Called only after native ownership recovery, before exposing HTTP admission. */
10: export async function recoverNativeWorkerAttempts(journal: NativeAttemptJournal, owner: NativeWorkerOwnership,
11:   reconciliation?: NativeCleanupReconciliation): Promise<void> {
12:   try {
13:     // The accepted journal is already bounded by its existing record/state limits.
14:     // Defer only failed cleanup rows so an earlier insertion cannot prevent the
15:     // original operation from producing its separately owned retry proof.
16:     const deferred: Array<{ envelope: WorkerAttemptEnvelopeV3; result: WorkerAttemptResultV3 }> = [];
17:     for await (const envelope of journal.acceptedEnvelopes()) {
18:       const result = await journal.withAttempt(envelope, async context => {
19:         const cached = await journal.readResult(envelope);
20:         if (cached) return cached;
21:         const recovered = await recoverNativeAttempt(journal, owner, envelope, new Date(context.acceptedAt), false);
22:         if (!recovered) throw new Error('WORKER_NATIVE_JOURNAL_RECOVERY_REQUIRED');
23:         return journal.seal(envelope, recovered);
24:       });
25:       if (result.cleanup.state === 'failed' && envelope.operation.contractId === 'kubeclaw.native-source-cleanup@1') {
26:         deferred.push({ envelope, result });
27:         continue;
28:       }
29:       if (result.cleanup.state === 'failed'
30:         && (!reconciliation || !await reconcileNativeCleanup(owner, envelope, result, reconciliation))) owner.fenceAdmission();
31:     }
32:     for (const { envelope, result } of deferred) {
33:       if (!reconciliation || !await resolveFailedNativeCleanup(journal, owner, envelope, result, reconciliation)) {
34:         owner.fenceAdmission();
35:       }
36:     }
37:   } catch (error) { owner.fenceAdmission(); throw error; }
38: }
39: 
40: export async function recoverNativeAttempt(journal: NativeAttemptJournal, ownership: NativeWorkerOwnership, envelope: WorkerAttemptEnvelopeV3,
41:   started: Date, newlyAccepted: boolean): Promise<WorkerAttemptResultV3 | null> {
42:   const owner = await ownership.record(journalIdentity(envelope));
43:   const archived = await journal.readProcess(envelope);
44:   if (archived) {
45:     if (!owner || owner.phase !== 'disposed' || owner.finalObservation === null
46:       || canonicalJson(owner.finalObservation) !== canonicalJson(archived.process.resources)) {
47:       throw new Error('WORKER_NATIVE_JOURNAL_OWNERSHIP_UNPROVEN');
48:     }
49:     return finalizeNativeWorkerResult(envelope, archived.process, started, new Date(archived.completedAt));
50:   }
51:   if (newlyAccepted && !owner) return null;
52:   if (owner && !['disposed', 'abandoned'].includes(owner.phase)) throw new Error('WORKER_NATIVE_RECOVERY_NOT_QUIESCENT');
53:   // The durable journal admission precedes ownership reservation. With intact
54:   // stores, a missing owner means no launch crossed that boundary.
55:   const notLaunched = !owner || ['WORKER_NATIVE_ALLOCATION_NOT_LAUNCHED', 'WORKER_NATIVE_RESERVATION_NOT_LAUNCHED'].includes(owner.diagnosis ?? '');
56:   return interruptedNativeWorkerResult(envelope, started, 'WORKER_NATIVE_INTERRUPTED_RESULT_UNAVAILABLE', owner?.finalObservation ?? null, notLaunched);
57: }

SOURCE skills/worker/core/worker/native-cleanup-reconciliation.ts SHA256 9cfc04ab25b0eecea23b75b9dcdbb4b87f87854c8b00b7346e7eafa33a0118f4
1: import {
2:   canonicalJson, checkWorkerNativeResultBinding, sha256Digest,
3:   validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3,
4: } from '@kubeclaw/pipeline-worker-core-contract';
5: import type { NativeAttemptJournal } from './native-attempt-journal.ts';
6: import type { NativeWorkerOwnership } from './native-worker-ownership.ts';
7: import type { WorkerOwnershipRecord } from './ownership-store.ts';
8: import { journalIdentity } from './native-journal-state.ts';
9: import { finalizeNativeWorkerResult } from './native-result.ts';
10: 
11: const contractId = 'kubeclaw.native-source-cleanup@1';
12: const inputSchemaId = 'native-source-cleanup-input.v1';
13: const inputSchemaDigest = sha256Digest({ schemaVersion: inputSchemaId,
14:   fields: ['reconciles', 'effectsDigest'], referenceFields: [
15:     'envelopeDigest', 'attemptId', 'attemptSpecDigest', 'profileDigest', 'claimId',
16:     'claimGeneration', 'workerId', 'resultDigest', 'receipt',
17:   ] });
18: export const nativeSourceCleanupResultSchema = Object.freeze({
19:   schemaId: 'native-source-cleanup-result.v1',
20:   schemaDigest: sha256Digest({ schemaVersion: 'native-source-cleanup-result.v1', fields: ['reconciliationDigest'] }),
21: });
22: 
23: export interface NativeCleanupReconciliation {
24:   readonly journal: NativeAttemptJournal;
25:   readonly cleanupProfileDigest: string;
26:   /** The role must durably bind this cleanup before launch under its publication fence. */
27:   reconcile(input: Readonly<{
28:     envelope: WorkerAttemptEnvelopeV3;
29:     result: WorkerAttemptResultV3;
30:     ownership: WorkerOwnershipRecord;
31:   }>): Promise<WorkerAttemptEnvelopeV3 | null>;
32:   /** Lookup only, after ordinary recovery; must not launch cleanup of a cleanup. */
33:   resolveFailedCleanup?(input: Readonly<{
34:     envelope: WorkerAttemptEnvelopeV3;
35:     result: WorkerAttemptResultV3;
36:   }>): Promise<Readonly<{
37:     original: WorkerAttemptEnvelopeV3;
38:     successfulCleanup: WorkerAttemptEnvelopeV3;
39:   }> | null>;
40: }
41: 
42: /** Fixed source-only proof identity; this never changes the original failed receipt. */
43: export function nativeSourceCleanupOperation(envelope: WorkerAttemptEnvelopeV3,
44:   result: WorkerAttemptResultV3, effectsDigest: string): WorkerAttemptEnvelopeV3['operation'] {
45:   if (!/^sha256:[a-f0-9]{64}$/u.test(effectsDigest)) throw new Error('WORKER_NATIVE_RECONCILIATION_EFFECTS_INVALID');
46:   return { contractId, inputSchemaId, inputSchemaDigest, values: {
47:     reconciles: { envelopeDigest: sha256Digest(envelope), attemptId: envelope.attemptId,
48:       attemptSpecDigest: envelope.attemptSpecDigest, profileDigest: envelope.profile.profileDigest,
49:       claimId: envelope.claim.claimId, claimGeneration: envelope.claim.generation,
50:       workerId: envelope.claim.workerId, resultDigest: result.resultDigest,
51:       receipt: { receiptId: result.receipt.receiptId, receiptDigest: result.receipt.receiptDigest } },
52:     effectsDigest,
53:   } };
54: }
55: 
56: async function quiescentOwner(owner: NativeWorkerOwnership, envelope: WorkerAttemptEnvelopeV3): Promise<WorkerOwnershipRecord> {
57:   const identity = journalIdentity(envelope);
58:   const record = await owner.record(identity);
59:   if (!record || canonicalJson(record.identity) !== canonicalJson(identity) || record.phase !== 'disposed'
60:     || record.binding === null || record.finalObservation === null || record.finalObservation.populated) {
61:     throw new Error('WORKER_NATIVE_RECONCILIATION_OWNERSHIP_UNPROVEN');
62:   }
63:   return record;
64: }
65: 
66: function validateCleanupEnvelope(cleanup: WorkerAttemptEnvelopeV3, envelope: WorkerAttemptEnvelopeV3,
67:   result: WorkerAttemptResultV3, profileDigest: string): void {
68:   validateWorkerResourceContractV3('workerAttemptEnvelope', cleanup);
69:   const effectsDigest = cleanup.operation.values.effectsDigest;
70:   if (typeof effectsDigest !== 'string' || cleanup.profile.profileDigest !== profileDigest
71:     || cleanup.attemptId === envelope.attemptId || cleanup.claim.claimId === envelope.claim.claimId
72:     || cleanup.attemptSpecDigest === envelope.attemptSpecDigest
73:     || canonicalJson(cleanup.operation) !== canonicalJson(nativeSourceCleanupOperation(envelope, result, effectsDigest))) {
74:     throw new Error('WORKER_NATIVE_RECONCILIATION_BINDING_INVALID');
75:   }
76: }
77: 
78: /** Role-side durable release must follow these same archived-result and ownership checks. */
79: export async function verifyNativeSourceCleanupResult(journal: NativeAttemptJournal, owner: NativeWorkerOwnership,
80:   cleanup: WorkerAttemptEnvelopeV3): Promise<void> {
81:   const result = await journal.readResult(cleanup);
82:   const archived = await journal.readProcess(cleanup);
83:   const ownership = await quiescentOwner(owner, cleanup);
84:   if (!result || !archived || archived.process.fault !== null || archived.process.exitCode !== 0
85:     || archived.process.signal !== null || result.state !== 'completed' || result.cleanup.state !== 'completed'
86:     || !checkWorkerNativeResultBinding(cleanup, result).ok
87:     || canonicalJson(ownership.finalObservation) !== canonicalJson(archived.process.resources)) {
88:     throw new Error('WORKER_NATIVE_RECONCILIATION_RESULT_UNPROVEN');
89:   }
90:   const expected = { ...nativeSourceCleanupResultSchema,
91:     values: { reconciliationDigest: sha256Digest(cleanup.operation.values) } };
92:   if (canonicalJson(result.specialistResult) !== canonicalJson(expected)) {
93:     throw new Error('WORKER_NATIVE_RECONCILIATION_RESULT_BINDING_INVALID');
94:   }
95:   // A separately sealed success cannot replace an invalid or different process
96:   // output. Reuse the actual executor finalizer, including measured accounting.
97:   await journal.withAttempt(cleanup, async context => {
98:     const recovered = finalizeNativeWorkerResult(cleanup, archived.process,
99:       new Date(context.acceptedAt), new Date(archived.completedAt));
100:     if (recovered.resultDigest !== result.resultDigest) {
101:       throw new Error('WORKER_NATIVE_RECONCILIATION_ARCHIVE_MISMATCH');
102:     }
103:   });
104: }
105: 
106: /** Called outside the original journal stripe. A failure leaves admission fenced. */
107: export async function reconcileNativeCleanup(owner: NativeWorkerOwnership, envelope: WorkerAttemptEnvelopeV3,
108:   result: WorkerAttemptResultV3, capability: NativeCleanupReconciliation): Promise<boolean> {
109:   if (envelope.operation.contractId === contractId || result.cleanup.state !== 'failed'
110:     || !checkWorkerNativeResultBinding(envelope, result).ok) {
111:     throw new Error('WORKER_NATIVE_RECONCILIATION_ORIGINAL_INVALID');
112:   }
113:   const journal = capability.journal;
114:   const profileDigest = capability.cleanupProfileDigest;
115:   const ownership = await quiescentOwner(owner, envelope);
116:   const candidate = await capability.reconcile(structuredClone({ envelope, result, ownership }));
117:   if (candidate === null) return false;
118:   const cleanup = structuredClone(candidate);
119:   validateCleanupEnvelope(cleanup, envelope, result, profileDigest);
120:   await verifyNativeSourceCleanupResult(journal, owner, cleanup);
121:   return true;
122: }
123: 
124: 
125: /** A failed cleanup receipt remains failed; a separate exact proof resolves its source effect. */
126: export async function resolveFailedNativeCleanup(originalJournal: NativeAttemptJournal,
127:   owner: NativeWorkerOwnership, failed: WorkerAttemptEnvelopeV3,
128:   failedResult: WorkerAttemptResultV3, capability: NativeCleanupReconciliation): Promise<boolean> {
129:   if (failed.operation.contractId !== contractId || failedResult.cleanup.state !== 'failed'
130:     || !checkWorkerNativeResultBinding(failed, failedResult).ok) {
131:     throw new Error('WORKER_NATIVE_RECONCILIATION_PREDECESSOR_INVALID');
132:   }
133:   const { resolveFailedCleanup, journal, cleanupProfileDigest } = capability;
134:   if (!resolveFailedCleanup) return false;
135:   const candidate = await resolveFailedCleanup(structuredClone({ envelope: failed, result: failedResult }));
136:   if (candidate === null) return false;
137:   const { original, successfulCleanup } = structuredClone(candidate);
138:   validateWorkerResourceContractV3('workerAttemptEnvelope', original);
139:   const originalResult = await originalJournal.readResult(original);
140:   if (original.operation.contractId === contractId || !originalResult || originalResult.cleanup.state !== 'failed') {
141:     throw new Error('WORKER_NATIVE_RECONCILIATION_ORIGINAL_INVALID');
142:   }
143:   validateCleanupEnvelope(failed, original, originalResult, cleanupProfileDigest);
144:   validateCleanupEnvelope(successfulCleanup, original, originalResult, cleanupProfileDigest);
145:   if (failed.operation.values.effectsDigest !== successfulCleanup.operation.values.effectsDigest
146:     || failed.attemptId === successfulCleanup.attemptId
147:     || failed.claim.claimId === successfulCleanup.claim.claimId) {
148:     throw new Error('WORKER_NATIVE_RECONCILIATION_PREDECESSOR_INVALID');
149:   }
150:   await quiescentOwner(owner, original);
151:   await quiescentOwner(owner, failed);
152:   await verifyNativeSourceCleanupResult(journal, owner, successfulCleanup);
153:   return true;
154: }

SOURCE skills/worker/core/worker/native-journal-state.ts SHA256 ae5cca21eb24261fa5389c7081bc3534e8e12b411d5bda0e97a69a94ead424d2
1: import fs from 'node:fs/promises';
2: import path from 'node:path';
3: import { sha256Digest, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
4: import type { WorkerOwnershipIdentity } from './ownership-store.ts';
5: import type { NativeWorkerProcessResult } from './native-worker-process.ts';
6: import { identityValid, exact } from './ownership-state.ts';
7: import { validateNativeWorkerResourceObservation } from './native-resource-observation.ts';
8: 
9: export const nativeJournalMaximumDiagnosticUnits = 4096;
10: 
11: export interface NativeAttemptJournalLimits {
12:   readonly maximumRecords: number;
13:   readonly maximumStateBytes: number;
14:   readonly maximumTotalBytes: number;
15:   readonly maximumInputBytes: number;
16:   readonly maximumOutputBytes: number;
17:   readonly maximumResultBytes: number;
18: }
19: 
20: interface BlobReference { readonly digest: string; readonly sizeBytes: number }
21: type ProcessRecord = Omit<NativeWorkerProcessResult, 'stdout' | 'stderr'> & { stdout: BlobReference; stderr: BlobReference };
22: export interface NativeAttemptJournalState {
23:   readonly schemaVersion: 'native-attempt-journal.v1';
24:   readonly identity: WorkerOwnershipIdentity;
25:   readonly envelopeDigest: string;
26:   readonly envelope: BlobReference;
27:   readonly acceptedAt: string;
28:   readonly reservationBytes: number;
29:   readonly process: ProcessRecord | null;
30:   readonly processCompletedAt: string | null;
31:   readonly result: BlobReference | null;
32: }
33: 
34: export function journalIdentity(envelope: WorkerAttemptEnvelopeV3): WorkerOwnershipIdentity {
35:   return { workerId: envelope.claim.workerId, attemptId: envelope.attemptId, claimId: envelope.claim.claimId,
36:     generation: envelope.claim.generation, profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest };
37: }
38: 
39: export function journalKey(envelope: WorkerAttemptEnvelopeV3): string {
40:   return sha256Digest([envelope.claim.workerId, envelope.attemptId, envelope.claim.generation]);
41: }
42: 
43: function blobReference(value: unknown): void {
44:   exact(value, ['digest', 'sizeBytes']);
45:   if (typeof value.digest !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(value.digest)
46:     || !Number.isSafeInteger(value.sizeBytes) || Number(value.sizeBytes) < 0) throw new Error('WORKER_NATIVE_JOURNAL_BLOB_INVALID');
47: }
48: 
49: export function validateJournalState(value: unknown): asserts value is NativeAttemptJournalState {
50:   exact(value, ['schemaVersion', 'identity', 'envelopeDigest', 'envelope', 'acceptedAt', 'reservationBytes', 'process', 'processCompletedAt', 'result']);
51:   if (value.schemaVersion !== 'native-attempt-journal.v1' || typeof value.acceptedAt !== 'string'
52:     || !Number.isFinite(Date.parse(value.acceptedAt)) || !Number.isSafeInteger(value.reservationBytes) || Number(value.reservationBytes) < 1) {
53:     throw new Error('WORKER_NATIVE_JOURNAL_STATE_INVALID');
54:   }
55:   identityValid(value.identity);
56:   blobReference(value.envelope);
57:   if (value.envelopeDigest !== (value.envelope as BlobReference).digest) throw new Error('WORKER_NATIVE_JOURNAL_ENVELOPE_DIGEST_INVALID');
58:   if (value.result !== null) blobReference(value.result);
59:   if (value.process !== null) {
60:     validateProcess(value.process);
61:     if (typeof value.processCompletedAt !== 'string' || !Number.isFinite(Date.parse(value.processCompletedAt))) throw new Error('WORKER_NATIVE_JOURNAL_COMPLETION_TIME_INVALID');
62:   } else if (value.processCompletedAt !== null) throw new Error('WORKER_NATIVE_JOURNAL_COMPLETION_TIME_INVALID');
63: }
64: 
65: function validateProcess(value: unknown): void {
66:   exact(value, ['schemaVersion', 'stdout', 'stderr', 'exitCode', 'signal', 'fault', 'resources']);
67:   if (value.schemaVersion !== 'worker-native-process-result.v1') throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_INVALID');
68:   blobReference(value.stdout); blobReference(value.stderr);
69:   validateNativeWorkerResourceObservation(value.resources);
70:   if (value.resources.populated) throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_NOT_QUIESCENT');
71:   if (value.exitCode !== null && (!Number.isInteger(value.exitCode) || Number(value.exitCode) < 0 || Number(value.exitCode) > 255)) throw new Error('WORKER_NATIVE_JOURNAL_EXIT_INVALID');
72:   if (value.exitCode !== 0 && value.fault === null) throw new Error('WORKER_NATIVE_JOURNAL_MISSING_PROCESS_FAILURE');
73:   for (const key of ['signal', 'fault']) {
74:     if (value[key] !== null && (typeof value[key] !== 'string' || value[key].length < 1 || value[key].length > nativeJournalMaximumDiagnosticUnits)) throw new Error('WORKER_NATIVE_JOURNAL_FAULT_INVALID');
75:   }
76: }
77: 
78: /** Count actual retained bytes, including crash leftovers, before new admission. */
79: export async function usedJournalBytes(root: string): Promise<number> {
80:   let total = 0;
81:   const pending = [root];
82:   while (pending.length) {
83:     const directory = pending.pop()!;
84:     for (const entry of await fs.readdir(directory, { withFileTypes: true })) {
85:       const file = path.join(directory, entry.name);
86:       if (entry.isDirectory()) { pending.push(file); continue; }
87:       if (!entry.isFile()) throw new Error('WORKER_NATIVE_JOURNAL_PATH_INVALID');
88:       total += await retainedFileSize(file);
89:       if (!Number.isSafeInteger(total)) throw new Error('WORKER_NATIVE_JOURNAL_CAPACITY_EXCEEDED');
90:     }
91:   }
92:   return total;
93: }
94: 
95: async function retainedFileSize(file: string): Promise<number> {
96:   try { return (await fs.lstat(file)).size; }
97:   catch (error) {
98:     // Atomic durable writes may unlink their temporary name during this scan.
99:     if ((error as NodeJS.ErrnoException).code === 'ENOENT') return 0;
100:     throw error;
101:   }
102: }

SOURCE skills/worker/core/worker/native-result.ts SHA256 11c8074a973fec8f764e64668e29c7d4907a5b9e605b6bad04cbfa0454d318bd
1: import { randomUUID } from 'node:crypto';
2: import { checkWorkerNativeResultBinding, initialWorkerNativeResourceAccounting, workerAttemptResultDigest, sha256Digest,
3:   type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
4: import { validateNativeWorkerResourceObservation, type NativeWorkerResourceObservation } from './native-resource-observation.ts';
5: import type { NativeWorkerProcessResult } from './native-worker-process.ts';
6: 
7: export function finalizeNativeWorkerResult(envelope: WorkerAttemptEnvelopeV3, process: NativeWorkerProcessResult,
8:   started: Date, completed: Date): WorkerAttemptResultV3 {
9:   const candidate = provisionalResult(envelope, process);
10:   const result = candidate.result ?? failedHostResult(envelope, started, completed, process.fault ?? candidate.fault!, false);
11:   if (!candidate.result) { result.exitCode = process.exitCode; result.signal = process.signal; }
12:   applyNativeObservation(result, process.resources);
13:   const fault = process.fault ?? (completed.getTime() >= Date.parse(envelope.claim.expiresAt) ? 'WORKER_CLAIM_EXPIRED' : null);
14:   if (fault && result.state === 'completed') {
15:     result.state = 'errored'; result.error = { code: fault, message: fault }; result.summary = fault;
16:     result.specialistResult = null; result.resources.resultBytes = 0;
17:   }
18:   result.startedAt = started.toISOString();
19:   result.completedAt = completed.toISOString();
20:   result.durationMs = Math.max(0, completed.getTime() - started.getTime());
21:   return sealResult(envelope, result);
22: }
23: 
24: export function interruptedNativeWorkerResult(envelope: WorkerAttemptEnvelopeV3, started: Date, code: string,
25:   observation: NativeWorkerResourceObservation | null, notLaunched: boolean): WorkerAttemptResultV3 {
26:   const result = failedHostResult(envelope, started, new Date(), code, notLaunched);
27:   if (observation !== null) applyNativeObservation(result, observation);
28:   return sealResult(envelope, result);
29: }
30: 
31: function applyNativeObservation(result: WorkerAttemptResultV3, observation: NativeWorkerResourceObservation): void {
32:   validateNativeWorkerResourceObservation(observation);
33:   if (observation.populated) throw new Error('WORKER_NATIVE_RESULT_SCOPE_POPULATED');
34:   result.resources.cpuTimeMs = Math.ceil(observation.cpuTimeMicroseconds / 1000);
35:   result.resources.maximumMemoryBytes = observation.maximumMemoryBytes;
36:   result.resources.maximumTasks = observation.maximumTasks;
37:   result.resourceAccounting.observations = {
38:     cpuTimeMs: { status: 'observed', value: result.resources.cpuTimeMs },
39:     maximumMemoryBytes: { status: 'observed', value: observation.maximumMemoryBytes },
40:     maximumTasks: { status: 'observed', value: observation.maximumTasks },
41:   };
42: }
43: 
44: function sealResult(envelope: WorkerAttemptEnvelopeV3, result: WorkerAttemptResultV3): WorkerAttemptResultV3 {
45:   result.resultDigest = workerAttemptResultDigest(result);
46:   const receiptId = `receipt:${randomUUID()}`;
47:   result.receipt = { receiptId, receiptDigest: sha256Digest({ namespace: 'native-worker', receiptId, resultDigest: result.resultDigest }) };
48:   const binding = checkWorkerNativeResultBinding(envelope, result);
49:   if (!binding.ok) throw new Error(`WORKER_NATIVE_FINAL_RESULT_INVALID:${binding.errors.join(';')}`);
50:   return result;
51: }
52: 
53: function provisionalResult(envelope: WorkerAttemptEnvelopeV3, process: NativeWorkerProcessResult): { result: WorkerAttemptResultV3 | null; fault: string | null } {
54:   try {
55:     const result = JSON.parse(Buffer.from(process.stdout).toString('utf8')) as WorkerAttemptResultV3;
56:     return checkWorkerNativeResultBinding(envelope, result).ok ? { result, fault: null }
57:       : { result: null, fault: 'WORKER_NATIVE_RESULT_BINDING_INVALID' };
58:   } catch (error) {
59:     if (!(error instanceof SyntaxError)) throw error;
60:     return { result: null, fault: 'WORKER_NATIVE_RESULT_INVALID_JSON' };
61:   }
62: }
63: 
64: function failedHostResult(envelope: WorkerAttemptEnvelopeV3, started: Date, completed: Date, code: string,
65:   notLaunched: boolean): WorkerAttemptResultV3 {
66:   return { schemaVersion: 'worker-attempt-result.v3', protocolVersion: envelope.protocolVersion, attemptId: envelope.attemptId,
67:     claimId: envelope.claim.claimId, claimGeneration: envelope.claim.generation, workerId: envelope.claim.workerId,
68:     profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest,
69:     state: 'errored', startedAt: started.toISOString(), completedAt: completed.toISOString(), durationMs: Math.max(0, completed.getTime() - started.getTime()),
70:     summary: code, specialistResult: null, error: { code, message: code }, evidence: [],
71:     resources: { logBytes: 0, resultBytes: 0, evidenceBytes: 0 },
72:     cleanup: notLaunched ? { state: 'not_required', summary: null }
73:       : { state: 'failed', summary: 'Native host has no validated specialist cleanup result; external effects require reconciliation' },
74:     exitCode: null, signal: null, resourceAccounting: initialWorkerNativeResourceAccounting(envelope),
75:     resultDigest: '', receipt: { receiptId: '', receiptDigest: '' },
76:   };
77: }

SOURCE skills/worker/core/worker/native-worker-process.ts SHA256 230bcb2eae21abc5d87187d682504155ef131a649b05f6662fb0d7a6db575182
1: import type { ChildProcessWithoutNullStreams } from 'node:child_process';
2: import type { NativeWorkerOwnership, NativeWorkerOwnershipLease } from './native-worker-ownership.ts';
3: import type { WorkerOwnershipIdentity } from './ownership-store.ts';
4: import type { NativeWorkerResourceObservation } from './native-resource-observation.ts';
5: import type { NativeWorkerOutputCapture } from './native-output-spool.ts';
6: import { cancelNativeProcess } from './native-process-cancellation.ts';
7: import { captureNativeWorkerOutput } from './native-process-output.ts';
8: import { validateNativeWorkerControlLimits } from './native-control-channel.ts';
9: import { startNativeProcessControl, type NativeWorkerProcessControl } from './native-process-control.ts';
10: 
11: export interface NativeWorkerProcessLimits {
12:   readonly cpuTimeMs: number;
13:   readonly memoryBytes: number;
14:   readonly tasks: number;
15:   readonly timeoutMs: number;
16:   readonly pollIntervalMs: number;
17:   readonly maximumInputBytes: number;
18:   readonly maximumOutputBytes: number;
19:   readonly closeTimeoutMs: number;
20: }
21: 
22: export interface NativeWorkerProcessOptions {
23:   readonly owner: NativeWorkerOwnership;
24:   readonly identity: WorkerOwnershipIdentity;
25:   readonly limits: NativeWorkerProcessLimits;
26:   readonly command: Parameters<NativeWorkerOwnershipLease['launch']>[0];
27:   readonly input: Uint8Array;
28:   readonly signal?: AbortSignal;
29:   readonly outputCapture?: NativeWorkerOutputCapture;
30:   readonly control?: NativeWorkerProcessControl;
31: }
32: 
33: export interface NativeWorkerProcessResult {
34:   readonly schemaVersion: 'worker-native-process-result.v1';
35:   readonly stdout: Uint8Array;
36:   readonly stderr: Uint8Array;
37:   readonly exitCode: number | null;
38:   readonly signal: string | null;
39:   readonly fault: string | null;
40:   readonly resources: NativeWorkerResourceObservation;
41: }
42: 
43: function validateLimits(limits: NativeWorkerProcessLimits): void {
44:   if (Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1)) {
45:     throw new Error('WORKER_NATIVE_PROCESS_LIMIT_INVALID');
46:   }
47:   for (const value of [limits.timeoutMs, limits.pollIntervalMs, limits.closeTimeoutMs]) {
48:     if (value > 2_147_483_647) throw new Error('WORKER_NATIVE_PROCESS_TIMER_INVALID');
49:   }
50: }
51: 
52: function budgetFault(observation: NativeWorkerResourceObservation, limits: NativeWorkerProcessLimits): string | null {
53:   if (observation.oomKills || observation.maximumMemoryBytes > limits.memoryBytes) return 'WORKER_MEMORY_LIMIT';
54:   if (observation.taskLimitHits || observation.maximumTasks > limits.tasks) return 'WORKER_TASK_LIMIT';
55:   if (observation.cpuTimeMicroseconds / 1000 > limits.cpuTimeMs) return 'WORKER_CPU_LIMIT';
56:   return null;
57: }
58: 
59: /** Entire trusted attempt host, including its completion I/O and every descendant. */
60: export async function runNativeWorkerProcess(options: NativeWorkerProcessOptions): Promise<NativeWorkerProcessResult> {
61:   const limits = { ...options.limits };
62:   const control = options.control ? { limits: { ...options.control.limits }, run: options.control.run } : undefined;
63:   validateLimits(limits);
64:   if (control) {
65:     validateNativeWorkerControlLimits(control.limits);
66:     if (typeof control.run !== 'function') throw new Error('WORKER_NATIVE_CONTROL_CONFIG_INVALID');
67:   }
68:   if (options.input.byteLength > limits.maximumInputBytes) throw new Error('WORKER_NATIVE_INPUT_LIMIT');
69:   const input = Buffer.from(options.input);
70:   const command = structuredClone(options.command);
71:   options.signal?.throwIfAborted();
72:   const lease = await options.owner.allocate(options.identity, { memoryBytes: limits.memoryBytes, tasks: limits.tasks });
73:   let child: ChildProcessWithoutNullStreams | undefined;
74:   try {
75:     options.signal?.throwIfAborted();
76:     child = await lease.launch(command, control !== undefined);
77:     return await collectProcess(child, lease, input, limits, options.signal, options.outputCapture, control);
78:   } finally {
79:     // Also stop a launcher interrupted before joining; it has no authority to start later.
80:     child?.kill('SIGKILL');
81:     await lease.finish();
82:   }
83: }
84: 
85: async function collectProcess(child: ChildProcessWithoutNullStreams, lease: NativeWorkerOwnershipLease,
86:   input: Buffer, limits: NativeWorkerProcessLimits, signal?: AbortSignal, outputCapture?: NativeWorkerOutputCapture,
87:   controlOptions?: NativeWorkerProcessControl): Promise<NativeWorkerProcessResult> {
88:   let fault: string | null = null;
89:   let closeTimer: NodeJS.Timeout | undefined;
90:   let closing: Promise<NativeWorkerResourceObservation> | undefined;
91:   let finish: () => void = () => {};
92:   const close = () => {
93:     child.kill('SIGKILL');
94:     closing ??= lease.finish();
95:     // The caller always observes this rejection after the child boundary settles.
96:     void closing.catch(() => {});
97:     closeTimer ??= setTimeout(() => {
98:       fault = 'WORKER_NATIVE_PROCESS_DRAIN_TIMEOUT';
99:       finish();
100:     }, limits.closeTimeoutMs);
101:   };
102:   const exited = new Promise<void>(resolve => { finish = resolve; });
103:   const stop = (code: string) => {
104:     fault ??= code;
105:     close();
106:   };
107:   const output = captureNativeWorkerOutput(child, limits.maximumOutputBytes, stop, outputCapture);
108:   const control = startNativeProcessControl(child, controlOptions, stop, limits.closeTimeoutMs, lease.launchAuthority());
109:   let disposeCancellation: (() => void) | undefined;
110:   const abort = () => {
111:     if (closing || disposeCancellation) return;
112:     fault ??= 'WORKER_ATTEMPT_CANCELLED';
113:     disposeCancellation = cancelNativeProcess(child, limits.closeTimeoutMs, close);
114:   };
115:   child.once('error', () => stop('WORKER_NATIVE_PROCESS_START_FAILED'));
116:   child.stdin.once('error', () => stop('WORKER_NATIVE_PROCESS_INPUT_FAILED'));
117:   child.once('exit', () => { close(); });
118:   child.once('close', finish);
119:   signal?.addEventListener('abort', abort, { once: true });
120:   const deadline = setTimeout(() => stop('WORKER_ATTEMPT_TIMEOUT'), limits.timeoutMs);
121:   const poll = setInterval(() => {
122:     if (closing) return;
123:     try { const code = budgetFault(lease.observe(), limits); if (code) stop(code); }
124:     catch { stop('WORKER_RESOURCE_MEASUREMENT_UNAVAILABLE'); }
125:   }, limits.pollIntervalMs);
126:   try {
127:     if (signal?.aborted) abort();
128:     else child.stdin.end(input);
129:     await exited;
130:     close();
131:     const resources = await closing!;
132:     await output.flush();
133:     await control.finish();
134:     fault ??= budgetFault(resources, limits);
135:     if (child.exitCode !== 0 && fault === null) fault = 'WORKER_NATIVE_PROCESS_FAILED';
136:     return { schemaVersion: 'worker-native-process-result.v1', ...output.snapshot(),
137:       exitCode: child.exitCode, signal: child.signalCode, fault, resources };
138:   } finally {
139:     clearTimeout(deadline); clearInterval(poll); if (closeTimer) clearTimeout(closeTimer);
140:     signal?.removeEventListener('abort', abort);
141:     disposeCancellation?.();
142:     child.stdin.destroy(); child.stdout.destroy(); child.stderr.destroy();
143:     await control.finish();
144:   }
145: }

SOURCE skills/worker/core/worker/phase-deadline.ts SHA256 13ead2817f0277f8bb7a45b09f42df228bc62e8a0d43e26eabbcbc4f2365e456
1: /** A timeout cannot kill JavaScript. Unsettled hooks remain explicitly unresolved. */
2: export class WorkerPhaseUnresolved extends Error {
3:   constructor(phase: string) { super(`WORKER_PHASE_UNRESOLVED:${phase}`); }
4: }
5: 
6: export class WorkerPhaseDeadline {
7:   #unresolved = false;
8:   readonly expiresAt: number;
9:   readonly timeoutMs: number;
10:   readonly now: () => number;
11:   readonly signal: AbortSignal | undefined;
12:   constructor(expiresAt: number, timeoutMs: number, now: () => number, signal?: AbortSignal) {
13:     this.expiresAt = expiresAt; this.timeoutMs = timeoutMs; this.now = now; this.signal = signal;
14:   }
15:   get unresolved(): boolean { return this.#unresolved; }
16:   quarantine(): void { this.#unresolved = true; }
17: 
18:   async run<T>(phase: string, work: (signal: AbortSignal) => Promise<T>, maintenance = false): Promise<T> {
19:     this.#assertStart(phase, maintenance);
20:     const controller = new AbortController();
21:     const end = maintenance ? this.now() + this.timeoutMs : Math.min(this.expiresAt, this.now() + this.timeoutMs);
22:     const abort = (): void => controller.abort(this.signal?.reason ?? new Error('WORKER_ATTEMPT_CANCELLED'));
23:     this.signal?.addEventListener('abort', abort, { once: true });
24:     let timer: NodeJS.Timeout | undefined;
25:     let settled = false;
26:     const operation = Promise.resolve().then(() => { controller.signal.throwIfAborted(); return work(controller.signal); });
27:     const settlement = operation.then(() => { settled = true; }, () => { settled = true; });
28:     const cancelled = new Promise<never>((_resolve, reject) => {
29:       controller.signal.addEventListener('abort', () => reject(controller.signal.reason), { once: true });
30:       timer = setTimeout(() => controller.abort(this.#timeoutError(phase, maintenance)), Math.max(1, end - this.now()));
31:     });
32:     try {
33:       const value = await Promise.race([operation, cancelled]);
34:       if (this.now() >= end) throw this.#timeoutError(phase, maintenance);
35:       return value;
36:     } catch (error) {
37:       controller.abort(error);
38:       if (!settled && !(await this.#drain(settlement))) { this.#unresolved = true; throw new WorkerPhaseUnresolved(phase); }
39:       if (maintenance && this.signal?.aborted && this.now() < end) return await operation;
40:       throw error;
41:     } finally {
42:       if (timer) clearTimeout(timer);
43:       this.signal?.removeEventListener('abort', abort);
44:       controller.abort(new Error(`${phase}_COMPLETE`));
45:     }
46:   }
47: 
48:   #assertStart(phase: string, maintenance: boolean): void {
49:     if (this.#unresolved) throw new WorkerPhaseUnresolved(phase);
50:     if (!maintenance && this.now() >= this.expiresAt) throw new Error('WORKER_CLAIM_EXPIRED');
51:     if (!maintenance && this.signal?.aborted) throw this.signal.reason ?? new Error('WORKER_ATTEMPT_CANCELLED');
52:   }
53:   #timeoutError(phase: string, maintenance: boolean): Error {
54:     return new Error(!maintenance && this.now() >= this.expiresAt ? 'WORKER_CLAIM_EXPIRED' : `${phase}_TIMEOUT`);
55:   }
56: 
57:   async #drain(settlement: Promise<void>): Promise<boolean> {
58:     let timer: NodeJS.Timeout | undefined;
59:     try { return await Promise.race([settlement.then(() => true), new Promise<boolean>(resolve => {
60:       timer = setTimeout(() => resolve(false), this.timeoutMs);
61:     })]); } finally { if (timer) clearTimeout(timer); }
62:   }
63: }
64: 
65: export async function settlesWithin(operation: Promise<unknown>, timeoutMs: number): Promise<boolean> {
66:   let timer: NodeJS.Timeout | undefined;
67:   try { return await Promise.race([operation.then(() => true, () => true), new Promise<boolean>(resolve => {
68:     timer = setTimeout(() => resolve(false), timeoutMs);
69:   })]); } finally { if (timer) clearTimeout(timer); }
70: }
71: 
72: export function armWorkerClaimDeadline(expiresAt: number, now: () => number, expire: () => void): () => void {
73:   let timer: NodeJS.Timeout | undefined;
74:   const schedule = (): void => {
75:     const remaining = expiresAt - now();
76:     if (remaining <= 0) { expire(); return; }
77:     timer = setTimeout(schedule, Math.min(remaining, 2_147_483_647));
78:   };
79:   schedule(); return () => { if (timer) clearTimeout(timer); };
80: }
