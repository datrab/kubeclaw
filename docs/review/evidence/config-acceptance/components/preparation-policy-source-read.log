SOURCE skills/buster/engine/test-gates/preparation-cleanup-execution.ts SHA256 7f68045db88cfea003fb204b06c61b5cef0d48ff0bb416fa060dceeb33249365
1: import { executeNativeWorkerAttempt, recoverNativeAttempt, verifyNativeSourceCleanupResult } from '@kubeclaw/worker-core';
2: import type { WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import type { PreparationCleanupAssociation } from './preparation-cleanup-binding.ts';
4: import type { PreparationExecutionOptions } from './preparation-execution.ts';
5: import { preparationCommand } from './preparation-command.ts';
6: import { preparationDigest } from './preparation-header.ts';
7: 
8: /** Existing predecessor recovery reuses Core's exact finalizer without launching or unfencing. */
9: export async function recoverPreparationCleanup(options: PreparationExecutionOptions,
10:   association: PreparationCleanupAssociation): Promise<WorkerAttemptResultV3 | null> {
11:   if (!await options.journal.hasAttempt(association.envelope)) return null;
12:   return options.journal.withAttempt(association.envelope, async context => {
13:     if (context.newlyAccepted) throw new Error('BUSTER_PREPARATION_CLEANUP_PREDECESSOR_MISSING');
14:     const cached = await options.journal.readResult(association.envelope);
15:     if (cached) return cached;
16:     const result = await recoverNativeAttempt(options.journal, options.owner, association.envelope,
17:       new Date(context.acceptedAt), false);
18:     if (!result) throw new Error('BUSTER_PREPARATION_CLEANUP_RECOVERY_REQUIRED');
19:     return options.journal.seal(association.envelope, result);
20:   });
21: }
22: 
23: /** Only this invocation's new cleanup may launch; a new failure keeps the owner fenced. */
24: export async function executePreparationCleanup(options: PreparationExecutionOptions,
25:   association: PreparationCleanupAssociation): Promise<WorkerAttemptResultV3> {
26:   const { envelope, settings, effects } = association;
27:   const command = preparationCommand(effects.admissionId, settings, options.command, effects.gate.preparationUid, 'cleanup');
28:   const encoded = JSON.stringify({ effects, settings });
29:   if (Buffer.byteLength(encoded) > settings.maximumInputBytes) throw new Error('BUSTER_PREPARATION_CLEANUP_INPUT_LIMIT');
30:   const result = await executeNativeWorkerAttempt({ envelope, journal: options.journal, process: {
31:     owner: options.owner,
32:     command: { ...command, environment: { ...command.environment, BUSTER_PREPARATION_ASSIGNED_CLEANUP: encoded } },
33:     limits: { cpuTimeMs: settings.resourcePolicy.cpuTimeMs, memoryBytes: settings.resourcePolicy.memoryBytes,
34:       tasks: settings.resourcePolicy.tasks, timeoutMs: settings.timeoutMs + 8 * settings.cleanupTimeoutMs,
35:       maximumInputBytes: settings.maximumInputBytes, maximumOutputBytes: settings.maximumOutputBytes,
36:       pollIntervalMs: settings.pollIntervalMs, closeTimeoutMs: settings.closeTimeoutMs },
37:   } });
38:   await options.ledger.recordCleanupResult(effects.admissionId, preparationDigest(envelope), result.resultDigest);
39:   await verifyNativeSourceCleanupResult(options.journal, options.owner, envelope);
40:   return result;
41: }

SOURCE skills/buster/engine/test-gates/preparation-cleanup-host.ts SHA256 0318f48456c8a36005e70c1272bcf63050b54d60b8cc252d1f902d2f1bb2d242
1: import fs from 'node:fs/promises';
2: import path from 'node:path';
3: import { WorkerAttemptExecutor, observeNativeWorkerResources, nativeSourceCleanupResultSchema,
4:   sha256Digest, type WorkerAttemptOperation } from '@kubeclaw/worker-core';
5: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
6: import { validateBusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
7: import { assertPreparationCleanupEffects, type PreparationCleanupEffects } from './preparation-cleanup-binding.ts';
8: import { preparationSourceDirectory } from './preparation-source.ts';
9: 
10: function assigned(name: string): string {
11:   const value = process.env[name];
12:   if (!value) throw new Error(`BUSTER_PREPARATION_ASSIGNED_ENV_REQUIRED:${name}`);
13:   return value;
14: }
15: 
16: async function readEnvelope(maximumBytes: number): Promise<WorkerAttemptEnvelopeV3> {
17:   const chunks: Buffer[] = [];
18:   let bytes = 0;
19:   for await (const chunk of process.stdin) {
20:     bytes += chunk.byteLength;
21:     if (bytes > maximumBytes) throw new Error('BUSTER_PREPARATION_ENVELOPE_LIMIT');
22:     chunks.push(Buffer.from(chunk));
23:   }
24:   const value: unknown = JSON.parse(Buffer.concat(chunks, bytes).toString('utf8'));
25:   validateWorkerResourceContractV3('workerAttemptEnvelope', value);
26:   return value as WorkerAttemptEnvelopeV3;
27: }
28: 
29: async function removeOwnedData(root: string, effects: PreparationCleanupEffects, signal: AbortSignal): Promise<void> {
30:   const directory = preparationSourceDirectory(root, effects.admissionId);
31:   const gate = path.dirname(directory);
32:   const stat = await fs.lstat(gate);
33:   if (!stat.isDirectory() || stat.uid !== 0 || stat.gid !== effects.gate.preparationUid
34:     || (stat.mode & 0o7777) !== 0o1770 || stat.dev !== effects.gate.device || stat.ino !== effects.gate.inode) {
35:     throw new Error('BUSTER_PREPARATION_CLEANUP_GATE_CHANGED');
36:   }
37:   let data;
38:   try { data = await fs.lstat(directory); }
39:   catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
40:   if (data) {
41:     if (!effects.data || !data.isDirectory() || data.dev !== effects.data.device
42:       || data.ino !== effects.data.inode || data.uid !== effects.data.uid) {
43:       throw new Error('BUSTER_PREPARATION_CLEANUP_SOURCE_CHANGED');
44:     }
45:     signal.throwIfAborted();
46:     await fs.rm(directory, { recursive: true });
47:   }
48:   // Absence is valid only under the durable association for this exact gate/effect.
49:   // The parent independently verifies the sealed result before removing its marker.
50:   const handle = await fs.open(gate, 'r');
51:   try { await handle.sync(); } finally { await handle.close(); }
52:   signal.throwIfAborted();
53: }
54: 
55: async function main(): Promise<void> {
56:   const maximumBytes = Number(assigned('BUSTER_PREPARATION_ASSIGNED_INPUT_BYTES'));
57:   if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 1) throw new Error('BUSTER_PREPARATION_ENVELOPE_LIMIT');
58:   const encoded = assigned('BUSTER_PREPARATION_ASSIGNED_CLEANUP');
59:   if (Buffer.byteLength(encoded) > maximumBytes) throw new Error('BUSTER_PREPARATION_ENVELOPE_LIMIT');
60:   const association = JSON.parse(encoded) as { effects: PreparationCleanupEffects; settings: unknown };
61:   if (Object.keys(association).sort().join(',') !== 'effects,settings') throw new Error('BUSTER_PREPARATION_CLEANUP_ASSOCIATION_INVALID');
62:   assertPreparationCleanupEffects(association.effects);
63:   validateBusterPreparationSettings(association.settings);
64:   const effects = association.effects;
65:   if (process.getuid?.() !== effects.gate.preparationUid || process.getgid?.() !== effects.gate.preparationUid) {
66:     throw new Error('BUSTER_PREPARATION_SLOT_INVALID');
67:   }
68:   const envelope = await readEnvelope(maximumBytes);
69:   if (envelope.operation.contractId !== 'kubeclaw.native-source-cleanup@1'
70:     || envelope.operation.values.effectsDigest !== sha256Digest(effects)) throw new Error('BUSTER_PREPARATION_CLEANUP_ASSOCIATION_INVALID');
71:   const cancellation = new AbortController();
72:   const cancel = () => cancellation.abort(new Error('BUSTER_PREPARATION_CANCELLED'));
73:   process.once('SIGINT', cancel);
74:   process.once('SIGTERM', cancel);
75:   let finished = false;
76:   const operation: WorkerAttemptOperation<WorkerAttemptEnvelopeV3> = {
77:     prepare() { return undefined; },
78:     async execute(context) {
79:       await removeOwnedData(assigned('BUSTER_PREPARATION_ASSIGNED_SOURCE_ROOT'), effects,
80:         AbortSignal.any([context.signal, cancellation.signal]));
81:       finished = true;
82:       return { summary: 'Owned unpublished source cleanup completed', evidence: [], exitCode: 0, signal: null,
83:         specialistResult: { ...nativeSourceCleanupResultSchema,
84:           values: { reconciliationDigest: sha256Digest(envelope.operation.values) } } };
85:     },
86:     async terminate() { cancel(); },
87:     async cleanup() { if (!finished) throw new Error('BUSTER_PREPARATION_SOURCE_RECONCILIATION_REQUIRED'); },
88:     async measure() {
89:       const resources = observeNativeWorkerResources(assigned('KUBECLAW_NATIVE_SCOPE'));
90:       return { cpuTimeMs: { status: 'observed', value: Math.ceil(resources.cpuTimeMicroseconds / 1000) },
91:         maximumMemoryBytes: { status: 'observed', value: resources.maximumMemoryBytes },
92:         maximumTasks: { status: 'observed', value: resources.maximumTasks } };
93:     },
94:   };
95:   try {
96:     const result = await new WorkerAttemptExecutor({ envelope, operation, signal: cancellation.signal,
97:       retainLogs: false, receiptNamespace: 'buster-source-cleanup-provisional' }).execute();
98:     process.stdout.write(JSON.stringify(result));
99:   } finally {
100:     process.removeListener('SIGINT', cancel);
101:     process.removeListener('SIGTERM', cancel);
102:   }
103: }
104: 
105: await main();

SOURCE skills/buster/engine/test-gates/preparation-cleanup-validation.ts SHA256 8cc3b8d59fb38bcb04b6549a05bb7c95f153f7f603405724f84a9385a45ce134
1: import { canonicalJson, validateWorkerResourceContractV3,
2:   type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { validateBusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
4: import { preparationDigest } from './preparation-header.ts';
5: import { assertPreparationCleanupEffects, type PreparationCleanupAssociation } from './preparation-cleanup-binding.ts';
6: import type { PreparationGateBinding } from './preparation-gate.ts';
7: 
8: function invalid(): never { throw new Error('BUSTER_PREPARATION_CLEANUP_ASSOCIATION_INVALID'); }
9: const digest = (value: unknown) => typeof value === 'string' && /^sha256:[a-f0-9]{64}$/u.test(value);
10: 
11: function validateAssociation(value: PreparationCleanupAssociation): void {
12:   if (!value || Object.keys(value).sort().join(',')
13:     !== 'effects,envelope,previousEnvelopeDigest,previousResultDigest,resultDigest,settings') invalid();
14:   assertPreparationCleanupEffects(value.effects);
15:   validateWorkerResourceContractV3('workerAttemptEnvelope', value.envelope);
16:   const settings = validateBusterPreparationSettings(value.settings);
17:   if ([value.envelope, value.settings].some(item => Buffer.byteLength(canonicalJson(item)) > settings.maximumInputBytes)) invalid();
18:   for (const item of [value.previousEnvelopeDigest, value.previousResultDigest, value.resultDigest]) {
19:     if (item !== null && !digest(item)) invalid();
20:   }
21:   const operation = value.envelope.operation;
22:   if (operation.contractId !== 'kubeclaw.native-source-cleanup@1'
23:     || operation.inputSchemaId !== 'native-source-cleanup-input.v1'
24:     || Object.keys(operation.values).sort().join(',') !== 'effectsDigest,reconciles'
25:     || operation.values.effectsDigest !== preparationDigest(value.effects)) invalid();
26: }
27: 
28: function validateOriginal(association: PreparationCleanupAssociation, original: WorkerAttemptEnvelopeV3): void {
29:   const reference = association.envelope.operation.values.reconciles as Record<string, unknown>;
30:   if (!reference || Object.keys(reference).sort().join(',') !== [
31:     'attemptId', 'attemptSpecDigest', 'claimGeneration', 'claimId', 'envelopeDigest',
32:     'profileDigest', 'receipt', 'resultDigest', 'workerId',
33:   ].sort().join(',')) invalid();
34:   const expected = { envelopeDigest: preparationDigest(original), attemptId: original.attemptId,
35:     attemptSpecDigest: original.attemptSpecDigest, profileDigest: original.profile.profileDigest,
36:     claimId: original.claim.claimId, claimGeneration: original.claim.generation, workerId: original.claim.workerId };
37:   if (Object.entries(expected).some(([key, value]) => reference[key] !== value) || !digest(reference.resultDigest)) invalid();
38:   const receipt = reference.receipt as Record<string, unknown>;
39:   if (!receipt || Object.keys(receipt).sort().join(',') !== 'receiptDigest,receiptId'
40:     || typeof receipt.receiptId !== 'string' || !digest(receipt.receiptDigest)) invalid();
41:   if (association.envelope.attemptId === original.attemptId
42:     || association.envelope.claim.claimId === original.claim.claimId) invalid();
43: }
44: 
45: /** This validates durable identity only; release additionally requires actual journal/owner verification. */
46: export function validatePreparationCleanupChain(value: readonly PreparationCleanupAssociation[],
47:   original: WorkerAttemptEnvelopeV3, gate: PreparationGateBinding | null): void {
48:   if (!Array.isArray(value)) invalid();
49:   let previous: PreparationCleanupAssociation | null = null;
50:   const attempts = new Set<string>();
51:   for (const association of value) {
52:     validateAssociation(association);
53:     validateOriginal(association, original);
54:     if (association.effects.originalEnvelopeDigest !== preparationDigest(original)
55:       || association.effects.admissionId !== original.operation.values.admissionId
56:       || preparationDigest(association.effects.gate) !== preparationDigest(gate)) invalid();
57:     if (association.previousEnvelopeDigest !== (previous ? preparationDigest(previous.envelope) : null)
58:       || association.previousResultDigest !== (previous?.resultDigest ?? null)) invalid();
59:     if (previous && (previous.resultDigest === null
60:       || preparationDigest(previous.effects) !== preparationDigest(association.effects))) invalid();
61:     if (attempts.has(association.envelope.attemptId)) invalid();
62:     attempts.add(association.envelope.attemptId);
63:     previous = association;
64:   }
65: }

