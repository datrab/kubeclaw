109:   } else if (item.parentInputId !== null) {
110:     if (phase.kind !== 'extract' || preparationDigest(phase.input) !== item.parentInputId) invalid();
111:   } else if (phase.kind !== 'stage') invalid();
112: }
113: 
114: function validateGate(item: SourceReservation): void {
115:   if (item.gate === null) return;
116:   if (Object.keys(item.gate).sort().join(',') !== 'device,inode,markerDigest,preparationUid'
117:     || item.gate.preparationUid !== item.slot || ![item.gate.device, item.gate.inode].every(nonnegative)
118:     || !digest(item.gate.markerDigest)) invalid();
119: }
120: 
121: function validateStagedReservation(item: SourceReservation): void {
122:   if (item.emptyGateResultDigest !== null && !digest(item.emptyGateResultDigest)) invalid();
123:   if (item.phase === 'empty-gate-reclaiming' && (!item.emptyGateResultDigest || !item.gate || item.source !== null)) invalid();
124:   if (item.input !== null) {
125:     assertStagedInput(item.input.input, item.input.job);
126:     if (item.input.input.admissionId !== item.admissionId || item.input.input.preparationUid !== item.slot
127:       || item.input.input.attemptSpecDigest !== item.attemptSpecDigest) invalid();
128:   }
129:   if (item.phase === 'retained-input' && (item.input === null || item.gate === null || !item.slotReleased)) invalid();
130: }
131: 
132: function validateAbsentHistoricalGroup(item: SourceReservation): void {
133:   if (item.groupMetadataBytes !== 0 || item.groupRecords !== 0 || item.groupReceiptDigest !== null
134:     || ['historical-reserved', 'retained-historical'].includes(item.phase)) invalid();
135: }
136: 
137: function validateHistoricalReservation(item: SourceReservation): void {
138:   if (item.groupReceiptDigest !== null && !digest(item.groupReceiptDigest)) invalid();
139:   if (item.historicalDescriptor === null) {
140:     validateAbsentHistoricalGroup(item);
141:     return;
142:   }
143:   assertHistoricalImportDescriptor(item.historicalDescriptor);
144:   if (item.input !== null || item.parentInputId !== null || item.source !== null) invalid();
145:   if (item.phase === 'retained-historical' && (!item.gate || !item.groupReceiptDigest || !item.slotReleased)) invalid();
146:   if (!['historical-reserved', 'retained-historical', 'released'].includes(item.phase)) invalid();
147: }
148: 
149: function validateReleasedCapacity(item: SourceReservation): void {
150:   if (item.phase === 'released') {
151:     if (item.bytes !== 0 || item.entries !== 0 || !item.slotReleased) invalid();
152:     if (item.emptyGateResultDigest === null && !item.cleanup.at(-1)?.resultDigest) invalid();
153:   } else if (item.bytes < 1 || item.entries < 1) invalid();
154: }
155: 
156: function validateExtractionSourceBinding(item: SourceReservation): void {
157:   if (item.source === null) return;
158:   const phase = item.envelope.operation.values.phase as { input?: BusterInputReference };
159:   const input = phase.input;
160:   if (!input || item.source.jobId !== input.jobId || item.source.requestDigest !== input.requestDigest
161:     || item.source.headerDigest !== input.headerDigest) invalid();
162: }
163: 
164: function validateSourceReservation(item: SourceReservation): void {
165:   if (item.source !== null) {
166:     assertPreparedSourceShape(item.source);
167:     if (item.source.admissionId !== item.admissionId || item.source.attemptSpecDigest !== item.attemptSpecDigest
168:       || item.source.preparationUid !== item.slot || item.parentInputId === null) invalid();
169:   }
170:   if (item.phase === 'reserved' && item.source !== null) invalid();
171:   if (['prepared', 'published', 'repository-released'].includes(item.phase) && (item.source === null || item.gate === null)) invalid();
172:   validateReleasedCapacity(item);
173: }
174: 
175: 
176: function validateExtractionGeneration(item: SourceReservation, byEnvelope: ReadonlyMap<string, SourceReservation>,
177:   generations: Set<string>): void {
178:   if (item.parentInputId === null) {
179:     if (item.extractionGeneration !== 0 || item.previousExtractionDigest !== null) invalid();
180:     return;
181:   }
182:   if (!Number.isSafeInteger(item.extractionGeneration) || item.extractionGeneration < 1) invalid();
183:   const key = `${item.parentInputId}:${item.extractionGeneration}`;
184:   if (generations.has(key)) invalid();
185:   generations.add(key);
186:   if (item.extractionGeneration === 1) {
187:     if (item.previousExtractionDigest !== null) invalid();
188:     return;
189:   }
190:   if (!digest(item.previousExtractionDigest)) invalid();
191:   const previous = byEnvelope.get(item.previousExtractionDigest!);
192:   if (!previous || previous.phase !== 'released' || previous.parentInputId !== item.parentInputId
193:     || previous.extractionGeneration + 1 !== item.extractionGeneration) invalid();
194: }
195: 
196: function validateUniqueReservation(item: SourceReservation, identities: Set<string>,
197:   occupied: Set<number>, inputs: Set<string>): void {
198:   if (identities.has(item.admissionId) || (!item.slotReleased && occupied.has(item.slot))
199:     || (item.parentInputId !== null && item.phase !== 'released' && inputs.has(item.parentInputId))) invalid();
200:   identities.add(item.admissionId);
201:   if (!item.slotReleased) occupied.add(item.slot);
202:   if (item.parentInputId !== null && item.phase !== 'released') inputs.add(item.parentInputId);
203: }
204: 
205: export function validateSourceLedger(state: SourceLedger): void {
206:   if (!state || state.schemaVersion !== empty.schemaVersion || Object.keys(state).sort().join(',') !== 'reservations,schemaVersion'
207:     || !Array.isArray(state.reservations)) invalid();
208:   const identities = new Set<string>();
209:   const occupied = new Set<number>();
210:   const inputs = new Set<string>();
211:   for (const item of state.reservations) {
212:     validateReservationShape(item);
213:     validateReservationEnvelope(item);
214:     validateGate(item);
215:     validatePreparationCleanupChain(item.cleanup, item.envelope, item.gate);
216:     validateStagedReservation(item);
217:     validateHistoricalReservation(item);
218:     validateSourceReservation(item);
219:     validateExtractionSourceBinding(item);
220:     validateUniqueReservation(item, identities, occupied, inputs);
221:   }
222:   const byEnvelope = new Map(state.reservations.map(item => [preparationDigest(item.envelope), item]));
223:   const generations = new Set<string>();
224:   for (const item of state.reservations) validateExtractionGeneration(item, byEnvelope, generations);
225: }

