410:       const remainingExecutionMs = timeoutAt - preparedAt;
411:       if (claimExpiresAt - preparedAt < remainingExecutionMs + (completionPhases * envelope.limits.cleanupTimeoutMs)) {
412:         throw new AttemptFault('interrupted', 'WORKER_CLAIM_WINDOW_INSUFFICIENT');
413:       }
414:       if (controller.signal.aborted) await cancellation;
415:       operationWork = operation.execute({ attempt: envelope, signal: controller.signal, log });
416:       operationResult = await Promise.race([operationWork, cancellation]);
417:       const operationCompletedAt = this.#now().getTime();
