88:     'groupMetadataBytes', 'groupReceiptDigest', 'groupRecords', 'historicalDescriptor', 'input', 'parentInputId',
89:     'phase', 'previousExtractionDigest', 'slot', 'slotReleased', 'source'];
90:   if (!item || Object.keys(item).sort().join(',') !== keys.sort().join(',')
91:     || typeof item.admissionId !== 'string' || !/^[a-f0-9]{32}$/u.test(item.admissionId) || !digest(item.attemptSpecDigest)
