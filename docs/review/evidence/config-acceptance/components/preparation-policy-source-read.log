4: import type { PreparationGateBinding } from './preparation-gate.ts';
5: 
6: export interface PreparationCleanupEffects {
7:   readonly schemaVersion: 'buster-preparation-cleanup-effects.v1';
8:   readonly admissionId: string;
9:   readonly originalEnvelopeDigest: string;
10:   readonly gate: PreparationGateBinding;
11:   readonly data: { readonly device: number; readonly inode: number; readonly uid: number } | null;
12: }
13: 
14: /** Every retry keeps its immutable predecessor identity; no receipt is replaced. */
15: export interface PreparationCleanupAssociation {
16:   readonly envelope: WorkerAttemptEnvelopeV3;
17:   readonly settings: BusterPreparationSettings;
18:   readonly effects: PreparationCleanupEffects;
19:   readonly previousEnvelopeDigest: string | null;
20:   readonly previousResultDigest: string | null;
21:   readonly resultDigest: string | null;
22: }
23: 
24: /** Journal admission independently enforces this complete serialized-envelope ceiling. */
25: export function preparationCleanupMetadataCapacity(maximumInputBytes: number): number {
26:   const digest = `sha256:${'f'.repeat(64)}`;
27:   const maximum = {
28:     envelope: null, settings: null,
29:     effects: { schemaVersion: 'buster-preparation-cleanup-effects.v1', admissionId: 'f'.repeat(32),
30:       originalEnvelopeDigest: digest,
31:       gate: { preparationUid: 1004, device: Number.MAX_SAFE_INTEGER, inode: Number.MAX_SAFE_INTEGER, markerDigest: digest },
32:       data: { device: Number.MAX_SAFE_INTEGER, inode: Number.MAX_SAFE_INTEGER, uid: 1004 } },
33:     previousEnvelopeDigest: digest, previousResultDigest: digest, resultDigest: digest,
34:   };
35:   // Both the complete envelope and its execution-settings snapshot are bounded by maximumInputBytes.
36:   const bytes = 2 * maximumInputBytes + Buffer.byteLength(canonicalJson(maximum)) - 8 + 1;
37:   if (!Number.isSafeInteger(bytes)) throw new Error('BUSTER_PREPARATION_CLEANUP_CAPACITY_INVALID');
38:   return bytes;
39: }
40: 
41: export function assertPreparationCleanupEffects(value: unknown): asserts value is PreparationCleanupEffects {
42:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('BUSTER_PREPARATION_CLEANUP_EFFECTS_INVALID');
43:   const effects = value as PreparationCleanupEffects;
44:   if (Object.keys(effects).sort().join(',') !== 'admissionId,data,gate,originalEnvelopeDigest,schemaVersion'
45:     || effects.schemaVersion !== 'buster-preparation-cleanup-effects.v1'
46:     || typeof effects.admissionId !== 'string' || !/^[a-f0-9]{32}$/u.test(effects.admissionId)
47:     || typeof effects.originalEnvelopeDigest !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(effects.originalEnvelopeDigest)) {
48:     throw new Error('BUSTER_PREPARATION_CLEANUP_EFFECTS_INVALID');
49:   }
50:   assertGateEffect(effects.gate);
51:   assertDataEffect(effects.data, effects.gate.preparationUid);
52: } 
53: 
54: function assertGateEffect(gate: PreparationGateBinding): void {
55:   const integer = (item: unknown) => typeof item === 'number' && Number.isSafeInteger(item) && item >= 0;
56:   if (!gate || Object.keys(gate).sort().join(',') !== 'device,inode,markerDigest,preparationUid'
57:     || ![1003, 1004].includes(gate.preparationUid)
58:     || ![gate.device, gate.inode].every(integer)
59:     || typeof gate.markerDigest !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(gate.markerDigest)) {
60:     throw new Error('BUSTER_PREPARATION_CLEANUP_EFFECTS_INVALID');
61:   }
62: }
63: 
64: function assertDataEffect(data: PreparationCleanupEffects['data'], uid: number): void {
65:   if (data === null) return;
66:   const integer = (item: unknown) => typeof item === 'number' && Number.isSafeInteger(item) && item >= 0;
67:   if (!data || Object.keys(data).sort().join(',') !== 'device,inode,uid'
68:     || ![data.device, data.inode].every(integer) || data.uid !== uid) {
69:     throw new Error('BUSTER_PREPARATION_CLEANUP_EFFECTS_INVALID');
70:   }
71: }

