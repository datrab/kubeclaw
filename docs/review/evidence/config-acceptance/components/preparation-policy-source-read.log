205: /** The host validates the immutable settings carried by its accepted envelope. */
206: export function validateBusterPreparationSettings(value: unknown): BusterPreparationSettings {
207:   validateComponentSettings('buster-preparation', value, 'SWARM_CONFIG_BUSTER_PREPARATION_INVALID');
208:   const settings = value as BusterPreparationSettings;
209:   for (const bytes of [settings.maximumRequestBytes, settings.maximumArchiveBytes, settings.maximumHeaderBytes,
210:     settings.maximumInputBytes, settings.maximumOutputBytes, settings.maximumResultBytes]) {
211:     if (bytes > 2_147_483_647) throw new Error('SWARM_CONFIG_BUSTER_BUFFER_LIMIT_INVALID');
212:   }
213:   if (settings.maximumArchiveBytes > settings.maximumRequestBytes
214:     || settings.maximumHeaderBytes >= settings.maximumMetadataBytes
215:     || settings.maximumInputBytes > settings.maximumJournalBytes
216:     || settings.maximumResultBytes + 4 * settings.maximumInputBytes > settings.maximumOutputBytes
217:     || settings.maximumHeaderBytes + 4 * settings.maximumInputBytes > settings.maximumResultBytes
218:     || settings.maximumOutputBytes > settings.maximumJournalBytes) {
219:     throw new Error('SWARM_CONFIG_BUSTER_STORAGE_BUDGET_INVALID');
220:   }
221:   validateBusterSourceReservation(settings);
222:   if (settings.closeTimeoutMs <= settings.drainTimeoutMs) throw new Error('SWARM_CONFIG_BUSTER_CLOSE_BUDGET_INVALID');
223:   if (!Number.isSafeInteger(settings.maximumRequestBytes + settings.maximumArchiveBytes + settings.maximumExtractedBytes)
224:     || settings.maximumRequestBytes + settings.maximumArchiveBytes + settings.maximumExtractedBytes > settings.maximumSourceBytes) {
225:     throw new Error('SWARM_CONFIG_BUSTER_SOURCE_RESERVATION_INVALID');
226:   }
227:   return Object.freeze({ ...settings, resourcePolicy: Object.freeze({ ...settings.resourcePolicy }) });
228: }
229: 
230: function validateBusterSourceReservation(settings: BusterPreparationSettings): void {
231:   const sourceReservation = settings.maximumRequestBytes + settings.maximumArchiveBytes + settings.maximumExtractedBytes
232:     + settings.maximumHeaderBytes + (settings.maximumArchiveEntries + 7) * settings.sourceEntryReservationBytes;
233:   if (!Number.isSafeInteger(sourceReservation) || sourceReservation > settings.maximumSourceBytes
234:     || settings.maximumArchiveEntries + 7 > settings.maximumSourceEntries) throw new Error('SWARM_CONFIG_BUSTER_SOURCE_RESERVATION_INVALID');
235: }
