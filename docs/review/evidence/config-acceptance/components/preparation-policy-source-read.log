14: async function sourceEffects(options: PreparationExecutionOptions, record: SourceReservation): Promise<PreparationCleanupEffects> {
15:   if (!record.gate || record.slotReleased || !['staging', 'reserved'].includes(record.phase)) {
16:     throw new Error('BUSTER_PREPARATION_CLEANUP_INELIGIBLE');
17:   }
18:   await verifyPreparationGate(options.command.sourceRoot, record.admissionId, record.gate);
19:   let data = null;
