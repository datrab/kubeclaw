398:       const preparedAt = this.#now().getTime();
399:       const queueDeadlineAt = Date.parse(envelope.queueDeadline);
400:       const firstDeadlineAt = Math.min(queueDeadlineAt, timeoutAt, claimExpiresAt);
401:       if (preparedAt >= firstDeadlineAt) {
402:         if (queueDeadlineAt === firstDeadlineAt) {
403:           throw new AttemptFault('interrupted', 'WORKER_QUEUE_DEADLINE_EXPIRED');
404:         }
405:         claimExpired = claimExpiresAt === firstDeadlineAt;
406:         timedOut = timeoutAt === firstDeadlineAt && !claimExpired;
407:         controller.abort(new Error(claimExpired ? 'WORKER_CLAIM_EXPIRED' : 'WORKER_ATTEMPT_TIMEOUT'));
408:         await cancellation;
