474:       const finalPart = freeze({
475:         schemaVersion: 'worker-log-part.v1' as const,
476:         protocolVersion: envelope.protocolVersion,
477:         attemptId: envelope.attemptId,
478:         claimId: envelope.claim.claimId,
479:         claimGeneration: envelope.claim.generation,
