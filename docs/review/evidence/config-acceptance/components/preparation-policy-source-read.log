7: 
8: export interface PreparationCommandConfig {
9:   readonly launcher: string;
10:   readonly sourceRoot: string;
11:   readonly cgroupRoot: string;
12:   readonly tarExecutable: string;
13:   readonly trustedSourceAuthority: string;
14:   readonly sourceAttestationPublicKey: string;
15: }
16: 
17: /** Immutable image entrypoints, fixed identity and own-gate filesystem authority. */
18: export function preparationCommand(admissionId: string, settings: BusterPreparationSettings,
19:   config: PreparationCommandConfig, preparationUid: PreparationSlot, phase: 'prepare' | 'historical' | 'cleanup' = 'prepare') {
20:   assertPreparationSlot(preparationUid);
21:   const directory = preparationSourceDirectory(config.sourceRoot, admissionId);
22:   const gate = path.dirname(directory);
23:   const sandbox = fileURLToPath(new URL('../../../common/plugin-runtime/foundation/isolation/plugin-sandbox', import.meta.url));
24:   const hostFiles = { prepare: './preparation-host.ts', historical: './preparation-historical-host.ts',
25:     cleanup: './preparation-cleanup-host.ts' } as const;
26:   const host = fileURLToPath(new URL(hostFiles[phase], import.meta.url));
27:   const app = fileURLToPath(new URL('../../../../', import.meta.url));
28:   const readRoots = [app, '/usr', '/lib', '/lib64', '/etc/ssl', '/proc', config.cgroupRoot]
29:     .filter(root => fs.existsSync(root));
30:   if (!readRoots.includes(config.cgroupRoot)) throw new Error('BUSTER_PREPARATION_CGROUP_ROOT_MISSING');
31:   for (const root of readRoots) {
32:     const real = fs.realpathSync(root);
33:     if (real === config.sourceRoot || config.sourceRoot.startsWith(`${real}${path.sep}`)) {
34:       throw new Error('BUSTER_PREPARATION_SOURCE_ANCESTOR_READ_FORBIDDEN');
35:     }
36:   }
37:   return { launcher: config.launcher, uid: preparationUid, gid: preparationUid, executable: sandbox,
38:     arguments: [String(settings.resourcePolicy.memoryBytes), String(Math.max(1, Math.ceil(settings.resourcePolicy.cpuTimeMs / 1000))),
39:       String(settings.maximumOpenFiles), ...readRoots.flatMap(root => ['--read-root', root]),
40:       '--write-root', gate, process.execPath, host],
41:     cwd: gate,
42:     environment: {
43:       PATH: '/usr/local/bin:/usr/bin:/bin', HOME: gate, TMPDIR: gate, NODE_ENV: 'production',
44:       BUSTER_PREPARATION_ASSIGNED_INPUT_BYTES: String(settings.maximumInputBytes),
45:       BUSTER_PREPARATION_ASSIGNED_SOURCE_ROOT: config.sourceRoot,
46:       BUSTER_PREPARATION_ASSIGNED_TAR: config.tarExecutable,
47:       BUSTER_PREPARATION_ASSIGNED_SOURCE_AUTHORITY: config.trustedSourceAuthority,
48:       BUSTER_PREPARATION_ASSIGNED_SOURCE_PUBLIC_KEY: config.sourceAttestationPublicKey,
49:     },
50:   };
51: }

SOURCE skills/buster/engine/test-gates/preparation-envelope.ts SHA256 90112c33cc7ecd6f4c237e3234bb7ba9abc8cf07e17aa9deb882ffc5afdb17df
1: import type { HistoricalImportDescriptor } from './preparation-historical-reference.ts';
2: import type { WorkerAttemptEnvelopeV3, WorkerProfileV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { validateWorkerResourceContractV3 } from '@kubeclaw/pipeline-worker-core-contract';
4: import { sha256Digest, workerAttemptSpecDigest, workerProfileDigest } from '@kubeclaw/worker-core';
5: import { assertPreparationSlot, type PreparationSlot } from './preparation-slots.ts';
6: import type { BusterInputReference } from './preparation-input.ts';
7: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
8: 
9: export function preparationProfile(engineContentDigest: string): WorkerProfileV3 {
10:   if (!/^sha256:[a-f0-9]{64}$/u.test(engineContentDigest)) throw new Error('BUSTER_PREPARATION_ENGINE_IDENTITY_REQUIRED');
11:   const profile = {
12:     schemaVersion: 'worker-profile.v3' as const,
13:     profileId: 'buster-native-preparation-v1', workerType: 'buster',
14:     coreContractId: 'kubeclaw.pipeline-worker-core@1',
15:     engine: { engineId: 'buster-native-preparation', contractId: 'kubeclaw.buster-preparation@1',
16:       engineVersion: '1.0.0', contentDigest: engineContentDigest },
17:     resourceCapabilities: {
18:       schemaVersion: 'worker-resource-capabilities.v2' as const,
19:       cpuTimeMs: { scope: 'native-attempt-tree' as const, unit: 'milliseconds' as const, measurement: 'measured' as const },
20:       maximumMemoryBytes: { scope: 'native-attempt-tree' as const, unit: 'bytes' as const, measurement: 'measured' as const },
21:       maximumTasks: { scope: 'native-attempt-tree' as const, unit: 'linux-tasks' as const, measurement: 'measured' as const },
22:     },
23:     capabilities: [],
24:   };
25:   return { ...profile, profileDigest: workerProfileDigest(profile) };
26: }
27: 
28: export type PreparationPhase = { readonly kind: 'historical'; readonly descriptor: HistoricalImportDescriptor }
29:   | { readonly kind: 'stage' }
30:   | { readonly kind: 'extract'; readonly input: BusterInputReference };
31: 
32: /** Parent-generated upload identity is durable before any request bytes reach the host. */
33: export function preparationEnvelope(admissionId: string, profile: WorkerProfileV3,
34:   settings: BusterPreparationSettings, now: Date, preparationUid: PreparationSlot, phase: PreparationPhase): WorkerAttemptEnvelopeV3 {
35:   if (!/^[a-f0-9]{32}$/u.test(admissionId)) throw new Error('BUSTER_PREPARATION_ADMISSION_ID_INVALID');
36:   assertPreparationSlot(preparationUid);
37:   const issuedAt = now.toISOString();
38:   const expiresAt = new Date(now.getTime() + settings.timeoutMs + 8 * settings.cleanupTimeoutMs).toISOString();
39:   const attemptId = `prepare-${admissionId}`;
40:   const unsigned = {
41:     schemaVersion: 'worker-attempt-envelope.v3' as const, protocolVersion: 'worker-protocol.v1' as const,
42:     pipelineRunId: attemptId, moduleId: null, gateId: null, planId: attemptId,
43:     nodeId: 'prepare-source', executionId: attemptId, attemptId, attemptNumber: 1,
44:     claim: { schemaVersion: 'attempt-claim.v1' as const, claimId: `claim-${admissionId}`, attemptId,
45:       generation: 1, workerId: 'buster-preparation', claimedAt: issuedAt, expiresAt },
46:     profile, packages: [], grantedCapabilities: [],
47:     limits: { timeoutMs: settings.timeoutMs, cleanupTimeoutMs: settings.cleanupTimeoutMs,
48:       logBytes: 1, resultBytes: settings.maximumResultBytes,
49:       evidenceBytes: 1, evidenceFiles: 1 },
50:     resourceBudgets: {
51:       schemaVersion: 'worker-resource-budgets.v2' as const,
52:       cpuTimeMs: { state: 'requested' as const, limit: settings.resourcePolicy.cpuTimeMs },
53:       maximumMemoryBytes: { state: 'requested' as const, limit: settings.resourcePolicy.memoryBytes },
54:       maximumTasks: { state: 'requested' as const, limit: settings.resourcePolicy.tasks },
55:     },
56:     inputs: [],
57:     operation: { contractId: 'kubeclaw.buster-preparation@1', inputSchemaId: 'buster-preparation-input.v1',
58:       inputSchemaDigest: sha256Digest({ schemaVersion: 'buster-preparation-input.v1', fields: ['admissionId', 'settings', 'preparationUid', 'phase'] }),
59:       values: { admissionId, preparationUid, settings: JSON.parse(JSON.stringify(settings)),
60:         phase: JSON.parse(JSON.stringify(phase)) } },
61:     cancellationId: `cancel-${admissionId}`, issuedAt, queueDeadline: expiresAt,
62:   };
63:   const envelope = { ...unsigned, attemptSpecDigest: workerAttemptSpecDigest(unsigned) };
64:   validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
65:   return envelope;
66: }

SOURCE skills/buster/engine/test-gates/preparation-execution.ts SHA256 e23033bcf78d19dfada0a25d7cffc9ba8133b97b686ffba24b362c601c8a6e93
1: import { randomBytes } from 'node:crypto';
2: import type { NativeAttemptJournal, NativeWorkerOwnership } from '@kubeclaw/worker-core';
3: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
4: import { preparationDigest, type PreparedPlanJob } from './preparation-header.ts';
5: import { assertStagedInput, type StagedAdmission } from './preparation-input.ts';
6: import { preparationProfile } from './preparation-envelope.ts';
7: import type { PreparationCommandConfig } from './preparation-command.ts';
8: import { createPreparationGate, retainPreparationGate, removeEmptyPreparationGate } from './preparation-gate.ts';
9: import { decodePreparationMessage, encodePreparationMessage, type PreparationIngress } from './preparation-channel.ts';
10: import type { PreparationSourceLedger } from './preparation-ledger.ts';
11: import { runPreparationPhase } from './preparation-native-phase.ts';
12: 
13: export interface PreparationExecutionOptions {
14:   readonly owner: NativeWorkerOwnership;
15:   readonly journal: NativeAttemptJournal;
16:   readonly ledger: PreparationSourceLedger;
17:   readonly settings: BusterPreparationSettings;
18:   readonly command: PreparationCommandConfig;
19:   readonly engineContentDigest: string;
20: }
21: 
22: /** A positive result means the original wire is durable and its native writer is quiescent. */
23: export async function executeBusterPreparation(options: PreparationExecutionOptions,
24:   ingress: PreparationIngress, signal: AbortSignal,
25:   admit: (job: PreparedPlanJob) => Promise<boolean>): Promise<StagedAdmission | null> {
26:   const { ledger } = options;
27:   const admissionId = randomBytes(16).toString('hex');
28:   const envelope = await ledger.reserve(admissionId, preparationProfile(options.engineContentDigest), new Date());
29:   const gate = await createPreparationGate(options.command.sourceRoot, admissionId, envelope);
30:   await ledger.bindGate(admissionId, gate);
31:   let permitted: StagedAdmission | undefined;
32:   const result = await runPreparationPhase(options, envelope, signal, async (channel, cancelled) => {
33:     const stop = () => ingress.fail(cancelled.reason);
34:     cancelled.addEventListener('abort', stop, { once: true });
35:     try {
36:       if (cancelled.aborted) stop();
37:       for await (const chunk of ingress.chunks()) await channel.send(encodePreparationMessage('bytes', admissionId, chunk));
38:       await channel.send(encodePreparationMessage('end', admissionId));
39:       const reader = channel.messages()[Symbol.asyncIterator]();
40:       const reply = await reader.next();
41:       if (reply.done) throw new Error('BUSTER_PREPARATION_VALIDATION_MISSING');
42:       const message = decodePreparationMessage(reply.value);
43:       if (message.kind !== 'validated' || message.admissionId !== admissionId) {
44:         throw new Error('BUSTER_PREPARATION_VALIDATION_INVALID');
45:       }
46:       const staged = JSON.parse(message.content.toString('utf8')) as StagedAdmission;
47:       assertStagedInput(staged.input, staged.job);
48:       if (staged.input.admissionId !== admissionId || staged.input.attemptSpecDigest !== envelope.attemptSpecDigest
49:         || staged.input.preparationUid !== envelope.operation.values.preparationUid) {
50:         throw new Error('BUSTER_PREPARATION_RESULT_IDENTITY_INVALID');
51:       }
52:       if (await admit(structuredClone(staged.job))) {
53:         await ledger.stageInput(staged);
54:         permitted = staged;
55:       }
56:       await channel.send(encodePreparationMessage(permitted ? 'proceed' : 'decline', admissionId));
57:     } finally { cancelled.removeEventListener('abort', stop); }
58:   });
59:   if (!permitted) {
60:     if (result.specialistResult?.schemaId !== 'buster-declined-input-result.v1'
61:       || preparationDigest(result.specialistResult.values) !== preparationDigest({ declined: true })) {
62:       throw new Error('BUSTER_PREPARATION_DECLINE_INVALID');
63:     }
64:     await ledger.beginEmptyGateReclaim(admissionId, preparationDigest(result));
65:     await removeEmptyPreparationGate(options.command.sourceRoot, admissionId, gate);
66:     await ledger.released(admissionId);
67:     return null;
68:   }
69:   if (result.specialistResult?.schemaId !== 'buster-staged-input-result.v1'
70:     || preparationDigest(result.specialistResult.values) !== preparationDigest(permitted)) {
71:     throw new Error('BUSTER_PREPARATION_RESULT_IDENTITY_INVALID');
72:   }
73:   await retainPreparationGate(options.command.sourceRoot, admissionId, gate);
74:   await ledger.retainInput(permitted);
75:   return permitted;
76: }

SOURCE skills/buster/engine/test-gates/preparation-gate.ts SHA256 7f3cb9aa8100a003713195cf3149f9097ea5f0cec18779e8deca92a0d2d894d7
1: import { assertPreparationSlot, type PreparationSlot } from './preparation-slots.ts';
2: import fs from 'node:fs/promises';
3: import path from 'node:path';
4: import type { WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
5: import { preparationSourceDirectory } from './preparation-source.ts';
6: import { preparationDigest } from './preparation-header.ts';
7: 
8: export interface PreparationGateBinding {
9:   readonly preparationUid: PreparationSlot;
10:   readonly device: number;
11:   readonly inode: number;
12:   readonly markerDigest: string;
13: }
14: 
15: async function syncDirectory(directory: string): Promise<void> {
16:   const handle = await fs.open(directory, 'r');
17:   try { await handle.sync(); } finally { await handle.close(); }
18: }
19: 
20: /** An existing directory is never adopted after an exclusive-create failure. */
21: export async function createPreparationGate(sourceRoot: string, admissionId: string,
22:   envelope: WorkerAttemptEnvelopeV3): Promise<PreparationGateBinding> {
23:   const preparationUid = envelope.operation.values.preparationUid;
24:   assertPreparationSlot(preparationUid);
25:   const gate = path.dirname(preparationSourceDirectory(sourceRoot, admissionId));
26:   await fs.mkdir(gate, { mode: 0o1770 });
27:   await fs.chown(gate, 0, preparationUid);
28:   await fs.chmod(gate, 0o1770);
29:   const marker = Buffer.from(JSON.stringify({ schemaVersion: 'buster-preparation-gate.v1',
30:     admissionId, envelopeDigest: preparationDigest(envelope) }));
31:   const handle = await fs.open(path.join(gate, 'gate.json'), 'wx', 0o400);
32:   try { await handle.writeFile(marker); await handle.sync(); } finally { await handle.close(); }
33:   await syncDirectory(gate);
34:   await syncDirectory(sourceRoot);
35:   const stat = await fs.lstat(gate);
36:   return { preparationUid, device: stat.dev, inode: stat.ino, markerDigest: preparationDigest(JSON.parse(marker.toString('utf8'))) };
37: }
38: 
39: export async function verifyPreparationGate(sourceRoot: string, admissionId: string,
40:   binding: PreparationGateBinding): Promise<string> {
41:   const gate = path.dirname(preparationSourceDirectory(sourceRoot, admissionId));
42:   const stat = await fs.lstat(gate);
43:   if (!stat.isDirectory() || stat.uid !== 0 || stat.dev !== binding.device || stat.ino !== binding.inode
44:     || !gatePermissions(stat.gid, stat.mode, binding.preparationUid)) throw new Error('BUSTER_PREPARATION_GATE_CHANGED');
45:   const file = path.join(gate, 'gate.json');
46:   const marker = await fs.lstat(file);
47:   if (!marker.isFile() || marker.uid !== 0 || marker.nlink !== 1 || marker.size > 1024
48:     || (marker.mode & 0o777) !== 0o400) throw new Error('BUSTER_PREPARATION_GATE_MARKER_CHANGED');
49:   const value: unknown = JSON.parse(await fs.readFile(file, 'utf8'));
50:   if (preparationDigest(value) !== binding.markerDigest) throw new Error('BUSTER_PREPARATION_GATE_MARKER_CHANGED');
51:   return gate;
52: }
53: 
54: /** Call only after durable root-ledger publication and actual native tree quiescence. */
55: export async function publishPreparationGate(sourceRoot: string, admissionId: string,
56:   binding: PreparationGateBinding): Promise<void> {
57:   const gate = await verifyPreparationGate(sourceRoot, admissionId, binding);
58:   // Revoke first: no intermediate group change ever gives the service write permission.
59:   await fs.chmod(gate, 0o700);
60:   await fs.chown(gate, 0, 1000);
61:   await fs.chmod(gate, 0o750);
62:   await syncDirectory(gate);
63: }
64: 
65: /** Original input is private to the parent after the staging owner's entire tree is quiescent. */
66: export async function retainPreparationGate(sourceRoot: string, admissionId: string,
67:   binding: PreparationGateBinding): Promise<void> {
68:   const gate = await verifyPreparationGate(sourceRoot, admissionId, binding);
69:   await fs.chmod(gate, 0o700);
70:   await fs.chown(gate, 0, 0);
71:   await syncDirectory(gate);
72: }
73: 
74: /** Metadata-only cleanup: never recurse and never remove a host-created data directory. */
75: export async function removeEmptyPreparationGate(sourceRoot: string, admissionId: string,
76:   binding: PreparationGateBinding): Promise<void> {
77:   const gate = path.dirname(preparationSourceDirectory(sourceRoot, admissionId));
78:   let stat;
79:   try { stat = await fs.lstat(gate); }
80:   catch (error) {
81:     if ((error as NodeJS.ErrnoException).code === 'ENOENT') return;
82:     throw error;
83:   }
84:   if (!stat.isDirectory() || stat.uid !== 0 || stat.dev !== binding.device || stat.ino !== binding.inode) {
85:     throw new Error('BUSTER_PREPARATION_GATE_CHANGED');
86:   }
87:   const entries = await fs.readdir(gate);
88:   if (entries.length === 1 && entries[0] === 'gate.json') {
89:     await verifyPreparationGate(sourceRoot, admissionId, binding);
90:     await fs.unlink(path.join(gate, 'gate.json'));
91:     await syncDirectory(gate);
92:   } else if (entries.length !== 0) throw new Error('BUSTER_PREPARATION_GATE_NOT_EMPTY');
93:   await fs.rmdir(gate);
94:   await syncDirectory(sourceRoot);
95: }
96: 
97: function gatePermissions(gid: number, mode: number, preparationUid: PreparationSlot): boolean {
98:   const permissions = mode & 0o7777;
99:   if (permissions === 0o1770) return gid === preparationUid;
100:   if (permissions === 0o750) return gid === 1000;
101:   return permissions === 0o700 && [0, 1000, preparationUid].includes(gid);
102: }

