421:       if (operationCompletedAt >= timeoutAt) throw new AttemptFault('timed_out', 'WORKER_ATTEMPT_TIMEOUT');
422:       if (logFault) throw logFault;
423:       preflightJson(operationResult.specialistResult, envelope.limits.resultBytes, 'WORKER_RESULT');
424:       const resultBytes = Buffer.byteLength(JSON.stringify(operationResult.specialistResult));
425:       if (resultBytes > envelope.limits.resultBytes) throw new AttemptFault('errored', 'WORKER_RESULT_LIMIT');
426:       checkEvidence(operationResult.evidence, envelope);
427:       operationResult = freeze(structuredClone(operationResult));
