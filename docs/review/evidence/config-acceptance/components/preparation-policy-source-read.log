22:     if (!stat.isDirectory() || stat.uid !== record.slot) throw new Error('BUSTER_PREPARATION_CLEANUP_SOURCE_CHANGED');
23:     data = { device: stat.dev, inode: stat.ino, uid: stat.uid };
24:   } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
25:   return { schemaVersion: 'buster-preparation-cleanup-effects.v1', admissionId: record.admissionId,
26:     originalEnvelopeDigest: preparationDigest(record.envelope), gate: structuredClone(record.gate), data };
