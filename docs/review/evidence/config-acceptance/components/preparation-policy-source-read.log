41: }
42: const wireSchema = JSON.parse(fs.readFileSync(new URL(
43:   '../../../../contracts/pipeline-test-gate/v1/schemas/pipeline-test-gate.v1.schema.json', import.meta.url,
44: ), 'utf8')) as { $id: string; $defs: Record<string, ObjectSchema> };
45: const headerSchema = structuredClone(wireSchema);
46: if (!headerSchema.$defs.remotePlanJob || !headerSchema.$defs.repositoryArchive) {
47:   throw new Error('BUSTER_PREPARATION_WIRE_SCHEMA_MISSING');
48: }
49: headerSchema.$id = 'kubeclaw.buster.prepared-header.v1';
50: headerSchema.$defs.remotePlanJob.properties.schemaVersion = { const: 'buster-plan-job-header.v1' };
51: headerSchema.$defs.repositoryArchive.properties.schemaVersion = { const: 'repository-archive-summary.v1' };
52: delete headerSchema.$defs.repositoryArchive.properties.data;
53: headerSchema.$defs.repositoryArchive.required = headerSchema.$defs.repositoryArchive.required.filter(key => key !== 'data');
54: const Constructor = Ajv2020 as unknown as new (options: object) => SchemaCompiler;
55: const compiler = new Constructor({ allErrors: true, strict: true });
56: (addFormats as unknown as (value: SchemaCompiler) => void)(compiler);
57: const validateHeader = compiler.compile({ ...headerSchema, $ref: '#/$defs/remotePlanJob' });
58: 
59: export function preparationDigest(value: unknown): string {
60:   return `sha256:${createHash('sha256').update(canonicalJson(value)).digest('hex')}`;
61: }
62: 
63: export function preparedPlanHeader(job: RemotePlanJobV1): PreparedPlanJob {
64:   const { data: _data, schemaVersion: _version, ...archive } = job.repositoryArchive;
65:   return { ...job, schemaVersion: 'buster-plan-job-header.v1',
66:     repositoryArchive: { ...archive, schemaVersion: 'repository-archive-summary.v1' } };
67: }
68: 
69: export function assertPreparedHeader(value: unknown): asserts value is PreparedPlanJob {
70:   if (!validateHeader(value)) throw new Error('BUSTER_PREPARATION_HEADER_INVALID');
71:   const job = value as PreparedPlanJob;
72:   validatePipelineTestGateContract('resolvedTestPlan', job.plan);
73:   if (remotePlanJobId(job.idempotencyKey) !== job.jobId
74:     || resolvedTestPlanDigest(job.plan) !== job.plan.planDigest
75:     || job.sourceSnapshot.archiveContentDigest !== job.repositoryArchive.contentDigest
76:     || job.sourceSnapshot.archiveSizeBytes !== job.repositoryArchive.sizeBytes
77:     || job.sourceSnapshot.pipelineStageId !== job.pipelineStageId
78:     || job.sourceSnapshot.attestation.authority !== job.sourceSnapshot.creatorAuthority) {
79:     throw new Error('BUSTER_PREPARATION_HEADER_IDENTITY_INVALID');
80:   }
81: }
82: 
83: export function assertPreparedSourceShape(value: unknown): asserts value is PreparedSourceReference {
84:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('BUSTER_PREPARATION_SOURCE_INVALID');
85:   const source = value as PreparedSourceReference;
86:   assertPreparationSlot(source.preparationUid);
87:   const keys = ['schemaVersion', 'admissionId', 'jobId', 'requestDigest', 'headerDigest',
88:     'archiveDigest', 'archiveBytes', 'attemptSpecDigest', 'preparationUid'];
89:   if (Object.keys(source).length !== keys.length || keys.some(key => !Object.hasOwn(source, key))
90:     || source.schemaVersion !== 'buster-prepared-source.v1'
91:     || typeof source.admissionId !== 'string' || !/^[a-f0-9]{32}$/u.test(source.admissionId)
92:     || typeof source.jobId !== 'string' || !/^job:[a-f0-9]{64}$/u.test(source.jobId)
93:     || ![source.requestDigest, source.headerDigest, source.archiveDigest, source.attemptSpecDigest]
94:       .every(value => typeof value === 'string' && /^sha256:[a-f0-9]{64}$/u.test(value))
95:     || !Number.isSafeInteger(source.archiveBytes) || source.archiveBytes < 1) {
96:     throw new Error('BUSTER_PREPARATION_SOURCE_INVALID');
97:   }
98: }
99: 
100: export function assertPreparedSource(value: unknown, job: PreparedPlanJob): asserts value is PreparedSourceReference {
101:   assertPreparedHeader(job);
102:   assertPreparedSourceShape(value);
103:   if (value.jobId !== job.jobId || value.requestDigest !== job.requestDigest
104:     || value.headerDigest !== preparationDigest(job)
105:     || value.archiveDigest !== job.repositoryArchive.contentDigest
106:     || value.archiveBytes !== job.repositoryArchive.sizeBytes) {
107:     throw new Error('BUSTER_PREPARATION_SOURCE_INVALID');
108:   }
109: }

SOURCE skills/buster/engine/test-gates/preparation-historical-host.ts SHA256 f8a008a3172e4bd4bdb84ea19f8435878a3c79d8f053d3a16a4f5ffcc084ea16
1: import { Socket } from 'node:net';
2: import { NativeWorkerControlChannel, WorkerAttemptExecutor, observeNativeWorkerResources, sha256Digest,
3:   type WorkerAttemptOperation } from '@kubeclaw/worker-core';
4: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
5: import { validateBusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
6: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
7: import { assertPreparationSlot } from './preparation-slots.ts';
8: import { assertHistoricalImportDescriptor, historicalInputDirectory } from './preparation-historical-reference.ts';
9: import type { HistoricalImportDescriptor } from './preparation-historical-reference.ts';
10: import { HistoricalHostChannel, historicalChannelLimits } from './preparation-historical-channel.ts';
11: import { materializeHistoricalImport } from './preparation-historical-materialize.ts';
12: 
13: function assigned(name: string): string {
14:   const value = process.env[name];
15:   if (!value) throw new Error(`BUSTER_HISTORICAL_ASSIGNED_ENV_REQUIRED:${name}`);
16:   return value;
17: }
18: 
19: async function envelopeInput(): Promise<WorkerAttemptEnvelopeV3> {
20:   const maximum = Number(assigned('BUSTER_PREPARATION_ASSIGNED_INPUT_BYTES'));
21:   if (!Number.isSafeInteger(maximum) || maximum < 1 || maximum > 2_147_483_647) throw new Error('BUSTER_HISTORICAL_ENVELOPE_LIMIT');
22:   const chunks: Buffer[] = [];
23:   let size = 0;
24:   for await (const chunk of process.stdin) {
25:     size += chunk.length;
26:     if (size > maximum) throw new Error('BUSTER_HISTORICAL_ENVELOPE_LIMIT');
27:     chunks.push(Buffer.from(chunk));
28:   }
29:   const value: unknown = JSON.parse(Buffer.concat(chunks, size).toString('utf8'));
30:   validateWorkerResourceContractV3('workerAttemptEnvelope', value);
31:   return value as WorkerAttemptEnvelopeV3;
32: }
33: 
34: function resourceMeasurement(scope: string) {
35:   const resources = observeNativeWorkerResources(scope);
36:   return { cpuTimeMs: { status: 'observed' as const, value: Math.ceil(resources.cpuTimeMicroseconds / 1000) },
37:     maximumMemoryBytes: { status: 'observed' as const, value: resources.maximumMemoryBytes },
38:     maximumTasks: { status: 'observed' as const, value: resources.maximumTasks } };
39: }
40: 
41: function openChannel(descriptor: HistoricalImportDescriptor, settings: BusterPreparationSettings): NativeWorkerControlChannel {
42:   return new NativeWorkerControlChannel(new Socket({ fd: 3, readable: true, writable: true, allowHalfOpen: true }),
43:     historicalChannelLimits(descriptor, settings));
44: }
45: 
46: async function main(): Promise<void> {
47:   const uid = process.getuid?.();
48:   assertPreparationSlot(uid);
49:   if (process.getgid?.() !== uid) throw new Error('BUSTER_HISTORICAL_OWNED_HOST_REQUIRED');
50:   const envelope = await envelopeInput();
51:   const values = envelope.operation.values;
52:   const phase = values.phase as { kind?: unknown; descriptor?: unknown };
53:   if (envelope.operation.contractId !== 'kubeclaw.buster-preparation@1'
54:     || Object.keys(values).sort().join(',') !== 'admissionId,phase,preparationUid,settings'
55:     || values.preparationUid !== uid || typeof values.admissionId !== 'string'
56:     || !phase || Object.keys(phase).sort().join(',') !== 'descriptor,kind' || phase.kind !== 'historical') {
57:     throw new Error('BUSTER_HISTORICAL_ENVELOPE_INVALID');
58:   }
59:   assertHistoricalImportDescriptor(phase.descriptor);
60:   const descriptor = phase.descriptor;
61:   const settings = validateBusterPreparationSettings(values.settings);
62:   const sourceRoot = assigned('BUSTER_PREPARATION_ASSIGNED_SOURCE_ROOT');
63:   historicalInputDirectory(sourceRoot, { importId: values.admissionId, sequence: 1 });
64:   const scope = assigned('KUBECLAW_NATIVE_SCOPE');
65:   const channel = openChannel(descriptor, settings);
66:   const input = new HistoricalHostChannel(channel, values.admissionId);
67:   const cancellation = new AbortController();
68:   const cancel = () => cancellation.abort(new Error('BUSTER_HISTORICAL_CANCELLED'));
69:   process.once('SIGINT', cancel);
70:   process.once('SIGTERM', cancel);
71:   let materialized = false;
72:   const operation: WorkerAttemptOperation<WorkerAttemptEnvelopeV3> = {
73:     prepare() { return undefined; },
74:     async execute(context) {
75:       const signal = AbortSignal.any([context.signal, cancellation.signal]);
76:       const bytes = await input.readSnapshot(descriptor);
77:       signal.throwIfAborted();
78:       const summary = await materializeHistoricalImport(bytes, {
79:         importId: values.admissionId as string, preparationUid: uid, attemptSpecDigest: envelope.attemptSpecDigest,
80:         descriptor, settings, trustedSourceAuthority: assigned('BUSTER_PREPARATION_ASSIGNED_SOURCE_AUTHORITY'),
81:         sourceAttestationPublicKey: assigned('BUSTER_PREPARATION_ASSIGNED_SOURCE_PUBLIC_KEY'),
82:       }, sourceRoot, required => input.reserve(required), signal);
83:       materialized = true;
84:       await input.complete();
85:       return { summary: 'Historical jobs staged in one owned phase', evidence: [], exitCode: 0, signal: null,
86:         specialistResult: { schemaId: 'buster-historical-import-result.v1',
87:           schemaDigest: sha256Digest({ schemaVersion: 'buster-historical-import-result.v1' }),
88:           values: JSON.parse(JSON.stringify(summary)) } };
89:     },
90:     async terminate() { cancel(); channel.destroy(); },
91:     async cleanup() {
92:       if (!materialized) throw new Error('BUSTER_HISTORICAL_RECONCILIATION_REQUIRED');
93:     },
94:     async measure() { return resourceMeasurement(scope); },
95:   };
96:   try {
97:     const result = await new WorkerAttemptExecutor({ envelope, operation, signal: cancellation.signal,
98:       retainLogs: false, receiptNamespace: 'buster-historical-import' }).execute();
99:     process.stdout.write(JSON.stringify(result));
100:   } finally {
101:     channel.destroy();
102:     process.removeListener('SIGINT', cancel);
103:     process.removeListener('SIGTERM', cancel);
104:   }
105: }
106: 
107: await main();

SOURCE skills/buster/engine/test-gates/preparation-host.ts SHA256 960f4605605171a5c1745144321995c91dc9f571926d497df278f9f2974c7fcc
1: import { assertPreparationSlot } from './preparation-slots.ts';
2: import { Socket } from 'node:net';
3: import {
4:   NativeWorkerControlChannel, WorkerAttemptExecutor, observeNativeWorkerResources, sha256Digest,
5:   type WorkerAttemptOperation,
6: } from '@kubeclaw/worker-core';
7: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
8: import { validateBusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
9: import { readPreparationInput, materializePreparedSource, preparationSourceDirectory } from './preparation-source.ts';
10: import { PreparationHostInput, preparationHostChannelLimits } from './preparation-host-channel.ts';
11: import { stagePreparationInput, stagedInputMetadata, assertBusterInput, wireDigest, type BusterInputReference } from './preparation-input.ts';
12: import { preparedPlanHeader, preparationDigest } from './preparation-header.ts';
13: 
14: async function readEnvelope(maximumBytes: number): Promise<WorkerAttemptEnvelopeV3> {
15:   const chunks: Buffer[] = [];
16:   let count = 0;
17:   for await (const chunk of process.stdin) {
18:     count += chunk.byteLength;
19:     if (count > maximumBytes) throw new Error('BUSTER_PREPARATION_ENVELOPE_LIMIT');
20:     chunks.push(Buffer.from(chunk));
21:   }
22:   const envelope: unknown = JSON.parse(Buffer.concat(chunks, count).toString('utf8'));
23:   validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
24:   return envelope as WorkerAttemptEnvelopeV3;
25: }
26: 
27: function environment(name: string): string {
28:   const value = process.env[name];
29:   if (!value) throw new Error(`BUSTER_PREPARATION_ASSIGNED_ENV_REQUIRED:${name}`);
30:   return value;
31: }
32: 
33: async function assignedPhase() {
34:   const maximumInputBytes = Number(environment('BUSTER_PREPARATION_ASSIGNED_INPUT_BYTES'));
35:   if (!Number.isSafeInteger(maximumInputBytes) || maximumInputBytes < 1 || maximumInputBytes > 2_147_483_647) {
36:     throw new Error('BUSTER_PREPARATION_ENVELOPE_LIMIT');
37:   }
38:   const envelope = await readEnvelope(maximumInputBytes);
39:   const settings = validateBusterPreparationSettings(envelope.operation.values.settings);
40:   const admissionId = envelope.operation.values.admissionId;
41:   const preparationUid = envelope.operation.values.preparationUid;
42:   assertPreparationSlot(preparationUid);
43:   if (process.getuid?.() !== preparationUid || process.getgid?.() !== preparationUid) throw new Error('BUSTER_PREPARATION_SLOT_INVALID');
44:   if (typeof admissionId !== 'string' || Object.keys(envelope.operation.values).sort().join(',') !== 'admissionId,phase,preparationUid,settings'
45:     || envelope.operation.contractId !== 'kubeclaw.buster-preparation@1') throw new Error('BUSTER_PREPARATION_OPERATION_INVALID');
46:   const phase = envelope.operation.values.phase as { kind?: unknown; input?: unknown };
47:   if (!phase || !['stage', 'extract'].includes(String(phase.kind))
48:     || Object.keys(phase).sort().join(',') !== (phase.kind === 'stage' ? 'kind' : 'input,kind')) {
49:     throw new Error('BUSTER_PREPARATION_PHASE_INVALID');
50:   }
51:   const sourceRoot = environment('BUSTER_PREPARATION_ASSIGNED_SOURCE_ROOT');
52:   preparationSourceDirectory(sourceRoot, admissionId);
53:   return { envelope, settings, admissionId, phase, sourceRoot };
54: }
55: 
56: function measureResources(scope: string) {
57:   const resources = observeNativeWorkerResources(scope);
58:   return {
59:     cpuTimeMs: { status: 'observed' as const, value: Math.ceil(resources.cpuTimeMicroseconds / 1000) },
60:     maximumMemoryBytes: { status: 'observed' as const, value: resources.maximumMemoryBytes },
61:     maximumTasks: { status: 'observed' as const, value: resources.maximumTasks },
62:   };
63: }
64: 
65: async function main(): Promise<void> {
66:   const scope = environment('KUBECLAW_NATIVE_SCOPE');
67:   const { envelope, settings, admissionId, phase, sourceRoot } = await assignedPhase();
68:   const channel = new NativeWorkerControlChannel(new Socket({ fd: 3, readable: true, writable: true, allowHalfOpen: true }), preparationHostChannelLimits(settings));
69:   const input = new PreparationHostInput(channel, admissionId);
70:   const cancellation = new AbortController();
71:   const cancel = () => cancellation.abort(new Error('BUSTER_PREPARATION_CANCELLED'));
72:   process.once('SIGINT', cancel);
73:   process.once('SIGTERM', cancel);
74:   let allocated = false;
75:   let materialized = false;
76:   const operation: WorkerAttemptOperation<WorkerAttemptEnvelopeV3> = {
77:     prepare() { return undefined; },
78:     async execute(context) {
79:       const signal = AbortSignal.any([context.signal, cancellation.signal]);
80:       const { job, wire } = await readPreparationInput(input.chunks(), settings, {
81:         trustedSourceAuthority: environment('BUSTER_PREPARATION_ASSIGNED_SOURCE_AUTHORITY'),
82:         sourceAttestationPublicKey: environment('BUSTER_PREPARATION_ASSIGNED_SOURCE_PUBLIC_KEY'),
83:       }, signal);
84:       let values: unknown;
85:       let schemaId: string;
86:       if (phase.kind === 'stage') {
87:         const staged = stagedInputMetadata(job, wire, admissionId, envelope.attemptSpecDigest, settings);
88:         const accepted = await input.admission(staged);
89:         values = accepted ? await stagePreparationInput(staged, wire, sourceRoot, signal, () => { allocated = true; }) : { declined: true };
90:         schemaId = accepted ? 'buster-staged-input-result.v1' : 'buster-declined-input-result.v1';
91:       } else {
92:         const retained = phase.input as BusterInputReference;
93:         assertBusterInput(retained, preparedPlanHeader(job));
94:         if (wire.byteLength !== retained.wireBytes || wireDigest(wire) !== retained.wireDigest
95:           || preparationDigest(preparedPlanHeader(job)) !== retained.headerDigest) {
96:           throw new Error('BUSTER_PREPARATION_RETAINED_INPUT_MISMATCH');
97:         }
98:         values = await materializePreparedSource(job, { admissionId, attemptSpecDigest: envelope.attemptSpecDigest,
99:           root: sourceRoot, tarExecutable: environment('BUSTER_PREPARATION_ASSIGNED_TAR'), settings, signal,
100:           onAllocated: () => { allocated = true; } });
101:         schemaId = 'buster-preparation-result.v1';
102:       }
103:       materialized = true;
104:       return { summary: 'Owned source phase completed', evidence: [], exitCode: 0, signal: null,
105:         specialistResult: { schemaId, schemaDigest: sha256Digest({ schemaVersion: schemaId }),
106:           values: JSON.parse(JSON.stringify(values)) } };
107:     },
108:     async terminate() { cancel(); channel.destroy(); },
109:     async cleanup() {
110:       if (allocated && !materialized) throw new Error('BUSTER_PREPARATION_SOURCE_RECONCILIATION_REQUIRED');
111:     },
112:     // Retained successful source is an intended output; partial source needs separate quiescent reconciliation.
113:     async measure() { return measureResources(scope); },
114:   };
115:   try {
116:     const result = await new WorkerAttemptExecutor({ envelope, operation, signal: cancellation.signal,
117:       retainLogs: false, receiptNamespace: 'buster-preparation-provisional' }).execute();
118:     process.stdout.write(JSON.stringify(result));
119:   } finally {
120:     channel.destroy();
121:     process.removeListener('SIGINT', cancel);
122:     process.removeListener('SIGTERM', cancel);
123:   }
124: }
125: 
126: await main();

