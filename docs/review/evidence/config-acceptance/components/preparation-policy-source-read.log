237: /** One fully validated startup snapshot; no inline-document or path fallback API. */
238: export function loadSwarmSettings(environment: NodeJS.ProcessEnv): Readonly<{
239:   prism: PrismSettings;
240:   buster: BusterSettings;
241:   workerCore: WorkerCoreSettings;
242:   identity: SwarmBundleIdentity;
243:   profile: Readonly<Record<string, unknown>>;
244: }> {
245:   rejectLegacyAuthors(environment);
246:   const bundle = readSwarmBundle(environment.SWARM_CONFIG);
247:   const control = bundle.components['prism-control'].settings as unknown as PrismControlSettings & { dispatchTimeoutMs: number };
248:   const worker = bundle.components['prism-worker'].settings as unknown as { ingress: PrismWorkerSettings; supervisor: PrismSupervisorSettings };
249:   const execution = bundle.components['prism-execution'].settings as unknown as Pick<PrismNativeSettings, 'resourcePolicy' | 'maximumResultBytes'>;
250:   const { dispatchTimeoutMs, ...controlSettings } = control;
251:   const projection: SwarmConfig = { operator: {
252:     prism: {
253:       control: controlSettings,
254:       studio: bundle.components['prism-studio'].settings as unknown as PrismStudioSettings,
255:       worker: worker.ingress,
256:       native: { ...execution, dispatchTimeoutMs, supervisor: worker.supervisor },
257:     },
258:     buster: bundle.components['buster-engine'].settings as unknown as BusterSettings,
259:   } };
260:   // Validate both domains before returning either: no partial bundle activation.
261:   const prism = prismSettingsFromConfig(projection);
262:   const buster = busterSettingsFromConfig(projection, bundle.identity.generationDirectory);
263:   return Object.freeze({ prism, buster, workerCore: bundle.components['worker-core'].settings as unknown as WorkerCoreSettings,
264:     profile: bundle.profile, identity: bundle.identity });
265: }
266: 
267: function rejectLegacyAuthors(environment: NodeJS.ProcessEnv): void {
268:   for (const key of [...migratedEnvironmentKeys,
269:     'BUSTER_V2_MAX_ARCHIVE_BYTES', 'BUSTER_V2_MAX_REQUEST_BYTES', 'BUSTER_V2_MAX_EXTRACTED_BYTES',
270:     'BUSTER_LEASE_API_GROUP', 'BUSTER_LEASE_API_VERSION', 'BUSTER_ALLOWED_SOURCE_SECRETS',
271:     'BUSTER_V2_MAX_ACTIVE_JOBS', 'BUSTER_V2_MAX_QUEUED_JOBS', 'BUSTER_V2_MAX_CONCURRENT_ATTEMPTS']) {
272:     if (environment[key] !== undefined) throw new Error(`SWARM_CONFIG_LEGACY_OVERRIDE:${key}`);
273:   }
274: }

