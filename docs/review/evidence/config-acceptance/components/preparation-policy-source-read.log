99:   validateWorkerResourceContractV3('workerAttemptEnvelope', item.envelope);
100:   const values = item.envelope.operation.values;
101:   if (values.preparationUid !== item.slot || values.admissionId !== item.admissionId
102:     || item.envelope.attemptSpecDigest !== item.attemptSpecDigest
103:     || item.envelope.operation.contractId !== 'kubeclaw.buster-preparation@1'
104:     || Object.keys(values).sort().join(',') !== 'admissionId,phase,preparationUid,settings') invalid();
105:   const phase = values.phase as { kind?: unknown; input?: unknown; descriptor?: unknown };
106:   if (!phase || typeof phase !== 'object') invalid();
107:   if (item.historicalDescriptor !== null) {
