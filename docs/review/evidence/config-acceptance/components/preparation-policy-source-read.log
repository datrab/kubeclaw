10: export function preparationCleanupProfile(engineContentDigest: string): WorkerProfileV3 {
11:   const base = preparationProfile(engineContentDigest);
12:   const profile = { ...base, profileId: 'buster-native-source-cleanup-v1',
13:     engine: { ...base.engine, engineId: 'buster-native-source-cleanup', contractId: 'kubeclaw.native-source-cleanup@1' } };
14:   return { ...profile, profileDigest: workerProfileDigest(profile) };
15: }
