SOURCE contracts/pipeline-worker-core/v1/src/digest.ts SHA256 10c61ec122ca6e65c7deef2c059a19ad70627cf65bdf1eb65f0ac2539457d780
1: import crypto from 'node:crypto';
2: 
3: function compareText(left: string, right: string): number {
4:   // RFC 8785 section 3.2.3 requires raw UTF-16 code-unit ordering.
5:   return left < right ? -1 : left > right ? 1 : 0;
6: }
7: 
8: function encodeString(value: string): string {
9:   for (let index = 0; index < value.length; index += 1) {
10:     const unit = value.charCodeAt(index);
11:     if (unit >= 0xd800 && unit <= 0xdbff) {
12:       const next = value.charCodeAt(index + 1);
13:       if (!(next >= 0xdc00 && next <= 0xdfff)) throw new TypeError('RFC8785_INVALID_UNICODE');
14:       index += 1;
15:     } else if (unit >= 0xdc00 && unit <= 0xdfff) {
16:       throw new TypeError('RFC8785_INVALID_UNICODE');
17:     }
18:   }
19:   return JSON.stringify(value);
20: }
21: 
22: export function canonicalJson(value: unknown): string {
23:   if (value === null) return 'null';
24:   if (typeof value === 'string') return encodeString(value);
25:   if (typeof value === 'boolean') return value ? 'true' : 'false';
26:   if (typeof value === 'number') {
27:     if (!Number.isFinite(value)) throw new TypeError('RFC8785_INVALID_NUMBER');
28:     return JSON.stringify(value);
29:   }
30:   if (typeof value !== 'object') throw new TypeError('RFC8785_INVALID_TYPE');
31:   if (Array.isArray(value)) {
32:     const items: string[] = [];
33:     for (let index = 0; index < value.length; index += 1) {
34:       if (!Object.hasOwn(value, index)) throw new TypeError('RFC8785_INVALID_ARRAY');
35:       items.push(canonicalJson(value[index]));
36:     }
37:     return `[${items.join(',')}]`;
38:   }
39:   const prototype = Object.getPrototypeOf(value);
40:   if (prototype !== Object.prototype && prototype !== null) throw new TypeError('RFC8785_INVALID_OBJECT');
41:   return `{${Object.entries(value as Record<string, unknown>)
42:     .sort(([left], [right]) => compareText(left, right))
43:     .map(([key, child]) => `${encodeString(key)}:${canonicalJson(child)}`)
44:     .join(',')}}`;
45: }
46: 
47: export function sha256Digest(value: unknown): string {
48:   return `sha256:${crypto.createHash('sha256').update(canonicalJson(value)).digest('hex')}`;
49: }
50: 
51: export function sha256Text(value: string): string {
52:   return `sha256:${crypto.createHash('sha256').update(value, 'utf8').digest('hex')}`;
53: }
54: 
55: export function workerProfileDigest(profile: Readonly<object>): string {
56:   const { profileDigest: _profileDigest, ...unsigned } = profile as Readonly<Record<string, unknown>>;
57:   return sha256Digest(unsigned);
58: }
59: 
60: export function workerAttemptSpecDigest(envelope: Readonly<object>): string {
61:   const { attemptSpecDigest: _attemptSpecDigest, claim: _claim, ...unsigned }
62:     = envelope as Readonly<Record<string, unknown>>;
63:   return sha256Digest(unsigned);
64: }
65: 
66: export function workerAttemptResultDigest(result: Readonly<object>): string {
67:   const { resultDigest: _resultDigest, receipt: _receipt, ...unsigned }
68:     = result as Readonly<Record<string, unknown>>;
69:   return sha256Digest(unsigned);
70: }

SOURCE contracts/pipeline-worker-core/v1/src/resource-validation-v3.ts SHA256 00332a01a4674616f0859a83d704771b497d0c0d4220629a35b9a7414f924784
1: import fs from 'node:fs';
2: import Ajv2020 from 'ajv/dist/2020.js';
3: import addFormats from 'ajv-formats';
4: import { canonicalJson } from './digest.ts';
5: import { workerCoreRelationErrors, PipelineWorkerCoreContractError } from './validation.ts';
6: import type { ContractValidationResult } from './types.ts';
7: import type { WorkerAttemptEnvelopeV3, WorkerAttemptResultV3, WorkerNativeResourceAccounting, WorkerNativeResourceMetric } from './resource-types-v3.ts';
8: 
9: export const workerNativeResourceMetrics: readonly WorkerNativeResourceMetric[] = ['cpuTimeMs', 'maximumMemoryBytes', 'maximumTasks'];
10: type Definition = 'workerProfile' | 'workerAttemptEnvelope' | 'workerAttemptResult';
11: type Validator = ((value: unknown) => boolean) & { errors?: unknown };
12: const Constructor = Ajv2020 as unknown as new(options: object) => { addSchema(schema: unknown): void; compile(schema: unknown): Validator };
13: const ajv = new Constructor({ strict: true, allErrors: true });
14: (addFormats as unknown as (value: unknown) => void)(ajv);
15: const schema = JSON.parse(fs.readFileSync(new URL('../schemas/pipeline-worker-core.v3.schema.json', import.meta.url), 'utf8')) as { $id: string };
16: ajv.addSchema(schema);
17: const validators = new Map<Definition, Validator>();
18: 
19: function accountingErrors(result: WorkerAttemptResultV3): string[] {
20:   const errors: string[] = [];
21:   for (const metric of workerNativeResourceMetrics) {
22:     const observation = result.resourceAccounting.observations[metric];
23:     const budget = result.resourceAccounting.budgets[metric];
24:     if (observation.status === 'observed') {
25:       if (!Number.isSafeInteger(observation.value) || result.resources[metric] !== observation.value) errors.push(`${metric}: invalid or inconsistent observation`);
26:     } else if (result.resources[metric] !== undefined) errors.push(`${metric}: unavailable observation cannot claim numeric use`);
27:     if (result.state === 'completed' && budget.state === 'requested'
28:       && (observation.status !== 'observed' || observation.value > budget.limit)) errors.push(`${metric}: requested budget was not satisfied`);
29:   }
30:   return errors;
31: }
32: 
33: export function checkWorkerResourceContractV3(definition: Definition, value: unknown): ContractValidationResult {
34:   let validate = validators.get(definition);
35:   if (!validate) { validate = ajv.compile({ $ref: `${schema.$id}#/$defs/${definition}` }); validators.set(definition, validate); }
36:   if (!validate(value)) return { ok: false, errors: [JSON.stringify(validate.errors)] };
37:   const errors = workerCoreRelationErrors(definition, value);
38:   if (definition === 'workerAttemptResult') errors.push(...accountingErrors(value as WorkerAttemptResultV3));
39:   if (definition === 'workerAttemptEnvelope') {
40:     const envelope = value as WorkerAttemptEnvelopeV3;
41:     for (const metric of workerNativeResourceMetrics) {
42:       const budget = envelope.resourceBudgets[metric];
43:       if (budget.state === 'requested' && !Number.isSafeInteger(budget.limit)) errors.push(`${metric}: unsafe budget integer`);
44:     }
45:   }
46:   return { ok: errors.length === 0, errors };
47: }
48: 
49: export function validateWorkerResourceContractV3(definition: Definition, value: unknown): void {
50:   const checked = checkWorkerResourceContractV3(definition, value);
51:   if (!checked.ok) throw new PipelineWorkerCoreContractError(`${definition}.v3`, checked.errors);
52: }
53: 
54: export function initialWorkerNativeResourceAccounting(envelope: WorkerAttemptEnvelopeV3): WorkerNativeResourceAccounting {
55:   const unavailable = { status: 'unavailable' as const, reason: 'Native attempt has not supplied final kernel observations' };
56:   return { schemaVersion: 'worker-resource-accounting.v2', capabilities: structuredClone(envelope.profile.resourceCapabilities),
57:     budgets: structuredClone(envelope.resourceBudgets), observations: {
58:       cpuTimeMs: { ...unavailable }, maximumMemoryBytes: { ...unavailable }, maximumTasks: { ...unavailable },
59:     } };
60: }
61: 
62: export function checkWorkerNativeResultBinding(envelope: WorkerAttemptEnvelopeV3, result: WorkerAttemptResultV3): ContractValidationResult {
63:   const errors = [...checkWorkerResourceContractV3('workerAttemptEnvelope', envelope).errors,
64:     ...checkWorkerResourceContractV3('workerAttemptResult', result).errors];
65:   if (errors.length) return { ok: false, errors };
66:   const expected = [envelope.protocolVersion, envelope.attemptId, envelope.claim.claimId, envelope.claim.generation,
67:     envelope.claim.workerId, envelope.profile.profileDigest, envelope.attemptSpecDigest];
68:   const actual = [result.protocolVersion, result.attemptId, result.claimId, result.claimGeneration,
69:     result.workerId, result.profileDigest, result.attemptSpecDigest];
70:   if (canonicalJson(expected) !== canonicalJson(actual)) errors.push('native result identity does not match accepted attempt');
71:   if (canonicalJson(envelope.resourceBudgets) !== canonicalJson(result.resourceAccounting.budgets)
72:     || canonicalJson(envelope.profile.resourceCapabilities) !== canonicalJson(result.resourceAccounting.capabilities)) errors.push('native result policy does not match accepted attempt');
73:   errors.push(...resultLimits(envelope, result));
74:   return { ok: errors.length === 0, errors };
75: }
76: 
77: function resultLimits(envelope: WorkerAttemptEnvelopeV3, result: WorkerAttemptResultV3): string[] {
78:   const errors: string[] = [];
79:   const evidenceBytes = result.evidence.reduce((sum, item) => sum + item.artifact.sizeBytes, 0);
80:   if (result.evidence.length > envelope.limits.evidenceFiles || new Set(result.evidence.map(item => item.evidenceId)).size !== result.evidence.length
81:     || evidenceBytes !== result.resources.evidenceBytes || evidenceBytes > envelope.limits.evidenceBytes) errors.push('native result evidence exceeds or differs from accepted limits');
82:   if (result.resources.logBytes > envelope.limits.logBytes || result.resources.resultBytes > envelope.limits.resultBytes) errors.push('native result output exceeds accepted limits');
83:   if (result.specialistResult !== null && Buffer.byteLength(JSON.stringify(result.specialistResult)) !== result.resources.resultBytes) errors.push('native specialist result byte count mismatch');
84:   if (result.state === 'completed' && (Date.parse(result.startedAt) < Date.parse(envelope.claim.claimedAt)
85:     || Date.parse(result.completedAt) >= Date.parse(envelope.claim.expiresAt))) errors.push('native result outside accepted claim window');
86:   return errors;
87: }

SOURCE contracts/pipeline-worker-core/v1/src/validation.ts SHA256 a4caf6147b58a5a68e49ed02bbe6ed75ce7f84f8d5baca4243b3519aecaa3147
1: import fs from 'node:fs';
2: import Ajv2020 from 'ajv/dist/2020.js';
3: import addFormats from 'ajv-formats';
4: import { sha256Text, workerAttemptResultDigest, workerAttemptSpecDigest, workerProfileDigest } from './digest.ts';
5: import type {
6:   ContractValidationResult,
7:   AttemptClaimV1,
8:   PipelineWorkerCoreDefinition,
9:   WorkerAttemptEnvelopeV1,
10:   WorkerAttemptMessageV1,
11:   WorkerAttemptResultV1,
12:   WorkerCancellationRequestV1,
13:   WorkerHealthV1,
14:   WorkerRegistrationV1,
15:   WorkerTrustEnvelopeV1,
16: } from './types.ts';
17: 
18: type Validator = ((value: unknown) => boolean) & { errors?: unknown[] | null };
19: interface AjvInstance {
20:   addSchema(schema: object): void;
21:   compile(schema: object): Validator;
22: }
23: 
24: const schemaUrl = new URL('../schemas/pipeline-worker-core.v1.schema.json', import.meta.url);
25: const schema = JSON.parse(fs.readFileSync(schemaUrl, 'utf8')) as { $id: string };
26: const AjvConstructor = Ajv2020 as unknown as new (options: { allErrors: boolean; strict: boolean }) => AjvInstance;
27: const installFormats = addFormats as unknown as (instance: AjvInstance) => AjvInstance;
28: const ajv = new AjvConstructor({ allErrors: true, strict: true });
29: installFormats(ajv);
30: ajv.addSchema(schema);
31: const validators = new Map<string, Validator>();
32: 
33: export class PipelineWorkerCoreContractError extends Error {
34:   definition: string;
35:   errors: string[];
36: 
37:   constructor(definition: string, errors: string[]) {
38:     super(`Invalid pipeline worker-core ${definition}: ${errors.join('; ')}`);
39:     this.name = 'PipelineWorkerCoreContractError';
40:     this.definition = definition;
41:     this.errors = [...errors];
42:   }
43: }
44: 
45: function validator(definition: PipelineWorkerCoreDefinition): Validator {
46:   const existing = validators.get(definition);
47:   if (existing) return existing;
48:   const compiled = ajv.compile({ $ref: `${schema.$id}#/$defs/${definition}` }) as Validator;
49:   validators.set(definition, compiled);
50:   return compiled;
51: }
52: 
53: function errorText(errors: unknown[] | null | undefined): string[] {
54:   if (!errors?.length) return ['contract validation failed without details'];
55:   return errors.map((error) => {
56:     if (!error || typeof error !== 'object') return String(error);
57:     const item = error as { instancePath?: string; message?: string };
58:     return `${item.instancePath || '/'} ${item.message || 'is invalid'}`;
59:   });
60: }
61: 
62: export function workerCoreRelationErrors(definition: PipelineWorkerCoreDefinition, value: unknown): string[] {
63:   if (definition === 'workerTrustEnvelope') {
64:     const envelope = value as WorkerTrustEnvelopeV1;
65:     return Date.parse(envelope.expiresAt) > Date.parse(envelope.issuedAt)
66:       ? []
67:       : ['/expiresAt must be after /issuedAt'];
68:   }
69: 
70:   if (definition === 'workerProfile') {
71:     const profile = value as WorkerRegistrationV1['profiles'][number];
72:     try {
73:       return workerProfileDigest(profile as unknown as Record<string, unknown>) === profile.profileDigest
74:         ? []
75:         : ['/profileDigest does not match the profile contents'];
76:     } catch {
77:       return ['/profile contains a value that cannot be canonically hashed'];
78:     }
79:   }
80: 
81:   if (definition === 'workerRegistration') {
82:     const registration = value as WorkerRegistrationV1;
83:     const errors: string[] = [];
84:     if (registration.capacity.available + registration.capacity.active !== registration.capacity.total) {
85:       errors.push('/capacity available plus active must equal total');
86:     }
87:     for (const [index, profile] of registration.profiles.entries()) {
88:       if (profile.workerType !== registration.workerType) {
89:         errors.push(`/profiles/${index}/workerType must match /workerType`);
90:       }
91:       try {
92:         if (workerProfileDigest(profile as unknown as Record<string, unknown>) !== profile.profileDigest) {
93:           errors.push(`/profiles/${index}/profileDigest does not match the profile contents`);
94:         }
95:       } catch {
96:         errors.push(`/profiles/${index} contains a value that cannot be canonically hashed`);
97:       }
98:     }
99:     const profileIds = registration.profiles.map((profile) => profile.profileId);
100:     if (new Set(profileIds).size !== profileIds.length) {
101:       errors.push('/profiles cannot contain duplicate profileId values');
102:     }
103:     if (Date.parse(registration.sentAt) < Date.parse(registration.startedAt)) {
104:       errors.push('/sentAt must not be before /startedAt');
105:     }
106:     return errors;
107:   }
108: 
109:   if (definition === 'workerHealth') {
110:     const health = value as WorkerHealthV1;
111:     const errors: string[] = [];
112:     if (health.capacity.available + health.capacity.active !== health.capacity.total) {
113:       errors.push('/capacity available plus active must equal total');
114:     }
115:     if (health.activeAttemptIds.length !== health.capacity.active) {
116:       errors.push('/activeAttemptIds length must equal /capacity/active');
117:     }
118:     return errors;
119:   }
120: 
121:   if (definition === 'attemptClaim') {
122:     const claim = value as AttemptClaimV1;
123:     return Date.parse(claim.expiresAt) > Date.parse(claim.claimedAt)
124:       ? []
125:       : ['/expiresAt must be after /claimedAt'];
126:   }
127: 
128:   if (definition === 'workerAttemptEnvelope') {
129:     const envelope = value as WorkerAttemptEnvelopeV1;
130:     const errors: string[] = [];
131:     try {
132:       if (workerProfileDigest(envelope.profile as unknown as Record<string, unknown>)
133:         !== envelope.profile.profileDigest) {
134:         errors.push('/profile/profileDigest does not match the profile contents');
135:       }
136:       if (workerAttemptSpecDigest(envelope as unknown as Record<string, unknown>) !== envelope.attemptSpecDigest) {
137:         errors.push('/attemptSpecDigest does not match the attempt contents');
138:       }
139:     } catch {
140:       errors.push('/attempt contains a value that cannot be canonically hashed');
141:     }
142:     if (Date.parse(envelope.claim.expiresAt) <= Date.parse(envelope.claim.claimedAt)) {
143:       errors.push('/claim/expiresAt must be after /claim/claimedAt');
144:     }
145:     if (Date.parse(envelope.claim.claimedAt) < Date.parse(envelope.issuedAt)) {
146:       errors.push('/claim/claimedAt must not be before /issuedAt');
147:     }
148:     if (envelope.claim.attemptId !== envelope.attemptId) {
149:       errors.push('/claim/attemptId must match /attemptId');
150:     }
151:     if (Date.parse(envelope.queueDeadline) <= Date.parse(envelope.issuedAt)) {
152:       errors.push('/queueDeadline must be after /issuedAt');
153:     }
154:     const unsupported = envelope.grantedCapabilities.filter(
155:       (capability) => !envelope.profile.capabilities.includes(capability),
156:     );
157:     if (unsupported.length > 0) {
158:       errors.push('/grantedCapabilities must be supported by /profile/capabilities');
159:     }
160:     const packageIds = envelope.packages.map((item) => item.packageId);
161:     if (new Set(packageIds).size !== packageIds.length) {
162:       errors.push('/packages cannot contain duplicate packageId values');
163:     }
164:     const inputNames = envelope.inputs.map((item) => item.name);
165:     if (new Set(inputNames).size !== inputNames.length) {
166:       errors.push('/inputs cannot contain duplicate name values');
167:     }
168:     return errors;
169:   }
170: 
171:   if (definition === 'workerLogPart') {
172:     const part = value as { text: string; contentDigest: string };
173:     return sha256Text(part.text) === part.contentDigest
174:       ? []
175:       : ['/contentDigest does not match /text'];
176:   }
177: 
178:   if (definition === 'workerAttemptResult') {
179:     const result = value as WorkerAttemptResultV1;
180:     const errors: string[] = [];
181:     if (Date.parse(result.completedAt) < Date.parse(result.startedAt)) {
182:       errors.push('/completedAt must not be before /startedAt');
183:     }
184:     if (result.cleanup.state === 'failed' && result.state !== 'errored') {
185:       errors.push('/state must be errored when /cleanup/state is failed');
186:     }
187:     try {
188:       if (workerAttemptResultDigest(result as unknown as Record<string, unknown>) !== result.resultDigest) {
189:         errors.push('/resultDigest does not match the result contents');
190:       }
191:     } catch {
192:       errors.push('/result contains a value that cannot be canonically hashed');
193:     }
194:     return errors;
195:   }
196: 
197:   return [];
198: }
199: 
200: export function checkPipelineWorkerCoreContract(
201:   definition: PipelineWorkerCoreDefinition,
202:   value: unknown,
203: ): ContractValidationResult {
204:   const validate = validator(definition);
205:   const ok = validate(value);
206:   if (!ok) return { ok: false, errors: errorText(validate.errors) };
207:   const errors = workerCoreRelationErrors(definition, value);
208:   return { ok: errors.length === 0, errors };
209: }
210: 
211: export function validatePipelineWorkerCoreContract(
212:   definition: PipelineWorkerCoreDefinition,
213:   value: unknown,
214: ): void {
215:   const result = checkPipelineWorkerCoreContract(definition, value);
216:   if (!result.ok) throw new PipelineWorkerCoreContractError(definition, result.errors);
217: }
218: 
219: export function checkWorkerAttemptMessageBinding(
220:   envelope: WorkerAttemptEnvelopeV1,
221:   message: WorkerAttemptMessageV1,
222: ): ContractValidationResult {
223:   const errors: string[] = [];
224:   if (message.protocolVersion !== envelope.protocolVersion) errors.push('/protocolVersion does not match the attempt');
225:   if (message.attemptId !== envelope.attemptId) errors.push('/attemptId does not match the attempt');
226:   if (message.claimId !== envelope.claim.claimId) errors.push('/claimId does not match the attempt claim');
227:   if (message.claimGeneration !== envelope.claim.generation) {
228:     errors.push('/claimGeneration does not match the attempt claim');
229:   }
230:   if (message.workerId !== envelope.claim.workerId) errors.push('/workerId does not match the attempt claim');
231:   return { ok: errors.length === 0, errors };
232: }
233: 
234: export function checkWorkerCancellationBinding(
235:   envelope: WorkerAttemptEnvelopeV1,
236:   request: WorkerCancellationRequestV1,
237: ): ContractValidationResult {
238:   const errors: string[] = [];
239:   if (request.protocolVersion !== envelope.protocolVersion) errors.push('/protocolVersion does not match the attempt');
240:   if (request.attemptId !== envelope.attemptId) errors.push('/attemptId does not match the attempt');
241:   if (request.cancellationId !== envelope.cancellationId) {
242:     errors.push('/cancellationId does not match the attempt');
243:   }
244:   return { ok: errors.length === 0, errors };
245: }
246: 
247: export function checkWorkerAttemptEnvelopeConsistency(
248:   accepted: WorkerAttemptEnvelopeV1,
249:   candidate: WorkerAttemptEnvelopeV1,
250: ): ContractValidationResult {
251:   const errors = [...checkPipelineWorkerCoreContract('workerAttemptEnvelope', candidate).errors];
252:   if (candidate.attemptId !== accepted.attemptId) errors.push('/attemptId does not match the accepted attempt');
253:   if (candidate.attemptSpecDigest !== accepted.attemptSpecDigest) {
254:     errors.push('/attemptSpecDigest does not match the accepted attempt');
255:   }
256:   if (candidate.profile.profileDigest !== accepted.profile.profileDigest) {
257:     errors.push('/profile/profileDigest does not match the accepted attempt');
258:   }
259:   if (candidate.protocolVersion !== accepted.protocolVersion) {
260:     errors.push('/protocolVersion does not match the accepted attempt');
261:   }
262:   if (candidate.claim.claimId !== accepted.claim.claimId) errors.push('/claim/claimId cannot change');
263:   if (candidate.claim.generation !== accepted.claim.generation) errors.push('/claim/generation cannot change');
264:   if (candidate.claim.workerId !== accepted.claim.workerId) errors.push('/claim/workerId cannot change');
265:   if (candidate.claim.claimedAt !== accepted.claim.claimedAt) errors.push('/claim/claimedAt cannot change');
266:   if (Date.parse(candidate.claim.expiresAt) < Date.parse(accepted.claim.expiresAt)) {
267:     errors.push('/claim/expiresAt can only be extended');
268:   }
269:   return { ok: errors.length === 0, errors };
270: }

