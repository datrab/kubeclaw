74:     jobId: `job:${'f'.repeat(64)}`, requestDigest: digest, headerDigest: digest,
75:     archiveDigest: digest, archiveBytes: Number.MAX_SAFE_INTEGER, attemptSpecDigest: item.attemptSpecDigest,
76:   } };
77: }
