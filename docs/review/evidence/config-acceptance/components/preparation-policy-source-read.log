58: export interface SourceLedger {
59:   readonly schemaVersion: 'buster-preparation-ledger.v1';
60:   readonly reservations: readonly SourceReservation[];
61: }
62: export const empty: SourceLedger = { schemaVersion: 'buster-preparation-ledger.v1', reservations: [] };
63: export function terminalMetadataProjection(item: SourceReservation): SourceReservation {
64:   if (item.phase === 'released') return item;
65:   const digest = `sha256:${'f'.repeat(64)}`;
66:   if (item.historicalDescriptor !== null) return { ...item, phase: 'historical-reserved', slotReleased: false, groupReceiptDigest: digest,
67:     gate: item.gate ?? { preparationUid: item.slot, device: Number.MAX_SAFE_INTEGER, inode: Number.MAX_SAFE_INTEGER, markerDigest: digest } };
68:   if (item.parentInputId === null) return { ...item, phase: 'empty-gate-reclaiming', slotReleased: false, emptyGateResultDigest: digest,
69:     gate: item.gate ?? { preparationUid: item.slot, device: Number.MAX_SAFE_INTEGER, inode: Number.MAX_SAFE_INTEGER, markerDigest: digest } };
70:   return { ...item, phase: 'repository-released', gate: item.gate ?? {
71:     preparationUid: item.slot, device: Number.MAX_SAFE_INTEGER, inode: Number.MAX_SAFE_INTEGER, markerDigest: digest,
72:   }, source: item.source ?? {
