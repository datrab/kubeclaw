16: export function assertCleanupDisposition(value: unknown): asserts value is TestProviderCleanupDisposition {
17:   if (value !== 'incomplete' && value !== 'completed-fixture') throw new Error('TEST_PROVIDER_CLEANUP_DISPOSITION_INVALID');
18: }
19: 
20: function runtimePaths(): { launcher: string; child: string } {
21:   const launcher = fileURLToPath(import.meta.resolve('@kubeclaw/plugin-foundation/isolation/plugin-sandbox'));
22:   const child = path.join(path.dirname(fileURLToPath(import.meta.url)), 'provider-child.mjs');
23:   if (!fs.existsSync(launcher)) throw new Error('TEST_PROVIDER_SANDBOX_NOT_BUILT');
24:   return { launcher, child };
25: }
26: 
27: function canonicalModule(entry: TestProviderRegistryEntry): string {
28:   const packageRoot = fs.realpathSync(entry.package.root);
29:   const modulePath = fs.realpathSync(path.resolve(packageRoot, entry.registration.entrypoint.module));
30:   if (!modulePath.startsWith(`${packageRoot}${path.sep}`) || !fs.statSync(modulePath).isFile()) {
31:     throw new Error(`TEST_PROVIDER_MODULE_FORBIDDEN:${entry.registration.registrationId}`);
32:   }
33:   return modulePath;
34: }
35: 
36: function providerWorkspace(workspaceRootValue: string, allowed: ProviderInvocationV1['workspace']) {
37:     const workspaceRoot = fs.realpathSync(workspaceRootValue);
38:     const repository = path.resolve(workspaceRoot, allowed.repository);
39:     const scratch = path.resolve(workspaceRoot, allowed.scratch);
40:     const evidence = path.resolve(workspaceRoot, allowed.evidence);
41:     for (const item of [repository, scratch, evidence]) {
42:       if (!item.startsWith(`${workspaceRoot}${path.sep}`)) throw new Error('TEST_PROVIDER_WORKSPACE_FORBIDDEN');
43:     }
44:     return { repository, scratch, evidence };
45: }
