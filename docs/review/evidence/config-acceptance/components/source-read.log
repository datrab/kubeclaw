34:             const raw = await this.#run(['get', 'busternamespacelease', leaseName, '-n', this.#settings.controllerNamespace, '-o', 'json'], null, signal, requestTimeoutMs);
35:             const value = object(JSON.parse(raw), 'lease');
36:             const status = object(value.status ?? {}, 'lease.status');
