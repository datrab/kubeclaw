120:   }
121:   async #run(args: readonly string[], input: string | null, signal: AbortSignal, timeout = this.#maximumExecutionMs): Promise<string> {
122:     if (signal.aborted) throw new Error('TAILSCALE_EXPOSURE_CANCELLED');
