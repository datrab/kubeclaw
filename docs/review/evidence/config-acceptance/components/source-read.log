23: 
24: export interface BusterRemotePlanServiceOptions extends BusterCapabilityRuntimeOptions {
25:   readonly store: PreparedBusterPlanJobStore;
26:   readonly preparation: BusterPreparation;
27:   readonly registry: RegistrySnapshot;
28:   readonly workerRevision: string;
29:   readonly runtimeRoot: string;
30:   readonly admission: BusterAdmissionSettings;
31:   readonly workerLocalRuntime: LocalWorkerRuntimePolicy;
32:   readonly executionPolicy: BusterExecutionSettings;
33:   readonly dependencyReadiness: BusterDependencyReadinessSettings;
34:   readonly now?: () => Date;
35:   readonly execute?: (
36:     job: PreparedPlanJob,
37:     paths: Readonly<{ jobRoot: string; repositoryRoot: string; sourceRepositoryRoot: string; workspaceRoot: string; artifactRoot: string; observabilityRoot: string }>,
38:     signal: AbortSignal,
39:   ) => Promise<TestPlanRunResult>;
40: }
41: 
42: 
43: function configuredBuildkitReadiness(options: BusterRemotePlanServiceOptions): BuildkitReadiness | undefined {
44:   if (!options.allowedCapabilities.has('container.build')) return undefined;
45:   if (!options.containerBuild) throw new Error('BUSTER_READINESS_BUILDKIT_CONFIG_REQUIRED');
46:   return new BuildkitReadiness({ buildctlExecutable: options.containerBuild.buildctlExecutable,
47:     buildkitHost: options.containerBuild.buildkitHost, maximumExecutionMs: options.dependencyReadiness.maximumExecutionMs,
48:     maximumOutputBytes: options.dependencyReadiness.maximumOutputBytes });
49: }
50: 
51: export class BusterRemotePlanService {
52:   readonly #options: BusterRemotePlanServiceOptions;
53:   readonly #now: () => Date;
54:   readonly #active = new Map<string, AbortController>();
55:   readonly #executions = new Map<string, Promise<void>>();
56:   readonly #queue = new Map<string, BusterStagedAdmission>();
57:   readonly #weights = new Map<string, number>();
58:   #submission: Promise<void> = Promise.resolve();
59:   #stopping = false;
60:   #executionFailure: Error | null = null;
61:   #recovered = false;
62:   readonly #buildkitReadiness: BuildkitReadiness | undefined;
63:   readonly #maximumActiveJobs: number;
64:   readonly #maximumQueuedJobs: number;
65:   readonly #maximumConcurrentAttempts: number;
66: 
67:   constructor(options: BusterRemotePlanServiceOptions) {
68:     const executionPolicy = validateBusterExecutionSettings(options.executionPolicy);
69:     const workerLocalRuntime = validateLocalWorkerRuntimePolicy(options.workerLocalRuntime);
70:     const dependencyReadiness = validateBusterDependencyReadinessSettings(options.dependencyReadiness);
71:     if (!/^[a-f0-9]{40,64}$/u.test(options.workerRevision)) throw new Error('BUSTER_REMOTE_WORKER_REVISION_INVALID');
72:     this.#options = { ...options, workerLocalRuntime, dependencyReadiness, executionPolicy };
73:     this.#buildkitReadiness = configuredBuildkitReadiness(this.#options);
74:     this.#now = options.now ?? (() => new Date());
75:     const admission = validateBusterAdmissionSettings(options.admission);
76:     this.#maximumActiveJobs = admission.maximumActiveJobs;
77:     this.#maximumQueuedJobs = admission.maximumQueuedJobs;
78:     this.#maximumConcurrentAttempts = admission.maximumConcurrentAttempts;
79:   }
80: 
81:   #validateAuthority(job: PreparedPlanJob): void {
82:     if (job.plan.registrySnapshotDigest !== this.#options.registry.snapshotDigest) {
83:       throw new Error('BUSTER_REMOTE_REGISTRY_SNAPSHOT_MISMATCH');
84:     }
85:     for (const node of job.plan.nodes) {
86:       const entry = this.#options.registry.testProviderContracts.get(node.provider.contractId);
87:       if (!entry) throw new Error(`BUSTER_REMOTE_PROVIDER_MISSING:${node.id}`);
88:       if (
89:         entry.registration.registrationId !== node.provider.registrationId
90:         || entry.registration.package.packageId !== node.provider.packageId
91:         || entry.registration.package.packageVersion !== node.provider.packageVersion
92:         || entry.registration.package.contentDigest !== node.provider.contentDigest
93:       ) throw new Error(`BUSTER_REMOTE_PROVIDER_IDENTITY_MISMATCH:${node.id}`);
94:       const allowed = new Set(entry.registration.capabilities);
95:       for (const capability of job.grants[node.id] ?? []) {
96:         if (!allowed.has(capability) || !this.#options.allowedCapabilities.has(capability)) {
97:           throw new Error(`BUSTER_REMOTE_CAPABILITY_DENIED:${node.id}:${capability}`);
98:         }
99:       }
100:     }
101:   }
102: 
103:   bootstrapReady(): boolean { return this.#recovered && !this.#stopping; }
104: 
105:   async readiness() {
106:     const initialized = this.bootstrapReady();
107:     const dependency = initialized ? await this.#buildkitReadiness?.check() : undefined;
108:     const currentInitialized = this.bootstrapReady();
109:     const ready = currentInitialized && dependency?.ok !== false;
110:     return { schemaVersion: 'buster-plan-readiness.v1', ready,
111:       code: ready ? 'BUSTER_READY' : currentInitialized ? 'BUSTER_DEPENDENCY_UNAVAILABLE' : 'BUSTER_NOT_BOOTSTRAPPED' };
112:   }
113: 
114:   async #assertDependencies(): Promise<void> {
115:     if ((await this.#buildkitReadiness?.check())?.ok === false) throw new Error('BUSTER_DEPENDENCY_UNAVAILABLE');
116:   }
117: 
118:   async submit(chunks: AsyncIterable<Uint8Array>): Promise<RemotePlanStatusV1> {
119:     if (this.#stopping) throw new Error('BUSTER_REMOTE_SHUTTING_DOWN');
120:     let release!: () => void;
121:     const prior = this.#submission;
122:     this.#submission = new Promise<void>((resolve) => { release = resolve; });
123:     await prior;
124:     try {
125:       let replay: RemotePlanStatusV1 | undefined;
126:       const staged = await this.#options.preparation.stage(chunks, async job => {
127:         this.#validateAuthority(job);
128:         if (this.#stopping) throw new Error('BUSTER_REMOTE_SHUTTING_DOWN');
129:         const known = (await this.#options.store.records()).find(record => record.payload.job.jobId === job.jobId);
130:         if (known) {
131:           if (known.payload.job.requestDigest !== job.requestDigest) throw new Error('BUSTER_REMOTE_JOB_CONFLICT');
132:           replay = known.payload.status;
133:           if (replay.state === 'accepted' && !this.#active.has(job.jobId)) {
134:             await this.#assertDependencies();
135:             if (known.payload.input === null) throw new Error('BUSTER_JOB_RECORD_INVALID');
136:             this.#start(known.payload);
137:           }
138:           return false;
139:         }
140:         if (job.maximumConcurrency > this.#maximumConcurrentAttempts) throw new Error('BUSTER_REMOTE_CONCURRENCY_EXCEEDS_SERVICE_LIMIT');
141:         if (this.#queue.size >= this.#maximumQueuedJobs) throw new Error('BUSTER_REMOTE_ADMISSION_FULL');
142:         await this.#assertDependencies();
143:         return true;
144:       });
145:       if (!staged) {
146:         if (!replay) throw new Error('BUSTER_PREPARATION_DECLINE_INVALID');
147:         return replay;
148:       }
149:       if (this.#stopping) throw new Error('BUSTER_REMOTE_SHUTTING_DOWN');
150:       const status = await this.#options.store.accept(staged, this.#now().toISOString());
151:       if (status.state === 'accepted' && !this.#active.has(staged.job.jobId)) this.#start(staged);
152:       return status;
153:     } finally { release(); }
154:   }
155: 
156:   async status(jobId: string): Promise<RemotePlanStatusV1> {
157:     return (await this.#options.store.get(jobId)).payload.status;
158:   }
159: 
160:   async evidence(jobId: string, contentDigest: string, maximumBytes: number): Promise<Buffer> {
161:     if (!/^sha256:[a-f0-9]{64}$/u.test(contentDigest)) throw new Error('BUSTER_REMOTE_EVIDENCE_DIGEST_INVALID');
162:     if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 0) throw new Error('BUSTER_REMOTE_EVIDENCE_LIMIT_INVALID');
163:     const stored = await this.#options.store.get(jobId);
164:     const status = stored.payload.status;
165:     if (status.state !== 'completed' || !status.result) throw new Error('BUSTER_REMOTE_EVIDENCE_NOT_READY');
166:     const result = JSON.parse((await this.#options.store.result(jobId, status.result.contentDigest,
167:       status.result.sizeBytes)).toString('utf8')) as RemotePlanResultV1;
168:     const matches = resultArtifacts(result).filter(artifact => artifact.contentDigest === contentDigest);
169:     if (matches.length === 0) throw new Error('BUSTER_REMOTE_EVIDENCE_NOT_FOUND');
170:     if (matches.some(item => item.sizeBytes !== matches[0]!.sizeBytes)) throw new Error('BUSTER_REMOTE_EVIDENCE_IDENTITY_CONFLICT');
171:     const runtimeRoot = stored.payload.resultOrigin?.kind === 'historical'
172:       ? this.#options.runtimeRoot : preparedPlanRuntimeRoot(this.#options.runtimeRoot);
173:     let bytes!: Buffer;
174:     for (const artifact of matches) bytes = await readJobArtifact(runtimeRoot, jobId, artifact, maximumBytes);
175:     return bytes;
176:   }
177: 
178:   async result(jobId: string, contentDigest: string, maximumBytes: number): Promise<Buffer> {
179:     return this.#options.store.result(jobId, contentDigest, maximumBytes);
180:   }
181: 
182:   async cancel(jobId: string): Promise<RemotePlanStatusV1> {
183:     const status = await this.#options.store.requestCancellation(jobId, this.#now().toISOString());
184:     if (status.state !== 'cancelling') return status;
185:     this.#queue.delete(jobId);
186:     this.#active.get(jobId)?.abort(new Error('BUSTER_REMOTE_CANCELLED'));
187:     if (!this.#active.has(jobId)) {
188:       return this.#options.store.transition(
189:         jobId, ['cancelling'], 'cancelled', this.#now().toISOString(), { error: 'cancelled before execution' },
190:       );
191:     }
192:     return status;
193:   }
194: 
195:   async recover(): Promise<void> {
196:     this.#recovered = false;
197:     for (const record of await this.#options.store.records()) {
198:       const prepared = record.payload;
199:       const { job, status } = prepared;
200:       if (status.state === 'accepted') await this.#recoverAccepted(prepared);
201:       else if (status.state === 'running') {
202:         await this.#options.store.transition(job.jobId, ['running'], 'failed', this.#now().toISOString(), {
203:           error: 'BUSTER_REMOTE_EXECUTION_INTERRUPTED',
204:         });
205:       } else if (status.state === 'cancelling') {
206:         await this.#options.store.transition(job.jobId, ['cancelling'], 'cancelled', this.#now().toISOString(), {
207:           error: 'cancelled during restart recovery',
208:         });
209:       }
210:       // A previous host's terminal record does not prove orphan quiescence.
211:       // Retain workspace inputs until an ownership reconciliation can prove it.
212:     }
213:     this.#recovered = true;
214:   }
215: 
216:   async shutdown(timeoutMs: number): Promise<void> {
217:     if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1) {
218:       throw new Error('BUSTER_REMOTE_SHUTDOWN_TIMEOUT_INVALID');
219:     }
220:     this.#stopping = true; this.#queue.clear();
221:     for (const controller of this.#active.values()) {
222:       controller.abort(new Error('BUSTER_REMOTE_SHUTDOWN'));
223:     }
224:     const dependencyShutdown = this.#buildkitReadiness?.shutdown();
225:     let timer: NodeJS.Timeout | undefined;
226:     try {
227:       const outcomes = await Promise.race([
228:         Promise.allSettled([this.#submission, ...this.#executions.values(), dependencyShutdown]),
229:         new Promise<never>((_resolve, reject) => {
230:           timer = setTimeout(() => reject(new Error('BUSTER_REMOTE_SHUTDOWN_TIMEOUT')), timeoutMs);
231:         }),
232:       ]);
233:       if (this.#executionFailure) throw this.#executionFailure;
234:       for (const outcome of outcomes) {
235:         if (outcome.status === 'rejected') throw outcome.reason;
236:       }
237:     } finally {
238:       if (timer) clearTimeout(timer);
239:     }
240:   }
241: 
242:   #start(prepared: BusterStagedAdmission): void {
243:     const { job } = prepared;
244:     if (this.#stopping || this.#active.has(job.jobId)) return;
245:     this.#queue.set(job.jobId, prepared); this.#drain();
246:   }
247: 
248:   #drain(): void {
249:     if (this.#stopping) return;
250:     for (const [id, prepared] of this.#queue) {
251:       const { job } = prepared;
252:       const used = [...this.#weights.values()].reduce((a, b) => a + b, 0);
253:       if (this.#active.size >= this.#maximumActiveJobs || used + job.maximumConcurrency > this.#maximumConcurrentAttempts) return;
254:       this.#queue.delete(id);
255:       const controller = new AbortController(); this.#active.set(id, controller); this.#weights.set(id, job.maximumConcurrency);
256:       const execution = this.#execute(prepared, controller).catch((error: unknown) => {
257:         // Normal execution failures are persisted by #execute. A rejection here
258:         // means that durable failure recording failed; retain its ownership even
259:         // after this execution leaves the active map.
260:         this.#executionFailure ??= error instanceof Error ? error : new Error('BUSTER_REMOTE_EXECUTION_PERSISTENCE_FAILED', { cause: error });
261:         this.#stopping = true;
262:         this.#queue.clear();
263:       }).finally(() => {
264:         this.#active.delete(id); this.#executions.delete(id); this.#weights.delete(id); this.#drain();
265:       });
266:       this.#executions.set(id, execution);
267:     }
268:   }
269: 
270:   async #recoverAccepted(prepared: StoredPreparedPlanJob): Promise<void> {
271:     const { job } = prepared;
272:     try {
273:       if (prepared.input === null) throw new Error('BUSTER_JOB_RECORD_INVALID');
274:       this.#options.store.validate(prepared);
275:       this.#validateAuthority(job);
276:       if (job.maximumConcurrency > this.#maximumConcurrentAttempts) throw new Error('BUSTER_REMOTE_CONCURRENCY_EXCEEDS_SERVICE_LIMIT');
277:       this.#start(prepared);
278:     } catch (error) {
279:       await this.#options.store.transition(job.jobId, ['accepted'], 'failed', this.#now().toISOString(), {
280:         error: error instanceof Error ? error.message : String(error),
281:       });
282:     }
283:   }
284: 
285:   async #execute(prepared: BusterStagedAdmission, controller: AbortController): Promise<void> {
286:     await executeBusterPreparedJob(this.#options, prepared, controller.signal, this.#now);
287:   }
288: }

SOURCE skills/buster/engine/test-gates/report-adapter-runtime.ts SHA256 47e65214958d6df49a39d71cef89c660bdb730a3cdee0a450006d83dafdaaf3d
1: import { validateBusterReportSettings, validateBusterProcessInputSettings, type BusterProcessInputSettings, type BusterReportExecutionSettings } from '../../../common/plugin-runtime/foundation/config/buster-execution.ts';
2: import { readPackage, writePackageSnapshot } from './report-adapter-package.ts';
3: import type { ReportArtifactReader } from './report-artifact-reader.ts';
4: export { FileReportArtifactReader, type ReportArtifactReader } from './report-artifact-reader.ts';
5: import crypto from 'node:crypto';
6: import { ProcessInputCleanupError, runProcessInput } from './process-input.ts';
7: import fs from 'node:fs';
8: import path from 'node:path';
9: import process from 'node:process';
10: import { fileURLToPath } from 'node:url';
11: import type { ArtifactRefV1, ReportAdapterResultV1 } from '@kubeclaw/pipeline-test-gate-contract';
12: import { validatePipelineTestGateContract } from '@kubeclaw/pipeline-test-gate-contract';
13: import type { ReportAdapterLimits, ReportAdapterOutput } from '@kubeclaw/plugin-sdk';
14: import type { ReportAdapterRegistryEntry } from '@kubeclaw/plugin-foundation/registry/types';
15: 
16: export interface ReportAdapterRuntimeLimits extends ReportAdapterLimits {
17:   readonly maximumSourceBytes: number;
18:   readonly maximumResultBytes: number;
19:   readonly timeoutMs: number;
20:   readonly memoryBytes: number;
21:   readonly cpuMillis: number;
22:   readonly openFiles: number;
23: }
24: 
25: const REQUIRED_LIMITS = Object.freeze([
26:   'maximumCases', 'maximumFindings', 'maximumCaseFindings',
27:   'maximumSourceBytes', 'maximumResultBytes', 'timeoutMs',
28:   'memoryBytes', 'cpuMillis', 'openFiles',
29: ] as const satisfies readonly (keyof ReportAdapterRuntimeLimits)[]);
30: 
31: function positiveInteger(value: number, code: string): void {
32:   if (!Number.isSafeInteger(value) || value < 1) throw new Error(code);
33: }
34: 
35: function abortable<T>(operation: Promise<T>, signal: AbortSignal): Promise<T> {
36:   if (signal.aborted) return Promise.reject(signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED'));
37:   return new Promise<T>((resolve, reject) => {
38:     const abort = () => finish(signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED'));
39:     const finish = (error?: unknown, value?: T) => {
40:       signal.removeEventListener('abort', abort);
41:       if (error !== undefined) reject(error); else resolve(value as T);
42:     };
43:     signal.addEventListener('abort', abort, { once: true });
44:     operation.then((value) => finish(undefined, value), (error: unknown) => finish(error));
45:   });
46: }
47: 
48: function runtimePaths(): { launcher: string; child: string } {
49:   const launcher = fileURLToPath(import.meta.resolve('@kubeclaw/plugin-foundation/isolation/plugin-sandbox'));
50:   const child = path.join(path.dirname(fileURLToPath(import.meta.url)), 'report-adapter-child.mjs');
51:   if (!fs.existsSync(launcher)) throw new Error('REPORT_ADAPTER_SANDBOX_NOT_BUILT');
52:   return { launcher, child };
53: }
54: 
55: function validateLimits(limits: ReportAdapterRuntimeLimits, policy: BusterReportExecutionSettings): void {
56:   if (!limits || typeof limits !== 'object' || Array.isArray(limits)) {
57:     throw new Error('REPORT_ADAPTER_LIMITS_INVALID');
58:   }
59:   for (const name of REQUIRED_LIMITS) {
60:     positiveInteger(limits[name], `REPORT_ADAPTER_LIMIT_INVALID:${name}`);
61:   }
62:   // Structural maxima are reportCase/reportAdapterResult constraints in pipeline-test-gate.v1.schema.json.
63:   if (limits.maximumCases > 5_000 || limits.maximumFindings > 5_000 || limits.maximumCaseFindings > 100) {
64:     throw new Error('REPORT_ADAPTER_DETAIL_LIMIT_EXCEEDS_CONTRACT');
65:   }
66:   const selectedCeilings = {
67:     maximumCases: policy.maximumCases, maximumFindings: policy.maximumFindings,
68:     maximumCaseFindings: policy.maximumCaseFindings,
69:     maximumSourceBytes: policy.maximumSourceBytes, maximumResultBytes: policy.maximumAggregateResultBytes,
70:     timeoutMs: policy.maximumTimeoutMs, memoryBytes: policy.memoryBytes,
71:     cpuMillis: Math.max(policy.minimumCpuTimeMs, Math.floor(policy.maximumTimeoutMs / 1000) * 1000),
72:     openFiles: policy.maximumOpenFiles,
73:   };
74:   for (const [name, maximum] of Object.entries(selectedCeilings)) {
75:     if (limits[name as keyof typeof selectedCeilings] > maximum) throw new Error(`REPORT_ADAPTER_HARD_LIMIT_EXCEEDED:${name}`);
76:   }
77:   if (limits.cpuMillis < policy.minimumCpuTimeMs) throw new Error('REPORT_ADAPTER_CPU_LIMIT_BELOW_POLICY');
78:   if (limits.openFiles < policy.minimumOpenFiles) throw new Error('REPORT_ADAPTER_OPEN_FILE_LIMIT_TOO_LOW');
79:   const requiredMemory = policy.runtimeMemoryReserveBytes
80:     + (limits.maximumSourceBytes * 3)
81:     + (limits.maximumResultBytes * 2);
82:   if (limits.memoryBytes < requiredMemory) throw new Error('REPORT_ADAPTER_MEMORY_LIMIT_INCOMPATIBLE');
83: }
84: 
85: function bindReportResult(value: ReportAdapterOutput, entry: ReportAdapterRegistryEntry,
86:   artifact: ArtifactRefV1, limits: ReportAdapterRuntimeLimits): ReportAdapterResultV1 {
87:   const result: ReportAdapterResultV1 = {
88:     ...value,
89:     schemaVersion: 'report-adapter-result.v1',
90:     adapter: {
91:       adapterId: entry.registration.adapterId,
92:       format: entry.registration.format,
93:       contractVersion: entry.registration.contractVersion,
94:       package: { ...entry.registration.package },
95:     },
96:     sourceArtifact: { ...artifact },
97:   };
98:   validatePipelineTestGateContract('reportAdapterResult', result);
99:   if (result.cases.length > limits.maximumCases) throw new Error('REPORT_ADAPTER_CASE_LIMIT');
100:   if (result.findings.length > limits.maximumFindings) throw new Error('REPORT_ADAPTER_FINDING_LIMIT');
101:   if (result.cases.some((reportCase) => reportCase.findings.length > limits.maximumCaseFindings)) {
102:     throw new Error('REPORT_ADAPTER_CASE_FINDING_LIMIT');
103:   }
104:   return Object.freeze(structuredClone(result));
105: }
106: 
107: export class RegisteredReportAdapterRuntime {
108:   readonly #policy: BusterReportExecutionSettings;
109:   readonly #processInputPolicy: BusterProcessInputSettings;
110:   readonly #reader: ReportArtifactReader;
111:   readonly #runtimeRoot: string;
112:   readonly #runtimeRootIdentity: { readonly dev: number; readonly ino: number };
113: 
114:   constructor(reader: ReportArtifactReader, runtimeRoot: string, policy: BusterReportExecutionSettings, processInputPolicy: BusterProcessInputSettings) {
115:     this.#processInputPolicy = validateBusterProcessInputSettings(processInputPolicy);
116:     this.#policy = validateBusterReportSettings(policy);
117:     if (!path.isAbsolute(runtimeRoot)) throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_NOT_ABSOLUTE');
118:     const resolvedRoot = path.resolve(runtimeRoot);
119:     if (resolvedRoot === path.parse(resolvedRoot).root) throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_TOO_BROAD');
120:     fs.mkdirSync(runtimeRoot, { recursive: true, mode: 0o700 });
121:     const rootStat = fs.lstatSync(runtimeRoot);
122:     if (!rootStat.isDirectory() || rootStat.isSymbolicLink()) throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_FORBIDDEN');
123:     if (typeof process.getuid === 'function' && rootStat.uid !== process.getuid()) {
124:       throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_OWNER_MISMATCH');
125:     }
126:     const parentStat = fs.statSync(path.dirname(runtimeRoot));
127:     const sticky = (parentStat.mode & 0o1000) !== 0;
128:     const writableByOthers = (parentStat.mode & 0o022) !== 0;
129:     if (writableByOthers) {
130:       const currentUid = typeof process.getuid === 'function' ? process.getuid() : undefined;
131:       const trustedOwner = currentUid === undefined || parentStat.uid === currentUid || parentStat.uid === 0;
132:       if (!sticky || !trustedOwner) throw new Error('REPORT_ADAPTER_RUNTIME_PARENT_FORBIDDEN');
133:     }
134:     fs.chmodSync(runtimeRoot, 0o700);
135:     this.#reader = reader;
136:     this.#runtimeRoot = fs.realpathSync(runtimeRoot);
137:     const identity = fs.statSync(this.#runtimeRoot);
138:     this.#runtimeRootIdentity = { dev: identity.dev, ino: identity.ino };
139:   }
140: 
141:   #assertRuntimeRoot(): void {
142:     const current = fs.lstatSync(this.#runtimeRoot);
143:     const canonical = fs.realpathSync(this.#runtimeRoot);
144:     if (!current.isDirectory() || current.isSymbolicLink() || canonical !== this.#runtimeRoot
145:       || current.dev !== this.#runtimeRootIdentity.dev || current.ino !== this.#runtimeRootIdentity.ino) {
146:       throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_CHANGED');
147:     }
148:   }
149: 
150:   async adapt(entry: ReportAdapterRegistryEntry, artifact: ArtifactRefV1,
151:     limits: ReportAdapterRuntimeLimits, signal?: AbortSignal): Promise<ReportAdapterResultV1> {
152:     validateLimits(limits, this.#policy);
153:     const deadline = new AbortController();
154:     const timer = setTimeout(() => deadline.abort(new Error('REPORT_ADAPTER_TIMEOUT')), limits.timeoutMs);
155:     const boundedSignal = signal ? AbortSignal.any([signal, deadline.signal]) : deadline.signal;
156:     try {
157:       return await this.#adaptWithinDeadline(entry, artifact, limits, boundedSignal);
158:     } catch (error) {
159:       // The process helper wraps signal aborts after drain; preserve our own deadline identity.
160:       if (deadline.signal.aborted && boundedSignal.reason === deadline.signal.reason
161:         && error instanceof Error && error.message === 'REPORT_ADAPTER_CANCELLED'
162:         && error.cause === deadline.signal.reason) throw deadline.signal.reason;
163:       throw error;
164:     } finally {
165:       clearTimeout(timer);
166:     }
167:   }
168: 
169:   async #readSource(entry: ReportAdapterRegistryEntry, artifact: ArtifactRefV1,
170:     limits: ReportAdapterRuntimeLimits, signal: AbortSignal): Promise<Buffer> {
171:     if (artifact.type !== 'test-report') {
172:       throw new Error(`REPORT_ADAPTER_ARTIFACT_TYPE_FORBIDDEN:${artifact.type}`);
173:     }
174:     if (!entry.registration.mediaTypes.includes(artifact.mediaType)) {
175:       throw new Error(`REPORT_ADAPTER_MEDIA_TYPE_UNSUPPORTED:${artifact.mediaType}`);
176:     }
177:     if (signal.aborted) throw signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED');
178:     const bytes = await abortable(this.#reader.read(artifact, limits.maximumSourceBytes, signal), signal);
179:     if (signal.aborted) throw signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED');
180:     if (bytes.byteLength !== artifact.sizeBytes || bytes.byteLength > limits.maximumSourceBytes) {
181:       throw new Error('REPORT_ARTIFACT_SIZE_MISMATCH');
182:     }
183:     const sourceDigest = `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}`;
184:     if (sourceDigest !== artifact.contentDigest) throw new Error('REPORT_ARTIFACT_DIGEST_MISMATCH');
185:     return bytes;
186:   }
187: 
188:   async #adaptWithinDeadline(entry: ReportAdapterRegistryEntry, artifact: ArtifactRefV1,
189:     limits: ReportAdapterRuntimeLimits, signal: AbortSignal): Promise<ReportAdapterResultV1> {
190:     this.#assertRuntimeRoot();
191:     const bytes = await this.#readSource(entry, artifact, limits, signal);
192:     const expectedDigest = entry.registration.package.contentDigest;
193:     const sourcePackage = await abortable(readPackage(entry.package.root, signal), signal);
194:     if (sourcePackage.digest !== expectedDigest) {
195:       throw new Error(`REPORT_ADAPTER_PACKAGE_DIGEST_MISMATCH:${entry.registration.adapterId}`);
196:     }
197: 
198:     const snapshot = path.join(this.#runtimeRoot, `adapter-${crypto.randomUUID()}`);
199:     let disposalConfirmed = true;
200:     try {
201:       await abortable(writePackageSnapshot(snapshot, sourcePackage.files, signal), signal);
202:       this.#assertRuntimeRoot();
203:       const copiedPackage = await abortable(readPackage(snapshot, signal), signal);
204:       if (copiedPackage.digest !== expectedDigest) throw new Error('REPORT_ADAPTER_PACKAGE_SNAPSHOT_MISMATCH');
205:       if (signal.aborted) throw signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED');
206:       const packageRoot = fs.realpathSync(snapshot);
207:       const modulePath = fs.realpathSync(path.resolve(packageRoot, entry.registration.entrypoint.module));
208:       if (!modulePath.startsWith(`${packageRoot}${path.sep}`) || !fs.statSync(modulePath).isFile()) {
209:         throw new Error('REPORT_ADAPTER_MODULE_FORBIDDEN');
210:       }
211:       const value = await this.#run(entry, artifact, bytes, limits, packageRoot, modulePath, signal);
212:       return bindReportResult(value, entry, artifact, limits);
213:     } catch (error) {
214:       if (error instanceof ProcessInputCleanupError) disposalConfirmed = false;
215:       throw error;
216:     } finally {
217:       if (disposalConfirmed) fs.rmSync(snapshot, { recursive: true, force: true });
218:     }
219:   }
220: 
221:   async #run(entry: ReportAdapterRegistryEntry, artifact: ArtifactRefV1, bytes: Buffer,
222:     limits: ReportAdapterRuntimeLimits, packageRoot: string, modulePath: string,
223:     signal?: AbortSignal): Promise<ReportAdapterOutput> {
224:     if (signal?.aborted) return Promise.reject(signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED'));
225:     if (limits.cpuMillis % 1000 !== 0) return Promise.reject(new Error('REPORT_ADAPTER_CPU_LIMIT_GRANULARITY'));
226:     const runtime = runtimePaths();
227:     const result = await runProcessInput(runtime.launcher, [
228:         String(limits.memoryBytes), String(limits.cpuMillis / 1000),
229:         String(limits.openFiles), process.execPath,
230:         `--max-old-space-size=${Math.max(this.#policy.minimumHeapMiB, Math.floor(limits.memoryBytes / (1024 * 1024) * this.#policy.heapFraction))}`,
231:         '--permission', `--allow-fs-read=${runtime.child}`, `--allow-fs-read=${packageRoot}`,
232:         '--no-addons', '--no-experimental-sqlite', runtime.child,
233:       ], {
234:       processInputPolicy: this.#processInputPolicy, cwd: packageRoot, env: { NODE_NO_WARNINGS: '1' }, ...(signal ? { signal } : {}),
235:       timeoutMs: limits.timeoutMs, maximumOutputBytes: limits.maximumResultBytes,
236:       prefix: 'REPORT_ADAPTER', outputLimitError: 'REPORT_ADAPTER_RESULT_LIMIT', input: `${JSON.stringify({
237:         kind: 'adapt',
238:         modulePath,
239:         exportName: entry.registration.entrypoint.export,
240:         mediaType: artifact.mediaType,
241:         contentBase64: bytes.toString('base64'),
242:         limits: {
243:           maximumCases: limits.maximumCases,
244:           maximumFindings: limits.maximumFindings,
245:           maximumCaseFindings: limits.maximumCaseFindings,
246:         },
247:       })}\n`,
248:     });
249:     const lines = result.stdout.toString('utf8').trim().split('\n');
250:     if (lines.length !== 1) throw new Error('REPORT_ADAPTER_PROTOCOL_INVALID');
251:     let message: { kind?: string; value?: ReportAdapterOutput; error?: string };
252:     try { message = JSON.parse(lines[0]!) as typeof message; }
253:     catch (error) { throw new Error(`REPORT_ADAPTER_PROTOCOL_INVALID:${String(result.code)}:${String(result.signal)}`, { cause: error }); }
254:     if (message.kind === 'result' && result.code === 0 && message.value) return message.value;
255:     throw new Error(`REPORT_ADAPTER_FAILED:${message.error ?? `${String(result.code)}:${String(result.signal)}`}`);
256:   }
257: }

