38:   if (!enabled) return {};
39:   return { kubernetesRuntimeSecurity: { ...policy.runtimeSecurity, kubectlExecutable: binding.kubectlExecutable,
40:     controllerNamespace: binding.controllerNamespace, leaseApiGroup: binding.leaseApiGroup } };
