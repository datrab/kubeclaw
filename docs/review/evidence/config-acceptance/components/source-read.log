SOURCE skills/buster/engine/test-gates/specialist-report-finalization.ts SHA256 2bc8ae28f2f2e9e65616681ba2e2b430b2d3378f6119f6bdc0b0aae5fd7b2d40
1: import type { BusterReportExecutionSettings } from '../../../common/plugin-runtime/foundation/config/buster-execution.ts';
2: import { canonical } from './canonical-value.ts';
3: import type { EvidenceRefV1, ProviderResultV1, ReportAdapterRefV1, ReportAdapterResultV1,
4:   ResolvedPlanNodeV1 } from '@kubeclaw/pipeline-test-gate-contract';
5: import type { RegistrySnapshot, ReportAdapterRegistryEntry } from '@kubeclaw/plugin-foundation/registry/types';
6: import type { WorkerAttemptOperation } from '@kubeclaw/worker-core';
7: import type { ReportAdapterRuntimeLimits } from './report-adapter-runtime.ts';
8: import { finalizeDirectCommandReports } from './report-finalizer.ts';
9: import { validateProviderResultCounts } from './provider-result-validation.ts';
10: 
11: export interface ReportAdapterExecutor {
12:   adapt(entry: ReportAdapterRegistryEntry, artifact: EvidenceRefV1['artifact'], limits: ReportAdapterRuntimeLimits,
13:     signal?: AbortSignal): Promise<ReportAdapterResultV1>;
14: }
15: 
16: type FinalizationContext = Parameters<NonNullable<WorkerAttemptOperation['finalizeResult']>>[0];
17: /** Existing contract data only; executable dependencies are supplied separately. */
18: export interface BusterReportFinalizationInput {
19:   readonly node: ResolvedPlanNodeV1;
20:   readonly providerResult: ProviderResultV1 | null;
21:   readonly evidence: FinalizationContext['evidence'];
22:   readonly specialistResult: FinalizationContext['specialistResult'];
23:   readonly cleanupTimeoutMs: number;
24:   readonly reportPolicy: BusterReportExecutionSettings;
25: }
26: export interface BusterReportFinalizationDependencies {
27:   readonly registry: RegistrySnapshot;
28:   readonly reportAdapterRuntime: ReportAdapterExecutor;
29:   readonly signal: AbortSignal;
30: }
31: 
32: function reportAdapterEntry(registry: RegistrySnapshot, reference: ReportAdapterRefV1): ReportAdapterRegistryEntry {
33:   const entry = [...registry.reportAdapters.values()].find((candidate) =>
34:     candidate.registration.adapterId === reference.adapterId
35:     && candidate.registration.format === reference.format
36:     && candidate.registration.contractVersion === reference.contractVersion
37:     && canonical(candidate.registration.package) === canonical(reference.package));
38:   if (!entry) throw new Error(`TEST_REPORT_ADAPTER_MISSING:${reference.format}`);
39:   return entry;
40: }
41: 
42: export async function finalizeBusterReports(
43:   { node, providerResult, evidence, specialistResult, cleanupTimeoutMs, reportPolicy }: BusterReportFinalizationInput,
44:   { registry, reportAdapterRuntime, signal }: BusterReportFinalizationDependencies,
45: ): Promise<FinalizationContext['specialistResult']> {
46:   if (node.provider.contractId === 'kubeclaw.direct-command@1'
47:     && node.configuration.values.resultMode === 'exit-code') return specialistResult;
48:   if (!providerResult || providerResult.reports.length === 0) return specialistResult;
49:   const evidenceById = new Map(evidence.map((item) => [item.evidenceId, item]));
50:   const reports: ReportAdapterResultV1[] = [];
51:   for (const declared of providerResult.reports) {
52:     const usedReportBytes = Buffer.byteLength(JSON.stringify(reports));
53:     const remainingReportBytes = reportPolicy.maximumAggregateResultBytes - usedReportBytes;
54:     if (remainingReportBytes < 1) throw new Error('TEST_REPORT_RESULT_LIMIT');
55:     const source = evidenceById.get(declared.evidenceId);
56:     if (!source) throw new Error(`TEST_PROVIDER_REPORT_NOT_RETAINED:${declared.evidenceId}`);
57:     const reference = node.reportAdapters.find((item) => item.format === declared.format);
58:     if (!reference) throw new Error(`TEST_REPORT_ADAPTER_NOT_RESOLVED:${declared.format}`);
59:     const adapter = reportAdapterEntry(registry, reference);
60:     const maximumSourceBytes = Math.max(1, Math.min(reportPolicy.maximumSourceBytes, source.artifact.sizeBytes));
61:     const adapterTimeoutMs = Math.min(reportPolicy.maximumTimeoutMs, cleanupTimeoutMs);
62:     reports.push(await reportAdapterRuntime.adapt(adapter, source.artifact, {
63:       maximumCases: reportPolicy.maximumCases,
64:       maximumFindings: reportPolicy.maximumFindings,
65:       maximumCaseFindings: reportPolicy.maximumCaseFindings,
66:       maximumSourceBytes,
67:       maximumResultBytes: remainingReportBytes,
68:       timeoutMs: adapterTimeoutMs,
69:       memoryBytes: reportPolicy.memoryBytes,
70:       cpuMillis: Math.max(reportPolicy.minimumCpuTimeMs, Math.floor(adapterTimeoutMs / 1_000) * 1_000),
71:       openFiles: reportPolicy.maximumOpenFiles,
72:     }, signal));
73:     if (Buffer.byteLength(JSON.stringify(reports)) > reportPolicy.maximumAggregateResultBytes) {
74:       throw new Error('TEST_REPORT_RESULT_LIMIT');
75:     }
76:   }
77:   const providerValue = specialistResult.values.providerResult as unknown as ProviderResultV1;
78:   if (node.provider.contractId !== 'kubeclaw.direct-command@1') {
79:     return {
80:       ...specialistResult,
81:       values: { ...specialistResult.values, reports: structuredClone(reports) } as never,
82:     };
83:   }
84:   const finalizedProvider = finalizeDirectCommandReports(providerValue, reports,
85:     node.mode === 'blocking' && node.configuration.values.resultMode === 'junit-required');
86:   validateProviderResultCounts(finalizedProvider);
87:   return {
88:     ...specialistResult,
89:     values: { ...specialistResult.values, providerResult: finalizedProvider,
90:       reports: structuredClone(reports) } as never,
91:   };
92: }

