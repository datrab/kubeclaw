10: const DNS_LABEL = /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/u;
11: const MAX_TIMER_MS = 2_147_483_647;
12: type JsonObject = Record<string, unknown>;
13: type Execute = (command: string, args: readonly string[], options: Readonly<Record<string, unknown>>)
14:   => Promise<{ stdout?: string; stderr?: string }>;
15: 
16: async function executeProcess(command: string, args: readonly string[], options: Readonly<Record<string, unknown>>, processInputPolicy: BusterProcessInputSettings): Promise<{ stdout: string; stderr: string }> {
17:   const result = await runProcessInput(command, args, {
18:     processInputPolicy,
19:     ...(options.env ? { env: options.env as NodeJS.ProcessEnv } : {}),
20:     ...(options.signal ? { signal: options.signal as AbortSignal } : {}),
21:     input: options.input as string | Buffer | null ?? null,
22:     timeoutMs: options.timeout as number, maximumOutputBytes: options.maxBuffer as number,
23:     prefix: 'TAILSCALE_EXPOSURE_KUBECTL',
24:   });
25:   const stdout = result.stdout.toString('utf8'); const stderr = result.stderr.toString('utf8');
26:   if (result.code !== 0) throw Object.assign(new Error(`TAILSCALE_EXPOSURE_KUBECTL_FAILED:${String(result.code)}:${String(result.signal)}`), { stdout, stderr });
27:   return { stdout, stderr };
28: }
