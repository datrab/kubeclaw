32: function verifiedSnapshot(entry: TestProviderRegistryEntry, workspaceRoot: string, attemptId: string): TestProviderRegistryEntry {
33:   const expected = entry.registration.package.contentDigest;
34:   if (computePackageDigest(entry.package.root) !== expected) {
35:     throw new Error(`TEST_PROVIDER_PACKAGE_DIGEST_MISMATCH:${entry.registration.registrationId}`);
36:   }
37:   const snapshots = path.join(workspaceRoot, 'test-provider-snapshots');
38:   fs.mkdirSync(snapshots, { recursive: true });
39:   const snapshotKey = createHash('sha256').update(attemptId).digest('hex');
40:   const destination = fs.mkdtempSync(path.join(snapshots, `${snapshotKey}-`));
41:   try {
42:     fs.cpSync(entry.package.root, destination, {
43:       recursive: true,
44:       force: true,
45:     });
46:     if (computePackageDigest(destination) !== expected) {
47:       throw new Error(`TEST_PROVIDER_PACKAGE_SNAPSHOT_MISMATCH:${entry.registration.registrationId}`);
48:     }
49:   } catch (error) {
50:     fs.rmSync(destination, { recursive: true, force: true });
51:     throw error;
52:   }
53:   const relativeManifest = path.relative(entry.package.root, entry.package.manifestPath);
54:   const relativeSchema = path.relative(entry.package.root, entry.configSchemaPath);
55:   return {
56:     ...entry,
57:     package: { ...entry.package, root: destination, manifestPath: path.join(destination, relativeManifest) },
58:     configSchemaPath: path.join(destination, relativeSchema),
59:   };
60: }
