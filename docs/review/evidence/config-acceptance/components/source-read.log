31: const EMPTY_COUNTS = Object.freeze({ total: 0, passed: 0, failed: 0, skipped: 0 });
32: function attemptSummary(evidenceFault: string | null, runtimeFault: string | null,
33:   result: WorkerAttemptResultV1 | null): string {
