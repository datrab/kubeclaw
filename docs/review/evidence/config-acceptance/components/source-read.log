24:   return { kubernetesFixture: { ...selected, kubectlExecutable: binding.kubectlExecutable,
25:     controllerNamespace: binding.controllerNamespace, leaseApiGroup: binding.leaseApiGroup, leaseApiVersion: binding.leaseApiVersion,
26:     allowedRegistryPrefixes: registryRepositoryPrefixes.map(repository => `${registryReference}/${repository}`),
27:     runnerSubject: `${binding.controllerNamespace}/${runnerServiceAccount}`,
28:     credentialReaderSubject: `${binding.controllerNamespace}/${credentialReaderServiceAccount}` } };
29: }
