441: export class FileObservabilityAdmissionStore {
442:   readonly #file: string;
443:   readonly #limits: AdmissionStoreLimits;
444:   #queue: Promise<unknown> = Promise.resolve();
445:   constructor(directory: string, limits: AdmissionStoreLimits) {
446:     if (
447:       Object.values(limits).some((value) => !validLimit(value)) ||
448:       limits.maximumBytes <= ADMISSION_METADATA_RESERVE
449:     )
450:       throw new Error("OBSERVABILITY_ADMISSION_LIMIT_INVALID");
451:     this.#file = path.join(directory, "admission.json");
452:     this.#limits = limits;
453:   }
454:   storageDirectory(): string {
455:     return path.dirname(this.#file);
456:   }
457:   #serial<T>(operation: () => Promise<T>): Promise<T> {
458:     const locked = () => withDurableStoreLock(this.#file, operation);
459:     const result = this.#queue.then(locked, locked);
460:     this.#queue = result.then(
461:       () => undefined,
462:       () => undefined,
463:     );
464:     return result;
465:   }
466:   #reason(reason: string): string {
467:     return reason.length <= 256
468:       ? reason
469:       : `${reason.slice(0, 180)}:sha256:${createHash("sha256").update(reason).digest("hex")}`;
470:   }
471:   async #recordOverflow(
472:     state: AdmissionState,
473:     raw: Uint8Array | string,
474:     reason: string,
475:     attributeToRun = true,
476:   ): Promise<void> {
477:     const attributed = attributeToRun ? quarantineAttribution(raw) : null;
478:     if (attributed) {
479:       const overflowItem = {
480:         ...attributed,
481:         itemId: `quarantine-overflow:${attributed.pipelineRunId}`,
482:         subjectId: `quarantine-overflow:${attributed.pipelineRunId}`,
483:         reasonCode: "quarantine-overflow",
484:       };
485:       const alreadyTracked = state.overflowUnresolvedItems.some(
486:         (item) => item.itemId === overflowItem.itemId,
487:       );
488:       if (
489:         !alreadyTracked &&
490:         state.overflowUnresolvedItems.length >=
491:           this.#limits.maximumQuarantineRecords
492:       )
493:         throw new Error("OBSERVABILITY_ADMISSION_FULL");
494:       if (!alreadyTracked) state.overflowUnresolvedItems.push(overflowItem);
495:     }
496:     state.quarantineOverflow = {
497:       count: (state.quarantineOverflow?.count ?? 0) + 1,
498:       lastReceivedAt: new Date().toISOString(),
499:       lastReason: this.#reason(reason),
500:       lastRawDigest: `sha256:${createHash("sha256").update(raw).digest("hex")}`,
501:       lastRawBytes:
502:         typeof raw === "string" ? Buffer.byteLength(raw) : raw.byteLength,
503:     };
504:     if (Buffer.byteLength(canonicalJson(state)) > this.#limits.maximumBytes)
505:       throw new Error("OBSERVABILITY_ADMISSION_FULL");
506:     await writeDurableState(this.#file, state);
507:   }
508:   async #quarantine(
509:     state: AdmissionState,
510:     raw: Uint8Array,
511:     reason: string,
512:   ): Promise<void> {
513:     const boundedReason = this.#reason(reason);
514:     if (state.quarantine.length >= this.#limits.maximumQuarantineRecords) {
515:       await this.#recordOverflow(state, raw, boundedReason);
516:       return;
517:     }
518:     const encoded = Buffer.from(raw).toString("base64");
519:     const attributed = quarantineAttribution(raw);
520:     const candidate = {
521:       ...state,
522:       quarantine: [
523:         ...state.quarantine,
524:         {
525:           quarantineId: `quarantine:${randomUUID()}`,
526:           receivedAt: new Date().toISOString(),
527:           reason: boundedReason,
528:           rawBase64: encoded,
529:         },
530:       ],
531:       unresolvedItems:
532:         attributed &&
533:         !state.unresolvedItems.some((item) => item.itemId === attributed.itemId)
534:           ? [...state.unresolvedItems, attributed]
535:           : state.unresolvedItems,
536:     };
537:     if (
538:       Buffer.byteLength(canonicalJson(candidate.quarantine)) >
539:         this.#limits.maximumQuarantineBytes ||
540:       Buffer.byteLength(canonicalJson(candidate)) >
541:         this.#limits.maximumBytes - ADMISSION_METADATA_RESERVE
542:     ) {
543:       await this.#recordOverflow(state, raw, boundedReason);
544:       return;
545:     }
546:     await writeDurableState(this.#file, candidate);
547:   }
548:   async #rejectOversizedIngress(raw: Uint8Array | string): Promise<void> {
549:     const inputBytes =
550:       typeof raw === "string" ? Buffer.byteLength(raw) : raw.byteLength;
551:     if (inputBytes <= this.#limits.maximumIngressBytes) return;
552:     await this.#serial(async () => {
553:       const state = await readAdmissionState(this.#file, this.#limits);
554:       await this.#recordOverflow(
555:         state,
556:         raw,
557:         "OBSERVABILITY_INGRESS_TOO_LARGE",
558:         false,
559:       );
560:     });
561:     throw new Error("OBSERVABILITY_INGRESS_TOO_LARGE");
562:   }
563:   async #retiredAcknowledgement(state:AdmissionState,key:string,recordDigest:string,bytes:Buffer):Promise<AdmissionAcknowledgementV1|null> {
564:     const retired=state.retiredEntries?.find(entry=>entry.key===key);
565:     if(!retired)return null;
566:     if(retired.acknowledgement.recordDigest!==recordDigest) {
567:       await this.#quarantine(state,bytes,"OBSERVABILITY_ADMISSION_IDENTITY_CONFLICT");
568:       throw new Error("OBSERVABILITY_ADMISSION_IDENTITY_CONFLICT");
569:     }
570:     await resolveAdmissionRetiredEntry(retired);
571:     return structuredClone(retired.acknowledgement);
572:   }
573:   async #admitUnlocked(
574:     state: AdmissionState,
575:     bytes: Buffer,
576:   ): Promise<{
577:     acknowledgement: AdmissionAcknowledgementV1;
578:     state: AdmissionState;
579:   }> {
580:     let record: ProducerRecordV1;
581:     try {
582:       record = decodePipelineObservabilityContract(
583:         "producerRecord",
584:         bytes,
585:       ) as ProducerRecordV1;
586:     } catch (error) {
587:       await this.#quarantine(
588:         state,
589:         bytes,
590:         error instanceof Error ? error.message : "OBSERVABILITY_WIRE_INVALID",
591:       );
592:       throw error;
593:     }
594:     const key = keyOf(record);
595:     const retired = await this.#retiredAcknowledgement(state,key,record.recordDigest,bytes);
596:     if(retired)return {acknowledgement:retired,state};
597:     const existing = state.entries.find((entry) => entry.key === key);
598:     if (existing) {
599:       if (existing.record.recordDigest !== record.recordDigest) {
600:         await this.#quarantine(
601:           state,
602:           bytes,
603:           "OBSERVABILITY_ADMISSION_IDENTITY_CONFLICT",
604:         );
605:         throw new Error("OBSERVABILITY_ADMISSION_IDENTITY_CONFLICT");
606:       }
607:       return {
608:         acknowledgement: this.#ack(existing, "duplicate"),
609:         state,
610:       };
611:     }
612:     if (state.entries.length >= this.#limits.maximumRecords)
613:       throw new Error("OBSERVABILITY_ADMISSION_FULL");
614:     if (!Number.isSafeInteger(state.nextCursor) || state.nextCursor < 1)
615:       throw new Error("OBSERVABILITY_CURSOR_EXHAUSTED");
616:     const entry: AdmissionEntry = {
617:       key,
618:       record,
619:       bytes: bytes.toString("utf8"),
620:       canonicalCursor: state.nextCursor,
621:       admittedAt: new Date().toISOString(),
622:     };
623:     const candidate = {
624:       ...state,
625:       nextCursor: state.nextCursor + 1,
626:       entries: [...state.entries, entry],
627:     };
628:     if (
629:       Buffer.byteLength(canonicalJson(candidate)) >
630:       this.#limits.maximumBytes - ADMISSION_METADATA_RESERVE
631:     )
632:       throw new Error("OBSERVABILITY_ADMISSION_FULL");
633:     await writeDurableState(this.#file, candidate);
634:     return {
635:       acknowledgement: this.#ack(entry, "admitted"),
636:       state: candidate,
637:     };
638:   }
639:   async #recordViews(state: AdmissionState): Promise<ReadonlyArray<AdmittedRecordView>> {
640:     const retired = await resolveAdmissionRetiredEntries(state.retiredEntries ?? []);
641:     return [...state.entries.map((entry) => ({
642:       record: structuredClone(entry.record), canonicalCursor: entry.canonicalCursor, admittedAt: entry.admittedAt,
643:     })),...retired].sort((left,right)=>left.canonicalCursor-right.canonicalCursor);
644:   }
645:   /** Caller holds the original attempt-store fence before acquiring this fence. */
646:   async retireCompletion(input: {operationId:string;actor:string;source:AdmissionCompletionReference;recordDigest:string;authority:AdmissionRetiredEntry['authority']}, authorize:()=>Promise<void>): Promise<{newlyRetired:boolean;releasedBytes:number}> {
647:     const scope=structuredClone(input);
648:     return this.#serial(async()=>{
649:       const state=await readAdmissionState(this.#file,this.#limits);
650:       const prior=state.retiredEntries?.find(item=>item.operationId===scope.operationId);
651:       if(prior) {
652:         if(canonicalJson(prior.authority)!==canonicalJson(scope.authority) || prior.actor!==scope.actor || canonicalJson(prior.source)!==canonicalJson(scope.source) || prior.acknowledgement.recordDigest!==scope.recordDigest)throw new Error("OBSERVABILITY_RETIREMENT_OPERATION_CONFLICT");
653:         await resolveAdmissionRetiredEntry(prior); await authorize();
654:         return {newlyRetired:false,releasedBytes:0};
655:       }
656:       const entry=state.entries.find(item=>item.record.recordDigest===scope.recordDigest && item.record.correlation.pipelineRunId===scope.source.pipelineRunId);
657:       if(!entry)throw new Error("OBSERVABILITY_RETIREMENT_RECORD_MISSING");
658:       const retired:AdmissionRetiredEntry={key:entry.key,acknowledgement:this.#ack(entry,"duplicate"),source:scope.source,operationId:scope.operationId,actor:scope.actor,authority:scope.authority};
659:       const views=await this.#recordViews(state);
660:       if(views.filter(item=>item.record.correlation.pipelineRunId===scope.source.pipelineRunId && canonicalJson(item.record.producer)===canonicalJson(entry.record.producer)).length!==1)throw new Error("OBSERVABILITY_RETIREMENT_PRODUCER_NOT_CLOSED");
661:       if([...state.gaps.filter(item=>item.pipelineRunId===scope.source.pipelineRunId && item.state!=="restored"),...state.unresolvedItems.filter(item=>item.pipelineRunId===scope.source.pipelineRunId),...state.overflowUnresolvedItems.filter(item=>item.pipelineRunId===scope.source.pipelineRunId)].length)throw new Error("OBSERVABILITY_RETIREMENT_INCOMPLETE");
662:       const resolved=await resolveAdmissionRetiredEntry(retired);
663:       if(canonicalJson(resolved.record)!==canonicalJson(entry.record))throw new Error("OBSERVABILITY_RETIREMENT_RECORD_CHANGED");
664:       const candidate:AdmissionState={...state,schemaVersion:"observability-admission-store.v2",entries:state.entries.filter(item=>item!==entry),retiredEntries:[...(state.retiredEntries??[]),retired]};
665:       assertAdmissionReplay(candidate,this.#limits);
666:       const after=Buffer.byteLength(canonicalJson(candidate)),releasedBytes=Buffer.byteLength(canonicalJson(state))-after;
667:       if(releasedBytes<=0 || after>this.#limits.maximumBytes)throw new Error("OBSERVABILITY_RETIREMENT_NO_CAPACITY_GAIN");
668:       await authorize();
669:       await writeDurableState(this.#file,candidate);
670:       return {newlyRetired:true,releasedBytes};
671:     });
672:   }
673:   async admit(raw: Uint8Array | string): Promise<AdmissionResult> {
674:     await this.#rejectOversizedIngress(raw);
675:     return this.#serial(async () => {
676:       const bytes = Buffer.from(raw);
677:       const admitted = await this.#admitUnlocked(
678:         await readAdmissionState(this.#file, this.#limits),
679:         bytes,
680:       );
681:       return { acknowledgement: admitted.acknowledgement };
682:     });
683:   }
684:   async admitAndRead(
685:     raw: Uint8Array | string,
686:   ): Promise<AdmissionWithRecordsResult> {
687:     await this.#rejectOversizedIngress(raw);
688:     return this.#serial(async () => {
689:       const admitted = await this.#admitUnlocked(
690:         await readAdmissionState(this.#file, this.#limits),
691:         Buffer.from(raw),
692:       );
693:       return {
694:         acknowledgement: admitted.acknowledgement,
695:         records: await this.#recordViews(admitted.state),
696:       };
697:     });
698:   }
699:   #ack(
700:     entry: AdmissionEntry,
701:     state: "admitted" | "duplicate",
702:   ): AdmissionAcknowledgementV1 {
703:     return {
704:       schemaVersion: "admission-acknowledgement.v1",
705:       recordId: entry.record.recordId,
706:       producer: entry.record.producer,
707:       pipelineRunId: entry.record.correlation.pipelineRunId,
708:       sequence: entry.record.sequence,
709:       state,
710:       admittedAt: entry.admittedAt,
711:       canonicalCursor: entry.canonicalCursor,
712:       recordDigest: entry.record.recordDigest,
713:     };
714:   }
715:   async snapshot(): Promise<Readonly<AdmissionState>> {
716:     return this.#serial(() => readAdmissionState(this.#file, this.#limits));
717:   }
718:   async admittedRecords(): Promise<ReadonlyArray<AdmittedRecordView>> {
719:     return this.#serial(async () => {
720:       return this.#recordViews(await readAdmissionState(this.#file, this.#limits));
721:     });
722:   }
723:   async admittedTail(
724:     pipelineRunId: string,
725:     fromCursor: number,
726:   ): Promise<ReadonlyArray<AdmittedRecordView>> {
727:     return (await this.admittedTailSnapshot(pipelineRunId, fromCursor)).records;
728:   }
729:   async admittedTailSnapshot(
730:     pipelineRunId: string,
731:     fromCursor: number,
732:   ): Promise<AdmissionTailSnapshot> {
733:     if (!Number.isSafeInteger(fromCursor) || fromCursor < 1)
734:       throw new Error("OBSERVABILITY_CURSOR_INVALID");
735:     return this.#serial(async () => {
736:       const state = await readAdmissionState(this.#file, this.#limits);
737:       const records = (await this.#recordViews(state))
738:         .filter(
739:           (entry) =>
740:             entry.canonicalCursor >= fromCursor &&
741:             entry.record.correlation.pipelineRunId === pipelineRunId,
742:         )
743:         .map((entry) => ({
744:           record: structuredClone(entry.record),
745:           canonicalCursor: entry.canonicalCursor,
746:           admittedAt: entry.admittedAt,
747:         }));
748:       return { records, nextCursor: state.nextCursor };
749:     });
750:   }
751:   async recordGap(gap: ProducerGapReportV1): Promise<void> {
752:     validatePipelineObservabilityContract("gapReport", gap);
753:     const snapshot = structuredClone(gap);
754:     await this.#serial(async () => {
755:       const state = await readAdmissionState(this.#file, this.#limits);
756:       const existing = state.gaps.find(
757:         (item) =>
758:           item.pipelineRunId === snapshot.pipelineRunId &&
759:           item.producer.producerId === snapshot.producer.producerId &&
760:           item.producer.bootId === snapshot.producer.bootId &&
761:           item.producer.producerType === snapshot.producer.producerType &&
762:           item.fromSequence === snapshot.fromSequence &&
763:           item.toSequence === snapshot.toSequence,
764:       );
765:       if (existing && canonicalJson(existing) === canonicalJson(snapshot))
766:         return;
767:       if (snapshot.state === "restored") {
768:         if (!existing || existing.state === "restored")
769:           throw new Error("OBSERVABILITY_GAP_RESTORATION_UNDECLARED");
770:         const expectedCount = snapshot.toSequence - snapshot.fromSequence + 1;
771:         const admitted = new Set(
772:           (await this.#recordViews(state))
773:             .filter(
774:               (entry) =>
775:                 entry.record.correlation.pipelineRunId ===
776:                   snapshot.pipelineRunId &&
777:                 entry.record.producer.producerId ===
778:                   snapshot.producer.producerId &&
779:                 entry.record.producer.bootId === snapshot.producer.bootId &&
780:                 entry.record.producer.producerType ===
781:                   snapshot.producer.producerType &&
782:                 entry.record.sequence >= snapshot.fromSequence &&
783:                 entry.record.sequence <= snapshot.toSequence,
784:             )
785:             .map((entry) => entry.record.sequence),
786:         );
787:         if (admitted.size !== expectedCount)
788:           throw new Error("OBSERVABILITY_GAP_RESTORATION_UNPROVED");
789:       }
790:       const gaps = state.gaps.filter((item) => item !== existing);
791:       const candidate = { ...state, gaps: [...gaps, snapshot] };
792:       if (
793:         Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes
794:       )
795:         throw new Error("OBSERVABILITY_ADMISSION_FULL");
796:       await writeDurableState(this.#file, candidate);
797:     });
798:   }
799:   async observabilityIssues(pipelineRunId: string): Promise<{
800:     missingRanges: ProducerGapReportV1[];
801:     unresolvedItems: UnresolvedObservabilityItemV1[];
802:   }> {
803:     return this.#serial(async () => {
804:       const state = await readAdmissionState(this.#file, this.#limits);
805:       return {
806:         missingRanges: state.gaps
807:           .filter(
808:             (item) =>
809:               item.pipelineRunId === pipelineRunId && item.state !== "restored",
810:           )
811:           .map((item) => structuredClone(item)),
812:         unresolvedItems: [
813:           ...state.unresolvedItems
814:             .filter((item) => item.pipelineRunId === pipelineRunId)
815:             .map(({ pipelineRunId: _pipelineRunId, ...item }) =>
816:               structuredClone(item),
817:             ),
818:           ...state.overflowUnresolvedItems
819:             .filter((item) => item.pipelineRunId === pipelineRunId)
820:             .map(({ pipelineRunId: _pipelineRunId, ...item }) =>
821:               structuredClone(item),
822:             ),
823:         ],
824:       };
825:     });
826:   }
827: }
828: 
829: export async function deliverPending(
830:   outbox: FileProducerOutbox,
831:   admission: FileObservabilityAdmissionStore,
832: ): Promise<number> {
833:   let delivered = 0;
834:   for (const entry of await outbox.pending()) {
835:     const { acknowledgement } = await admission.admit(entry.bytes);
836:     await outbox.acknowledge(acknowledgement);
837:     delivered += 1;
838:   }
839:   return delivered;
840: }

SOURCE skills/common/plugin-runtime/foundation/observability/durable-record-dependency.ts SHA256 b9d7866810eaa8b77681aa42c69b8f4651229317b0f73d0077b1866f97c1e73a
1: import fs from 'node:fs/promises';
2: import { readDurableState } from './durable-delivery.ts';
3: import { assertDurableRecordReplay, type DurableRecord, type DurableRecordState } from './record-retirement.ts';
4: 
5: /** Reject aliased writer namespaces before a caller acquires a second lock. */
6: export async function assertDistinctStoreFiles(ownerFile: string, dependencyFile: string): Promise<void> {
7:   if (ownerFile === dependencyFile) throw new Error('DURABLE_RECORD_RETAINED_STORE_ALIAS');
8:   const [ownerPath, dependencyPath] = await Promise.all([fs.realpath(ownerFile), fs.realpath(dependencyFile)]);
9:   if (ownerPath !== ownerFile || dependencyPath !== dependencyFile || ownerPath === dependencyPath) {
10:     throw new Error('DURABLE_RECORD_RETAINED_STORE_ALIAS');
11:   }
12:   const [owner, dependency] = await Promise.all([fs.lstat(ownerPath), fs.lstat(dependencyPath)]);
13:   if (!owner.isFile() || !dependency.isFile() || owner.nlink !== 1 || dependency.nlink !== 1
14:     || owner.dev === dependency.dev && owner.ino === dependency.ino) {
15:     throw new Error('DURABLE_RECORD_RETAINED_STORE_ALIAS');
16:   }
17: }
18: 
19: /** Read-owned clones while the caller holds this store's original writer fence. */
20: export async function readStoreRecords<T>(file: string, maximumBytes: number, stream: string): Promise<readonly DurableRecord<T>[]> {
21:   const state = await readDurableState<DurableRecordState>(file, { schemaVersion: 'pipeline-durable-record-store.v1', records: [] }, maximumBytes);
22:   assertDurableRecordReplay(state);
23:   return structuredClone(state.records.filter(record => record.stream === stream)) as DurableRecord<T>[];
24: }
25: 
26: interface RetainedStoreFence<R> {
27:   readonly ownerFile: string;
28:   readonly retainedFile: string;
29:   readonly owner: (operation: () => Promise<R>) => Promise<R>;
30:   readonly retained: (operation: (records: readonly DurableRecord[]) => Promise<R>) => Promise<R>;
31: }
32: /** Fixed owner then dependency order; reject aliases before either nested acquisition. */
33: export async function withRetainedStoreFence<R>(fence: RetainedStoreFence<R>,
34:   operation: (records: readonly DurableRecord[]) => Promise<R>,
35: ): Promise<R> {
36:   await assertDistinctStoreFiles(fence.ownerFile, fence.retainedFile);
37:   return fence.owner(async () => {
38:     await assertDistinctStoreFiles(fence.ownerFile, fence.retainedFile);
39:     return fence.retained(async records => {
40:       await assertDistinctStoreFiles(fence.ownerFile, fence.retainedFile);
41:       return operation(records);
42:     });
43:   });
44: }

SOURCE skills/common/plugin-runtime/foundation/observability/durable-records.ts SHA256 ab407b028f3a22c96a436c3bdf2a9dd7bfee3b36d301de919669d2d1bf25c553
1: export { FileDurableBlobStore, type DurableBlobStore } from './durable-blobs.ts';
2: import { readStoreRecords, withRetainedStoreFence } from './durable-record-dependency.ts';
3: import {assertDurableRecordReplay, assertRetirementIntent, payloadDigest, ownerValid, existingRecord,
4:   type DurableRecord, type DurableRecordState, type RecordRetirementIntent, type RecordRetirement} from './record-retirement.ts';
5: export {assertDurableRecordReplay} from './record-retirement.ts';
6: export type {DurableRecord, DurableRecordState, RecordRetirementIntent, RecordRetirement, RecordTombstone} from './record-retirement.ts';
7: import path from "node:path";
8: import { canonicalJson } from "@kubeclaw/pipeline-observability-contract";
9: import {
10:   readDurableState,
11:   withDurableStoreLock,
12:   writeDurableState,
13: } from "./durable-delivery.ts";
14: 
15: export interface DurableRecordLimits {
16:   readonly maximumRecords: number;
17:   readonly maximumBytes: number;
18:   readonly maximumRecordBytes: number;
19: }
20: 
21: export interface DurableRecordStore {
22:   append<T>(stream: string, idempotencyKey: string, payload: T, owner?: string): Promise<{
23:     readonly appended: boolean;
24:     readonly record: DurableRecord<T>;
25:   }>;
26:   transition<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string, payload: T): Promise<DurableRecord<T>>;
27:   read<T>(stream: string): Promise<ReadonlyArray<DurableRecord<T>>>;
28: }
29: 
30: const EMPTY_STATE: DurableRecordState = {
31:   schemaVersion: "pipeline-durable-record-store.v1",
32:   records: [],
33: };
34: const IDENTITY = /^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$/;
35: const DIGEST = /^sha256:[a-f0-9]{64}$/;
36: 
37: function positiveInteger(value: number, code: string): void {
38:   if (!Number.isSafeInteger(value) || value < 1) throw new Error(code);
39: }
40: 
41: function identity(value: string, code: string): void {
42:   if (!IDENTITY.test(value)) throw new Error(code);
43: }
44: 
45: 
46: export class FileDurableRecordStore implements DurableRecordStore {
47:   readonly #file: string;
48:   readonly #limits: DurableRecordLimits;
49:   #queue: Promise<unknown> = Promise.resolve();
50: 
51:   constructor(root: string, limits: DurableRecordLimits) {
52:     positiveInteger(limits.maximumRecords, "DURABLE_RECORD_LIMIT_INVALID");
53:     positiveInteger(limits.maximumBytes, "DURABLE_RECORD_LIMIT_INVALID");
54:     positiveInteger(limits.maximumRecordBytes, "DURABLE_RECORD_LIMIT_INVALID");
55:     this.#file = path.join(path.resolve(root), "records", "store.json");
56:     this.#limits = limits;
57:   }
58: 
59:   #serial<T>(operation: () => Promise<T>): Promise<T> {
60:     const locked = () => withDurableStoreLock(this.#file, operation);
61:     const result = this.#queue.then(locked, locked);
62:     this.#queue = result.then(() => undefined, () => undefined);
63:     return result;
64:   }
65: 
66:   async append<T>(stream: string, idempotencyKey: string, payload: T, owner?: string): Promise<{
67:     readonly appended: boolean;
68:     readonly record: DurableRecord<T>;
69:   }> {
70:     identity(stream, "DURABLE_RECORD_STREAM_INVALID");
71:     identity(idempotencyKey, "DURABLE_RECORD_IDEMPOTENCY_KEY_INVALID");
72:     if (owner !== undefined && !ownerValid(owner)) throw new Error("DURABLE_RECORD_OWNER_INVALID");
73:     const snapshot = JSON.parse(canonicalJson(payload)) as T;
74:     const digest = payloadDigest(snapshot);
75:     if (Buffer.byteLength(canonicalJson(snapshot)) > this.#limits.maximumRecordBytes)
76:       throw new Error("DURABLE_RECORD_SIZE_EXCEEDED");
77:     return this.#serial(async () => {
78:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes);
79:       assertDurableRecordReplay(state);
80:       const duplicate = existingRecord(state, stream, idempotencyKey, digest, snapshot, owner);
81:       if (duplicate) return { appended: false, record: duplicate };
82:       if (state.records.length >= this.#limits.maximumRecords)
83:         throw new Error("DURABLE_RECORD_STORE_FULL");
84:       const record: DurableRecord<T> = {
85:         schemaVersion: owner === undefined ? "pipeline-durable-record.v1" : "pipeline-durable-record.v2",
86:         ...(owner === undefined ? {} : { owner }),
87:         stream,
88:         sequence: state.records.filter((entry) => entry.stream === stream).length + (state.tombstones?.filter(entry => entry.stream === stream).length ?? 0) + 1,
89:         idempotencyKey,
90:         committedAt: new Date().toISOString(),
91:         payloadDigest: digest,
92:         payload: snapshot,
93:       };
94:       const candidate: DurableRecordState = owner === undefined ? { ...state, records: [...state.records, record] }
95:         : { ...state, schemaVersion: 'pipeline-durable-record-store.v2', records: [...state.records, record], tombstones: state.tombstones ?? [], retirements: state.retirements ?? [] };
96:       if (Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes)
97:         throw new Error("DURABLE_RECORD_STORE_FULL");
98:       await writeDurableState(this.#file, candidate);
99:       return { appended: true, record: structuredClone(record) };
100:     });
101:   }
102: 
103:   async read<T>(stream: string): Promise<ReadonlyArray<DurableRecord<T>>> {
104:     return this.withRecords<T, ReadonlyArray<DurableRecord<T>>>(stream, async records => records);
105:   }
106: 
107:   /** Domain owners may inspect records while holding this store's writer fence.
108:    * Never reenter this store from operation; acquire other stores in a fixed order. */
109:   async withRecords<T, R>(stream: string, operation: (records: ReadonlyArray<DurableRecord<T>>) => Promise<R>): Promise<R> {
110:     identity(stream, "DURABLE_RECORD_STREAM_INVALID");
111:     return this.#serial(async () => operation(await readStoreRecords<T>(this.#file, this.#limits.maximumBytes, stream)));
112:   }
113: 
114:   async retirements(stream: string): Promise<readonly RecordRetirement[]> {
115:     identity(stream, 'DURABLE_RECORD_STREAM_INVALID');
116:     return this.#serial(async () => {
117:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes); assertDurableRecordReplay(state);
118:       return structuredClone((state.retirements ?? []).filter(entry => entry.intent.stream === stream));
119:     });
120:   }
121: 
122:   /** Caller holds its domain fence; authorize runs again inside the real store writer fence. */
123:   async retire(intentInput: RecordRetirementIntent, authorize: (records: readonly DurableRecord[]) => Promise<void>): Promise<RecordRetirement & { readonly newlyRetired: boolean; readonly releasedBytes: number }> {
124:     const intent = JSON.parse(canonicalJson(intentInput)) as RecordRetirementIntent; assertRetirementIntent(intent);
125:     const intentDigest = payloadDigest(intent);
126:     return this.#serial(async () => {
127:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes); assertDurableRecordReplay(state);
128:       const previous = state.retirements?.find(item => item.intent.operationId === intent.operationId);
129:       if (previous) {
130:         if (previous.intentDigest !== intentDigest) throw new Error('DURABLE_RETIREMENT_CONFLICT');
131:         await authorize([]);
132:         return { ...structuredClone(previous), newlyRetired: false, releasedBytes: Number.parseInt(previous.releasedBytesHex,16) };
133:       }
134:       const selected = intent.records.map(item => {
135:         const record = state.records.find(entry => entry.stream === intent.stream && entry.idempotencyKey === item.idempotencyKey);
136:         if (!record || record.schemaVersion !== 'pipeline-durable-record.v2' || record.owner !== intent.owner
137:           || record.payloadDigest !== item.payloadDigest) throw new Error('DURABLE_RETIREMENT_RECORD_CHANGED');
138:         return record;
139:       });
140:       await authorize(structuredClone(selected));
141:       const selectedIds = new Set(selected.map(record => record.idempotencyKey));
142:       const retirement = { intent, intentDigest, releasedBytesHex: '0000000000000000' };
143:       const candidate: DurableRecordState = {
144:         schemaVersion: 'pipeline-durable-record-store.v2',
145:         records: state.records.filter(record => record.stream !== intent.stream || !selectedIds.has(record.idempotencyKey)),
146:         tombstones: [...state.tombstones ?? [], ...selected.map(record => {
147:           const { payload: _payload, ...header } = record; return { ...header, retirementId: intent.operationId };
148:         })], retirements: [...state.retirements ?? [], retirement],
149:       };
150:       const before = Buffer.byteLength(canonicalJson(state));
151:       // Fixed-width hex avoids a self-referential decimal digit-count equation.
152:       const releasedBytes = before - Buffer.byteLength(canonicalJson(candidate));
153:       if (releasedBytes < 1) throw new Error('DURABLE_RETIREMENT_NO_SAVING');
154:       retirement.releasedBytesHex = releasedBytes.toString(16).padStart(16,'0');
155:       assertDurableRecordReplay(candidate);
156:       if (Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes) throw new Error('DURABLE_RECORD_STORE_FULL');
157:       await writeDurableState(this.#file, candidate);
158:       return { ...structuredClone(retirement), newlyRetired: true, releasedBytes };
159:     });
160:   }
161: 
162:   async transition<T>(
163:     stream: string,
164:     idempotencyKey: string,
165:     expectedPayloadDigest: string,
166:     payload: T,
167:     authorize?: (records: ReadonlyArray<DurableRecord>) => void,
168:   ): Promise<DurableRecord<T>> {
169:     const { snapshot, digest } = this.#transitionCandidate(stream, idempotencyKey, expectedPayloadDigest, payload);
170:     return this.#serial(() => this.#transitionLocked(stream, idempotencyKey, expectedPayloadDigest, snapshot, digest, authorize));
171:   }
172: 
173:   /** Hold the owner writer before its retained dependency writer through the
174:    * original durable transition. Domain callers must use one fixed store order. */
175:   async transitionWithRetainedStore<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string,
176:     payload: T, retained: FileDurableRecordStore, retainedStream: string,
177:     authorize: (records: ReadonlyArray<DurableRecord>, retainedRecords: ReadonlyArray<DurableRecord>) => void,
178:   ): Promise<DurableRecord<T>> {
179:     const { snapshot, digest } = this.#transitionCandidate(stream, idempotencyKey, expectedPayloadDigest, payload);
180:     return this.#withRetainedStore(retained, retainedStream, retainedRecords =>
181:       this.#transitionLocked(stream, idempotencyKey, expectedPayloadDigest, snapshot, digest,
182:         records => authorize(records, retainedRecords)));
183:   }
184: 
185:   /** Read-owned snapshots with the same fixed two-store fence as a retained transition. */
186:   async withRetainedRecords<T, R>(stream: string, retained: FileDurableRecordStore, retainedStream: string,
187:     operation: (records: readonly DurableRecord<T>[], retainedRecords: readonly DurableRecord[]) => Promise<R>,
188:   ): Promise<R> {
189:     identity(stream, 'DURABLE_RECORD_STREAM_INVALID');
190:     return this.#withRetainedStore(retained, retainedStream, async records =>
191:       operation(await readStoreRecords<T>(this.#file, this.#limits.maximumBytes, stream), records));
192:   }
193: 
194:   #withRetainedStore<R>(retained: FileDurableRecordStore, stream: string, operation: (records: readonly DurableRecord[]) => Promise<R>): Promise<R> {
195:     identity(stream, 'DURABLE_RECORD_STREAM_INVALID');
196:     return withRetainedStoreFence({ ownerFile: this.#file, retainedFile: retained.#file,
197:       owner: callback => this.#serial(callback), retained: callback => retained.withRecords(stream, callback) }, operation);
198:   }
199: 
200:   #transitionCandidate<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string, payload: T): { snapshot: T; digest: string } {
201:     identity(stream, "DURABLE_RECORD_STREAM_INVALID");
202:     identity(idempotencyKey, "DURABLE_RECORD_IDEMPOTENCY_KEY_INVALID");
203:     if (!DIGEST.test(expectedPayloadDigest)) throw new Error("DURABLE_RECORD_DIGEST_INVALID");
204:     const snapshot = JSON.parse(canonicalJson(payload)) as T;
205:     const digest = payloadDigest(snapshot);
206:     if (Buffer.byteLength(canonicalJson(snapshot)) > this.#limits.maximumRecordBytes)
207:       throw new Error("DURABLE_RECORD_SIZE_EXCEEDED");
208:     return { snapshot, digest };
209:   }
210: 
211:   async #transitionLocked<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string,
212:     snapshot: T, digest: string, authorize?: (records: ReadonlyArray<DurableRecord>) => void,
213:   ): Promise<DurableRecord<T>> {
214:       const state = await readDurableState(this.#file, EMPTY_STATE, this.#limits.maximumBytes);
215:       assertDurableRecordReplay(state);
216:       const index = state.records.findIndex(
217:         (record) => record.stream === stream && record.idempotencyKey === idempotencyKey,
218:       );
219:       if (index < 0) {
220:         if (state.tombstones?.some(record => record.stream === stream && record.idempotencyKey === idempotencyKey)) throw new Error('DURABLE_RECORD_RETIRED');
221:         throw new Error("DURABLE_RECORD_NOT_FOUND");
222:       }
223:       const existing = state.records[index];
224:       if (!existing) throw new Error("DURABLE_RECORD_NOT_FOUND");
225:       if (existing.payloadDigest !== expectedPayloadDigest)
226:         throw new Error("DURABLE_RECORD_TRANSITION_CONFLICT");
227:       const record: DurableRecord<T> = {
228:         ...existing,
229:         committedAt: new Date().toISOString(),
230:         payloadDigest: digest,
231:         payload: snapshot,
232:       };
233:       const next = [...state.records];
234:       next[index] = record;
235:       const candidate: DurableRecordState = { ...state, records: next };
236:       if (Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes)
237:         throw new Error("DURABLE_RECORD_STORE_FULL");
238:       // The domain fence is already held; the final check must not yield or
239:       // reenter this store between its CAS comparison and durable write.
240:       if (authorize?.(structuredClone(state.records)) !== undefined) throw new Error('DURABLE_RECORD_AUTHORIZATION_NOT_SYNCHRONOUS');
241:       await writeDurableState(this.#file, candidate);
242:       return structuredClone(record);
243: 
244:   }
245: }
246: 

SOURCE skills/common/plugin-runtime/foundation/observability/hash-journal.ts SHA256 b00c2271bb662055d7250ca193f842d1e6346edf22dfa713b33df1b637ce957a
1: import {createHash} from 'node:crypto';
2: 
3: export interface HashJournalRecord<T> {
4:   readonly sequence: number;
5:   readonly previousHash: string | null;
6:   readonly hash: string;
7:   readonly entry: T;
8: }
9: 
10: /** The original append-journal wire hash. Parsing does not repair or write. */
11: export function hashJournalRecord(sequence:number, previousHash:string|null, entry:unknown):string {
12:   return `sha256:${createHash('sha256').update(JSON.stringify({sequence,previousHash,entry})).digest('hex')}`;
13: }
14: 
15: export function parseHashJournal<T>(buffer:Buffer, file:string, precedingSequence=0, precedingHash:string|null=null):HashJournalRecord<T>[] {
16:   if (!buffer.length) return [];
17:   const text=buffer.toString('utf8');
18:   if(!text.endsWith('\n'))throw new Error(`JOURNAL_RECORD_INCOMPLETE:${file}`);
19:   const records:HashJournalRecord<T>[]=[];
20:   for(const line of text.slice(0,-1).split('\n')) {
21:     const sequence=precedingSequence+records.length+1;
22:     if(!line.length)throw new Error(`JOURNAL_RECORD_EMPTY:${file}:${sequence}`);
23:     const record=JSON.parse(line) as HashJournalRecord<T>;
24:     const previousHash=records.at(-1)?.hash??precedingHash;
25:     if(record.sequence!==sequence || record.previousHash!==previousHash)throw new Error(`JOURNAL_CHAIN_INVALID:${file}:${sequence}`);
26:     if(record.hash!==hashJournalRecord(sequence,previousHash,record.entry))throw new Error(`JOURNAL_HASH_INVALID:${file}:${sequence}`);
27:     records.push(record);
28:   }
29:   return records;
30: }

SOURCE skills/common/plugin-runtime/foundation/observability/record-retirement.ts SHA256 00a081bdccc917067eeabea36d6438615aada22c637e4d7f42e3852285647681
1: import crypto from 'node:crypto';
2: import {canonicalJson} from '@kubeclaw/pipeline-observability-contract';
3: const IDENTITY = /^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$/;
4: const DIGEST = /^sha256:[a-f0-9]{64}$/;
5: export interface DurableRecord<T = unknown> {
6:   readonly schemaVersion: "pipeline-durable-record.v1" | "pipeline-durable-record.v2";
7:   readonly owner?: string;
8:   readonly stream: string;
9:   readonly sequence: number;
10:   readonly idempotencyKey: string;
11:   readonly committedAt: string;
12:   readonly payloadDigest: string;
13:   readonly payload: T;
14: }
15: 
16: export interface DurableRecordState {
17:   readonly schemaVersion: "pipeline-durable-record-store.v1" | "pipeline-durable-record-store.v2";
18:   readonly records: DurableRecord[];
19:   readonly tombstones?: RecordTombstone[];
20:   readonly retirements?: RecordRetirement[];
21: }
22: export interface RecordRetirementIntent {
23:   readonly operationId: string;
24:   readonly actor: string;
25:   readonly owner: string;
26:   readonly stream: string;
27:   readonly records: readonly { readonly idempotencyKey: string; readonly payloadDigest: string }[];
28:   readonly evidence: Readonly<Record<string, unknown>>;
29: }
30: export interface RecordRetirement {
31:   readonly intent: RecordRetirementIntent;
32:   readonly intentDigest: string;
33:   readonly releasedBytesHex: string;
34: }
35: export interface RecordTombstone extends Omit<DurableRecord, 'payload'> {
36:   readonly retirementId: string;
37: }
38: 
39: export function payloadDigest(payload: unknown): string {
40:   return `sha256:${crypto.createHash("sha256").update(canonicalJson(payload)).digest("hex")}`;
41: }
42: 
43: export function ownerValid(owner: unknown): owner is string {
44:   return typeof owner === 'string' && owner.length > 0 && owner.length <= 512 && !/[\u0000-\u001f\u007f]/u.test(owner);
45: }
46: function recordHeaderValid(record: Omit<DurableRecord, 'payload'>): boolean {
47:   return (record.schemaVersion === 'pipeline-durable-record.v1' && record.owner === undefined
48:     || record.schemaVersion === 'pipeline-durable-record.v2' && ownerValid(record.owner))
49:     && IDENTITY.test(record.stream) && IDENTITY.test(record.idempotencyKey)
50:     && Number.isSafeInteger(record.sequence) && record.sequence > 0
51:     && typeof record.committedAt === 'string' && DIGEST.test(record.payloadDigest);
52: }
53: export function assertRetirementIntent(intent: RecordRetirementIntent): void {
54:   if (!intent || Object.keys(intent).sort().join(',') !== 'actor,evidence,operationId,owner,records,stream'
55:     || !IDENTITY.test(intent.operationId) || !ownerValid(intent.actor) || !ownerValid(intent.owner)
56:     || !IDENTITY.test(intent.stream) || !Array.isArray(intent.records) || !intent.records.length
57:     || !intent.evidence || typeof intent.evidence !== 'object' || Array.isArray(intent.evidence)) throw new Error('DURABLE_RETIREMENT_INTENT_INVALID');
58:   assertRetirementSelection(intent.records);
