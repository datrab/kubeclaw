SOURCE skills/prism/server/worker-config.ts SHA256 f74aa34451583c1df785eaf21006b056b55791277f4731c9360f1ee5db0f5b0e
1: import { loadPrismSettings, loadPrismWorkerSettings, type PrismWorkerSettings } from '../../common/plugin-runtime/foundation/config/swarm.ts';
2: 
3: /** Platform-owned configuration is captured once before starting the worker. */
4: 
5: export function loadWorkerConfig(environment: NodeJS.ProcessEnv = process.env) {
6:   if (environment.PORT !== undefined) throw new Error('SWARM_CONFIG_LEGACY_OVERRIDE:PORT moved to prism-worker.config.json settings.ingress.port');
7:   const spiffeEnabled = environment.WORKER_TRUST_SPIFFE_ENABLED === 'true';
8:   const workerSecret = environment.PRISM_WORKER_SECRET ?? '';
9:   if (!spiffeEnabled && !workerSecret) throw new Error('PRISM_WORKER_SECRET is required');
10:   const trustedControlSpiffeId = environment.PRISM_TRUSTED_CONTROL_SPIFFE_ID ?? '';
11:   if (spiffeEnabled && !trustedControlSpiffeId) throw new Error('Prism worker SPIFFE trust policy is incomplete');
12:   const databaseUrl = environment.DATABASE_URL ?? '';
13:   if (!spiffeEnabled && !databaseUrl) throw new Error('DATABASE_URL is required');
14:   const snapshot = loadPrismSettings(environment);
15:   const settings = snapshot.worker;
16:   return Object.freeze({ spiffeEnabled, workerSecret, trustedControlSpiffeId, databaseUrl, shutdownTimeoutMs: settings.shutdownTimeoutMs,
17:     controlInternalUrl: new URL(environment.PRISM_CONTROL_INTERNAL_URL ?? 'http://prism-control:8080'),
18:     native: snapshot.native, port: settings.port, ingress: ingressLimits(settings),
19:   });
20: }
21: 
22: export function workerIngressLimits(environment: NodeJS.ProcessEnv = process.env) {
23:   return ingressLimits(loadPrismWorkerSettings(environment));
24: }
25: 
26: function ingressLimits(settings: PrismWorkerSettings) {
27:   return Object.freeze({
28:     maximumActiveRequests: settings.maximumActiveRequests,
29:     maximumProbeRequests: settings.maximumProbeRequests,
30:     maximumConnections: settings.maximumConnections,
31:     maximumInputBytes: settings.maximumInputBytes,
32:     requestTimeoutMs: settings.requestTimeoutMs,
33:   });
34: }

SOURCE skills/prism/server/worker-service.ts SHA256 90174f5edf19c85ef1642da95a51aac46854f9a1ce7172d876045a5bac1595e4
1: import { type IncomingMessage, type ServerResponse } from "node:http";
2: import {
3:   validateWorkerResourceContractV3,
4:   type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3,
5: } from "@kubeclaw/pipeline-worker-core-contract";
6: import { type WorkerNonceDatabase, WorkerDependencyUnavailable } from "./worker-readiness.ts";
7: import { createManagedWorkerServer } from "./worker-lifecycle.ts";
8: import { authorizeProxiedSpiffePeer, NativeWorkerAttemptBusy } from "@kubeclaw/worker-core";
9: import { workerIngressLimits } from './worker-config.ts';
10: 
11: export type WorkerAuthentication =
12:   | { mode: "hmac"; secret: string; database: WorkerNonceDatabase }
13:   | { mode: "spiffe"; trustedControlSpiffeId: string };
14: 
15: export interface NativePrismWorkerExecution {
16:   ready(): boolean;
17:   execute(envelope: WorkerAttemptEnvelopeV3, signal: AbortSignal): Promise<WorkerAttemptResultV3>;
18: }
19: 
20: export function createWorkerServer(auth: WorkerAuthentication, execution: NativePrismWorkerExecution, limits = workerIngressLimits()) {
21:   return createManagedWorkerServer(
22:     (request, response, signal) => handleWorkerRequest(auth, request, response, signal, { maximumInputBytes: limits.maximumInputBytes, native: execution }),
23:     () => auth.mode === 'hmac' ? auth.database.close() : Promise.resolve(),
24:     limits,
25:   );
26: }
27: 
28: async function handleWorkerRequest(auth: WorkerAuthentication,
29:   request: IncomingMessage, response: ServerResponse, signal: AbortSignal,
30:   { maximumInputBytes, native }: { maximumInputBytes: number; native: NativePrismWorkerExecution }): Promise<WorkerAttemptResultV3 | void> {
31:   if (serveLocalHealth(request, response, native)) return;
32:   if (request.url === '/ready') return serveReadiness(auth, response, signal, native);
33:   if (request.url !== "/v1/attempts" || request.method !== "POST") {
34:     response.writeHead(404);
35:     return void response.end();
36:   }
37:   try {
38:     if (
39:       !(request.headers["content-type"] ?? "")
40:         .toString()
41:         .toLowerCase()
42:         .startsWith("application/json")
43:     ) {
44:       response.writeHead(415);
45:       return void response.end();
46:     }
47:     const chunks: Buffer[] = [];
48:     let size = 0;
49:     for await (const chunk of request) {
50:       size += chunk.length;
51:       if (size > maximumInputBytes)
52:         throw new Error("Prism attempt request is too large");
53:       chunks.push(chunk);
54:     }
55:     const raw = Buffer.concat(chunks);
56:     if (auth.mode === "spiffe") authorizeProxiedSpiffePeer(request.headers, request.socket.remoteAddress, new Set([auth.trustedControlSpiffeId]));
57:     else await auth.database.authenticate(auth.secret, raw, request.headers, signal);
58:     const result = await dispatchAttempt(JSON.parse(raw.toString('utf8')), signal, native);
59:     response.writeHead(200, { "content-type": "application/json" });
60:     response.end(JSON.stringify(result));
61:     return result;
62:   } catch (error) {
63:     response.writeHead(error instanceof WorkerDependencyUnavailable || error instanceof NativeWorkerAttemptBusy ? 503 : 422, { "content-type": "application/json" });
64:     response.end(
65:       JSON.stringify({
66:         error: error instanceof Error ? error.message : "failed",
67:       }),
68:     );
69:   }
70: }
71: 
72: async function serveReadiness(auth: WorkerAuthentication, response: ServerResponse, signal: AbortSignal,
73:   native: NativePrismWorkerExecution): Promise<void> {
74:   if (!native.ready()) {
75:     response.writeHead(503, { 'content-type': 'application/json' });
76:     response.end('{"status":"not-ready","error":"PRISM_NATIVE_RECONCILIATION_REQUIRED"}');
77:     return;
78:   }
79:   try {
80:     if (auth.mode === 'hmac') await auth.database.check(signal);
81:     response.writeHead(200, { 'content-type': 'application/json' });
82:     response.end('{"status":"ready"}');
83:   } catch {
84:     response.writeHead(503, { 'content-type': 'application/json' });
85:     response.end('{"status":"not-ready","error":"PRISM_NONCE_DATABASE_UNAVAILABLE"}');
86:   }
87: }
88: 
89: async function dispatchAttempt(input: unknown, signal: AbortSignal, native: NativePrismWorkerExecution): Promise<WorkerAttemptResultV3> {
90:   validateWorkerResourceContractV3('workerAttemptEnvelope', input);
91:   if (!native.ready()) throw new Error('PRISM_NATIVE_RECONCILIATION_REQUIRED');
92:   return native.execute(input as WorkerAttemptEnvelopeV3, signal);
93: }
94: 
95: function serveLocalHealth(request: IncomingMessage, response: ServerResponse, native: NativePrismWorkerExecution): boolean {
96:   if (request.url === "/health" || request.url === "/bootstrap") {
97:     if (request.url === '/bootstrap' && !native.ready()) {
98:       response.writeHead(503, { 'content-type': 'application/json' });
99:       response.end('{"status":"not-ready","error":"PRISM_NATIVE_RECONCILIATION_REQUIRED"}');
100:       return true;
101:     }
102:     response.writeHead(200, { "content-type": "application/json" });
103:     response.end(JSON.stringify({ status: request.url === "/health" ? "alive" : "initialized" }));
104:     return true;
105:   }
106:   return false;
107: }

SOURCE skills/prism/server/worker.ts SHA256 cfecfaa12715e48f923af86b69a6a7582024246d4df619be90e9270d95d96d5d
1: import { FileWorkerOwnershipStore, NativeWorkerOwnership, requireNativeWorkerSupervisorAuthority, requireNativeWorkerLauncher } from '@kubeclaw/worker-core';
2: import { fileURLToPath } from 'node:url';
3: import path from 'node:path';
4: import { nativePrismSupervisorConfig } from '../config/native-worker.ts';
5: import { nativePrismExecution } from './native-worker-execution.ts';
6: import { createWorkerServer } from './worker-service.ts';
7: import type { ManagedWorkerServer } from './worker-lifecycle.ts';
8: import { WorkerNonceDatabase } from './worker-readiness.ts';
9: import { loadWorkerConfig } from './worker-config.ts';
10: 
11: /** Native-only startup: durable ownership and journal recovery precede HTTP admission. */
12: export async function runNativePrismWorker(): Promise<void> {
13:   const config = loadWorkerConfig();
14:   const native = nativePrismSupervisorConfig(config);
15:   requireNativeWorkerSupervisorAuthority();
16:   requireNativeWorkerLauncher(native.launcher);
17:   const store = new FileWorkerOwnershipStore(native.ownershipRoot, {
18:     maximumRecords: native.maximumRecords, maximumBytes: native.maximumBytes,
19:   });
20:   await NativeWorkerOwnership.supervise({ ...native, store }, async owner => {
21:     const execution = await nativePrismExecution(owner, native, config);
22:     const authentication = config.spiffeEnabled
23:       ? { mode: 'spiffe' as const, trustedControlSpiffeId: config.trustedControlSpiffeId }
24:       : { mode: 'hmac' as const, secret: config.workerSecret, database: new WorkerNonceDatabase(config.databaseUrl) };
25:     const server = createWorkerServer(authentication, execution, config.ingress);
26:     await serve(server, owner, config);
27:   });
28: }
29: 
30: async function serve(server: ManagedWorkerServer, owner: NativeWorkerOwnership, config: ReturnType<typeof loadWorkerConfig>): Promise<void> {
31:   let stop: () => void = () => {};
32:   try {
33:     await new Promise<void>((resolve, reject) => {
34:       let stopping = false;
35:       stop = () => {
36:         if (stopping) return;
37:         stopping = true;
38:         owner.fenceAdmission();
39:         void server.shutdown(config.shutdownTimeoutMs).then(resolve, reject);
40:       };
41:       process.once('SIGTERM', stop); process.once('SIGINT', stop);
42:       server.once('error', reject);
43:       server.listen(config.port, '0.0.0.0');
44:     });
45:   } finally {
46:     owner.fenceAdmission();
47:     process.removeListener('SIGTERM', stop); process.removeListener('SIGINT', stop);
48:     await server.shutdown(config.shutdownTimeoutMs);
49:   }
50: }
51: 
52: if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
53:   runNativePrismWorker().then(() => {
54:     process.stderr.write('{"event":"prism_native_worker_shutdown","state":"ownership_reconciled"}\n');
55:   }, (error: unknown) => {
56:     process.stderr.write(`${JSON.stringify({ event: 'prism_native_worker_failure',
57:       code: error instanceof Error ? error.message : 'PRISM_NATIVE_UNKNOWN_FAILURE' })}\n`);
58:     process.exitCode = 1;
59:   });
60: }

SOURCE skills/worker/core/worker/local-runtime.ts SHA256 17ce49a84ab0484d19e004aad2db4554804df89230c6884dd3c91c4892e962a4
1: import {
2:   validatePipelineWorkerCoreContract,
3:   type WorkerAttemptEnvelopeV1,
4:   type WorkerHealthV1,
5:   type WorkerLifecycleState,
6:   type WorkerProfileV1,
7:   type WorkerProtocolVersion,
8:   type WorkerRegistrationV1,
9: } from '@kubeclaw/pipeline-worker-core-contract';
10: 
11: const MAX_TIMER_MS = 2_147_483_647;
12: 
13: export interface LocalWorkerRuntimePolicy {
14:   readonly drainTimeoutMs: number;
15:   readonly cancellationTimeoutMs: number;
16:   readonly replayLimit: number;
17: }
18: 
19: export function validateLocalWorkerRuntimePolicy(options: LocalWorkerRuntimePolicy): Readonly<LocalWorkerRuntimePolicy> {
20:   if (options === null || typeof options !== 'object') throw new Error('WORKER_LOCAL_POLICY_REQUIRED');
21:   const drainTimeoutMs = positiveTimer(options.drainTimeoutMs, 'WORKER_LOCAL_DRAIN_TIMEOUT_INVALID');
22:   const cancellationTimeoutMs = positiveTimer(options.cancellationTimeoutMs,
23:     'WORKER_LOCAL_CANCELLATION_TIMEOUT_INVALID');
24:   const replayLimit = options.replayLimit;
25:   if (!Number.isSafeInteger(replayLimit) || replayLimit < 1 || replayLimit > 1_000_000) {
26:     throw new Error('WORKER_LOCAL_REPLAY_LIMIT_INVALID');
27:   }
28:   return Object.freeze({ drainTimeoutMs, cancellationTimeoutMs, replayLimit });
29: }
30: 
31: export interface LocalWorkerRuntimeOptions extends LocalWorkerRuntimePolicy {
32:   readonly workerId: string;
33:   readonly workerType: string;
34:   readonly coreVersion: string;
35:   readonly protocolVersions: readonly WorkerProtocolVersion[];
36:   readonly profiles: readonly WorkerProfileV1[];
37:   readonly capacity: number;
38:   readonly now?: () => Date;
39: }
40: 
41: interface ActiveAttempt {
42:   readonly controller: AbortController;
43:   readonly completion: Promise<unknown>;
44: }
45: 
46: interface ResolvedLocalWorkerRuntimeOptions {
47:   readonly workerId: string;
48:   readonly workerType: string;
49:   readonly coreVersion: string;
50:   readonly capacity: number;
51:   readonly drainTimeoutMs: number;
52:   readonly cancellationTimeoutMs: number;
53:   readonly replayLimit: number;
54: }
55: 
56: function freeze<T>(value: T): T {
57:   if (!value || typeof value !== 'object') return value;
58:   for (const child of Object.values(value as Record<string, unknown>)) freeze(child);
59:   return Object.isFrozen(value) ? value : Object.freeze(value);
60: }
61: 
62: function positiveTimer(value: number, code: string): number {
63:   if (!Number.isSafeInteger(value) || value < 1 || value > MAX_TIMER_MS) throw new Error(code);
64:   return value;
65: }
66: 
67: async function settleWithin(attempts: readonly Promise<unknown>[], timeoutMs: number): Promise<boolean> {
68:   if (attempts.length === 0) return true;
69:   let timer: NodeJS.Timeout | undefined;
70:   try {
71:     return await Promise.race([
72:       Promise.allSettled(attempts).then(() => true),
73:       new Promise<boolean>((resolve) => { timer = setTimeout(() => resolve(false), timeoutMs); }),
74:     ]);
75:   } finally {
76:     if (timer) clearTimeout(timer);
77:   }
78: }
79: 
80: function armClaimExpiry(deadline: number, controller: AbortController, now: () => Date): () => void {
81:   let timer: NodeJS.Timeout | undefined;
82:   const schedule = (): void => {
83:     const remaining = deadline - now().getTime();
84:     if (remaining <= 0) { controller.abort(new Error('WORKER_LOCAL_CLAIM_EXPIRED')); return; }
85:     timer = setTimeout(schedule, Math.min(remaining, MAX_TIMER_MS));
86:   };
87:   schedule();
88:   return () => { if (timer) clearTimeout(timer); };
89: }
90: 
91: export class LocalWorkerRuntime {
92:   readonly #options: Readonly<ResolvedLocalWorkerRuntimeOptions>;
93:   readonly #profiles: readonly WorkerProfileV1[];
94:   readonly #protocolVersions: readonly WorkerProtocolVersion[];
95:   readonly #profileDigests: ReadonlySet<string>;
96:   readonly #now: () => Date;
97:   readonly #startedAt: string;
98:   readonly #active = new Map<string, ActiveAttempt>();
99:   readonly #acceptedAttemptIds = new Map<string, number>();
100:   #state: WorkerLifecycleState = 'starting';
101:   #healthSequence = 0;
102:   #draining: Promise<void> | null = null;
103: 
104:   constructor(options: LocalWorkerRuntimeOptions) {
105:     if (!Number.isSafeInteger(options.capacity) || options.capacity < 1 || options.capacity > 4096) {
106:       throw new Error('WORKER_LOCAL_CAPACITY_INVALID');
107:     }
108:     const { drainTimeoutMs, cancellationTimeoutMs, replayLimit } = validateLocalWorkerRuntimePolicy(options);
109:     this.#profiles = freeze(structuredClone([...options.profiles]));
110:     this.#protocolVersions = freeze([...new Set(options.protocolVersions)].sort());
111:     this.#profileDigests = new Set(this.#profiles.map((profile) => profile.profileDigest));
112:     this.#now = options.now ?? (() => new Date());
113:     this.#startedAt = this.#now().toISOString();
114:     this.#options = freeze({ workerId: options.workerId, workerType: options.workerType,
115:       coreVersion: options.coreVersion, capacity: options.capacity, drainTimeoutMs, cancellationTimeoutMs, replayLimit });
116:     validatePipelineWorkerCoreContract('workerRegistration', this.registration());
117:   }
118: 
119:   get state(): WorkerLifecycleState { return this.#state; }
120: 
121:   markReady(): WorkerRegistrationV1 {
122:     if (this.#state !== 'starting') throw new Error(`WORKER_LOCAL_TRANSITION_INVALID:${this.#state}:ready`);
123:     this.#state = 'ready';
124:     return this.registration();
125:   }
126: 
127:   markUnhealthy(): WorkerHealthV1 {
128:     if (this.#state === 'stopped') throw new Error('WORKER_LOCAL_TRANSITION_INVALID:stopped:unhealthy');
129:     this.#state = 'unhealthy';
130:     return this.health();
131:   }
132: 
133:   registration(): WorkerRegistrationV1 {
134:     const registration = freeze({
135:       schemaVersion: 'worker-registration.v1' as const,
136:       workerId: this.#options.workerId,
137:       workerType: this.#options.workerType,
138:       coreVersion: this.#options.coreVersion,
139:       protocolVersions: [...this.#protocolVersions],
140:       profiles: structuredClone(this.#profiles) as WorkerProfileV1[],
141:       capacity: this.#capacity(),
142:       lifecycleState: this.#state,
143:       startedAt: this.#startedAt,
144:       sentAt: this.#now().toISOString(),
145:     });
146:     validatePipelineWorkerCoreContract('workerRegistration', registration);
147:     return registration;
148:   }
149: 
150:   health(): WorkerHealthV1 {
151:     const health = freeze({
152:       schemaVersion: 'worker-health.v1' as const,
153:       workerId: this.#options.workerId,
154:       sequence: this.#healthSequence++,
155:       lifecycleState: this.#state,
156:       capacity: this.#capacity(),
157:       activeAttemptIds: [...this.#active.keys()].sort(),
158:       sentAt: this.#now().toISOString(),
159:     });
160:     validatePipelineWorkerCoreContract('workerHealth', health);
161:     return health;
162:   }
163: 
164:   runAttempt<T>(envelope: WorkerAttemptEnvelopeV1, execute: (signal: AbortSignal) => Promise<T>): Promise<T> {
165:     if (this.#state !== 'ready') throw new Error(`WORKER_LOCAL_NOT_READY:${this.#state}`);
166:     if (this.#active.size >= this.#options.capacity) throw new Error('WORKER_LOCAL_CAPACITY_EXHAUSTED');
167:     validatePipelineWorkerCoreContract('workerAttemptEnvelope', envelope);
168:     if (envelope.claim.workerId !== this.#options.workerId) throw new Error('WORKER_LOCAL_CLAIM_WORKER_MISMATCH');
169:     const now = this.#now().getTime();
170:     if (now >= Date.parse(envelope.queueDeadline)) throw new Error('WORKER_LOCAL_QUEUE_DEADLINE_EXPIRED');
171:     if (now < Date.parse(envelope.claim.claimedAt)) throw new Error('WORKER_LOCAL_CLAIM_NOT_ACTIVE');
172:     if (now >= Date.parse(envelope.claim.expiresAt)) throw new Error('WORKER_LOCAL_CLAIM_EXPIRED');
173:     if (!this.#protocolVersions.includes(envelope.protocolVersion)) throw new Error('WORKER_LOCAL_PROTOCOL_UNSUPPORTED');
174:     if (!this.#profileDigests.has(envelope.profile.profileDigest)) throw new Error('WORKER_LOCAL_PROFILE_UNSUPPORTED');
175:     this.#reclaimExpiredAttempts(now);
176:     if (this.#acceptedAttemptIds.has(envelope.attemptId)) throw new Error('WORKER_LOCAL_ATTEMPT_DUPLICATE');
177:     if (this.#acceptedAttemptIds.size >= this.#options.replayLimit) {
178:       throw new Error('WORKER_LOCAL_REPLAY_CAPACITY_EXHAUSTED');
179:     }
180:     this.#acceptedAttemptIds.set(envelope.attemptId, Date.parse(envelope.claim.expiresAt));
181:     const controller = new AbortController();
182:     const claimExpiresAt = Date.parse(envelope.claim.expiresAt);
183:     const queueDeadline = Date.parse(envelope.queueDeadline);
184:     const clearClaimExpiry = armClaimExpiry(claimExpiresAt, controller, this.#now);
185:     let resolveOperation!: (value: T | PromiseLike<T>) => void;
186:     let rejectOperation!: (reason?: unknown) => void;
187:     const operation = new Promise<T>((resolve, reject) => {
188:       resolveOperation = resolve;
189:       rejectOperation = reject;
190:     });
191:     const completion = operation.then((value) => {
192:       if (this.#now().getTime() >= claimExpiresAt) throw new Error('WORKER_LOCAL_CLAIM_EXPIRED');
193:       return value;
194:     }).finally(clearClaimExpiry);
195:     this.#active.set(envelope.attemptId, { controller, completion });
196:     try {
197:       // Use one authoritative start timestamp immediately before the callback.
198:       // The synchronous start also pins verified provider bytes before the
199:       // caller can replace installed package content.
200:       const startNow = this.#now().getTime();
201:       if (startNow >= queueDeadline) throw new Error('WORKER_LOCAL_QUEUE_DEADLINE_EXPIRED');
202:       if (startNow >= claimExpiresAt) throw new Error('WORKER_LOCAL_CLAIM_EXPIRED');
203:       resolveOperation(execute(controller.signal));
204:     } catch (error) {
205:       rejectOperation(error);
206:     }
207:     void completion.then(
208:       () => { this.#active.delete(envelope.attemptId); },
209:       () => { this.#active.delete(envelope.attemptId); },
210:     );
211:     return completion;
212:   }
213: 
214:   drain(): Promise<void> {
215:     this.#draining ??= this.#drainOnce();
216:     return this.#draining;
217:   }
218: 
219:   stop(): WorkerHealthV1 {
220:     if (this.#active.size > 0) throw new Error('WORKER_LOCAL_ACTIVE_ATTEMPTS');
221:     this.#state = 'stopped';
222:     return this.health();
223:   }
224: 
225:   #reclaimExpiredAttempts(now: number): void {
226:     for (const [attemptId, expiresAt] of this.#acceptedAttemptIds) {
227:       if (expiresAt <= now && !this.#active.has(attemptId)) this.#acceptedAttemptIds.delete(attemptId);
228:     }
229:   }
230: 
231:   #capacity() {
232:     return { total: this.#options.capacity, available: this.#options.capacity - this.#active.size,
233:       active: this.#active.size };
234:   }
235: 
236:   async #drainOnce(): Promise<void> {
237:     if (this.#state === 'stopped') return;
238:     this.#state = 'draining';
239:     const initial = [...this.#active.values()].map((attempt) => attempt.completion);
240:     if (!(await settleWithin(initial, this.#options.drainTimeoutMs))) {
241:       for (const attempt of this.#active.values()) attempt.controller.abort(new Error('WORKER_LOCAL_DRAIN_CANCELLED'));
242:       const cancelled = [...this.#active.values()].map((attempt) => attempt.completion);
243:       if (!(await settleWithin(cancelled, this.#options.cancellationTimeoutMs))) {
244:         this.#state = 'unhealthy';
245:         throw new Error('WORKER_LOCAL_DRAIN_TIMEOUT');
246:       }
247:     }
248:     this.#state = 'stopped';
249:   }
250: }

