SOURCE charts/kubeclaw/values.yaml SHA256 e5bcd61acfd50636130f3d4ebbfb6377d14762ae7f9dac6c8da37caff70436b1
1: busterComponentFile: files/config/buster-engine.config.json
2: # =============================================================================
3: # KubeClaw Helm Chart — Default Values
4: # =============================================================================
5: # Autonomous Multi-Agent AI Swarm on Kubernetes
6: #
7: # This file contains sensible defaults. Override per-agent using instance
8: # value files from the examples/ directory.
9: #
10: # Minimal required configuration:
11: #   - agentRole
12: #   - auth.existingSecret + auth.existingSecretKey
13: #   - litellm.existingSecret + litellm.existingSecretKey
14: #   - agent.git.repoUrl
15: # =============================================================================
16: 
17: # -- Agent identity. One of: nova, forge, echo, buster, prism
18: agentRole: "nova"
19: 
20: # =============================================================================
21: # IMAGES
22: # =============================================================================
23: 
24: image:
25:   # General image for Nova, Forge, and Echo. Buster production values select
26:   # the dedicated minimal gateway image instead.
27:   digest: ""
28:   repository: ghcr.io/datrab/kubeclaw-nova
29:   tag: "latest"
30:   pullPolicy: Always
31: 
32: imagePullSecrets: []
33:   # - name: ghcr-secret
34: 
35: codeBundle:
36:   sha256: ""
37:   enabled: false
38:   # Concrete archive download URL resolved by deploy tooling or CI.
39:   archiveUrl: ""
40:   expectedCommit: ""
41:   contractVersion: "v2"
42:   auth:
43:     existingSecret: ""
44:     existingSecretKey: "token"
45: 
46: runtimeInfrastructure:
47:   # Required when buster-v2-runtime is selected. No implicit HTTP or node endpoint.
48:   registry:
49:     endpoint: ""
50:     transport: "" # https, or explicitly selected anonymous http-lab
51:     authSecretName: ""
52:     usernameKey: username
53:     passwordKey: password
54:     caSecretName: ""
55:     caSecretKey: ca.crt
56:     nodeCaFile: ""
57:   # Docker Hub only. Empty means BuildKit and generated node config use no mirror.
58:   dockerHubMirror:
59:     endpoint: ""
60:     transport: ""
61:     caSecretName: ""
62:     caSecretKey: ca.crt
63:     nodeCaFile: ""
64: 
65: # =============================================================================
66: # GATEWAY
67: # =============================================================================
68: 
69: gateway:
70:   # Internal URL used by colocated runtime processes such as Buster and the
71:   # gateway runtime. Empty defaults to http://127.0.0.1:<gateway.port>.
72:   url: ""
73:   # Run OpenClaw doctor --fix as a blocking init migration while the gateway is
74:   # stopped. New OpenClaw releases can require state-schema migrations before
75:   # the gateway is able to expose a healthy endpoint.
76:   startupDoctor:
77:     enabled: true
78:     # Keep V8 below the container memory limit while allowing OpenClaw's
79:     # configuration and SQLite migrations to process larger persistent state.
80:     nodeOptions: "--max-old-space-size=768"
81:     resources:
82:       requests: { cpu: 50m, memory: 128Mi }
83:       limits: { cpu: 1000m, memory: 1Gi }
84:   command:
85:     - "node"
86:     - "/app/openclaw.mjs"
87:     - "gateway"
88:     - "--bind"
89:     - "lan"
90:     - "--port"
91:     - "18789"
92:   port: 18789
93:   bridgePort: 18790
94:   resources: {}
95: 
96: # Resource budget for setup work such as the offline OpenClaw plugin install.
97: # This init container runs before all application containers, so its resources
98: # are not concurrent with the gateway and runtime sidecars.
99: initSetup:
100:   resources:
101:     requests: { cpu: 100m, memory: 256Mi }
102:     limits: { cpu: 1000m, memory: 2Gi }
103: 
104: # Official external plugins are resolved by their pinned npm provenance while
105: # npm remains in offline mode against the cache baked into the gateway image.
106: # The install-mode marker forces a one-time repair when provenance rules change.
107: pluginSeed:
108:   installMode: "official-npm-v1"
109:   specs:
110:     - "npm:@openclaw/acpx@2026.9.5"
111:     - "npm:@openclaw/discord@2026.9.5"
112: 
113: # =============================================================================
114: # CAPABILITY PROVIDERS
115: # =============================================================================
116: 
117: # Remote agent roles that provide capabilities to this deployment. Provider
118: # Services follow the chart's canonical `agent-<role>` naming contract.
119: capabilityProviders: {}
120:   # buster:
121:   #   agentRole: buster
122:   #   capabilities:
123:   #     runtime.dispatch:
124:   #       adapter: openclaw
125:   #       port: 18789
126:   #     test.plan.execute:
127:   #       adapter: buster-plan-v1
128:   #       port: 18891
129: 
130: # -- Replica count (always 1 per agent — agents are stateful)
131: replicaCount: 1
132: 
133: workerTrust:
134:   spiffe:
135:     enabled: false
136:     trustDomain: kubeclaw.internal
137:     socketPath: /run/spire/sockets/spire-agent.sock
138:     csiDriver: csi.spiffe.io
139:     envoy:
140:       repository: envoyproxy/envoy
141:       tag: v1.39.0
142:       digest: "sha256:d59f7f5fa10cff6d5892b6c5e7df5c9297ddfb2c3683e33fbfb82da24de4fa66"
143:       pullPolicy: IfNotPresent
144:       resources:
145:         requests: { cpu: 50m, memory: 64Mi }
146:         limits: { cpu: 500m, memory: 256Mi }
147: 
148: # =============================================================================
149: # AUTHENTICATION
150: # =============================================================================
151: # Gateway tokens authenticate API access to each agent.
152: # REQUIRED: Provide either token directly or via existingSecret.
153: # For production, always use existingSecret with SOPS or sealed-secrets.
154: 
155: auth:
156:   # Direct token (NOT recommended for production)
157:   token: ""
158:   # Reference an existing K8s secret
159:   existingSecret: ""
160:   existingSecretKey: "gatewayToken"
161: 
162: # =============================================================================
163: # MEMORY SEARCH EMBEDDING ENDPOINT (LiteLLM)
164: # =============================================================================
165: # LiteLLM is used only as the OpenAI-compatible remote embedding endpoint for
166: # OpenClaw memory search. Agent reasoning uses the managed OpenAI route directly.
167: 
168: litellm:
169:   endpoint: "http://litellm.kubeclaw.svc.cluster.local:4000/v1"
170:   # Direct API key (NOT recommended for production)
171:   apiKey: ""
172:   # Reference an existing K8s secret
173:   existingSecret: ""
174:   existingSecretKey: "litellmApiKey"
175: 
176: # =============================================================================
177: # STITCH API (Google Stitch MCP — UI design tool for Prism)
178: # =============================================================================
179: 
180: stitch:
181:   # Reference an existing K8s secret containing the Stitch API key
182:   existingSecret: ""
183:   existingSecretKey: "stitchApiKey"
184: 
185: # =============================================================================
186: # DISCORD INTEGRATION (optional)
187: # =============================================================================
188: 
189: discord:
190:   enabled: false
191:   channelId: ""
192:   # Discord user IDs allowed to approve exec commands (array of "user:<id>" strings)
193:   execApprovers: []
194:   # Direct token
195:   token: ""
196:   # Or reference existing secret
197:   existingSecret: ""
198:   existingSecretKey: "discordToken"
199: 
200: discordWebhook:
201:   secretName: ""
202:   secretKey: "discordWebhook"
203: 
204: # =============================================================================
205: # GIT CONFIGURATION
206: # =============================================================================
207: 
208: agent:
209:   # Active project name — sets CURRENT_PROJECT env for memory scoping
210:   project: ""  # e.g. "kubecommand"
211:   model:
212:     primary: "openai/gpt-5.6-sol"
213:     fallbacks:
214:       - "openai/gpt-5.5"
215:   git:
216:     # Enables chart-managed repository sync and SSH credentials. Disabling keeps
217:     # existing workspace data and removes Git init steps, mounts and Secret needs.
218:     enabled: true
219:     # Required only when enabled: K8s secret containing the SSH deploy key
220:     secretName: ""  # e.g. "git-deploy-key-nova"
221:     repoUrl: ""     # e.g. "git@github.com:your-org/your-project.git"
222: 
223: # =============================================================================
224: # INFRASTRUCTURE CONNECTIONS
225: # =============================================================================
226: 
227: # -- Redis (inter-agent messaging via Redis Streams)
228: # Infrastructure is deployed separately. Configure connection here.
229: redis:
230:   host: "redis-master.kubeclaw.svc.cluster.local"
231:   port: "6379"
232:   secretName: "redis-secrets"
233:   secretKey: "redis-password"
234: 
235: # =============================================================================
236: # =============================================================================
237: # WORKSPACE FILES
238: # =============================================================================
239: # Agent personality and operating procedures, mounted as markdown files.
240: # Define inline here or in your instance values file.
241: # See examples/workspace-templates/ for reference configurations.
242: 
243: workspace:
244:   enabled: true
245:   # false = only write files on first deploy (OpenClaw edits are preserved across restarts)
246:   # true  = overwrite from values on every restart (useful during initial development)
247:   overrideOnRestart: false
248:   soul: ""       # SOUL.md — personality, tone, core directives
249:   agents: ""     # AGENTS.md — protocols, workflow, delegation rules
250:   user: ""       # USER.md — information about the human operator
251:   tools: ""      # TOOLS.md — available tools and usage patterns
252:   memory: ""     # MEMORY.md — long-term context
253:   identity: ""   # IDENTITY.md — agent identity (filled at first run)
254:   bootstrap: ""  # BOOTSTRAP.md — first-run ritual (self-deleting)
255: 
256: # =============================================================================
257: # SERVICE
258: # =============================================================================
259: 
260: service:
261:   type: ClusterIP
262:   gatewayPort: 18789
263:   gatewayTargetPort: gateway
264:   bridgeEnabled: true
265:   bridgePort: 18790
266:   # NodePort for gateway when service.type is NodePort.
267:   nodePort: 0
268:   bridgeNodePort: 0
269:   # Extra ports to expose on the internal Service.
270:   # If nodePort is set while service.type is not NodePort, the chart also
271:   # creates a dedicated NodePort Service for that extra port without exposing
272:   # the gateway.
273:   extraPorts: []
274:   # Archviewer uses its own private Service; configure archviewer below.
275: 
276: # =============================================================================
277: # PERSISTENCE
278: # =============================================================================
279: 
280: persistence:
281:   config:
282:     enabled: true
283:     size: 10Gi
284:     storageClass: ""  # Uses cluster default if empty
285:     accessModes: ["ReadWriteOnce"]
286:   workspace:
287:     enabled: true
288:     size: 20Gi
289:     storageClass: ""
290:     accessModes: ["ReadWriteOnce"]
291: 
292: # =============================================================================
293: # RESOURCES
294: # =============================================================================
295: 
296: resources:
297:   requests:
298:     cpu: 200m
299:     memory: 512Mi
300:   limits:
301:     cpu: 2000m
302:     memory: 2Gi
303: 
304: # =============================================================================
305: # SECURITY
306: # =============================================================================
307: # OpenClaw's base image requires root. Set to false only if running a custom
308: # rootless image. Containers remain non-privileged in either mode.
309: 
310: runAsRoot: true
311: 
312: # =============================================================================
313: # HEALTH CHECKS
314: # =============================================================================
315: 
316: probes:
317:   startup:
318:     enabled: true
319:     initialDelaySeconds: 10
320:     periodSeconds: 10
321:     timeoutSeconds: 10
322:     failureThreshold: 24
323:   readiness:
324:     enabled: true
325:     initialDelaySeconds: 5
326:     periodSeconds: 10
327:     timeoutSeconds: 10
328:     failureThreshold: 3
329:   liveness:
330:     enabled: true
331:     initialDelaySeconds: 120
332:     periodSeconds: 15
333:     timeoutSeconds: 5
334:     failureThreshold: 3
335:   dependencies:
336:     gateway:
337:       enabled: true
338:     redis:
339:       enabled: true
340:     redisStream:
341:       enabled: true
342:       stream: ""
343:       maxLen: 1000
344:     litellm:
345:       enabled: true
346:     registries:
347:       enabled: true
348:       endpoints:
349:         - "http://registry-local.kubeclaw.svc.cluster.local:5001"
350:         - "http://registry-mirror.kubeclaw.svc.cluster.local:5000"
351: # =============================================================================
352: # SHUTDOWN
353: # =============================================================================
354: 
355: shutdown:
356:   # Kubernetes sends SIGTERM after preStop completes; keep this long enough for
357:   # Redis task settlement, active-session termination, and lease cleanup.
358:   terminationGracePeriodSeconds: 180
359:   drainFile: "/tmp/kubeclaw-draining"
360:   preStopDrainSeconds: 5
361: 
362: # =============================================================================
363: # SERVICE ACCOUNT
364: # =============================================================================
365: # When enabled, creates an agent ServiceAccount. By default it does not mount a
366: # Kubernetes token. Buster deployments that need Kubernetes suite access use
367: # busterNamespaceBroker; the chart projects a lease-client token only into the
368: # pipeline sidecar and keeps the gateway token-free.
369: 
370: serviceAccount:
371:   create: false
372:   automount: false
373: 
374: # =============================================================================
375: # BUSTER NAMESPACE BROKER (Buster only)
376: # =============================================================================
377: # Self-contained namespace lease controller for Buster k8s tests.
378: # Buster can create BusterNamespaceLease objects in the release namespace; the
379: # trusted controller creates/deletes ephemeral test namespaces and binds Buster's
380: # ServiceAccount only inside those namespaces.
381: 
382: busterNamespaceBroker:
383:   enabled: false
384:   # Grants the agent ServiceAccount permission to request ephemeral test
385:   # namespaces through BusterNamespaceLease CRs. Buster gets this permission
386:   # whenever broker mode is enabled. Other roles, such as Nova E2E, must opt in
387:   # explicitly and still do not receive namespace/workload authority.
388:   leaseClient:
389:     enabled: false
390:     verificationRead:
391:       enabled: false
392:       # Existing operator namespace; shared by the scoped RBAC and agent probe.
393:       # The agent release does not create or own this namespace or Secret.
394:       tailscaleOperatorNamespace: tailscale
395:       tailscaleOAuthSecretName: operator-oauth
396:   # Opt-in trusted Nova runtime only; same-container code is not isolated by this mount.
397:   readyClient:
398:     enabled: false
399:     endpoint: ""
400:     audience: ""
401:     caSecretName: ""
402:   allowedPrefixes:
403:     - test
404:   defaultTtlSeconds: 7200
405:   maxTtlSeconds: 86400
406:   controller:
407:     # Independent human-decision authority; empty configuration denies all.
408:     productDecisions:
409:       enabled: false
410:       audience: ""
411:       producerNamespace: ""
412:       producerServiceAccount: ""
413:       issuer: ""
414:       verifyKey: "" # Raw Ed25519 public key, standard base64; never a signing key.
415:       allowedActors: []
416:     readiness:
417:       enabled: false
418:       audience: ""
419:       producerNamespace: ""
420:       producerServiceAccount: ""
421:       tlsSecretName: ""
422:     # A lease can bind only these service accounts and access modes. Each lease
423:     # must explicitly request its subjects; no agent is added to all namespaces.
424:     allowedAccess:
425:       # Subjects without a namespace are resolved in the Helm release namespace.
426:       - subject: agent-buster
427:         modes: [deployer, tester]
428:       - subject: agent-nova
429:         modes: [deployer]
430:     # Only these Secrets can be copied from the release namespace into a test
431:     # namespace. Test-login Secrets are created separately and scoped by name.
432:     allowedSourceSecrets: []
433:     image:
434:       repository: ghcr.io/datrab/kubeclaw-namespace-controller
435:       tag: latest
436:       pullPolicy: Always
437:     pollIntervalMs: 3000
438:     resources:
439:       requests: { cpu: 50m, memory: 128Mi }
440:       limits: { cpu: 500m, memory: 512Mi }
441: 
442: # =============================================================================
443: # COMMANDS
444: # =============================================================================
445: 
446: commands:
447:   # Channel-qualified operator IDs for OpenClaw owner-only commands.
448:   # Example: ["discord:123456789012345678"]
449:   ownerAllowFrom: []
450:   # Discord user IDs allowed to use DMs, commands, and guild channels. Bare,
451:   # "user:", and "discord:" forms are accepted here; guild policy renders
452:   # canonical bare IDs under channels.discord.guilds.*.users.
453:   allowFromDiscord: []
454: 
455: # =============================================================================
456: # SWARM CONFIG
457: # =============================================================================
458: # Platform-level config for the pipeline engine.
459: # Mounted read-only as a complete bundle at /etc/kubeclaw/swarm.
460: # SWARM_CONFIG is an explicit entry into the mounted component bundle.
461: # All operator values are authored in files/config/*-*.config.json.
462: # The former swarmConfigJson inline author is rejected, including an empty value.
463: 
464: swarmConfig:
465:   # Applies only to existing lint/tool-file copying, never the operator bundle.
466:   overrideOnRestart: false
467: 
468: # Default is loaded from charts/kubeclaw/files/config/.semgrep.yml.
469: # To override, paste your full YAML config here:
470: #
471: #   semgrepConfigYaml: |
472: #     rules:
473: #       - id: my-rule
474: #         ...
475: 
476: semgrepConfigYaml: ""
477: 
478: # Default is loaded from charts/kubeclaw/files/config/eslint-config.mjs.
479: # To override, paste your full flat-config module here:
480: #
481: #   eslintConfigMjs: |
482: #     export default [
483: #       {
484: #         rules: {
485: #           'no-alert': 'warn',
486: #         },
487: #       },
488: #     ];
489: 
490: eslintConfigMjs: ""
491: 
492: # =============================================================================
493: # CUSTOM SKILLS (optional)
494: # =============================================================================
495: # KubeClaw system skills (redis.ts, memory.js, pipeline.ts, etc.) are delivered
496: # by code bundles. This section is ONLY for additional user-defined skills.
497: #
498: # Example:
499: #   customSkills:
500: #     my-notifier.js: |
501: #       #!/usr/bin/env node
502: #       console.log("custom skill");
503: 
504: customSkills: {}
505: 
506: # =============================================================================
507: # SCHEDULING
508: # =============================================================================
509: 
510: nodeSelector: {}
511: tolerations: []
512: podAnnotations: {}
513: extraEnv: []
514: 
515: # -- Extra sidecar containers to inject into the agent pod (e.g. archviewer)
516: extraContainers: []
517: 
518: # Architecture documents require both Tailnet access and HTTP credentials.
519: # Supply Secret/<existingSecret> with an htpasswd key outside the repository.
520: archviewer:
521:   enabled: false
522:   # Both providers require active enforcement; policies are additive.
523:   networkPolicyProvider: cilium
524:   existingSecret: ""
525:   hostname: nova-architecture
526:   tailscaleOperatorNamespace: tailscale
527: 
528: # -- Extra volumes to mount into the agent pod
529: extraVolumes: []
530: 
531: # -- Extra volume mounts for the main kubeclaw container
532: extraVolumeMounts: []
533: 
534: busterRuntimePersistence:
535:   enabled: false
536:   claimName: ""
537:   size: 64Gi
538:   storageClass: ""
539: 
540: # Generated by render-native-worker-node; required only for the Buster native role.
541: busterNative:
542:   nodeName: ""
543:   namespace: ""
544:   policyDigest: ""

