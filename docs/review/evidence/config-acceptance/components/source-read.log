9:     const decimalPlaces = mantissa.includes('.') ? mantissa.length - mantissa.indexOf('.') - 1 : 0;
10:     let numerator = BigInt(mantissa.replace('.', ''));
11:     let denominator = 10n ** BigInt(decimalPlaces);
12:     const binaryPowers = new Map([['Ki', 10n], ['Mi', 20n], ['Gi', 30n], ['Ti', 40n], ['Pi', 50n], ['Ei', 60n]]);
13:     const decimalPowers = new Map([['n', -9], ['u', -6], ['m', -3], ['k', 3], ['K', 3],
14:         ['M', 6], ['G', 9], ['T', 12], ['P', 15], ['E', 18]]);
15:     if (parsed[2])
16:         numerator *= 1n << binaryPowers.get(parsed[2])!;
17:     const exponent = parsed[3] ? decimalPowers.get(parsed[3])!
18:         : parsed[4] ? Number.parseInt(parsed[4].slice(1), 10) : 0;
19:     if (!Number.isSafeInteger(exponent) || Math.abs(exponent) > 63) {
20:         throw new Error(`KUBERNETES_FIXTURE_STORAGE_QUANTITY_INVALID:${quantity}`);
21:     }
22:     if (exponent >= 0)
23:         numerator *= 10n ** BigInt(exponent);
24:     else
25:         denominator *= 10n ** BigInt(-exponent);
26:     if (numerator < 1n || numerator % denominator !== 0n) {
27:         throw new Error(`KUBERNETES_FIXTURE_STORAGE_QUANTITY_INVALID:${quantity}`);
28:     }
29:     return numerator / denominator;
