70: function validatePodContainers(spec: JsonObject, podSecurity: JsonObject): void {
71:     for (const field of ['initContainers', 'containers']) {
72:         const containers = spec[field];
73:         if (containers === undefined)
74:             continue;
75:         if (!Array.isArray(containers) || (field === 'containers' && containers.length < 1)) {
