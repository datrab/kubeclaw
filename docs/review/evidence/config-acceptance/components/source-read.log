174:       await handle.sync();
175:     } finally {
176:       await handle.close();
177:     }
178:     await fs.rename(temporary, file);
179:     renamed = true;
180:     await syncDirectory(path.dirname(file));
181:   } finally {
182:     if (!renamed) await fs.unlink(temporary).catch(() => undefined);
183:   }
184: }
185: async function acquireKernelLock(
186:   lockFile: string,
187: ): Promise<() => Promise<void>> {
188:   const child = spawn(
189:     "/usr/bin/flock",
190:     [
191:       "--exclusive",
192:       "--timeout",
193:       "5",
194:       lockFile,
195:       "/bin/sh",
196:       "-c",
197:       "printf 'locked\\n'; exec /bin/cat >/dev/null",
198:     ],
199:     { stdio: ["pipe", "pipe", "pipe"] },
200:   );
201:   let error = "";
202:   child.stderr?.on("data", (chunk: Buffer) => {
203:     error += chunk.toString("utf8");
204:   });
205:   const exited = new Promise<number | null>((resolve, reject) => {
206:     child.once("error", reject);
207:     child.once("exit", resolve);
208:   });
209:   await new Promise<void>((resolve, reject) => {
210:     let output = "";
211:     child.stdout?.on("data", (chunk: Buffer) => {
212:       output += chunk.toString("utf8");
213:       if (output.includes("locked\n")) resolve();
214:     });
215:     child.once("error", reject);
216:     child.once("exit", (code) => {
217:       if (!output.includes("locked\n"))
218:         reject(new Error(`OBSERVABILITY_STORE_LOCKED:${code}:${error.trim()}`));
219:     });
220:   });
221:   return async () => {
222:     child.stdin?.end();
223:     const code = await exited;
224:     if (code !== 0)
225:       throw new Error(
226:         `OBSERVABILITY_STORE_UNLOCK_FAILED:${code}:${error.trim()}`,
227:       );
228:   };
229: }
230: async function cleanupCrashArtifacts(
231:   directory: string,
232:   file: string,
233: ): Promise<void> {
234:   const basename = path.basename(file);
235:   for (const entry of await fs.readdir(directory, { withFileTypes: true })) {
236:     if (
237:       entry.isFile() &&
238:       entry.name.startsWith(`${basename}.`) &&
239:       entry.name.endsWith(".tmp")
240:     )
241:       await fs.unlink(path.join(directory, entry.name)).catch(() => undefined);
242:   }
243: }
244: export async function withDurableStoreLock<T>(
245:   file: string,
246:   operation: () => Promise<T>,
247: ): Promise<T> {
248:   const directory = path.dirname(file);
249:   await ensureDirectoryDurable(directory);
250:   const lockFile = path.join(directory, ".write-lock");
251:   const handle = await fs.open(lockFile, "a+", 0o600);
252:   try {
253:     const stat = await handle.stat();
254:     if (!stat.isFile() || stat.nlink !== 1)
255:       throw new Error("OBSERVABILITY_STORE_LOCK_FILE_INVALID");
256:   } finally {
257:     await handle.close();
258:   }
259:   let release: () => Promise<void>;
260:   try {
261:     release = await acquireKernelLock(lockFile);
262:   } catch (error) {
263:     throw new Error(
264:       `OBSERVABILITY_STORE_LOCK_FAILED:${file}:${error instanceof Error ? error.message : String(error)}`,
265:     );
266:   }
267:   try {
268:     await cleanupCrashArtifacts(directory, file);
269:     return await operation();
270:   } finally {
271:     await release();
272:   }
273: }
274: function keyOf(record: ProducerRecordV1): string {
275:   return [
276:     record.producer.producerId,
277:     record.producer.bootId,
278:     record.producer.producerType,
279:     record.correlation.pipelineRunId,
280:     String(record.sequence),
281:   ].join("|");
282: }
283: function validLimit(value: number): boolean {
284:   return Number.isSafeInteger(value) && value > 0;
285: }
286: function validIdentityPart(value: unknown): value is string {
287:   return (
288:     typeof value === "string" &&
289:     value.length >= 1 &&
290:     value.length <= 256 &&
291:     /^[A-Za-z0-9][A-Za-z0-9._:-]*$/.test(value)
292:   );
293: }
294: function quarantineAttribution(
295:   raw: Uint8Array | string,
296: ): AdmissionState["unresolvedItems"][number] | null {
297:   try {
298:     const bytes = Buffer.from(raw);
299:     const decoded = JSON.parse(bytes.toString("utf8")) as {
300:       producer?: Record<string, unknown>;
301:       correlation?: { pipelineRunId?: string };
302:       recordId?: string;
303:     };
304:     if (
305:       !decoded.producer ||
306:       !validIdentityPart(decoded.producer.producerId) ||
307:       !validIdentityPart(decoded.producer.bootId) ||
308:       !validIdentityPart(decoded.producer.producerType) ||
309:       !validIdentityPart(decoded.correlation?.pipelineRunId)
310:     )
311:       return null;
312:     const producer = {
313:       producerId: decoded.producer.producerId,
314:       bootId: decoded.producer.bootId,
315:       producerType: decoded.producer.producerType,
316:     };
317:     const rawDigest = createHash("sha256").update(bytes).digest("hex");
318:     return {
319:       itemId: `quarantine:${rawDigest}`,
320:       kind: "quarantined-record",
321:       producer,
322:       subjectId: validIdentityPart(decoded.recordId)
323:         ? decoded.recordId
324:         : `record:${rawDigest}`,
325:       reasonCode: "record-quarantined",
326:       pipelineRunId: decoded.correlation.pipelineRunId,
327:     };
328:   } catch {
329:     return null;
330:   }
331: }
332: 
333: export class FileProducerOutbox {
334:   readonly #file: string;
335:   readonly #limits: ProducerOutboxLimits;
336:   #queue: Promise<unknown> = Promise.resolve();
337:   constructor(directory: string, limits: ProducerOutboxLimits) {
338:     if (!validLimit(limits.maximumRecords) || !validLimit(limits.maximumBytes))
339:       throw new Error("OBSERVABILITY_OUTBOX_LIMIT_INVALID");
340:     this.#file = path.join(directory, "outbox.json");
341:     this.#limits = limits;
342:   }
343:   #serial<T>(operation: () => Promise<T>): Promise<T> {
344:     const locked = () => withDurableStoreLock(this.#file, operation);
345:     const result = this.#queue.then(locked, locked);
346:     this.#queue = result.then(
347:       () => undefined,
348:       () => undefined,
349:     );
350:     return result;
351:   }
352:   async append(
353:     unsigned: Omit<ProducerRecordV1, "recordDigest"> | ProducerRecordV1,
354:   ): Promise<ProducerRecordV1> {
355:     const input = structuredClone(unsigned);
356:     const candidateRecord = {
357:       ...input,
358:       recordDigest: producerRecordDigest(input as ProducerRecordV1),
359:     } as ProducerRecordV1;
360:     const bytes = canonicalJson(candidateRecord);
361:     const record = decodePipelineObservabilityContract(
362:       "producerRecord",
363:       bytes,
364:     ) as ProducerRecordV1;
365:     return this.#serial(async () => {
366:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
367:       const key = keyOf(record);
368:       const existing = state.entries.find(
369:         (entry) => keyOf(entry.record) === key,
370:       );
371:       if (existing) {
372:         if (existing.record.recordDigest !== record.recordDigest)
373:           throw new Error("OBSERVABILITY_OUTBOX_IDENTITY_CONFLICT");
374:         return structuredClone(existing.record);
375:       }
376:       const candidate = {
377:         ...state,
378:         entries: [
379:           ...state.entries,
380:           { record, bytes, acknowledged: false, canonicalCursor: null },
381:         ],
382:       };
383:       if (
384:         state.entries.length >= this.#limits.maximumRecords ||
385:         Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes
386:       )
387:         throw new Error("OBSERVABILITY_OUTBOX_FULL");
388:       await writeDurableState(this.#file, candidate);
389:       return structuredClone(record);
390:     });
391:   }
392:   async pending(): Promise<ReadonlyArray<OutboxEntry>> {
393:     return this.#serial(async () => {
394:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
395:       return state.entries
396:         .filter((entry) => !entry.acknowledged)
397:         .sort((left, right) => left.record.sequence - right.record.sequence);
398:     });
399:   }
400:   async acknowledge(ack: AdmissionAcknowledgementV1): Promise<void> {
401:     validatePipelineObservabilityContract("admissionAcknowledgement", ack);
402:     const snapshot = JSON.parse(
403:       canonicalJson(ack),
404:     ) as AdmissionAcknowledgementV1;
405:     await this.#serial(async () => {
406:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
407:       const entry = state.entries.find(
408:         (candidate) =>
409:           candidate.record.recordId === snapshot.recordId &&
410:           keyOf(candidate.record) ===
411:             [
412:               snapshot.producer.producerId,
413:               snapshot.producer.bootId,
414:               snapshot.producer.producerType,
415:               snapshot.pipelineRunId,
416:               String(snapshot.sequence),
417:             ].join("|"),
418:       );
419:       if (
420:         !entry ||
421:         entry.record.recordDigest !== snapshot.recordDigest ||
422:         entry.record.producer.producerType !== snapshot.producer.producerType
423:       )
424:         throw new Error("OBSERVABILITY_ACK_MISMATCH");
425:       entry.acknowledged = true;
426:       entry.canonicalCursor = snapshot.canonicalCursor;
427:       await writeDurableState(this.#file, state);
428:     });
429:   }
430:   async compact(): Promise<number> {
431:     return this.#serial(async () => {
432:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
433:       const before = state.entries.length;
434:       state.entries = state.entries.filter((entry) => !entry.acknowledged);
435:       await writeDurableState(this.#file, state);
436:       return before - state.entries.length;
437:     });
438:   }
439: }
