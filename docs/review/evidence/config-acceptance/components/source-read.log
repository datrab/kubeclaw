71: function mapCompletedOutputs(input: ResultInput, workerExecutionState: ExecutionState,
72:   completedProviderResult: ProviderResultV1 | null, evidence: EvidenceRefV1[]): void {
73:  const { state } = input;
74:  const { entry } = input.prepared;
75:     if (workerExecutionState === "completed" && completedProviderResult) {
76:       try {
77:         state.producedOutputs = validateAndMapOutputs(
78:           entry,
79:           completedProviderResult,
80:           new Map(evidence.map((item) => [item.evidenceId, item])),
81:         );
82:       } catch (error) {
83:         state.evidenceFault = detail(error);
84:         state.producedOutputs = [];
85:       }
86:     }
87: }
