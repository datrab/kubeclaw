1: import type { BusterProcessInputSettings } from '../../../common/plugin-runtime/foundation/config/buster-execution.ts';
2: import { DirectCommandCapabilityInvoker, type DirectCommandCapabilityInvokerOptions } from './direct-command-runtime.ts';
3: import { ContainerBuildCapabilityInvoker, type ContainerBuildCapabilityInvokerOptions } from './container-build-runtime.ts';
4: import { KubernetesFixtureCapabilityInvoker, type KubernetesFixtureCapabilityInvokerOptions } from './kubernetes-fixture-runtime.ts';
5: import { TailscaleExposureCapabilityInvoker, type TailscaleExposureCapabilityInvokerOptions } from './tailscale-exposure-runtime.ts';
6: import { NetworkHttpCapabilityInvoker, type NetworkHttpCapabilityInvokerOptions } from './network-http-runtime.ts';
7: import { BrowserAxeCapabilityInvoker, type BrowserAxeCapabilityInvokerOptions } from './browser-axe-runtime.ts';
8: import { BrowserLighthouseCapabilityInvoker, type BrowserLighthouseCapabilityInvokerOptions } from './browser-lighthouse-runtime.ts';
9: import { BrowserVisualCapabilityInvoker, type BrowserVisualCapabilityInvokerOptions } from './browser-visual-runtime.ts';
10: import { BrowserPlaywrightCapabilityInvoker, type BrowserPlaywrightCapabilityInvokerOptions } from './browser-playwright-runtime.ts';
11: import { SecurityScanCapabilityInvoker, type SecurityScanCapabilityInvokerOptions } from './security-scan-runtime.ts';
12: import { KubernetesRuntimeSecurityCapabilityInvoker,
13:   type KubernetesRuntimeSecurityCapabilityInvokerOptions } from './kubernetes-runtime-security.ts';
14: import { CompositeTestProviderCapabilityInvoker } from './composite-capability-runtime.ts';
15: import type { TestProviderCapabilityInvoker } from './runner.ts';
16: 
17: export interface BusterCapabilityRuntimeOptions {
18:   readonly allowedCapabilities: ReadonlySet<string>;
19:   readonly directCommand?: Omit<DirectCommandCapabilityInvokerOptions, 'workspaceRoot'>;
20:   readonly containerBuild?: Omit<ContainerBuildCapabilityInvokerOptions, 'workspaceRoot'>;
21:   readonly kubernetesFixture?: Omit<KubernetesFixtureCapabilityInvokerOptions, 'workspaceRoot' | 'processInputPolicy'>;
22:   readonly tailscaleExposure?: Omit<TailscaleExposureCapabilityInvokerOptions, 'processInputPolicy'>;
23:   readonly networkHttp?: NetworkHttpCapabilityInvokerOptions;
24:   readonly browserAxe?: BrowserAxeCapabilityInvokerOptions;
25:   readonly browserLighthouse?: BrowserLighthouseCapabilityInvokerOptions;
26:   readonly browserVisual?: BrowserVisualCapabilityInvokerOptions;
27:   readonly browserPlaywright?: Omit<BrowserPlaywrightCapabilityInvokerOptions, 'workspaceRoot'>;
28:   readonly securityScan?: Omit<SecurityScanCapabilityInvokerOptions, 'workspaceRoot'>;
29:   readonly kubernetesRuntimeSecurity?: Omit<KubernetesRuntimeSecurityCapabilityInvokerOptions, 'workspaceRoot'>;
30: }
31: 
32: /** Construct the complete local capability owner in the process that executes work.
33:  * The service currently owns this process; native cutover must move this single
34:  * construction boundary into the attempt host, without parent-side RPC work. */
35: export function createBusterCapabilityRuntime(options: BusterCapabilityRuntimeOptions,
36:   paths: Readonly<{ jobRoot: string; workspaceRoot: string }>, processInputPolicy: BusterProcessInputSettings) {
37:   const { jobRoot, workspaceRoot } = paths;
38:   const routes = new Map<string, TestProviderCapabilityInvoker>();
39:   const add = <T extends TestProviderCapabilityInvoker>(capability: string, create: () => T): T | undefined => {
40:     if (!options.allowedCapabilities.has(capability)) return undefined;
41:     const invoker = create(); routes.set(capability, invoker); return invoker;
42:   };
43:   const directCommand = add('command.execute', () => new DirectCommandCapabilityInvoker({
44:     ...required(options.directCommand, 'BUSTER_DIRECT_COMMAND_CONFIG_REQUIRED'), workspaceRoot,
45:   }));
46:   add('container.build', () => new ContainerBuildCapabilityInvoker({
47:     ...required(options.containerBuild, 'BUSTER_CONTAINER_BUILD_CONFIG_REQUIRED'), workspaceRoot,
48:   }));
49:   add('kubernetes.fixture', () => new KubernetesFixtureCapabilityInvoker({
50:     ...required(options.kubernetesFixture, 'BUSTER_KUBERNETES_FIXTURE_CONFIG_REQUIRED'), workspaceRoot: jobRoot, processInputPolicy,
51:   }));
52:   add('kubernetes.exposure', () => new TailscaleExposureCapabilityInvoker(
53:     { ...required(options.tailscaleExposure, 'BUSTER_TAILSCALE_EXPOSURE_CONFIG_REQUIRED'), processInputPolicy }));
54:   add('network.http', () => new NetworkHttpCapabilityInvoker(
55:     required(options.networkHttp, 'BUSTER_NETWORK_HTTP_CONFIG_REQUIRED')));
56:   add('browser.axe', () => new BrowserAxeCapabilityInvoker(
57:     required(options.browserAxe, 'BUSTER_BROWSER_AXE_CONFIG_REQUIRED')));
58:   add('browser.lighthouse', () => new BrowserLighthouseCapabilityInvoker(
59:     required(options.browserLighthouse, 'BUSTER_BROWSER_LIGHTHOUSE_CONFIG_REQUIRED')));
60:   add('browser.visual', () => new BrowserVisualCapabilityInvoker(
61:     required(options.browserVisual, 'BUSTER_BROWSER_VISUAL_CONFIG_REQUIRED')));
62:   add('browser.playwright', () => new BrowserPlaywrightCapabilityInvoker({
63:     ...required(options.browserPlaywright, 'BUSTER_BROWSER_PLAYWRIGHT_CONFIG_REQUIRED'), workspaceRoot,
64:   }));
65:   add('security.scan', () => new SecurityScanCapabilityInvoker({
66:     ...required(options.securityScan, 'BUSTER_SECURITY_SCAN_CONFIG_REQUIRED'), workspaceRoot: jobRoot,
67:   }));
68:   add('kubernetes.runtime-security', () => new KubernetesRuntimeSecurityCapabilityInvoker({
69:     ...required(options.kubernetesRuntimeSecurity, 'BUSTER_KUBERNETES_RUNTIME_SECURITY_CONFIG_REQUIRED'), workspaceRoot: jobRoot,
70:   }));
71:   const invoker = routes.size ? new CompositeTestProviderCapabilityInvoker(routes) : null;
72:   return { invoker, async shutdown(): Promise<void> { await directCommand?.shutdown(); } };
73: }
74: 
75: function required<T>(value: T | undefined, errorCode: string): T {
76:   if (value === undefined || value === null) throw new Error(errorCode);
77:   return value;
78: }

SOURCE skills/buster/engine/test-gates/dependency-process.ts SHA256 c1f305fd3281328e1cd5714b1366cb946907e2a96af2bf6c3f629c2ab4ed354b
1: import { spawn } from 'node:child_process';
2: import crypto from 'node:crypto';
3: 
4: export interface DependencyProcessOptions {
5:   readonly executable: string;
6:   readonly args: readonly string[];
7:   readonly maximumExecutionMs: number;
8:   readonly maximumOutputBytes: number;
9:   readonly signal?: AbortSignal;
10: }
11: export interface DependencyProcessResult {
12:   readonly ok: boolean;
13:   readonly code: 'DEPENDENCY_OK' | 'DEPENDENCY_CANCELLED' | 'DEPENDENCY_TIMEOUT' | 'DEPENDENCY_OUTPUT_LIMIT' | 'DEPENDENCY_SPAWN_FAILED' | 'DEPENDENCY_EXIT_FAILED';
14:   readonly exitCode: number | null;
15:   readonly signal: string | null;
16:   readonly errno: string | null;
17:   readonly outputBytes: number;
18:   readonly outputDigest: string;
19:   readonly durationMs: number;
20: }
21: 
22: export function validateDependencyProcessLimits(options: Pick<DependencyProcessOptions, 'maximumExecutionMs' | 'maximumOutputBytes'>): void {
23:   for (const [value, maximum] of [[options.maximumExecutionMs, 30_000], [options.maximumOutputBytes, 1024 * 1024]] as const) {
24:     if (!Number.isSafeInteger(value) || value < 1 || value > maximum) throw new Error('DEPENDENCY_PROCESS_LIMIT_INVALID');
25:   }
26: }
27: 
28: /** Wait for actual child closure after termination; never race against detached work. */
29: export async function runDependencyProcess(options: DependencyProcessOptions): Promise<DependencyProcessResult> {
30:   validateDependencyProcessLimits(options);
31:   const started = Date.now();
32:   if (options.signal?.aborted) return { ok: false, code: 'DEPENDENCY_CANCELLED', exitCode: null, signal: null, errno: null,
33:     outputBytes: 0, outputDigest: `sha256:${crypto.createHash('sha256').digest('hex')}`, durationMs: 0 };
34:   return await new Promise<DependencyProcessResult>((resolve) => {
35:     const child = spawn(options.executable, [...options.args], {
36:       detached: true, stdio: ['ignore', 'pipe', 'pipe'], env: { PATH: '/usr/local/bin:/usr/bin:/bin', LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' },
37:     });
38:     let failure: DependencyProcessResult['code'] | undefined;
39:     let errno: string | null = null;
40:     let outputBytes = 0;
41:     const digest = crypto.createHash('sha256');
42:     const stop = (code: DependencyProcessResult['code']): void => {
43:       failure ??= code;
44:       if (!child.pid) return;
45:       try { process.kill(-child.pid, 'SIGKILL'); }
46:       catch (error) {
47:         const code = (error as NodeJS.ErrnoException).code;
48:         if (code !== 'ESRCH') { errno = 'TERMINATION_FAILED'; child.kill('SIGKILL'); }
49:       }
50:     };
51:     const cancel = (): void => stop('DEPENDENCY_CANCELLED');
52:     options.signal?.addEventListener('abort', cancel, { once: true });
53:     if (options.signal?.aborted) cancel();
54:     const timer = setTimeout(() => stop('DEPENDENCY_TIMEOUT'), options.maximumExecutionMs);
55:     const output = (chunk: Buffer): void => {
56:       if (failure) return;
57:       outputBytes += chunk.byteLength;
58:       if (outputBytes > options.maximumOutputBytes) { stop('DEPENDENCY_OUTPUT_LIMIT'); return; }
59:       digest.update(chunk);
60:     };
61:     child.stdout.on('data', output); child.stderr.on('data', output);
62:     child.once('error', (error: NodeJS.ErrnoException) => {
63:       failure ??= 'DEPENDENCY_SPAWN_FAILED';
64:       errno = typeof error.code === 'string' && /^[A-Z0-9_]+$/u.test(error.code) ? error.code : 'UNKNOWN';
65:     });
66:     child.once('close', (exitCode, signal) => {
67:       clearTimeout(timer);
68:       options.signal?.removeEventListener('abort', cancel);
69:       const code = failure ?? (exitCode === 0 ? 'DEPENDENCY_OK' : 'DEPENDENCY_EXIT_FAILED');
70:       resolve({ ok: code === 'DEPENDENCY_OK', code, exitCode, signal, errno, outputBytes,
71:         outputDigest: `sha256:${digest.digest('hex')}`, durationMs: Date.now() - started });
72:     });
73:   });
74: }

SOURCE skills/buster/engine/test-gates/kubernetes-fixture-inspection.ts SHA256 d2ea5344cca6f0e849dbe94b3bb455e170c7a0ec44d8e2f9f0517c5bd3ce0a74
1: import type { BusterManifestPolicy } from '../../../common/plugin-runtime/foundation/config/buster-cluster-invokers.ts';
2: import { boundedManifestDocuments } from './kubernetes-manifest.ts';
3: import { flattenDocuments } from './kubernetes-fixture-manifest-files.ts';
4: import { podSpecs, validatePodSecurity } from './kubernetes-fixture-pods.ts';
5: import { persistentVolumeClaims, validatePersistentVolumeClaim, type PersistentVolumePolicy } from './kubernetes-fixture-storage.ts';
6: import { object, text, IMMUTABLE_IMAGE, type JsonObject } from './kubernetes-fixture-values.ts';
7: const CLUSTER_SCOPED_KINDS = new Set([
8:     'APIService', 'CertificateSigningRequest', 'ClusterRole', 'ClusterRoleBinding',
9:     'CSIDriver', 'CSINode', 'CustomResourceDefinition', 'FlowSchema', 'IngressClass',
10:     'MutatingWebhookConfiguration', 'Namespace', 'Node', 'PersistentVolume',
11:     'PriorityClass', 'PriorityLevelConfiguration', 'RuntimeClass', 'StorageClass',
12:     'ValidatingAdmissionPolicy', 'ValidatingAdmissionPolicyBinding',
13:     'ValidatingWebhookConfiguration', 'VolumeSnapshotClass',
14: ]);
15: const ALLOWED_NAMESPACED_KINDS = new Set([
16:     'ConfigMap', 'CronJob', 'Deployment', 'Job', 'PersistentVolumeClaim', 'Pod', 'Service', 'StatefulSet',
17: ]);
18: interface ManifestPolicy {
19:     readonly manifest: BusterManifestPolicy;
20:     readonly immutableImage: string;
21:     readonly maximumResources: number;
22:     readonly allowedRegistryPrefixes: readonly string[];
23:     readonly serviceName: string;
24:     readonly servicePort: number;
25:     readonly expectedServiceTargetPort: number | null;
26:     readonly persistentVolumePolicy: PersistentVolumePolicy;
27: }
28: interface InspectionState {
29:     workloads: number;
30:     matchedImage: boolean;
31:     matchedService: boolean;
32:     serviceTargetPortName: string | null;
33:     resolvedServiceTargetPort: number | null;
34:     namedContainerPorts: Map<string, Set<number>>;
35:     persistentVolumeTotalBytes: bigint;
36: }
37: export function inspectManifest(bytes: Buffer, policy: ManifestPolicy): {
38:     resources: number;
39:     workloads: number;
40:     serviceTargetPort: number;
41: } {
42:     const loaded = boundedManifestDocuments(bytes, policy.manifest);
43:     const documents = flattenDocuments(loaded, policy.maximumResources, policy.manifest);
44:     if (documents.length < 1 || documents.length > policy.maximumResources)
45:         throw new Error('KUBERNETES_FIXTURE_RESOURCE_COUNT_INVALID');
46:     const state: InspectionState = { workloads: 0, matchedImage: false, matchedService: false,
47:         serviceTargetPortName: null, resolvedServiceTargetPort: null,
48:         namedContainerPorts: new Map(), persistentVolumeTotalBytes: 0n };
49:     for (const document of documents)
50:         inspectDocument(document, policy, state);
51:     return finishInspection(documents.length, policy, state);
52: }
53: function inspectDocument(document: JsonObject, policy: ManifestPolicy, state: InspectionState): void {
54:     const apiVersion = text(document.apiVersion, 'apiVersion', 128);
55:     const kind = text(document.kind, 'kind', 128);
56:     const metadata = object(document.metadata, 'metadata');
57:     text(metadata.name, 'metadata.name', 253);
58:     if (CLUSTER_SCOPED_KINDS.has(kind))
59:         throw new Error(`KUBERNETES_FIXTURE_CLUSTER_SCOPE_DENIED:${kind}`);
60:     if (!ALLOWED_NAMESPACED_KINDS.has(kind))
61:         throw new Error(`KUBERNETES_FIXTURE_RESOURCE_KIND_DENIED:${kind}`);
62:     if (metadata.namespace !== undefined)
63:         throw new Error(`KUBERNETES_FIXTURE_NAMESPACE_FIELD_DENIED:${kind}`);
64:     if (!apiVersion.includes('/') && apiVersion !== 'v1')
65:         throw new Error('KUBERNETES_FIXTURE_API_VERSION_INVALID');
66:     for (const claim of persistentVolumeClaims(document)) {
67:         state.persistentVolumeTotalBytes += validatePersistentVolumeClaim(claim.name, claim.spec, policy.persistentVolumePolicy)
68:             * claim.copies;
69:         if (state.persistentVolumeTotalBytes > policy.persistentVolumePolicy.maximumTotalBytes) {
70:             throw new Error('KUBERNETES_FIXTURE_PVC_TOTAL_SIZE_DENIED');
71:         }
72:     }
73:     if (kind === 'Service')
74:         inspectService(document, metadata, policy, state);
75:     inspectPods(document, policy, state);
76: }
77: function inspectService(document: JsonObject, metadata: JsonObject, policy: ManifestPolicy, state: InspectionState): void {
78:     const spec = object(document.spec, 'service.spec');
79:     const type = spec.type ?? 'ClusterIP';
80:     const annotations = object(metadata.annotations ?? {}, 'service.metadata.annotations');
81:     const externalIPs = spec.externalIPs;
82:     const hasExternalIPs = externalIPs !== undefined && (!Array.isArray(externalIPs) || externalIPs.length > 0);
83:     const externalName = spec.externalName;
84:     const hasExternalName = externalName !== undefined
85:         && (typeof externalName !== 'string' || externalName.trim().length > 0);
86:     if (type !== 'ClusterIP' || hasExternalIPs || hasExternalName) {
87:         throw new Error('KUBERNETES_FIXTURE_EXTERNAL_SERVICE_DENIED');
88:     }
89:     if (annotations['tailscale.com/expose'] !== undefined) {
90:         throw new Error('KUBERNETES_FIXTURE_EXTERNAL_SERVICE_DENIED');
91:     }
92:     selectService(spec, metadata, policy, state);
93: }
94: function selectService(spec: JsonObject, metadata: JsonObject, policy: ManifestPolicy, state: InspectionState): void {
95:     if (metadata.name === policy.serviceName) {
96:         if (state.matchedService)
97:             throw new Error('KUBERNETES_FIXTURE_SERVICE_DUPLICATE');
98:         state.matchedService = true;
99:         const ports = Array.isArray(spec.ports) ? spec.ports.map((entry) => object(entry, 'service.port')) : [];
100:         const selected = ports.filter((entry) => entry.port === policy.servicePort);
101:         if (selected.length !== 1)
102:             throw new Error('KUBERNETES_FIXTURE_SERVICE_PORT_MISMATCH');
103:         const target = selected[0]!.targetPort ?? policy.servicePort;
104:         if (typeof target === 'number')
105:             state.resolvedServiceTargetPort = target;
106:         if (typeof target === 'string')
107:             state.serviceTargetPortName = target;
108:     }
109: }
110: function inspectPods(document: JsonObject, policy: ManifestPolicy, state: InspectionState): void {
111:     for (const spec of podSpecs(document)) {
112:         state.workloads += 1;
113:         validatePodSecurity(spec);
114:         for (const field of ['initContainers', 'containers']) {
115:             const containers = spec[field];
116:             if (containers === undefined)
117:                 continue;
118:             if (!Array.isArray(containers))
119:                 throw new Error('KUBERNETES_FIXTURE_CONTAINERS_INVALID');
120:             for (const container of containers) {
121:                 inspectContainer(container, policy, state);
122:             }
123:         }
124:     }
125: }
126: function inspectContainer(container: unknown, policy: ManifestPolicy, state: InspectionState): void {
127:     const containerObject = object(container, 'container');
128:     const image = text(containerObject.image, 'container.image', 2048);
129:     const parsed = IMMUTABLE_IMAGE.exec(image);
130:     if (!parsed)
131:         throw new Error(`KUBERNETES_FIXTURE_MUTABLE_IMAGE_DENIED:${image}`);
132:     if (!policy.allowedRegistryPrefixes.some((prefix) => parsed[1] === prefix || parsed[1]!.startsWith(`${prefix}/`))) {
133:         throw new Error(`KUBERNETES_FIXTURE_IMAGE_REGISTRY_DENIED:${image}`);
134:     }
135:     if (image === policy.immutableImage)
136:         state.matchedImage = true;
137:     recordContainerPorts(containerObject, state);
138: }
139: function recordContainerPorts(containerObject: JsonObject, state: InspectionState): void {
140:     for (const rawPort of Array.isArray(containerObject.ports) ? containerObject.ports : []) {
141:         const port = object(rawPort, 'container.port');
142:         if (typeof port.name === 'string' && Number.isSafeInteger(port.containerPort)) {
143:             const values = state.namedContainerPorts.get(port.name) ?? new Set<number>();
144:             values.add(Number(port.containerPort));
145:             state.namedContainerPorts.set(port.name, values);
146:         }
147:     }
148: }
149: function finishInspection(resources: number, policy: ManifestPolicy, state: InspectionState) {
150:     if (state.workloads < 1)
151:         throw new Error('KUBERNETES_FIXTURE_WORKLOAD_REQUIRED');
152:     if (!state.matchedImage)
153:         throw new Error('KUBERNETES_FIXTURE_IMAGE_NOT_USED');
154:     if (!state.matchedService)
155:         throw new Error('KUBERNETES_FIXTURE_SERVICE_REQUIRED');
156:     if (state.serviceTargetPortName !== null) {
157:         const ports = state.namedContainerPorts.get(state.serviceTargetPortName);
158:         if (ports?.size !== 1)
159:             throw new Error('KUBERNETES_FIXTURE_SERVICE_TARGET_PORT_MISMATCH');
160:         state.resolvedServiceTargetPort = [...ports][0]!;
161:     }
162:     if (state.resolvedServiceTargetPort === null || state.resolvedServiceTargetPort < 1 || state.resolvedServiceTargetPort > 65_535
