68:     }
69:     if (spec.volumeMode !== undefined && spec.volumeMode !== 'Filesystem') {
70:         throw new Error(`KUBERNETES_FIXTURE_PVC_VOLUME_MODE_DENIED:${name}`);
71:     }
72:     const storageClass = spec.storageClassName;
73:     if (storageClass === undefined) {
74:         if (!policy.allowDefaultStorageClass)
75:             throw new Error('KUBERNETES_FIXTURE_DEFAULT_STORAGE_CLASS_DENIED');
76:     }
77:     else {
78:         const selected = text(storageClass, 'persistentVolumeClaim.storageClassName', 253);
79:         if (!policy.allowedStorageClasses.has(selected)) {
