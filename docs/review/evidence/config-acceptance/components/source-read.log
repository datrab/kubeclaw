32: 
33: export class TestPlanRunner {
34:   readonly #options: TestPlanRunnerOptions;
35:   readonly #loader: TestProviderLoader;
36:   readonly #store: EvidenceStore;
37:   readonly #now: () => Date;
38:   readonly #id: () => string;
39:   readonly #workspaceRoot: string;
40:   readonly #authorityId: string;
41:   readonly #workerRuntime: WorkerAttemptRuntime;
42:   readonly #durableAttemptStore: FileDurableAttemptStore;
43:   readonly #observabilityAdmissionStore: FileObservabilityAdmissionStore;
44:   readonly #reportAdapterRuntime: ReportAdapterExecutor;
45:   readonly #customDurableAttemptStore: boolean;
46:   readonly #cleanupErrors: { nodeId: string; message: string }[] = [];
47:   readonly #retainedFixtures: Array<{
48:     node: ResolvedPlanNodeV1;
49:     execution: AttemptExecution;
50:   }> = [];
51: 
52:   constructor(options: TestPlanRunnerOptions) {
53:     const { workerLocalRuntime, executionPolicy } = validateRunnerOptions(options);
54:     const { workspaceRoot, artifactRoot, observabilityRoot } = prepareRunnerPaths(options);
55:     this.#workspaceRoot = workspaceRoot;
56:     this.#options = { ...options, workerLocalRuntime, executionPolicy, artifactRoot, observabilityRoot };
57:     this.#loader = options.loader ?? new RegisteredTestProviderLoader({ provider: executionPolicy.provider, observation: executionPolicy.observation });
58:     this.#store = options.evidenceStore ?? new FileEvidenceStore(artifactRoot);
59:     this.#reportAdapterRuntime = options.reportAdapterRuntime ?? new RegisteredReportAdapterRuntime(
60:       new FileReportArtifactReader([artifactRoot]), path.join(observabilityRoot, 'report-adapters'), executionPolicy.reports, executionPolicy.processInput);
61:     this.#customDurableAttemptStore = options.durableAttemptStore !== undefined;
62:     this.#durableAttemptStore =
63:       options.durableAttemptStore ??
64:       new FileDurableAttemptStore(path.join(observabilityRoot, "attempts"), executionPolicy.stores.attempts);
65:     this.#observabilityAdmissionStore =
66:       options.observabilityAdmissionStore ??
67:       new FileObservabilityAdmissionStore(path.join(observabilityRoot, "admission"), executionPolicy.stores.admission);
68:     this.#now = options.now ?? (() => new Date());
69:     this.#id = options.id ?? (() => crypto.randomUUID());
70:     this.#authorityId = `test-runner:${options.plan.planDigest}`;
71:     this.#workerRuntime = configuredWorkerRuntime(options, workerLocalRuntime, this.#now);
72:   }
73: 
74:   async run(): Promise<TestPlanRunResult> {
75:     let recoveredCompletions = 0;
76:     if (
77:       this.#customDurableAttemptStore ||
78:       fs.existsSync(
79:         path.join(
80:           this.#options.observabilityRoot,
81:           "attempts",
82:           "attempt-store.json",
83:         ),
84:       )
85:     )
86:       recoveredCompletions = await resumeRunnerCompletions(this.#completionOwner());
87:     if (recoveredCompletions > 0)
88:       throw new Error(
89:         `TEST_RUNNER_RECOVERY_OWNED_BY_NOVA:${recoveredCompletions}`,
90:       );
91:     return new RunnerScheduler({
92:       options: this.#options,
93:       authorityId: this.#authorityId,
94:       id: this.#id,
95:       cleanupErrors: this.#cleanupErrors,
96:       executeNode: (node, outputs) => this.#executeNode(node, outputs),
97:       retainFixture: (node, execution) => this.#retainedFixtures.push({ node, execution }),
98:       cleanupFixtures: () => this.#cleanupFixtures(),
99:     }).run();
100:   }
101: 
102:   #executeNode(node: ResolvedPlanNodeV1,
103:     outputs: ReadonlyMap<string, readonly ProducedOutputV1[]>): Promise<NodeExecution> {
104:     return executeRunnerNode({
105:       options: this.#options, authorityId: this.#authorityId, id: this.#id,
106:       executeAttempt: (next, attempt, values) => this.#executeAttempt(next, attempt, values),
107:     }, node, outputs);
108:   }
109: 
110:   async #executeAttempt(
111:     node: ResolvedPlanNodeV1,
112:     attemptNumber: number,
113:     outputs: ReadonlyMap<string, readonly ProducedOutputV1[]>,
114:   ): Promise<AttemptExecution> {
115:     const prepared = prepareRunnerAttempt({ options: this.#options, workspaceRoot: this.#workspaceRoot, id: this.#id },
116:       node, attemptNumber, outputs);
117:     const { attemptId, attemptRepository, stagingBase, evidenceDirectory, stagedEvidenceDirectory,
118:       stagedErrorEvidenceDirectory, runnerEvidenceDirectory, entry, granted, preparationFault,
119:       missingCapability, invocation } = prepared;
120:     const state = createRunnerProviderState();
121:     const providerResultLimit = this.#options.executionPolicy.provider.maximumResultBytes;
122:     const busterLog = createLogCapture(node.limits.logBytes);
123:     const retainAnyLog = entry.registration.evidenceTypes.includes("log") &&
124:       [...node.evidence.onPass, ...node.evidence.onFail, ...node.evidence.onError].includes("log");
125:     const cleanupTimeoutMs = this.#options.executionPolicy.provider.cleanupTimeoutMs;
126:     const operation = createRunnerProviderOperation({
127:       options: this.#options, node, entry, invocation, workspaceRoot: this.#workspaceRoot,
128:       attemptId, evidenceDirectory, stagedEvidenceDirectory, stagedErrorEvidenceDirectory,
129:       runnerEvidenceDirectory, granted, providerResultLimit, cleanupTimeoutMs, retainAnyLog, busterLog,
130:       loader: this.#loader, reportAdapterRuntime: this.#reportAdapterRuntime,
131:       context: (signal, log, grants, inputs) => this.#context(signal, log, grants, inputs),
132:       collectEvidence: (provider, id, directory, declarations, files, bytes, signal) =>
133:         this.#collectEvidence(provider, id, directory, declarations, files, bytes, signal),
134:     }, state, preparationFault, missingCapability);
135:     const issuedAt = this.#now();
136:     const workerEnvelope = createRunnerEnvelope({ options: this.#options, node, attemptId, attemptNumber,
137:       granted, cleanupTimeoutMs, providerResultLimit, invocation, operation, issuedAt });
138:     const { workerResult, workerRuntimeFault } = await executeRunnerAttempt({
139:       options: this.#options, workerRuntime: this.#workerRuntime, now: this.#now,
140:       id: this.#id, authorityId: this.#authorityId, completion: this.#completionOwner(),
141:     }, workerEnvelope, operation, stagingBase);
142:     return finalizeRunnerAttempt({ options: this.#options, now: this.#now, id: this.#id,
143:       authorityId: this.#authorityId, cleanupErrors: this.#cleanupErrors,
144:       cleanupProvider: (next, instance, value, log) => this.#cleanupProvider(next, instance, value, log),
145:     }, { prepared, state, node, attemptNumber, issuedAt, busterLog, workerResult, workerRuntimeFault });
146:   }
147: 
148:   #completionOwner(): CompletionOwner {
149:     return { options: this.#options, attemptStore: this.#durableAttemptStore,
150:       admissionStore: this.#observabilityAdmissionStore, authorityId: this.#authorityId, now: this.#now };
151:   }
152: 
153:   #context(
154:     signal: AbortSignal,
155:     log: TestProviderExecutionContext["log"],
156:     granted: ReadonlySet<string>,
157:     inputs: readonly ResolvedInputV1[],
158:   ): TestProviderExecutionContext {
159:     return Object.freeze({
160:       signal,
161:       workspaceRoot: this.#workspaceRoot,
162:       log,
163:       invoke: async (
164:         capability: string,
165:         request: TestProviderCapabilityRequest,
166:         invocationSignal?: AbortSignal,
167:       ) => {
168:         if (!granted.has(capability))
169:           throw new Error(`TEST_PROVIDER_CAPABILITY_DENIED:${capability}`);
170:         if (!this.#options.capabilityInvoker)
171:           throw new Error(`TEST_PROVIDER_CAPABILITY_UNAVAILABLE:${capability}`);
172:         return this.#options.capabilityInvoker.invoke(
173:           capability,
174:           request,
175:           invocationSignal ? AbortSignal.any([signal, invocationSignal]) : signal,
176:           inputs,
177:         );
178:       },
179:     });
180:   }
181: 
182:   async #collectEvidence(
183:     entry: TestProviderRegistryEntry,
184:     attemptId: string,
185:     evidenceDirectory: string,
186:     declarations: readonly DeclaredEvidenceV1[],
187:     maximumFiles: number,
188:     maximumBytes: number,
189:     signal: AbortSignal,
190:   ): Promise<EvidenceRefV1[]> {
191:     signal.throwIfAborted();
192:     if (declarations.length > maximumFiles)
193:       throw new Error("TEST_PROVIDER_ARTIFACT_FILE_LIMIT");
194:     const ids = new Set<string>();
195:     const files = new Set<string>();
196:     const evidence: EvidenceRefV1[] = [];
197:     let total = 0;
198:     for (const declaration of declarations) {
199:       signal.throwIfAborted();
200:       if (ids.has(declaration.evidenceId) || files.has(declaration.file))
201:         throw new Error(
202:           `TEST_PROVIDER_EVIDENCE_DUPLICATE:${declaration.evidenceId}`,
203:         );
204:       ids.add(declaration.evidenceId);
205:       files.add(declaration.file);
206:       if (!entry.registration.evidenceTypes.includes(declaration.type))
207:         throw new Error(
208:           `TEST_PROVIDER_EVIDENCE_TYPE_INVALID:${declaration.type}`,
209:         );
210:       const stored = await this.#store.store(
211:         attemptId,
212:         evidenceDirectory,
213:         declaration,
214:         maximumBytes - total,
215:         signal,
216:       );
217:       signal.throwIfAborted();
218:       total += stored.artifact.sizeBytes;
219:       if (total > maximumBytes)
220:         throw new Error("TEST_PROVIDER_ARTIFACT_BYTE_LIMIT");
221:       evidence.push(
222:         Object.freeze({
223:           evidenceId: declaration.evidenceId,
