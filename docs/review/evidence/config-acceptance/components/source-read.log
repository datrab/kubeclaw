20: 
21: /** No provider or HTTP-runtime module is imported into this privileged parent. */
22: export async function runBusterPreparationSupervisor(): Promise<void> {
23:   requireNativeWorkerSupervisorAuthority();
24:   requireRootBusterSettings(process.env);
25:   const settings = loadBusterPreparationSettings(process.env);
26:   const native = nativeBusterPreparationConfig(settings, process.env);
27:   const source = await fs.lstat(preparationSourceRoot);
28:   if (!source.isDirectory() || source.uid !== 0 || (source.mode & 0o022) !== 0
29:     || await fs.realpath(preparationSourceRoot) !== preparationSourceRoot) throw new Error('BUSTER_NATIVE_SOURCE_ROOT_NOT_TRUSTED');
30:   const store = new FileWorkerOwnershipStore(native.pool.ownershipRoot, {
31:     maximumRecords: settings.maximumRecords, maximumBytes: settings.maximumOwnershipBytes,
32:   });
33:   await NativeWorkerOwnership.supervise({ store, cgroupRoot: native.pool.cgroupRoot,
34:     nodeIdentity: native.nodeIdentity, drainTimeoutMs: settings.drainTimeoutMs,
35:     maximumActiveScopes: native.pool.maximumActiveScopes, poolLimits: native.pool.limits }, async owner => {
36:     const journal = new NativeAttemptJournal(path.join(native.pool.ownershipRoot, 'preparation-journal'), {
37:       maximumRecords: settings.maximumRecords, maximumStateBytes: settings.maximumMetadataBytes,
38:       maximumTotalBytes: settings.maximumJournalBytes, maximumInputBytes: settings.maximumInputBytes,
39:       maximumOutputBytes: settings.maximumOutputBytes, maximumResultBytes: settings.maximumResultBytes,
40:     });
41:     const execution: PreparationExecutionOptions = {
42:       owner, journal, settings, ledger: new PreparationSourceLedger(preparationSourceRoot, settings),
43:       engineContentDigest: native.engineContentDigest,
44:       command: { launcher: native.launcher, sourceRoot: preparationSourceRoot,
45:         cgroupRoot: native.pool.cgroupRoot, tarExecutable: native.tarExecutable,
46:         trustedSourceAuthority: native.trustedSourceAuthority, sourceAttestationPublicKey: native.sourceAttestationPublicKey },
47:     };
48:     await recoverNativeWorkerAttempts(journal, owner, preparationCleanupReconciliation(execution));
49:     await runHistoricalImport(execution, native.stateRoot);
50:     await recoverPreparationLedger(execution);
51:     if (!owner.isReady()) throw new Error('BUSTER_PREPARATION_RECOVERY_REQUIRED');
52:     await serveUnprivilegedBuster(execution);
53:   });
54: }
55: 
56: async function serveUnprivilegedBuster(execution: PreparationExecutionOptions): Promise<void> {
57:   const child = spawn('/usr/bin/setpriv', ['--reuid=1000', '--regid=1000', '--groups', '1000,1002',
58:     process.execPath, fileURLToPath(new URL('../remote-plan-cli.ts', import.meta.url)),
59:     '--config', preparationRuntimeConfig], { stdio: ['inherit', 'inherit', 'inherit', 'pipe'], env: process.env });
60:   const pipe = child.stdio[3] as Duplex;
61:   const channel = new NativeWorkerControlChannel(pipe, preparationServiceChannelLimits(execution.settings));
62:   const stop = () => { execution.owner.fenceAdmission(); child.kill('SIGTERM'); };
63:   process.once('SIGINT', stop);
64:   process.once('SIGTERM', stop);
65:   const closed = new Promise<void>((resolve, reject) => {
66:     child.once('error', reject);
67:     child.once('exit', (code, signal) => {
68:       channel.destroy();
69:       if (code === 0 || signal === 'SIGTERM') resolve();
70:       else reject(new Error(`BUSTER_SERVICE_EXIT:${code}:${signal}`));
71:     });
72:   });
73:   void closed.catch(() => {});
74:   try {
75:     await servePreparationRequests(channel, {
76:       maximumActivePreparations: execution.settings.maximumActivePreparations,
77:       maximumRequestBytes: execution.settings.maximumRequestBytes,
78:       prepare: (input, signal, admit) => executeBusterPreparation(execution, input, signal, admit),
79:       extract: (staged, signal) => extractBusterPreparation(execution, staged, signal),
80:     });
81:     await closed;
82:   } finally {
83:     stop();
84:     channel.destroy();
85:     await closed;
86:     process.removeListener('SIGINT', stop);
87:     process.removeListener('SIGTERM', stop);
88:   }
89: }

SOURCE skills/buster/engine/test-gates/process-input-lifecycle.ts SHA256 ff1279f5ca4af3364b0e04cf977803717b6884329f75b9c5461be3b5455797bd
1: import { validateBusterProcessInputSettings, type BusterProcessInputSettings } from '../../../common/plugin-runtime/foundation/config/buster-execution.ts';
2: import type { ChildProcess } from 'node:child_process';
3: import { captureLinuxProcessGroup, linuxProcessGroupRunning } from '@kubeclaw/plugin-foundation/processes/linux-process-group';
4: 
5: // Own both the native close and the group lifetime. A leader can exit while
6: // descendants remain runnable or keep its pipes open.
7: export class ProcessInputLifecycle {
8:   readonly #policy: BusterProcessInputSettings;
9:   readonly #child: ChildProcess;
10:   readonly #closed: Promise<void>;
11:   readonly #group: number | undefined;
12:   readonly #identityError: unknown;
13:   #cleanup: Promise<void> | undefined;
14: 
15:   constructor(child: ChildProcess, closed: Promise<void>, policy: BusterProcessInputSettings) {
16:     this.#policy = validateBusterProcessInputSettings(policy);
17:     this.#child = child; this.#closed = closed;
18:     if (process.platform === 'linux' && child.pid) {
19:       try { this.#group = captureLinuxProcessGroup(child.pid); }
20:       catch (error) { this.#identityError = error; }
21:     }
22:   }
23: 
24:   cleanup(): Promise<void> {
25:     this.#cleanup ??= this.#finish();
26:     return this.#cleanup;
27:   }
28: 
29:   async #finish(): Promise<void> {
30:     const deadline = Date.now() + this.#policy.cleanupTimeoutMs;
31:     const failures: unknown[] = [];
32:     let force: NodeJS.Timeout | undefined;
33:     let bound: NodeJS.Timeout | undefined;
34:     try {
35:       // Signal failure does not release ownership: still await close and group quiescence.
36:       this.#attemptSignal('SIGTERM', failures);
37:       force = setTimeout(() => this.#attemptSignal('SIGKILL', failures), this.#policy.terminationGraceMs);
38:       await Promise.race([
39:         this.#acknowledgeClosure(deadline, failures),
40:         new Promise<never>((_resolve, reject) => {
41:           bound = setTimeout(() => reject(new Error('PROCESS_INPUT_CLEANUP_TIMEOUT')), Math.max(1, deadline - Date.now()));
42:         }),
43:       ]);
44:     } catch (error) {
45:       this.#attemptSignal('SIGKILL', failures);
46:       // Destroying host pipe ends is not a termination claim. Preserve all causes.
47:       this.#child.stdin?.destroy(); this.#child.stdout?.destroy(); this.#child.stderr?.destroy();
48:       if (failures.length) throw new AggregateError([error, ...failures], 'PROCESS_INPUT_CLEANUP_FAILED', { cause: error });
49:       throw error;
50:     } finally { clearTimeout(force); clearTimeout(bound); }
51:     if (failures.length) throw new AggregateError(failures, 'PROCESS_INPUT_CLEANUP_FAILED');
52:   }
53: 
54:   #attemptSignal(signal: NodeJS.Signals, failures: unknown[]): void {
55:     try { this.#signal(signal); }
56:     catch (error) { failures.push(error); }
57:   }
58: 
59:   async #acknowledgeClosure(deadline: number, failures: unknown[]): Promise<void> {
60:     // Record group failure immediately, but still wait for actual close within the same deadline.
61:     await Promise.all([this.#closed, this.#acknowledge(deadline).catch(error => { failures.push(error); })]);
62:   }
63: 
64:   async #acknowledge(deadline: number): Promise<void> {
65:     if (process.platform !== 'linux') return;
66:     if (!this.#alive()) return;
67:     if (this.#group === undefined) throw new Error('PROCESS_INPUT_IDENTITY_UNAVAILABLE', { cause: this.#identityError });
68:     while (await linuxProcessGroupRunning(this.#group, deadline)) {
69:       if (Date.now() >= deadline) throw new Error('PROCESS_INPUT_CLEANUP_TIMEOUT');
70:       await new Promise((resolve) => setTimeout(resolve, this.#policy.acknowledgementPollMs));
71:     }
72:   }
73: 
74:   #alive(): boolean {
75:     if (!this.#child.pid || process.platform === 'win32') return false;
76:     try { process.kill(-this.#child.pid, 0); return true; }
77:     catch (error) { if ((error as NodeJS.ErrnoException).code === 'ESRCH') return false; throw error; }
78:   }
79: 
80:   #signal(signal: NodeJS.Signals): void {
81:     try {
82:       if (process.platform !== 'win32' && this.#child.pid) process.kill(-this.#child.pid, signal);
83:       else this.#child.kill(signal);
84:     } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ESRCH') throw error; }
85:   }
86: }

SOURCE skills/buster/engine/test-gates/process-input.ts SHA256 4215ff0c2849dba12fe36887aed1ba771a0c77c8475274176807ea472b66856d
1: import { validateBusterProcessInputSettings, type BusterProcessInputSettings } from '../../../common/plugin-runtime/foundation/config/buster-execution.ts';
2: import { spawn } from 'node:child_process';
3: import { ProcessInputLifecycle } from './process-input-lifecycle.ts';
4: 
5: export class ProcessInputCleanupError extends AggregateError {
6:   constructor(prefix: string, failure: Error | undefined, cleanup: unknown) {
7:     super([...(failure ? [failure] : []), cleanup], `${prefix}_CLEANUP_FAILED`, { cause: failure ?? cleanup });
8:     this.name = 'ProcessInputCleanupError';
9:   }
10: }
11: 
12: export interface ProcessInputOptions {
13:   readonly processInputPolicy: BusterProcessInputSettings;
14:   readonly cwd?: string;
15:   readonly env?: NodeJS.ProcessEnv;
16:   readonly signal?: AbortSignal;
17:   readonly timeoutMs: number;
18:   readonly maximumOutputBytes: number;
19:   readonly prefix: string;
20:   readonly outputLimitError?: string;
21:   readonly input?: string | Buffer | null;
22: }
23: export interface ProcessInputResult {
24:   readonly code: number | null;
25:   readonly signal: NodeJS.Signals | null;
26:   readonly stdout: Buffer;
27:   readonly stderr: Buffer;
28: }
29: 
30: function processPolicy(options: ProcessInputOptions): BusterProcessInputSettings {
31:   const processInputPolicy = validateBusterProcessInputSettings(options.processInputPolicy);
32:   if (!Number.isSafeInteger(options.timeoutMs) || options.timeoutMs < 1 || options.timeoutMs > 2147483647) throw new Error('PROCESS_INPUT_TIMEOUT_INVALID');
33:   if (!Number.isSafeInteger(options.maximumOutputBytes) || options.maximumOutputBytes < 1) throw new Error('PROCESS_INPUT_OUTPUT_LIMIT_INVALID');
34:   return processInputPolicy;
35: }
36: 
37: // Attach every stream error handler before sending input. Failures settle only
38: // after close and process-group acknowledgement, with a bounded failure on incomplete disposal.
39: export function runProcessInput(command: string, args: readonly string[], options: ProcessInputOptions): Promise<ProcessInputResult> {
40:   const processInputPolicy = processPolicy(options);
41:   if (options.signal?.aborted) return Promise.reject(new Error(`${options.prefix}_CANCELLED`, { cause: options.signal.reason }));
42:   return new Promise((resolve, reject) => {
43:     const child = spawn(command, [...args], { ...(options.cwd ? { cwd: options.cwd } : {}),
44:       ...(options.env ? { env: options.env } : {}), detached: process.platform !== 'win32', stdio: ['pipe', 'pipe', 'pipe'] });
45:     const output = { stdout: [] as Buffer[], stderr: [] as Buffer[], stdoutBytes: 0, stderrBytes: 0 };
46:     let failure: Error | undefined;
47:     let finishing = false;
48:     let resolveClosed!: () => void;
49:     const closed = new Promise<void>((resolveClose) => { resolveClosed = resolveClose; });
50:     let exitCode: number | null = null;
51:     let exitSignal: NodeJS.Signals | null = null;
52:     let lifecycle: ProcessInputLifecycle;
53:     const settle = (cleanup?: unknown): void => {
54:       clearTimeout(timer); options.signal?.removeEventListener('abort', abort);
55:       const stdout = Buffer.concat(output.stdout, output.stdoutBytes);
56:       const stderr = Buffer.concat(output.stderr, output.stderrBytes);
57:       const error = cleanup ? new ProcessInputCleanupError(options.prefix, failure, cleanup) : failure;
58:       if (error) reject(Object.assign(error, { stdout: stdout.toString('utf8'), stderr: stderr.toString('utf8') }));
59:       else resolve({ code: exitCode, signal: exitSignal, stdout, stderr });
60:     };
61:     const finish = (): void => {
62:       if (finishing) return;
63:       finishing = true;
64:       void lifecycle.cleanup().then(() => settle(), (error) => settle(error));
65:     };
66:     const fail = (error: Error): void => {
67:       failure ??= error;
68:       child.stdin.destroy();
69:       finish();
70:     };
71:     const collect = (stream: 'stdout' | 'stderr', chunk: Buffer): void => {
72:       if (failure) return;
73:       const key = stream === 'stdout' ? 'stdoutBytes' : 'stderrBytes';
74:       if (chunk.byteLength > options.maximumOutputBytes - output[key]) {
75:         fail(new Error(options.outputLimitError ?? `${options.prefix}_OUTPUT_LIMIT`)); return;
76:       }
77:       output[key] += chunk.byteLength; output[stream].push(chunk);
78:     };
79:     const abort = (): void => fail(new Error(`${options.prefix}_CANCELLED`, { cause: options.signal?.reason }));
80:     const timer = setTimeout(() => fail(new Error(`${options.prefix}_TIMEOUT`)), options.timeoutMs);
81:     options.signal?.addEventListener('abort', abort, { once: true });
82:     child.stdin.on('error', (error) => fail(new Error(`${options.prefix}_STDIN_FAILED`, { cause: error })));
83:     child.stdout.on('error', (error) => fail(new Error(`${options.prefix}_STDOUT_FAILED`, { cause: error })));
84:     child.stderr.on('error', (error) => fail(new Error(`${options.prefix}_STDERR_FAILED`, { cause: error })));
85:     child.stdout.on('data', (chunk: Buffer) => collect('stdout', chunk));
86:     child.stderr.on('data', (chunk: Buffer) => collect('stderr', chunk));
87:     child.once('error', fail);
88:     child.once('exit', (code, signal) => { exitCode = code; exitSignal = signal; finish(); });
89:     child.once('close', (code, signal) => {
90:       exitCode = code; exitSignal = signal; resolveClosed(); finish();
91:     });
92:     lifecycle = new ProcessInputLifecycle(child, closed, processInputPolicy);
93:     if (options.signal?.aborted) { abort(); return; }
94:     try { child.stdin.end(options.input ?? undefined); }
95:     catch (error) { fail(new Error(`${options.prefix}_STDIN_FAILED`, { cause: error })); }
96:   });
97: }

