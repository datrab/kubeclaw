SOURCE charts/kubeclaw/templates/_swarm-config.tpl SHA256 87230c626fee3ea8adf33dadb29db0672b86c60d736ec0b91db47c74f1d94472
1: {{/* One selected complete Buster owner document; no keywise settings merges. */}}
2: {{- define "kubeclaw.swarmConfig" -}}
3: {{- $raw := required "canonical swarm.config.json is required" (.Files.Get "files/config/swarm.config.json") -}}
4: {{- $config := mustFromJson $raw -}}
5: {{- $schema := mustFromJson (.Files.Get "files/config/swarm.schema.json") -}}
6: {{- range $key, $value := $config -}}
7: {{- if not (hasKey $schema.properties $key) -}}{{- fail (printf "unsupported swarm key %s" $key) -}}{{- end -}}
8: {{- end -}}
9: {{- range $key := $schema.required -}}
10: {{- if not (hasKey $config $key) -}}{{- fail (printf "required swarm key %s" $key) -}}{{- end -}}
11: {{- end -}}
12: {{- range $key := list "profile" "features" "tuning" -}}
13: {{- if ne (toJson (index $config $key)) (toJson (index $schema.properties $key).const) -}}{{- fail (printf "unsupported swarm %s" $key) -}}{{- end -}}
14: {{- end -}}
15: {{- if and (hasKey $config "_doc") (not (kindIs "string" $config._doc)) -}}{{- fail "swarm _doc must be a string" -}}{{- end -}}
16: {{- if not (kindIs "map" $config.overrides) -}}{{- fail "swarm overrides must be an empty object" -}}{{- end -}}
17: {{- if ne (len $config.overrides) 0 -}}{{- fail "swarm overrides must be an empty object" -}}{{- end -}}
18: {{- if ne $config.schemaVersion "swarm-entry.v2" -}}{{- fail "swarm entry schemaVersion is invalid" -}}{{- end -}}
19: {{- if not (kindIs "map" $config.components) -}}{{- fail "swarm components must be an object" -}}{{- end -}}
20: {{- $owners := list "prism-control" "prism-studio" "prism-worker" "prism-execution" "buster-engine" "worker-core" -}}
21: {{- if ne (len $config.components) (len $owners) -}}{{- fail "swarm requires exactly six component references" -}}{{- end -}}
22: {{- $components := dict -}}
23: {{- range $owner := $owners -}}
24: {{- $name := printf "%s.config.json" $owner -}}
25: {{- if ne (index $config.components $owner) $name -}}{{- fail (printf "swarm component reference invalid: %s" $owner) -}}{{- end -}}
26: {{- $componentRaw := $.Files.Get (printf "files/config/%s" $name) -}}
27: {{- if eq $owner "buster-engine" -}}{{- $componentRaw = include "kubeclaw.busterComponentRaw" $ -}}{{- end -}}
28: {{- $component := mustFromJson (required (printf "swarm component missing: %s" $owner) $componentRaw) -}}
29: {{- if not (kindIs "map" $component) -}}{{- fail "swarm component must be an object" -}}{{- end -}}
30: {{- if or (ne (len $component) 3) (ne $component.schemaVersion "swarm-component.v1") (ne $component.owner $owner) (not (hasKey $component "settings")) -}}{{- fail (printf "swarm component identity invalid: %s" $owner) -}}{{- end -}}
31: {{- $label := index (dict "prism-control" "control" "prism-worker" "worker" "prism-studio" "studio" "prism-execution" "native" "buster-engine" "buster" "worker-core" "worker-core") $owner -}}
32: {{- if not (kindIs "map" $component.settings) -}}{{- fail (printf "swarm %s settings must be an object" $label) -}}{{- end -}}
33: {{- $_ := set $components $owner $component.settings -}}
34: {{- end -}}
35: {{- $control := index $components "prism-control" -}}
36: {{- $worker := index $components "prism-worker" -}}
37: {{- $execution := index $components "prism-execution" -}}
38: {{- if not (hasKey $control "dispatchTimeoutMs") -}}{{- fail "swarm native dispatchTimeoutMs required in prism-control.config.json" -}}{{- end -}}
39: {{- if ne (len $control) 5 -}}{{- fail "swarm control requires exactly five settings" -}}{{- end -}}
40: {{- if or (ne (len $worker) 2) (not (hasKey $worker "ingress")) (not (hasKey $worker "supervisor")) -}}{{- fail "swarm worker requires ingress and supervisor only" -}}{{- end -}}
41: {{- if or (ne (len $execution) 2) (not (hasKey $execution "resourcePolicy")) (not (hasKey $execution "maximumResultBytes")) -}}{{- fail "swarm native requires resourcePolicy and maximumResultBytes only" -}}{{- end -}}
42: {{- $native := dict "resourcePolicy" $execution.resourcePolicy "maximumResultBytes" $execution.maximumResultBytes "dispatchTimeoutMs" $control.dispatchTimeoutMs "supervisor" $worker.supervisor -}}
43: {{- $_ := set $config "operator" (dict "prism" (dict "control" (omit $control "dispatchTimeoutMs") "studio" (index $components "prism-studio") "worker" $worker.ingress "native" $native) "buster" (index $components "buster-engine")) -}}
44: {{- $componentSchema := mustFromJson (required "component schema required" (.Files.Get "files/config/swarm-components.schema.json")) -}}
45: {{- $definitions := index $componentSchema "$defs" -}}
46: {{- $core := index $components "worker-core" -}}
47: {{- if or (ne (len $core) 1) (not (hasKey $core "localRuntime")) (not (kindIs "map" $core.localRuntime)) -}}{{- fail "worker-core.config.json settings.localRuntime is required" -}}{{- end -}}
48: {{- $local := $core.localRuntime -}}
49: {{- if ne (len $local) 3 -}}{{- fail "worker-core.config.json localRuntime requires exactly three settings" -}}{{- end -}}
50: {{- range $key := list "drainTimeoutMs" "cancellationTimeoutMs" "replayLimit" -}}
51: {{- $value := index $local $key -}}
52: {{- $maximum := ternary (float64 1000000) (float64 2147483647) (eq $key "replayLimit") -}}
53: {{- if not (kindIs "float64" $value) -}}{{- fail (printf "worker-core.config.json localRuntime.%s must be an integer" $key) -}}{{- end -}}
54: {{- if or (lt $value (float64 1)) (gt $value $maximum) (ne $value (floor $value)) -}}{{- fail (printf "worker-core.config.json localRuntime.%s is out of range" $key) -}}{{- end -}}
55: {{- end -}}
56: {{- if not (kindIs "map" $config.operator) -}}{{- fail "swarm operator must be an object" -}}{{- end -}}
57: {{- if not (hasKey $config.operator "prism") -}}{{- fail "swarm operator requires prism" -}}{{- end -}}
58: {{- range $key, $value := $config.operator -}}
59: {{- if not (has $key (list "prism" "buster")) -}}{{- fail (printf "unsupported swarm operator %s" $key) -}}{{- end -}}
60: {{- end -}}
61: {{- if hasKey $config.operator "buster" -}}
62: {{- $buster := $config.operator.buster -}}
63: {{- if not (kindIs "map" $buster) -}}{{- fail "swarm buster must be an object" -}}{{- end -}}
64: {{- if or (ne (len $buster) 5) (not (hasKey $buster "preparation")) (not (hasKey $buster "admission")) (not (hasKey $buster "dependencyReadiness")) (not (hasKey $buster "execution")) (not (hasKey $buster "clusterInvokers")) -}}{{- fail "swarm buster requires preparation, admission, dependencyReadiness, execution and clusterInvokers only" -}}{{- end -}}
65: {{- $cluster := $buster.clusterInvokers -}}
66: {{- include "kubeclaw.validateClusterPolicy" (dict "value" $cluster "schema" (index $definitions "buster-cluster-invokers") "name" "clusterInvokers") -}}
67: {{- if or (gt $cluster.kubernetesFixture.maximumPersistentVolumeClaimBytes $cluster.kubernetesFixture.maximumPersistentVolumeTotalBytes) (gt $cluster.tailscaleExposure.pollIntervalMs $cluster.tailscaleExposure.maximumExecutionMs) (gt (mulf $cluster.kubernetesFixture.maximumManifestBytes $cluster.kubernetesFixture.commandOutputManifestMultiplier) (float64 9007199254740991)) -}}{{- fail "buster cluster policy coherence invalid" -}}{{- end -}}
68: {{- if gt $cluster.runtimeSecurity.pollIntervalMs $cluster.runtimeSecurity.maximumObservationAgeMs -}}{{- fail "buster cluster runtime security policy coherence invalid" -}}{{- end -}}
69: {{- range $suffix := $cluster.tailscaleExposure.allowedHostSuffixes -}}
70: {{- if contains ".." $suffix -}}{{- fail "buster cluster host suffix invalid" -}}{{- end -}}
71: {{- end -}}
72: {{- $execution := $buster.execution -}}
73: {{- if not (kindIs "map" $execution) -}}{{- fail "buster-engine.config.json execution must be an object" -}}{{- end -}}
74: {{- if ne (len $execution) 5 -}}{{- fail "buster execution requires provider, reports, observation, stores and processInput" -}}{{- end -}}
75: {{- range $key := list "provider" "reports" "observation" "stores" "processInput" -}}
