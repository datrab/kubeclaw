1: import path from "node:path";
2: import { canonicalJson } from "@kubeclaw/pipeline-observability-contract";
3: import {
4:   closureKey,
5:   closureIntentDigest,
6:   type ClosureRetirementIntent,
7:   type ClosureReference,
8: } from "./closure-projection.ts";
9: import {
10:   completionRetirementSource,
11:   type AdmissionRetiredEntry,
12: } from "./admission-retirement.ts";
13: import {
14:   createAttemptProjection,
15:   attemptProjectionKey,
16:   attemptStoreDigest,
17:   assertAttemptRetirementIntent,
18:   readAttemptJournalPrefix,
19:   replaceAttemptProjectionSync,
20:   encodeAttemptState,
21:   type AttemptRetirementIntent,
22: } from "./attempt-projection.ts";
23: import { assertAttemptReplay } from "./attempt-replay.ts";
24: import type { ProducerClosureV1 } from "@kubeclaw/pipeline-observability-contract";
25: import type { DurableAttemptStoreSnapshot } from "./durable-attempts.ts";
26: import type { ProjectedResultMetadata } from "./attempt-projection.ts";
27: import type { AttemptState } from "./attempt-state.ts";
28: import type { FileObservabilityAdmissionStore } from "./durable-delivery.ts";
29: export async function retireAdmissionCompletion(
30:   store: AttemptState,
31:   admission: FileObservabilityAdmissionStore,
32:   input: {
33:     pipelineRunId: string;
34:     attemptId: string;
35:     claimGeneration: number;
36:     recordDigest: string;
37:     operationId: string;
38:     actor: string;
39:     authority: AdmissionRetiredEntry["authority"];
40:   },
41:   authorize: () => Promise<void>,
42: ): Promise<{ newlyRetired: boolean; releasedBytes: number }> {
43:   const scope = structuredClone(input);
44:   if (path.resolve(admission.storageDirectory()) === path.resolve(store.root))
45:     throw new Error("OBSERVABILITY_RETIREMENT_STORE_OVERLAP");
46:   return store.serial(async () => {
47:     const state = await store.readState();
48:     const source = await completionRetirementSource(
49:       state,
50:       scope,
51:       store.file,
52:       store.limits.maximumMetadataBytes,
53:     );
54:     const issues = await admission.observabilityIssues(scope.pipelineRunId);
55:     if (issues.missingRanges.length || issues.unresolvedItems.length)
56:       throw new Error("OBSERVABILITY_RETIREMENT_INCOMPLETE");
57:     return admission.retireCompletion(
58:       {
59:         authority: scope.authority,
60:         operationId: scope.operationId,
61:         actor: scope.actor,
62:         recordDigest: scope.recordDigest,
63:         source,
64:       },
65:       authorize,
66:     );
67:   });
68: }
69: export async function retireImportedResult(
70:   store: AttemptState,
71:   input: AttemptRetirementIntent,
72:   withCheckpointFence: CheckpointFence,
73:   authorize: () => void,
74: ): Promise<{ newlyRetired: boolean; releasedBytes: number }> {
75:   const intent = structuredClone(input);
76:   assertAttemptRetirementIntent(intent, store.root);
77:   return store.serial(async () => {
78:     const state = await store.readState(),
79:       key = attemptProjectionKey(intent);
80:     const existing = store.projections.get(key);
81:     authorize();
82:     // Async source/evidence checks finish before acquiring the synchronous
83:     // journal fence. Existing FileJournal appenders must not wait on an await.
84:     await completionRetirementSource(
85:       state,
86:       intent,
87:       store.file,
88:       store.limits.maximumMetadataBytes,
89:     );
90:     return withCheckpointFence(() =>
91:       commitImportedResult(store, state, intent, existing, authorize),
92:     );
93:   });
94: }
95: export async function retireImportedClosure(
96:   store: AttemptState,
97:   input: ClosureRetirementIntent,
98:   withCheckpointFence: CheckpointFence,
99:   authorize: () => void,
100: ): Promise<{ newlyRetired: boolean; releasedBytes: number }> {
101:   const intent = structuredClone(input),
102:     { closureDigest, ...resultIntent } = intent;
103:   assertAttemptRetirementIntent(resultIntent, store.root);
104:   if (!/^sha256:[a-f0-9]{64}$/u.test(closureDigest))
105:     throw new Error("OBSERVABILITY_CLOSURE_RETIREMENT_DIGEST");
106:   return store.serial(async () => {
107:     const state = await store.readState(),
108:       key = attemptProjectionKey(intent),
109:       result = store.projections.get(key);
110:     const closure = result?.completionIntent?.closure;
111:     if (!result || !closure || closure.closureDigest !== closureDigest)
112:       throw new Error("OBSERVABILITY_CLOSURE_RESULT_PROJECTION_REQUIRED");
113:     const source = result.resultReference.intent;
114:     for (const field of [
115:       "resultDigest",
116:       "recordDigest",
117:       "journalSequence",
118:       "journalHash",
119:     ] as const) {
120:       if (source[field] !== intent[field])
121:         throw new Error("OBSERVABILITY_CLOSURE_RETIREMENT_SOURCE_CHANGED");
122:     }
123:     authorize();
124:     await completionRetirementSource(
125:       state,
126:       intent,
127:       store.file,
128:       store.limits.maximumMetadataBytes,
129:     );
130:     return withCheckpointFence(() =>
131:       commitImportedClosure(store, state, intent, closure, authorize),
132:     );
133:   });
134: }
135: 
136: interface RetirementOutcome {
137:   newlyRetired: boolean;
138:   releasedBytes: number;
139: }
140: type CheckpointFence = (
141:   operation: () => RetirementOutcome,
142: ) => RetirementOutcome;
143: 
144: function commitImportedResult(
145:   store: AttemptState,
146:   state: DurableAttemptStoreSnapshot,
147:   intent: AttemptRetirementIntent,
148:   existing: ProjectedResultMetadata | undefined,
149:   authorize: () => void,
150: ): RetirementOutcome {
151:   const key = attemptProjectionKey(intent);
152:   authorize();
153:   if (existing) {
154:     if (
155:       canonicalJson(existing.resultReference.intent) !== canonicalJson(intent)
156:     )
157:       throw new Error("OBSERVABILITY_RESULT_RETIREMENT_CONFLICT");
158:     return { newlyRetired: false, releasedBytes: 0 };
159:   }
160:   const before = readAttemptJournalPrefix(
161:     store.file,
162:     store.limits.maximumMetadataBytes,
163:   );
164:   if (attemptStoreDigest(before) !== intent.expectedStoreDigest)
165:     throw new Error("OBSERVABILITY_RESULT_RETIREMENT_STORE_CHANGED");
166:   const item = state.results.find(
167:     (result) => attemptProjectionKey(result) === key,
168:   );
169:   if (
170:     !item ||
171:     item.result.resultDigest !== intent.resultDigest ||
172:     !item.storedAt
173:   )
174:     throw new Error("OBSERVABILITY_RESULT_RETIREMENT_UNCONFIRMED");
175:   // Reuse the original full completion/evidence/closure validation. Never fabricate an ACK.
176:   const projected = createAttemptProjection(
177:     item,
178:     intent,
179:     store.root,
180:     store.limits.maximumMetadataBytes,
181:   );
182:   store.projections.set(key, projected);
183:   store.checkSize(state);
184:   const releasedBytes =
185:     before.length -
186:     Buffer.byteLength(
187:       canonicalJson(
188:         encodeAttemptState(state, store.projections, store.closureProjections),
189:       ),
190:     );
191:   if (releasedBytes <= 0)
192:     throw new Error("OBSERVABILITY_RESULT_RETIREMENT_NOT_SMALLER");
193:   authorize();
194:   replaceAttemptProjectionSync(
195:     store.file,
196:     encodeAttemptState(state, store.projections, store.closureProjections),
197:   );
198:   return { newlyRetired: true, releasedBytes };
199: }
200: 
201: function commitImportedClosure(
202:   store: AttemptState,
203:   state: DurableAttemptStoreSnapshot,
204:   intent: ClosureRetirementIntent,
205:   closure: ProducerClosureV1,
206:   authorize: () => void,
207: ): RetirementOutcome {
208:   const key = attemptProjectionKey(intent);
209:   authorize();
210:   const existing = store.closureProjections.get(closureKey(closure));
211:   if (existing) {
212:     if (existing.intentDigest !== closureIntentDigest(intent))
213:       throw new Error("OBSERVABILITY_CLOSURE_RETIREMENT_CONFLICT");
214:     return { newlyRetired: false, releasedBytes: 0 };
215:   }
216:   const before = readAttemptJournalPrefix(
217:     store.file,
218:     store.limits.maximumMetadataBytes,
219:   );
220:   if (attemptStoreDigest(before) !== intent.expectedStoreDigest)
221:     throw new Error("OBSERVABILITY_CLOSURE_RETIREMENT_STORE_CHANGED");
222:   const reference: ClosureReference = {
223:     schemaVersion: "attempt-closure-reference.v1",
224:     resultKey: key,
225:     closureDigest: intent.closureDigest,
226:     operationId: intent.operationId,
227:     actor: intent.actor,
228:     intentDigest: closureIntentDigest(intent),
229:   };
230:   const references = new Map(store.closureProjections);
231:   references.set(closureKey(closure), reference);
232:   const encoded = encodeAttemptState(state, store.projections, references);
233:   assertAttemptReplay(
234:     state,
235:     store.root,
236:     store.limits,
237:     store.projections.size,
238:     references.size,
239:   );
240:   const afterBytes = Buffer.byteLength(canonicalJson(encoded)),
241:     releasedBytes = before.length - afterBytes;
242:   if (afterBytes > store.limits.maximumMetadataBytes)
243:     throw new Error("OBSERVABILITY_ATTEMPT_METADATA_FULL");
244:   if (releasedBytes <= 0)
245:     throw new Error("OBSERVABILITY_CLOSURE_RETIREMENT_NOT_SMALLER");
246:   authorize();
247:   replaceAttemptProjectionSync(store.file, encoded);
248:   store.closureProjections = references;
249:   return { newlyRetired: true, releasedBytes };
250: }

SOURCE skills/common/plugin-runtime/foundation/observability/attempt-state.ts SHA256 392ad6e2a590c964cc0d8cd1fe0c75237f240798e6d99ee2ed2b33da8047fdca
1: import path from "node:path";
2: import { canonicalJson } from "@kubeclaw/pipeline-observability-contract";
3: import {
4:   decodeAttemptState,
5:   encodeAttemptState,
6:   type AttemptProjections,
7:   type PersistedAttempt,
8: } from "./attempt-projection.ts";
9: import type { ClosureProjections } from "./closure-projection.ts";
10: import { assertAttemptReplay } from "./attempt-replay.ts";
11: import {
12:   cleanupStaging,
13:   cleanupUnreferencedBlobs,
14: } from "./attempt-evidence.ts";
15: import {
16:   readDurableState,
17:   writeDurableState,
18:   withDurableStoreLock,
19: } from "./durable-delivery.ts";
20: import type {
21:   DurableAttemptStoreLimits,
22:   DurableAttemptStoreSnapshot,
23: } from "./durable-attempts.ts";
24: const EMPTY_STATE: DurableAttemptStoreSnapshot = {
25:   schemaVersion: "durable-attempt-store.v1",
26:   evidence: [],
27:   results: [],
28:   closures: [],
29: };
30: 
31: function validLimit(value: number): boolean {
32:   return Number.isSafeInteger(value) && value > 0;
33: }
34: 
35: export class AttemptState {
36:   readonly root: string;
37:   readonly file: string;
38:   readonly limits: DurableAttemptStoreLimits;
39:   #queue: Promise<unknown> = Promise.resolve();
40:   closureProjections: ClosureProjections = new Map();
41:   projections: AttemptProjections = new Map();
42:   constructor(root: string, limits: DurableAttemptStoreLimits) {
43:     if (!path.isAbsolute(root))
44:       throw new Error("OBSERVABILITY_ATTEMPT_STORE_ROOT_NOT_ABSOLUTE");
45:     if (Object.values(limits).some((value) => !validLimit(value)))
46:       throw new Error("OBSERVABILITY_ATTEMPT_STORE_LIMIT_INVALID");
47:     this.root = root;
48:     this.file = path.join(root, "attempt-store.json");
49:     this.limits = limits;
50:   }
51:   serial<T>(operation: () => Promise<T>): Promise<T> {
52:     const locked = () =>
53:       withDurableStoreLock(this.file, async () => {
54:         await cleanupStaging(this.root);
55:         return operation();
56:       });
57:     const result = this.#queue.then(locked, locked);
58:     this.#queue = result.then(
59:       () => undefined,
60:       () => undefined,
61:     );
62:     return result;
63:   }
64:   async readState(): Promise<DurableAttemptStoreSnapshot> {
65:     const raw = await readDurableState<PersistedAttempt>(
66:       this.file,
67:       EMPTY_STATE,
68:       this.limits.maximumMetadataBytes,
69:     );
70:     const { state, projections, closureProjections } = decodeAttemptState(
71:       raw,
72:       this.root,
73:       this.limits,
74:     );
75:     this.projections = projections;
76:     this.closureProjections = closureProjections;
77:     return state;
78:   }
79:   async writeState(state: DurableAttemptStoreSnapshot): Promise<void> {
80:     this.checkSize(state);
81:     await writeDurableState(
82:       this.file,
83:       encodeAttemptState(state, this.projections, this.closureProjections),
84:     );
85:   }
86:   checkSize(state: DurableAttemptStoreSnapshot): void {
87:     const encoded = encodeAttemptState(
88:       state,
89:       this.projections,
90:       this.closureProjections,
91:     );
92:     assertAttemptReplay(
93:       state,
94:       this.root,
95:       this.limits,
96:       this.projections.size,
97:       this.closureProjections.size,
98:     );
99:     if (
100:       Buffer.byteLength(canonicalJson(encoded)) >
101:       this.limits.maximumMetadataBytes
102:     )
103:       throw new Error("OBSERVABILITY_ATTEMPT_METADATA_FULL");
104:   }
105:   async reclaimExpiredEvidence(
106:     state: DurableAttemptStoreSnapshot,
107:   ): Promise<void> {
108:     const referenced = new Set(
109:       state.results.flatMap((stored) =>
110:         stored.result.evidence.map(
111:           (item) =>
112:             `${stored.pipelineRunId}\0${stored.attemptId}\0${stored.claimGeneration}\0${item.evidenceId}`,
113:         ),
114:       ),
115:     );
116:     const now = Date.now();
117:     const retained = state.evidence.filter((item) => {
118:       const key = `${item.pipelineRunId}\0${item.attemptId}\0${item.claimGeneration}\0${item.evidenceId}`;
119:       if (referenced.has(key)) return true;
120:       const stagedAt = Date.parse(item.stagedAt);
121:       return (
122:         Number.isFinite(stagedAt) &&
123:         now - stagedAt < this.limits.maximumPendingEvidenceAgeMs
124:       );
125:     });
126:     if (retained.length === state.evidence.length) return;
127:     state.evidence = retained;
128:     this.checkSize(state);
129:     await this.writeState(state);
130:     await cleanupUnreferencedBlobs(this.root, state);
131:   }
132: }

SOURCE skills/common/plugin-runtime/foundation/observability/clawdeck-view.ts SHA256 51264741ac619877d2154668d83aeedbb666d1dfeb524685936b2d90d3322c41
1: import type {
2:   ObservabilityCompletenessV1,
3:   ProducerGapReportV1,
4:   ProducerRecordV1,
5:   UnresolvedObservabilityItemV1,
6: } from "@kubeclaw/pipeline-observability-contract";
7: import type { WorkerAttemptResultV1 } from "@kubeclaw/pipeline-worker-core-contract";
8: import {
9:   FileDurableAttemptStore,
10:   type DurableEvidenceMetadata,
11:   type RequiredProducerClosure,
12: } from "./durable-attempts.ts";
13: import { FileObservabilityAdmissionStore } from "./durable-delivery.ts";
14: 
15: export interface ClawDeckRawRecord {
16:   canonicalCursor: number;
17:   admittedAt: string;
18:   record: ProducerRecordV1;
19: }
20: export interface ClawDeckAttemptView {
21:   attemptId: string;
22:   claimGeneration: number;
23:   workerId: string;
24:   result: WorkerAttemptResultV1;
25:   storedAt: string | null;
26:   evidence: DurableEvidenceMetadata[];
27: }
28: export interface ClawDeckObservationView {
29:   schemaVersion: "clawdeck-observation-view.v1";
30:   pipelineRunId: string;
31:   fromCursor: number;
32:   nextCursor: number;
33:   rawRecords: ClawDeckRawRecord[];
34:   attempts: ClawDeckAttemptView[];
35:   closureIds: string[];
36:   completeness: ObservabilityCompletenessV1;
37: }
38: 
39: export async function buildClawDeckObservationView(options: {
40:   pipelineRunId: string;
41:   fromCursor?: number;
42:   requiredClosures: ReadonlyArray<RequiredProducerClosure>;
43:   missingRanges?: ReadonlyArray<ProducerGapReportV1>;
44:   unresolvedItems?: ReadonlyArray<UnresolvedObservabilityItemV1>;
45:   admissionStore: FileObservabilityAdmissionStore;
46:   attemptStore: FileDurableAttemptStore;
47: }): Promise<ClawDeckObservationView> {
48:   const fromCursor = options.fromCursor ?? 1;
49:   if (!Number.isSafeInteger(fromCursor) || fromCursor < 1)
50:     throw new Error("CLAWDECK_CURSOR_INVALID");
51:   for (const gap of options.missingRanges ?? [])
52:     await options.admissionStore.recordGap(gap);
53:   const [admissionTail, attemptState, completeness] = await Promise.all([
54:     options.admissionStore.admittedTailSnapshot(
55:       options.pipelineRunId,
56:       fromCursor,
57:     ),
58:     options.attemptStore.snapshot(),
59:     options.attemptStore.evaluateCompleteness(
60:       options.pipelineRunId,
61:       options.requiredClosures,
62:       options.admissionStore,
63:       [],
64:       options.unresolvedItems,
65:     ),
66:   ]);
67:   const rawRecords = [...admissionTail.records]
68:     .sort((left, right) => left.canonicalCursor - right.canonicalCursor)
69:     .map((item) => ({
70:       canonicalCursor: item.canonicalCursor,
71:       admittedAt: item.admittedAt,
72:       record: structuredClone(item.record),
73:     }));
74:   const attempts = attemptState.results
75:     .filter((item) => item.pipelineRunId === options.pipelineRunId)
76:     .map((item) => ({
77:       attemptId: item.attemptId,
78:       claimGeneration: item.claimGeneration,
79:       workerId: item.workerId,
80:       result: structuredClone(item.result),
81:       storedAt: item.storedAt,
82:       evidence: attemptState.evidence
83:         .filter(
84:           (evidence) =>
85:             evidence.pipelineRunId === item.pipelineRunId &&
86:             evidence.attemptId === item.attemptId &&
87:             evidence.claimGeneration === item.claimGeneration,
88:         )
89:         .map((evidence) => structuredClone(evidence)),
90:     }))
91:     .sort(
92:       (left, right) =>
93:         left.attemptId.localeCompare(right.attemptId) ||
94:         left.claimGeneration - right.claimGeneration,
95:     );
96:   const closureIds = attemptState.closures
97:     .filter((item) => item.pipelineRunId === options.pipelineRunId)
98:     .map((item) => item.closureId)
99:     .sort();
100:   const nextCursor = Math.max(fromCursor, admissionTail.nextCursor);
101:   return {
102:     schemaVersion: "clawdeck-observation-view.v1",
103:     pipelineRunId: options.pipelineRunId,
104:     fromCursor,
105:     nextCursor,
106:     rawRecords,
107:     attempts,
108:     closureIds,
109:     completeness,
110:   };
111: }

SOURCE skills/common/plugin-runtime/foundation/observability/closure-projection.ts SHA256 0c76760e141a63472111d2e930e8215b8336a3a9ed9bac1533dd2cd2c0cae69a
1: import {canonicalJson, type ProducerClosureV1} from '@kubeclaw/pipeline-observability-contract';
2: import {createHash} from 'node:crypto';
3: import type {AttemptRetirementIntent, AttemptProjections} from './attempt-projection.ts';
4: import {replayAssert, replayIdentity, replayObject} from './replay-validation.ts';
5: 
6: export interface ClosureRetirementIntent extends AttemptRetirementIntent {
7:   closureDigest:string;
8: }
9: /** The result's completionIntent remains full; this never points to another closure reference. */
10: export interface ClosureReference {
11:   schemaVersion:'attempt-closure-reference.v1';
12:   resultKey:string;
13:   closureDigest:string;
14:   operationId:string;
15:   actor:string;
16:   intentDigest:string;
17: }
18: export type ClosureProjections=Map<string,ClosureReference>;
19: export const closureKey=(closure:ProducerClosureV1):string=>canonicalJson([closure.pipelineRunId,closure.closureId]);
20: export const closureIntentDigest=(intent:ClosureRetirementIntent):string=>`sha256:${createHash('sha256').update(canonicalJson(intent)).digest('hex')}`;
21: const DIGEST=/^sha256:[a-f0-9]{64}$/u;
22: 
23: export function resolveClosureReference(reference:ClosureReference,results:AttemptProjections):ProducerClosureV1 {
24:   replayObject(reference,['schemaVersion','resultKey','closureDigest','operationId','actor','intentDigest'],'closure-reference');
25:   replayAssert(reference.schemaVersion==='attempt-closure-reference.v1'&&typeof reference.resultKey==='string'
26:     &&DIGEST.test(reference.closureDigest)&&DIGEST.test(reference.intentDigest)
27:     &&replayIdentity(reference.operationId)&&replayIdentity(reference.actor),'closure-reference-identity');
28:   const result=results.get(reference.resultKey),closure=result?.completionIntent?.closure;
29:   replayAssert(result&&closure&&result.storedAt!==null&&closure.closureDigest===reference.closureDigest,'closure-reference-source');
30:   // Imported result decoding validates the full completion and its import. The
31:   // copied closure is then subject to the original closure/evidence replay rules.
32:   return structuredClone(closure);
33: }
34: 
35: export function decodeClosures(items:readonly (ProducerClosureV1|ClosureReference)[],results:AttemptProjections):{
36:   closures:ProducerClosureV1[];closureProjections:ClosureProjections;
37: } {
38:   const closureProjections:ClosureProjections=new Map();
39:   const closures=items.map(item=>{
40:     if(item.schemaVersion==='producer-closure.v1')return item;
41:     const reference=item as ClosureReference,closure=resolveClosureReference(reference,results),key=closureKey(closure);
42:     replayAssert(!closureProjections.has(key),'closure-reference-duplicate');
43:     closureProjections.set(key,reference);return closure;
44:   });
45:   replayAssert(closureProjections.size>0,'closure-projections-empty');
46:   return {closures,closureProjections};
47: }
48: 
49: export function encodeClosures(closures:readonly ProducerClosureV1[],references:ClosureProjections,results:AttemptProjections):(ProducerClosureV1|ClosureReference)[] {
50:   let found=0;
51:   const encoded=closures.map(closure=>{
52:     const reference=references.get(closureKey(closure));if(!reference)return closure;
53:     replayAssert(canonicalJson(resolveClosureReference(reference,results))===canonicalJson(closure),'closure-reference-mutated');
54:     found++;return reference;
55:   });
56:   replayAssert(found===references.size,'closure-reference-removed');return encoded;
57: }

SOURCE skills/common/plugin-runtime/foundation/observability/durable-attempts.ts SHA256 19a9a9ad9e3a3bbb876d2b846a3e97b738a1e9c2586e37c4bb2a80a960d46d20
1: import {
2:   producerClosureDigest,
3:   type ObservabilityCompletenessV1,
4:   type ProducerClosureV1,
5:   type ProducerGapReportV1,
6:   type ProducerIdentityV1,
7:   type ProducerRecordV1,
8:   type UnresolvedObservabilityItemV1,
9: } from "@kubeclaw/pipeline-observability-contract";
10: import type {
11:   WorkerAttemptResultV1,
12:   WorkerEvidenceRefV1,
