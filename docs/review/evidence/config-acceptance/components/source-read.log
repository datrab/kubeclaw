15:         if (isObject(templateSpec))
16:             return [templateSpec as JsonObject];
17:     }
18:     const jobTemplate = typed.jobTemplate;
19:     if (isObject(jobTemplate)) {
20:         const jobSpec = (jobTemplate as JsonObject).spec;
21:         const jobTemplateValue = isObject(jobSpec)
22:             ? (jobSpec as JsonObject).template : null;
23:         const jobPodSpec = isObject(jobTemplateValue)
24:             ? (jobTemplateValue as JsonObject).spec : null;
25:         if (isObject(jobPodSpec))
26:             return [jobPodSpec as JsonObject];
27:     }
28:     return [];
