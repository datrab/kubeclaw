72: /** Reads an existing regular canonical file or immutable prefix, never follows a link or repairs a tail. */
73: export function readAttemptJournalPrefix(file:string,maximumBytes:number,prefixBytes?:number):Buffer {
74:   replayAssert(Number.isSafeInteger(maximumBytes)&&maximumBytes>0,'attempt-journal-read-limit');
75:   replayAssert(fs.realpathSync(file)===file,'attempt-journal-path');
76:   const fd=fs.openSync(file,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW|fs.constants.O_NONBLOCK);
77:   try {
78:     const stat=fs.fstatSync(fd),length=prefixBytes??stat.size;
79:     replayAssert(stat.isFile()&&Number.isSafeInteger(length)&&length>0&&length<=maximumBytes&&stat.size>=length,'attempt-journal-size');
80:     const bytes=Buffer.alloc(length);let offset=0;
81:     while(offset<length){const count=fs.readSync(fd,bytes,offset,length-offset,offset);replayAssert(count>0,'attempt-journal-truncated');offset+=count;}
82:     replayAssert(fs.realpathSync(file)===file,'attempt-journal-path');
83:     return bytes;
84:   } finally {fs.closeSync(fd);}
85: }
86: function assertReference(item:ProjectedResultMetadata,root:string,maximumBytes:number):void {
87:   replayObject(item,['pipelineRunId','planId','nodeId','attemptId','claimGeneration','workerId','completionIntent','storedAt','resultReference'],'attempt-projected-result');
88:   const reference=item.resultReference;
89:   replayObject(reference,['schemaVersion','intent','journalPrefixBytes'],'attempt-result-reference');
90:   replayAssert(reference.schemaVersion==='attempt-result-reference.v1','attempt-result-reference-version');
91:   assertAttemptRetirementIntent(reference.intent,root);
92:   replayAssert(attemptProjectionKey(item)===attemptProjectionKey(reference.intent)&&item.completionIntent?.record.recordDigest===reference.intent.recordDigest,'attempt-result-reference-owner');
93:   replayAssert(Number.isSafeInteger(reference.journalPrefixBytes)&&reference.journalPrefixBytes>0&&reference.journalPrefixBytes<=maximumBytes,'attempt-result-reference-budget');
94: }
95: function assertImportedCompleteness(item:ProjectedResultMetadata,d:ImportEntry['decision']):void {
96:   validatePipelineObservabilityContract('observabilityCompleteness',d.completeness);
97:   const closure=item.completionIntent?.closure,c=d.completeness;
98:   replayAssert(closure&&c.pipelineRunId===item.pipelineRunId&&c.state==='complete'&&!c.missingClosureIds.length&&!c.missingRanges.length&&!c.unresolvedItems.length
99:     &&c.requiredClosureIds.includes(closure.closureId)&&c.admittedClosureIds.includes(closure.closureId),'attempt-result-import-completeness');
100: }
101: function resolveResult(item:ProjectedResultMetadata,record:HashJournalRecord<ImportEntry>):WorkerAttemptResultV1 {
102:   const {intent}=item.resultReference,entry=record.entry,d=entry.decision;
103:   replayAssert(record.sequence===intent.journalSequence&&record.hash===intent.journalHash&&entry.schemaVersion==='nova-observability-reconciliation.v1','attempt-result-journal-binding');
104:   replayAssert(d?.pipelineRunId===item.pipelineRunId&&d.planId===item.planId&&d.nodeId===item.nodeId&&d.attemptId===item.attemptId&&d.claimGeneration===item.claimGeneration
105:     &&d.action==='imported'&&d.nextClaimGeneration===null,'attempt-result-import-owner');
106:   validatePipelineWorkerCoreContract('workerAttemptResult',d.result);
107:   replayAssert(d.result.resultDigest===intent.resultDigest&&d.result.workerId===item.workerId&&item.storedAt!==null,'attempt-result-import-digest');
108:   replayAssert(entry.decisionKey===[item.pipelineRunId,item.planId,item.nodeId,item.attemptId,String(item.claimGeneration),intent.resultDigest,'imported'].join('|'),'attempt-result-import-key');
109:   assertImportedCompleteness(item,d);
110:   return structuredClone(d.result);
111: }
112: function offsets(bytes:Buffer):number[] {
113:   const ends:number[]=[];let at=-1;
114:   while((at=bytes.indexOf(10,at+1))!==-1)ends.push(at+1);
115:   return ends;
116: }
