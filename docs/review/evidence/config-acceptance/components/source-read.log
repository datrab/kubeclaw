18: export function manifestBytes(file: string, expectedDigest: string, maximumBytes: number): Buffer {
19:     const handle = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
20:     try {
21:         const before = fs.fstatSync(handle);
22:         if (before.size < 1 || before.size > maximumBytes)
23:             throw new Error('KUBERNETES_FIXTURE_MANIFEST_SIZE_INVALID');
24:         const bytes = Buffer.alloc(before.size);
25:         let offset = 0;
26:         while (offset < bytes.length) {
27:             const count = fs.readSync(handle, bytes, offset, bytes.length - offset, offset);
28:             if (count === 0)
29:                 throw new Error('KUBERNETES_FIXTURE_MANIFEST_READ_INCOMPLETE');
30:             offset += count;
31:         }
32:         const after = fs.fstatSync(handle);
33:         if (after.size !== before.size || after.mtimeMs !== before.mtimeMs) {
34:             throw new Error('KUBERNETES_FIXTURE_MANIFEST_CHANGED');
35:         }
36:         const digest = `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}`;
37:         if (digest !== expectedDigest)
38:             throw new Error('KUBERNETES_FIXTURE_MANIFEST_DIGEST_MISMATCH');
39:         return bytes;
40:     }
41:     finally {
42:         fs.closeSync(handle);
43:     }
44: }
45: export function flattenDocuments(values: unknown[], maximumResources: number, policy: BusterManifestPolicy): JsonObject[] {
46:     const out: JsonObject[] = [];
47:     const pending = values.filter(value => value !== null && value !== undefined).reverse();
48:     let visits = 0;
49:     while (pending.length) {
50:         if (++visits > policy.maximumFlattenVisits)
51:             throw new Error('KUBERNETES_FIXTURE_MANIFEST_COMPLEXITY_LIMIT');
52:         const document = object(pending.pop(), 'manifestDocument');
53:         if (document.kind === 'List') {
54:             if (!Array.isArray(document.items))
55:                 throw new Error('KUBERNETES_FIXTURE_MANIFEST_LIST_INVALID');
56:             if (pending.length + document.items.length > policy.maximumFlattenPending)
57:                 throw new Error('KUBERNETES_FIXTURE_MANIFEST_COMPLEXITY_LIMIT');
58:             for (let index = document.items.length - 1; index >= 0; index -= 1)
59:                 pending.push(document.items[index]);
60:         }
61:         else {
62:             if (out.length >= maximumResources)
63:                 throw new Error('KUBERNETES_FIXTURE_RESOURCE_COUNT_INVALID');
64:             out.push(document);
65:         }
66:     }
67:     return out;
68: }

