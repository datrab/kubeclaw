12: /** A reference to an immutable, already committed completion, never a new archive. */
13: export interface AdmissionCompletionReference {
14:   file: string;
15:   maximumBytes: number;
16:   pipelineRunId: string;
17:   planId: string;
18:   nodeId: string;
19:   attemptId: string;
20:   claimGeneration: number;
21:   resultDigest: string;
22:   closureDigest: string;
23: }
24: export interface AdmissionRetiredEntry {
25:   key: string;
26:   acknowledgement: AdmissionAcknowledgementV1;
27:   source: AdmissionCompletionReference;
28:   operationId: string;
29:   actor: string;
30:   authority: {runRoot:string;journalHead:string;snapshotDigest:string};
31: }
32: export function assertAdmissionRetiredEntry(entry: AdmissionRetiredEntry): void {
33:   replayObject(entry, ['key','acknowledgement','source','operationId','actor','authority'], 'admission-retired-entry');
34:   replayAssert(replayIdentity(entry.operationId) && replayIdentity(entry.actor), 'admission-retirement-author');
35:   validatePipelineObservabilityContract('admissionAcknowledgement',entry.acknowledgement);
36:   replayAssert(entry.acknowledgement.state === 'duplicate','admission-retirement-ack');
37:   const s=entry.source, a=entry.acknowledgement;
38:   replayObject(entry.authority,['runRoot','journalHead','snapshotDigest'],'admission-retirement-authority');
39:   replayAssert(typeof entry.authority.runRoot==='string' && path.isAbsolute(entry.authority.runRoot) && path.resolve(entry.authority.runRoot)===entry.authority.runRoot
40:     && /^sha256:[a-f0-9]{64}$/.test(entry.authority.journalHead) && /^sha256:[a-f0-9]{64}$/.test(entry.authority.snapshotDigest),'admission-retirement-authority-binding');
41:   replayObject(s,['file','maximumBytes','pipelineRunId','planId','nodeId','attemptId','claimGeneration','resultDigest','closureDigest'],'admission-retirement-source');
42:   replayAssert(s.file === path.join(entry.authority.runRoot,'observability/attempts/attempt-store.json'),'admission-retirement-file');
43:   replayAssert(Number.isSafeInteger(s.maximumBytes) && s.maximumBytes > 0 && Number.isSafeInteger(s.claimGeneration) && s.claimGeneration > 0,'admission-retirement-bounds');
44:   for(const field of ['pipelineRunId','planId','nodeId','attemptId'] as const)replayAssert(replayIdentity(s[field]),'admission-retirement-owner');
45:   replayAssert(/^sha256:[a-f0-9]{64}$/.test(s.resultDigest) && /^sha256:[a-f0-9]{64}$/.test(s.closureDigest),'admission-retirement-digest');
46:   replayAssert(a.pipelineRunId === s.pipelineRunId && entry.key === [a.producer.producerId,a.producer.bootId,a.producer.producerType,a.pipelineRunId,String(a.sequence)].join('|'),'admission-retirement-identity');
47: }
48: 
49: /** Atomic source snapshots are immutable for this result identity. No nested store lock. */
50: async function readRetirementBytes(file:string,maximumBytes:number):Promise<Buffer> {
51:   replayAssert(await fs.realpath(file)===file,'admission-retirement-source-path');
52:   const handle=await fs.open(file,constants.O_RDONLY|constants.O_NOFOLLOW|constants.O_NONBLOCK);
53:   let bytes:Buffer;
54:   try {
55:     const stat=await handle.stat();
56:     replayAssert(stat.isFile() && stat.size<=maximumBytes,'admission-retirement-source-size');
57:     bytes=Buffer.alloc(stat.size);let offset=0;
58:     while(offset<bytes.length){const read=await handle.read(bytes,offset,bytes.length-offset,offset);replayAssert(read.bytesRead>0,'admission-retirement-source-truncated');offset+=read.bytesRead;}
59:     replayAssert((await handle.read(Buffer.alloc(1),0,1,offset)).bytesRead===0,'admission-retirement-source-grew');
60:   } finally {await handle.close();}
61:   replayAssert(await fs.realpath(file)===file,'admission-retirement-source-path');
62:   return bytes;
63: }
64: async function readSource(s:AdmissionCompletionReference):Promise<DurableAttemptStoreSnapshot> {
65:   const state=JSON.parse((await readRetirementBytes(s.file,s.maximumBytes)).toString()) as PersistedAttempt;
66:   return decodeAttemptState(state,path.dirname(s.file),{
67:     maximumEvidenceObjects:Number.MAX_SAFE_INTEGER,maximumEvidenceBytes:Number.MAX_SAFE_INTEGER,
68:     maximumEvidenceObjectBytes:Number.MAX_SAFE_INTEGER,maximumResults:Number.MAX_SAFE_INTEGER,
69:     maximumClosures:Number.MAX_SAFE_INTEGER,maximumMetadataBytes:s.maximumBytes,maximumPendingEvidenceAgeMs:Number.MAX_SAFE_INTEGER,
70:   }).state;
71: }
72: export function resolveAdmissionRetiredSnapshot(entry:AdmissionRetiredEntry,state:DurableAttemptStoreSnapshot):AdmittedRecordView {
73:   assertAdmissionRetiredEntry(entry);
74:   const s=entry.source;
75:   const result=state.results.find(item=>item.pipelineRunId===s.pipelineRunId && item.attemptId===s.attemptId && item.claimGeneration===s.claimGeneration);
76:   replayAssert(result?.storedAt && result.planId===s.planId && result.nodeId===s.nodeId && result.result.resultDigest===s.resultDigest,'admission-retirement-source-result');
77:   const intent=result.completionIntent;
78:   replayAssert(intent && intent.closure.closureDigest===s.closureDigest && state.closures.some(item=>canonicalJson(item)===canonicalJson(intent.closure)),'admission-retirement-source-closure');
79:   const record=intent.record,a=entry.acknowledgement;
80:   replayAssert(record.recordDigest===a.recordDigest && record.recordId===a.recordId && canonicalJson(record.producer)===canonicalJson(a.producer)
81:     && record.sequence===a.sequence && record.correlation.pipelineRunId===a.pipelineRunId,'admission-retirement-source-record');
82:   return {record:structuredClone(record),canonicalCursor:a.canonicalCursor,admittedAt:a.admittedAt};
83: }
84: 
85: export async function resolveAdmissionRetiredEntries(entries:readonly AdmissionRetiredEntry[]):Promise<AdmittedRecordView[]> {
86:   const sources=new Map<string,Promise<DurableAttemptStoreSnapshot>>();
87:   return Promise.all(entries.map(async entry=>{
88:     assertAdmissionRetiredEntry(entry);
89:     const key=canonicalJson([entry.source.file,entry.source.maximumBytes]);
90:     let source=sources.get(key);
91:     if(!source){source=readSource(entry.source);sources.set(key,source);}
92:     return resolveAdmissionRetiredSnapshot(entry,await source);
93:   }));
94: }
95: export async function resolveAdmissionRetiredEntry(entry:AdmissionRetiredEntry):Promise<AdmittedRecordView> {
96:   return (await resolveAdmissionRetiredEntries([entry]))[0]!;
97: }
