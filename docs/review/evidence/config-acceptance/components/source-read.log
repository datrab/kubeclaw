5: export function podSpecs(document: JsonObject): JsonObject[] {
6:     const spec = document.spec;
7:     if (!isObject(spec))
8:         return [];
9:     const typed = spec as JsonObject;
10:     if (document.kind === 'Pod')
11:         return [typed];
12:     const template = typed.template;
13:     if (isObject(template)) {
