118: /** All references share the canonical run journal: one bounded read and one chain validation. */
119: export function decodeAttemptState(raw:PersistedAttempt,root:string,limits:DurableAttemptStoreLimits,
120:   readPrefix:(file:string,maximumBytes:number,prefixBytes:number)=>Buffer=readAttemptJournalPrefix,
121: ):{state:DurableAttemptStoreSnapshot;projections:AttemptProjections;closureProjections:ClosureProjections} {
122:   if(raw.schemaVersion==='durable-attempt-store.v1') {assertAttemptReplay(raw,root,limits);return {state:raw,projections:new Map(),closureProjections:new Map()};}
123:   replayObject(raw,['schemaVersion','evidence','results','closures'],'attempt-v2-envelope');
124:   replayAssert(['durable-attempt-store.v2','durable-attempt-store.v3'].includes(raw.schemaVersion)&&Array.isArray(raw.results)&&Array.isArray(raw.closures),'attempt-v2-version');
125:   const projected=raw.results.filter((item):item is ProjectedResultMetadata=>Object.hasOwn(item,'resultReference'));
126:   replayAssert(projected.length>0,'attempt-v2-empty-projections');
127:   for(const item of projected)assertReference(item,root,limits.maximumMetadataBytes);
128:   const maximumPrefix=projected.reduce((maximum,item)=>Math.max(maximum,item.resultReference.journalPrefixBytes),0);
129:   const journal=attemptImportJournal(root),bytes=readPrefix(journal,limits.maximumMetadataBytes,maximumPrefix);
130:   replayAssert(bytes.length===maximumPrefix,'attempt-journal-prefix-length');
131:   const records=parseHashJournal<ImportEntry>(bytes,journal),ends=offsets(bytes),projections:AttemptProjections=new Map();
132:   const results=raw.results.map(item=>{
133:     if(!('resultReference' in item))return item;
134:     const ref=item.resultReference,record=records[ref.intent.journalSequence-1];
135:     replayAssert(record&&ends[ref.intent.journalSequence-1]===ref.journalPrefixBytes,'attempt-journal-prefix-binding');
136:     const key=attemptProjectionKey(item);replayAssert(!projections.has(key),'attempt-result-projection-duplicate');projections.set(key,item);
137:     const {resultReference:_,...metadata}=item;
138:     return {...metadata,result:resolveResult(item,record)};
139:   });
140:   const decoded=raw.schemaVersion==='durable-attempt-store.v3'?decodeClosures(raw.closures,projections):{closures:raw.closures,closureProjections:new Map()};
141:   const state:DurableAttemptStoreSnapshot={...raw,schemaVersion:'durable-attempt-store.v1',results,closures:decoded.closures};
142:   assertAttemptReplay(state,root,limits,projections.size,decoded.closureProjections.size);
143:   return {state,projections,closureProjections:decoded.closureProjections};
144: }
145: 
146: export function encodeAttemptState(state:DurableAttemptStoreSnapshot,projections:AttemptProjections,closureProjections:ClosureProjections=new Map()):PersistedAttempt {
147:   if(!projections.size){replayAssert(!closureProjections.size,'closure-result-projection-required');return state;}
148:   let found=0;
149:   const results=state.results.map(item=>{
150:     const projected=projections.get(attemptProjectionKey(item));if(!projected)return item;
151:     const {result,...metadata}=item,{resultReference,...retained}=projected;
152:     replayAssert(result.resultDigest===resultReference.intent.resultDigest&&canonicalJson(metadata)===canonicalJson(retained),'attempt-projection-mutated');
153:     found++;return projected;
154:   });
155:   replayAssert(found===projections.size,'attempt-projection-removed');
156:   if(closureProjections.size)return {...state,schemaVersion:'durable-attempt-store.v3',results,closures:encodeClosures(state.closures,closureProjections,projections)};
157:   return {...state,schemaVersion:'durable-attempt-store.v2',results};
158: }
159: 
160: export function createAttemptProjection(item:DurableResultMetadata,intent:AttemptRetirementIntent,root:string,maximumBytes:number):ProjectedResultMetadata {
161:   assertAttemptRetirementIntent(intent,root);
162:   const journal=attemptImportJournal(root),bytes=readAttemptJournalPrefix(journal,maximumBytes);
163:   const records=parseHashJournal<ImportEntry>(bytes,journal),end=offsets(bytes)[intent.journalSequence-1];
164:   replayAssert(end!==undefined,'attempt-import-checkpoint-missing');
165:   const {result,...metadata}=item;
166:   const projected:ProjectedResultMetadata={...metadata,resultReference:{schemaVersion:'attempt-result-reference.v1',intent:structuredClone(intent),journalPrefixBytes:end}};
167:   assertReference(projected,root,maximumBytes);
168:   replayAssert(canonicalJson(resolveResult(projected,records[intent.journalSequence-1]!))===canonicalJson(result),'attempt-import-result-changed');
169:   return projected;
170: }

SOURCE skills/common/plugin-runtime/foundation/observability/attempt-replay.ts SHA256 99b766563ae07230838fa85c4f60a3c6b0f9a4dde341885af679ce983ad8eb08
1: import path from 'node:path';
2: import { pathToFileURL } from 'node:url';
3: import { canonicalJson, validatePipelineObservabilityContract, type ProducerClosureV1, type ProducerIdentityV1 } from '@kubeclaw/pipeline-observability-contract';
4: import { validatePipelineWorkerCoreContract, type WorkerAttemptResultV1 } from '@kubeclaw/pipeline-worker-core-contract';
5: import { scopedEvidenceId, type DurableAttemptStoreLimits, type DurableAttemptStoreSnapshot, type DurableCompletionIntent, type DurableEvidenceMetadata, type DurableResultMetadata } from './durable-attempts.ts';
6: import { replayAssert, replayIdentity, replayObject, replayTimestamp, replayUnique } from './replay-validation.ts';
7: 
8: function sameProducer(left: ProducerIdentityV1, right: ProducerIdentityV1): boolean {
9:   return canonicalJson(left) === canonicalJson(right);
10: }
11: export function assertCompletionIntent(pipelineRunId: string, snapshot: WorkerAttemptResultV1, intent: DurableCompletionIntent | null): void {
12:   if (intent === null) return;
13:   replayObject(intent, ['record', 'closure'], 'attempt-intent');
14:   validatePipelineObservabilityContract('producerRecord', intent.record);
15:   validatePipelineObservabilityContract('producerClosure', intent.closure);
16:   const declared = new Set(intent.closure.requiredEvidenceIds);
17:   const evidenceBound = snapshot.evidence.every((item) => declared.has(scopedEvidenceId(snapshot.attemptId, snapshot.claimGeneration, item.evidenceId)));
18:   const payload = intent.record.payload as Record<string, unknown> | null;
19:   if (intent.record.recordType !== 'attempt.completed' || !payload || payload.resultDigest !== snapshot.resultDigest || payload.workerId !== snapshot.workerId
20:     || intent.record.correlation.pipelineRunId !== pipelineRunId || intent.record.correlation.attemptId !== snapshot.attemptId
21:     || intent.record.correlation.claimId !== snapshot.claimId || intent.record.correlation.claimGeneration !== snapshot.claimGeneration
22:     || intent.closure.pipelineRunId !== pipelineRunId || !sameProducer(intent.record.producer, intent.closure.producer) || !evidenceBound) {
23:     throw new Error('OBSERVABILITY_COMPLETION_INTENT_IDENTITY_MISMATCH');
24:   }
25: }
26: function evidenceKey(item: { pipelineRunId: string; attemptId: string; claimGeneration: number; evidenceId: string }): string {
27:   return canonicalJson([item.pipelineRunId, item.attemptId, item.claimGeneration, item.evidenceId]);
28: }
29: function evidenceReplay(item: DurableEvidenceMetadata, root: string, keys: Set<string>): void {
30:   replayObject(item, ['pipelineRunId', 'attemptId', 'claimGeneration', 'producer', 'evidenceId', 'type', 'mediaType', 'artifact', 'stagedAt'], 'attempt-evidence');
31:   for (const field of ['pipelineRunId', 'attemptId', 'evidenceId', 'type', 'mediaType'] as const) replayAssert(replayIdentity(item[field]), `attempt-evidence-${field}`);
32:   replayAssert(Number.isSafeInteger(item.claimGeneration) && item.claimGeneration > 0 && replayTimestamp(item.stagedAt), 'attempt-evidence-generation');
33:   validatePipelineObservabilityContract('producerIdentity', item.producer);
34:   validatePipelineWorkerCoreContract('workerEvidenceRef', { evidenceId: item.evidenceId, type: item.type, artifact: item.artifact });
35:   const hex = item.artifact.contentDigest.slice(7);
36:   replayAssert(item.artifact.artifactId === `artifact:${hex}` && item.artifact.type === item.type && item.artifact.mediaType === item.mediaType
37:     && item.artifact.storageUrl === pathToFileURL(path.join(root, 'blobs', hex.slice(0, 2), hex)).href, 'attempt-evidence-artifact');
38:   replayUnique(keys, evidenceKey(item), 'attempt-evidence-duplicate');
39: }
40: function resultReplay(item: DurableResultMetadata, evidence: Map<string, DurableEvidenceMetadata>, keys: Set<string>): void {
41:   replayObject(item, ['pipelineRunId', 'planId', 'nodeId', 'attemptId', 'claimGeneration', 'workerId', 'result', 'completionIntent', 'storedAt'], 'attempt-result');
42:   replayAssert(replayIdentity(item.pipelineRunId) && (item.storedAt === null || replayTimestamp(item.storedAt)), 'attempt-result-metadata');
43:   replayAssert((item.planId === null && item.nodeId === null) || (replayIdentity(item.planId) && replayIdentity(item.nodeId)), 'attempt-result-owner');
44:   validatePipelineWorkerCoreContract('workerAttemptResult', item.result);
45:   replayAssert(item.attemptId === item.result.attemptId && item.claimGeneration === item.result.claimGeneration && item.workerId === item.result.workerId, 'attempt-result-identity');
46:   replayUnique(keys, canonicalJson([item.pipelineRunId, item.attemptId, item.claimGeneration]), 'attempt-result-duplicate');
47:   assertCompletionIntent(item.pipelineRunId, item.result, item.completionIntent);
48:   if (item.completionIntent !== null) closureEvidenceReplay(item.completionIntent.closure, evidence.values());
49:   for (const reference of item.result.evidence) {
50:     const metadata = evidence.get(evidenceKey({ ...item, evidenceId: reference.evidenceId }));
51:     replayAssert(metadata && canonicalJson(metadata.artifact) === canonicalJson(reference.artifact) && metadata.type === reference.type, 'attempt-result-evidence');
52:     if (item.completionIntent !== null) replayAssert(sameProducer(metadata.producer, item.completionIntent.record.producer), 'attempt-result-evidence-producer');
53:   }
54: }
55: function closureEvidenceReplay(closure: ProducerClosureV1, evidence: Iterable<DurableEvidenceMetadata>): void {
56:   for (const metadata of evidence) {
57:     if (metadata.pipelineRunId !== closure.pipelineRunId) continue;
58:     const scoped = scopedEvidenceId(metadata.attemptId, metadata.claimGeneration, metadata.evidenceId);
59:     if (closure.requiredEvidenceIds.includes(scoped)) replayAssert(sameProducer(metadata.producer, closure.producer), 'attempt-closure-evidence-producer');
60:   }
61:   // Closure-only staged evidence may already have expired under the existing
62:   // retention contract. Missing bytes/metadata remain a completeness issue;
63:   // present metadata must never contradict the closure's producer identity.
64: }
65: function projectionCount(count:number,length:number,reason:string):void {
66:   replayAssert(Number.isSafeInteger(count)&&count>=0&&count<=length,reason);
67: }
68: export function assertAttemptReplay(state: DurableAttemptStoreSnapshot, root: string, limits: DurableAttemptStoreLimits, validatedProjectedResults = 0, validatedProjectedClosures = 0): void {
69:   replayObject(state, ['schemaVersion', 'evidence', 'results', 'closures'], 'attempt-envelope');
70:   replayAssert(state.schemaVersion === 'durable-attempt-store.v1' && Array.isArray(state.evidence) && Array.isArray(state.results) && Array.isArray(state.closures), 'attempt-version');
71:   projectionCount(validatedProjectedResults,state.results.length,'attempt-projection-count');
72:   projectionCount(validatedProjectedClosures,state.closures.length,'closure-projection-count');
73:   replayAssert(state.evidence.length <= limits.maximumEvidenceObjects && state.results.length - validatedProjectedResults <= limits.maximumResults && state.closures.length - validatedProjectedClosures <= limits.maximumClosures, 'attempt-count');
74:   const evidenceKeys = new Set<string>();
75:   const evidence = new Map<string, DurableEvidenceMetadata>();
76:   for (const item of state.evidence) { evidenceReplay(item, root, evidenceKeys); evidence.set(evidenceKey(item), item); }
77:   const resultKeys = new Set<string>();
78:   const generations = new Map<string, number>();
79:   for (const item of state.results) {
80:     resultReplay(item, evidence, resultKeys);
81:     const attemptKey = canonicalJson([item.pipelineRunId, item.attemptId]);
82:     replayAssert(item.claimGeneration > (generations.get(attemptKey) ?? 0), 'attempt-generation-order');
83:     generations.set(attemptKey, item.claimGeneration);
84:   }
85:   const closureKeys = new Set<string>();
86:   for (const closure of state.closures) {
87:     validatePipelineObservabilityContract('producerClosure', closure);
88:     closureEvidenceReplay(closure, state.evidence);
89:     replayUnique(closureKeys, canonicalJson([closure.pipelineRunId, closure.closureId]), 'attempt-closure-duplicate');
90:     const owners = state.results.filter((item) => item.pipelineRunId === closure.pipelineRunId && item.completionIntent?.closure.closureId === closure.closureId);
91:     for (const owner of owners) replayAssert(canonicalJson(owner.completionIntent!.closure) === canonicalJson(closure), 'attempt-closure-intent');
92:   }
93: }

SOURCE skills/common/plugin-runtime/foundation/observability/attempt-results.ts SHA256 8eb29b312f6dc332a597294589a3b7089650868853688fc45012b7cf70cef18c
1: import fs from "node:fs/promises";
2: import {
3:   canonicalJson,
4:   type ProducerClosureV1,
5: } from "@kubeclaw/pipeline-observability-contract";
6: import {
7:   validatePipelineWorkerCoreContract,
8:   type WorkerAttemptResultV1,
9: } from "@kubeclaw/pipeline-worker-core-contract";
10: import { assertCompletionIntent } from "./attempt-replay.ts";
11: import {
12:   requireIdentity,
13:   digest,
14:   cleanupUnreferencedBlobs,
15: } from "./attempt-evidence.ts";
16: import { storeClosureUnlocked } from "./attempt-completeness.ts";
17: import type {
18:   DurableCompletionIntent,
19:   DurableResultMetadata,
20:   DurableAttemptStoreSnapshot,
21:   DurableResultOwner,
22: } from "./durable-attempts.ts";
23: import type { AttemptState } from "./attempt-state.ts";
24: import type { FileObservabilityAdmissionStore } from "./durable-delivery.ts";
25: export async function storeResult(
26:   store: AttemptState,
27:   pipelineRunId: string,
28:   result: WorkerAttemptResultV1,
29:   completionIntent: DurableCompletionIntent | null = null,
30:   owner: DurableResultOwner | null = null,
31: ): Promise<DurableResultMetadata> {
32:   requireIdentity(pipelineRunId, "OBSERVABILITY_PIPELINE_RUN_ID_INVALID");
33:   const snapshot = structuredClone(result);
34:   const intent = structuredClone(completionIntent);
35:   const ownerSnapshot = structuredClone(owner);
36:   if (ownerSnapshot) {
37:     requireIdentity(ownerSnapshot.planId, "OBSERVABILITY_PLAN_ID_INVALID");
38:     requireIdentity(ownerSnapshot.nodeId, "OBSERVABILITY_NODE_ID_INVALID");
39:   }
40:   validatePipelineWorkerCoreContract("workerAttemptResult", snapshot);
41:   assertCompletionIntent(pipelineRunId, snapshot, intent);
42:   return store.serial(async () => {
43:     const state = await store.readState();
44:     await store.reclaimExpiredEvidence(state);
45:     await cleanupUnreferencedBlobs(store.root, state);
46:     const existing = findResult(state, pipelineRunId, snapshot);
47:     if (existing)
48:       return resumeResultCommit(
49:         store,
50:         state,
51:         existing,
52:         snapshot,
53:         intent,
54:         ownerSnapshot,
55:       );
56:     requireUnfinalizedAttempt(state, pipelineRunId, snapshot);
57:     await verifyResultEvidence(state, pipelineRunId, snapshot);
58:     return commitResult(
59:       store,
60:       state,
61:       pipelineRunId,
62:       snapshot,
63:       intent,
64:       ownerSnapshot,
65:     );
66:   });
67: }
68: export async function resumeCompletion(
69:   store: AttemptState,
70:   pipelineRunId: string,
71:   attemptId: string,
72:   claimGeneration: number,
73:   admission: FileObservabilityAdmissionStore,
74: ): Promise<ProducerClosureV1> {
75:   return store.serial(async () => {
76:     const state = await store.readState();
77:     await store.reclaimExpiredEvidence(state);
78:     if (
79:       state.results.some(
80:         (item) =>
81:           item.pipelineRunId === pipelineRunId &&
82:           item.attemptId === attemptId &&
83:           item.claimGeneration > claimGeneration,
84:       )
85:     )
86:       throw new Error("OBSERVABILITY_STALE_CLAIM_COMPLETION");
87:     const stored = state.results.find(
88:       (item) =>
89:         item.pipelineRunId === pipelineRunId &&
90:         item.attemptId === attemptId &&
91:         item.claimGeneration === claimGeneration,
92:     );
93:     if (!stored?.completionIntent)
94:       throw new Error("OBSERVABILITY_COMPLETION_INTENT_MISSING");
95:     if (typeof stored.storedAt !== "string")
96:       throw new Error("OBSERVABILITY_RESULT_COMMIT_PENDING");
97:     const { records: admitted } = await admission.admitAndRead(
98:       canonicalJson(stored.completionIntent.record),
99:     );
100:     return storeClosureUnlocked(
101:       store,
102:       state,
103:       stored.completionIntent.closure,
104:       admitted,
105:     );
106:   });
107: }
108: 
109: function findResult(
110:   state: DurableAttemptStoreSnapshot,
111:   pipelineRunId: string,
112:   snapshot: WorkerAttemptResultV1,
113: ): DurableResultMetadata | undefined {
114:   const generations = state.results
115:     .filter(
116:       (item) =>
117:         item.pipelineRunId === pipelineRunId &&
118:         item.attemptId === snapshot.attemptId,
119:     )
120:     .map((item) => item.claimGeneration);
121:   const highest = generations.length ? Math.max(...generations) : 0;
122:   if (snapshot.claimGeneration < highest)
123:     throw new Error("OBSERVABILITY_STALE_CLAIM_RESULT");
124:   return state.results.find(
125:     (item) =>
126:       item.pipelineRunId === pipelineRunId &&
127:       item.attemptId === snapshot.attemptId &&
128:       item.claimGeneration === snapshot.claimGeneration,
129:   );
130: }
131: 
132: async function resumeResultCommit(
133:   store: AttemptState,
134:   state: DurableAttemptStoreSnapshot,
135:   existing: DurableResultMetadata,
136:   snapshot: WorkerAttemptResultV1,
137:   intent: DurableCompletionIntent | null,
138:   ownerSnapshot: DurableResultOwner | null,
139: ): Promise<DurableResultMetadata> {
140:   if (
141:     existing.result.resultDigest !== snapshot.resultDigest ||
142:     canonicalJson(existing.completionIntent) !== canonicalJson(intent) ||
143:     existing.planId !== (ownerSnapshot?.planId ?? null) ||
144:     existing.nodeId !== (ownerSnapshot?.nodeId ?? null)
145:   )
146:     throw new Error("OBSERVABILITY_RESULT_IDENTITY_CONFLICT");
147:   if (existing.storedAt === null) {
148:     existing.storedAt = new Date().toISOString();
149:     store.checkSize(state);
150:     await store.writeState(state);
151:   }
152:   return structuredClone(existing);
153: }
154: 
155: function requireUnfinalizedAttempt(
156:   state: DurableAttemptStoreSnapshot,
157:   pipelineRunId: string,
158:   snapshot: WorkerAttemptResultV1,
159: ): void {
160:   const finalizedGeneration = state.results.find(
161:     (item) =>
162:       item.pipelineRunId === pipelineRunId &&
163:       item.attemptId === snapshot.attemptId &&
164:       item.claimGeneration < snapshot.claimGeneration &&
165:       item.completionIntent !== null &&
166:       state.closures.some(
167:         (closure) =>
168:           closure.pipelineRunId === pipelineRunId &&
169:           closure.closureId === item.completionIntent!.closure.closureId,
170:       ),
171:   );
172:   if (finalizedGeneration)
173:     throw new Error("OBSERVABILITY_ATTEMPT_ALREADY_COMPLETED");
174: }
175: 
176: async function verifyResultEvidence(
177:   state: DurableAttemptStoreSnapshot,
178:   pipelineRunId: string,
179:   snapshot: WorkerAttemptResultV1,
180: ): Promise<void> {
181:   for (const evidence of snapshot.evidence) {
182:     const metadata = state.evidence.find(
183:       (item) =>
184:         item.pipelineRunId === pipelineRunId &&
185:         item.attemptId === snapshot.attemptId &&
186:         item.claimGeneration === snapshot.claimGeneration &&
187:         item.evidenceId === evidence.evidenceId,
188:     );
189:     if (
190:       !metadata ||
191:       canonicalJson(metadata.artifact) !== canonicalJson(evidence.artifact)
192:     )
193:       throw new Error(
194:         `OBSERVABILITY_RESULT_EVIDENCE_MISSING:${evidence.evidenceId}`,
195:       );
196:     const file = new URL(metadata.artifact.storageUrl);
197:     const evidenceBytes = await fs.readFile(file);
198:     if (
199:       evidenceBytes.byteLength !== metadata.artifact.sizeBytes ||
200:       digest(evidenceBytes) !== metadata.artifact.contentDigest
201:     )
202:       throw new Error(
203:         `OBSERVABILITY_RESULT_EVIDENCE_CORRUPT:${evidence.evidenceId}`,
204:       );
205:   }
206: }
207: 
208: async function commitResult(
209:   store: AttemptState,
210:   state: DurableAttemptStoreSnapshot,
211:   pipelineRunId: string,
212:   snapshot: WorkerAttemptResultV1,
213:   intent: DurableCompletionIntent | null,
214:   ownerSnapshot: DurableResultOwner | null,
215: ): Promise<DurableResultMetadata> {
216:   if (
217:     state.results.length - store.projections.size >=
218:     store.limits.maximumResults
219:   )
220:     throw new Error("OBSERVABILITY_RESULT_STORE_FULL");
221:   const metadata: DurableResultMetadata = {
222:     pipelineRunId,
223:     planId: ownerSnapshot?.planId ?? null,
224:     nodeId: ownerSnapshot?.nodeId ?? null,
225:     attemptId: snapshot.attemptId,
226:     claimGeneration: snapshot.claimGeneration,
227:     workerId: snapshot.workerId,
228:     result: snapshot,
229:     completionIntent: intent,
230:     storedAt: null,
231:   };
232:   const pending = { ...state, results: [...state.results, metadata] };
233:   const reservedCommit: DurableResultMetadata = {
234:     ...metadata,
235:     storedAt: "9999-12-31T23:59:59.999Z",
236:   };
237:   store.checkSize({
238:     ...state,
239:     results: [...state.results, reservedCommit],
240:   });
241:   await store.writeState(pending);
242:   const committed: DurableResultMetadata = {
243:     ...metadata,
244:     storedAt: new Date().toISOString(),
245:   };
246:   const committedState = {
247:     ...state,
248:     results: [...state.results, committed],
249:   };
250:   store.checkSize(committedState);
251:   await store.writeState(committedState);
252:   return structuredClone(committed);
253: }

