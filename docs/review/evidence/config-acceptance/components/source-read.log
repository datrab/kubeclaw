SOURCE skills/common/plugin-runtime/foundation/config/swarm-bundle.ts SHA256 8f29590beaa082f4bdb51741aebefca4f917c280e4fdbf153b7aca0f92d434b3
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import { createHash } from 'node:crypto';
4: import Ajv2020 from 'ajv/dist/2020.js';
5: 
6: const owners = ['prism-control', 'prism-studio', 'prism-worker', 'prism-execution', 'buster-engine', 'worker-core'] as const;
7: type Owner = typeof owners[number];
8: interface Validator { (value: unknown): boolean; errors?: unknown[] | null }
9: const AjvConstructor = Ajv2020 as unknown as new (options: { allErrors: boolean; strict: boolean }) => {
10:   compile(schema: object): Validator;
11: };
12: const ajv = new AjvConstructor({ allErrors: true, strict: true });
13: const entrySchema = JSON.parse(fs.readFileSync(new URL('./swarm.schema.json', import.meta.url), 'utf8')) as object;
14: const componentSchema = JSON.parse(fs.readFileSync(new URL('./swarm-components.schema.json', import.meta.url), 'utf8')) as {
15:   $defs: Record<string, object>;
16: };
17: const validateEntry = ajv.compile(entrySchema);
18: const validateComponent = ajv.compile(componentSchema);
19: const settingsDefinitionNames = ['buster-preparation', 'buster-admission', 'buster-dependency-readiness',
20:   'buster-runtime-security', 'buster-cluster-invokers', 'buster-execution', 'buster-execution-observation', 'buster-provider-runtime', 'buster-execution-reports', 'buster-execution-processInput'] as const;
21: const settingsValidators = new Map(settingsDefinitionNames.map(name => [name, ajv.compile({
22:   $defs: componentSchema.$defs, $ref: name === 'buster-runtime-security'
23:     ? '#/$defs/buster-cluster-invokers/properties/runtimeSecurity' : `#/$defs/${name}`,
24: })]));
25: interface Component {
26:   readonly schemaVersion: 'swarm-component.v1';
27:   readonly owner: Owner;
28:   readonly settings: Readonly<Record<string, unknown>>;
29: }
30: interface Observation {
31:   readonly file: string;
32:   readonly fd: number;
33:   readonly before: fs.BigIntStats;
34:   readonly sha256: string;
35: }
36: export interface SwarmBundleIdentity {
37:   readonly entry: string;
38:   readonly generationDirectory: string;
39:   readonly files: readonly Readonly<{ name: string; sha256: string }>[];
40: }
41: 
42: /** Envelope validators are also used at the existing owned-host boundary. */
43: export function validateComponentSettings(name: (typeof settingsDefinitionNames)[number], value: unknown, error: string): void {
44:   const validate = settingsValidators.get(name);
45:   if (!validate || !validate(value)) throw new Error(error);
46: }
47: 
48: function freezeJson(value: unknown): void {
49:   if (value === null || typeof value !== 'object') return;
50:   for (const child of Object.values(value)) freezeJson(child);
51:   Object.freeze(value);
52: }
53: 
54: function unchanged(a: fs.BigIntStats, b: fs.BigIntStats): boolean {
55:   return b.isFile() && a.dev === b.dev && a.ino === b.ino && a.mode === b.mode
56:     && a.size === b.size && a.mtimeNs === b.mtimeNs && a.ctimeNs === b.ctimeNs;
57: }
58: 
59: function readDocument(file: string, observations: Observation[]): unknown {
60:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
61:   try {
62:     const before = fs.fstatSync(fd, { bigint: true });
63:     if (!before.isFile()) throw new Error(`SWARM_CONFIG_INVALID:not a regular file:${file}`);
64:     const bytes = fs.readFileSync(fd);
65:     if (!unchanged(before, fs.fstatSync(fd, { bigint: true }))) throw new Error(`SWARM_CONFIG_CHANGED:${file}`);
66:     const value: unknown = JSON.parse(bytes.toString('utf8'));
67:     observations.push({ file, fd, before, sha256: createHash('sha256').update(bytes).digest('hex') });
68:     return value;
69:   } catch (error) {
70:     fs.closeSync(fd);
71:     throw error;
72:   }
73: }
74: 
75: /** Resolve only the entry alias; every component stays in that physical generation. */
76: export function readSwarmBundle(file: string | undefined): Readonly<{
77:   components: Readonly<Record<Owner, Component>>;
78:   profile: Readonly<Record<string, unknown>>;
79:   identity: SwarmBundleIdentity;
80: }> {
81:   if (typeof file !== 'string' || file.length === 0 || !path.isAbsolute(file)) {
82:     throw new Error('SWARM_CONFIG_PATH_REQUIRED');
83:   }
84:   const entry = fs.realpathSync(file);
85:   const generationDirectory = path.dirname(entry);
86:   const observations: Observation[] = [];
87:   try {
88:     const document = readDocument(entry, observations);
89:     if (!validateEntry(document)) throw new Error(`SWARM_CONFIG_INVALID:${JSON.stringify(validateEntry.errors)}`);
90:     const references = (document as { components: Record<Owner, string> }).components;
91:     const components = {} as Record<Owner, Component>;
92:     for (const owner of owners) {
93:       // The strict entry schema fixes each filename; there is no include resolver.
94:       const value = readDocument(path.join(generationDirectory, references[owner]), observations);
95:       if (!validateComponent(value) || (value as Component).owner !== owner) {
96:         throw new Error(`SWARM_CONFIG_INVALID:component:${owner}`);
97:       }
98:       freezeJson(value);
99:       components[owner] = value as Component;
100:     }
101:     for (const observation of observations) {
102:       if (!unchanged(observation.before, fs.fstatSync(observation.fd, { bigint: true }))
103:         || !unchanged(observation.before, fs.lstatSync(observation.file, { bigint: true }))) {
104:         throw new Error(`SWARM_CONFIG_CHANGED:${observation.file}`);
105:       }
106:     }
107:     const identity: SwarmBundleIdentity = Object.freeze({
108:       entry, generationDirectory,
109:       files: Object.freeze(observations.map(item => Object.freeze({ name: path.basename(item.file), sha256: item.sha256 }))),
110:     });
111:     const entryValues = document as Record<string, unknown>;
112:     const profile = { _doc: entryValues._doc, profile: entryValues.profile, features: entryValues.features,
113:       tuning: entryValues.tuning, overrides: entryValues.overrides };
114:     freezeJson(profile);
115:     return Object.freeze({ components: Object.freeze(components), profile, identity });
116:   } finally {
117:     for (const observation of observations) fs.closeSync(observation.fd);
118:   }
119: }

