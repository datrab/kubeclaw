125: function cleanupFailedFor(worker: WorkerAttemptResultV1 | null, retainedFailure: boolean): boolean {
126:   if (worker?.cleanup.state === 'failed') return true;
127:   if (retainedFailure) return true;
128:   return worker?.error?.code === 'WORKER_TERMINATION_FAILED';
129: }
130: 
131: function unsignedAttemptResult(owner: ResultOwner, input: ResultInput,
132:   facts: { executionState: ExecutionState; outcome: TestOutcome; completedProviderResult: ProviderResultV1 | null; evidence: EvidenceRefV1[] }) {
133:  const { state, node, attemptNumber, issuedAt, busterLog, workerResult, workerRuntimeFault } = input;
134:  const { attemptId } = input.prepared;
135:  const { executionState, outcome, completedProviderResult, evidence } = facts;
136:     const fallbackCompletedAt = owner.now();
137:     const resources = attemptResources(workerResult, busterLog, evidence);
138:     const faulted = executionState !== "completed";
139:     const unsigned = {
140:       schemaVersion: "attempt-result.v1" as const,
141:       ...resultIdentity(owner.options.plan, node),
142:       attemptId,
143:       attemptNumber,
144:       provider: node.provider,
145:       mode: node.mode,
146:       executionState,
147:       outcome,
148:       startedAt: workerResult?.startedAt ?? issuedAt.toISOString(),
149:       completedAt:
150:         workerResult?.completedAt ?? fallbackCompletedAt.toISOString(),
151:       durationMs:
152:         workerResult?.durationMs ??
153:         Math.max(0, fallbackCompletedAt.getTime() - issuedAt.getTime()),
154:       summary: attemptSummary(state.evidenceFault, workerRuntimeFault, workerResult),
155:       ...providerResultFields(faulted, completedProviderResult, workerResult),
156:       evidence,
157:       outputs: faulted ? [] : state.producedOutputs,
158:       resources,
159:       exitCode: workerResult?.exitCode ?? null,
