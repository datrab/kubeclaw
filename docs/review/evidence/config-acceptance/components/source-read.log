2: import { randomUUID } from 'node:crypto';
3: import { NativeProcessLaunches } from './native-process-launches.ts';
4: import type { ChildProcessWithoutNullStreams } from 'node:child_process';
5: import { NativeWorkerResourceScope, type NativeWorkerScopeLimits } from './native-resource-scope.ts';
6: import type { NativeWorkerResourceObservation } from './native-resource-observation.ts';
