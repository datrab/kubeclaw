70: export class TailscaleExposureCapabilityInvoker implements TestProviderCapabilityInvoker {
71:   readonly #kubectl: string;
72:   readonly #controllerNamespace: string;
73:   readonly #apiGroup: string;
74:   readonly #apiVersion: string;
75:   readonly #prefixes: readonly string[];
76:   readonly #suffixes: readonly string[];
77:   readonly #maximumExecutionMs: number;
78:   readonly #pollIntervalMs: number;
79:   readonly #shortCommandTimeoutMs: number;
