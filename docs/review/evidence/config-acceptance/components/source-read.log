173: function busterSettingsFromConfig(value: unknown, componentDirectory: string): BusterSettings {
174:   const preparation = busterPreparationSettingsFromConfig(value);
175:   const admission = validateBusterAdmissionSettings((value as SwarmConfig).operator.buster?.admission);
176:   const dependencyReadiness = validateBusterDependencyReadinessSettings((value as SwarmConfig).operator.buster?.dependencyReadiness);
177:   const execution = validateBusterExecutionSettings((value as SwarmConfig).operator.buster?.execution);
178:   const authored = validateBusterClusterInvokerSettings((value as SwarmConfig).operator.buster?.clusterInvokers);
179:   const clusterInvokers = Object.freeze({ ...authored, shared: Object.freeze({ ...authored.shared,
180:     kubectlExecutable: path.resolve(componentDirectory, authored.shared.kubectlExecutable) }) });
181:   return Object.freeze({ preparation, admission, dependencyReadiness, execution, clusterInvokers });
182: }
