50: function validateContainerSecurity(raw: unknown, podSecurity: JsonObject): void {
51:     const container = object(raw, 'container');
52:     const security = object(container.securityContext ?? {}, 'container.securityContext');
53:     if (security.privileged === true || security.allowPrivilegeEscalation !== false
54:         || (security.runAsNonRoot !== true && podSecurity.runAsNonRoot !== true)) {
55:         throw new Error('KUBERNETES_FIXTURE_CONTAINER_SECURITY_INVALID');
56:     }
57:     const capabilities = object(security.capabilities ?? {}, 'container.capabilities');
58:     if (!Array.isArray(capabilities.drop) || !capabilities.drop.includes('ALL')) {
59:         throw new Error('KUBERNETES_FIXTURE_CAPABILITY_DROP_REQUIRED');
60:     }
61:     const ports = Array.isArray(container.ports) ? container.ports : [];
62:     if (ports.some((port) => {
63:         const hostPort = object(port, 'container.port').hostPort;
64:         return hostPort !== undefined && hostPort !== 0;
65:     })) {
