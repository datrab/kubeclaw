SOURCE scripts/updates/release-configuration.mjs SHA256 25913c0267162ddb0c89b36cf6c141061431bd9ead08990ff195cc9808a23fc6
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import { execFileSync } from 'node:child_process';
4: 
5: const configurationPaths = {
6:   runtime: ['charts/kubeclaw', 'charts/prism', ...['nova', 'buster', 'prism-agent', 'prism'].map(role => `my-values/${role}-values.yaml`)],
7:   ops: ['charts/ops-pod'],
8: };
9: 
10: const configurationAliases = {
11:   'charts/prism/files/config/swarm.config.json': '../../../kubeclaw/files/config/swarm.config.json',
12:   'charts/prism/files/config/swarm.schema.json': '../../../../skills/common/plugin-runtime/foundation/config/swarm.schema.json',
13:   "charts/prism/templates/_swarm-bundle.tpl": "../../kubeclaw/templates/_swarm-config.tpl",
14:   "charts/kubeclaw/files/config/swarm.schema.json": "../../../../skills/common/plugin-runtime/foundation/config/swarm.schema.json",
15:   "charts/kubeclaw/files/config/swarm-components.schema.json": "../../../../skills/common/plugin-runtime/foundation/config/swarm-components.schema.json",
16:   "charts/prism/files/config/swarm-components.schema.json": "../../../../skills/common/plugin-runtime/foundation/config/swarm-components.schema.json",
17:   "charts/prism/files/config/prism-control.config.json": "../../../kubeclaw/files/config/prism-control.config.json",
18:   "charts/prism/files/config/prism-studio.config.json": "../../../kubeclaw/files/config/prism-studio.config.json",
19:   "charts/prism/files/config/prism-worker.config.json": "../../../kubeclaw/files/config/prism-worker.config.json",
20:   "charts/prism/files/config/prism-execution.config.json": "../../../kubeclaw/files/config/prism-execution.config.json",
21:   "charts/prism/files/config/buster-engine.config.json": "../../../kubeclaw/files/config/buster-engine.config.json",
22:   "charts/prism/files/config/worker-core.config.json": "../../../kubeclaw/files/config/worker-core.config.json",
23: };
24: 
25: function assertNoLinkedAncestors(root, relative) {
26:   const parts = relative.split('/');
27:   for (let index = 1; index < parts.length; index++) {
28:     const ancestor = parts.slice(0, index).join('/');
29:     if (!fs.lstatSync(path.join(root, ancestor)).isDirectory()) throw new Error(`RELEASE_CONFIGURATION_DIRECTORY_REQUIRED: ${ancestor}`);
30:   }
31: }
32: 
33: function filesUnder(root, relative) {
34:   const stat = fs.lstatSync(path.join(root, relative));
35:   if (stat.isSymbolicLink()) {
36:     if (configurationAliases[relative] !== fs.readlinkSync(path.join(root, relative))) throw new Error(`RELEASE_CONFIGURATION_SYMLINK: ${relative}`);
37:     return [relative];
38:   }
39:   if (stat.isFile()) return [relative];
40:   if (!stat.isDirectory()) throw new Error(`RELEASE_CONFIGURATION_FILE_REQUIRED: ${relative}`);
41:   return fs.readdirSync(path.join(root, relative)).flatMap(name => filesUnder(root, `${relative}/${name}`));
42: }
43: 
44: function sourceAliasTargets(entries, readEntries, git) {
45:   const targets = [];
46:   for (const entry of entries) {
47:     if (entry.mode !== '120000') continue;
48:     const target = configurationAliases[entry.name];
49:     if (!target || git(['cat-file', 'blob', entry.digest]) !== target) throw new Error(`RELEASE_CONFIGURATION_SOURCE_FILE_INVALID: ${entry.name}`);
50:     const canonical = path.posix.normalize(path.posix.join(path.posix.dirname(entry.name), target));
51:     const source = readEntries([canonical]);
52:     if (source.length !== 1 || source[0].name !== canonical || source[0].mode === '120000') throw new Error(`RELEASE_CONFIGURATION_SOURCE_FILE_INVALID: ${canonical}`);
53:     targets.push(source[0]);
54:   }
55:   return targets;
56: }
57: 
58: function verifyWorkingFiles(root, entries, git) {
59:   for (const { name, digest, mode } of entries) {
60:     assertNoLinkedAncestors(root, name);
61:     const stat = fs.lstatSync(path.join(root, name));
62:     if (mode === '120000') {
63:       if (!stat.isSymbolicLink() || fs.readlinkSync(path.join(root, name)) !== configurationAliases[name]) throw new Error(`RELEASE_CONFIGURATION_ALIAS_CHANGED: ${name}`);
64:       continue;
65:     }
66:     if (!stat.isFile()) throw new Error(`RELEASE_CONFIGURATION_FILE_REQUIRED: ${name}`);
67:     const actual = git(['hash-object', '--no-filters', '--', name]).trim();
68:     if (actual !== digest) throw new Error(`RELEASE_CONFIGURATION_CHANGED: ${name}; select a successful image build using this configuration`);
69:   }
70: }
71: 
72: // The preserved image receipt supplies the source commit. Identical configuration
73: // bytes may survive later unrelated commits; unqualified chart/value drift may not.
74: export function verifyReleaseConfiguration(root, commit, family) {
75:   if (!/^[a-f0-9]{40}$/u.test(commit) || !configurationPaths[family]) throw new Error('RELEASE_CONFIGURATION_IDENTITY_INVALID');
76:   const git = args => execFileSync('git', ['-C', root, ...args], { encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
77:   const top = git(['rev-parse', '--show-toplevel']).trim();
78:   if (fs.realpathSync(top) !== fs.realpathSync(root)) throw new Error('RELEASE_CONFIGURATION_REPOSITORY_ROOT_REQUIRED');
79:   const readEntries = paths => git(['ls-tree', '-rz', commit, '--', ...paths])
80:     .split('\0').filter(Boolean).map(record => {
81:       const separator = record.indexOf('\t');
82:       const [mode, type, digest] = record.slice(0, separator).split(' ');
83:       const name = record.slice(separator + 1);
84:       if (type !== 'blob' || !['100644', '100755', '120000'].includes(mode)) throw new Error(`RELEASE_CONFIGURATION_SOURCE_FILE_INVALID: ${name}`);
85:       return { name, digest, mode };
86:     });
87:   const entries = readEntries(configurationPaths[family]);
88:   const targets = sourceAliasTargets(entries, readEntries, git);
89:   for (const relative of configurationPaths[family]) assertNoLinkedAncestors(root, relative);
90:   const names = configurationPaths[family].flatMap(relative => filesUnder(root, relative)).sort();
91:   const expected = entries.map(entry => entry.name).sort();
92:   if (JSON.stringify(names) !== JSON.stringify(expected)) throw new Error('RELEASE_CONFIGURATION_FILESET_CHANGED');
93:   verifyWorkingFiles(root, [...entries, ...targets], git);
94:   return { sourceCommit: commit, paths: configurationPaths[family] };
95: }

SOURCE skills/buster/engine/remote-plan-cli.ts SHA256 2f5e47619915feede36cf8909c860b9cd7e4dd4378eeaf2f9b8b72a61a8d5670
1: #!/usr/bin/env node
2: import path from 'node:path';
3: import { Socket } from 'node:net';
4: import { NativeWorkerControlChannel } from '@kubeclaw/worker-core';
5: import { loadSwarmSettings } from '../../common/plugin-runtime/foundation/config/swarm.ts';
6: import { preparationSourceRoot } from './test-gates/preparation-config.ts';
7: import { BusterPreparationClient } from './test-gates/preparation-client.ts';
8: import { preparationServiceChannelLimits } from './test-gates/preparation-channel.ts';
9: import process from 'node:process';
10: import { loadProductionBusterRemotePlanRuntime } from './test-gates/production.ts';
11: 
12: function configArgument(values: readonly string[]): string {
13:   if (values.length !== 2 || values[0] !== '--config' || !values[1]) {
14:     throw new Error('Usage: remote-plan-cli --config <buster-runtime.json>');
15:   }
16:   return path.resolve(values[1]);
17: }
18: 
19: try {
20:   if (process.getuid?.() !== 1000 || process.getgid?.() !== 1000) throw new Error('BUSTER_SERVICE_IDENTITY_REQUIRED');
21:   const snapshot = loadSwarmSettings(process.env);
22:   const settings = snapshot.buster;
23:   const client = new BusterPreparationClient(new NativeWorkerControlChannel(
24:     new Socket({ fd: 3, readable: true, writable: true, allowHalfOpen: true }),
25:     preparationServiceChannelLimits(settings.preparation)), settings.preparation, preparationSourceRoot);
26:   const runtime = loadProductionBusterRemotePlanRuntime(configArgument(process.argv.slice(2)), client, settings, snapshot.workerCore.localRuntime, process.env);
27:   const address = await runtime.start();
28:   process.stdout.write(`${JSON.stringify({ schemaVersion: 'buster-remote-runtime-ready.v1',
29:     host: address.address, port: address.port })}\n`);
30:   try {
31:     await Promise.race([client.disconnected(), new Promise<void>((resolve) => {
32:       const stop = (): void => resolve();
33:       process.once('SIGINT', stop);
34:       process.once('SIGTERM', stop);
35:     })]);
36:   } finally {
37:     try { await runtime.stop(); } finally { await client.close(); }
38:   }
39: } catch (error) {
40:   process.stderr.write(`${JSON.stringify({ status: 'error', error: error instanceof Error ? error.message : String(error) })}\n`);
41:   process.exitCode = 1;
42: }

SOURCE skills/buster/engine/test-gates/buildkit-readiness.ts SHA256 7f50b4c1c6c1e661319dd2f9ba1afecf27dd19a26c06ac51ef52abc0d97703f3
1: import { runDependencyProcess, validateDependencyProcessLimits, type DependencyProcessResult } from './dependency-process.ts';
2: 
3: export interface BuildkitReadinessOptions {
4:   readonly buildctlExecutable: string;
5:   readonly buildkitHost: string;
6:   readonly maximumExecutionMs: number;
7:   readonly maximumOutputBytes: number;
8: }
9: 
10: /** One current native check shared by concurrent callers; no completed result cache. */
11: export class BuildkitReadiness {
12:   readonly #options: BuildkitReadinessOptions;
13:   #lastCode: DependencyProcessResult['code'] | undefined;
14:   #checking: Promise<DependencyProcessResult> | undefined;
15:   readonly #cancellation = new AbortController();
16: 
17:   constructor(options: BuildkitReadinessOptions) {
18:     if (!options.buildctlExecutable.startsWith('/') || /[\0\r\n]/u.test(options.buildctlExecutable) || !options.buildkitHost || /[\0\r\n]/u.test(options.buildkitHost)) {
19:       throw new Error('BUSTER_READINESS_BUILDKIT_CONFIG_INVALID');
20:     }
21:     validateDependencyProcessLimits(options);
22:     this.#options = { ...options };
23:   }
24: 
25:   async shutdown(): Promise<void> {
26:     this.#cancellation.abort();
27:     await this.#checking;
28:   }
29: 
30:   check(): Promise<DependencyProcessResult> {
31:     this.#checking ??= runDependencyProcess({ executable: this.#options.buildctlExecutable,
32:       signal: this.#cancellation.signal,
33:       args: ['--addr', this.#options.buildkitHost, 'debug', 'workers'],
34:       maximumExecutionMs: this.#options.maximumExecutionMs, maximumOutputBytes: this.#options.maximumOutputBytes,
35:     }).then(result => {
36:       if (result.code !== this.#lastCode) {
37:         this.#lastCode = result.code;
38:         process.stderr.write(JSON.stringify({ event: 'buster.dependency-readiness', dependency: 'buildkit', ...result }) + '\n');
39:       }
40:       return result;
41:     }).finally(() => { this.#checking = undefined; });
42:     return this.#checking;
43:   }
44: }

