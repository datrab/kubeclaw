73: function configuredCapabilities(sources: ReturnType<typeof capabilitySources>, directory: string, environment: NodeJS.ProcessEnv,
74:   policy: BusterClusterInvokerSettings, bindingSource: unknown) {
75:   const {
76:     directCommandSource, containerBuildSource,
77:     networkHttpSource, browserAxeSource, browserLighthouseSource, browserVisualSource,
78:     browserPlaywrightSource, securityScanSource,
79:     directCommandCgroup, allowSampledProcessLimit, registryUsername, registryPassword, browserPlaywrightCgroup,
80:   } = sources;
81:   return {
82:     ...directCommandOptions(directCommandSource, directory, directCommandCgroup, allowSampledProcessLimit),
83:     ...containerBuildOptions(containerBuildSource, directory, registryUsername, registryPassword),
84:     ...configuredClusterCapabilities(sources, policy, bindingSource),
85:     ...networkHttpOptions(networkHttpSource, containerBuildSource, registryUsername, registryPassword),
86:     ...browserAxeOptions(browserAxeSource),
87:     ...browserLighthouseOptions(browserLighthouseSource),
88:     ...browserVisualOptions(browserVisualSource),
89:     ...browserPlaywrightOptions(browserPlaywrightSource, directory, browserPlaywrightCgroup),
90:     ...securityScanOptions(securityScanSource, directory, environment),
91:   };
