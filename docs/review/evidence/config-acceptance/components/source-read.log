11: export interface NativeWorkerOwnershipOptions {
12:   readonly cgroupRoot: string;
13:   readonly store: FileWorkerOwnershipStore;
14:   readonly nodeIdentity: string;
15:   readonly drainTimeoutMs: number;
16:   readonly maximumActiveScopes: number;
17:   readonly poolLimits: NativeWorkerPoolLimits;
18: }
19: 
20: /** Constructed by supervisor policy code, never deserialized from a worker request. */
21: export interface NativeWorkerLaunchCommand {
22:   readonly uid: number;
23:   readonly gid: number;
24:   readonly executable: string;
25:   readonly arguments: readonly string[];
26:   readonly cwd: string;
27:   readonly environment: NodeJS.ProcessEnv;
28:   readonly resourceLimits?: NativeWorkerScopeLimits;
29: }
30: 
31: export interface NativeWorkerLaunchAuthority {
32:   readonly launch: (command: NativeWorkerLaunchCommand) => Promise<ChildProcessWithoutNullStreams>;
33: }
34: 
35: function terminal(record: WorkerOwnershipRecord): boolean {
36:   return record.phase === 'disposed' || record.phase === 'abandoned';
37: }
38: 
39: function diagnosis(error: unknown): string {
40:   return (error instanceof Error ? error.message : String(error)).slice(0, 4096).toWellFormed() || 'WORKER_NATIVE_UNKNOWN_FAILURE';
41: }
42: 
43: /** A lease is available only after its reservation and native identity are durable. */
44: export class NativeWorkerOwnershipLease {
45:   readonly #scope: NativeWorkerResourceScope;
46:   readonly #options: NativeWorkerOwnershipOptions;
47:   readonly #settled: (failed: boolean) => void;
48:   #record: WorkerOwnershipRecord;
49:   #started = false;
50:   #closing = false;
51:   #launch: Promise<ChildProcessWithoutNullStreams> | undefined;
52:   #completion: Promise<NativeWorkerResourceObservation> | undefined;
53:   #launcher: string | undefined;
54:   #childLaunches: Promise<unknown> = Promise.resolve();
55:   readonly #launchers = new NativeProcessLaunches();
56: 
57:   constructor(scope: NativeWorkerResourceScope, record: WorkerOwnershipRecord, options: NativeWorkerOwnershipOptions,
58:     settled: (failed: boolean) => void = () => {}) {
59:     this.#scope = scope;
60:     this.#record = record;
61:     this.#options = options;
62:     this.#settled = settled;
63:   }
64: 
65:   /** Spawn is inside the launch fence; callers never receive a reusable admission path. */
66:   launch(command: NativeWorkerLaunchCommand & { readonly launcher: string }, controlPipe = false): Promise<ChildProcessWithoutNullStreams> {
67:     if (this.#record.topology.kind !== 'aggregate.v1') return Promise.reject(new Error('WORKER_OWNERSHIP_LEGACY_LAUNCH_FORBIDDEN'));
68:     if (this.#started || this.#closing) return Promise.reject(new Error('WORKER_NATIVE_LAUNCH_FENCED'));
69:     const input = structuredClone(command);
70:     this.#launcher = input.launcher;
71:     this.#started = true;
72:     this.#launch = this.#options.store.transition(this.#record, 'running').then(async record => {
73:       this.#record = record;
74:       if (this.#closing) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
75:       return this.#startChild('host', input, controlPipe);
76:     });
77:     return this.#launch;
78:   }
79: 
80:   /** Only trusted supervisor callbacks receive this capability. No scope path crosses IPC. */
81:   launchAuthority(): NativeWorkerLaunchAuthority {
82:     return Object.freeze({ launch: async (command: NativeWorkerLaunchCommand) => {
83:       const input = structuredClone(command);
84:       if (this.#closing || !this.#started || !this.#launch) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
85:       await this.#launch;
86:       if (this.#closing || this.#record.phase !== 'running') throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
87:       const pending = this.#childLaunches.then(() => this.#startChild(`helper-${randomUUID()}`, input, false));
88:       this.#childLaunches = pending.catch(() => undefined);
89:       return pending;
90:     } });
91:   }
92: 
93:   async #startChild(name: string, command: NativeWorkerLaunchCommand, controlPipe: boolean): Promise<ChildProcessWithoutNullStreams> {
94:     if (this.#closing || !this.#launcher) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
95:     this.#scope.verifyChildren(this.#record.topology.children, false);
96:     const limits = this.#scope.childLimits(command.resourceLimits);
97:     this.#record = await this.#options.store.reserveChild(this.#record, name, limits);
98:     if (this.#closing) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
99:     const reserved = this.#record.topology.children.find(child => child.name === name)!;
100:     const binding = this.#scope.createChild(reserved);
101:     this.#record = await this.#options.store.bindChild(this.#record, name, binding);
102:     if (this.#closing) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
103:     const child = this.#record.topology.children.find(item => item.name === name)!;
104:     return this.#launchers.spawn(this.#launcher, [...this.#scope.childLaunchArguments(child), String(command.uid), String(command.gid),
105:       command.executable, ...command.arguments], { cwd: command.cwd,
106:       env: { ...command.environment, KUBECLAW_NATIVE_SUPERVISOR_PID: String(process.pid) } }, controlPipe);
107:   }
108: 
109:   observe(): NativeWorkerResourceObservation { return this.#scope.observe(); }
110: 
111:   finish(): Promise<NativeWorkerResourceObservation> {
112:     this.#closing = true;
113:     this.#completion ??= this.#finish().then(observation => {
114:       this.#settled(false);
115:       return observation;
116:     }, (error: unknown) => {
117:       this.#settled(true);
118:       throw error;
119:     });
120:     return this.#completion;
121:   }
122: 
123:   async #drainOwnedSubtree(): Promise<NativeWorkerResourceObservation> {
124:     const errors: unknown[] = [];
125:     // A pre-entry launcher failure cannot strand already entered descendants.
126:     try { await this.#launchers.drain(this.#options.drainTimeoutMs); }
127:     catch (error) { errors.push(error); }
128:     // Unknown/replaced groups are never adopted, killed or removed as owned work.
129:     this.#scope.verifyChildren(this.#record.topology.children, this.#record.phase === 'empty');
130:     try {
131:       if (this.#record.phase !== 'quiescing' && this.#record.phase !== 'empty') {
132:         const notLaunched = this.#record.phase === 'allocated' && !this.#started;
133:         this.#record = await this.#options.store.transition(this.#record, 'quiescing',
134:           notLaunched ? { diagnosis: 'WORKER_NATIVE_ALLOCATION_NOT_LAUNCHED' } : {});
135:       }
136:     } catch (error) { errors.push(error); }
137:     let observation: NativeWorkerResourceObservation | undefined;
138:     // Quota/fsync failure must not make identity-checked kernel drain unreachable.
139:     // Any failure still prevents finalization, deletion and reservation release.
140:     try { observation = await this.#scope.terminateAndDrain(this.#options.drainTimeoutMs); }
141:     catch (error) { errors.push(error); }
142:     if (errors.length === 1) throw errors[0];
143:     if (errors.length) throw new AggregateError(errors, 'WORKER_NATIVE_QUIESCENCE_INCOMPLETE');
144:     return observation!;
145:   }
146: 
147:   async #finish(): Promise<NativeWorkerResourceObservation> {
148:     // A concurrent fsync of the launch fence must settle before the terminal CAS.
149:     await this.#launch?.catch(() => undefined);
150:     await this.#childLaunches;
151:     try {
152:       const observation = await this.#drainOwnedSubtree();
153:       if (this.#record.finalObservation !== null && canonicalJson(this.#record.finalObservation) !== canonicalJson(observation)) {
154:         throw new Error('WORKER_NATIVE_TERMINAL_COUNTERS_CHANGED');
155:       }
156:       if (this.#record.phase !== 'empty' || this.#record.finalObservation === null) {
157:         // Persist the final kernel counters in the same fsynced state as the
158:         // empty phase. A crash after rmdir must not erase accounting evidence.
159:         this.#record = await this.#options.store.transition(this.#record, 'empty', { finalObservation: observation });
160:       }
161:       this.#scope.disposeChildren(this.#record.topology.children);
162:       this.#scope.dispose();
163:       this.#record = await this.#options.store.transition(this.#record, 'disposed');
164:       return observation;
165:     } catch (error) {
166:       try {
167:         if (!terminal(this.#record) && this.#record.phase !== 'unresolved' && this.#record.phase !== 'empty') {
168:           this.#record = await this.#options.store.transition(this.#record, 'unresolved', { diagnosis: diagnosis(error) });
169:         }
170:       } catch (persistenceError) {
171:         throw new AggregateError([error, persistenceError], 'WORKER_NATIVE_RECONCILIATION_RECORD_FAILED');
172:       }
173:       throw error;
174:     }
175:   }
176: }
177: 
178: /** No admission is exposed until every previous durable owner has been reconciled. */
179: export class NativeWorkerOwnership {
180:   readonly #options: NativeWorkerOwnershipOptions;
181:   readonly #leases = new Set<NativeWorkerOwnershipLease>();
182:   readonly #admitting = new Set<string>();
183:   readonly #allocations = new Set<Promise<NativeWorkerOwnershipLease>>();
184:   readonly #pool: NativeWorkerResourcePool;
185:   #closed = false;
186: 
187:   private constructor(options: NativeWorkerOwnershipOptions) {
188:     this.#options = options;
189:     this.#pool = new NativeWorkerResourcePool(options.cgroupRoot, options.poolLimits, options.maximumActiveScopes);
190:   }
191: 
192:   isReady(): boolean {
193:     if (!this.#closed) {
194:       try { this.#pool.verify(); } catch { this.#closed = true; }
195:     }
196:     return !this.#closed;
197:   }
198: 
199:   fenceAdmission(): void { this.#closed = true; }
200: 
201:   async record(identity: WorkerOwnershipIdentity): Promise<WorkerOwnershipRecord | null> {
202:     const expected = structuredClone(identity);
203:     const record = (await this.#options.store.records()).find(record => record.identity.workerId === expected.workerId
204:       && record.identity.attemptId === expected.attemptId && record.identity.generation === expected.generation);
205:     if (record && canonicalJson(record.identity) !== canonicalJson(expected)) throw new Error('WORKER_NATIVE_RECOVERY_IDENTITY_CONFLICT');
206:     return record ?? null;
207:   }
208: 
209:   static async supervise<T>(options: NativeWorkerOwnershipOptions,
210:     operation: (owner: NativeWorkerOwnership) => Promise<T>): Promise<T> {
211:     if (!Number.isSafeInteger(options.drainTimeoutMs) || options.drainTimeoutMs < 1) {
212:       throw new Error('WORKER_NATIVE_DRAIN_LIMIT_INVALID');
213:     }
214:     if (!Number.isSafeInteger(options.maximumActiveScopes) || options.maximumActiveScopes < 1) {
215:       throw new Error('WORKER_NATIVE_CAPACITY_INVALID');
216:     }
217:     const captured = { ...options, poolLimits: { ...options.poolLimits }, cgroupRoot: fs.realpathSync(options.cgroupRoot) };
218:     return captured.store.withSupervisor(async () => {
219:       const owner = new NativeWorkerOwnership(captured);
220:       await owner.#recover();
221:       let result: T | undefined;
222:       const errors: unknown[] = [];
223:       try { result = await operation(owner); } catch (error) { errors.push(error); }
224:       owner.#closed = true;
225:       await Promise.allSettled(owner.#allocations);
226:       const closed = await Promise.allSettled([...owner.#leases].map(lease => lease.finish()));
227:       for (const close of closed) if (close.status === 'rejected') errors.push(close.reason);
228:       if (errors.length) throw new AggregateError(errors, 'WORKER_NATIVE_SUPERVISOR_UNRESOLVED');
229:       return result as T;
230:     });
231:   }
232: 
233:   allocate(identity: WorkerOwnershipIdentity, limits: NativeWorkerScopeLimits): Promise<NativeWorkerOwnershipLease> {
234:     const operation = this.#allocate(identity, limits);
235:     this.#allocations.add(operation);
236:     void operation.then(() => this.#allocations.delete(operation), () => this.#allocations.delete(operation));
237:     return operation;
238:   }
239: 
240:   async #allocate(identity: WorkerOwnershipIdentity, limits: NativeWorkerScopeLimits): Promise<NativeWorkerOwnershipLease> {
241:     const captured = structuredClone(identity);
242:     const requested = { ...limits };
243:     const key = JSON.stringify([captured.workerId, captured.attemptId]);
244:     if (this.#closed || this.#admitting.has(key)) throw new Error('WORKER_NATIVE_ADMISSION_FENCED');
245:     const releaseCapacity = this.#pool.reserve(requested);
246:     this.#admitting.add(key);
247:     let record: WorkerOwnershipRecord | undefined;
248:     try {
249:       record = await this.#options.store.reserve(captured);
250:       if (record.phase !== 'reserved' || record.topology.kind !== 'aggregate.v1') throw new Error('WORKER_NATIVE_IDENTITY_ALREADY_USED');
251:       const scope = NativeWorkerResourceScope.createReserved(this.#options.cgroupRoot, record.scopeName, requested);
252:       record = await this.#options.store.transition(record, 'allocated', { binding: scope.binding() });
253:       const lease = new NativeWorkerOwnershipLease(scope, record, this.#options, failed => {
254:         if (failed) this.#closed = true;
255:         else { this.#leases.delete(lease); releaseCapacity(); }
256:       });
257:       this.#leases.add(lease);
258:       if (this.#closed) {
259:         await lease.finish();
260:         throw new Error('WORKER_NATIVE_ADMISSION_FENCED');
261:       }
262:       return lease;
263:     } catch (error) {
264:       // A reservation without a committed binding can never have launched work.
265:       // Keep it recoverable; never reuse its name or infer completion from failure.
266:       if (record?.phase === 'reserved') this.#closed = true;
267:       // Only a confirmed unused identity may return its reservation here. Once
268:       // allocated, the lease releases it after durable quiescence and disposal.
269:       if (!record || record.phase !== 'allocated') releaseCapacity();
270:       throw error;
271:     } finally { this.#admitting.delete(key); }
272:   }
273: 
274:   async #recover(): Promise<void> {
275:     const records = await this.#options.store.records();
276:     const names = new Set(NativeWorkerResourceScope.inventory(this.#options.cgroupRoot));
277:     const registered = new Set(records.map(record => record.scopeName));
278:     if ([...names].some(name => !registered.has(name))) throw new Error('WORKER_NATIVE_UNKNOWN_SCOPE');
279:     const currentBoot = fs.readFileSync('/proc/sys/kernel/random/boot_id', 'utf8').trim();
280:     // A PVC can move between machines. A different boot ID alone cannot prove
281:     // that processes on the previous machine have stopped.
282:     await this.#options.store.bindHostIdentity(this.#options.nodeIdentity, currentBoot);
283:     for (const record of records) await this.#recoverRecord(record, names, currentBoot);
284:   }
285: 
286:   async #recoverRecord(record: WorkerOwnershipRecord, names: ReadonlySet<string>, currentBoot: string): Promise<void> {
287:     const exists = names.has(record.scopeName);
288:     if (terminal(record)) {
289:       if (exists) throw new Error('WORKER_NATIVE_RETIRED_SCOPE_REAPPEARED');
290:       return;
291:     }
292:     if (!exists && record.phase === 'empty') {
293:       await this.#options.store.transition(record, 'disposed');
294:       return;
295:     }
296:     if (!exists && (!record.binding || record.binding.bootId !== currentBoot)) {
297:       await this.#options.store.transition(record, 'abandoned', {
298:         diagnosis: record.binding ? 'WORKER_NATIVE_BOOT_CHANGED_RESULT_UNAVAILABLE' : 'WORKER_NATIVE_RESERVATION_NOT_LAUNCHED',
299:       });
300:       return;
301:     }
302:     if (!exists) throw new Error('WORKER_NATIVE_OWNED_SCOPE_MISSING');
303:     let scope: NativeWorkerResourceScope;
304:     if (record.phase === 'reserved') {
305:       scope = NativeWorkerResourceScope.recoverEmptyReservation(this.#options.cgroupRoot, record.scopeName, record.topology.kind === 'aggregate.v1');
306:       record = await this.#options.store.transition(record, 'allocated', { binding: scope.binding() });
307:     } else {
308:       if (!record.binding) throw new Error('WORKER_NATIVE_UNBOUND_SCOPE_UNRESOLVED');
309:       scope = NativeWorkerResourceScope.reopen(this.#options.cgroupRoot, record.binding, record.topology.kind === 'aggregate.v1');
310:     }
311:     await new NativeWorkerOwnershipLease(scope, record, this.#options).finish();
312:   }
313: }

SOURCE skills/worker/core/worker/native-worker-process.ts SHA256 230bcb2eae21abc5d87187d682504155ef131a649b05f6662fb0d7a6db575182
1: import type { ChildProcessWithoutNullStreams } from 'node:child_process';
2: import type { NativeWorkerOwnership, NativeWorkerOwnershipLease } from './native-worker-ownership.ts';
3: import type { WorkerOwnershipIdentity } from './ownership-store.ts';
4: import type { NativeWorkerResourceObservation } from './native-resource-observation.ts';
5: import type { NativeWorkerOutputCapture } from './native-output-spool.ts';
6: import { cancelNativeProcess } from './native-process-cancellation.ts';
7: import { captureNativeWorkerOutput } from './native-process-output.ts';
8: import { validateNativeWorkerControlLimits } from './native-control-channel.ts';
9: import { startNativeProcessControl, type NativeWorkerProcessControl } from './native-process-control.ts';
10: 
11: export interface NativeWorkerProcessLimits {
12:   readonly cpuTimeMs: number;
13:   readonly memoryBytes: number;
14:   readonly tasks: number;
15:   readonly timeoutMs: number;
16:   readonly pollIntervalMs: number;
17:   readonly maximumInputBytes: number;
18:   readonly maximumOutputBytes: number;
19:   readonly closeTimeoutMs: number;
20: }
21: 
22: export interface NativeWorkerProcessOptions {
23:   readonly owner: NativeWorkerOwnership;
24:   readonly identity: WorkerOwnershipIdentity;
25:   readonly limits: NativeWorkerProcessLimits;
26:   readonly command: Parameters<NativeWorkerOwnershipLease['launch']>[0];
27:   readonly input: Uint8Array;
28:   readonly signal?: AbortSignal;
29:   readonly outputCapture?: NativeWorkerOutputCapture;
30:   readonly control?: NativeWorkerProcessControl;
31: }
32: 
33: export interface NativeWorkerProcessResult {
34:   readonly schemaVersion: 'worker-native-process-result.v1';
35:   readonly stdout: Uint8Array;
36:   readonly stderr: Uint8Array;
37:   readonly exitCode: number | null;
38:   readonly signal: string | null;
39:   readonly fault: string | null;
40:   readonly resources: NativeWorkerResourceObservation;
41: }
42: 
43: function validateLimits(limits: NativeWorkerProcessLimits): void {
44:   if (Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1)) {
45:     throw new Error('WORKER_NATIVE_PROCESS_LIMIT_INVALID');
46:   }
47:   for (const value of [limits.timeoutMs, limits.pollIntervalMs, limits.closeTimeoutMs]) {
48:     if (value > 2_147_483_647) throw new Error('WORKER_NATIVE_PROCESS_TIMER_INVALID');
49:   }
50: }
51: 
52: function budgetFault(observation: NativeWorkerResourceObservation, limits: NativeWorkerProcessLimits): string | null {
53:   if (observation.oomKills || observation.maximumMemoryBytes > limits.memoryBytes) return 'WORKER_MEMORY_LIMIT';
54:   if (observation.taskLimitHits || observation.maximumTasks > limits.tasks) return 'WORKER_TASK_LIMIT';
55:   if (observation.cpuTimeMicroseconds / 1000 > limits.cpuTimeMs) return 'WORKER_CPU_LIMIT';
56:   return null;
57: }
58: 
59: /** Entire trusted attempt host, including its completion I/O and every descendant. */
60: export async function runNativeWorkerProcess(options: NativeWorkerProcessOptions): Promise<NativeWorkerProcessResult> {
61:   const limits = { ...options.limits };
62:   const control = options.control ? { limits: { ...options.control.limits }, run: options.control.run } : undefined;
63:   validateLimits(limits);
64:   if (control) {
65:     validateNativeWorkerControlLimits(control.limits);
66:     if (typeof control.run !== 'function') throw new Error('WORKER_NATIVE_CONTROL_CONFIG_INVALID');
67:   }
68:   if (options.input.byteLength > limits.maximumInputBytes) throw new Error('WORKER_NATIVE_INPUT_LIMIT');
69:   const input = Buffer.from(options.input);
70:   const command = structuredClone(options.command);
71:   options.signal?.throwIfAborted();
72:   const lease = await options.owner.allocate(options.identity, { memoryBytes: limits.memoryBytes, tasks: limits.tasks });
73:   let child: ChildProcessWithoutNullStreams | undefined;
74:   try {
75:     options.signal?.throwIfAborted();
76:     child = await lease.launch(command, control !== undefined);
77:     return await collectProcess(child, lease, input, limits, options.signal, options.outputCapture, control);
78:   } finally {
79:     // Also stop a launcher interrupted before joining; it has no authority to start later.
80:     child?.kill('SIGKILL');
81:     await lease.finish();
82:   }
83: }
84: 
85: async function collectProcess(child: ChildProcessWithoutNullStreams, lease: NativeWorkerOwnershipLease,
86:   input: Buffer, limits: NativeWorkerProcessLimits, signal?: AbortSignal, outputCapture?: NativeWorkerOutputCapture,
87:   controlOptions?: NativeWorkerProcessControl): Promise<NativeWorkerProcessResult> {
88:   let fault: string | null = null;
89:   let closeTimer: NodeJS.Timeout | undefined;
90:   let closing: Promise<NativeWorkerResourceObservation> | undefined;
91:   let finish: () => void = () => {};
92:   const close = () => {
93:     child.kill('SIGKILL');
94:     closing ??= lease.finish();
95:     // The caller always observes this rejection after the child boundary settles.
96:     void closing.catch(() => {});
97:     closeTimer ??= setTimeout(() => {
98:       fault = 'WORKER_NATIVE_PROCESS_DRAIN_TIMEOUT';
99:       finish();
100:     }, limits.closeTimeoutMs);
101:   };
102:   const exited = new Promise<void>(resolve => { finish = resolve; });
103:   const stop = (code: string) => {
104:     fault ??= code;
105:     close();
106:   };
107:   const output = captureNativeWorkerOutput(child, limits.maximumOutputBytes, stop, outputCapture);
108:   const control = startNativeProcessControl(child, controlOptions, stop, limits.closeTimeoutMs, lease.launchAuthority());
109:   let disposeCancellation: (() => void) | undefined;
110:   const abort = () => {
111:     if (closing || disposeCancellation) return;
112:     fault ??= 'WORKER_ATTEMPT_CANCELLED';
113:     disposeCancellation = cancelNativeProcess(child, limits.closeTimeoutMs, close);
114:   };
115:   child.once('error', () => stop('WORKER_NATIVE_PROCESS_START_FAILED'));
116:   child.stdin.once('error', () => stop('WORKER_NATIVE_PROCESS_INPUT_FAILED'));
117:   child.once('exit', () => { close(); });
118:   child.once('close', finish);
119:   signal?.addEventListener('abort', abort, { once: true });
120:   const deadline = setTimeout(() => stop('WORKER_ATTEMPT_TIMEOUT'), limits.timeoutMs);
121:   const poll = setInterval(() => {
122:     if (closing) return;
123:     try { const code = budgetFault(lease.observe(), limits); if (code) stop(code); }
124:     catch { stop('WORKER_RESOURCE_MEASUREMENT_UNAVAILABLE'); }
125:   }, limits.pollIntervalMs);
126:   try {
127:     if (signal?.aborted) abort();
128:     else child.stdin.end(input);
129:     await exited;
130:     close();
131:     const resources = await closing!;
132:     await output.flush();
133:     await control.finish();
134:     fault ??= budgetFault(resources, limits);
135:     if (child.exitCode !== 0 && fault === null) fault = 'WORKER_NATIVE_PROCESS_FAILED';
136:     return { schemaVersion: 'worker-native-process-result.v1', ...output.snapshot(),
137:       exitCode: child.exitCode, signal: child.signalCode, fault, resources };
138:   } finally {
139:     clearTimeout(deadline); clearInterval(poll); if (closeTimer) clearTimeout(closeTimer);
140:     signal?.removeEventListener('abort', abort);
141:     disposeCancellation?.();
142:     child.stdin.destroy(); child.stdout.destroy(); child.stderr.destroy();
143:     await control.finish();
144:   }
145: }

SOURCE skills/prism/control/pipeline-preference-subject.ts SHA256 ded8597750c0e6fb3de823cceb31ecbbff7ece03143f4cdd30037ceff0a77eb3
1: /** The configured value is platform-owned, unlike a Nova project/stage request. */
2: export function authorizePipelinePreferenceSubject(requested: unknown, configured: unknown): string | null {
3:   if (configured !== undefined && (typeof configured !== 'string' || !/^user-[a-f0-9]{24}$/u.test(configured))) {
4:     throw new Error('invalid platform pipeline preference subject');
5:   }
6:   if (requested === undefined) return typeof configured === "string" ? configured : null;
7:   if (typeof requested !== 'string' || requested !== configured) {
8:     throw new Error('pipeline preference subject is not authorized by platform configuration');
9:   }
10:   return requested;
11: }
