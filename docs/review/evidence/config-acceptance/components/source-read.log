39: function busterWorkerSummary(value: string): string {
40:   const mapped: Record<string, string> = {
41:     WORKER_ATTEMPT_CANCELLED: "TEST_PROVIDER_CANCELLED",
42:     WORKER_ATTEMPT_TIMEOUT: "TEST_PROVIDER_TIMEOUT",
43:     WORKER_CPU_LIMIT: "TEST_PROVIDER_CPU_LIMIT",
44:     WORKER_LOG_LIMIT: "TEST_PROVIDER_LOG_LIMIT",
45:     WORKER_MEMORY_LIMIT: "TEST_PROVIDER_MEMORY_LIMIT",
46:     WORKER_PROCESS_LIMIT: "TEST_PROVIDER_PROCESS_LIMIT",
47:   };
