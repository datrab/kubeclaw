10: type JsonObject = Record<string, unknown>;
11: 
12: export interface KubernetesRuntimeSecurityCapabilityInvokerOptions extends BusterRuntimeSecuritySettings {
13:   readonly workspaceRoot: string;
14:   readonly kubectlExecutable: string;
15:   readonly controllerNamespace: string;
16:   readonly leaseApiGroup: string;
17: }
18: 
19: function capturedOptions(options: KubernetesRuntimeSecurityCapabilityInvokerOptions): BusterRuntimeSecuritySettings {
20:   const { workspaceRoot, kubectlExecutable, controllerNamespace, leaseApiGroup, ...settings } = options;
21:   const policy = validateBusterRuntimeSecuritySettings(settings);
22:   if (typeof workspaceRoot !== 'string' || workspaceRoot.length === 0
23:     || typeof kubectlExecutable !== 'string' || kubectlExecutable.length === 0
24:     || typeof controllerNamespace !== 'string' || !/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/u.test(controllerNamespace)
25:     || typeof leaseApiGroup !== 'string' || !/^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/u.test(leaseApiGroup)) {
26:     throw new Error('KUBERNETES_RUNTIME_SECURITY_CONFIG_INVALID');
27:   }
28:   return policy;
29: }
30: 
31: function object(value: unknown, code = 'KUBERNETES_RUNTIME_SECURITY_RESPONSE_INVALID'): JsonObject {
32:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error(code);
33:   return value as JsonObject;
34: }
35: 
36: function text(value: unknown, label: string, maximum = 2048): string {
37:   if (typeof value !== 'string' || value.length < 1 || value.length > maximum) {
38:     throw new Error(`KUBERNETES_RUNTIME_SECURITY_REQUEST_INVALID:${label}`);
39:   }
40:   return value;
41: }
42: 
43: function canonicalJson(value: unknown): string {
44:   const normalized = (entry: unknown): unknown => {
45:     if (Array.isArray(entry)) return entry.map(normalized);
46:     if (entry && typeof entry === 'object') return Object.fromEntries(Object.entries(entry as JsonObject)
47:       .sort(([left], [right]) => left.localeCompare(right)).map(([key, item]) => [key, normalized(item)]));
48:     return entry;
49:   };
50:   return JSON.stringify(normalized(value));
51: }
52: 
53: export function runtimeSecurityResultDigest(snapshot: JsonObject): string {
54:   const payload = { findings: snapshot.findings, omittedFindingCount: snapshot.omittedFindingCount,
55:     podCount: snapshot.podCount, serviceCount: snapshot.serviceCount,
56:     totalFindingCount: snapshot.totalFindingCount };
57:   return `sha256:${crypto.createHash('sha256').update(canonicalJson(payload)).digest('hex')}`;
58: }
59: 
60: export function runtimeSecurityObservationHasValidAccounting(snapshot: JsonObject): boolean {
61:   if (!Array.isArray(snapshot.findings) || !Number.isSafeInteger(snapshot.totalFindingCount)
62:     || Number(snapshot.totalFindingCount) < 0 || !Number.isSafeInteger(snapshot.omittedFindingCount)
63:     || Number(snapshot.omittedFindingCount) < 0) return false;
64:   const total = Number(snapshot.totalFindingCount); const omitted = Number(snapshot.omittedFindingCount);
65:   if (omitted === 0) return total === snapshot.findings.length;
66:   const overflow = snapshot.findings.at(-1);
67:   return snapshot.findings.length > 0 && total - omitted === snapshot.findings.length - 1
68:     && Boolean(overflow && typeof overflow === 'object' && !Array.isArray(overflow)
69:       && (overflow as JsonObject).id === 'runtime:findings:overflow'
70:       && (overflow as JsonObject).severity === 'critical');
71: }
72: 
73: export function containedRuntimeSecurityManifest(root: string, value: unknown): string {
74:   const requested = text(value, 'manifestPath', 4096);
75:   const resolved = fs.realpathSync(path.isAbsolute(requested) ? requested : path.resolve(root, requested));
76:   if (!fs.statSync(resolved).isFile() || (resolved !== root && !resolved.startsWith(`${root}${path.sep}`))) {
77:     throw new Error('KUBERNETES_RUNTIME_SECURITY_PATH_DENIED');
78:   }
79:   return resolved;
80: }
81: 
82: async function kubectl(executable: string, args: readonly string[], timeoutMs: number, policy: BusterRuntimeSecuritySettings,
83:   signal: AbortSignal): Promise<Buffer> {
84:   return await new Promise<Buffer>((resolve, reject) => {
85:     const controller = new AbortController();
86:     const combined = AbortSignal.any([signal, controller.signal]);
87:     const child = spawn(executable, [...args], { signal: combined, stdio: ['ignore', 'pipe', 'pipe'],
88:       env: { PATH: policy.executableSearchPath.join(path.delimiter), ...kubernetesCredentialEnvironment(), LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' } });
89:     const stdout: Buffer[] = []; const stderr: Buffer[] = []; let bytes = 0; let settled = false;
90:     const timer = setTimeout(() => controller.abort(), timeoutMs);
91:     const finish = (error?: Error, output?: Buffer): void => {
92:       if (settled) return; settled = true; clearTimeout(timer); error ? reject(error) : resolve(output!);
93:     };
94:     const collect = (target: Buffer[]) => (chunk: Buffer): void => {
95:       bytes += chunk.byteLength;
96:       if (bytes > policy.maximumOutputBytes) { finish(new Error('KUBERNETES_RUNTIME_SECURITY_OUTPUT_LIMIT_EXCEEDED')); controller.abort(); }
97:       else target.push(Buffer.from(chunk));
98:     };
99:     child.stdout.on('data', collect(stdout)); child.stderr.on('data', collect(stderr));
100:     child.on('error', (error) => finish(signal.aborted ? new Error('KUBERNETES_RUNTIME_SECURITY_CANCELLED')
101:       : controller.signal.aborted ? new Error('KUBERNETES_RUNTIME_SECURITY_TIMEOUT')
102:         : new Error('KUBERNETES_RUNTIME_SECURITY_EXECUTION_FAILED', { cause: error })));
103:     child.on('close', (code, childSignal) => {
104:       if (settled) return;
105:       if (signal.aborted) return finish(new Error('KUBERNETES_RUNTIME_SECURITY_CANCELLED'));
106:       if (controller.signal.aborted) return finish(new Error('KUBERNETES_RUNTIME_SECURITY_TIMEOUT'));
107:       if (code !== 0 || childSignal) return finish(new Error(`KUBERNETES_RUNTIME_SECURITY_EXECUTION_FAILED:${Buffer.concat(stderr).toString('utf8').slice(0, policy.diagnosticCodeUnits)}`));
108:       finish(undefined, Buffer.concat(stdout));
109:     });
110:   });
111: }
112: 
113: function runtimeSecuritySnapshot(lease: JsonObject, namespace: string): JsonObject | null {
114:   const status = object(lease.status);
115:   if (status.namespaceName !== namespace || object(lease.spec).namespaceName !== namespace) {
116:     throw new Error('KUBERNETES_RUNTIME_SECURITY_LEASE_MISMATCH');
117:   }
118:   return status.runtimeSecurity && typeof status.runtimeSecurity === 'object'
119:     && !Array.isArray(status.runtimeSecurity) ? object(status.runtimeSecurity) : null;
120: }
121: 
122: function observationMatches(snapshot: JsonObject | null, digest: string, immutableImage: string,
123:   policy: BusterRuntimeSecuritySettings): snapshot is JsonObject {
124:   return snapshot?.phase === 'Observed' && snapshot.manifestDigest === digest
125:     && snapshot.immutableImage === immutableImage && Array.isArray(snapshot.findings)
126:     && Number.isSafeInteger(snapshot.podCount) && Number(snapshot.podCount) > 0
127:     && Number.isSafeInteger(snapshot.serviceCount) && Number(snapshot.serviceCount) > 0
128:     && runtimeSecurityObservationHasValidAccounting(snapshot)
129:     && runtimeSecurityObservationIsFresh(snapshot.observedAt, Date.now(), policy.maximumObservationAgeMs, policy.maximumFutureSkewMs)
130:     && typeof snapshot.resultDigest === 'string' && /^sha256:[a-f0-9]{64}$/u.test(snapshot.resultDigest);
131: }
132: 
133: export class KubernetesRuntimeSecurityCapabilityInvoker implements TestProviderCapabilityInvoker {
134:   readonly #root: string; readonly #kubectl: string; readonly #controllerNamespace: string;
135:   readonly #leaseApiGroup: string;
136:   readonly #policy: BusterRuntimeSecuritySettings;
137: 
138:   constructor(options: KubernetesRuntimeSecurityCapabilityInvokerOptions) {
139:     this.#policy = capturedOptions(options);
140:     this.#root = fs.realpathSync(options.workspaceRoot); this.#kubectl = fs.realpathSync(options.kubectlExecutable);
141:     fs.accessSync(this.#kubectl, fs.constants.X_OK); this.#controllerNamespace = options.controllerNamespace;
142:     this.#leaseApiGroup = options.leaseApiGroup;
143:   }
144: 
145:   async invoke(capability: string, request: unknown, signal: AbortSignal): Promise<Readonly<Record<string, unknown>>> {
146:     if (capability !== 'kubernetes.runtime-security') throw new Error('KUBERNETES_RUNTIME_SECURITY_CAPABILITY_DENIED');
147:     const value = object(request, 'KUBERNETES_RUNTIME_SECURITY_REQUEST_INVALID');
148:     if (value.operation !== 'inspect') throw new Error('KUBERNETES_RUNTIME_SECURITY_OPERATION_DENIED');
149:     const payload = object(value.payload, 'KUBERNETES_RUNTIME_SECURITY_REQUEST_INVALID');
150:     const leaseName = text(payload.leaseName, 'leaseName', 253); const namespace = text(payload.namespace, 'namespace', 63);
151:     if (!this.#policy.allowedNamespacePrefixes.some((prefix) => namespace.startsWith(`${prefix}-`))) throw new Error('KUBERNETES_RUNTIME_SECURITY_NAMESPACE_DENIED');
152:     const immutableImage = text(payload.immutableImage, 'immutableImage');
153:     const manifestPath = containedRuntimeSecurityManifest(this.#root, payload.manifestPath);
154:     const digest = text(payload.manifestDigest, 'manifestDigest', 71);
155:     const actualDigest = `sha256:${crypto.createHash('sha256').update(fs.readFileSync(manifestPath)).digest('hex')}`;
156:     if (actualDigest !== digest) throw new Error('KUBERNETES_RUNTIME_SECURITY_MANIFEST_DIGEST_MISMATCH');
157:     const timeoutMs = Math.min(this.#policy.maximumExecutionMs,
158:       Number.isSafeInteger(payload.timeoutMs) ? Number(payload.timeoutMs) : this.#policy.maximumExecutionMs);
159:     const leaseResource = `busternamespaceleases.${this.#leaseApiGroup}`;
160:     const deadline = Date.now() + timeoutMs;
161:     while (Date.now() < deadline) {
162:       const lease = object(JSON.parse((await kubectl(this.#kubectl,
163:         ['get', leaseResource, leaseName, '-n', this.#controllerNamespace, '-o', 'json'],
164:         Math.max(1, deadline - Date.now()), this.#policy, signal)).toString('utf8')));
165:       const snapshot = runtimeSecuritySnapshot(lease, namespace);
166:       if (observationMatches(snapshot, digest, immutableImage, this.#policy)) {
167:         if (runtimeSecurityResultDigest(snapshot) !== snapshot.resultDigest) {
168:           throw new Error('KUBERNETES_RUNTIME_SECURITY_RESULT_DIGEST_MISMATCH');
169:         }
170:         return Object.freeze({ scanner: 'kubernetes-runtime-security', leaseName, namespace, manifestDigest: digest,
171:           observedAt: snapshot.observedAt, podCount: snapshot.podCount, serviceCount: snapshot.serviceCount,
172:           totalFindingCount: snapshot.totalFindingCount, omittedFindingCount: snapshot.omittedFindingCount,
173:           findings: snapshot.findings, resultDigest: snapshot.resultDigest });
174:       }
175:       await new Promise<void>((resolve, reject) => {
176:         const onAbort = () => { clearTimeout(timer); reject(new Error('KUBERNETES_RUNTIME_SECURITY_CANCELLED')); };
177:         const timer = setTimeout(() => { signal.removeEventListener('abort', onAbort); resolve(); },
178:           Math.min(this.#policy.pollIntervalMs, Math.max(1, deadline - Date.now())));
179:         signal.addEventListener('abort', onAbort, { once: true });
180:       });
181:     }
182:     throw new Error('KUBERNETES_RUNTIME_SECURITY_TIMEOUT');
183:   }
184: }
185: 
186: export function runtimeSecurityObservationIsFresh(value: unknown, nowMs: number, maximumAgeMs: number, maximumFutureSkewMs: number): boolean {
187:   if (typeof value !== 'string') return false;
188:   const observedMs = Date.parse(value);
189:   if (!Number.isFinite(observedMs)) return false;
190:   return observedMs <= nowMs + maximumFutureSkewMs && nowMs - observedMs <= maximumAgeMs;
191: }

SOURCE skills/buster/engine/test-gates/preparation-archive.ts SHA256 a3f47267addf5e371faff3896521eb3aac35b49523275a7766ed29c8d1d42f6a
1: import { spawn } from 'node:child_process';
2: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
3: 
4: export type ArchivePreparationLimits = Pick<BusterPreparationSettings, 'maximumExtractedBytes' | 'tarTimeoutMs'
5:   | 'maximumArchiveEntries' | 'maximumListingLineBytes' | 'maximumTarStderrBytes'>;
6: 
7: async function runTar(
8:   executable: string,
9:   args: readonly string[],
10:   signal: AbortSignal,
11:   limits: ArchivePreparationLimits,
12:   onLine?: (line: string) => void,
13: ): Promise<void> {
14:   signal.throwIfAborted();
15:   await new Promise<void>((resolve, reject) => {
16:     const child = spawn(executable, [...args], { stdio: ['ignore', 'pipe', 'pipe'] });
17:     let fault: Error | null = null;
18:     let pending = '';
19:     let stderr = Buffer.alloc(0);
20:     const stop = (error: Error): void => {
21:       fault ??= error;
22:       child.kill('SIGKILL');
23:     };
24:     const timer = setTimeout(() => stop(new Error('BUSTER_REMOTE_ARCHIVE_TIMEOUT')), limits.tarTimeoutMs);
25:     const abort = () => stop(new Error('BUSTER_REMOTE_ARCHIVE_CANCELLED'));
26:     signal.addEventListener('abort', abort, { once: true });
27:     child.stdout.on('data', (chunk: Buffer) => {
28:       if (!onLine || fault) return;
29:       pending += chunk.toString('utf8');
30:       if (Buffer.byteLength(pending) > limits.maximumListingLineBytes) {
31:         stop(new Error('BUSTER_REMOTE_ARCHIVE_LISTING_EXCEEDED'));
32:         return;
33:       }
34:       const lines = pending.split('\n');
35:       pending = lines.pop() ?? '';
36:       try { for (const line of lines) if (line) onLine(line); }
37:       catch (error) { stop(error instanceof Error ? error : new Error(String(error))); }
38:     });
39:     child.stderr.on('data', (chunk: Buffer) => {
40:       const available = Math.max(0, limits.maximumTarStderrBytes - stderr.byteLength);
41:       stderr = Buffer.concat([stderr, chunk.subarray(0, available)]);
42:     });
43:     child.once('error', (error) => { fault ??= error; });
44:     child.once('close', (code, terminationSignal) => {
45:       clearTimeout(timer);
46:       signal.removeEventListener('abort', abort);
47:       if (!fault && onLine && pending) {
48:         try { onLine(pending); } catch (error) { fault = error instanceof Error ? error : new Error(String(error)); }
49:       }
50:       if (fault) reject(fault);
51:       else if (code !== 0) reject(new Error(`BUSTER_REMOTE_TAR_FAILED:${code}:${terminationSignal ?? ''}:${stderr.toString('utf8').slice(-4096)}`));
52:       else resolve();
53:     });
54:   });
55: }
56: 
57: export async function safeExtract(
58:   tarExecutable: string,
59:   archive: string,
60:   target: string,
61:   limits: ArchivePreparationLimits,
62:   signal: AbortSignal,
63: ): Promise<void> {
64:   let entries = 0;
65:   let total = 0;
66:   const unsafeName = (name: string): boolean => {
67:     if (name.startsWith('/') || name.includes('\0')) return true;
68:     const normalized = name.endsWith('/') ? name.slice(0, -1) : name;
69:     const parts = normalized.split('/');
70:     return parts.some((part, index) => part === '..' || part === '' || (part === '.' && index !== 0));
71:   };
72:   await runTar(tarExecutable, ['--numeric-owner', '-tvzf', archive], signal, limits, (entry) => {
73:     entries += 1;
74:     if (entries > limits.maximumArchiveEntries) throw new Error('BUSTER_REMOTE_ARCHIVE_ENTRY_LIMIT');
75:     if (!/^[-d]/u.test(entry)) throw new Error('BUSTER_REMOTE_ARCHIVE_TYPE_DENIED');
76:     const match = entry.match(/^\S+\s+\S+\s+(\d+)\s+\S+\s+\S+\s+(.+)$/u);
77:     if (!match?.[1] || !match[2] || unsafeName(match[2])) throw new Error('BUSTER_REMOTE_ARCHIVE_PATH_INVALID');
78:     const size = Number(match[1]);
79:     if (!Number.isSafeInteger(size) || size < 0) throw new Error('BUSTER_REMOTE_ARCHIVE_ENTRY_INVALID');
80:     total += size;
81:     if (!Number.isSafeInteger(total) || total > limits.maximumExtractedBytes) {
82:       throw new Error('BUSTER_REMOTE_ARCHIVE_EXPANDED_SIZE_EXCEEDED');
83:     }
84:   });
85:   await runTar(tarExecutable, ['--no-same-owner', '--no-same-permissions', '-xzf', archive, '-C', target], signal, limits);
86: }
