37:     const seccomp = object(podSecurity.seccompProfile ?? {}, 'pod.seccompProfile');
38:     if (seccomp.type !== 'RuntimeDefault' && seccomp.type !== 'Localhost') {
39:         throw new Error('KUBERNETES_FIXTURE_SECCOMP_REQUIRED');
40:     }
41:     const volumes = Array.isArray(spec.volumes) ? spec.volumes : [];
42:     if (volumes.some((volume) => object(volume, 'pod.volume').hostPath !== undefined)) {
43:         throw new Error('KUBERNETES_FIXTURE_HOST_PATH_DENIED');
44:     }
45:     if (volumes.some((volume) => object(volume, 'pod.volume').ephemeral !== undefined)) {
46:         throw new Error('KUBERNETES_FIXTURE_GENERIC_EPHEMERAL_VOLUME_DENIED');
