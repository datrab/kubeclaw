170: export async function finalizeRunnerAttempt(owner: ResultOwner, input: ResultInput) {
171:  const { state, node, attemptNumber, issuedAt, busterLog, workerResult, workerRuntimeFault } = input;
172:  const { attemptId, attemptRepository, entry, invocation } = input.prepared;
173:     const completedProviderResult = completedProviderResultFor(input);
174:     const retainedFaultCleanupFailed = await cleanupFaultedFixture(owner, input);
175:     const workerExecutionState = workerExecutionStateFor(owner, input);
176:     const workerOutcome: TestOutcome =
177:       workerExecutionState === "completed"
178:         ? completedProviderResult!.outcome
179:         : null;
180:     const evidence = (workerResult?.evidence ?? []) as EvidenceRefV1[];
181:     mapCompletedOutputs(input, workerExecutionState, completedProviderResult, evidence);
182:     const executionState: ExecutionState = state.evidenceFault
183:       ? "errored"
184:       : workerExecutionState;
185:     const outcome: TestOutcome =
186:       executionState === "completed" ? workerOutcome : null;
187:     const unsigned = unsignedAttemptResult(owner, input, { executionState, outcome, completedProviderResult, evidence });
188:     const resultDigest = digest(unsigned);
189:     const result: AttemptResultV1 = {
190:       ...unsigned,
191:       resultDigest,
192:       receipt: receipt(owner.authorityId, owner.id(), resultDigest),
193:     };
194:     validatePipelineTestGateContract("attemptResult", result);
195:     const cleanupFailed = cleanupFailedFor(workerResult, retainedFaultCleanupFailed);
196:     if (cleanupFailed)
197:       owner.cleanupErrors.push({
198:         nodeId: node.id,
199:         message: workerResult?.cleanup.summary ?? "Cleanup failed.",
200:       });
201:     if (!state.retainFixture) {
202:       await fs.promises.rm(attemptRepository, { recursive: true, force: true });
203:     }
204:     return { result: freeze(result), instance: state.instance, invocation, cleanupFailed };
205: }

SOURCE skills/buster/engine/test-gates/runner-provider-operation.ts SHA256 332e73e5e35b28800ab7ad70331adf8c2ed683f819a0ea6504eea0abbb61645c
1: import fs from 'node:fs';
2: import type { TestProviderExecutionContext } from '@kubeclaw/plugin-sdk';
3: import { sha256Digest, type WorkerAttemptOperation, type WorkerAttemptOperationResult } from '@kubeclaw/worker-core';
4: import { stageEvidenceFiles } from './artifacts.ts';
5: import { validateBusterProviderResult } from './provider-result-validation.ts';
6: import { finalizeBusterReports } from './specialist-report-finalization.ts';
7: import { freeze, selectedEvidenceTypes } from './runner-values.ts';
8: import { addOutputEvidenceTypes, collectRunnerAttemptEvidence } from './runner-attempt-evidence.ts';
9: import type { RunnerProviderInput, RunnerProviderState } from './runner-provider-state.ts';
10: 
11: type ExecutionContext = Parameters<WorkerAttemptOperation['execute']>[0];
12: 
13: function providerContext(input: RunnerProviderInput, context: ExecutionContext): TestProviderExecutionContext {
14:   return input.context(context.signal, (stream, value) => {
15:     input.busterLog.contextLog(stream, value);
16:     context.log(stream, value);
17:   }, new Set(input.granted), input.invocation.inputs);
18: }
19: 
20: function assertNotAborted(signal: AbortSignal): void {
21:   if (signal.aborted) throw signal.reason ?? new Error('TEST_PROVIDER_CANCELLED');
22: }
23: 
24: async function initializeProvider(input: RunnerProviderInput, state: RunnerProviderState,
25:   workerContext: ExecutionContext, context: TestProviderExecutionContext): Promise<void> {
26:   state.loadWork = input.loader.load(input.entry, input.invocation, input.workspaceRoot, workerContext.signal);
27:   state.instance = await state.loadWork;
28:   assertNotAborted(workerContext.signal);
29:   if (input.node.kind === 'fixture') {
30:     state.fixtureInitializationStarted = true;
31:     const supportsCleanup = await state.instance.supportsCleanup(context);
32:     assertNotAborted(workerContext.signal);
33:     if (!supportsCleanup) throw new Error('TEST_PROVIDER_FIXTURE_CLEANUP_REQUIRED');
34:   }
35:   assertNotAborted(workerContext.signal);
36: }
37: 
38: async function stageProviderEvidence(input: RunnerProviderInput, state: RunnerProviderState,
39:   selected: Set<string>, signal: AbortSignal): Promise<void> {
40:   const candidates = state.providerResult!.evidenceFiles.filter(item => input.node.evidence.onError.includes(item.type));
41:   try {
42:     await stageEvidenceFiles(input.evidenceDirectory, input.stagedErrorEvidenceDirectory, candidates,
43:       input.node.limits.artifactFiles, input.node.limits.artifactBytes, signal);
44:     state.stagedErrorFiles = candidates;
45:   } catch (error) {
46:     await fs.promises.rm(input.stagedErrorEvidenceDirectory, { recursive: true, force: true });
47:     state.stagedErrorFiles = [];
48:     if (signal.aborted) throw error;
49:   }
50:   state.stagedFiles = state.providerResult!.evidenceFiles.filter(item => selected.has(item.type));
51:   await stageEvidenceFiles(input.evidenceDirectory, input.stagedEvidenceDirectory, state.stagedFiles,
52:     input.node.limits.artifactFiles, input.node.limits.artifactBytes, signal);
53: }
54: 
55: async function executeProvider(input: RunnerProviderInput, state: RunnerProviderState,
56:   workerContext: ExecutionContext): Promise<WorkerAttemptOperationResult> {
57:   const context = providerContext(input, workerContext);
58:   await initializeProvider(input, state, workerContext, context);
59:   state.executionStarted = true;
60:   state.providerResult = await state.instance!.execute(input.invocation, context);
61:   validateBusterProviderResult(input.entry, state.providerResult, input.providerResultLimit);
62:   state.providerResult = freeze(structuredClone(state.providerResult));
63:   const selected = selectedEvidenceTypes(input.node, 'completed', state.providerResult.outcome);
64:   addOutputEvidenceTypes(state.providerResult, selected);
65:   state.stagingWork = stageProviderEvidence(input, state, selected, workerContext.signal);
66:   await state.stagingWork;
67:   state.retainFixture = input.node.kind === 'fixture' && state.providerResult.outcome === 'passed';
68:   return {
69:     summary: state.providerResult.summary,
70:     specialistResult: {
71:       schemaId: 'kubeclaw.buster-provider-result.v1',
72:       schemaDigest: sha256Digest({ schemaId: 'kubeclaw.buster-provider-result.v1' }),
73:       values: { providerResult: structuredClone(state.providerResult) } as never,
74:     },
75:     evidence: [], exitCode: state.providerResult.exitCode, signal: state.providerResult.signal,
76:   };
77: }
78: 
79: async function cleanupProviderOperation(input: RunnerProviderInput, state: RunnerProviderState,
80:   workerContext: ExecutionContext): Promise<void> {
81:   if (!state.executionStarted && !state.fixtureInitializationStarted) {
82:     await state.instance?.discard?.();
83:     return;
84:   }
85:   if (!state.instance?.cleanup || state.retainFixture) return;
86:   await state.instance.cleanup(input.invocation, providerContext(input, workerContext), 'incomplete');
87: }
88: 
89: export function createRunnerProviderOperation(input: RunnerProviderInput, state: RunnerProviderState,
90:   preparationFault: Error | null, missingCapability: string | undefined): WorkerAttemptOperation {
91:   return {
92:     prepare: () => {
93:       if (preparationFault) throw preparationFault;
94:       if (missingCapability) throw new Error(`TEST_PROVIDER_CAPABILITY_DENIED:${missingCapability}`);
95:       return undefined;
96:     },
97:     execute: context => executeProvider(input, state, context),
98:     terminate: async () => {
99:       const loaded = state.instance ?? (await state.loadWork?.catch(() => null));
100:       await loaded?.terminate();
101:       await state.stagingWork?.catch(() => undefined);
102:     },
103:     measure: async () => {
104:       const measured = state.instance?.resources() ?? { cpuTimeMs: 0, maximumMemoryBytes: 0, maximumProcesses: 0 };
105:       return { cpuTimeMs: Math.ceil(measured.cpuTimeMs ?? 0),
106:         maximumMemoryBytes: Math.ceil(measured.maximumMemoryBytes ?? 0),
107:         maximumProcesses: Math.ceil(measured.maximumProcesses ?? 0) };
108:     },
109:     cleanup: context => cleanupProviderOperation(input, state, context),
110:     collectEvidence: phase => collectRunnerAttemptEvidence(input, state, phase),
111:     finalizeResult: ({ evidence, specialistResult, signal }) => finalizeBusterReports(
112:       { node: input.node, providerResult: state.providerResult, evidence, specialistResult, cleanupTimeoutMs: input.cleanupTimeoutMs, reportPolicy: input.options.executionPolicy.reports },
113:       { registry: input.options.registry, reportAdapterRuntime: input.reportAdapterRuntime, signal },
114:     ),
115:   };
116: }

SOURCE skills/buster/engine/test-gates/runner-setup.ts SHA256 ad0a216f45ecb0196ab96f1a653643f450748f9e61850691892104b1114a91c3
1: import { validateBusterExecutionSettings } from '../../../common/plugin-runtime/foundation/config/buster-execution.ts';
2: import fs from 'node:fs';
3: import path from 'node:path';
4: import { validateLocalWorkerRuntimePolicy, LocalWorkerRuntime, type LocalWorkerRuntimePolicy } from '@kubeclaw/worker-core';
5: import type { TestPlanRunnerOptions, WorkerAttemptRuntime } from './runner-types.ts';
6: import { assertPlanIdentity } from './runner-plan-identity.ts';
7: import { containedRelative, secureDirectory } from './runner-paths.ts';
8: import { createBusterWorkerProfiles } from './runner-worker-profile.ts';
9: 
10: export function validateRunnerOptions(options: TestPlanRunnerOptions) {
11:     const workerLocalRuntime = validateLocalWorkerRuntimePolicy(options.workerLocalRuntime);
12:     assertPlanIdentity(options.plan, options.registry);
13:     if (
14:       !Number.isSafeInteger(options.maximumConcurrency) ||
15:       options.maximumConcurrency < 1
16:     )
17:       throw new Error("TEST_RUNNER_CONCURRENCY_INVALID");
18:     for (const legacy of ['cleanupTimeoutMs', 'maximumProviderResultBytes']) {
19:       if (Object.hasOwn(options, legacy)) throw new Error(`TEST_RUNNER_LEGACY_POLICY:${legacy}`);
20:     }
21:     const executionPolicy = validateBusterExecutionSettings(options.executionPolicy);
22:     if (
23:       !path.isAbsolute(options.workspaceRoot) ||
24:       !path.isAbsolute(options.repositoryRoot) ||
25:       !path.isAbsolute(options.artifactRoot) ||
26:       !path.isAbsolute(options.observabilityRoot)
27:     ) {
28:       throw new Error("TEST_RUNNER_PATH_NOT_ABSOLUTE");
29:     }
30:     return { workerLocalRuntime, executionPolicy };
31: }
32: 
33: function prepareWorkspace(options: TestPlanRunnerOptions) {
34:     fs.mkdirSync(options.workspaceRoot, { recursive: true });
35:     const workspaceRoot = fs.realpathSync(options.workspaceRoot);
36:     fs.mkdirSync(options.artifactRoot, { recursive: true });
37:     const artifactRoot = fs.realpathSync(options.artifactRoot);
38:     if (
39:       artifactRoot === workspaceRoot ||
40:       artifactRoot.startsWith(`${workspaceRoot}${path.sep}`) ||
41:       workspaceRoot.startsWith(`${artifactRoot}${path.sep}`)
42:     ) {
43:       throw new Error("TEST_RUNNER_ARTIFACT_ROOT_OVERLAPS_WORKSPACE");
44:     }
45:     return { workspaceRoot, artifactRoot };
46: }
47: 
48: export function prepareRunnerPaths(options: TestPlanRunnerOptions) {
49:     const { workspaceRoot, artifactRoot } = prepareWorkspace(options);
50:     const observabilityRoot = secureDirectory(
51:       options.observabilityRoot,
52:       "TEST_RUNNER_OBSERVABILITY_ROOT",
53:     );
54:     if (
55:       observabilityRoot === workspaceRoot ||
56:       observabilityRoot.startsWith(`${workspaceRoot}${path.sep}`) ||
57:       workspaceRoot.startsWith(`${observabilityRoot}${path.sep}`)
58:     )
59:       throw new Error("TEST_RUNNER_OBSERVABILITY_ROOT_OVERLAPS_WORKSPACE");
60:     if (options.durableAttemptStore)
61:       secureDirectory(
62:         options.durableAttemptStore.storageDirectory(),
63:         "TEST_RUNNER_ATTEMPT_STORE_ROOT",
64:       );
65:     if (options.observabilityAdmissionStore)
66:       secureDirectory(
67:         options.observabilityAdmissionStore.storageDirectory(),
68:         "TEST_RUNNER_ADMISSION_STORE_ROOT",
69:       );
70:     if (
71:       options.durableAttemptStore &&
72:       fs.realpathSync(options.durableAttemptStore.storageDirectory()) !==
73:         path.join(observabilityRoot, "attempts")
74:     )
75:       throw new Error("TEST_RUNNER_ATTEMPT_STORE_ROOT_MISMATCH");
76:     if (
77:       options.observabilityAdmissionStore &&
78:       fs.realpathSync(
79:         options.observabilityAdmissionStore.storageDirectory(),
80:       ) !== path.join(observabilityRoot, "admission")
81:     )
82:       throw new Error("TEST_RUNNER_ADMISSION_STORE_ROOT_MISMATCH");
83:     containedRelative(
84:       workspaceRoot,
85:       options.repositoryRoot,
86:       "TEST_RUNNER_REPOSITORY",
87:     );
88:     if (options.sourceRepositoryRoot !== undefined && (
89:       !path.isAbsolute(options.sourceRepositoryRoot)
90:       || fs.realpathSync(options.sourceRepositoryRoot) !== options.sourceRepositoryRoot
91:       || !fs.statSync(options.sourceRepositoryRoot).isDirectory()
92:     )) throw new Error("TEST_RUNNER_SOURCE_REPOSITORY_INVALID");
93:     return { workspaceRoot, artifactRoot, observabilityRoot };
94: }
95: 
96: export function configuredWorkerRuntime(options: TestPlanRunnerOptions,
97:   workerLocalRuntime: LocalWorkerRuntimePolicy, now: () => Date): WorkerAttemptRuntime {
98:     if (options.workerRuntime) {
99:       return options.workerRuntime;
100:     } else {
101:       const runtime = new LocalWorkerRuntime({
102:         workerId: "worker:buster:local",
103:         workerType: "buster",
104:         coreVersion: "1.0.0",
105:         protocolVersions: ["worker-protocol.v1"],
106:         profiles: createBusterWorkerProfiles(
107:           options.plan,
108:           options.registry,
109:           options.grants,
110:         ),
111:         capacity: options.maximumConcurrency,
112:         drainTimeoutMs: workerLocalRuntime.drainTimeoutMs,
113:         cancellationTimeoutMs: workerLocalRuntime.cancellationTimeoutMs,
114:         replayLimit: workerLocalRuntime.replayLimit,
115:         now,
116:       });
117:       runtime.markReady();
118:       return runtime;
119:     }
120: }

