SOURCE skills/buster/engine/test-gates/kubernetes-manifest.ts SHA256 a86a248f1bd72e949a6d2cf63811f48fb1974e417954eea0e4a9f5f2a1a9e8df
1: import type { BusterManifestPolicy } from '../../../common/plugin-runtime/foundation/config/buster-cluster-invokers.ts';
2: import { loadAll } from 'js-yaml';
3: 
4: 
5: /** Bound parser recursion and expanded alias work before inspecting any manifest. */
6: export function boundedManifestDocuments(bytes: Buffer, policy: BusterManifestPolicy): unknown[] {
7:   const values: unknown[] = [];
8:   let depth = 0; let nodes = 0;
9:   try {
10:     loadAll(bytes.toString('utf8'), value => { values.push(value); }, {
11:       listener(event) {
12:         if (event === 'open') {
13:           if (++depth > policy.maximumDepth || ++nodes > policy.maximumNodes) throw new Error('KUBERNETES_FIXTURE_MANIFEST_COMPLEXITY_LIMIT');
14:         } else depth -= 1;
15:       },
16:     });
17:   } catch (error) {
18:     throw new Error(`KUBERNETES_FIXTURE_MANIFEST_PARSE_FAILED: ${error instanceof Error ? error.message : String(error)}`, { cause: error });
19:   }
20:   validateAliasGraph(values, policy);
21:   return values;
22: }
23: 
24: function validateAliasGraph(values: unknown[], policy: BusterManifestPolicy): void {
25:   const active = new WeakSet<object>(); const seen = new WeakSet<object>();
26:   const pending: { value: unknown; depth: number; leave?: boolean }[] = values.map(value => ({ value, depth: 0 }));
27:   let nodes = 0; let aliases = 0;
28:   while (pending.length) {
29:     const frame = pending.pop()!;
30:     if (!frame.value || typeof frame.value !== 'object') continue;
31:     if (frame.leave) { active.delete(frame.value); continue; }
32:     if (++nodes > policy.maximumNodes || frame.depth > policy.maximumDepth) throw new Error('KUBERNETES_FIXTURE_MANIFEST_COMPLEXITY_LIMIT');
33:     if (active.has(frame.value)) throw new Error('KUBERNETES_FIXTURE_MANIFEST_ALIAS_CYCLE');
34:     if (seen.has(frame.value) && ++aliases > policy.maximumAliases) throw new Error('KUBERNETES_FIXTURE_MANIFEST_ALIAS_LIMIT');
35:     seen.add(frame.value); active.add(frame.value);
36:     const children = Object.values(frame.value);
37:     if (pending.length + children.length > policy.maximumNodes) throw new Error('KUBERNETES_FIXTURE_MANIFEST_COMPLEXITY_LIMIT');
38:     pending.push({ ...frame, leave: true });
39:     for (const value of children) pending.push({ value, depth: frame.depth + 1 });
40:   }
41: }

