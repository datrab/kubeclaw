38: function configuredService(value: Record<string, unknown>, directory: string, environment: NodeJS.ProcessEnv,
39:   preparation: BusterPreparation, settings: { buster: BusterSettings; workerLocalRuntime: WorkerCoreSettings['localRuntime'] }, workerRevision: string, sourceAttestationPublicKey: string) {
40:   const dependencyReadiness = validateBusterDependencyReadinessSettings(settings.buster.dependencyReadiness);
41:   const registry = runtimeRegistry(value, directory);
42:   const records = object(value.recordLimits, 'recordLimits');
43:   const allowedCapabilities = new Set(Array.isArray(value.allowedCapabilities)
44:     && value.allowedCapabilities.every((item) => typeof item === 'string') ? value.allowedCapabilities : (() => {
45:       throw new Error('BUSTER_REMOTE_CONFIG_INVALID:allowedCapabilities');
46:     })());
47:   const sources = capabilitySources(value, allowedCapabilities, environment);
48:   const stateRoot = path.resolve(directory, value.stateRoot as string);
49:   const capabilities = configuredCapabilities(sources, directory, environment, settings.buster.clusterInvokers, value.clusterBindings);
50:   return new BusterRemotePlanService({
51:     preparation,
52:     store: new FileBusterPlanJobStore(stateRoot, {
53:       recordLimits: {
54:         maximumRecords: integer(records.maximumRecords, 'recordLimits.maximumRecords'),
55:         maximumBytes: integer(records.maximumBytes, 'recordLimits.maximumBytes'),
56:         maximumRecordBytes: integer(records.maximumRecordBytes, 'recordLimits.maximumRecordBytes'),
57:       },
58:       maximumResultBytes: integer(value.maximumResultBytes, 'maximumResultBytes'),
59:       maximumResultStoreBytes: integer(value.maximumResultStoreBytes, 'maximumResultStoreBytes'),
60:       trustedSourceAuthority: value.trustedSourceAuthority as string,
61:       sourceAttestationPublicKey,
62:     }),
63:     registry,
64:     dependencyReadiness,
65:     workerRevision,
66:     runtimeRoot: path.resolve(directory, value.runtimeRoot as string),
67:     admission: settings.buster.admission, workerLocalRuntime: settings.workerLocalRuntime, executionPolicy: settings.buster.execution,
68:     allowedCapabilities,
69:     ...capabilities,
70:   });
71: }
