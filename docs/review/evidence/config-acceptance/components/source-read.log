15: export function loadProductionBusterRemotePlanRuntime(
16:   file: string,
17:   preparation: BusterPreparation,
18:   settings: BusterSettings,
19:   workerLocalRuntime: WorkerCoreSettings['localRuntime'],
20:   environment: Readonly<Record<string, string | undefined>>,
21: ): BusterRemotePlanRuntime {
22:   rejectLegacyClusterEnvironment(environment);
23:   const executionPolicy = validateBusterExecutionSettings(settings.execution);
24:   const clusterInvokers = validateBusterClusterInvokerSettings(settings.clusterInvokers);
25:   const canonical = fs.realpathSync(file);
26:   const workerRevision = environment.KUBECLAW_BUILD_REVISION;
27:   if (!workerRevision || !/^[a-f0-9]{40,64}$/u.test(workerRevision)) {
28:     throw new Error('BUSTER_REMOTE_WORKER_REVISION_INVALID');
29:   }
30:   const directory = path.dirname(canonical);
31:   const value = object(JSON.parse(fs.readFileSync(canonical, 'utf8')), 'root');
32:   validateRuntimeRoot(value);
33:   const authority = runtimeAuthority(value, environment);
34:   const service = configuredService(value, directory, environment, preparation, { buster: { ...settings, execution: executionPolicy, clusterInvokers }, workerLocalRuntime }, workerRevision, authority.sourceAttestationPublicKey);
35:   return configuredRuntime(value, directory, service, settings, authority);
36: }
