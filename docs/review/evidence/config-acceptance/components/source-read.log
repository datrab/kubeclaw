28: export function nativePrismSupervisorConfig(config: ReturnType<typeof loadWorkerConfig>, environment: NodeJS.ProcessEnv = process.env) {
29:   const root = (name: string) => {
30:     const value = environment[name];
31:     if (!value || !path.isAbsolute(value) || path.resolve(value) !== value || value === '/') throw new Error(`PRISM_NATIVE_PATH_REQUIRED:${name}`);
32:     return value;
33:   };
34:   const engineContentDigest = prismEngineContentDigest(environment);
35:   if (!/^sha256:[a-f0-9]{64}$/u.test(engineContentDigest ?? '')) throw new Error('PRISM_NATIVE_ENGINE_CONTENT_IDENTITY_REQUIRED');
36:   const pool = readNativeWorkerPoolPolicy(root('PRISM_NATIVE_POOL_POLICY_FILE'), 'prism');
37:   requirePrismResourcePoolCapacity(config.native.resourcePolicy, pool.limits);
38:   requireNativeWorkerRuntimeIdentity(pool.runtimeIdentityFile);
39:   return Object.freeze({
40:     ...prismSupervisorSettings(config),
41:     engineContentDigest: engineContentDigest!,
42:     cgroupRoot: pool.cgroupRoot, ownershipRoot: pool.ownershipRoot,
43:     poolLimits: pool.limits, nodeIdentity: readNativeWorkerNodeIdentity(pool.nodeIdentityFile),
44:     launcher: root('PRISM_NATIVE_LAUNCHER'),
45:     maximumActiveScopes: pool.maximumActiveScopes,
46:     browserPath: environment.PLAYWRIGHT_BROWSERS_PATH ?? '/ms-playwright',
47:   });
48: }
49: 
50: /** Numeric startup snapshot; host authority is validated separately before composition. */
51: export function prismSupervisorSettings(config: ReturnType<typeof loadWorkerConfig>) {
52:   const supervisor = config.native.supervisor;
53:   return Object.freeze({
54:     policy: config.native.resourcePolicy,
55:     uid: supervisor.uid, gid: supervisor.gid,
56:     maximumRecords: supervisor.maximumOwnershipRecords,
57:     maximumBytes: supervisor.maximumOwnershipBytes,
58:     maximumInputBytes: config.ingress.maximumInputBytes,
59:     maximumOutputBytes: supervisor.maximumOutputBytes,
60:     maximumResultBytes: config.native.maximumResultBytes,
61:     maximumJournalBytes: supervisor.maximumJournalBytes,
62:     pollIntervalMs: supervisor.pollIntervalMs,
63:     drainTimeoutMs: supervisor.drainTimeoutMs,
64:     closeTimeoutMs: supervisor.closeTimeoutMs,
65:   });
66: }

SOURCE skills/prism/control/worker-operation-transport.ts SHA256 048a23bb132d4d70978e28449a468169ccd87b3a06fa2127fedffbcc992a9958
1: import { randomBytes } from 'node:crypto';
2: import type { WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import type { loadControlServerConfig } from '../server/control-config.ts';
4: import { signInternalRequest } from '../server/internal-auth.ts';
5: 
6: type Config = ReturnType<typeof loadControlServerConfig>;
7: 
8: export async function requestWorkerResult(config: Config, attempt: WorkerAttemptEnvelopeV3): Promise<unknown> {
9:   const body = Buffer.from(JSON.stringify(attempt)); const timestamp = Date.now(); const nonce = randomBytes(16).toString('hex');
10:   const response = await fetch(new URL('/v1/attempts', config.workerUrl), {
11:     method: 'POST', body, signal: AbortSignal.timeout(config.nativeWorkerDispatchTimeoutMs),
12:     headers: config.spiffeEnabled ? { 'content-type': 'application/json' } : {
13:       'content-type': 'application/json', 'x-prism-timestamp': String(timestamp), 'x-prism-nonce': nonce,
14:       'x-prism-signature': `v1=${signInternalRequest(config.workerSecret, body, timestamp, nonce)}`,
15:     },
16:   });
17:   if (!response.ok) { await response.body?.cancel(); throw new Error(`Prism worker failed: ${response.status}`); }
18:   return boundedResult(response, config.maximumWorkerResponseBytes);
19: }
20: 
21: async function boundedResult(response: Response, maximumBytes: number): Promise<unknown> {
22:   const reader = response.body?.getReader();
23:   if (!reader) throw new Error('PRISM_NATIVE_RESULT_BODY_REQUIRED');
24:   const chunks: Uint8Array[] = []; let size = 0;
25:   try {
26:     for (;;) {
27:       const chunk = await reader.read();
28:       if (chunk.done) break;
29:       size += chunk.value.byteLength;
30:       if (size > maximumBytes) { await reader.cancel(); throw new Error('PRISM_NATIVE_RESULT_BODY_LIMIT'); }
31:       chunks.push(chunk.value);
32:     }
33:     return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(Buffer.concat(chunks)));
34:   } finally { reader.releaseLock(); }
35: }

SOURCE skills/prism/server/agent-routes.ts SHA256 55c4c77fc4ff7b981287c433c126d9754dffd3df1de464ec0d83bb0294caec17
1: import {
2:   validatePrism,
3:   type PrismDocument,
4: } from "@kubeclaw/prism-contracts-v1";
