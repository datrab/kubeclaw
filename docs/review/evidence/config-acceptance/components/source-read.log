81:         }
82:     }
83:     const resources = object(spec.resources, 'persistentVolumeClaim.resources');
84:     const requests = object(resources.requests, 'persistentVolumeClaim.resources.requests');
85:     const bytes = storageBytes(requests.storage);
86:     if (bytes > policy.maximumClaimBytes)
