51: async function cleanupFaultedFixture(owner: ResultOwner, input: ResultInput): Promise<boolean> {
52:  const { state, node, busterLog, workerResult, workerRuntimeFault } = input;
53:  const { invocation } = input.prepared;
54:     let retainedFaultCleanupFailed = false;
55:     if (
56:       state.retainFixture &&
57:       (workerRuntimeFault || workerResult?.state !== "completed") &&
58:       state.instance
59:     ) {
60:       retainedFaultCleanupFailed = !(await owner.cleanupProvider(
61:         node,
62:         state.instance,
63:         invocation,
64:         busterLog.contextLog,
65:       ));
66:       state.retainFixture = false;
67:     }
68:  return retainedFaultCleanupFailed;
69: }
