93: 
94: function configuredClusterCapabilities(sources: ReturnType<typeof capabilitySources>,
95:   policy: BusterClusterInvokerSettings, bindingSource: unknown) {
96:   const { kubernetesFixtureEnabled, tailscaleExposureEnabled, kubernetesRuntimeSecurityEnabled,
97:     containerBuildSource, registryUsername, registryPassword } = sources;
98:   if (!kubernetesFixtureEnabled && !tailscaleExposureEnabled && !kubernetesRuntimeSecurityEnabled
99:     && bindingSource === undefined) return {};
100:   const binding = clusterRuntimeBinding(bindingSource, policy);
101:   return {
102:     ...kubernetesFixtureOptions(kubernetesFixtureEnabled, policy, binding, kubernetesFixtureEnabled
103:       ? registryHealthConfiguration(true, containerBuildSource, registryUsername, registryPassword).origin : undefined),
104:     ...tailscaleExposureOptions(tailscaleExposureEnabled, policy, binding),
105:     ...kubernetesRuntimeSecurityOptions(kubernetesRuntimeSecurityEnabled, policy, binding),
106:   };
107: }
108: 
109: function configuredRuntime(value: Record<string, unknown>, directory: string, service: BusterRemotePlanService,
110:   settings: BusterSettings, { trustedPeerSpiffeIds, token }: ReturnType<typeof runtimeAuthority>) {
111:   const tlsSource = value.tls === undefined ? null : object(value.tls, 'tls');
112:   const tls = tlsSource ? {
113:     key: fs.readFileSync(fs.realpathSync(path.resolve(directory, String(tlsSource.keyPath)))),
114:     cert: fs.readFileSync(fs.realpathSync(path.resolve(directory, String(tlsSource.certificatePath)))),
115:   } : undefined;
116:   const host = value.host as string;
117:   return new BusterRemotePlanRuntime({
118:     service,
119:     host,
120:     port: integer(value.port, 'port', 0),
121:     ...(trustedPeerSpiffeIds ? { trustedPeerSpiffeIds } : { token: token! }),
122:     maximumRequestBytes: settings.preparation.maximumRequestBytes,
123:     maximumResponseBytes: integer(value.maximumResponseBytes, 'maximumResponseBytes'),
124:     maximumResultBytes: integer(value.maximumResultBytes, 'maximumResultBytes'),
125:     shutdownTimeoutMs: integer(value.shutdownTimeoutMs, 'shutdownTimeoutMs'),
126:     ...(tls ? { tls } : {}),
127:   });
128: }

