237: {{/* Validates only the explicit cluster policy schema vocabulary; no defaults. */}}
238: {{- define "kubeclaw.validateClusterPolicy" -}}
239: {{- $value := .value -}}{{- $schema := .schema -}}{{- $name := .name -}}
240: {{- if eq $schema.type "object" -}}
241: {{- if not (kindIs "map" $value) -}}{{- fail (printf "%s must be an object" $name) -}}{{- end -}}
242: {{- if ne (len $value) (len $schema.required) -}}{{- fail (printf "%s requires exactly declared fields" $name) -}}{{- end -}}
243: {{- range $key := $schema.required -}}
244: {{- if not (hasKey $value $key) -}}{{- fail (printf "%s.%s required" $name $key) -}}{{- end -}}
245: {{- include "kubeclaw.validateClusterPolicy" (dict "value" (index $value $key) "schema" (index $schema.properties $key) "name" (printf "%s.%s" $name $key)) -}}
246: {{- end -}}
247: {{- else if eq $schema.type "array" -}}
248: {{- if not (kindIs "slice" $value) -}}{{- fail (printf "%s must be an array" $name) -}}{{- end -}}
249: {{- if or (lt (len $value) (int $schema.minItems)) (and (hasKey $schema "maxItems") (gt (len $value) (int $schema.maxItems))) -}}{{- fail (printf "%s array bounds invalid" $name) -}}{{- end -}}
250: {{- range $item := $value -}}{{- include "kubeclaw.validateClusterPolicy" (dict "value" $item "schema" $schema.items "name" $name) -}}{{- end -}}
251: {{- else if eq $schema.type "string" -}}
252: {{- if not (kindIs "string" $value) -}}{{- fail (printf "%s must be a string" $name) -}}{{- end -}}
253: {{- if lt (len $value) (int $schema.minLength) -}}{{- fail (printf "%s cannot be empty" $name) -}}{{- end -}}
254: {{- if and (hasKey $schema "maxLength") (gt (len $value) (int $schema.maxLength)) -}}{{- fail (printf "%s string too long" $name) -}}{{- end -}}
255: {{- if and (hasKey $schema "pattern") (not (regexMatch $schema.pattern $value)) -}}{{- fail (printf "%s string invalid" $name) -}}{{- end -}}
256: {{- else if eq $schema.type "boolean" -}}
257: {{- if not (kindIs "bool" $value) -}}{{- fail (printf "%s must be boolean" $name) -}}{{- end -}}
258: {{- else if eq $schema.type "integer" -}}
259: {{- if not (kindIs "float64" $value) -}}{{- fail (printf "%s must be a number" $name) -}}{{- end -}}
260: {{- if or (ne $value (floor $value)) (lt $value (float64 $schema.minimum)) (gt $value (float64 $schema.maximum)) -}}{{- fail (printf "%s integer bounds invalid" $name) -}}{{- end -}}
261: {{- else -}}{{- fail "unsupported cluster policy schema type" -}}{{- end -}}
262: {{- end -}}
