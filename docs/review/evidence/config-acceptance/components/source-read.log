40: export async function syncDirectory(directory: string): Promise<void> {
41:   const handle = await fs.open(directory, "r");
42:   try {
43:     await handle.sync();
44:   } finally {
45:     await handle.close();
46:   }
47: }
48: 
49: export async function durableBlob(
50:   root: string,
51:   contentDigest: string,
52:   bytes: Uint8Array,
53: ): Promise<string> {
54:   const hex = contentDigest.slice("sha256:".length);
55:   const directory = path.join(root, "blobs", hex.slice(0, 2));
56:   const staging = path.join(root, "staging");
57:   await ensureDirectoryDurable(directory);
58:   await ensureDirectoryDurable(staging);
59:   const destination = path.join(directory, hex);
60:   try {
61:     const existing = await fs.readFile(destination);
62:     if (digest(existing) !== contentDigest)
63:       throw new Error("OBSERVABILITY_EVIDENCE_DIGEST_CONFLICT");
64:     return destination;
65:   } catch (error) {
66:     if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
67:   }
68:   const temporary = path.join(staging, `${hex}.${randomUUID()}.tmp`);
69:   let renamed = false;
70:   try {
71:     const handle = await fs.open(temporary, "wx", 0o600);
72:     try {
73:       await handle.writeFile(bytes);
74:       await handle.sync();
75:     } finally {
76:       await handle.close();
77:     }
78:     await fs.rename(temporary, destination);
79:     renamed = true;
80:     await syncDirectory(directory);
81:     return destination;
82:   } finally {
83:     if (!renamed) await fs.unlink(temporary).catch(() => undefined);
84:   }
85: }
86: 
87: export async function cleanupStaging(root: string): Promise<void> {
88:   const staging = path.join(root, "staging");
89:   await fs.mkdir(staging, { recursive: true });
90:   for (const entry of await fs.readdir(staging, { withFileTypes: true })) {
91:     if (entry.isFile() && entry.name.endsWith(".tmp"))
92:       await fs.unlink(path.join(staging, entry.name));
93:   }
94: }
95: 
96: export async function cleanupUnreferencedBlobs(
97:   root: string,
98:   state: DurableAttemptStoreSnapshot,
99: ): Promise<void> {
100:   const blobs = path.join(root, "blobs");
101:   const referenced = new Set(
102:     state.evidence.map((item) => item.artifact.contentDigest.slice(7)),
103:   );
104:   let prefixes: Dirent<string>[] = [];
105:   try {
106:     prefixes = await fs.readdir(blobs, {
107:       withFileTypes: true,
108:       encoding: "utf8",
109:     });
110:   } catch (error) {
111:     if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
112:     throw error;
113:   }
114:   for (const prefix of prefixes) {
115:     if (!prefix.isDirectory() || !/^[0-9a-f]{2}$/.test(prefix.name)) continue;
116:     const directory = path.join(blobs, prefix.name);
117:     for (const entry of await fs.readdir(directory, {
118:       withFileTypes: true,
119:       encoding: "utf8",
120:     })) {
121:       if (
122:         entry.isFile() &&
123:         /^[0-9a-f]{64}$/.test(entry.name) &&
124:         !referenced.has(entry.name)
125:       )
126:         await fs.unlink(path.join(directory, entry.name));
127:     }
128:   }
129: }
130: 
131: export function scopedEvidenceId(
132:   attemptId: string,
133:   claimGeneration: number,
134:   evidenceId: string,
135: ): string {
136:   return `evidence:${createHash("sha256").update(canonicalJson({ attemptId, claimGeneration, evidenceId })).digest("hex")}`;
137: }
138: export async function storeEvidence(
139:   store: AttemptState,
140:   input: DurableEvidenceInput,
141:   bytes: Uint8Array,
142: ): Promise<WorkerEvidenceRefV1> {
143:   const snapshot = structuredClone(input);
144:   validateEvidenceInput(snapshot);
145:   const content = Uint8Array.from(bytes);
146:   if (content.byteLength > store.limits.maximumEvidenceObjectBytes)
147:     throw new Error("OBSERVABILITY_EVIDENCE_OBJECT_TOO_LARGE");
148:   return store.serial(() => persistEvidence(store, snapshot, content));
149: }
150: 
151: function validateEvidenceInput(snapshot: DurableEvidenceInput): void {
152:   requireIdentity(
153:     snapshot.pipelineRunId,
154:     "OBSERVABILITY_PIPELINE_RUN_ID_INVALID",
155:   );
156:   requireIdentity(snapshot.attemptId, "OBSERVABILITY_ATTEMPT_ID_INVALID");
157:   requireIdentity(snapshot.evidenceId, "OBSERVABILITY_EVIDENCE_ID_INVALID");
158:   requireIdentity(snapshot.type, "OBSERVABILITY_EVIDENCE_TYPE_INVALID");
159:   requireIdentity(
160:     snapshot.mediaType,
161:     "OBSERVABILITY_EVIDENCE_MEDIA_TYPE_INVALID",
162:   );
163:   if (
164:     !Number.isSafeInteger(snapshot.claimGeneration) ||
165:     snapshot.claimGeneration < 1
166:   )
167:     throw new Error("OBSERVABILITY_CLAIM_GENERATION_INVALID");
168:   validatePipelineObservabilityContract("producerIdentity", snapshot.producer);
169: }
170: 
171: async function persistEvidence(
172:   store: AttemptState,
173:   snapshot: DurableEvidenceInput,
174:   content: Uint8Array,
175: ): Promise<WorkerEvidenceRefV1> {
176:   const state = await store.readState();
177:   await store.reclaimExpiredEvidence(state);
178:   await cleanupUnreferencedBlobs(store.root, state);
179:   const existing = state.evidence.find(
180:     (item) =>
181:       item.pipelineRunId === snapshot.pipelineRunId &&
182:       item.attemptId === snapshot.attemptId &&
183:       item.claimGeneration === snapshot.claimGeneration &&
184:       item.evidenceId === snapshot.evidenceId,
185:   );
186:   const contentDigest = digest(content);
187:   if (existing) {
188:     if (
189:       existing.artifact.contentDigest !== contentDigest ||
190:       existing.type !== snapshot.type ||
191:       existing.mediaType !== snapshot.mediaType ||
192:       !sameProducer(existing.producer, snapshot.producer)
193:     )
194:       throw new Error("OBSERVABILITY_EVIDENCE_IDENTITY_CONFLICT");
195:     return structuredClone({
196:       evidenceId: existing.evidenceId,
197:       type: existing.type,
198:       artifact: existing.artifact,
199:     });
200:   }
201:   assertEvidenceCapacity(state, store.limits, content);
202:   const hex = contentDigest.slice(7);
203:   const destination = path.join(store.root, "blobs", hex.slice(0, 2), hex);
204:   const artifact = {
205:     artifactId: `artifact:${hex}`,
206:     type: snapshot.type,
207:     mediaType: snapshot.mediaType,
208:     contentDigest,
209:     sizeBytes: content.byteLength,
210:     storageUrl: pathToFileURL(destination).href,
211:   };
212:   const metadata: DurableEvidenceMetadata = {
213:     ...snapshot,
214:     artifact,
215:     stagedAt: new Date().toISOString(),
216:   };
217:   const candidate = { ...state, evidence: [...state.evidence, metadata] };
218:   store.checkSize(candidate);
219:   await durableBlob(store.root, contentDigest, content);
220:   await store.writeState(candidate);
221:   return structuredClone({
222:     evidenceId: snapshot.evidenceId,
223:     type: snapshot.type,
224:     artifact,
225:   });
226: }
227: 
228: function assertEvidenceCapacity(
229:   state: DurableAttemptStoreSnapshot,
230:   limits: DurableAttemptStoreLimits,
231:   content: Uint8Array,
232: ): void {
233:   const total = state.evidence.reduce(
234:     (sum, item) => sum + item.artifact.sizeBytes,
235:     0,
236:   );
237:   if (
238:     state.evidence.length >= limits.maximumEvidenceObjects ||
239:     total + content.byteLength > limits.maximumEvidenceBytes
240:   )
241:     throw new Error("OBSERVABILITY_EVIDENCE_STORE_FULL");
242: }

