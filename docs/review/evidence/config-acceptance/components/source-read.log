35: }[] {
36:     if (document.kind === 'PersistentVolumeClaim') {
37:         const metadata = object(document.metadata, 'persistentVolumeClaim.metadata');
38:         return [{ name: text(metadata.name, 'persistentVolumeClaim.metadata.name', 253),
39:                 spec: object(document.spec, 'persistentVolumeClaim.spec'), copies: 1n }];
40:     }
41:     if (document.kind !== 'StatefulSet')
42:         return [];
43:     const spec = object(document.spec, 'statefulSet.spec');
