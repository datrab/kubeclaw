2: import { validatePipelineTestGateContract, type AttemptResultV1, type EvidenceRefV1, type ExecutionState, type ProviderInvocationV1, type ProviderResultV1, type ReportAdapterResultV1, type ResolvedPlanNodeV1, type ResourceUseV1, type TestOutcome } from '@kubeclaw/pipeline-test-gate-contract';
