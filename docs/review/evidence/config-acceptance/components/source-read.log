18: export interface LoadedTestProvider {
19:   supportsCleanup(context: TestProviderExecutionContext): Promise<boolean>;
20:   execute(invocation: ProviderInvocationV1, context: TestProviderExecutionContext): Promise<ProviderResultV1>;
21:   cleanup(invocation: ProviderInvocationV1, context: TestProviderExecutionContext, disposition: TestProviderCleanupDisposition): Promise<void>;
22:   terminate(): Promise<void>;
23:   discard?(): Promise<void>;
24:   resources(): ProviderProcessResources;
25: }
