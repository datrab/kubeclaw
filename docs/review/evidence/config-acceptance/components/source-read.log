184: export function validateBusterDependencyReadinessSettings(value: unknown): BusterDependencyReadinessSettings {
185:   validateComponentSettings('buster-dependency-readiness', value, 'SWARM_CONFIG_BUSTER_DEPENDENCY_READINESS_INVALID');
186:   return Object.freeze({ ...value as BusterDependencyReadinessSettings });
187: }
