132: /** Validate the authored document before selecting its operator-owned settings. */
133: function prismSettingsFromConfig(value: unknown): PrismSettings {
134:   const control = (value as SwarmConfig).operator.prism.control;
135:   if (path.resolve(control.artifactRoot) !== control.artifactRoot || control.artifactRoot === '/') {
136:     throw new Error('SWARM_CONFIG_INVALID:control.artifactRoot must be a normalized absolute non-root path');
137:   }
138:   try { new URL(control.studioPublicUrl); }
139:   catch { throw new Error('SWARM_CONFIG_INVALID:control.studioPublicUrl must be an absolute HTTP(S) URL'); }
140:   const studio = (value as SwarmConfig).operator.prism.studio;
141:   validateStudioOrigin(studio.controlUrl);
142:   const settings = (value as SwarmConfig).operator.prism.worker;
143:   if (settings.maximumActiveRequests + settings.maximumProbeRequests > settings.maximumConnections) {
144:     throw new Error('SWARM_CONFIG_WORKER_CONNECTION_BUDGET_INVALID');
145:   }
146:   const supervisor = (value as SwarmConfig).operator.prism.native.supervisor;
147:   if (settings.shutdownTimeoutMs <= supervisor.closeTimeoutMs + supervisor.drainTimeoutMs) {
148:     throw new Error('SWARM_CONFIG_WORKER_SHUTDOWN_BUDGET_INVALID');
149:   }
150:   return Object.freeze({ studio: Object.freeze({ ...studio }), control: Object.freeze({ ...control }), worker: Object.freeze({ ...settings }),
151:     native: Object.freeze({ ...(value as SwarmConfig).operator.prism.native,
152:       supervisor: Object.freeze({ ...supervisor }),
153:       resourcePolicy: Object.freeze({ ...(value as SwarmConfig).operator.prism.native.resourcePolicy }) }) });
154: }
155: 
156: function validateStudioOrigin(value: string): void {
157:   try {
158:     const url = new URL(value);
159:     if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password
160:       || url.pathname !== '/' || url.search || url.hash || /[\\\x00-\x20\x7f]/u.test(value)) throw new Error('origin');
161:   } catch { throw new Error('SWARM_CONFIG_INVALID:studio.controlUrl must be an absolute HTTP(S) origin'); }
162: }
