1: import { spawn, type ChildProcessWithoutNullStreams } from 'node:child_process';
2: import fs from 'node:fs';
3: import path from 'node:path';
4: import process from 'node:process';
5: import readline from 'node:readline';
6: import { fileURLToPath } from 'node:url';
7: import type { ProviderInvocationV1, ProviderResultV1 } from '@kubeclaw/pipeline-test-gate-contract';
8: import type { TestProviderExecutionContext, TestProviderCleanupDisposition } from '@kubeclaw/plugin-sdk';
9: import type { TestProviderRegistryEntry } from '@kubeclaw/plugin-foundation/registry/types';
10: import { validateBusterProviderRuntimeSettings, type BusterProviderRuntimeSettings } from '../../../common/plugin-runtime/foundation/config/buster-execution.ts';
11: import type { ProviderProcessResources } from './provider-loader.ts';
12: import { ProviderCapabilities } from './provider-capabilities.ts';
