85:   constructor(options: TailscaleExposureCapabilityInvokerOptions) {
86:     const processInputPolicy = validateBusterProcessInputSettings(options.processInputPolicy);
87:     validateTailscaleOperationPolicy(options);
88:     this.#shortCommandTimeoutMs = options.shortCommandTimeoutMs;
