93:         ? { cpuTimeMs: workerResult.resources.cpuTimeMs }
94:         : {}),
95:       ...(workerResult?.resources.maximumMemoryBytes !== undefined
96:         ? { maximumMemoryBytes: workerResult.resources.maximumMemoryBytes }
97:         : {}),
98:       logBytes: workerResult?.resources.logBytes ?? busterLog.bytes(),
99:       artifactBytes: evidence.reduce(
100:         (sum, item) => sum + item.artifact.sizeBytes,
101:         0,
102:       ),
103:     };
104:  return resources;
105: }
106: 
107: function providerResultFields(faulted: boolean, provider: ProviderResultV1 | null,
108:   worker: WorkerAttemptResultV1 | null) {
