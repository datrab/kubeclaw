53:         const metadata = object(template.metadata, 'statefulSet.volumeClaimTemplate.metadata');
54:         return { name: text(metadata.name, 'statefulSet.volumeClaimTemplate.metadata.name', 253),
55:             spec: object(template.spec, 'statefulSet.volumeClaimTemplate.spec'), copies: BigInt(Number(replicas)) };
56:     });
