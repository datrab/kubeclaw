62: class IsolatedLoadedProvider implements LoadedTestProvider {
63:   readonly #policy: BusterProviderRuntimeSettings;
64:   readonly #entry: TestProviderRegistryEntry;
65:   readonly #invocation: ProviderInvocationV1;
66:   #session: ProviderProcessSession;
67:   #terminated = false;
68:   readonly #accountedSessions = new WeakSet<ProviderProcessSession>();
69:   #resources: ProviderProcessResources = { cpuTimeMs: 0, maximumMemoryBytes: 0, maximumProcesses: 1 };
70: 
71:   readonly #workspaceRoot: string;
72: 
73:   constructor(entry: TestProviderRegistryEntry, invocation: ProviderInvocationV1, workspaceRoot: string, policy: BusterProviderRuntimeSettings) {
74:     this.#policy = policy;
75:     this.#entry = entry; this.#invocation = invocation; this.#workspaceRoot = workspaceRoot;
76:     this.#session = new ProviderProcessSession(entry, invocation, workspaceRoot, policy);
77:   }
78: 
79:   supportsCleanup(context: TestProviderExecutionContext): Promise<boolean> { return this.#session.initialize(context); }
80: 
81:   execute(_invocation: ProviderInvocationV1, context: TestProviderExecutionContext): Promise<ProviderResultV1> {
82:     return this.#session.execute(context);
83:   }
84: 
85:   async cleanup(_invocation: ProviderInvocationV1, context: TestProviderExecutionContext, disposition: TestProviderCleanupDisposition): Promise<void> {
86:     assertCleanupDisposition(disposition);
87:     if (this.#terminated) {
88:       // Adopt recovery ownership before initialization, never the old session flag.
89:       this.#session = new ProviderProcessSession(this.#entry, this.#invocation, this.#workspaceRoot, this.#policy);
90:       this.#terminated = false;
91:     }
92:     await this.#cleanupSession(this.#session, context, disposition);
93:   }
94: 
95:   async #cleanupSession(session: ProviderProcessSession, context: TestProviderExecutionContext,
96:     disposition: TestProviderCleanupDisposition): Promise<void> {
97:     let cleanupFailure: { error: unknown } | undefined;
98:     try { if (await session.initialize(context)) await session.cleanup(context, disposition); }
99:     catch (error) { cleanupFailure = { error }; }
100:     try { await this.#terminateSession(session); }
101:     catch (terminationError) {
102:       if (cleanupFailure) throw new AggregateError([cleanupFailure.error, terminationError],
103:         `TEST_PROVIDER_CLEANUP_AND_TERMINATION_FAILED:${cleanupFailure.error instanceof Error ? cleanupFailure.error.message : String(cleanupFailure.error)}:${terminationError instanceof Error ? terminationError.message : String(terminationError)}`, { cause: cleanupFailure.error });
104:       throw terminationError;
105:     }
106:     // Preserve the existing boundary: a failed stop never authorizes deletion.
107:     this.#removeSnapshot();
108:     if (cleanupFailure) throw cleanupFailure.error;
109:   }
110: 
111:   async terminate(): Promise<void> {
112:     if (this.#terminated) return;
113:     await this.#terminateSession(this.#session);
114:   }
115: 
116:   async #terminateSession(session: ProviderProcessSession): Promise<void> {
117:     session.resources();
118:     try { await session.terminate(); }
119:     finally {
120:       if (session.disposalConfirmed) {
121:         if (!this.#accountedSessions.has(session)) {
122:           this.#resources = this.#combinedResources(session);
123:           this.#accountedSessions.add(session);
124:         }
125:         if (this.#session === session) this.#terminated = true;
126:       }
127:     }
128:   }
129: 
130:   async discard(): Promise<void> {
131:     await this.terminate();
132:     this.#removeSnapshot();
133:   }
134: 
135:   #removeSnapshot(): void {
136:     const snapshots = path.join(fs.realpathSync(this.#workspaceRoot), 'test-provider-snapshots');
137:     const relative = path.relative(snapshots, this.#entry.package.root);
138:     if (relative === '' || relative === '..' || relative.startsWith(`..${path.sep}`)) throw new Error('TEST_PROVIDER_SNAPSHOT_PATH_INVALID');
139:     fs.rmSync(this.#entry.package.root, { recursive: true, force: true });
140:   }
141: 
142:   #combinedResources(session: ProviderProcessSession): ProviderProcessResources {
143:     const current = session.resources();
144:     return {
145:       cpuTimeMs: this.#resources.cpuTimeMs + current.cpuTimeMs,
146:       maximumMemoryBytes: Math.max(this.#resources.maximumMemoryBytes, current.maximumMemoryBytes),
147:       maximumProcesses: Math.max(this.#resources.maximumProcesses, current.maximumProcesses),
148:     };
149:   }
150: 
151:   resources(): ProviderProcessResources {
152:     return this.#terminated ? { ...this.#resources } : this.#combinedResources(this.#session);
153:   }
154: }
155: 
156: export class RegisteredTestProviderLoader implements TestProviderLoader {
157:   readonly #policy: BusterProviderRuntimeSettings;
158:   constructor(policy: BusterProviderRuntimeSettings) {
159:     this.#policy = validateBusterProviderRuntimeSettings(policy);
160:   }
161: 
162:   async load(entry: TestProviderRegistryEntry, invocation: ProviderInvocationV1, workspaceRoot: string,
163:     signal: AbortSignal): Promise<LoadedTestProvider> {
164:     if (signal.aborted) throw signal.reason ?? new Error('TEST_PROVIDER_CANCELLED');
165:     const provider = new IsolatedLoadedProvider(verifiedSnapshot(entry, workspaceRoot, invocation.attemptId), invocation, workspaceRoot, this.#policy);
166:     if (signal.aborted) { await provider.discard(); throw signal.reason ?? new Error('TEST_PROVIDER_CANCELLED'); }
167:     return provider;
168:   }
169: }

