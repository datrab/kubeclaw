1: import type { ProviderInvocationV1, ResolvedPlanNodeV1 } from '@kubeclaw/pipeline-test-gate-contract';
2: import type { WorkerAttemptEnvelopeV1 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { sha256Digest, workerAttemptSpecDigest, type WorkerAttemptOperation } from '@kubeclaw/worker-core';
4: import { createBusterWorkerProfile } from './runner-worker-profile.ts';
5: import type { TestPlanRunnerOptions } from './runner-types.ts';
6: interface EnvelopeInput {
7:  readonly options: TestPlanRunnerOptions;
8:  readonly node: ResolvedPlanNodeV1;
9:  readonly attemptId: string;
10:  readonly attemptNumber: number;
11:  readonly granted: readonly string[];
12:  readonly cleanupTimeoutMs: number;
13:  readonly providerResultLimit: number;
14:  readonly invocation: ProviderInvocationV1;
15:  readonly operation: WorkerAttemptOperation;
16:  readonly issuedAt: Date;
17: }
18: function envelopeLimits(node: ResolvedPlanNodeV1, cleanupTimeoutMs: number, providerResultLimit: number, reportResultLimit: number, workerResultWrapperBytes: number) {
19:  return {
20:         timeoutMs: node.timeoutMs,
21:         cleanupTimeoutMs,
22:         cpuMillis: node.limits.cpuMillis,
23:         memoryBytes: node.limits.memoryBytes,
24:         processes: node.limits.processes,
25:         logBytes: node.limits.logBytes,
26:         resultBytes: providerResultLimit + reportResultLimit + workerResultWrapperBytes,
27:         evidenceBytes: node.limits.artifactBytes,
28:         evidenceFiles: node.limits.artifactFiles,
29:       };
30: }
31: function envelopeOperation(invocation: ProviderInvocationV1) {
32:  return {
33:         contractId: "kubeclaw.buster-provider-attempt@1",
34:         inputSchemaId: "kubeclaw.buster-provider-attempt.v1",
35:         inputSchemaDigest: sha256Digest({
36:           schemaId: "kubeclaw.buster-provider-attempt.v1",
37:         }),
38:         values: { invocation: structuredClone(invocation) } as never,
39:       };
40: }
41: export function createRunnerEnvelope(input: EnvelopeInput): WorkerAttemptEnvelopeV1 {
42:  const { options, node, attemptId, attemptNumber, granted, cleanupTimeoutMs, providerResultLimit,
43:    invocation, operation, issuedAt } = input;
44:     const profile = createBusterWorkerProfile(options.registry, granted);
45:     const completionPhases = 3 + Number(Boolean(operation.cleanup)) + Number(Boolean(operation.collectEvidence)) + Number(Boolean(operation.finalizeResult));
46:     const claimWindowMs = node.timeoutMs + completionPhases * cleanupTimeoutMs + options.executionPolicy.provider.claimGraceMs;
47:     const envelopeBase = {
48:       schemaVersion: "worker-attempt-envelope.v1" as const,
49:       protocolVersion: "worker-protocol.v1" as const,
50:       pipelineRunId: options.plan.runId,
51:       moduleId: options.plan.scope.moduleId,
52:       gateId: options.plan.scope.gateId,
53:       planId: options.plan.planId,
54:       nodeId: node.id,
55:       executionId: node.executionId,
56:       attemptId,
57:       attemptNumber,
58:       claim: {
59:         schemaVersion: "attempt-claim.v1" as const,
60:         claimId: `claim:${attemptId}`,
61:         attemptId,
62:         generation: 1,
63:         workerId: "worker:buster:local",
64:         claimedAt: issuedAt.toISOString(),
65:         expiresAt: new Date(issuedAt.getTime() + claimWindowMs).toISOString(),
66:       },
67:       profile,
68:       packages: [
69:         {
70:           packageId: node.provider.packageId,
71:           packageVersion: node.provider.packageVersion,
72:           contentDigest: node.provider.contentDigest,
73:         },
74:       ],
75:       grantedCapabilities: [...granted],
76:       limits: envelopeLimits(node, cleanupTimeoutMs, providerResultLimit, options.executionPolicy.reports.maximumAggregateResultBytes, options.executionPolicy.provider.workerResultWrapperBytes),
77:       inputs: [],
78:       operation: envelopeOperation(invocation),
79:       cancellationId: `cancel:${attemptId}`,
80:       issuedAt: issuedAt.toISOString(),
81:       queueDeadline: new Date(issuedAt.getTime() + options.executionPolicy.provider.queueTimeoutMs).toISOString(),
82:     };
83:     const workerEnvelope: WorkerAttemptEnvelopeV1 = {
84:       ...envelopeBase,
85:       attemptSpecDigest: workerAttemptSpecDigest({
86:         ...envelopeBase,
87:         attemptSpecDigest: "",
88:       }),
89:     };
90:  return workerEnvelope;
91: }

