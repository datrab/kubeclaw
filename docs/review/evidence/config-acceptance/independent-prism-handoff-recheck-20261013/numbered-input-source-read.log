151:   async createDirectionSet(projectKey: string, generationId: string, designs: readonly { key: string; title: string; summary: string; document: PrismDocument; evidence?: Record<string, unknown> }[], agent?:AgentCompletion) {
152:     if (designs.length !== 3 || new Set(designs.map(item => item.key)).size !== 3
153:       || designs.some(item => !item.key || !item.title || !item.summary || item.document.meta.projectId !== projectKey)) throw new Error("invalid Prism design set");
154:     return inTransaction(this.db, async connection => {
155:       const project = await connection.query<{ id: string }>("SELECT id FROM prism.project WHERE external_id=$1 FOR UPDATE", [projectKey]);
156:       if (!project.rows[0]) throw new Error("active Prism project not found");
157:       const projectId = project.rows[0].id;
158:       if(agent){const replay=await lockAgentResult(connection,agent,generationId);if(replay)return replay as {status:string;projectId:string;documentId:string;directions:Array<{directionId:string;documentId:string;key:string}>};}
159:       const resultDigest = digest(JSON.stringify(designs));
160:       const bound = await boundDesignRound(connection,projectId,generationId,resultDigest);
161:       if (bound.replay) return bound.replay as {status: string; projectId: string; documentId: string; directions: Array<{directionId:string;documentId:string;key:string}>};
162:       const requestId = bound.requestId;
163:       const directions = [];
164:       for (const item of designs) {
165:         const documentId = await insertDocument(connection, projectId, `direction-${generationId}-${item.key}`, item.document, 'agent:prism', requestId);
166:         await connection.query("UPDATE prism.design_document SET design_round_id=$2 WHERE id=$1",[documentId,generationId]);
167:         const current = await new RevisionRepository(connection).current(documentId);
168:         const directionId = randomUUID();
169:         const content = JSON.stringify(item.document);
170:         await connection.query("INSERT INTO prism.direction(id,project_id,source_document_id,source_revision_id,direction_key,title,summary,proposal,content_digest,state,evidence) VALUES($1,$2,$3,$4,$5,$6,$7,$8::jsonb,$9,'proposed',$10::jsonb)",
171:           [directionId, projectId, documentId, current.id, item.key, item.title, item.summary, content, digest(content), JSON.stringify(item.evidence ?? {})]);
172:         directions.push({ directionId, documentId, key: item.key });
173:       }
174:       const result = { status: 'created', generationId, projectId, documentId: directions[0]!.documentId, directions };
175:       await connection.query("UPDATE prism.design_round SET result_digest=$2,result=$3::jsonb WHERE id=$1",[generationId,resultDigest,JSON.stringify(result)]);
176:       if(agent)await recordAgentResult(connection,agent,result);
177:       return result;
178:     });
179:   }
180:   async current(
181:     documentId: string,
182:   ): Promise<{ id: string; document: PrismDocument }> {
183:     const result = await this.db.query<{ id: string; content: PrismDocument }>(
184:       "SELECT r.id,r.content FROM prism.design_document d JOIN prism.design_revision r ON r.id=d.current_revision_id WHERE d.id=$1",
185:       [documentId],
186:     );
187:     if (!result.rows[0]) throw new Error("document not found");
188:     return { id: result.rows[0].id, document: result.rows[0].content };
189:   }
190:   async revision(
191:     documentId: string,
192:     revision: number,
193:   ): Promise<{ id: string; document: PrismDocument }> {
194:     const result = await this.db.query<{ id: string; content: PrismDocument }>(
195:       "SELECT id,content FROM prism.design_revision WHERE document_id=$1 AND revision=$2",
196:       [documentId, revision],
197:     );
198:     if (!result.rows[0]) throw new Error("design revision not found");
199:     return { id: result.rows[0].id, document: result.rows[0].content };
200:   }
201:   async includesOperation(
202:     documentId: string,
203:     idempotencyKey: string,
204:   ): Promise<boolean> {
205:     const result = await this.db.query(
206:       "SELECT id FROM prism.design_revision WHERE document_id=$1 AND operation->>'idempotencyKey'=$2 LIMIT 1",
207:       [documentId, idempotencyKey],
208:     );
209:     return Boolean(result.rows[0]);
210:   }
211:   async history(
212:     documentId: string,
213:   ): Promise<
214:     Array<{
215:       id: string;
216:       revision: number;
217:       createdAt: string;
218:       createdBy: string;
219:       operation: Record<string, unknown> | null;
220:     }>
221:   > {
222:     const result = await this.db.query<{
223:       id: string;
224:       revision: number;
225:       created_at: string;
226:       created_by: string;
227:       operation: Record<string, unknown> | null;
228:     }>(
229:       "SELECT id,revision,created_at::text,created_by,operation FROM prism.design_revision WHERE document_id=$1 ORDER BY created_at DESC,id DESC",
230:       [documentId],
231:     );
232:     return result.rows.map((row) => ({
233:       id: row.id,
234:       revision: row.revision,
235:       createdAt: row.created_at,
236:       createdBy: row.created_by,
237:       operation: row.operation,
238:     }));
239:   }
240:   async restore(
241:     documentId: string,
242:     revisionId: string,
243:     user: string,
244:   ): Promise<PrismDocument> {
245:     const source = await this.db.query<{ content: PrismDocument }>(
246:       "SELECT content FROM prism.design_revision WHERE id=$1 AND document_id=$2",
247:       [revisionId, documentId],
248:     );
249:     if (!source.rows[0]) throw new Error("revision not found");
250:     const current = await this.current(documentId);
251:     const next = structuredClone(source.rows[0].content);
252:     next.meta.revision = current.document.meta.revision + 1;
253:     next.meta.updatedAt = new Date().toISOString();
254:     return this.replace(
255:       documentId,
256:       current.id,
257:       next,
258:       { type: "revision.restored", sourceRevisionId: revisionId },
259:       user,
260:     );
261:   }
262:   async apply(
263:     documentId: string,
264:     operation: PrismOperation,
265:     user: string,
266:   ): Promise<PrismDocument> {
267:     return inTransaction(this.db, async (connection) => {
268:       const current = await new RevisionRepository(connection).current(documentId);
269:       const next = applyOperation(current.document, operation);
270:       const id = randomUUID();
271:       const content = JSON.stringify(next);
272:       await connection.query(
273:         "INSERT INTO prism.design_revision(id,document_id,revision,schema_id,content,content_digest,parent_revision_id,operation,created_by) VALUES($1,$2,$3,$4,$5::jsonb,$6,$7,$8::jsonb,$9)",
274:         [
275:           id,
276:           documentId,
277:           next.meta.revision,
278:           next.meta.schema,
279:           content,
280:           digest(content),
281:           current.id,
282:           JSON.stringify(operation),
283:           user,
284:         ],
285:       );
286:       const updated = await connection.query(
287:         "UPDATE prism.design_document SET current_revision_id=$1 WHERE id=$2 AND current_revision_id=$3 RETURNING id",
288:         [id, documentId, current.id],
289:       );
290:       if (!updated.rows[0]) throw new Error("revision conflict");
291:       return next;
292:     });
293:   }
294:   async replace(
295:     documentId: string,
296:     expectedRevisionId: string,
297:     document: PrismDocument,
298:     operation: Record<string, unknown>,
299:     user: string,
300:     agent?:AgentCompletion,
301:   ): Promise<PrismDocument> {
302:     return inTransaction(this.db, async (connection) => {
303:       if(agent){const replay=await lockAgentResult(connection,agent,String(operation.generationId));if(replay)return replay as PrismDocument;}
304:       const current = await new RevisionRepository(connection).current(documentId);
305:       if (current.id !== expectedRevisionId)
306:         throw new Error("revision conflict");
307:       const id = randomUUID();
308:       const content = JSON.stringify(document);
309:       await connection.query(
310:         "INSERT INTO prism.design_revision(id,document_id,revision,schema_id,content,content_digest,parent_revision_id,operation,created_by) VALUES($1,$2,$3,$4,$5::jsonb,$6,$7,$8::jsonb,$9)",
311:         [
312:           id,
313:           documentId,
314:           document.meta.revision,
315:           document.meta.schema,
316:           content,
317:           digest(content),
318:           current.id,
319:           JSON.stringify(operation),
320:           user,
321:         ],
322:       );
323:       const updated = await connection.query(
324:         "UPDATE prism.design_document SET current_revision_id=$1 WHERE id=$2 AND current_revision_id=$3 RETURNING id",
325:         [id, documentId, current.id],
326:       );
327:       if (!updated.rows[0]) throw new Error("revision conflict");
328:       if(agent)await recordAgentResult(connection,agent,document);
329:       return document;
330:     });
331:   }
332: }
