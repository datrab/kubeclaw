1: import { createHash } from "node:crypto";
2: import type { PrismDocument } from "@kubeclaw/prism-contracts-v1";
3: import { validatePrism } from "@kubeclaw/prism-contracts-v1";
4: import { applyOperation, type PrismOperation } from "../domain/index.ts";
5: import { evaluate } from "../evaluation/index.ts";
6: import {
7:   EngineExecutionCache,
8:   type EngineCacheLimits,
9: } from "./execution-cache.ts";
10: import { renderOperation } from "./render-operation.ts";
11: 
12: export type EngineOperation =
13:   "generate" | "render" | "evaluate" | "ingest" | "publish";
14: export type EngineRequest = {
15:   contract: "kubeclaw.prism-design-engine@1";
16:   operation: EngineOperation;
17:   input: Record<string, unknown>;
18:   idempotencyKey: string;
19: };
20: export type EngineResult = {
21:   operation: EngineOperation;
22:   output: Record<string, unknown>;
23: };
24: export interface DesignProvider {
25:   propose(
26:     document: PrismDocument,
27:     instruction: string,
28:     signal?: AbortSignal,
29:   ): Promise<PrismOperation[]>;
30:   embed(
31:     text: string,
32:     signal?: AbortSignal,
33:   ): Promise<{ embedding: number[]; model: string; modelVersion: string }>;
34: }
35: const hash = (value: string) =>
36:   `sha256:${createHash("sha256").update(value).digest("hex")}`;
37: function exactInput(
38:   input: Record<string, unknown>,
39:   allowed: readonly string[],
40:   required: readonly string[],
41: ): void {
42:   for (const key of Object.keys(input))
43:     if (!allowed.includes(key))
44:       throw new Error(`unsupported Prism input field: ${key}`);
45:   for (const key of required)
46:     if (!(key in input)) throw new Error(`missing Prism input field: ${key}`);
47: }
48: 
49: function validateOperationInput(request: EngineRequest): void {
50:   if (request.operation === "generate")
51:     exactInput(
52:       request.input,
53:       ["document", "instruction", "mode"],
54:       ["document", "instruction"],
55:     );
56:   else if (request.operation === "render")
57:     exactInput(
58:       request.input,
59:       ["document", "view", "state", "viewport", "capture", "assetSources"],
60:       ["document", "view", "state", "viewport"],
61:     );
62:   else if (request.operation === "evaluate")
63:     exactInput(request.input, ["document"], ["document"]);
64:   else if (request.operation === "ingest")
65:     exactInput(request.input, ["text"], ["text"]);
66:   else exactInput(request.input, ["document", "approved"], ["document"]);
67: }
68: 
69: export class PrismEngine {
70:   private readonly provider: DesignProvider;
71:   private readonly executions: EngineExecutionCache<EngineResult>;
72:   constructor(provider: DesignProvider, cacheLimits?: EngineCacheLimits) {
73:     this.provider = provider;
74:     this.executions = new EngineExecutionCache(cacheLimits);
75:   }
76:   cacheUsage() {
77:     return this.executions.usage();
78:   }
79:   async execute(
80:     request: EngineRequest,
81:     options: { signal?: AbortSignal } = {},
82:   ): Promise<EngineResult> {
83:     const owner = options.signal;
84:     owner?.throwIfAborted();
85:     if (request.contract !== "kubeclaw.prism-design-engine@1")
86:       throw new Error("unsupported Prism engine contract");
87:     // Bind deferred execution to the same caller-independent input as its identity.
88:     const ownedRequest = structuredClone(request);
89:     const fingerprint = hash(
90:       JSON.stringify({
91:         operation: ownedRequest.operation,
92:         input: ownedRequest.input,
93:       }),
94:     );
95:     return this.executions.execute(
96:       ownedRequest.idempotencyKey,
97:       fingerprint,
98:       () => this.executeOnce(ownedRequest, owner),
99:       owner,
100:     );
101:   }
102:   private async ingest(
103:     input: Record<string, unknown>,
104:     signal?: AbortSignal,
105:   ): Promise<EngineResult> {
106:     const text = String(input.text ?? "").trim();
107:     if (!text || text.length > 200_000)
108:       throw new Error("ingest text length is invalid");
109:     const embedded = await this.provider.embed(text, signal);
110:     if (
111:       !embedded.embedding.length ||
112:       embedded.embedding.some((value) => !Number.isFinite(value))
113:     )
114:       throw new Error("embedding provider returned an invalid vector");
115:     return {
116:       operation: "ingest",
117:       output: { ...embedded, sourceDigest: hash(text) },
118:     };
119:   }
120:   private async executeOnce(
121:     request: EngineRequest,
122:     signal?: AbortSignal,
123:   ): Promise<EngineResult> {
124:     signal?.throwIfAborted();
125:     validateOperationInput(request);
126:     if (request.operation === "ingest")
127:       return this.ingest(request.input, signal);
128:     const document = request.input.document as PrismDocument;
129:     validatePrism<PrismDocument>("designDocument", document);
130:     let result: EngineResult;
131:     if (request.operation === "generate") {
132:       const operations = await this.provider.propose(
133:         document,
134:         String(request.input.instruction ?? ""),
135:         signal,
136:       );
137:       const next = operations.reduce(
138:         (current, operation) =>
139:           applyOperation(current, {
140:             ...operation,
141:             baseRevision: current.meta.revision,
142:           } as PrismOperation),
143:         document,
144:       );
145:       result = {
146:         operation: "generate",
147:         output: {
148:           document: next,
149:           operations,
150:           mode: String(request.input.mode ?? "refine"),
151:         },
152:       };
153:     } else if (request.operation === "render") {
154:       result = await renderOperation(document, request.input, signal);
155:     } else if (request.operation === "evaluate") {
156:       const report = evaluate(document);
157:       result = {
158:         operation: "evaluate",
159:         output: report,
160:       };
161:     } else {
162:       if (request.input.approved !== true)
163:         throw new Error("explicit approval is required");
164:       const canonical = JSON.stringify(document);
165:       const manifest = {
166:         schema: "prism.baseline-bundle.v1",
167:         projectId: document.meta.projectId,
168:         revision: document.meta.revision,
169:         designDigest: hash(canonical),
170:       };
171:       result = {
172:         operation: "publish",
173:         output: { manifest, bundleDigest: hash(JSON.stringify(manifest)) },
174:       };
175:     }
176:     return result;
177:   }
178: }
