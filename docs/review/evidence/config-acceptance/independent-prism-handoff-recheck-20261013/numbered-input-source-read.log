{"path": "skills/prism/storage/artifacts.ts", "sha256": "8177fe9d5199d1af866a2ad7d5d7fdfa82b99b0fe6df5b7f0c3c04e96536ef1f"}
1: import { createHash, randomUUID } from 'node:crypto';
2: import { constants } from 'node:fs';
3: import { link, mkdir, open, unlink } from 'node:fs/promises';
4: import { dirname, join, resolve } from 'node:path';
5: 
6: const digest = (value: Uint8Array): string => `sha256:${createHash('sha256').update(value).digest('hex')}`;
7: 
8: async function syncDirectory(directory: string): Promise<void> {
9:   const handle = await open(directory, constants.O_RDONLY | constants.O_DIRECTORY);
10:   try { await handle.sync(); } finally { await handle.close(); }
11: }
12: async function ensureDurableDirectory(directory: string): Promise<void> {
13:   await mkdir(directory, { recursive: true });
14:   // Also cover another concurrent creator that has not yet synced its parent.
15:   for (let current = resolve(directory);;) {
16:     await syncDirectory(current);
17:     const parent = dirname(current); if (parent === current) return; current = parent;
18:   }
19: }
20: async function verifiedBytes(file: string, expectedDigest: string, durable = false): Promise<Buffer> {
21:   const handle = await open(file, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
22:   try {
23:     if (!(await handle.stat()).isFile()) throw new Error('PRISM_ARTIFACT_NOT_REGULAR');
24:     const bytes = await handle.readFile();
25:     if (digest(bytes) !== expectedDigest) throw new Error(`PRISM_ARTIFACT_CORRUPT:${expectedDigest}`);
26:     // An existing object's presence alone is not a durable acknowledgement.
27:     if (durable) await handle.sync(); return bytes;
28:   } finally { await handle.close(); }
29: }
30: 
31: async function removePending(pending: string, directory: string, failure: unknown): Promise<void> {
32:   try { await unlink(pending); await syncDirectory(directory); }
33:   catch (error) {
34:     if (failure) throw new AggregateError([failure, error], 'PRISM_ARTIFACT_PENDING_CLEANUP_FAILED', { cause: failure });
35:     throw error;
36:   }
37: }
38: 
39: export class ContentAddressedArtifactStore {
40:   readonly #root: string;
41:   constructor(root: string) { this.#root = resolve(root); }
42: 
43:   async put(content: Uint8Array): Promise<{ artifactId: string; digest: string; sizeBytes: number }> {
44:     // Take ownership before the first await; callers may reuse their buffer.
45:     const bytes = Buffer.from(content); const contentDigest = digest(bytes); const hex = contentDigest.slice(7);
46:     const file = join(this.#root, hex.slice(0, 2), hex); const directory = dirname(file);
47:     await ensureDurableDirectory(directory);
48:     const pending = `${file}.${randomUUID()}.pending`; let created = false; let failure: unknown;
49:     try {
50:       const handle = await open(pending, 'wx', 0o600); created = true;
51:       try { await handle.writeFile(bytes); await handle.sync(); } finally { await handle.close(); }
52:       try { await link(pending, file); }
53:       catch (error) {
54:         if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
55:         await verifiedBytes(file, contentDigest, true);
56:       }
57:       await syncDirectory(directory);
58:       return { artifactId: `artifact:${contentDigest}`, digest: contentDigest, sizeBytes: bytes.byteLength };
59:     } catch (error) { failure = error; throw error; }
60:     finally { if (created) await removePending(pending, directory, failure); }
61:   }
62: 
63:   async get(artifactId: string): Promise<Uint8Array> {
64:     const match = /^artifact:sha256:([a-f0-9]{64})$/u.exec(artifactId);
65:     if (!match) throw new Error('invalid artifact ID');
66:     return verifiedBytes(join(this.#root, match[1]!.slice(0, 2), match[1]!), `sha256:${match[1]}`);
67:   }
68: }
