9: /** The same Prism lifecycle runs inside the dedicated native host. */
10: export function nativeOperationFor(envelope: WorkerAttemptEnvelopeV3, engine: PrismEngine,
11:   artifacts: WorkerArtifactClient, scope: string): WorkerAttemptOperation<WorkerAttemptEnvelopeV3> {
12:   const operation = new PrismWorkerOperation(envelope, engine, artifacts);
13:   return {
14:     prepare: limits => operation.prepare(limits), execute: context => operation.execute(context),
15:     terminate: () => operation.terminate(),
16:     async measure({ signal }) {
17:       signal.throwIfAborted();
18:       const resources = observeNativeWorkerResources(scope);
19:       return { cpuTimeMs: { status: 'observed', value: Math.ceil(resources.cpuTimeMicroseconds / 1000) },
20:         maximumMemoryBytes: { status: 'observed', value: resources.maximumMemoryBytes },
21:         maximumTasks: { status: 'observed', value: resources.maximumTasks } };
22:     },
23:   };
24: }
25: 
26: export class PrismWorkerOperation implements Omit<WorkerAttemptOperation<WorkerAttemptEnvelopeV3>, 'measure'> {
27:   private prepared = false;
28:   private terminated = false;
29:   private readonly controller = new AbortController();
30:   private execution: Promise<WorkerAttemptOperationResult> | undefined;
31:   private settlement: Promise<{ ok: true } | { ok: false; error: unknown }> | undefined;
32:   private readonly envelope: WorkerAttemptEnvelopeV3;
33:   private readonly engine: PrismEngine;
34:   private readonly artifacts: WorkerArtifactClient;
35:   constructor(envelope: WorkerAttemptEnvelopeV3, engine: PrismEngine, artifacts: WorkerArtifactClient) {
36:     this.envelope = envelope; this.engine = engine; this.artifacts = artifacts;
37:   }
38:   prepare(_limits: WorkerAttemptLimitsV2) {
39:     if (this.prepared || this.terminated) throw new Error('Prism attempt cannot be prepared again');
40:     this.prepared = true;
41:     return undefined;
42:   }
43:   execute(context: Pick<WorkerAttemptContext, 'signal' | 'log'>) {
44:     if (this.execution) throw new Error('Prism attempt execution already started');
45:     const signal = AbortSignal.any([context.signal, this.controller.signal]);
46:     this.execution = this.run({ ...context, signal });
47:     this.settlement = this.execution.then(() => ({ ok: true as const }),
48:       (error: unknown) => ({ ok: false as const, error }));
49:     return this.execution;
50:   }
51:   async terminate() {
52:     this.terminated = true;
53:     this.controller.abort(new Error('Prism attempt terminated'));
54:     // Core bounds this drain and reports unresolved work; do not detach I/O.
55:     const settled = await this.settlement;
56:     if (settled && !settled.ok && settled.error instanceof PrismBrowserCloseError) throw settled.error;
57:   }
58:   private async run(context: Pick<WorkerAttemptContext, 'signal' | 'log'>) {
59:     if (!this.prepared || this.terminated || context.signal.aborted)
60:       throw new Error("Prism attempt cannot start");
61:     if (this.envelope.operation.values.operation === "generate")
62:       throw new Error("Prism generation requires the OpenClaw agent gateway");
63:     context.log(
64:       "system",
65:       `Prism ${String(this.envelope.operation.values.operation)} operation started`,
66:     );
67:     const hydratedInput = await readInput(this.envelope, this.artifacts, context.signal);
68:     const specialistResult = await executePrismOperation(
69:       this.engine,
70:       this.envelope.operation,
71:       this.envelope.executionId,
72:       hydratedInput,
73:       context.signal,
74:     );
75:     if (this.terminated || context.signal.aborted)
76:       throw new Error("Prism attempt was cancelled");
77:     const values={...specialistResult.values};const evidence=[];
78:     if(typeof values.screenshotBase64==="string"){evidence.push(await this.artifacts.upload("render-screenshot","preview","image/png",Buffer.from(values.screenshotBase64,"base64"), context.signal));delete values.screenshotBase64;}
79:     if(typeof values.ariaSnapshot==="string"){evidence.push(await this.artifacts.upload("render-aria","accessibility-tree","text/plain",Buffer.from(values.ariaSnapshot), context.signal));delete values.ariaSnapshot;}
80:     const boundedResult={...specialistResult,values};
81:     return {
82:       summary: "Prism operation completed",
83:       specialistResult:boundedResult,
84:       evidence,
85:       exitCode: 0,
86:       signal: null,
87:     };
88:   }
89: }
90: 
91: async function readInput(envelope: WorkerAttemptEnvelopeV3, artifacts: WorkerArtifactClient,
92:   signal: AbortSignal): Promise<Record<string, unknown>> {
93:   const inputName = String(envelope.operation.values.inputName ?? '');
94:   const declared = envelope.inputs.find((item) => item.name === inputName && item.kind === 'artifact');
95:   if (!declared || declared.kind !== 'artifact' || declared.artifact.mediaType !== 'application/json'
96:     || declared.artifact.type !== 'prism-engine-input') throw new Error('Prism input artifact is missing or invalid');
97:   const bytes = await artifacts.read(declared.artifact, signal);
98:   return JSON.parse(bytes.toString('utf8')) as Record<string, unknown>;
99: }
