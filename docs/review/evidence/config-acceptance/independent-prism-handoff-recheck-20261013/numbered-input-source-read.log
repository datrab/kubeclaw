{"path": "skills/prism/studio/round-response.ts", "sha256": "cf0e058fabff7de650214209111370ba43358c894bf24719d7e13297ba2448d0"}
1: /** Preserve Control's private response diagnostics while checking the expected JSON contract. */
2: export async function roundResponse<T>(response: Response, operation: string,
3:   valid: (value: unknown) => boolean, expected: string): Promise<T> {
4:   const body=await response.text();
5:   const context=`${operation}: HTTP ${response.status} ${response.statusText}`.trim();
6:   if(!response.ok)throw new Error(`${context}: ${body || '(empty response body)'}`);
7:   let value:unknown;
8:   try {value=JSON.parse(body);} catch(error) {
9:     throw new Error(`${context}: invalid JSON response (${error instanceof Error ? error.message : String(error)}); body: ${body}`,{cause:error});
10:   }
11:   if(!valid(value))throw new Error(`${context}: invalid response contract; expected ${expected}; body: ${body}`);
12:   return value as T;
13: }
14: export function responseObject(value:unknown):value is Record<string,unknown> {
15:   return value!==null && typeof value==='object' && !Array.isArray(value);
16: }
