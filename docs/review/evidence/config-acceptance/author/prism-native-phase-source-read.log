1: import {
2:   validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3,
3: } from '@kubeclaw/pipeline-worker-core-contract';
4: import { runNativeWorkerProcess, type NativeWorkerProcessOptions } from './native-worker-process.ts';
5: import { NativeWorkerAttemptBusy, type NativeAttemptJournal } from './native-attempt-journal.ts';
6: import { NativeWorkerOutputSpool } from './native-output-spool.ts';
7: import { journalIdentity } from './native-journal-state.ts';
8: import { finalizeNativeWorkerResult, interruptedNativeWorkerResult } from './native-result.ts';
9: import { recoverNativeAttempt } from './native-attempt-recovery.ts';
10: import { NativeWorkerCapacityExceeded } from './resource-reservations.ts';
11: 
12: export interface NativeWorkerAttemptExecutorOptions {
13:   readonly envelope: WorkerAttemptEnvelopeV3;
14:   readonly journal: NativeAttemptJournal;
15:   readonly process: Omit<NativeWorkerProcessOptions, 'identity' | 'input' | 'outputCapture'>;
16: }
17: 
18: class NativeAdmissionRejected extends Error {}
19: 
20: /** A fsynced identity precedes launch; a fsynced sealed receipt precedes delivery. */
21: export async function executeNativeWorkerAttempt(options: NativeWorkerAttemptExecutorOptions): Promise<WorkerAttemptResultV3> {
22:   validateWorkerResourceContractV3('workerAttemptEnvelope', options.envelope);
23:   try {
24:     const result = await options.journal.withAttempt(options.envelope, async context => {
25:       const envelope = context.envelope;
26:       const cached = await options.journal.readResult(envelope);
27:       if (cached) return cached;
28:       const started = new Date(context.acceptedAt);
29:       const recovered = await recoverNativeAttempt(options.journal, options.process.owner, envelope, started, context.newlyAccepted);
30:       if (recovered) return options.journal.seal(envelope, recovered);
31:       const limits = launchLimits(options, envelope);
32:       if (limits instanceof NativeAdmissionRejected) {
33:         // Admission was persisted, but the claim expired before launch. The
34:         // ownership lookup above proved that no process crossed that boundary.
35:         return options.journal.seal(envelope, interruptedNativeWorkerResult(envelope, started, limits.message, null, true));
36:       }
37:       const spool = await NativeWorkerOutputSpool.create(context.outputRoot, limits.maximumOutputBytes);
38:       try {
39:         const process = await runNativeWorkerProcess({ ...options.process, limits, outputCapture: spool,
40:           identity: journalIdentity(envelope), input: Buffer.from(JSON.stringify(envelope)) });
41:         const completed = new Date();
42:         await spool.flush();
43:         await options.journal.recordProcess(envelope, process, completed);
44:         return await options.journal.seal(envelope, finalizeNativeWorkerResult(envelope, process, started, completed));
45:       } catch (error) {
46:         if (!(error instanceof NativeWorkerCapacityExceeded)) throw error;
47:         if (await options.process.owner.record(journalIdentity(envelope))) throw new Error('WORKER_NATIVE_CAPACITY_REJECTION_OWNERSHIP_CONFLICT');
48:         // Aggregate admission rejected before the durable owner reservation.
49:         // Preserve this accepted attempt as an explicit never-launched failure.
50:         return await options.journal.seal(envelope, interruptedNativeWorkerResult(envelope, started, error.message, null, true));
51:       } finally { await spool.close(); }
52:     }, envelope => { acceptedLimits(options, envelope, new Date()); });
53:     if (result.cleanup.state === 'failed') options.process.owner.fenceAdmission();
54:     return result;
55:   } catch (error) {
56:     if (error instanceof NativeWorkerAttemptBusy || error instanceof NativeAdmissionRejected) throw error;
57:     // Persistence or ownership uncertainty cannot permit a later admission.
58:     options.process.owner.fenceAdmission();
59:     throw error;
60:   }
61: }
62: 
63: function launchLimits(options: NativeWorkerAttemptExecutorOptions, envelope: WorkerAttemptEnvelopeV3) {
64:   try { return acceptedLimits(options, envelope, new Date()); }
65:   catch (error) { if (error instanceof NativeAdmissionRejected) return error; throw error; }
66: }
67: 
68: function acceptedLimits(options: NativeWorkerAttemptExecutorOptions, envelope: WorkerAttemptEnvelopeV3, started: Date) {
69:   const limits = options.process.limits;
70:   const accepted = { cpuTimeMs: limits.cpuTimeMs, maximumMemoryBytes: limits.memoryBytes, maximumTasks: limits.tasks };
71:   for (const [metric, maximum] of Object.entries(accepted)) {
72:     const budget = envelope.resourceBudgets[metric as keyof typeof accepted];
73:     if (budget.state !== 'requested' || budget.limit !== maximum) throw new NativeAdmissionRejected('WORKER_NATIVE_ACCEPTED_LIMIT_MISMATCH');
74:   }
75:   const claimRemaining = Date.parse(envelope.claim.expiresAt) - started.getTime();
76:   if (started.getTime() < Date.parse(envelope.claim.claimedAt) || claimRemaining <= 0
77:     || started.getTime() >= Date.parse(envelope.queueDeadline)) throw new NativeAdmissionRejected('WORKER_NATIVE_CLAIM_NOT_ACTIVE');
78:   return { ...limits, timeoutMs: Math.min(limits.timeoutMs, claimRemaining) };
79: }
