116: function freeze<T>(value: T): T {
117:   if (!value || typeof value !== 'object') return value;
118:   for (const child of Object.values(value as Record<string, unknown>)) freeze(child);
119:   return Object.isFrozen(value) ? value : Object.freeze(value);
120: }
