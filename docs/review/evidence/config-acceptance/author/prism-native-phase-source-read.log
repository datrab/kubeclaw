187: function validateEnvelopeDigests(envelope: WorkerAttemptEnvelope): void {
188:   if(envelope.schemaVersion==='worker-attempt-envelope.v3')validateWorkerResourceContractV3('workerAttemptEnvelope',envelope);
189:   else if(envelope.schemaVersion==='worker-attempt-envelope.v2')validateWorkerResourceContractV2('workerAttemptEnvelope',envelope);
190:   else validatePipelineWorkerCoreContract('workerAttemptEnvelope', envelope);
191: }
192: 
193: function receipt(namespace: string, nonce: string, resultDigest: string) {
194:   const receiptId = `receipt:${crypto.createHash('sha256').update(`${namespace}:${nonce}:${resultDigest}`).digest('hex')}`;
195:   return { receiptId, receiptDigest: sha256Digest({ namespace, receiptId, resultDigest }) };
196: }
197: 
198: function checkEvidence(evidence: readonly WorkerEvidenceRefV1[], envelope: WorkerAttemptEnvelope): void {
199:   if (evidence.length > envelope.limits.evidenceFiles) throw new AttemptFault('errored', 'WORKER_EVIDENCE_FILE_LIMIT');
200:   const ids = new Set<string>();
201:   let total = 0;
202:   for (const item of evidence) {
203:     validatePipelineWorkerCoreContract('workerEvidenceRef', item);
204:     if (ids.has(item.evidenceId)) throw new AttemptFault('errored', 'WORKER_EVIDENCE_ID_DUPLICATE');
205:     ids.add(item.evidenceId);
206:     total += item.artifact.sizeBytes;
207:     if (total > envelope.limits.evidenceBytes) throw new AttemptFault('errored', 'WORKER_EVIDENCE_BYTE_LIMIT');
208:   }
209: }
210: 
211: export class WorkerAttemptExecutor<E extends WorkerAttemptEnvelope = WorkerAttemptEnvelopeV1> {
212:   readonly #options: WorkerAttemptExecutorOptions<E>;
213:   readonly #accounting: WorkerResourceAccounting | WorkerNativeResourceAccounting | undefined;
214:   readonly #now: () => Date;
215:   readonly #id: () => string;
216:   #progressSequence = 0;
217:   #logSequence = 0;
218:   #execution: Promise<WorkerAttemptResult> | null = null;
219: 
220:   constructor(options: WorkerAttemptExecutorOptions<E>) {
221:     preflightJson(options.envelope, MAX_ATTEMPT_ENVELOPE_BYTES, 'WORKER_ATTEMPT_INPUT');
222:     const envelope = freeze(structuredClone(options.envelope));
223:     validateEnvelopeDigests(envelope);
224:     if (envelope.limits.logBytes > MAX_ATTEMPT_LOG_BYTES) throw new Error('WORKER_LOG_LIMIT_INVALID');
225:     if (options.receiptNamespace !== undefined
226:       && (options.receiptNamespace.length === 0 || options.receiptNamespace.length > 4096
227:         || options.receiptNamespace !== options.receiptNamespace.toWellFormed())) {
228:       throw new Error('WORKER_RECEIPT_NAMESPACE_INVALID');
229:     }
230:     this.#options = { ...options, envelope };
231:     this.#accounting=envelope.schemaVersion==='worker-attempt-envelope.v3'?initialWorkerNativeResourceAccounting(envelope)
232:       :envelope.schemaVersion==='worker-attempt-envelope.v2'?initialWorkerResourceAccounting(envelope):undefined;
233:     this.#now = options.now ?? (() => new Date());
234:     this.#id = options.id ?? (() => crypto.randomUUID());
235:   }
236: 
237:   async execute(): Promise<WorkerResultFor<E>> {
238:     this.#execution ??= this.#executeOnce();
239:     return this.#execution as Promise<WorkerResultFor<E>>;
240:   }
241: 
242:   async #executeOnce(): Promise<WorkerAttemptResult> {
243:     const { envelope, operation } = this.#options;
244:     const started = this.#now();
245:     if (started.getTime() >= Date.parse(envelope.queueDeadline)) {
246:       // No operation is prepared or started after queue expiry. Zero resource
247:       // use is authoritative here; calling the adapter would violate that rule.
248:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_QUEUE_DEADLINE_EXPIRED'), null, [], {
249:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
250:       }, { state: 'not_required', summary: null });
251:     }
252:     if (started.getTime() >= Date.parse(envelope.claim.expiresAt)) {
253:       // An expired claim owns no work. Do not touch the operation adapter.
254:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_CLAIM_EXPIRED'), null, [], {
255:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
256:       }, { state: 'not_required', summary: null });
257:     }
258:     if (started.getTime() < Date.parse(envelope.claim.claimedAt)) {
259:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_CLAIM_NOT_ACTIVE'), null, [], {
260:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
261:       }, { state: 'not_required', summary: null });
262:     }
263:     const completionPhases = 3 + Number(Boolean(operation.cleanup)) + Number(Boolean(operation.collectEvidence))
264:       + Number(this.#options.retainLogs !== false && Boolean(this.#options.storeFullLog)) + Number(Boolean(operation.finalizeResult));
265:     const requiredClaimWindow = envelope.limits.timeoutMs + (completionPhases * envelope.limits.cleanupTimeoutMs);
266:     if (Date.parse(envelope.claim.expiresAt) - started.getTime() < requiredClaimWindow) {
267:       // The local executor cannot renew a claim. It starts only when the claim
268:       // covers execution, termination, both measurements and every configured completion hook.
269:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_CLAIM_WINDOW_INSUFFICIENT'), null, [], {
270:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
271:       }, { state: 'not_required', summary: null });
272:     }
273: 
274:     const unsupportedBudget = unsupportedWorkerBudget(envelope);
275:     if (unsupportedBudget) return this.#result(started, started,
276:       new AttemptFault('errored', 'WORKER_RESOURCE_MEASUREMENT_UNAVAILABLE', `Requested ${unsupportedBudget} has no declared measurement capability`),
277:       null, [], {logBytes: 0, resultBytes: 0, evidenceBytes: 0}, {state: 'not_required', summary: null});
278:     const controller = new AbortController();
279:     const logParts: WorkerLogPartV1[] = [];
280:     const decoder = new WorkerLogDecoder(envelope.limits.logBytes);
281:     let logPartCount = 0;
282:     let logBytes = 0;
283:     let logClosed = false;
284:     let logFault: AttemptFault | null = null;
285:     let timedOut = false;
286:     let claimExpired = false;
287:     let timer: NodeJS.Timeout | undefined;
288:     let termination: Promise<string | null> | null = null;
289:     const terminate = (): Promise<string | null> => {
290:       termination ??= this.#terminate(operation, envelope.limits.cleanupTimeoutMs);
291:       return termination;
292:     };
293:     const abort = (): void => {
294:       controller.abort(this.#options.signal?.reason ?? new Error('WORKER_ATTEMPT_CANCELLED'));
295:       void terminate();
296:     };
297:     this.#options.signal?.addEventListener('abort', abort, { once: true });
298:     if (this.#options.signal?.aborted) abort();
299:     const log: WorkerAttemptContext['log'] = (stream, value) => {
300:       if (logClosed || logFault) return;
301:       let text: string;
302:       try { text = decoder.decode(stream, value); }
303:       catch (error) { logFault = new AttemptFault('errored', detail(error)); controller.abort(logFault); void terminate(); return; }
304:       if (!text && typeof value !== 'string') return;
305:       let offset = 0;
306:       do {
307:         if (logPartCount >= MAX_ATTEMPT_LOG_PARTS) {
308:           logFault = new AttemptFault('errored', 'WORKER_LOG_LIMIT');
309:           controller.abort(logFault);
310:           void terminate();
311:           return;
312:         }
313:         logPartCount += 1;
314:         let end = Math.min(offset + 65_536, text.length);
315:         if (end < text.length && end > offset && /[\uD800-\uDBFF]/u.test(text[end - 1]!)) end -= 1;
316:         const chunk = text.slice(offset, end);
317:         const rendered = `[${stream}] ${chunk}`;
318:         logBytes += Buffer.byteLength(rendered);
319:         if (logBytes > envelope.limits.logBytes) {
320:           logFault = new AttemptFault('errored', 'WORKER_LOG_LIMIT');
321:           controller.abort(logFault);
322:           void terminate();
323:           return;
324:         }
325:         if (this.#options.retainLogs === false) {
326:           offset = end;
327:           continue;
328:         }
329:         const part = freeze({
330:           schemaVersion: 'worker-log-part.v1' as const,
331:           protocolVersion: envelope.protocolVersion,
332:           attemptId: envelope.attemptId,
333:           claimId: envelope.claim.claimId,
334:           claimGeneration: envelope.claim.generation,
335:           workerId: envelope.claim.workerId,
336:           sequence: this.#logSequence++,
337:           stream,
338:           text: chunk,
339:           contentDigest: sha256Text(chunk),
340:           final: false,
341:           sentAt: this.#now().toISOString(),
342:         });
343:         validatePipelineWorkerCoreContract('workerLogPart', part);
344:         logParts.push(part);
345:         try {
346:           void Promise.resolve(this.#options.onLogPart?.(part)).catch(() => undefined);
347:         } catch {
348:           // Live delivery is best effort. The full log is stored before completion.
349:         }
350:         offset = end;
351:       } while (offset < text.length);
352:     };
353: 
354:     let operationResult: WorkerAttemptOperationResult | null = null;
355:     let operationWork: Promise<WorkerAttemptOperationResult> | undefined;
356:     let executionUnresolved = false;
357:     let fault: AttemptFault | null = null;
358:     let cleanup: WorkerAttemptResultV1['cleanup'] = { state: 'not_required', summary: null };
359:     const timeoutAt = started.getTime() + envelope.limits.timeoutMs;
360:     const claimExpiresAt = Date.parse(envelope.claim.expiresAt);
361:     const phases = new WorkerPhaseDeadline(claimExpiresAt, envelope.limits.cleanupTimeoutMs, () => this.#now().getTime(), this.#options.signal);
362:     const clearClaimTimer = armWorkerClaimDeadline(claimExpiresAt, () => this.#now().getTime(), () => {
363:       claimExpired = true; controller.abort(new Error('WORKER_CLAIM_EXPIRED')); void terminate();
364:     });
365:     const deadlineAt = Math.min(timeoutAt, claimExpiresAt);
366:     timer = setTimeout(() => {
367:       claimExpired = claimExpiresAt <= timeoutAt;
368:       timedOut = !claimExpired;
369:       controller.abort(new Error(claimExpired ? 'WORKER_CLAIM_EXPIRED' : 'WORKER_ATTEMPT_TIMEOUT'));
370:       void terminate();
371:     }, Math.max(1, deadlineAt - started.getTime()));
372:     const cancellation = new Promise<never>((_resolve, reject) => {
373:       const rejectCancellation = (): void => {
374:         if (logFault) reject(logFault);
375:         else if (claimExpired) reject(new AttemptFault('interrupted', 'WORKER_CLAIM_EXPIRED'));
376:         else if (timedOut) reject(new AttemptFault('timed_out', 'WORKER_ATTEMPT_TIMEOUT'));
377:         else reject(new AttemptFault('cancelled', 'WORKER_ATTEMPT_CANCELLED'));
378:       };
379:       controller.signal.addEventListener('abort', rejectCancellation, { once: true });
380:     });
381:     try {
382:       if (controller.signal.aborted) throw new AttemptFault('cancelled', 'WORKER_ATTEMPT_CANCELLED');
383:       this.#progress('accepted', 'Attempt accepted.');
384:       this.#progress('started', 'Attempt started.');
385:       const preparationResult = operation.prepare(envelope.limits) as unknown;
386:       if (preparationResult !== undefined) {
387:         if ((typeof preparationResult === 'object' && preparationResult !== null)
388:           || typeof preparationResult === 'function') {
389:           try {
390:             const then = Reflect.get(preparationResult, 'then');
391:             if (typeof then === 'function') void Promise.resolve(preparationResult).catch(() => undefined);
392:           } catch {
393:             // The invalid return is rejected below. A hostile then getter cannot escape.
394:           }
395:         }
396:         throw new AttemptFault('errored', 'WORKER_PREPARATION_INVALID');
397:       }
398:       const preparedAt = this.#now().getTime();
399:       const queueDeadlineAt = Date.parse(envelope.queueDeadline);
400:       const firstDeadlineAt = Math.min(queueDeadlineAt, timeoutAt, claimExpiresAt);
401:       if (preparedAt >= firstDeadlineAt) {
402:         if (queueDeadlineAt === firstDeadlineAt) {
403:           throw new AttemptFault('interrupted', 'WORKER_QUEUE_DEADLINE_EXPIRED');
404:         }
405:         claimExpired = claimExpiresAt === firstDeadlineAt;
406:         timedOut = timeoutAt === firstDeadlineAt && !claimExpired;
407:         controller.abort(new Error(claimExpired ? 'WORKER_CLAIM_EXPIRED' : 'WORKER_ATTEMPT_TIMEOUT'));
408:         await cancellation;
409:       }
410:       const remainingExecutionMs = timeoutAt - preparedAt;
411:       if (claimExpiresAt - preparedAt < remainingExecutionMs + (completionPhases * envelope.limits.cleanupTimeoutMs)) {
412:         throw new AttemptFault('interrupted', 'WORKER_CLAIM_WINDOW_INSUFFICIENT');
413:       }
414:       if (controller.signal.aborted) await cancellation;
415:       operationWork = operation.execute({ attempt: envelope, signal: controller.signal, log });
416:       operationResult = await Promise.race([operationWork, cancellation]);
417:       const operationCompletedAt = this.#now().getTime();
418:       if (operationCompletedAt >= claimExpiresAt && claimExpiresAt <= timeoutAt) {
419:         throw new AttemptFault('interrupted', 'WORKER_CLAIM_EXPIRED');
420:       }
421:       if (operationCompletedAt >= timeoutAt) throw new AttemptFault('timed_out', 'WORKER_ATTEMPT_TIMEOUT');
422:       if (logFault) throw logFault;
423:       preflightJson(operationResult.specialistResult, envelope.limits.resultBytes, 'WORKER_RESULT');
424:       const resultBytes = Buffer.byteLength(JSON.stringify(operationResult.specialistResult));
425:       if (resultBytes > envelope.limits.resultBytes) throw new AttemptFault('errored', 'WORKER_RESULT_LIMIT');
426:       checkEvidence(operationResult.evidence, envelope);
427:       operationResult = freeze(structuredClone(operationResult));
428:       this.#progress('running', 'Attempt operation completed.');
429:     } catch (error) {
430:       operationResult = null;
431:       fault = error instanceof AttemptFault
432:         ? error
433:         : error instanceof Error && /^WORKER_[A-Z0-9_]+$/.test(error.message)
434:           ? new AttemptFault('errored', error.message)
435:         : new AttemptFault(controller.signal.aborted ? (timedOut ? 'timed_out' : 'cancelled') : 'errored',
436:           controller.signal.aborted ? (timedOut ? 'WORKER_ATTEMPT_TIMEOUT' : 'WORKER_ATTEMPT_CANCELLED') : 'WORKER_ATTEMPT_ERROR', detail(error));
437:       const terminationError = await terminate();
438:       if (terminationError) fault = new AttemptFault('errored', 'WORKER_TERMINATION_FAILED', terminationError);
439:       if (operationWork) executionUnresolved = !(await settlesWithin(operationWork, envelope.limits.cleanupTimeoutMs));
440:     } finally {
441:       if (timer) clearTimeout(timer);
442:     }
443: 
444:     if (executionUnresolved) phases.quarantine();
445:     const executionFault = fault;
446:     let measured:unknown;
447:     try {measured=await phases.run('WORKER_RESOURCE_MEASUREMENT',signal=>operation.measure({signal}),Boolean(executionFault));}
448:     catch {measured=undefined;}
449:     let assessment=assessWorkerResources(envelope,measured,this.#accounting);
450:     if(assessment.error && (!fault || assessment.error.code==='WORKER_RESOURCE_MEASUREMENT_INVALID'))fault=new AttemptFault('errored',assessment.error.code,assessment.error.message);
451: 
452:     if (operation.cleanup) {
453:       if (claimExpired || this.#now().getTime() >= claimExpiresAt) await terminate();
454:       this.#progress('cleanup_started', 'Attempt cleanup started.');
455:       try {
456:         await phases.run('WORKER_CLEANUP', signal => operation.cleanup!({ attempt: envelope, signal, log }), true);
457:         cleanup = { state: 'completed', summary: null };
458:         this.#progress('cleanup_completed', 'Attempt cleanup completed.');
459:       } catch (error) {
460:         const terminationError = await terminate();
461:         const message = detail(error);
462:         cleanup = { state: 'failed', summary: message };
463:         fault = new AttemptFault('errored', terminationError ? 'WORKER_TERMINATION_FAILED' : 'WORKER_CLEANUP_FAILED', terminationError ?? message);
464:       }
465:     }
466:     try { decoder.finish(); } catch (error) { logFault = new AttemptFault('errored', detail(error)); }
467: 
468:     if (logFault) fault = logFault;
469: 
470:     // The terminal log snapshot is authoritative. Ignore delayed stream
471:     // callbacks after this point so live delivery and durable evidence agree.
472:     logClosed = true;
473:     if (this.#options.retainLogs !== false && this.#options.onLogPart) {
474:       const finalPart = freeze({
475:         schemaVersion: 'worker-log-part.v1' as const,
476:         protocolVersion: envelope.protocolVersion,
477:         attemptId: envelope.attemptId,
478:         claimId: envelope.claim.claimId,
479:         claimGeneration: envelope.claim.generation,
480:         workerId: envelope.claim.workerId,
481:         sequence: this.#logSequence++,
482:         stream: 'system' as const,
483:         text: '',
484:         contentDigest: sha256Text(''),
485:         final: true,
486:         sentAt: this.#now().toISOString(),
487:       });
488:       validatePipelineWorkerCoreContract('workerLogPart', finalPart);
489:       try {
490:         void Promise.resolve(this.#options.onLogPart(finalPart)).catch(() => undefined);
491:       } catch {
492:         // The terminal result remains authoritative when live delivery fails.
493:       }
494:     }
495:     const fullLog = logParts.map((part) => `[${part.stream}] ${part.text}`).join('');
496:     let evidence = [...(operationResult?.evidence ?? [])];
497:     if (operation.collectEvidence) {
498:       try {
499:         const collected = await phases.run('WORKER_EVIDENCE_COLLECTION', signal => operation.collectEvidence!({
500:           attempt: envelope, state: fault?.state ?? 'completed', signal,
501:         }));
502:         const candidateEvidence = [...evidence, ...collected.evidence];
503:         checkEvidence(candidateEvidence, envelope);
504:         evidence = candidateEvidence;
505:         if (collected.error) {
506:           fault = new AttemptFault('errored', 'WORKER_EVIDENCE_COLLECTION_FAILED', collected.error);
507:         }
508:       } catch (error) {
509:         fault = error instanceof AttemptFault
510:           ? error
511:           : new AttemptFault('errored', 'WORKER_EVIDENCE_COLLECTION_FAILED', detail(error));
512:       }
513:     }
514:     if (fullLog) {
515:       try {
516:         if (!this.#options.storeFullLog) throw new Error('WORKER_FULL_LOG_STORE_REQUIRED');
517:         const fullLogBytes = Buffer.byteLength(fullLog);
518:         const existingEvidenceBytes = evidence.reduce((sum, item) => sum + item.artifact.sizeBytes, 0);
519:         if (evidence.length + 1 > envelope.limits.evidenceFiles) throw new Error('WORKER_EVIDENCE_FILE_LIMIT');
520:         if (existingEvidenceBytes + fullLogBytes > envelope.limits.evidenceBytes) {
521:           throw new Error('WORKER_EVIDENCE_BYTE_LIMIT');
522:         }
523:         const stored = await phases.run('WORKER_LOG_STORE', signal => this.#options.storeFullLog!(envelope.attemptId, fullLog, { signal }));
524:         if (!stored) throw new Error('WORKER_FULL_LOG_STORE_REQUIRED');
525:         if (stored.artifact.contentDigest !== sha256Text(fullLog)
526:           || stored.artifact.sizeBytes !== fullLogBytes) {
527:           throw new Error('WORKER_FULL_LOG_INTEGRITY_MISMATCH');
528:         }
529:         const candidateEvidence = [...evidence, stored];
530:         checkEvidence(candidateEvidence, envelope);
531:         evidence = candidateEvidence;
532:       } catch (error) {
533:         fault ??= new AttemptFault('errored', 'WORKER_LOG_STORE_FAILED', detail(error));
534:       }
535:     }
536:     if (!fault && operationResult && operation.finalizeResult) {
537:       try {
538:         const specialistResult = await phases.run('WORKER_RESULT_FINALIZATION', signal => operation.finalizeResult!({
539:           attempt: envelope, evidence: freeze(structuredClone(evidence)), specialistResult: operationResult!.specialistResult, signal,
540:         }));
541:         preflightJson(specialistResult, envelope.limits.resultBytes, 'WORKER_RESULT');
542:         const finalizedBytes = Buffer.byteLength(JSON.stringify(specialistResult));
543:         if (finalizedBytes > envelope.limits.resultBytes) throw new Error('WORKER_RESULT_LIMIT');
544:         operationResult = freeze({ ...operationResult, specialistResult: structuredClone(specialistResult) });
545:       } catch (error) {
546:         fault = new AttemptFault('errored', 'WORKER_RESULT_FINALIZATION_FAILED', detail(error));
547:       }
548:     }
549:     // Completion hooks also consume the attempt's resources. Keep the early
550:     // check above to avoid starting optional finalization after an overrun, but
551:     // bind the terminal receipt to usage after cleanup, evidence and reports.
552:     // A failed or quarantined final observation must not reuse an earlier value
553:     // as if it covered those phases. Maintenance measurement preserves bounded
554:     // diagnostics after cancellation without authorizing additional execution.
555:     measured = undefined;
556:     try { measured = await phases.run('WORKER_FINAL_RESOURCE_MEASUREMENT', signal => operation.measure({ signal }), Boolean(fault)); }
557:     catch { measured = undefined; }
558:     assessment = assessWorkerResources(envelope, measured, this.#accounting, assessment.resources);
559:     if (assessment.error && !fault) {
560:       fault = new AttemptFault('errored', assessment.error.code, assessment.error.message);
561:     }
562:     this.#options.signal?.removeEventListener('abort', abort);
563:     if (this.#options.signal?.aborted) {
564:       const terminationError = await terminate();
565:       if (terminationError) {
566:         fault = new AttemptFault('errored', 'WORKER_TERMINATION_FAILED', terminationError);
567:       } else {
568:         if (cleanup.state !== 'failed') fault = executionFault ?? new AttemptFault('cancelled', 'WORKER_ATTEMPT_CANCELLED');
569:       }
570:     } else if (!fault && controller.signal.aborted) {
571:       fault = new AttemptFault('cancelled', 'WORKER_ATTEMPT_CANCELLED');
572:     }
573:     if (claimExpired || this.#now().getTime() >= claimExpiresAt || phases.unresolved || executionUnresolved) {
574:       const terminationError = await terminate();
575:       if (terminationError) fault = new AttemptFault('errored', 'WORKER_TERMINATION_FAILED', terminationError);
576:     }
577:     clearClaimTimer();
578:     if ((phases.unresolved || executionUnresolved) && fault?.code !== 'WORKER_TERMINATION_FAILED') fault = new AttemptFault('errored', 'WORKER_PHASE_UNRESOLVED', `${fault?.code ?? 'WORKER_ATTEMPT_ERROR'}: ${fault?.message ?? ''}; aborted work did not settle; external outcome requires reconciliation.`);
579:     else if ((claimExpired || this.#now().getTime() >= claimExpiresAt) && fault?.code !== 'WORKER_TERMINATION_FAILED' && cleanup.state !== 'failed') fault = executionFault ?? new AttemptFault('interrupted', 'WORKER_CLAIM_EXPIRED');
580:     const completed = this.#now();
581:     const resultBytes = operationResult ? Buffer.byteLength(JSON.stringify(operationResult.specialistResult)) : 0;
582:     return this.#result(started, completed, fault, operationResult, evidence, {
583:       ...assessment.resources,
584:       logBytes,
585:       resultBytes,
586:       evidenceBytes: evidence.reduce((sum, item) => sum + item.artifact.sizeBytes, 0),
587:     }, cleanup);
588:   }
589: 
590:   #progress(state: AttemptProgressEventV1['state'], message: string): void {
591:     if (!this.#options.onProgress) return;
592:     const { envelope } = this.#options;
593:     const event = freeze({
594:       schemaVersion: 'attempt-progress-event.v1' as const,
595:       protocolVersion: envelope.protocolVersion,
596:       attemptId: envelope.attemptId,
597:       claimId: envelope.claim.claimId,
598:       claimGeneration: envelope.claim.generation,
599:       workerId: envelope.claim.workerId,
600:       sequence: this.#progressSequence++,
601:       state,
602:       message,
603:       progressPercent: null,
604:       details: {} as Record<string, JsonValue>,
605:       sentAt: this.#now().toISOString(),
606:     });
607:     validatePipelineWorkerCoreContract('attemptProgressEvent', event);
608:     try {
609:       void Promise.resolve(this.#options.onProgress(event)).catch(() => undefined);
610:     } catch {
611:       // Progress is best effort. The terminal result is authoritative.
612:     }
613:   }
614: 
615:   async #terminate(operation: WorkerAttemptOperation<E>, timeoutMs: number): Promise<string | null> {
616:     let timer: NodeJS.Timeout | undefined;
617:     try {
618:       return await Promise.race([
619:         Promise.resolve().then(() => operation.terminate()).then(() => null, (error: unknown) => detail(error)),
620:         new Promise<string>((resolve) => {
621:           timer = setTimeout(() => resolve('WORKER_TERMINATION_TIMEOUT'), timeoutMs);
622:         }),
623:       ]);
624:     } finally {
625:       if (timer) clearTimeout(timer);
626:     }
627:   }
628: 
629:   #result(started: Date, completed: Date, fault: AttemptFault | null, operationResult: WorkerAttemptOperationResult | null,
630:     evidence: readonly WorkerEvidenceRefV1[], resources: WorkerResourceUseV1,
631:     cleanup: WorkerAttemptResultV1['cleanup']): WorkerAttemptResult {
632:     const { envelope } = this.#options;
633:     const finalCompleted = completed.getTime() < started.getTime() ? started : completed;
634:     const unsigned = {
635:       ...resourceResultFields(envelope, this.#accounting),
636:       protocolVersion: envelope.protocolVersion,
637:       attemptId: envelope.attemptId,
638:       claimId: envelope.claim.claimId,
639:       claimGeneration: envelope.claim.generation,
640:       workerId: envelope.claim.workerId,
641:       state: fault?.state ?? 'completed' as const,
642:       startedAt: started.toISOString(),
643:       completedAt: finalCompleted.toISOString(),
644:       durationMs: Math.max(0, finalCompleted.getTime() - started.getTime()),
645:       summary: boundedText(fault?.message ?? operationResult?.summary, 'Attempt completed.'),
646:       specialistResult: fault ? null : operationResult?.specialistResult ?? null,
647:       error: fault ? { code: fault.code, message: boundedText(fault.message, fault.code) } : null,
648:       evidence: [...evidence],
649:       resources,
650:       cleanup: {
651:         state: cleanup.state,
652:         summary: cleanup.summary === null ? null : boundedText(cleanup.summary, 'Cleanup failed.'),
653:       },
654:       exitCode: fault ? null : operationResult?.exitCode ?? null,
655:       signal: fault ? null : (typeof operationResult?.signal === 'string' && operationResult.signal.length > 0
