1: import type { ChildProcessWithoutNullStreams } from 'node:child_process';
2: import type { NativeWorkerOwnership, NativeWorkerOwnershipLease } from './native-worker-ownership.ts';
3: import type { WorkerOwnershipIdentity } from './ownership-store.ts';
4: import type { NativeWorkerResourceObservation } from './native-resource-observation.ts';
5: import type { NativeWorkerOutputCapture } from './native-output-spool.ts';
6: import { cancelNativeProcess } from './native-process-cancellation.ts';
7: import { captureNativeWorkerOutput } from './native-process-output.ts';
8: import { validateNativeWorkerControlLimits } from './native-control-channel.ts';
9: import { startNativeProcessControl, type NativeWorkerProcessControl } from './native-process-control.ts';
10: 
11: export interface NativeWorkerProcessLimits {
12:   readonly cpuTimeMs: number;
13:   readonly memoryBytes: number;
14:   readonly tasks: number;
15:   readonly timeoutMs: number;
16:   readonly pollIntervalMs: number;
17:   readonly maximumInputBytes: number;
18:   readonly maximumOutputBytes: number;
19:   readonly closeTimeoutMs: number;
20: }
21: 
22: export interface NativeWorkerProcessOptions {
23:   readonly owner: NativeWorkerOwnership;
24:   readonly identity: WorkerOwnershipIdentity;
25:   readonly limits: NativeWorkerProcessLimits;
26:   readonly command: Parameters<NativeWorkerOwnershipLease['launch']>[0];
27:   readonly input: Uint8Array;
28:   readonly signal?: AbortSignal;
29:   readonly outputCapture?: NativeWorkerOutputCapture;
30:   readonly control?: NativeWorkerProcessControl;
31: }
32: 
33: export interface NativeWorkerProcessResult {
34:   readonly schemaVersion: 'worker-native-process-result.v1';
35:   readonly stdout: Uint8Array;
36:   readonly stderr: Uint8Array;
37:   readonly exitCode: number | null;
38:   readonly signal: string | null;
39:   readonly fault: string | null;
40:   readonly resources: NativeWorkerResourceObservation;
41: }
42: 
43: function validateLimits(limits: NativeWorkerProcessLimits): void {
44:   if (Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1)) {
45:     throw new Error('WORKER_NATIVE_PROCESS_LIMIT_INVALID');
46:   }
47:   for (const value of [limits.timeoutMs, limits.pollIntervalMs, limits.closeTimeoutMs]) {
48:     if (value > 2_147_483_647) throw new Error('WORKER_NATIVE_PROCESS_TIMER_INVALID');
49:   }
50: }
51: 
52: function budgetFault(observation: NativeWorkerResourceObservation, limits: NativeWorkerProcessLimits): string | null {
53:   if (observation.oomKills || observation.maximumMemoryBytes > limits.memoryBytes) return 'WORKER_MEMORY_LIMIT';
54:   if (observation.taskLimitHits || observation.maximumTasks > limits.tasks) return 'WORKER_TASK_LIMIT';
55:   if (observation.cpuTimeMicroseconds / 1000 > limits.cpuTimeMs) return 'WORKER_CPU_LIMIT';
56:   return null;
57: }
58: 
59: /** Entire trusted attempt host, including its completion I/O and every descendant. */
60: export async function runNativeWorkerProcess(options: NativeWorkerProcessOptions): Promise<NativeWorkerProcessResult> {
61:   const limits = { ...options.limits };
62:   const control = options.control ? { limits: { ...options.control.limits }, run: options.control.run } : undefined;
63:   validateLimits(limits);
64:   if (control) {
65:     validateNativeWorkerControlLimits(control.limits);
66:     if (typeof control.run !== 'function') throw new Error('WORKER_NATIVE_CONTROL_CONFIG_INVALID');
67:   }
68:   if (options.input.byteLength > limits.maximumInputBytes) throw new Error('WORKER_NATIVE_INPUT_LIMIT');
69:   const input = Buffer.from(options.input);
70:   const command = structuredClone(options.command);
71:   options.signal?.throwIfAborted();
72:   const lease = await options.owner.allocate(options.identity, { memoryBytes: limits.memoryBytes, tasks: limits.tasks });
73:   let child: ChildProcessWithoutNullStreams | undefined;
74:   try {
75:     options.signal?.throwIfAborted();
76:     child = await lease.launch(command, control !== undefined);
77:     return await collectProcess(child, lease, input, limits, options.signal, options.outputCapture, control);
78:   } finally {
79:     // Also stop a launcher interrupted before joining; it has no authority to start later.
80:     child?.kill('SIGKILL');
81:     await lease.finish();
82:   }
83: }
84: 
85: async function collectProcess(child: ChildProcessWithoutNullStreams, lease: NativeWorkerOwnershipLease,
86:   input: Buffer, limits: NativeWorkerProcessLimits, signal?: AbortSignal, outputCapture?: NativeWorkerOutputCapture,
87:   controlOptions?: NativeWorkerProcessControl): Promise<NativeWorkerProcessResult> {
88:   let fault: string | null = null;
89:   let closeTimer: NodeJS.Timeout | undefined;
90:   let closing: Promise<NativeWorkerResourceObservation> | undefined;
91:   let finish: () => void = () => {};
92:   const close = () => {
93:     child.kill('SIGKILL');
94:     closing ??= lease.finish();
95:     // The caller always observes this rejection after the child boundary settles.
96:     void closing.catch(() => {});
97:     closeTimer ??= setTimeout(() => {
98:       fault = 'WORKER_NATIVE_PROCESS_DRAIN_TIMEOUT';
99:       finish();
100:     }, limits.closeTimeoutMs);
101:   };
102:   const exited = new Promise<void>(resolve => { finish = resolve; });
103:   const stop = (code: string) => {
104:     fault ??= code;
105:     close();
106:   };
107:   const output = captureNativeWorkerOutput(child, limits.maximumOutputBytes, stop, outputCapture);
108:   const control = startNativeProcessControl(child, controlOptions, stop, limits.closeTimeoutMs, lease.launchAuthority());
109:   let disposeCancellation: (() => void) | undefined;
110:   const abort = () => {
111:     if (closing || disposeCancellation) return;
112:     fault ??= 'WORKER_ATTEMPT_CANCELLED';
113:     disposeCancellation = cancelNativeProcess(child, limits.closeTimeoutMs, close);
114:   };
115:   child.once('error', () => stop('WORKER_NATIVE_PROCESS_START_FAILED'));
116:   child.stdin.once('error', () => stop('WORKER_NATIVE_PROCESS_INPUT_FAILED'));
117:   child.once('exit', () => { close(); });
118:   child.once('close', finish);
119:   signal?.addEventListener('abort', abort, { once: true });
120:   const deadline = setTimeout(() => stop('WORKER_ATTEMPT_TIMEOUT'), limits.timeoutMs);
121:   const poll = setInterval(() => {
122:     if (closing) return;
123:     try { const code = budgetFault(lease.observe(), limits); if (code) stop(code); }
124:     catch { stop('WORKER_RESOURCE_MEASUREMENT_UNAVAILABLE'); }
125:   }, limits.pollIntervalMs);
126:   try {
127:     if (signal?.aborted) abort();
128:     else child.stdin.end(input);
129:     await exited;
130:     close();
131:     const resources = await closing!;
132:     await output.flush();
133:     await control.finish();
134:     fault ??= budgetFault(resources, limits);
135:     if (child.exitCode !== 0 && fault === null) fault = 'WORKER_NATIVE_PROCESS_FAILED';
136:     return { schemaVersion: 'worker-native-process-result.v1', ...output.snapshot(),
137:       exitCode: child.exitCode, signal: child.signalCode, fault, resources };
138:   } finally {
139:     clearTimeout(deadline); clearInterval(poll); if (closeTimer) clearTimeout(closeTimer);
140:     signal?.removeEventListener('abort', abort);
141:     disposeCancellation?.();
142:     child.stdin.destroy(); child.stdout.destroy(); child.stderr.destroy();
143:     await control.finish();
144:   }
145: }
