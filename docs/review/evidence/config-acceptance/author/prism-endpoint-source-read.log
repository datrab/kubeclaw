1941:     spec:
1942:       serviceAccountName: prism-test-runner
1943:       automountServiceAccountToken: false
1944:       imagePullSecrets: [{ name: ${PRISM_IMAGE_PULL_SECRET_NAME} }]
1945:       restartPolicy: Never
