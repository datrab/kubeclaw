26: function loadTrustConfig(environment: NodeJS.ProcessEnv) {
27:   const spiffeEnabled = environment.WORKER_TRUST_SPIFFE_ENABLED === 'true';
28:   const trustedNovaSpiffeId = environment.PRISM_TRUSTED_NOVA_SPIFFE_ID ?? '';
29:   const trustedWorkerSpiffeId = environment.PRISM_TRUSTED_WORKER_SPIFFE_ID ?? '';
30:   const trustedControlSpiffeId = environment.PRISM_CONTROL_SPIFFE_ID ?? '';
31:   const trustedPrismAgentSpiffeId = environment.PRISM_TRUSTED_AGENT_SPIFFE_ID ?? '';
32:   if (spiffeEnabled && (!trustedNovaSpiffeId || !trustedWorkerSpiffeId || !trustedControlSpiffeId || !trustedPrismAgentSpiffeId)) {
33:     throw new Error('Prism SPIFFE trust policy is incomplete');
34:   }
35:   return {
36:     spiffeEnabled, trustedNovaSpiffeId, trustedWorkerSpiffeId,
37:     trustedControlSpiffeId, trustedPrismAgentSpiffeId,
38:     trustedTestRunnerSpiffeId: environment.PRISM_TRUSTED_TEST_RUNNER_SPIFFE_ID ?? '',
39:     dispatchSecret: spiffeEnabled ? '' : required(environment, 'PRISM_DISPATCH_SECRET'),
40:     workerSecret: spiffeEnabled ? '' : required(environment, 'PRISM_WORKER_SECRET'),
41:   };
42: }
