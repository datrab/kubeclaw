{"path": "skills/prism/control/worker-operation-transport.ts", "sha256": "048a23bb132d4d70978e28449a468169ccd87b3a06fa2127fedffbcc992a9958"}
1: import { randomBytes } from 'node:crypto';
2: import type { WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import type { loadControlServerConfig } from '../server/control-config.ts';
4: import { signInternalRequest } from '../server/internal-auth.ts';
5: 
6: type Config = ReturnType<typeof loadControlServerConfig>;
7: 
8: export async function requestWorkerResult(config: Config, attempt: WorkerAttemptEnvelopeV3): Promise<unknown> {
9:   const body = Buffer.from(JSON.stringify(attempt)); const timestamp = Date.now(); const nonce = randomBytes(16).toString('hex');
10:   const response = await fetch(new URL('/v1/attempts', config.workerUrl), {
11:     method: 'POST', body, signal: AbortSignal.timeout(config.nativeWorkerDispatchTimeoutMs),
12:     headers: config.spiffeEnabled ? { 'content-type': 'application/json' } : {
13:       'content-type': 'application/json', 'x-prism-timestamp': String(timestamp), 'x-prism-nonce': nonce,
14:       'x-prism-signature': `v1=${signInternalRequest(config.workerSecret, body, timestamp, nonce)}`,
15:     },
16:   });
17:   if (!response.ok) { await response.body?.cancel(); throw new Error(`Prism worker failed: ${response.status}`); }
18:   return boundedResult(response, config.maximumWorkerResponseBytes);
19: }
20: 
21: async function boundedResult(response: Response, maximumBytes: number): Promise<unknown> {
22:   const reader = response.body?.getReader();
23:   if (!reader) throw new Error('PRISM_NATIVE_RESULT_BODY_REQUIRED');
24:   const chunks: Uint8Array[] = []; let size = 0;
25:   try {
26:     for (;;) {
27:       const chunk = await reader.read();
28:       if (chunk.done) break;
29:       size += chunk.value.byteLength;
30:       if (size > maximumBytes) { await reader.cancel(); throw new Error('PRISM_NATIVE_RESULT_BODY_LIMIT'); }
31:       chunks.push(chunk.value);
32:     }
33:     return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(Buffer.concat(chunks)));
34:   } finally { reader.releaseLock(); }
35: }
{"path": "skills/prism/server/corpus-routes.ts", "sha256": "3f02fab3d0b41ed9a1074193e0312db0176be504f5d510a1c7a35d967eff77bf"}
1: import { createHash } from "node:crypto";
2: import { type IncomingMessage, type ServerResponse } from "node:http";
3: import { ingest, search, type CorpusInput } from "../corpus/index.ts";
4: 
5: import type { AuthenticatedControlContext } from "./control-context.ts";
6: import { body, json, sha256 } from "./control-http.ts";
7: type RouteContext = Pick<
8:   AuthenticatedControlContext,
9:   "pool" | "artifacts" | "runWorker" | "config"
10: >;
11: 
12: export async function corpusRoutes(
13:   context: RouteContext,
14:   request: IncomingMessage,
15:   response: ServerResponse,
16:   url: URL,
17: ): Promise<boolean> {
18:   if (url.pathname === "/v1/artifacts" && request.method === "POST") {
19:     await uploadArtifact(context, request, response);
20:     return true;
21:   }
22:   if (url.pathname === "/v1/corpus" && request.method === "POST") {
23:     await ingestCorpus(context, request, response);
24:     return true;
25:   }
26:   if (url.pathname === "/v1/corpus/search" && request.method === "GET") {
27:     await searchCorpus(context, response, url);
28:     return true;
29:   }
30:   return false;
31: }
32: async function uploadArtifact(
33:   context: RouteContext,
34:   request: IncomingMessage,
35:   response: ServerResponse,
36: ) {
37:   const { artifacts } = context;
38: 
39:   const input = (await body(request, 8_500_000)) as { base64?: string };
40:   if (!input.base64) throw new Error("base64 is required");
41:   const decoded = Buffer.from(input.base64, "base64");
42:   if (
43:     decoded.byteLength > 6_000_000 ||
44:     decoded.toString("base64") !== input.base64
45:   )
46:     throw new Error("artifact payload is invalid or exceeds 6 MB");
47:   return json(response, 201, await artifacts.put(decoded));
48: }
49: async function ingestCorpus(
50:   context: RouteContext,
51:   request: IncomingMessage,
52:   response: ServerResponse,
53: ) {
54:   const { pool } = context;
55: 
56:   const input = (await body(request)) as CorpusInput;
57:   const acquisition = await acquireCorpus(context.config, input);
58:   let publicationError: unknown;
59:   let stored: { id: string; digest: string } | undefined;
60:   try {
61:     stored = await publishCorpus(context, input, acquisition);
62:   } catch (error) {
63:     publicationError = error;
64:   }
65:   let cleanupError: unknown;
66:   try {
67:     await cleanAcquisition(context.config, acquisition.quarantineDigest);
68:   } catch (error) {
69:     cleanupError = error;
70:   }
71:   if (publicationError && cleanupError)
72:     throw new AggregateError(
73:       [publicationError, cleanupError],
74:       "corpus publication and quarantine cleanup failed",
75:     );
76:   if (publicationError) throw publicationError;
77:   if (cleanupError) throw cleanupError;
78:   // ingest returns corpus_revision.id so activation remains bound to the exact governed revision.
79:   await pool.query(
80:     "UPDATE prism.corpus_item SET status='active' WHERE current_revision_id=$1",
81:     [stored!.id],
82:   );
83:   return json(response, 201, stored!);
84: }
85: async function searchCorpus(
86:   context: RouteContext,
87:   response: ServerResponse,
88:   url: URL,
89: ) {
90:   const { pool, runWorker } = context;
91: 
92:   const query = url.searchParams.get("q") ?? "";
93:   const embedded = await runWorker(
94:     "ingest",
95:     { text: query },
96:     `query:${sha256(query)}`,
97:   );
98:   const parseFilter = (name: string): Record<string, unknown> | undefined => {
99:     const value = url.searchParams.get(name);
100:     if (!value) return undefined;
101:     const parsed = JSON.parse(value);
102:     if (!parsed || typeof parsed !== "object" || Array.isArray(parsed))
103:       throw new Error(`${name} filter must be an object`);
104:     return parsed as Record<string, unknown>;
105:   };
106:   const items = await search(
107:     pool,
108:     query,
109:     Math.min(50, Math.max(1, Number(url.searchParams.get("limit") ?? 10))),
110:     {
111:       embedding: embedded.embedding as number[],
112:       model: String(embedded.model),
113:     },
114:     {
115:       required: parseFilter("required"),
116:       preferred: parseFilter("preferred"),
117:       avoid: parseFilter("avoid"),
118:       sourceFamilyLimit: Math.min(
119:         10,
120:         Math.max(1, Number(url.searchParams.get("sourceFamilyLimit") ?? 2)),
121:       ),
122:     },
123:   );
124:   return json(response, 200, {
125:     items,
126:     coverageGap:
127:       items.length <
128:       Math.min(50, Math.max(1, Number(url.searchParams.get("limit") ?? 10)))
129:         ? "The approved corpus does not cover all requested result slots."
130:         : null,
131:   });
132: }
133: 
134: interface Acquisition {
135:   normalized: CorpusInput;
136:   quarantineDigest: string;
137:   contentBase64: string;
138: }
139: async function acquireCorpus(
140:   config: AuthenticatedControlContext["config"],
141:   input: CorpusInput,
142: ): Promise<Acquisition> {
143:   const { ingestionUrl, ingestionSecret } = config;
144:   if (input.sourceKind === "public-web")
145:     throw new Error(
146:       "public-web ingestion is disabled until a source policy is approved",
147:     );
148:   const acquired = await fetch(new URL("/v1/acquisitions", ingestionUrl), {
149:     method: "POST",
150:     headers: {
151:       authorization: `Bearer ${ingestionSecret}`,
152:       "content-type": "application/json",
153:     },
154:     body: JSON.stringify(input),
155:     signal: AbortSignal.timeout(30_000),
156:   });
157:   if (!acquired.ok)
158:     throw new Error(`corpus acquisition failed: ${acquired.status}`);
159:   const acquisition = (await acquired.json()) as {
160:     normalized?: CorpusInput;
161:     quarantineDigest?: string;
162:     contentBase64?: string;
163:   };
164:   if (
165:     !acquisition.normalized ||
166:     !acquisition.quarantineDigest ||
167:     !acquisition.contentBase64
168:   )
169:     throw new Error("corpus acquisition returned invalid evidence");
170:   return acquisition as Acquisition;
171: }
172: async function publishCorpus(
173:   context: Pick<AuthenticatedControlContext, "pool" | "runWorker">,
174:   input: CorpusInput,
175:   acquisition: Acquisition,
176: ) {
177:   const { pool, runWorker } = context;
178:   const sourceBytes = Buffer.from(acquisition.contentBase64, "base64");
179:   if (
180:     `sha256:${createHash("sha256").update(sourceBytes).digest("hex")}` !==
181:     acquisition.quarantineDigest
182:   )
183:     throw new Error("corpus acquisition digest mismatch");
184:   const normalized = {
185:     ...acquisition.normalized,
186:     sourceContentDigest: acquisition.quarantineDigest,
187:   };
188:   const text = `${normalized.title} ${normalized.summary} ${normalized.tags.join(" ")}`;
189:   const embedded = await runWorker(
190:     "ingest",
191:     { text },
192:     `corpus:${sha256(JSON.stringify(input))}`,
193:   );
194:   return ingest(
195:     pool,
196:     normalized,
197:     {
198:       embedding: embedded.embedding as number[],
199:       model: String(embedded.model),
200:       modelVersion: String(embedded.modelVersion),
201:       sourceDigest: String(embedded.sourceDigest),
202:     },
203:     { activate: false },
204:   );
205: }
206: async function cleanAcquisition(
207:   config: AuthenticatedControlContext["config"],
208:   quarantineDigest: string,
209: ) {
210:   const { ingestionUrl, ingestionSecret } = config;
211:   await fetch(
212:     new URL(`/v1/acquisitions/${quarantineDigest.slice(7)}`, ingestionUrl),
213:     {
214:       method: "DELETE",
215:       headers: { authorization: `Bearer ${ingestionSecret}` },
216:       signal: AbortSignal.timeout(10_000),
217:     },
218:   ).then((result) => {
219:     if (!result.ok)
220:       throw new Error(`quarantine cleanup failed: ${result.status}`);
221:   });
222: }
{"path": "charts/prism/templates/workloads.yaml", "sha256": "e7a7cee020d5fd6823b5a63039a9ba2e924ed63363a7bb7bad1d51dd59722e20"}
1: {{- $swarm := include "prism.swarmConfig" . | fromJson }}
2: {{- $shutdownTimeoutMs := $swarm.operator.prism.worker.shutdownTimeoutMs }}
3: {{- if ne (int .Values.control.replicas) 1 }}
4: {{- fail "control.replicas must be 1 while prism-artifacts uses ReadWriteOnce storage" }}
5: {{- end }}
6: {{- include "prism.productDecisions.validate" . }}
7: {{- if or (ne (int .Values.worker.replicas) 1) (ne .Values.worker.native.namespace .Release.Namespace) (not .Values.worker.native.nodeName) (not (regexMatch "^[a-f0-9]{64}$" .Values.worker.native.policyDigest)) }}
8: {{- fail "native Prism requires one worker, its selected namespace/node and generated policy digest" }}
9: {{- end }}
10: {{- if or (le (int $shutdownTimeoutMs) (add (int $swarm.operator.prism.native.supervisor.closeTimeoutMs) (int $swarm.operator.prism.native.supervisor.drainTimeoutMs))) (le (mul (int .Values.worker.terminationGracePeriodSeconds) 1000) (int $shutdownTimeoutMs)) }}
11: {{- fail "worker shutdown must cover native close plus scope drain, and fit within pod termination grace" }}
12: {{- end }}
13: {{- range $name := list "control" "studio" "worker" }}
14: {{- $image := index $.Values.images $name }}
15: apiVersion: apps/v1
16: kind: Deployment
17: metadata:
18:   name: prism-{{ $name }}
19:   annotations:
20:     argocd.argoproj.io/sync-wave: "2"
21: spec:
22:   replicas: {{ (index $.Values $name).replicas }}
23:   {{- if or (eq $name "control") (eq $name "worker") }}
24:   strategy: { type: Recreate }
25:   {{- end }}
26:   selector: { matchLabels: { app: prism-{{ $name }} } }
27:   template:
28:     metadata:
29:       labels:
30:         app: prism-{{ $name }}
31:         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
32:         kubeclaw.dev/worker-trust: "true"
33:         {{- end }}
34:       {{- if or (and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker"))) (eq $name "control") (eq $name "worker") (eq $name "studio") }}
35:       annotations:
36:         {{- if has $name (list "control" "worker" "studio") }}
37:         checksum/swarm-config: {{ include "kubeclaw.swarmBundle" $ | sha256sum }}
38:         {{- end }}
39:         {{- if eq $name "worker" }}
40:         kubeclaw.dev/native-worker-role: prism
41:         kubeclaw.dev/native-worker-policy: {{ $.Values.worker.native.policyDigest | quote }}
42:         {{- end }}
43:         {{- if and (eq $name "control") $.Values.control.productDecisions.enabled }}
44:         checksum/product-decisions: {{ toJson $.Values.control.productDecisions | sha256sum }}
45:         {{- end }}
46:         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
47:         checksum/worker-trust: {{ index ((include (print $.Template.BasePath "/configmap-worker-trust.yaml") $) | fromYaml).data (printf "%s.yaml" $name) | sha256sum }}
48:         {{- end }}
49:       {{- end }}
50:     spec:
51:       serviceAccountName: prism-{{ $name }}
52:       {{- if eq $name "worker" }}
53:       terminationGracePeriodSeconds: {{ $.Values.worker.terminationGracePeriodSeconds }}
54:       {{- end }}
55:       imagePullSecrets: {{ toYaml $.Values.imagePullSecrets | nindent 8 }}
56:       automountServiceAccountToken: false
57:       # The Prism images use the named `node` image user. Kubernetes cannot prove
58:       # that a named image user is non-root when runAsNonRoot is set, so make the
59:       # image's numeric runtime identity explicit for every Prism application pod.
60:       {{- if eq $name "worker" }}
61:       securityContext: { runAsNonRoot: false, runAsUser: 0, runAsGroup: 0, seccompProfile: { type: RuntimeDefault } }
62:       affinity:
63:         nodeAffinity:
64:           requiredDuringSchedulingIgnoredDuringExecution:
65:             nodeSelectorTerms:
66:               - matchFields:
67:                   - { key: metadata.name, operator: In, values: [{{ $.Values.worker.native.nodeName | quote }}] }
68:       {{- else }}
69:       securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: { type: RuntimeDefault } }
70:       {{- end }}
71:       topologySpreadConstraints:
72:         - maxSkew: 1
73:           topologyKey: kubernetes.io/hostname
74:           whenUnsatisfiable: ScheduleAnyway
75:           labelSelector: { matchLabels: { app: prism-{{ $name }} } }
76:       containers:
77:         - name: {{ $name }}
78:           image: {{ include "prism.imageRef" $image | quote }}
79:           imagePullPolicy: {{ $image.pullPolicy }}
80:           {{- if eq $name "worker" }}
81:           command: ["node", "skills/prism/server/worker.ts"]
82:           securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"], add: ["SETUID", "SETGID", "KILL"] } }
83:           {{- else }}
84:           securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
85:           {{- end }}
86:           env:
87:             {{- if or (eq $name "control") (eq $name "worker") }}
88:             - { name: PRISM_ENGINE_CONTENT_DIGEST, value: {{ $.Values.images.worker.digest | quote }} }
89:             {{- end }}
90:             - { name: SWARM_CONFIG, value: /etc/kubeclaw/swarm/swarm.config.json }
91:             {{- if and (or (eq $name "control") (eq $name "worker")) (not $.Values.workerTrust.spiffe.enabled) }}
92:             - name: PRISM_WORKER_SECRET
93:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: worker-secret } }
94:             {{- end }}
95:             {{- if eq $name "control" }}
96:             {{- include "prism.productDecisions.env" $ | nindent 12 }}
97:             {{- if $.Values.workerTrust.spiffe.enabled }}
98:             - { name: PRISM_WORKER_URL, value: "http://127.0.0.1:18081" }
99:             - { name: PRISM_CONTROL_INTERNAL_URL, value: "http://127.0.0.1:18080" }
100:             - { name: PRISM_AGENT_URL, value: "http://127.0.0.1:18082" }
101:             {{- end }}
102:             - name: DATABASE_URL
103:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.database }}, key: runtime-url } }
104:             - name: PRISM_SESSION_SECRET
105:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: session-secret } }
106:             - name: PRISM_INGRESS_SECRET
107:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: ingress-secret } }
108:             {{- if not $.Values.workerTrust.spiffe.enabled }}
109:             - name: PRISM_DISPATCH_SECRET
110:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: dispatch-secret } }
111:             {{- end }}
112:             - { name: PRISM_INGESTION_URL, value: "http://prism-ingestion:8080" }
113:             - name: PRISM_INGESTION_SECRET
114:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: ingestion-secret } }
115:             {{- end }}
116:             {{- if eq $name "studio" }}
117:             - name: PRISM_INGRESS_SECRET
118:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: ingress-secret } }
119:             {{- end }}
120:             {{- if eq $name "worker" }}
121:             - { name: PRISM_CONTROL_INTERNAL_URL, value: {{ ternary "http://127.0.0.1:18080" "http://prism-control:8080" $.Values.workerTrust.spiffe.enabled | quote }} }
122:             - name: DATABASE_URL
123:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.database }}, key: runtime-url } }
124:             {{- end }}
125:             {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
126:             - { name: SPIFFE_ENDPOINT_SOCKET, value: {{ printf "unix://%s" $.Values.workerTrust.spiffe.socketPath | quote }} }
127:             - { name: WORKER_TRUST_SPIFFE_ENABLED, value: "true" }
128:             {{- if eq $name "control" }}
129:             - { name: PRISM_TRUSTED_NOVA_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/%s" $.Values.workerTrust.spiffe.trustDomain $.Values.workerTrust.spiffe.novaNamespace $.Values.workerTrust.spiffe.novaServiceAccount | quote }} }
130:             - { name: PRISM_TRUSTED_TEST_RUNNER_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/prism-test-runner" $.Values.workerTrust.spiffe.trustDomain $.Release.Namespace | quote }} }
131:             - { name: PRISM_TRUSTED_WORKER_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/prism-worker" $.Values.workerTrust.spiffe.trustDomain $.Release.Namespace | quote }} }
132:             - { name: PRISM_CONTROL_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/prism-control" $.Values.workerTrust.spiffe.trustDomain $.Release.Namespace | quote }} }
133:             - { name: PRISM_TRUSTED_AGENT_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/%s" $.Values.workerTrust.spiffe.trustDomain $.Values.workerTrust.spiffe.agentNamespace $.Values.workerTrust.spiffe.agentServiceAccount | quote }} }
134:             {{- else }}
135:             - { name: PRISM_TRUSTED_CONTROL_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/prism-control" $.Values.workerTrust.spiffe.trustDomain $.Release.Namespace | quote }} }
136:             {{- end }}
137:             {{- end }}
138:           resources: {{ toYaml (index $.Values $name).resources | nindent 12 }}
139:           volumeMounts:
140:             - { name: tmp, mountPath: /tmp }
141:             {{- if has $name (list "control" "worker" "studio") }}
142:             - { name: swarm-config, mountPath: /etc/kubeclaw/swarm, readOnly: true }
143:             {{- end }}
144:             {{- if eq $name "worker" }}
145:             - { name: native-pool, mountPath: /sys/fs/cgroup/kubeclaw.slice/kubeclaw-native-pools.service/prism }
146:             - { name: native-ownership, mountPath: /var/lib/kubeclaw/native/prism }
147:             - { name: native-policy, mountPath: /etc/kubeclaw/prism-pool.json, readOnly: true }
148:             - { name: native-node-identity, mountPath: /etc/kubeclaw/native-node-id, readOnly: true }
149:             - { name: native-runtime-identity, mountPath: /etc/kubeclaw/native-runtime-identity.json, readOnly: true }
150:             {{- end }}
151:             {{- if eq $name "control" }}
152:             - { name: artifacts, mountPath: {{ $swarm.operator.prism.control.artifactRoot | quote }} }
153:             {{- if $.Values.control.productDecisions.enabled }}
154:             - { name: product-decision-signing, mountPath: /var/run/prism/product-signing, readOnly: true }
155:             - { name: product-decision-controller, mountPath: /var/run/prism/product-controller, readOnly: true }
156:             {{- end }}
157:             {{- end }}
158:           {{- if eq $name "worker" }}
159:           # The migration is a post-install hook. On the first install the worker
160:           # must become ready before that hook can create its nonce table.
161:           {{- end }}
162:           readinessProbe: { httpGet: { path: {{ ternary "/bootstrap" "/ready" (eq $name "worker") | quote }}, port: {{ ternary (int $swarm.operator.prism.control.port) (ternary (int $swarm.operator.prism.studio.port) (int $swarm.operator.prism.worker.port) (eq $name "studio")) (eq $name "control") }} }, initialDelaySeconds: 3 }
163:           livenessProbe: { httpGet: { path: /health, port: {{ ternary (int $swarm.operator.prism.control.port) (ternary (int $swarm.operator.prism.studio.port) (int $swarm.operator.prism.worker.port) (eq $name "studio")) (eq $name "control") }} }, initialDelaySeconds: 10 }
164:         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
165:         - name: worker-trust-proxy
166:           image: "{{ $.Values.workerTrust.spiffe.envoy.repository }}:{{ $.Values.workerTrust.spiffe.envoy.tag }}@{{ $.Values.workerTrust.spiffe.envoy.digest }}"
167:           imagePullPolicy: {{ $.Values.workerTrust.spiffe.envoy.pullPolicy }}
168:           args: ["-c", {{ printf "/etc/kubeclaw-worker-trust/%s.yaml" $name | quote }}, "--service-cluster", {{ printf "prism-%s" $name | quote }}]
169:           ports: [{ name: worker-trust, containerPort: 8443, protocol: TCP }, { name: envoy-health, containerPort: 19000, protocol: TCP }]
170:           startupProbe:
171:             httpGet: { path: /bootstrap, port: envoy-health }
172:             periodSeconds: 2
173:             failureThreshold: 30
174:             timeoutSeconds: 3
175:           readinessProbe:
176:             httpGet: { path: /ready, port: envoy-health }
177:             initialDelaySeconds: 3
178:             timeoutSeconds: 3
179:           livenessProbe:
180:             httpGet: { path: /health, port: envoy-health }
181:             initialDelaySeconds: 10
182:             timeoutSeconds: 3
183:           securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
184:           resources: {{ toYaml $.Values.workerTrust.spiffe.envoy.resources | nindent 12 }}
185:           volumeMounts:
186:             - { name: worker-trust-envoy, mountPath: /etc/kubeclaw-worker-trust, readOnly: true }
187:             - { name: spiffe-workload-api, mountPath: /run/spire/sockets, readOnly: true }
188:             - { name: worker-trust-tmp, mountPath: /tmp }
189:         {{- end }}
190:       volumes:
191:         - { name: tmp, emptyDir: { sizeLimit: 4Gi } }
192:         {{- if has $name (list "control" "worker" "studio") }}
193:         - { name: swarm-config, configMap: { name: prism-swarm-config, defaultMode: 0444 } }
194:         {{- end }}
195:         {{- if eq $name "worker" }}
196:         - { name: native-pool, hostPath: { path: /sys/fs/cgroup/kubeclaw.slice/kubeclaw-native-pools.service/prism, type: Directory } }
197:         - { name: native-ownership, hostPath: { path: /var/lib/kubeclaw/native/prism, type: Directory } }
198:         - { name: native-policy, hostPath: { path: /etc/kubeclaw/prism-pool.json, type: File } }
199:         - { name: native-node-identity, hostPath: { path: /etc/kubeclaw/native-node-id, type: File } }
200:         - { name: native-runtime-identity, hostPath: { path: /etc/kubeclaw/native-runtime-identity.json, type: File } }
201:         {{- end }}
202:         {{- if eq $name "control" }}
203:         - { name: artifacts, persistentVolumeClaim: { claimName: prism-artifacts } }
204:         {{- include "prism.productDecisions.volumes" $ | nindent 8 }}
205:         {{- end }}
206:         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
207:         - { name: worker-trust-envoy, configMap: { name: prism-worker-trust, defaultMode: 0444 } }
208:         - name: spiffe-workload-api
209:           csi: { driver: {{ $.Values.workerTrust.spiffe.csiDriver | quote }}, readOnly: true }
210:         - { name: worker-trust-tmp, emptyDir: { sizeLimit: 64Mi } }
211:         {{- end }}
212: ---
213: {{- end }}
214: {{- range $name := list "studio" "worker" }}
215: apiVersion: policy/v1
216: kind: PodDisruptionBudget
217: metadata: { name: prism-{{ $name }} }
218: spec: { minAvailable: 1, selector: { matchLabels: { app: prism-{{ $name }} } } }
219: ---
220: {{- end }}
221: apiVersion: v1
222: kind: PersistentVolumeClaim
223: metadata:
224:   name: prism-artifacts
225:   annotations:
226:     helm.sh/resource-policy: keep
227:     argocd.argoproj.io/sync-options: Prune=false,Delete=false
228:     argocd.argoproj.io/sync-wave: "2"
229: spec:
230:   accessModes: [ReadWriteOnce]
231:   {{- if .Values.artifactStorage.storageClass }}
232:   storageClassName: {{ .Values.artifactStorage.storageClass | quote }}
233:   {{- end }}
234:   resources: { requests: { storage: {{ .Values.artifactStorage.storage }} } }
{"path": "charts/prism/templates/configmap-worker-trust.yaml", "sha256": "7f84362f9d9c0d5fa08962e33e0c231621c4600ce52b9a6aa822334f81f3a1fc"}
1: {{- $controlPort := (include "prism.swarmConfig" . | fromJson).operator.prism.control.port | int }}
2: {{- if .Values.workerTrust.spiffe.enabled }}
3: {{- $trustDomain := required "workerTrust.spiffe.trustDomain is required" .Values.workerTrust.spiffe.trustDomain }}
4: {{- $namespace := .Release.Namespace }}
5: apiVersion: v1
6: kind: ConfigMap
7: metadata: { name: prism-worker-trust }
8: data:
9:   control.yaml: |
10:     node: { id: {{ printf "prism-control.%s" $namespace | quote }}, cluster: prism-control }
11:     admin: { address: { socket_address: { address: 127.0.0.1, port_value: 9901 } } }
12:     static_resources:
13:       listeners:
14:         {{- include "prism.trustReadinessListeners" (dict "identity" (printf "spiffe://%s/ns/%s/sa/prism-control" $trustDomain $namespace) "trustDomain" $trustDomain) | nindent 8 }}
15:         - name: control-ingress
16:           address: { socket_address: { address: 0.0.0.0, port_value: 8443 } }
17:           filter_chains:
18:             - transport_socket:
19:                 name: envoy.transport_sockets.tls
20:                 typed_config:
21:                   "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
22:                   require_client_certificate: true
23:                   common_tls_context:
24:                     tls_certificate_sds_secret_configs:
25:                       - name: default
26:                         sds_config:
27:                           resource_api_version: V3
28:                           api_config_source: { api_type: GRPC, transport_api_version: V3, grpc_services: [{ envoy_grpc: { cluster_name: spire-agent } }] }
29:                     combined_validation_context:
30:                       default_validation_context:
31:                         match_typed_subject_alt_names:
32:                           - { san_type: URI, matcher: { exact: {{ printf "spiffe://%s/ns/%s/sa/%s" $trustDomain .Values.workerTrust.spiffe.novaNamespace .Values.workerTrust.spiffe.novaServiceAccount | quote }} } }
33:                           - { san_type: URI, matcher: { exact: {{ printf "spiffe://%s/ns/%s/sa/prism-test-runner" $trustDomain $namespace | quote }} } }
34:                           - { san_type: URI, matcher: { exact: {{ printf "spiffe://%s/ns/%s/sa/prism-control" $trustDomain $namespace | quote }} } }
35:                           - { san_type: URI, matcher: { exact: {{ printf "spiffe://%s/ns/%s/sa/prism-worker" $trustDomain $namespace | quote }} } }
36:                           - { san_type: URI, matcher: { exact: {{ printf "spiffe://%s/ns/%s/sa/%s" $trustDomain .Values.workerTrust.spiffe.agentNamespace .Values.workerTrust.spiffe.agentServiceAccount | quote }} } }
37:                       validation_context_sds_secret_config:
38:                         name: {{ printf "spiffe://%s" $trustDomain | quote }}
39:                         sds_config:
40:                           resource_api_version: V3
41:                           api_config_source: { api_type: GRPC, transport_api_version: V3, grpc_services: [{ envoy_grpc: { cluster_name: spire-agent } }] }
42:               filters:
43:                 - name: envoy.filters.network.http_connection_manager
44:                   typed_config:
45:                     "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
46:                     stat_prefix: control-ingress
47:                     forward_client_cert_details: SANITIZE_SET
48:                     set_current_client_cert_details: { uri: true }
49:                     route_config:
50:                       name: control-local
51:                       virtual_hosts: [{ name: local, domains: ["*"], routes: [{ match: { prefix: "/" }, route: { cluster: control-local } }] }]
52:                     http_filters: [{ name: envoy.filters.http.router, typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router } }]
53:         - name: worker-egress
54:           address: { socket_address: { address: 127.0.0.1, port_value: 18081 } }
55:           filter_chains: [{ filters: [{ name: envoy.filters.network.tcp_proxy, typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy, stat_prefix: worker-egress, cluster: worker-mtls } }] }]
56:         - name: control-egress
57:           address: { socket_address: { address: 127.0.0.1, port_value: 18080 } }
58:           filter_chains: [{ filters: [{ name: envoy.filters.network.tcp_proxy, typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy, stat_prefix: control-egress, cluster: control-mtls } }] }]
59:         - name: prism-agent-egress
60:           address: { socket_address: { address: 127.0.0.1, port_value: 18082 } }
61:           filter_chains: [{ filters: [{ name: envoy.filters.network.tcp_proxy, typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy, stat_prefix: prism-agent-egress, cluster: prism-agent-mtls } }] }]
62:       clusters:
63:         {{- include "prism.trustReadinessCluster" (dict "identity" (printf "spiffe://%s/ns/%s/sa/prism-control" $trustDomain $namespace) "trustDomain" $trustDomain) | nindent 8 }}
64:         - name: spire-agent
65:           connect_timeout: 0.25s
66:           http2_protocol_options: {}
67:           load_assignment: { cluster_name: spire-agent, endpoints: [{ lb_endpoints: [{ endpoint: { address: { pipe: { path: {{ .Values.workerTrust.spiffe.socketPath | quote }} } } } }] }] }
68:         - name: control-local
69:           connect_timeout: 1s
70:           type: STATIC
71:           load_assignment: { cluster_name: control-local, endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: 127.0.0.1, port_value: {{ $controlPort }} } } } }] }] }
72:         - name: worker-mtls
73:           connect_timeout: 3s
74:           type: STRICT_DNS
