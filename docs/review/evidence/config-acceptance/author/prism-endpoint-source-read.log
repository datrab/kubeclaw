4: const required = (name) => {
5:   const value = process.env[name];
6:   if (!value) throw new Error(`${name} is required for the real Prism E2E`);
7:   return value;
8: };
9: const endpoint = required("PRISM_CONTROL_URL").replace(/\/$/, "");
10: const agentEndpoint = required("PRISM_AGENT_URL").replace(/\/$/, "");
11: const ingress = required("PRISM_E2E_INGRESS_SECRET");
12: const user = required("PRISM_E2E_USER");
13: const startedAt = new Date().toISOString();
14: const call = async (path, init = {}) => fetch(`${endpoint}${path}`, init);
15: const agentCall = async (path, init = {}) => fetch(`${agentEndpoint}${path}`, init);
16: for (let attempt = 1; attempt <= 60; attempt += 1) {
17:   try {
18:     const response = await call("/health");
19:     if (response.ok) break;
20:   } catch {
21:     // The native sidecar can still be obtaining its first SVID from SPIRE.
22:   }
23:   if (attempt === 60) throw new Error("Worker Trust proxy did not become ready");
24:   await new Promise((resolve) => setTimeout(resolve, 500));
25: }
26: const session = await call("/v1/session", {
27:   method: "POST",
28:   headers: { "tailscale-user-login": user, "x-prism-ingress-secret": ingress },
29: });
30: assert.equal(session.status, 201);
31: const cookies = session.headers.getSetCookie();
32: const csrf = (await session.json()).csrf;
33: const cookie = cookies.map((value) => value.split(";", 1)[0]).join("; ");
34: const headers = {
35:   cookie,
36:   "x-prism-csrf": csrf,
37:   "content-type": "application/json",
38: };
39: const externalId = `prism-e2e-${Date.now()}`;
40: const architectureContent = {
41:   schema: "kubeclaw.architecture.v1",
42:   title: "Prism production acceptance",
43:   audience: ["operator"],
44:   surfaces: ["web"],
45:   journeys: ["review deployments"],
46:   states: ["default", "empty", "error"],
47:   constraints: ["keyboard accessible"],
48: };
49: const architectureBytes = JSON.stringify(architectureContent);
50: const architectureDigest = `sha256:${createHash("sha256").update(architectureBytes).digest("hex")}`;
51: const initialDispatchBody = JSON.stringify({
52:   request: {
53:     schema: "prism.design-request.v1",
54:     projectId: externalId,
55:     architecture: {
56:       artifactId: `artifact:${architectureDigest}`,
57:       contentDigest: architectureDigest,
58:       revision: 1,
59:     },
60:     architectureContent,
61:   },
62:   idempotencyKey: `${externalId}-request`,
63: });
64: const initialDispatchKey = `${externalId}-request`;
65: const initialDispatch = await agentCall("/v1/dispatch", {
66:   method: "POST",
67:   headers: {
68:     "content-type": "application/json",
69:     "idempotency-key": initialDispatchKey,
70:   },
71:   body: initialDispatchBody,
72: });
73: assert.equal(initialDispatch.status, 202, await initialDispatch.clone().text());
74: let projectId="";let documentId="";
75: for(let attempt=0;attempt<180;attempt++){
76:   const projectsResponse=await call("/v1/projects",{headers:{cookie}});
77:   if(projectsResponse.ok){const project=(await projectsResponse.json()).items.find((item)=>item.external_id===externalId&&item.direction_count===3);if(project){projectId=project.id;documentId=project.document_id;break;}}
78:   await new Promise((resolve)=>setTimeout(resolve,2000));
79: }
80: assert.ok(projectId&&documentId,"OpenClaw Prism agent did not commit exactly three designs");
81: const directionsResponse=await call(`/v1/projects/${projectId}/directions`,{headers:{cookie}});
82: assert.equal(directionsResponse.status,200,await directionsResponse.clone().text());
83: const directions = (await directionsResponse.json()).items;
84: assert.equal(directions.length,3);
85: const chosen = await call(`/v1/directions/${directions[0].id}/select`, {
86:   method: "POST",
87:   headers: {...headers, "Idempotency-Key": `select-${randomUUID()}`},
88:   body: JSON.stringify({ documentId: directions[0].source_document_id }),
89: });
90: assert.equal(chosen.status, 200, await chosen.clone().text());
91: const chosenResult=await chosen.clone().json();
92: const selectedDocument = chosenResult.document;
93: documentId=chosenResult.documentId;
94: const engine = await call(`/v1/documents/${documentId}/engine`, {
95:   method: "POST",
96:   headers,
97:   body: JSON.stringify({
98:     operation: "generate",
99:     baseRevision: selectedDocument.meta.revision,
100:     idempotencyKey: `${externalId}-generate`,
101:     input: {
102:       instruction:
103:         "Keep the layout and make the heading identify this live acceptance run.",
104:     },
105:   }),
106: });
107: assert.equal(engine.status, 202, await engine.clone().text());
108: let current;
109: for(let attempt=0;attempt<180;attempt++){
110:   const currentResponse=await call(`/v1/documents/${documentId}`,{headers:{cookie}});
111:   assert.equal(currentResponse.status,200);
112:   current=(await currentResponse.json()).document;
113:   if(current.meta.revision>selectedDocument.meta.revision)break;
114:   await new Promise((resolve)=>setTimeout(resolve,2000));
115: }
116: assert.ok(current.meta.revision>selectedDocument.meta.revision);
117: const revisions = await call(`/v1/documents/${documentId}/revisions`, {
118:   headers: { cookie },
119: });
120: assert.equal(revisions.status, 200);
121: assert.ok((await revisions.json()).items.length >= 3);
122: const designDigest = `sha256:${createHash("sha256").update(JSON.stringify(current)).digest("hex")}`;
123: const evaluation = await call(`/v1/documents/${documentId}/engine`, {
124:   method: "POST",
125:   headers,
126:   body: JSON.stringify({
127:     operation: "evaluate",
128:     baseRevision: current.meta.revision,
129:     idempotencyKey: `${externalId}-evaluate`,
130:     input: {},
131:   }),
132: });
133: assert.equal(evaluation.status, 200, await evaluation.clone().text());
134: const findings =
135:   (await evaluation.json()).specialistResult.values.findings ?? [];
136: const acceptedWarningIds = findings
137:   .filter((finding) => finding.level === "review")
138:   .map((finding) => finding.id);
139: const approvalResponse = await call("/v1/approvals", {
140:   method: "POST",
141:   headers,
142:   body: JSON.stringify({
143:     projectId,
144:     documentId,
145:     designDigest,
146:     acceptedWarningIds,
147:   }),
148: });
149: assert.equal(
150:   approvalResponse.status,
151:   201,
152:   await approvalResponse.clone().text(),
153: );
154: const approvalId = (await approvalResponse.json()).id;
155: const baselineResponse = await call("/v1/baselines", {
156:   method: "POST",
157:   headers,
158:   body: JSON.stringify({ projectId, documentId, approvalId }),
159: });
160: assert.equal(
161:   baselineResponse.status,
162:   201,
163:   await baselineResponse.clone().text(),
164: );
165: const baseline = await baselineResponse.json();
166: assert.match(baseline.bundleDigest, /^sha256:[a-f0-9]{64}$/);
167: const dispatchBody = JSON.stringify({
168:   request: {
169:     schema: "prism.design-request.v1",
170:     projectId: externalId,
171:     architecture: {
172:       artifactId: `artifact:${architectureDigest}`,
173:       contentDigest: architectureDigest,
174:       revision: 1,
175:     },
176:     architectureContent,
177:     approvalId,
178:   },
179:   idempotencyKey: `${externalId}-dispatch`,
180: });
181: const dispatchKey = `${externalId}-dispatch`;
182: const dispatch = await call("/v1/dispatch", {
183:   method: "POST",
184:   headers: {
185:     "content-type": "application/json",
186:     "idempotency-key": dispatchKey,
187:   },
188:   body: dispatchBody,
189: });
190: assert.equal(dispatch.status, 200, await dispatch.clone().text());
191: const handoff = (await dispatch.json()).result;
192: assert.equal(handoff.bundleDigest, baseline.bundleDigest);
193: const evidence = [baseline.bundleDigest, designDigest];
194: console.log(
195:   JSON.stringify({
196:     status: "passed",
197:     testVersion: "prism-live-service-e2e.v3",
198:     scope: "prism-service-only",
199:     novaStage: false,
200:     projectId,
201:     documentId,
202:     approvalId,
203:     directionCount: directions.length,
204:     repositoryCommit: process.env.GITHUB_SHA ?? "local",
205:     imageReferences: required("PRISM_E2E_IMAGE_REFERENCES").split(",").filter(Boolean),
206:     clusterIdentity: required("CLUSTER_ID"),
207:     namespace: process.env.PRISM_NAMESPACE ?? "kubeclaw",
208:     startedAt,
209:     finishedAt: new Date().toISOString(),
210:     evidenceArtifactDigests: evidence,
211:     skippedChecks: ["nova-stage", "forge-implementation", "buster-fidelity"],
212:   }),
213: );
