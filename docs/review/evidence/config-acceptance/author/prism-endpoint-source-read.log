1964:             - { name: PRISM_AGENT_URL, value: "http://127.0.0.1:18444" }
1965:             - name: PRISM_E2E_USER
1966:               valueFrom: { configMapKeyRef: { name: ${runner_job}, key: user } }
1967:             - name: PRISM_E2E_IMAGE_REFERENCES
1968:               valueFrom: { configMapKeyRef: { name: ${runner_job}, key: image-references } }
1969:             - name: CLUSTER_ID
1970:               valueFrom: { configMapKeyRef: { name: ${runner_job}, key: cluster } }
1971:             - name: PRISM_NAMESPACE
1972:               valueFrom: { configMapKeyRef: { name: ${runner_job}, key: namespace } }
1973:             - name: PRISM_E2E_INGRESS_SECRET
1974:               valueFrom: { secretKeyRef: { name: ${PRISM_RUNTIME_SECRET_NAME}, key: ingress-secret } }
1975:           securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
1976:       volumes:
1977:         - { name: worker-trust-envoy, configMap: { name: prism-worker-trust, defaultMode: 0444 } }
1978:         - name: spiffe-workload-api
1979:           csi: { driver: csi.spiffe.io, readOnly: true }
1980:         - { name: worker-trust-tmp, emptyDir: { sizeLimit: 64Mi } }
1981: EOF
1982:   kubectl wait -n "$PRISM_NAMESPACE" --for=condition=complete "job/$runner_job" --timeout=30m || { kubectl logs -n "$PRISM_NAMESPACE" "job/$runner_job"; return 1; }
1983:   kubectl logs -n "$PRISM_NAMESPACE" "job/$runner_job"
1984:   if [[ ${PRISM_E2E_RUN_FAILURES:-false} == "true" ]]; then
1985:     PRISM_NAMESPACE="$PRISM_NAMESPACE" node "$REPO_DIR/tests/verification/live/prism-production-failures.mjs"
1986:   else
1987:     info "Prism service smoke complete. The Nova, Forge, Buster, and failure gates remain separate required production checks."
1988:   fi
