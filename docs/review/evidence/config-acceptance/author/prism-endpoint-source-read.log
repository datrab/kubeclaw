70: /** Capture one startup configuration before asynchronous signing-key I/O. */
71: export async function loadControlCompositionConfig(environment: NodeJS.ProcessEnv = process.env) {
72:   const snapshot = {...environment};
73:   const service = loadControlServerConfig(snapshot);
74:   const product = await loadProductAuthorityConfig(snapshot);
75:   return Object.freeze({service, product, listener: Object.freeze({port: service.port, databaseUrl: snapshot.DATABASE_URL})});
