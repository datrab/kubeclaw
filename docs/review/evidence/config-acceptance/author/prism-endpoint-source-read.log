1932:   kubectl apply -n "$PRISM_NAMESPACE" -f - <<EOF
1933: apiVersion: batch/v1
1934: kind: Job
1935: metadata: { name: ${runner_job}, labels: { app: prism-test-runner } }
1936: spec:
1937:   backoffLimit: 0
1938:   ttlSecondsAfterFinished: 600
1939:   template:
