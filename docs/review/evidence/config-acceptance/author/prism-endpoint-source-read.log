1949:           restartPolicy: Always
1950:           image: ${worker_trust_image}
1951:           args: ["-c", "/etc/kubeclaw-worker-trust/runner.yaml", "--service-cluster", "prism-test-runner"]
1952:           securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
1953:           resources: { requests: { cpu: 50m, memory: 64Mi }, limits: { cpu: 500m, memory: 256Mi } }
1954:           volumeMounts:
1955:             - { name: worker-trust-envoy, mountPath: /etc/kubeclaw-worker-trust, readOnly: true }
1956:             - { name: spiffe-workload-api, mountPath: /run/spire/sockets, readOnly: true }
1957:             - { name: worker-trust-tmp, mountPath: /tmp }
1958:       containers:
