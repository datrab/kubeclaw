1: import { loadPrismSettings, loadPrismWorkerSettings, type PrismWorkerSettings } from '../../common/plugin-runtime/foundation/config/swarm.ts';
2: 
3: /** Platform-owned configuration is captured once before starting the worker. */
4: 
5: export function loadWorkerConfig(environment: NodeJS.ProcessEnv = process.env) {
6:   if (environment.PORT !== undefined) throw new Error('SWARM_CONFIG_LEGACY_OVERRIDE:PORT moved to prism-worker.config.json settings.ingress.port');
7:   const spiffeEnabled = environment.WORKER_TRUST_SPIFFE_ENABLED === 'true';
8:   const workerSecret = environment.PRISM_WORKER_SECRET ?? '';
9:   if (!spiffeEnabled && !workerSecret) throw new Error('PRISM_WORKER_SECRET is required');
10:   const trustedControlSpiffeId = environment.PRISM_TRUSTED_CONTROL_SPIFFE_ID ?? '';
11:   if (spiffeEnabled && !trustedControlSpiffeId) throw new Error('Prism worker SPIFFE trust policy is incomplete');
12:   const databaseUrl = environment.DATABASE_URL ?? '';
13:   if (!spiffeEnabled && !databaseUrl) throw new Error('DATABASE_URL is required');
14:   const snapshot = loadPrismSettings(environment);
15:   const settings = snapshot.worker;
16:   return Object.freeze({ spiffeEnabled, workerSecret, trustedControlSpiffeId, databaseUrl, shutdownTimeoutMs: settings.shutdownTimeoutMs,
17:     controlInternalUrl: new URL(environment.PRISM_CONTROL_INTERNAL_URL ?? 'http://prism-control:8080'),
18:     native: snapshot.native, port: settings.port, ingress: ingressLimits(settings),
19:   });
20: }
21: 
22: export function workerIngressLimits(environment: NodeJS.ProcessEnv = process.env) {
23:   return ingressLimits(loadPrismWorkerSettings(environment));
24: }
25: 
26: function ingressLimits(settings: PrismWorkerSettings) {
27:   return Object.freeze({
28:     maximumActiveRequests: settings.maximumActiveRequests,
29:     maximumProbeRequests: settings.maximumProbeRequests,
30:     maximumConnections: settings.maximumConnections,
31:     maximumInputBytes: settings.maximumInputBytes,
32:     requestTimeoutMs: settings.requestTimeoutMs,
33:   });
34: }
{"path": "skills/prism/config/native-worker.ts", "sha256": "c2a0722a4a938830529d5f60ff5fb4533984a0f8e38c37c693be79c0674141a6"}
1: import path from 'node:path';
2: import { requirePrismResourcePoolCapacity } from './resource-policy.ts';
3: import type { loadWorkerConfig } from '../server/worker-config.ts';
4: import { readNativeWorkerNodeIdentity, readNativeWorkerPoolPolicy, requireNativeWorkerRuntimeIdentity } from '@kubeclaw/worker-core';
5: 
6: /** Image identity shared by producer and worker. */
7: export function prismEngineContentDigest(environment: NodeJS.ProcessEnv = process.env): string | undefined {
8:   const digest = environment.PRISM_ENGINE_CONTENT_DIGEST?.trim();
9:   if (environment.NODE_ENV === 'production' && !/^sha256:[a-f0-9]{64}$/u.test(digest ?? '')) {
10:     throw new Error('PRISM_NATIVE_ENGINE_CONTENT_IDENTITY_REQUIRED');
11:   }
12:   return digest;
13: }
14: 
15: export function nativePrismHostConfig(environment: NodeJS.ProcessEnv = process.env) {
16:   const scope = environment.KUBECLAW_NATIVE_SCOPE;
17:   if (!scope) throw new Error('PRISM_NATIVE_PREEXEC_MEMBERSHIP_REQUIRED');
18:   if (environment.PRISM_NATIVE_MAXIMUM_INPUT_BYTES !== undefined) throw new Error('SWARM_CONFIG_LEGACY_OVERRIDE:PRISM_NATIVE_MAXIMUM_INPUT_BYTES');
19:   const maximumInputBytes = Number(environment.PRISM_NATIVE_ASSIGNED_INPUT_BYTES);
20:   if (!Number.isSafeInteger(maximumInputBytes) || maximumInputBytes < 1 || maximumInputBytes > 2_147_483_647) throw new Error('PRISM_NATIVE_INPUT_LIMIT_REQUIRED');
21:   const controlInternalUrl = new URL(environment.PRISM_CONTROL_INTERNAL_URL!);
22:   const workerSecret = environment.PRISM_WORKER_SECRET ?? '';
23:   const spiffeEnabled = environment.WORKER_TRUST_SPIFFE_ENABLED === 'true';
24:   if (!spiffeEnabled && !workerSecret) throw new Error('PRISM_NATIVE_ARTIFACT_AUTH_REQUIRED');
25:   return Object.freeze({ scope, maximumInputBytes, controlInternalUrl, workerSecret, spiffeEnabled });
26: }
27: 
28: export function nativePrismSupervisorConfig(config: ReturnType<typeof loadWorkerConfig>, environment: NodeJS.ProcessEnv = process.env) {
29:   const root = (name: string) => {
30:     const value = environment[name];
31:     if (!value || !path.isAbsolute(value) || path.resolve(value) !== value || value === '/') throw new Error(`PRISM_NATIVE_PATH_REQUIRED:${name}`);
32:     return value;
33:   };
34:   const engineContentDigest = prismEngineContentDigest(environment);
35:   if (!/^sha256:[a-f0-9]{64}$/u.test(engineContentDigest ?? '')) throw new Error('PRISM_NATIVE_ENGINE_CONTENT_IDENTITY_REQUIRED');
36:   const pool = readNativeWorkerPoolPolicy(root('PRISM_NATIVE_POOL_POLICY_FILE'), 'prism');
37:   requirePrismResourcePoolCapacity(config.native.resourcePolicy, pool.limits);
38:   requireNativeWorkerRuntimeIdentity(pool.runtimeIdentityFile);
39:   return Object.freeze({
40:     ...prismSupervisorSettings(config),
41:     engineContentDigest: engineContentDigest!,
42:     cgroupRoot: pool.cgroupRoot, ownershipRoot: pool.ownershipRoot,
43:     poolLimits: pool.limits, nodeIdentity: readNativeWorkerNodeIdentity(pool.nodeIdentityFile),
44:     launcher: root('PRISM_NATIVE_LAUNCHER'),
45:     maximumActiveScopes: pool.maximumActiveScopes,
46:     browserPath: environment.PLAYWRIGHT_BROWSERS_PATH ?? '/ms-playwright',
47:   });
48: }
49: 
50: /** Numeric startup snapshot; host authority is validated separately before composition. */
51: export function prismSupervisorSettings(config: ReturnType<typeof loadWorkerConfig>) {
52:   const supervisor = config.native.supervisor;
53:   return Object.freeze({
54:     policy: config.native.resourcePolicy,
55:     uid: supervisor.uid, gid: supervisor.gid,
56:     maximumRecords: supervisor.maximumOwnershipRecords,
57:     maximumBytes: supervisor.maximumOwnershipBytes,
58:     maximumInputBytes: config.ingress.maximumInputBytes,
59:     maximumOutputBytes: supervisor.maximumOutputBytes,
60:     maximumResultBytes: config.native.maximumResultBytes,
61:     maximumJournalBytes: supervisor.maximumJournalBytes,
62:     pollIntervalMs: supervisor.pollIntervalMs,
63:     drainTimeoutMs: supervisor.drainTimeoutMs,
64:     closeTimeoutMs: supervisor.closeTimeoutMs,
65:   });
66: }
{"path": "skills/prism/server/native-worker-execution.ts", "sha256": "d87eb7d05cdc40f3eb353dba63236fa8c20a02adf1b70512c81944bb7cb71a56"}
1: import { prismAttemptResourceLimits } from '../config/resource-policy.ts';
2: import { fileURLToPath } from 'node:url';
3: import path from 'node:path';
4: import { executeNativeWorkerAttempt, NativeAttemptJournal, recoverNativeWorkerAttempts, type NativeWorkerOwnership } from '@kubeclaw/worker-core';
5: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
6: import { prismNativeWorkerProfile } from '../engine/worker-envelope.ts';
7: import type { nativePrismSupervisorConfig } from '../config/native-worker.ts';
8: import type { loadWorkerConfig } from './worker-config.ts';
9: 
10: /** Only serializable trusted configuration crosses into the per-attempt host. */
11: export async function nativePrismExecution(owner: NativeWorkerOwnership, native: ReturnType<typeof nativePrismSupervisorConfig>,
12:   config: ReturnType<typeof loadWorkerConfig>) {
13:   const journal = new NativeAttemptJournal(path.join(native.ownershipRoot, 'attempt-journal'), {
14:     maximumRecords: native.maximumRecords, maximumStateBytes: native.maximumBytes,
15:     maximumTotalBytes: native.maximumJournalBytes, maximumInputBytes: native.maximumInputBytes,
16:     maximumOutputBytes: native.maximumOutputBytes, maximumResultBytes: native.maximumResultBytes,
17:   });
18:   await recoverNativeWorkerAttempts(journal, owner);
19:   const command = nativePrismCommand(native, config);
20:   return {
21:     ready: () => owner.isReady(),
22:     async execute(envelope: WorkerAttemptEnvelopeV3, signal: AbortSignal) {
23:       validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
24:       const recovered = await journal.hasAttempt(envelope);
25:       if (!recovered && envelope.profile.profileDigest !== prismNativeWorkerProfile.profileDigest) throw new Error('PRISM_NATIVE_PROFILE_NOT_ACCEPTED');
26:       const resourceLimits = prismAttemptResourceLimits(envelope, native.policy, recovered);
27:       return executeNativeWorkerAttempt({ envelope, journal, process: { owner, command, signal,
28:         limits: { ...resourceLimits,
29:           timeoutMs: envelope.limits.timeoutMs + 8 * envelope.limits.cleanupTimeoutMs,
30:           maximumInputBytes: native.maximumInputBytes, maximumOutputBytes: native.maximumOutputBytes,
31:           pollIntervalMs: native.pollIntervalMs, closeTimeoutMs: native.closeTimeoutMs },
32:       } });
33:     },
34:   };
35: }
36: 
37: /** Build a closed child environment from the startup snapshot, never process.env. */
38: export function nativePrismCommand(native: ReturnType<typeof nativePrismSupervisorConfig>, config: ReturnType<typeof loadWorkerConfig>) {
39:   return { launcher: native.launcher, uid: native.uid, gid: native.gid, executable: process.execPath,
40:     arguments: [fileURLToPath(new URL('./native-worker-host.ts', import.meta.url))], cwd: process.cwd(),
41:     environment: { PATH: '/usr/local/bin:/usr/bin:/bin', HOME: '/tmp', NODE_ENV: 'production',
42:       PRISM_ENGINE_CONTENT_DIGEST: native.engineContentDigest,
43:       PLAYWRIGHT_BROWSERS_PATH: native.browserPath, PRISM_CONTROL_INTERNAL_URL: config.controlInternalUrl.toString(),
44:       PRISM_WORKER_SECRET: config.workerSecret, WORKER_TRUST_SPIFFE_ENABLED: String(config.spiffeEnabled),
45:       PRISM_NATIVE_ASSIGNED_INPUT_BYTES: String(native.maximumInputBytes) },
46:   };
47: }
{"path": "skills/prism/control/native-operation.ts", "sha256": "1c394e56baaddf1a338f4194e26391333a490f53278e12aeda70a1924a4486ac"}
1: import { requestWorkerResult } from './worker-operation-transport.ts';
2: import type { ContentAddressedArtifactStore, Database } from '../storage/index.ts';
3: import { prismNativeAttempt } from '../engine/worker-envelope.ts';
4: import type { EngineOperation } from '../engine/index.ts';
5: import type { loadControlServerConfig } from '../server/control-config.ts';
6: import { WorkerArtifactClient } from '../server/worker-artifacts.ts';
7: import { hydrateWorkerResult } from './worker-evidence.ts';
8: import { reserveNativePrismOperation, recordNativePrismResult, completeNativePrismOperation } from './native-operation-store.ts';
9: 
10: type Config = ReturnType<typeof loadControlServerConfig>;
11: 
12: export async function runNativePrismOperation(database: Database, artifacts: ContentAddressedArtifactStore,
13:   config: Config, operation: EngineOperation, input: Record<string, unknown>, key: string): Promise<Record<string, unknown>> {
14:   const stored = await artifacts.put(Buffer.from(JSON.stringify(input)));
15:   const proposed = prismNativeAttempt(operation, { artifactId: stored.artifactId, type: 'prism-engine-input', mediaType: 'application/json',
16:     contentDigest: stored.digest, sizeBytes: stored.sizeBytes,
17:     storageUrl: new URL(`/v1/internal/artifacts/${stored.digest}`, config.controlInternalUrl).toString() }, key, config.nativeResourcePolicy);
18:   const reserved = await reserveNativePrismOperation(database, key, proposed);
19:   const client = new WorkerArtifactClient(config.controlInternalUrl, config.workerSecret, config.spiffeEnabled);
20:   if (reserved.result) {
21:     const hydrated = await hydrateWorkerResult(reserved.result.attempt, reserved.result.workerResult, client);
22:     await completeNativePrismOperation(database, key, reserved.result.attempt.executionId);
23:     return hydrated.values;
24:   }
25:   const received = await requestWorkerResult(config, reserved.attempt);
26:   const result = await recordNativePrismResult(database, key, reserved.attempt, received);
27:   const hydrated = await hydrateWorkerResult(reserved.attempt, result, client);
28:   await completeNativePrismOperation(database, key, reserved.attempt.executionId);
29:   return hydrated.values;
30: }
