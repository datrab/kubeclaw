    1 export interface EngineCacheLimits {
    2   readonly maximumInFlight: number;
    3   readonly maximumCompletedEntries: number;
    4   readonly maximumCompletedBytes: number;
    5 }
    6 export const DEFAULT_ENGINE_CACHE_LIMITS: EngineCacheLimits = Object.freeze({
    7   maximumInFlight: 4,
    8   maximumCompletedEntries: 32,
    9   maximumCompletedBytes: 16 * 1024 * 1024,
   10 });
   11 type Pending<T> = { fingerprint: string; result: Promise<T>; owner: AbortSignal | undefined };
   12 type Completed = { fingerprint: string; serialized: string; bytes: number };
   13 
   14 /** RAM optimization only; durable request/result replay belongs to Control. */
   15 export class EngineExecutionCache<T> {
   16   readonly #limits: EngineCacheLimits;
   17   readonly #pending = new Map<string, Pending<T>>();
   18   readonly #completed = new Map<string, Completed>();
   19   #completedBytes = 0;
   20 
   21   constructor(limits: EngineCacheLimits = DEFAULT_ENGINE_CACHE_LIMITS) {
   22     for (const value of [limits.maximumInFlight, limits.maximumCompletedEntries, limits.maximumCompletedBytes]) {
   23       if (!Number.isSafeInteger(value) || value < 1) throw new Error('PRISM_ENGINE_CACHE_LIMIT_INVALID');
   24     }
   25     this.#limits = Object.freeze({ ...limits });
   26   }
   27 
   28   usage() {
   29     return Object.freeze({ inFlight: this.#pending.size, completedEntries: this.#completed.size,
   30       completedBytes: this.#completedBytes, totalEntries: this.#pending.size + this.#completed.size });
   31   }
   32 
   33   async execute(key: string, fingerprint: string, execute: () => Promise<T>, owner?: AbortSignal): Promise<T> {
   34     owner?.throwIfAborted();
   35     const pending = this.#pending.get(key);
   36     const completed = this.#completed.get(key);
   37     if ((pending && pending.fingerprint !== fingerprint) || (completed && completed.fingerprint !== fingerprint)) {
   38       throw new Error('idempotency key was used for a different request');
   39     }
   40     if (pending) {
   41       if (pending.owner !== owner) throw new Error('PRISM_ENGINE_EXECUTION_OWNER_CONFLICT');
   42       return pending.result;
   43     }
   44     if (completed) {
   45       this.#completed.delete(key);
   46       this.#completed.set(key, completed);
   47       return JSON.parse(completed.serialized) as T;
   48     }
   49     if (this.#pending.size >= this.#limits.maximumInFlight) throw new Error('PRISM_ENGINE_IN_FLIGHT_LIMIT');
   50     // Reserve ownership before beginning execution, including synchronous callbacks.
   51     const result = Promise.resolve().then(() => {
   52       owner?.throwIfAborted();
   53       return execute();
   54     }).then(value => {
   55       try {
   56         owner?.throwIfAborted();
   57         this.#retain(key, fingerprint, value);
   58         return value;
   59       } finally { this.#pending.delete(key); }
   60     }, (error: unknown) => {
   61       this.#pending.delete(key);
   62       throw error;
   63     });
   64     // Duplicates share the checked retention settlement, never inner execution alone.
   65     this.#pending.set(key, { fingerprint, result, owner });
   66     return result;
   67   }
   68 
   69   #retain(key: string, fingerprint: string, value: T): void {
   70     const serialized = JSON.stringify(value);
   71     const bytes = Buffer.byteLength(serialized) + Buffer.byteLength(key) + Buffer.byteLength(fingerprint);
   72     if (bytes > this.#limits.maximumCompletedBytes) return;
   73     while (this.#completed.size >= this.#limits.maximumCompletedEntries
   74       || this.#completedBytes + bytes > this.#limits.maximumCompletedBytes) {
   75       const oldest = this.#completed.keys().next().value!;
   76       this.#completedBytes -= this.#completed.get(oldest)!.bytes;
   77       this.#completed.delete(oldest);
   78     }
   79     this.#completed.set(key, { fingerprint, serialized, bytes });
   80     this.#completedBytes += bytes;
   81   }
   82 }
