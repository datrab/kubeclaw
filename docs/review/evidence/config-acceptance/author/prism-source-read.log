    1 import type {
    2   SpecialistOperationV1,
    3   WorkerSpecialistResultV1,
    4 } from "@kubeclaw/pipeline-worker-core-contract";
    5 import { engineRequestSchema, engineResultSchema } from "@kubeclaw/prism-contracts-v1/digest";
    6 import { validateEngineRequest, validateEngineResult, validatePrism } from "@kubeclaw/prism-contracts-v1";
    7 import type { PrismEngine, EngineOperation } from "./index.ts";
    8 const supportedOperations = new Set<EngineOperation>([
    9   "generate",
   10   "render",
   11   "evaluate",
   12   "ingest",
   13   "publish",
   14 ]);
   15 export async function executePrismOperation(
   16   engine: PrismEngine,
   17   operation: SpecialistOperationV1,
   18   idempotencyKey: string,
   19   hydratedInput?: Record<string,unknown>,
   20   signal?: AbortSignal,
   21 ): Promise<WorkerSpecialistResultV1> {
   22   if (operation.contractId !== "kubeclaw.prism-design-engine@1")
   23     throw new Error("worker operation is not for Prism");
   24   const rawName = operation.values.operation;
   25   if (
   26     typeof rawName !== "string" ||
   27     !supportedOperations.has(rawName as EngineOperation)
   28   )
   29     throw new Error("unsupported Prism operation");
   30   const name = rawName as EngineOperation;
   31   const requestContract = engineRequestSchema(name);
   32   if (operation.inputSchemaId !== requestContract.schemaId || operation.inputSchemaDigest !== requestContract.schemaDigest)
   33     throw new Error("Prism request schema does not match the installed contract");
   34   const input = hydratedInput??operation.values.input as Record<string, unknown>;
   35   validateEngineRequest(name,{operation:name,input});
   36   if(name!=="ingest")validatePrism("designDocument",input.document);
   37   const result = await engine.execute({
   38     contract: "kubeclaw.prism-design-engine@1",
   39     operation: name,
   40     input,
   41     idempotencyKey,
   42   }, signal ? { signal } : {});
   43   const resultContract = engineResultSchema(name);
   44   validateEngineResult(name,result.output);
   45   return {
   46     schemaId: resultContract.schemaId,
   47     schemaDigest: resultContract.schemaDigest,
   48     values: result.output as WorkerSpecialistResultV1["values"],
   49   };
   50 }
