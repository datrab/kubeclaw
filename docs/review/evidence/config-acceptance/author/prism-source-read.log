    1 import { createHash } from "node:crypto";
    2 import { validatePrism, type PrismDocument } from "@kubeclaw/prism-contracts-v1";
    3 import type { PrismOperation } from "../domain/index.ts";
    4 import type { DesignProvider } from "./index.ts";
    5 
    6 export class DeterministicDesignProvider implements DesignProvider {
    7   async embed(
    8     text: string,
    9     signal?: AbortSignal,
   10   ): Promise<{ embedding: number[]; model: string; modelVersion: string }> {
   11     signal?.throwIfAborted();
   12     const bytes = createHash("sha256").update(text).digest();
   13     return {
   14       embedding: Array.from(bytes.subarray(0, 16), (value) => value / 255),
   15       model: "deterministic-test-only",
   16       modelVersion: "1",
   17     };
   18   }
   19   async propose(
   20     document: PrismDocument,
   21     instruction: string,
   22     signal?: AbortSignal,
   23   ): Promise<PrismOperation[]> {
   24     signal?.throwIfAborted();
   25     const node = document.views.home?.root.children?.[0];
   26     if (!node) return [];
   27     return [
   28       {
   29         type: "node.props.set",
   30         baseRevision: document.meta.revision,
   31         nodeId: node.id,
   32         props: { content: instruction || "Updated design" },
   33       },
   34     ];
   35   }
   36 }
   37 
   38 export class OpenAICompatibleDesignProvider implements DesignProvider {
   39   readonly #endpoint: URL;
   40   readonly #embeddingEndpoint: URL | null;
   41   readonly #apiKey: string;
   42   readonly #model: string;
   43   readonly #embeddingModel: string;
   44   readonly #timeoutMs: number;
   45   constructor(options: {
   46     endpoint: string;
   47     embeddingEndpoint: string;
   48     apiKey: string;
   49     model: string;
   50     embeddingModel: string;
   51     timeoutMs?: number;
   52   }) {
   53     const providerUrl = (value: string, label: string) => {
   54       const url = new URL(value);
   55       const internalHttp =
   56         url.protocol === "http:" &&
   57         (url.hostname.endsWith(".svc.cluster.local") ||
   58           url.hostname.endsWith(".svc"));
   59       if (url.protocol !== "https:" && !internalHttp)
   60         throw new Error(
   61           `${label} requires HTTPS or an internal Kubernetes Service`,
   62         );
   63       return url;
   64     };
   65     this.#endpoint = providerUrl(options.endpoint, "design provider");
   66     if (!options.apiKey || !options.model)
   67       throw new Error("design provider credentials and model are required");
   68     if (Boolean(options.embeddingEndpoint) !== Boolean(options.embeddingModel))
   69       throw new Error(
   70         "embedding provider endpoint and model must be configured together",
   71       );
   72     this.#embeddingEndpoint = options.embeddingEndpoint
   73       ? providerUrl(options.embeddingEndpoint, "embedding provider")
   74       : null;
   75     this.#apiKey = options.apiKey;
   76     this.#model = options.model;
   77     this.#embeddingModel = options.embeddingModel;
   78     this.#timeoutMs = options.timeoutMs ?? 60_000;
   79   }
   80   async propose(
   81     document: PrismDocument,
   82     instruction: string,
   83     signal?: AbortSignal,
   84   ): Promise<PrismOperation[]> {
   85     const response = await fetch(this.#endpoint, {
   86       method: "POST",
   87       signal: signal
   88         ? AbortSignal.any([signal, AbortSignal.timeout(this.#timeoutMs)])
   89         : AbortSignal.timeout(this.#timeoutMs),
   90       headers: {
   91         authorization: `Bearer ${this.#apiKey}`,
   92         "content-type": "application/json",
   93       },
   94       body: JSON.stringify({
   95         model: this.#model,
   96         response_format: { type: "json_object" },
   97         messages: [
   98           {
   99             role: "system",
  100             content:
  101               "Return JSON with an operations array. Use only Prism typed operations. Do not return code or markdown.",
  102           },
  103           { role: "user", content: JSON.stringify({ instruction, document }) },
  104         ],
  105       }),
  106     });
  107     if (!response.ok)
  108       throw new Error(`design provider failed: ${response.status}`);
  109     const envelope = (await response.json()) as {
  110       choices?: Array<{ message?: { content?: string } }>;
  111     };
  112     const text = envelope.choices?.[0]?.message?.content;
  113     if (!text) throw new Error("design provider returned no content");
  114     const parsed = JSON.parse(text) as { operations?: unknown };
  115     if (!Array.isArray(parsed.operations))
  116       throw new Error("design provider returned invalid operations");
  117     return parsed.operations.map((value) =>
  118       validatePrism<PrismOperation>("operation", value),
  119     );
  120   }
  121   async embed(
  122     text: string,
  123     signal?: AbortSignal,
  124   ): Promise<{ embedding: number[]; model: string; modelVersion: string }> {
  125     if (!this.#embeddingEndpoint || !this.#embeddingModel)
  126       throw new Error("embedding provider is not configured");
  127     const response = await fetch(this.#embeddingEndpoint, {
  128       method: "POST",
  129       signal: signal
  130         ? AbortSignal.any([signal, AbortSignal.timeout(this.#timeoutMs)])
  131         : AbortSignal.timeout(this.#timeoutMs),
  132       headers: {
  133         authorization: `Bearer ${this.#apiKey}`,
  134         "content-type": "application/json",
  135       },
  136       body: JSON.stringify({
  137         model: this.#embeddingModel,
  138         input: text,
  139         encoding_format: "float",
  140       }),
  141     });
  142     if (!response.ok)
  143       throw new Error(`embedding provider failed: ${response.status}`);
  144     const value = (await response.json()) as {
  145       data?: Array<{ embedding?: number[] }>;
  146     };
  147     const embedding = value.data?.[0]?.embedding;
  148     if (
  149       !Array.isArray(embedding) ||
  150       !embedding.length ||
  151       embedding.some((item) => !Number.isFinite(item))
  152     )
  153       throw new Error("embedding provider returned no valid vector");
  154     return { embedding, model: this.#embeddingModel, modelVersion: "provider" };
  155   }
  156 }
