   15 let bytes = 0;
   16 for await (const chunk of process.stdin) {
   17   bytes += chunk.length;
   18   if (bytes > config.maximumInputBytes) throw new Error('PRISM_NATIVE_INPUT_LIMIT');
   19   chunks.push(Buffer.from(chunk));
   20 }
   21 const envelope = JSON.parse(Buffer.concat(chunks).toString('utf8')) as WorkerAttemptEnvelopeV3;
   22 validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
   23 const artifacts = new WorkerArtifactClient(config.controlInternalUrl, config.workerSecret, config.spiffeEnabled);
   24 const engine = new PrismEngine(new DeterministicDesignProvider());
   25 const result = await new WorkerAttemptExecutor({ envelope, signal: cancellation.signal,
   26   operation: nativeOperationFor(envelope, engine, artifacts, config.scope), receiptNamespace: 'prism-native-provisional',
   27   storeFullLog(attemptId, content, { signal }) {
   28     if (attemptId !== envelope.attemptId) throw new Error('Prism log attempt identity mismatch');
   29     return artifacts.upload('prism-full-log', 'log', 'text/plain', Buffer.from(content), signal);
   30   },
   31 }).execute();
   32 // Closing stdout is not the completion boundary: the supervisor drains the tree and reseals.
   33 process.stdout.write(JSON.stringify(result));
   34 }
