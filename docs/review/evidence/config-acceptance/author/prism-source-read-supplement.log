    6   constructor(status: number | undefined, body: Buffer) {
    7     const value = body.toString('utf8').trim();
    8     const code = /^DEMO_PRODUCT_[A-Z_]{1,100}$/u.test(value) ? value : undefined;
    9     super(code ?? `product controller response ${status}`); this.code = code;
   10   }
   11 }
   12 export async function productController(config: ProductConfig, path: string, body: unknown): Promise<unknown> {
   13   const [ca, token] = await Promise.all([readFile(config.caFile), readFile(config.tokenFile, 'utf8')]);
   14   if (!token.trim() || token.length > 64_000 || /[\r\n]/u.test(token.trim())) throw new Error('invalid product controller transport token');
   15   const bytes = Buffer.from(JSON.stringify(body));
   16   return new Promise((resolve, reject) => {
   17     const outgoing = request(new URL(path, config.controller), {method: 'POST', ca, rejectUnauthorized: true,
   18       signal: AbortSignal.timeout(15_000), headers: {authorization: `Bearer ${token.trim()}`, 'content-type': 'application/json', 'content-length': bytes.length}}, response => {
   19       const chunks: Buffer[] = []; let size = 0;
   20       response.on('data', (chunk: Buffer) => { size += chunk.length; if (size > 1_000_000) response.destroy(new Error('product controller response too large')); else chunks.push(chunk); });
   21       response.on('error', reject);
   22       response.on('end', () => {
   23         if (response.statusCode !== 200) { reject(new ProductControllerError(response.statusCode, Buffer.concat(chunks))); return; }
   24         try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); } catch (error) { reject(error); }
   25       });
   26     });
   27     outgoing.on('error', reject); outgoing.end(bytes);
   28   });
   29 }
