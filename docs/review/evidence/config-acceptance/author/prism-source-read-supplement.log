   59 }
   60 export function signProductIntent(intent: ProductIntent, actor: {user: string; expiresAt: number}, config: ProductConfig, now = Date.now()): {envelope: ProductEnvelope; payload: ProductPayload; payloadDigest: string} {
   61   const expiry = Math.floor(Math.min(now + 300_000, actor.expiresAt) / 1000) * 1000;
   62   if (expiry <= now) throw new Error('operator session expires before decision issuance');
