    8 function renderAssetsFor(
    9   document: PrismDocument,
   10   input: Record<string, unknown>,
   11 ): Record<string, unknown> {
   12   const suppliedAssets = (input.assetSources ?? {}) as Record<string, unknown>;
   13   const renderAssets: Record<string, unknown> = {};
   14   for (const [assetId, rawAsset] of Object.entries(document.assets)) {
   15     const asset = rawAsset as {
   16       artifact?: string;
   17       mediaType?: string;
   18       alt?: string;
   19     };
   20     const src = suppliedAssets[assetId];
   21     if (
   22       !asset.artifact ||
   23       !asset.mediaType ||
   24       typeof src !== "string" ||
   25       !src.startsWith(`data:${asset.mediaType};base64,`) ||
   26       src.length > 16_000_000
   27     )
   28       throw new Error(`render asset is unavailable: ${assetId}`);
   29     renderAssets[assetId] = {
   30       ...asset,
   31       src,
   32     };
   33   }
   34   return renderAssets;
   35 }
   36 
   37 function renderHtml(
   38   document: PrismDocument,
   39   input: Record<string, unknown>,
   40 ): string {
   41   const renderAssets = renderAssetsFor(document, input);
   42   const safeColor = (value: unknown, fallback: string) =>
   43     typeof value === "string" &&
   44     /^(?:#[0-9a-f]{3,8}|rgba?\([0-9., %]+\)|hsla?\([0-9., %a-z]+\)|transparent|currentColor)$/iu.test(
   45       value,
   46     )
   47       ? value
   48       : fallback;
   49   const safeFont = (value: unknown) =>
   50     typeof value === "string" && /^[a-z0-9 _-]{1,80}$/iu.test(value)
   51       ? value
   52       : "system-ui";
   53   const bodyBackground = safeColor(
   54     (document.theme.colors as Record<string, unknown>)?.background,
   55     "#ffffff",
   56   );
   57   const bodyForeground = safeColor(
   58     (document.theme.colors as Record<string, unknown>)?.text,
   59     "#111111",
   60   );
   61   const viewData = document.views[String(input.view)]?.mockData as Record<string, unknown> | undefined;
   62   const bodyFont = safeFont(
   63     (
   64       (document.theme.typography as Record<string, unknown>)?.body as
   65         Record<string, unknown> | undefined
   66     )?.family,
   67   );
   68   const html = `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; font-src data:; style-src 'unsafe-inline'"><style>*,*::before,*::after{box-sizing:border-box}html,body{margin:0;min-height:100%;background:${bodyBackground};color:${bodyForeground};font-family:${bodyFont},system-ui,sans-serif}button,input,select,textarea{font:inherit}img{max-width:100%;height:auto}</style></head><body>${renderNode(
   69     resolveView(
   70       document,
   71       String(input.view ?? "home"),
   72       String(input.state ?? "default"),
   73       String(input.viewport ?? "wide") as "compact" | "regular" | "wide",
   74     ),
   75     renderAssets,
   76     {
   77       ...(viewData === undefined ? {} : { data: viewData }),
   78       components: document.components,
   79       theme: document.theme as Record<string, unknown>,
   80     },
   81   )}</body></html>`;
   82   return html;
   83 }
   84 
   85 async function captureHtml(
   86   html: string,
   87   input: Record<string, unknown>,
   88   rendererMetadata: Record<string, unknown>,
   89   signal?: AbortSignal,
   90 ) {
   91   let screenshotBase64: string | undefined;
   92   let ariaSnapshot: string | undefined;
   93   let accessibilityFindings: string[] | undefined;
   94   const owned = await openOwnedBrowser(signal);
   95   const browser = owned.browser;
   96   rendererMetadata = {
   97     ...rendererMetadata,
   98     name: "chromium",
   99     version: browser.version(),
  100   };
  101   try {
  102     const widths = { compact: 390, regular: 768, wide: 1440 } as const;
  103     const context = await browser.newContext({
  104       viewport: {
  105         width: widths[String(input.viewport) as keyof typeof widths] ?? 1440,
  106         height: 1000,
  107       },
  108       locale: "en-US",
  109       timezoneId: "UTC",
  110       reducedMotion: "reduce",
  111     });
  112     const page = await context.newPage();
  113     await page.setContent(html, { waitUntil: "load" });
  114     await page.addStyleTag({
  115       content:
  116         "*,*::before,*::after{animation:none!important;transition:none!important;caret-color:transparent!important}",
  117     });
  118     screenshotBase64 = (
  119       await page.screenshot({ type: "png", fullPage: true })
  120     ).toString("base64");
  121     ariaSnapshot = await page.locator("body").ariaSnapshot();
  122     accessibilityFindings = await page
  123       .locator(
  124         "button,input,select,textarea,[role=button],[role=link],[role=tab]",
  125       )
  126       .evaluateAll(interactiveFindings);
  127     const contrast = await page.locator("body").evaluate(contrastFindings);
  128     accessibilityFindings.push(...contrast);
  129     await context.close();
  130   } finally {
  131     await owned.close();
  132   }
  133   return {
  134     screenshotBase64,
  135     ariaSnapshot,
  136     accessibilityFindings,
  137     rendererMetadata,
  138   };
  139 }
  140 
  141 export async function renderOperation(
  142   document: PrismDocument,
  143   input: Record<string, unknown>,
  144   signal?: AbortSignal,
  145 ): Promise<EngineResult> {
  146   const html = renderHtml(document, input);
  147   const capture = input.capture === true;
  148   let screenshotBase64: string | undefined;
  149   let ariaSnapshot: string | undefined;
  150   let accessibilityFindings: string[] | undefined;
  151   let rendererMetadata: Record<string, unknown> = {
  152     name: "prism-html",
  153     version: "v1",
  154     locale: "en-US",
  155     timezone: "UTC",
  156     motion: "reduced",
  157   };
  158   if (capture) {
  159     const captured = await captureHtml(html, input, rendererMetadata, signal);
  160     ({
  161       screenshotBase64,
  162       ariaSnapshot,
  163       accessibilityFindings,
  164       rendererMetadata,
  165     } = captured);
  166   }
  167   return {
  168     operation: "render",
  169     output: {
  170       html,
  171       renderer: rendererMetadata,
  172       accessibilityFindings: accessibilityFindings ?? [],
  173       ...(screenshotBase64 ? { screenshotBase64, ariaSnapshot } : {}),
  174     },
  175   };
  176 }
