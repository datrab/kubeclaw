   27       return send(response,202,{jobId:job.id,generationId:job.id,status:job.state==='needs_nova'?'NeedsNova':job.state,result:job.result,outcome:job.outcome});
   28     }
   29     return send(response,404,{error:'not found'});
   30   }catch(error){return send(response,422,{error:error instanceof Error?error.message:String(error)});}
   31 });
   32 const tick=()=>{void runner.tick().catch(error=>console.error('Prism durable agent runner:',error));};
   33 const poll=setInterval(tick,1000);
