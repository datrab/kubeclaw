    1 import { chromium, type Browser } from 'playwright';
    2 
    3 export class PrismBrowserCloseError extends Error {
    4   constructor(cause: unknown) { super('PRISM_BROWSER_CLOSE_FAILED', { cause }); }
    5 }
    6 
    7 type Closed = { ok: true } | { ok: false; error: unknown };
    8 function browserCloser(browser: Browser): () => Promise<Closed> {
    9   let closing: Promise<Closed> | undefined;
   10   return () => closing ??= browser.close().then(() => ({ ok: true as const }),
   11     (error: unknown) => ({ ok: false as const, error }));
   12 }
   13 
   14 /** Only the admitted execution owner may close this browser. Core bounds drain time. */
   15 export async function openOwnedBrowser(signal: AbortSignal | undefined) {
   16   signal?.throwIfAborted();
   17   const browser = await chromium.launch({ headless: true });
   18   const closeOnce = browserCloser(browser);
   19   const abort = () => { void closeOnce(); };
   20   signal?.addEventListener('abort', abort, { once: true });
   21   const close = async () => {
   22     signal?.removeEventListener('abort', abort);
   23     const closed = await closeOnce();
   24     if (!closed.ok) throw new PrismBrowserCloseError(closed.error);
   25     signal?.throwIfAborted();
   26   };
   27   if (signal?.aborted) await close();
   28   return { browser, close };
   29 }
