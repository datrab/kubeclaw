    1 import { isDeepStrictEqual } from 'node:util';
    2 import type { IncomingMessage, ServerResponse } from 'node:http';
    3 import type { Queryable } from '../storage/index.ts';
    4 import { parseProductIntent, productActor, type ProductConfig } from '../control/product-decisions.ts';
    5 import { recordProductIntent, recordProductReceipt, storedProductDecision, type StoredProductDecision } from '../storage/product-decisions.ts';
    6 import { productController, ProductControllerError } from './product-controller.ts';
    7 import { productOperatorPage } from './product-operator-page.ts';
    8 
    9 export function receiptFor(stored: StoredProductDecision, value: unknown): Record<string, unknown> {
   10   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('invalid product receipt');
   11   const receipt = value as Record<string, unknown>;
   12   const payload = JSON.parse(Buffer.from(stored.envelope.payload, 'base64').toString('utf8')) as Record<string, unknown>;
   13   const expected = {schemaVersion: 'demo-product-decision-receipt.v1', decisionId: stored.decision_id,
   14     payloadDigest: stored.payload_digest, action: stored.intent.action, leaseName: payload.leaseName,
   15     leaseUID: payload.leaseUID, readyDigest: payload.readyDigest, generation: payload.generation,
   16     actorId: stored.actor_id, issuer: payload.issuer, previousExpiry: payload.expectedExpiry,
   17     state: stored.intent.action === 'accept' ? 'accepted' : 'extended'};
   18   const oldExpiry = String(payload.expectedExpiry);
   19   const fraction = /(?:\.([0-9]+))?Z$/u.exec(oldExpiry)?.[1];
   20   const wholeSeconds = oldExpiry.replace(/\.[0-9]+Z$/u, 'Z');
   21   const extended = new Date(Date.parse(wholeSeconds) + Number(payload.extensionSeconds ?? 0) * 1000).toISOString().replace('.000Z', fraction ? `.${fraction}Z` : 'Z');
   22   const expiresAt = stored.intent.action === 'accept' ? oldExpiry : extended;
   23   if (Object.keys(receipt).length !== Object.keys(expected).length + 3 || Object.entries(expected).some(([key, field]) => receipt[key] !== field) || !isDeepStrictEqual(receipt.envelope, stored.envelope) || receipt.expiresAt !== expiresAt || typeof receipt.appliedAt !== 'string' || !Number.isFinite(Date.parse(receipt.appliedAt))) throw new Error('product receipt does not bind the recorded decision');
   24   return receipt;
   25 }
   26 async function reconcile(db: Queryable, config: ProductConfig, stored: StoredProductDecision): Promise<Record<string, unknown>> {
   27   if (stored.receipt) return {state: 'applied', decisionId: stored.decision_id, receipt: receiptFor(stored, stored.receipt)};
   28   // The immutable status key remains usable after signature expiration. A failed status
   29   // request is ambiguous: retry only the identical envelope; never issue another one.
   30   const status = {schemaVersion: 'demo-product-status-request.v1', decisionId: stored.decision_id,
   31     leaseName: stored.intent.subject.leaseName, leaseUID: stored.intent.subject.leaseUID, payloadDigest: stored.payload_digest};
   32   try {
   33     let receipt: Record<string, unknown>;
   34     try { receipt = receiptFor(stored, await productController(config, '/v1/demo-product/status', status)); }
   35     catch { receipt = receiptFor(stored, await productController(config, '/v1/demo-product/decisions', stored.envelope)); }
   36     await recordProductReceipt(db, stored.decision_id, receipt);
   37     return {state: 'applied', decisionId: stored.decision_id, receipt};
   38   } catch (error) {
   39     return {state: 'pending', decisionId: stored.decision_id, ...(error instanceof ProductControllerError && error.code ? {controllerCode: error.code} : {}), message: 'Outcome is unconfirmed. Recover this decision; do not create a replacement.'};
   40   }
   41 }
   42 async function input(request: IncomingMessage): Promise<unknown> {
   43   if (request.headers['content-type']?.split(';')[0] !== 'application/json') throw new Error('application/json required');
   44   const chunks: Buffer[] = []; let size = 0;
   45   for await (const chunk of request) { size += chunk.length; if (size > 32_000) throw new Error('product input too large'); chunks.push(chunk); }
   46   return JSON.parse(Buffer.concat(chunks).toString('utf8'));
   47 }
   48 async function authorizedProductRoute(request: IncomingMessage, url: URL, options: {db: Queryable; config: ProductConfig}, actor: {user: string; expiresAt: number}, json: (code: number, value: unknown) => void): Promise<void> {
   49     if (url.pathname === '/v1/product-decisions/subjects' && request.method === 'GET') {
   50       json(200, await productController(options.config, '/v1/demo-product/subjects', {schemaVersion: 'demo-product-subject-request.v1'})); return;
   51     }
   52     if (url.pathname === '/v1/product-decisions' && request.method === 'GET') {
   53       const rows = await options.db.query('SELECT d.decision_id,d.intent,d.created_at,r.receipt FROM prism.product_decision d LEFT JOIN prism.product_decision_receipt r USING(decision_id) WHERE actor_id=$1 ORDER BY created_at DESC LIMIT 100', [actor.user]);
   54       json(200, {decisions: rows.rows}); return;
   55     }
   56     if (url.pathname === '/v1/product-decisions' && request.method === 'POST') {
   57       let intent;
   58       try { intent = parseProductIntent(await input(request)); }
   59       catch { json(400, {state: 'rejected-before-recording', error: 'Invalid decision input; no decision was recorded by this request.'}); return; }
   60       const stored = await recordProductIntent(options.db, intent, actor, options.config);
   61       const result = await reconcile(options.db, options.config, stored);
   62       json(result.state === 'applied' ? 200 : 202, result); return;
   63     }
   64     const recovery = /^\/v1\/product-decisions\/([0-9a-f-]{36})\/recover$/u.exec(url.pathname);
   65     if (recovery && request.method === 'POST') {
   66       const stored = await storedProductDecision(options.db, recovery[1]!);
   67       if (!stored || stored.actor_id !== actor.user) throw new Error('product decision is not owned by this operator');
   68       const result = await reconcile(options.db, options.config, stored);
   69       json(result.state === 'applied' ? 200 : 202, result); return;
   70     }
   71     json(404, {error: 'unknown product decision route'});
   72 }
   73 export async function handleProductDecisions(request: IncomingMessage, response: ServerResponse, url: URL,
   74   options: {db: Queryable; config?: ProductConfig; sessionSecret: string}): Promise<boolean> {
   75   if (!url.pathname.startsWith('/v1/product-decisions')) return false;
   76   response.setHeader('cache-control', 'no-store');
   77   const json = (code: number, value: unknown): void => {response.writeHead(code, {'content-type': 'application/json'}); response.end(JSON.stringify(value));};
   78   if (!options.config) { json(404, {error: 'product decisions are disabled'}); return true; }
   79   // The page is static and grants no authority. All data/actions authenticate below.
   80   if (url.pathname === '/v1/product-decisions/operator' && request.method === 'GET') {
   81     response.writeHead(200, {'content-type': 'text/html; charset=utf-8', 'x-frame-options': 'DENY', 'content-security-policy': "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'"}); response.end(productOperatorPage); return true;
   82   }
   83   try {
   84     const actor = productActor(request.headers, options.config, options.sessionSecret, request.method !== 'GET');
   85     await authorizedProductRoute(request, url, {db: options.db, config: options.config}, actor, json);
   86   } catch (error) { json(403, {error: error instanceof Error ? error.message : 'product decision rejected'}); }
   87   return true;
   88 }
