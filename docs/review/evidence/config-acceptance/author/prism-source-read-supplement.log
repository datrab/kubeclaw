   64   const payload: ProductPayload = {schemaVersion: 'demo-product-decision.v1', issuer: config.issuer,
   65     actorId: actor.user, decisionId: intent.decisionId, action: intent.action, reason: intent.reason,
   66     ...subject, issuedAt: new Date(Math.floor(now / 1000) * 1000).toISOString().replace('.000Z', 'Z'),
   67     expiresAt: new Date(expiry).toISOString().replace('.000Z', 'Z'),
