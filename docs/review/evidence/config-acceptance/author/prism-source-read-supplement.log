    1 import { Pool } from 'pg';
    2 import { bootstrapPrismDatabaseRoles } from './database-roles.ts';
    3 import { prismDatabaseBootstrapConfig } from '../config/database-bootstrap.ts';
    4 
    5 const config = prismDatabaseBootstrapConfig();
    6 const admin = new Pool({ connectionString: config.adminUrl, connectionTimeoutMillis: config.connectionTimeoutMs });
    7 const retryableCodes = new Set(['ECONNREFUSED', 'ECONNRESET', 'EHOSTUNREACH', 'ENETUNREACH', 'ETIMEDOUT', '57P03']);
    8 
    9 async function bootstrap(): Promise<void> {
   10   for (let attempt = 1; attempt <= config.maximumAttempts; attempt += 1) {
   11     try { await bootstrapPrismDatabaseRoles(admin, config.adminUrl, config.passwords); return; }
   12     catch (error) {
   13       const code = error && typeof error === 'object' && 'code' in error ? String(error.code) : 'UNKNOWN';
   14       if (!retryableCodes.has(code) || attempt === config.maximumAttempts) throw error;
   15       process.stderr.write(`PostgreSQL is not ready (${code}); retrying bootstrap (${attempt}/${config.maximumAttempts})\n`);
   16       await new Promise(resolve => setTimeout(resolve, config.retryDelayMs));
   17     }
   18   }
   19 }
   20 try { await bootstrap(); } finally { await admin.end(); }
