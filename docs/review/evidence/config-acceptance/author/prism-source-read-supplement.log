    8   const chunks=[];let size=0;
    9   for await(const chunk of request){size+=chunk.length;if(size>2_000_000)throw new Error('request too large');chunks.push(chunk);}
   10   return JSON.parse(Buffer.concat(chunks).toString('utf8'));
