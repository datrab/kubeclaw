3: import type { CapabilityInvocation } from './runtime.ts';
4: 
5: const PROFILE_BYTES = portableJson(CURRENT_RUNTIME_DISPATCH_PROFILE);
6: 
7: /** Exact finite canonical contract, generated from the owning schema, not a fallback codec. */
8: export function parseRuntimeDispatchProfile(value: unknown): RuntimeDispatchProfile {
9:   if (portableJson(value) !== PROFILE_BYTES) throw new Error('RUNTIME_DISPATCH_PROFILE_INVALID');
10:   return CURRENT_RUNTIME_DISPATCH_PROFILE;
11: }
12: 
13: /** Producers select the frozen run profile before effect admission. Historical absence is unchanged. */
14: export function withRuntimeDispatchProfile(
15:   request: CapabilityInvocation, profile?: RuntimeDispatchProfile,
16: ): CapabilityInvocation {
17:   if (profile === undefined) return request;
18:   const selected = parseRuntimeDispatchProfile(profile);
19:   portableJson(request);
20:   if (Object.hasOwn(request, 'runtimeDispatchProfile')) throw new Error('RUNTIME_DISPATCH_PROFILE_ALREADY_BOUND');
21:   return Object.freeze({ ...request, runtimeDispatchProfile: selected });
22: }
23: 
24: /** Only closed invocation metadata is control. An identically named model key is ordinary data. */
25: export function runtimeDispatchProfileFields(request: object, capability?: string): Readonly<{ runtimeDispatchProfile?: RuntimeDispatchProfile }> {
26:   portableJson(request);
27:   if (!Object.hasOwn(request, 'runtimeDispatchProfile')) return {};
28:   if (capability !== undefined && capability !== 'runtime.dispatch') throw new Error('RUNTIME_DISPATCH_PROFILE_CAPABILITY_INVALID');
29:   return { runtimeDispatchProfile: parseRuntimeDispatchProfile((request as CapabilityInvocation).runtimeDispatchProfile) };
30: }
