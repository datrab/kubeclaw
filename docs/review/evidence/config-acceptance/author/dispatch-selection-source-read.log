1: import type {
2:   AdapterActivationContext,
3:   AdapterInstance,
4:   EffectRequest,
5: } from '@kubeclaw/plugin-sdk';
6: 
7: interface DispatchInvocation<Target> {
8:   readonly context: AdapterActivationContext;
9:   readonly target: Target;
10:   readonly request: EffectRequest;
11:   readonly signal: AbortSignal;
12: }
13: 
14: export function createDispatchAdapter<Target>(
15:   context: AdapterActivationContext,
16:   targets: ReadonlyMap<string, Target>,
17:   assertRequest: (request: EffectRequest) => void,
18:   dispatch: (invocation: DispatchInvocation<Target>) => Promise<Readonly<Record<string, unknown>>>,
19: ): AdapterInstance {
20:   let shuttingDown = false;
21:   return {
22:     async ready() {
23:       if (shuttingDown) throw new Error('ADAPTER_SHUTTING_DOWN');
24:     },
25:     async invoke({ request, signal, confidential, fence }) {
26:       if (!confidential) fence.assertCurrent();
27:       if (shuttingDown) throw new Error('ADAPTER_SHUTTING_DOWN');
28:       if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
29:       assertRequest(request);
30:       const target = targets.get(request.resource.canonicalId);
31:       if (!target) throw new Error(`RUNTIME_TARGET_DENIED:${request.resource.canonicalId}`);
32:       return dispatch({ context, target, request, signal });
33:     },
34:     async shutdown() {
35:       shuttingDown = true;
36:     },
37:   };
38: }
