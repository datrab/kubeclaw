1: import type { OpenClawTarget } from './openclaw.ts';
2: 
3: const ID = /^[a-z0-9](?:[a-z0-9._:-]{0,126}[a-z0-9])?$/;
4: const KEYS = new Set(['endpoint', 'tokenSecret', 'runtime', 'agentId', 'agentRole', 'model', 'thinking', 'controllerSessionKey', 'collectorMode', 'spawnIntervalMs', 'cwd', 'repositoryRoot', 'workspaceRoot', 'pollMs', 'maxPollMs', 'maxPolls', 'sessionTimeoutMs', 'resultPathPrefix', 'resultEndpoint', 'resultTokenSecret', 'tokenizerEncoding', 'maxPromptBytes', 'maxInputTokens', 'maxOutputTokens', 'maxContextTokens']);
5: 
6: function record(value: unknown): value is Record<string, unknown> { return value !== null && typeof value === 'object' && !Array.isArray(value); }
7: function exact(value: Record<string, unknown>, allowed: ReadonlySet<string>, code: string): void { for (const key of Object.keys(value)) if (!allowed.has(key)) throw new Error(`${code}:${key}`); }
8: function optionalUrl(value: unknown): string | undefined { return typeof value === 'string' ? new URL(value).href.replace(/\/+$/u, '') : undefined; }
9: function validHttp(value: URL): boolean { return ['http:', 'https:'].includes(value.protocol) && !value.username && !value.password && !value.hash; }
10: function validInteger(value: number, minimum: number, maximum = Number.MAX_SAFE_INTEGER): boolean { return Number.isSafeInteger(value) && value >= minimum && value <= maximum; }
11: function text(value: unknown, fallback = ''): string { return typeof value === 'string' ? value.trim() : fallback; }
12: function idValue(value: unknown, fallback: string): string { return typeof value === 'string' && ID.test(value) ? value : fallback; }
13: function absolute(value: unknown): string { return typeof value === 'string' && value.startsWith('/') ? value : ''; }
14: function endpointValue(value: unknown): URL | null { return typeof value === 'string' ? new URL(value) : null; }
15: function optionalText(value: unknown): string | undefined { return typeof value === 'string' ? value : undefined; }
16: function controllerSessionKey(value: unknown, agentId: string): string | undefined {
17:   if (value === undefined) return undefined;
18:   if (typeof value !== 'string' || value.length > 512 || !value.startsWith(`agent:${agentId}:`)) return '';
19:   return value;
20: }
21: function numberValue(value: unknown, fallback: number): number { return Number(value === undefined ? fallback : value); }
22: function encodingValue(value: unknown): OpenClawTarget['tokenizerEncoding'] {
23:   return (value === undefined ? 'o200k_base' : value) as OpenClawTarget['tokenizerEncoding'];
24: }
25: function prefixValue(value: unknown): string {
26:   if (typeof value !== 'string' || value.length === 0 || value.startsWith('/') || value.split('/').includes('..')) return '';
27:   return value.replace(/\/+$/u, '');
28: }
29: function timingValid(target: OpenClawTarget): boolean {
30:   return validInteger(target.spawnIntervalMs, 0, 60_000)
31:     && validInteger(target.pollMs, 10) && validInteger(target.maxPollMs, target.pollMs)
32:     && validInteger(target.maxPolls, 1) && validInteger(target.sessionTimeoutMs, target.pollMs, 86_400_000);
33: }
34: function resultValid(target: OpenClawTarget): boolean {
35:   return ((target.resultEndpoint === undefined) === (target.resultTokenSecret === undefined))
36:     && (target.resultTokenSecret === undefined || ID.test(target.resultTokenSecret));
37: }
38: function targetValid(target: OpenClawTarget, endpoint: URL | null): boolean {
39:   return [
40:     endpoint !== null && validHttp(endpoint), ID.test(target.tokenSecret),
41:     ['acp', 'subagent'].includes(target.runtime), Boolean(target.model), Boolean(target.cwd),
42:     Boolean(target.repositoryRoot), Boolean(target.resultPathPrefix), resultValid(target), timingValid(target),
43:     target.tokenizerEncoding === 'o200k_base',
44:     target.maxPromptBytes === 900_000, target.maxInputTokens === 120_000,
45:     target.maxOutputTokens === 6_000, target.maxContextTokens === 128_000,
46:     target.maxInputTokens + target.maxOutputTokens <= target.maxContextTokens,
47:     target.collectorMode !== true || target.runtime === 'subagent',
48:   ].every(Boolean);
49: }
50: 
51: function parseTarget(id: string, raw: unknown): OpenClawTarget {
52:   if (!ID.test(id) || !record(raw)) throw new Error(`RUNTIME_CONFIG_INVALID:target:${id}`);
53:   exact(raw, KEYS, 'RUNTIME_CONFIG_UNKNOWN_TARGET_FIELD');
54:   const endpoint = endpointValue(raw.endpoint);
55:   const target: OpenClawTarget = {
56:     endpoint: endpoint?.href ?? '', tokenSecret: text(raw.tokenSecret),
57:     runtime: raw.runtime as 'acp' | 'subagent',
58:     agentId: idValue(raw.agentId, 'codex'), agentRole: idValue(raw.agentRole, id), model: text(raw.model),
59:     thinking: text(raw.thinking, 'high'), cwd: absolute(raw.cwd), repositoryRoot: absolute(raw.repositoryRoot),
60:     ...(raw.workspaceRoot === undefined ? {} : { workspaceRoot: absolute(raw.workspaceRoot) }),
61:     pollMs: numberValue(raw.pollMs, 1_000), maxPollMs: numberValue(raw.maxPollMs, 15_000),
62:     maxPolls: numberValue(raw.maxPolls, 1_800), sessionTimeoutMs: numberValue(raw.sessionTimeoutMs, 1_800_000),
63:     resultPathPrefix: prefixValue(raw.resultPathPrefix), resultEndpoint: optionalUrl(raw.resultEndpoint),
64:     resultTokenSecret: optionalText(raw.resultTokenSecret),
65:     collectorMode: raw.collectorMode === true,
66:     spawnIntervalMs: numberValue(raw.spawnIntervalMs, 1_500),
67:     tokenizerEncoding: encodingValue(raw.tokenizerEncoding),
68:     maxPromptBytes: numberValue(raw.maxPromptBytes, 900_000), maxInputTokens: numberValue(raw.maxInputTokens, 120_000),
69:     maxOutputTokens: numberValue(raw.maxOutputTokens, 6_000), maxContextTokens: numberValue(raw.maxContextTokens, 128_000),
70:   };
71:   const sessionKey = controllerSessionKey(raw.controllerSessionKey, target.agentId);
72:   if (sessionKey === '') throw new Error(`RUNTIME_CONFIG_INVALID:controllerSessionKey:${id}`);
73:   if (sessionKey) Object.assign(target, { controllerSessionKey: sessionKey });
74:   if (!targetValid(target, endpoint)) throw new Error(`RUNTIME_CONFIG_INVALID:openclaw:${id}`);
75:   if (raw.workspaceRoot !== undefined && !target.workspaceRoot) throw new Error(`RUNTIME_CONFIG_INVALID:workspaceRoot:${id}`);
76:   return target;
77: }
