79: export function targetsFrom(raw: Readonly<Record<string, unknown>>): ReadonlyMap<string, OpenClawTarget> {
80:   exact(raw as Record<string, unknown>, new Set(['targets']), 'RUNTIME_CONFIG_UNKNOWN_FIELD');
81:   if (!record(raw.targets) || Object.keys(raw.targets).length === 0) throw new Error('RUNTIME_CONFIG_INVALID:targets');
82:   return new Map(Object.entries(raw.targets).map(([id, target]) => [id, parseTarget(id, target)]));
83: }
84: 
85: export function validTargetId(value: string): boolean { return ID.test(value); }
