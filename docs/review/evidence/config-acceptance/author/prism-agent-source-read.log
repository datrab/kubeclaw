12:   const files=['agent-process.ts','agent-attempt.ts','agent-job-runner.mjs','agent-prompt.mjs','preference-prompt.mjs'];
13:   const content=await Promise.all(files.map(async file=>({file,digest:sha256Text(await readFile(new URL(file,import.meta.url),'utf8'))})));
14:   const unsignedProfile={schemaVersion:'worker-profile.v2' as const,profileId:'prism-openclaw-launcher-v2',workerType:'prism-agent',coreContractId:'kubeclaw.pipeline-worker-core@2',
15:     engine:{engineId:'prism-openclaw-launcher',contractId:'kubeclaw.prism-agent-launcher@1',engineVersion:'2.0.0',contentDigest:sha256Digest(content)},capabilities:['openclaw.agent','artifacts.write'],resourceCapabilities:{
16:       schemaVersion:'worker-resource-capabilities.v1' as const,
17:       cpuTimeMs:unavailable('milliseconds'),maximumMemoryBytes:unavailable('bytes'),maximumProcesses:unavailable('processes'),
18:     }};
19:   const profile:WorkerProfileV2={...unsignedProfile,profileDigest:workerProfileDigest(unsignedProfile)};
20:   const expiresAt=new Date(job.expires_at).toISOString();const now=new Date().toISOString();
21:   const unsigned={schemaVersion:'worker-attempt-envelope.v2' as const,protocolVersion:'worker-protocol.v1' as const,
22:     pipelineRunId:`prism-${job.id}`,moduleId:null,gateId:null,planId:`prism-${job.id}`,nodeId:'openclaw-agent',executionId:job.id,
23:     attemptId:job.fence,attemptNumber:1,claim:{schemaVersion:'attempt-claim.v1' as const,claimId:job.fence,attemptId:job.fence,generation:1,workerId:runnerId,claimedAt:now,expiresAt},profile,packages:[],grantedCapabilities:[...profile.capabilities],
24:     limits:{timeoutMs:900_000,cleanupTimeoutMs:10_000,logBytes:1_048_576,resultBytes:1_048_576,evidenceBytes:2_097_152,evidenceFiles:2},
25:     resourceBudgets:{schemaVersion:'worker-resource-budgets.v1' as const,cpuTimeMs:{state:'unrequested' as const},maximumMemoryBytes:{state:'unrequested' as const},maximumProcesses:{state:'unrequested' as const}},
26:     inputs:[],operation:{contractId:'kubeclaw.prism-agent-launcher@1',inputSchemaId:'prism-agent-job.v1',inputSchemaDigest:sha256Digest({type:'object',required:['jobId','requestDigest','request']}),values:{jobId:job.id,requestDigest:job.request_digest,request:job.request as JsonValue}},
