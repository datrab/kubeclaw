    1 import { createHash, randomUUID } from "node:crypto";
    2 import { isIP } from "node:net";
    3 import { inTransaction, type Database, type Queryable } from "../storage/index.ts";
    4 
    5 export type SourceKind =
    6   "internal-project" | "user-upload" | "generated" | "public-web";
    7 export type CorpusInput = {
    8   sourceKind: SourceKind;
    9   locator?: string;
   10   title: string;
   11   summary: string;
   12   tags: string[];
   13   sourceFamily?: string;
   14   surface?: string;
   15   industry?: string;
   16   style?: string[];
   17   rights: "full" | "derived" | "analysis-only" | "temporary";
   18   contentBase64?: string;
   19   mediaType?: string;
   20   sourceContentDigest?: string;
   21 };
   22 export type EmbeddingEvidence = {
   23   embedding: number[];
   24   model: string;
   25   modelVersion: string;
   26   sourceDigest: string;
   27 };
   28 const hash = (value: string) =>
   29   `sha256:${createHash("sha256").update(value).digest("hex")}`;
   30 export function validateSource(input: CorpusInput): void {
   31   if(input.sourceContentDigest&&!/^sha256:[a-f0-9]{64}$/u.test(input.sourceContentDigest))throw new Error("source content digest is invalid");
   32   if (input.sourceKind === "public-web") {
   33     if (!input.locator) throw new Error("public source needs a locator");
   34     const url = new URL(input.locator);
   35     const host = url.hostname.replace(/^\[|\]$/g, "").toLowerCase();
   36     const unsafeV4 = (value: string) => {
   37       const parts = value.split(".").map(Number);
   38       return (
   39         parts[0] === 10 ||
   40         parts[0] === 127 ||
   41         parts[0] === 0 ||
   42         (parts[0] === 169 && parts[1] === 254) ||
   43         (parts[0] === 192 && parts[1] === 168) ||
   44         (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) ||
   45         parts[0] >= 224
   46       );
   47     };
   48     const unsafeV6 = (value: string) =>
   49       value === "::1" ||
   50       value === "::" ||
   51       value.startsWith("fc") ||
   52       value.startsWith("fd") ||
   53       /^fe[89ab]/.test(value) ||
   54       value.startsWith("ff") ||
   55       value.startsWith("2001:db8:");
   56     if (
   57       url.protocol !== "https:" ||
   58       host === "localhost" ||
   59       host.endsWith(".localhost") ||
   60       (isIP(host) === 4 && unsafeV4(host)) ||
   61       (isIP(host) === 6 && unsafeV6(host))
   62     )
   63       throw new Error("source network is not allowed");
   64   }
   65 }
   66 export async function ingest(
   67   db: Database,
   68   input: CorpusInput,
   69   evidence: EmbeddingEvidence,
   70   options:{activate?:boolean}={},
   71 ): Promise<{ id: string; digest: string }> {
   72   validateSource(input);
   73   if (
   74     !evidence.embedding.length ||
   75     evidence.embedding.length > 4096 ||
   76     evidence.embedding.some((value) => !Number.isFinite(value))
   77   )
   78     throw new Error("valid embedding evidence is required");
   79   const digest = hash(JSON.stringify(input));
   80   return inTransaction(db, async (connection) => {
   81     // Serialize identical inputs before lookup; all writes share this reserved transaction.
   82     await connection.query("SELECT pg_advisory_xact_lock(hashtextextended($1,0))", [`prism-corpus:${digest}`]);
   83     const prior = await connection.query<{ id: string }>(
   84       "SELECT id FROM prism.corpus_revision WHERE content_digest=$1 LIMIT 1",
   85       [digest],
   86     );
   87     if (prior.rows[0]) return { id: prior.rows[0].id, digest };
   88     return insertRevision(connection, input, evidence, digest, options.activate !== false);
   89   });
   90 }
   91 async function insertRevision(connection: Queryable, input: CorpusInput, evidence: EmbeddingEvidence, digest: string, activate: boolean): Promise<{ id: string; digest: string }> {
   92   const itemId = randomUUID(),
   93     revisionId = randomUUID(),
   94     rightsId = randomUUID();
   95   const allowDesignUse =
   96     input.rights === "full" || input.rights === "derived";
   97   await connection.query(
   98     "INSERT INTO prism.rights_policy(id,retention,retain_original,allow_derivatives,allow_embedding,allow_design_use,basis) VALUES($1,$2,$3,$4,true,$5,'explicit-ingestion-policy')",
   99     [
  100       rightsId,
  101       input.rights,
  102       false,
  103       allowDesignUse,
  104       allowDesignUse,
  105     ],
  106   );
  107   await connection.query(
  108     "INSERT INTO prism.corpus_item(id,corpus_key,kind,status) VALUES($1,$2,$3,$4)",
  109     [itemId, digest, input.sourceKind,!activate?"restricted":"active"],
  110   );
  111   await connection.query(
  112     "INSERT INTO prism.corpus_revision(id,corpus_item_id,revision,source_kind,source_locator_hash,captured_at,normalized,searchable_text,content_digest,normalization_version,rights_id,source_content_digest) VALUES($1,$2,1,$3,$4,now(),$5::jsonb,$6,$7,'v1',$8,$9)",
  113     [
  114       revisionId,
  115       itemId,
  116       input.sourceKind,
  117       input.locator ? hash(input.locator) : null,
  118       JSON.stringify({
  119         title: input.title,
  120         summary: input.summary,
  121         tags: input.tags,
  122         sourceFamily: input.sourceFamily ?? input.sourceKind,
  123         ...(input.surface ? { surface: input.surface } : {}),
  124         ...(input.industry ? { industry: input.industry } : {}),
  125         ...(input.style ? { style: input.style } : {}),
  126       }),
  127       `${input.title} ${input.summary} ${input.tags.join(" ")}`,
  128       digest,
  129       rightsId,
  130       input.sourceContentDigest??null,
  131     ],
  132   );
  133   await connection.query(
  134     "UPDATE prism.corpus_item SET current_revision_id=$1 WHERE id=$2",
  135     [revisionId, itemId],
  136   );
  137   await connection.query(
  138     "INSERT INTO prism.corpus_embedding(corpus_revision_id,model,model_version,normalization_version,source_digest,embedding) VALUES($1,$2,$3,'v1',$4,$5::vector)",
  139     [
  140       revisionId,
  141       evidence.model,
  142       evidence.modelVersion,
  143       evidence.sourceDigest,
  144       `[${evidence.embedding.join(",")}]`,
  145     ],
  146   );
  147   return { id: revisionId, digest };
  148 }
  149 
  150 export async function search(
  151   db: Queryable,
  152   query: string,
  153   limit = 10,
  154   queryEmbedding?: { embedding: number[]; model: string },
  155   options: {
  156     required?: Record<string, unknown>;
  157     preferred?: Record<string, unknown>;
  158     avoid?: Record<string, unknown>;
  159     sourceFamilyLimit?: number;
  160   } = {},
  161 ): Promise<Array<Record<string, unknown>>> {
  162   const vector = queryEmbedding?.embedding;
  163   if (
  164     vector &&
  165     (vector.length === 0 || vector.some((value) => !Number.isFinite(value)))
  166   )
  167     throw new Error("query embedding is invalid");
  168   const requiredFilter = JSON.stringify(options.required ?? {});
  169   const avoidFilter = JSON.stringify(options.avoid ?? {});
  170   const result = vector
  171     ? await db.query(
  172         "WITH eligible AS (SELECT r.*,e.embedding,e.model FROM prism.corpus_revision r JOIN prism.corpus_item i ON i.current_revision_id=r.id JOIN prism.rights_policy p ON p.id=r.rights_id JOIN prism.corpus_embedding e ON e.corpus_revision_id=r.id WHERE i.status='active' AND p.allow_design_use=true AND (p.valid_until IS NULL OR p.valid_until>now()) AND e.model=$4 AND r.normalized @> $5::jsonb AND ($6::jsonb='{}'::jsonb OR NOT r.normalized @> $6::jsonb)), text_rank AS (SELECT id,row_number() OVER(ORDER BY ts_rank(search_vector,websearch_to_tsquery('simple',$1)) DESC,id) AS rank FROM eligible WHERE search_vector @@ websearch_to_tsquery('simple',$1) LIMIT 100), vector_rank AS (SELECT id,row_number() OVER(ORDER BY embedding <=> $3::vector,id) AS rank FROM eligible LIMIT 100), fused AS (SELECT COALESCE(t.id,v.id) id,COALESCE(1.0/(60+t.rank),0)+COALESCE(1.0/(60+v.rank),0) score FROM text_rank t FULL JOIN vector_rank v USING(id)) SELECT r.id,r.normalized,r.source_kind,f.score,'hybrid-rrf-v1' AS ranking FROM fused f JOIN prism.corpus_revision r ON r.id=f.id ORDER BY f.score DESC,r.id LIMIT $2",
  173         [
  174           query,
  175           Math.max(limit * 10, 100),
  176           `[${vector.join(",")}]`,
  177           queryEmbedding!.model,
  178           requiredFilter,
  179           avoidFilter,
  180         ],
  181       )
  182     : await db.query(
  183         "SELECT r.id,r.normalized,r.source_kind,ts_rank(r.search_vector,websearch_to_tsquery('simple',$1)) AS score,'text-v1' AS ranking FROM prism.corpus_revision r JOIN prism.corpus_item i ON i.current_revision_id=r.id JOIN prism.rights_policy p ON p.id=r.rights_id WHERE i.status='active' AND p.allow_design_use=true AND (p.valid_until IS NULL OR p.valid_until>now()) AND r.normalized @> $3::jsonb AND ($4::jsonb='{}'::jsonb OR NOT r.normalized @> $4::jsonb) AND r.search_vector @@ websearch_to_tsquery('simple',$1) ORDER BY score DESC,r.id LIMIT $2",
  184         [query, Math.max(limit * 10, 100), requiredFilter, avoidFilter],
  185       );
  186   const matches = (
  187     normalized: Record<string, unknown>,
  188     filter: Record<string, unknown> | undefined,
  189   ) =>
  190     !filter ||
  191     Object.entries(filter).every(([key, expected]) => {
  192       const actual = normalized[key];
  193       return Array.isArray(expected)
  194         ? expected.every((value) =>
  195             Array.isArray(actual) ? actual.includes(value) : actual === value,
  196           )
  197         : Array.isArray(actual)
  198           ? actual.includes(expected)
  199           : actual === expected;
  200     });
  201   const familyLimit = Math.max(1, options.sourceFamilyLimit ?? 2);
  202   const families = new Map<string, number>();
  203   const selected: Array<Record<string, unknown>> = [];
  204   const eligible = result.rows
  205     .map((row, rank) => ({ row, rank }))
  206     .filter(({ row }) => {
  207       const normalized = (row.normalized ?? {}) as Record<string, unknown>;
  208       return (
  209         matches(normalized, options.required) &&
  210         !(
  211           matches(normalized, options.avoid) &&
  212           Object.keys(options.avoid ?? {}).length > 0
  213         )
  214       );
  215     })
  216     .sort((left, right) => {
  217       const leftPreferred = matches(
  218         (left.row.normalized ?? {}) as Record<string, unknown>,
  219         options.preferred,
  220       );
  221       const rightPreferred = matches(
  222         (right.row.normalized ?? {}) as Record<string, unknown>,
  223         options.preferred,
  224       );
  225       return (
  226         Number(rightPreferred) - Number(leftPreferred) || left.rank - right.rank
  227       );
  228     });
  229   for (const { row } of eligible) {
  230     const normalized = (row.normalized ?? {}) as Record<string, unknown>;
  231     const family = String(
  232       normalized.sourceFamily ?? row.source_kind ?? "unknown",
  233     );
  234     if ((families.get(family) ?? 0) >= familyLimit) continue;
  235     families.set(family, (families.get(family) ?? 0) + 1);
  236     const preferred = matches(normalized, options.preferred);
  237     selected.push({
  238       ...row,
  239       explanation: {
  240         ranking: row.ranking,
  241         requiredMatched: true,
  242         preferredMatched: preferred,
  243         sourceFamily: family,
  244         diversityCap: familyLimit,
  245       },
  246     });
  247     if (selected.length === limit) break;
  248   }
  249   return selected;
  250 }
  251 export async function expire(db: Queryable, id: string): Promise<void> {
  252   await db.query(
  253     "UPDATE prism.corpus_item SET status='expired' WHERE current_revision_id=$1",
  254     [id],
  255   );
  256 }
