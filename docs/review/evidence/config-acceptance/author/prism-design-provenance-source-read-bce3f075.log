SOURCE skills/prism/openclaw-plugin/index.test.mjs sha256:0c5f68f6ca9cbbbdec820d619392a3b489a1302dedd309cf0eff67e566923114
    1 import assert from "node:assert/strict";
    2 import test from "node:test";
    3 import register from "./index.mjs";
    4 
    5 test("Prism OpenClaw plugin enforces one exact three-design commit tool", () => {
    6   const tools = [];
    7   register({ registerTool(tool) { tools.push(tool); } });
    8   assert.deepEqual(tools.map((tool) => tool.name), [
    9     "prism_create_design_set",
   10     "prism_apply_revision",
   11   ]);
   12   const designs = tools[0].parameters.properties.designs;
   13   assert.equal(designs.minItems, 3);
   14   assert.equal(designs.maxItems, 3);
   15   assert.deepEqual(designs.items.required, ["key", "title", "summary", "document"]);
   16 });

SOURCE skills/prism/tests/directions.test.mts sha256:29f1b9e783bea0b0a3cee331c021dfe039e9a9262461d27e4513feedf1bde7d6
    1 import assert from "node:assert/strict";
    2 import test from "node:test";
    3 import fixture from "../../../contracts/prism/v1/fixtures/minimal-web.json" with {type:"json"};
    4 import { assertMaterialDirectionDiversity, directionSignature, materialDirectionDistance } from "../directions/index.ts";
    5 
    6 test("direction diversity ignores copy-only changes",()=>{
    7   const copy=structuredClone(fixture);copy.views.home.root.children[0].props.content="Different copy";
    8   assert.equal(directionSignature(fixture as any),directionSignature(copy as any));
    9   assert.throws(()=>assertMaterialDirectionDiversity([fixture as any,copy as any]),/materially distinct/);
   10 });
   11 test("direction diversity rejects one cosmetic token change",()=>{
   12   const visual=structuredClone(fixture);visual.theme.colors.action="#0066ff";
   13   assert.equal(materialDirectionDistance(fixture as any,visual as any),1);
   14   assert.throws(()=>assertMaterialDirectionDiversity([fixture as any,visual as any]),/materially distinct/);
   15 });
   16 test("direction diversity accepts a material visual system change",()=>{
   17   const visual=structuredClone(fixture);visual.theme.colors.action="#0066ff";visual.theme.colors.background="#101820";visual.theme.space.medium=20;
   18   assert.notEqual(directionSignature(fixture as any),directionSignature(visual as any));
   19   assert.doesNotThrow(()=>assertMaterialDirectionDiversity([fixture as any,visual as any]));
   20 });
   21 test("direction diversity ignores object key order",()=>{
   22   const reordered=structuredClone(fixture);
   23   reordered.theme.colors=Object.fromEntries(Object.entries(reordered.theme.colors).reverse()) as typeof reordered.theme.colors;
   24   reordered.theme.typography=Object.fromEntries(Object.entries(reordered.theme.typography).reverse()) as typeof reordered.theme.typography;
   25   assert.equal(directionSignature(fixture as any),directionSignature(reordered as any));
   26 });

