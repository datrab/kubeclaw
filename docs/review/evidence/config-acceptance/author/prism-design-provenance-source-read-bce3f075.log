  249   };
  250   const retractPreference = async (eventId: string) => {
  251     if (!document || !userId) return;
  252     const event = {
  253       schema: "prism.preference-event.v1",
  254       eventId: `event-${crypto.randomUUID()}`,
  255       userId,
  256       projectId: document.meta.projectId,
  257       action: "retracted",
  258       target: { eventId },
  259       traits: [],
  260       context: { surface: "studio" },
  261       source: "explicit",
  262       learningScope: "project",
  263       retractsEventId: eventId,
  264       occurredAt: new Date().toISOString(),
  265     };
  266     const response = await fetch("/v1/preferences", {
  267       method: "POST",
  268       headers: { "content-type": "application/json", "x-prism-csrf": csrf },
  269       body: JSON.stringify(event),
  270     });
  271     if (!response.ok) {
  272       const value = (await response.json()) as { error?: string };
  273       throw new Error(value.error ?? "Preference retraction failed");
  274     }
  275     await loadLearned();
  276   };
  277   const pendingDirectionKeys = useRef(new Map<string, string>());
  278   const directionRequest = (route: string, payload: object) => {
  279     const body = JSON.stringify(payload);
  280     const identity = JSON.stringify([route, body]);
  281     const key = pendingDirectionKeys.current.get(identity) ?? crypto.randomUUID();
  282     pendingDirectionKeys.current.set(identity, key);
  283     return { identity, options: { method: "POST", headers: { "content-type": "application/json", "x-prism-csrf": csrf, "Idempotency-Key": key }, body } };
  284   };
  285   const selectDirection = async (directionId: string) => {
  286     const documentId = new URLSearchParams(location.search).get("document");
  287     if (!documentId) throw new Error("Document ID is missing");
  288     const route = `/v1/directions/${encodeURIComponent(directionId)}/select`;
  289     const mutation = directionRequest(route, {documentId});
  290     const response = await fetch(route, mutation.options);
  291     const result = (await response.json()) as {
  292       document?: PrismDocument;
  293       documentId?: string;
  294       error?: string;
  295     };
  296     if (!response.ok || !result.document)
  297       throw new Error(result.error ?? "Direction selection failed");
  298     pendingDirectionKeys.current.delete(mutation.identity);
  299     setDocument(result.document);
  300     if(result.documentId){
  301       const query=new URLSearchParams(location.search);query.set("document",result.documentId);
  302       history.replaceState(null,"",`?${query.toString()}`);
  303     }
  304     setQuality(null);
  305     setAcceptedWarnings([]);
  306     setDirections((items) =>
  307       items.map((item) => ({
  308         ...item,
  309         state: item.id === directionId ? "selected" : "rejected",
  310       })),
  311     );
  312   };
  313   const recordDirectionFeedback = async (
  314     directionId: string,
  315     action: "rejected" | "liked" | "disliked" | "preserved",
  316   ) => {
  317     const route = `/v1/directions/${encodeURIComponent(directionId)}/feedback`;
  318     const mutation = directionRequest(route, {action});
  319     const response = await fetch(route, mutation.options);
  320     const result = (await response.json()) as { error?: string; eventId?: string; state?: string };
  321     if (!response.ok || !result.eventId || result.state !== (action === "rejected" ? "rejected" : "recorded"))
  322       throw new Error(result.error ?? "Direction feedback failed");
  323     pendingDirectionKeys.current.delete(mutation.identity);
  324     if (action === "rejected")
  325       setDirections((items) =>
  326         items.map((item) =>
  327           item.id === directionId ? { ...item, state: "rejected" } : item,
  328         ),
  329       );
  330     await loadLearned();
  331   };
  332   const requestNewRound = async () => {
  333     const query=new URLSearchParams(location.search);
  334     const projectId=query.get("project");const documentId=query.get("document");
  335     if (!projectId || !documentId || !document) throw new Error("Current design identity is missing");
  336     const client:RoundClient={projectId,userId,csrf,origin:location.origin,storage:sessionStorage};
  337     const pending=pendingRound(client,{documentId,expectedRevision:document.meta.revision,parentRoundId:directions[0]?.generation_id});
  338     setRoundPending(true);setRoundBusy(true);setRoundMessage("Requesting the design round…");
  339     try {
  340       const accepted=await submitRound(client,pending);
  341       setRoundMessage("Design round pending. Checking for the three proposals…");
  342       const ready=await waitForRound(client,accepted);
  343       if(!ready){setRoundMessage("Still pending. Retry the same round to reconnect without creating another request.");return;}
  344       setDirections(ready.directions);setDocument(ready.document);setQuality(null);setAcceptedWarnings([]);setApprovalMessage("");setRoundPending(false);setRoundMessage("New design round ready.");
  345       query.set("document",ready.documentId);history.replaceState(null,"",`?${query.toString()}`);
  346     } catch(error) {
  347       setRoundMessage(`Round pending or conflicted: ${error instanceof Error ? error.message : String(error)} The request key is retained; retry does not create a new round.`);
  348     } finally {setRoundBusy(false);}
  349   };
  350   const approve = async () => {
  351     if (!document) return;
  352     const query = new URLSearchParams(location.search);
  353     const projectId = query.get("project");
  354     const documentId = query.get("document");
  355     if (!projectId || !documentId)
  356       throw new Error("Project identity is missing");
  357     const report = quality ?? (await evaluateDesign());
  358     if (report.status === "blocked")
  359       throw new Error("Resolve all blocking design findings before approval");
  360     const warnings = report.findings
  361       .filter((finding) => finding.level === "review")
  362       .map((finding) => finding.id);
  363     if (warnings.some((id) => !acceptedWarnings.includes(id)))
  364       throw new Error("Review and accept each design warning before approval");
  365     const bytes = new TextEncoder().encode(JSON.stringify(document));
  366     const hash = Array.from(
  367       new Uint8Array(await crypto.subtle.digest("SHA-256", bytes)),
  368     )
  369       .map((value) => value.toString(16).padStart(2, "0"))
  370       .join("");
  371     const approval = await fetch("/v1/approvals", {
  372       method: "POST",
  373       headers: { "content-type": "application/json", "x-prism-csrf": csrf },
  374       body: JSON.stringify({
  375         projectId,
  376         documentId,
  377         designDigest: `sha256:${hash}`,
  378         acceptedWarningIds: acceptedWarnings,
  379       }),
  380     });
  381     const approvalBody = (await approval.json()) as {
  382       id?: string;
  383       error?: string;
  384     };
  385     if (!approval.ok || !approvalBody.id)
  386       throw new Error(approvalBody.error ?? "Approval failed");
  387     const baseline = await fetch("/v1/baselines", {
  388       method: "POST",
  389       headers: { "content-type": "application/json", "x-prism-csrf": csrf },
  390       body: JSON.stringify({
  391         projectId,
  392         documentId,
  393         approvalId: approvalBody.id,
  394       }),
  395     });
  396     const baselineBody = (await baseline.json()) as {
  397       bundleDigest?: string;
  398       error?: string;
  399     };
  400     if (!baseline.ok || !baselineBody.bundleDigest)
  401       throw new Error(baselineBody.error ?? "Baseline publication failed");
  402     setApprovalMessage(
  403       `Published ${baselineBody.bundleDigest}. Approval ID: ${approvalBody.id}`,
  404     );
  405   };
  406   const evaluateDesign = async () => {
  407     if (!document) throw new Error("Design is not loaded");
  408     const documentId = new URLSearchParams(location.search).get("document");
  409     if (!documentId) throw new Error("Document ID is missing");
  410     const response = await fetch(
  411       `/v1/documents/${encodeURIComponent(documentId)}/engine`,
  412       {
  413         method: "POST",
  414         headers: { "content-type": "application/json", "x-prism-csrf": csrf },
  415         body: JSON.stringify({
  416           operation: "evaluate",
  417           baseRevision: document.meta.revision,
  418           idempotencyKey: `studio-evaluate-${document.meta.documentId}-${document.meta.revision}`,
  419           input: {},
  420         }),
  421       },
  422     );
  423     const body = (await response.json()) as {
  424       specialistResult?: {
  425         values?: {
  426           status: string;
  427           findings: Array<{
  428             id: string;
  429             level: string;
  430             message: string;
  431             target?: string;
  432           }>;
  433         };
  434       };
  435       error?: string;
  436     };
  437     if (!response.ok || !body.specialistResult?.values)
  438       throw new Error(body.error ?? "Design evaluation failed");
  439     setQuality(body.specialistResult.values);
  440     setAcceptedWarnings([]);
  441     return body.specialistResult.values;
  442   };
  443   const updateTitle = () => {
  444     if (!document) return;
  445     const current = document;
  446     const title = selectedNode;
  447     if (!title) return;
  448     void commit({
  449       type: "node.props.set",
  450       baseRevision: current.meta.revision,
  451       nodeId: title.id,
  452       props: {
  453         ...(title.type==="button"
  454           ? {label:String(title.props?.label??"Action")==="Action"?"Continue":"Action"}
  455           : {content:String(title.props?.content??"")==="Services"?"Deployments":"Services"}),
  456       },
  457     }).catch((error) => setFailure(String(error)));
  458   };
  459   const insert = () => {
  460     if (!document) return;
  461     const current = document;
  462     void commit({
  463       type: "node.insert",
  464       baseRevision: current.meta.revision,
  465       parentId: current.views[viewId]?.root.id ?? `${viewId}-root`,
  466       index: current.views[viewId]?.root.children?.length ?? 0,
  467       node: {
  468         id: `action-${current.meta.revision}`,
  469         type: "button",
  470         props: {
  471           label: "Inspect",
  472           variant: "primary",
  473           action: "preview-action",
  474         },
  475       },
  476     }).catch((error) => setFailure(String(error)));
  477   };
  478   const move = () => {
  479     if (!document) return;
  480     const current = document;
  481     const last = current.views[viewId]?.root.children?.at(-1);
  482     if (!last) return;
  483     void commit({
  484       type: "node.move",
  485       baseRevision: current.meta.revision,
  486       nodeId: last.id,
  487       parentId: current.views[viewId]?.root.id ?? `${viewId}-root`,
  488       index: 0,
  489     }).catch((error) => setFailure(String(error)));
  490   };
  491   if (failure)
  492     return (
  493       <main className="studio">
  494         <section className="start-panel">
  495           <h1>Prism cannot open</h1>
  496           <p>{failure}</p>
  497         </section>
  498       </main>
  499     );
  500   if (!document)
  501     return (
  502       <main className="studio">
  503         <section className="start-panel">
  504           <h1>Prism Studio</h1>
  505           {projects.length === 0 ? (
  506             <>
  507               <p>No design requests yet.</p>
  508               <p>Projects appear here after Nova sends an architecture to Prism.</p>
  509             </>
  510           ) : (
  511             <section aria-label="Prism projects">
  512               <h2>Projects from Nova</h2>
  513               {projects.map((project) => (
  514                 <article key={project.id}>
  515                   <strong>{project.name}</strong>
  516                   {project.document_id ? (
  517                     <>
  518                       <p>{project.direction_count} design directions</p>
  519                       <a href={`?project=${encodeURIComponent(project.id)}&document=${encodeURIComponent(project.document_id)}`}>Open designs</a>
  520                     </>
  521                   ) : (
  522                     <p>Design generation pending.</p>
  523                   )}
  524                 </article>
  525               ))}
  526             </section>
  527           )}
  528           <button onClick={() => location.reload()}>Refresh</button>
  529         </section>
  530       </main>
  531     );
  532   return (
  533     <main className="studio">
  534       <header>
  535         <div className="brand">
  536           <span className="mark">P</span>
  537           <strong>Prism</strong>
  538           <span className="quiet">{document.meta.title}</span>
  539         </div>
  540         <div className="top-actions">
  541           <span data-testid="revision">Revision {document.meta.revision}</span>
  542           <select
  543             aria-label="Viewport"
  544             value={viewport}
  545             onChange={(event) => setViewport(event.target.value as Viewport)}
  546           >
  547             <option value="compact">Compact</option>
  548             <option value="regular">Regular</option>
  549             <option value="wide">Wide</option>
  550           </select>
  551           <button onClick={() => setMode(mode === "edit" ? "preview" : "edit")}>
  552             {mode === "edit" ? "Preview" : "Edit"}
  553           </button>
  554           <button
  555             onClick={() =>
  556               void evaluateDesign().catch((error) => setFailure(String(error)))
  557             }
  558           >
  559             Check design
  560           </button>
  561           <button
  562             className="approve"
  563             onClick={() =>
  564               void approve().catch((error) => setFailure(String(error)))
  565             }
  566           >
  567             Approve
  568           </button>
  569         </div>
  570       </header>
  571       {approvalMessage && (
  572         <p role="status" className="approval-status">
  573           {approvalMessage}
  574         </p>
  575       )}
  576       {brief&&<section aria-label="Design brief" className="brief"><h2>Brief</h2><p>Prism imported the approved Nova architecture and uses it as the design boundary.</p><dl>{Object.entries((brief.architectureContent&&typeof brief.architectureContent==="object"?brief.architectureContent:brief) as Record<string,unknown>).slice(0,12).map(([key,value])=><React.Fragment key={key}><dt>{key}</dt><dd>{typeof value==="string"?value:JSON.stringify(value)}</dd></React.Fragment>)}</dl></section>}
  577       {quality && (
  578         <section aria-label="Design quality">
  579           <h2>Design quality: {quality.status}</h2>
  580           {quality.findings.length === 0 ? (
  581             <p>No findings.</p>
  582           ) : (
  583             quality.findings.map((finding) => (
  584               <label key={finding.id}>
  585                 <input
  586                   type="checkbox"
  587                   disabled={finding.level !== "review"}
  588                   checked={
