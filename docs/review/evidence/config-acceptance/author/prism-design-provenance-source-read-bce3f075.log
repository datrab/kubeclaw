  633                 <button onClick={()=>void recordDirectionFeedback(direction.id,"disliked").catch((error)=>setFailure(String(error)))}>Less like this</button>
  634                 <button onClick={()=>void recordDirectionFeedback(direction.id,"preserved").catch((error)=>setFailure(String(error)))}>Keep this detail</button>
