  163           livenessProbe: { httpGet: { path: /health, port: {{ ternary (int $swarm.operator.prism.control.port) (ternary (int $swarm.operator.prism.studio.port) (int $swarm.operator.prism.worker.port) (eq $name "studio")) (eq $name "control") }} }, initialDelaySeconds: 10 }
  164         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
