  594                       event.target.checked
  595                         ? [...current, finding.id]
  596                         : current.filter((id) => id !== finding.id),
  597                     )
  598                   }
  599                 />
  600                 <strong>{finding.level}</strong> {finding.message}
  601                 {finding.target ? ` (${finding.target})` : ""}
  602               </label>
  603             ))
  604           )}
  605         </section>
  606       )}
  607       <aside className="navigator">
  608         <p className="eyebrow">Experience</p>
  609         {roundMessage && <p role="status">{roundMessage}</p>}
  610         {(roundPending || (directions.length===3 && directions.every(direction=>direction.state==="rejected"))) && <button disabled={roundBusy} onClick={()=>void requestNewRound().catch(error=>setRoundMessage(String(error)))}>{roundBusy ? "Waiting for new round…" : roundPending ? "Retry the same design round" : "Request new design round"}</button>}
  611         {directions.length > 0 && (
