   42     profile: prismNativeWorkerProfile, packages: [], grantedCapabilities: prismNativeWorkerProfile.capabilities,
   43     limits: { timeoutMs: 300_000, cleanupTimeoutMs: 10_000, logBytes: 1_048_576, resultBytes: 16_777_216, evidenceBytes: 134_217_728, evidenceFiles: 64 },
   44     resourceBudgets: { schemaVersion: 'worker-resource-budgets.v2' as const,
   45       cpuTimeMs: { state: 'requested' as const, limit: policy.cpuTimeMs },
   46       maximumMemoryBytes: { state: 'requested' as const, limit: policy.memoryBytes },
   47       maximumTasks: { state: 'requested' as const, limit: policy.tasks },
   48     },
   49     inputs: [{name:"prism-input",kind:"artifact" as const,artifact:inputArtifact}], operation: { contractId: "kubeclaw.prism-design-engine@1", inputSchemaId: request.schemaId, inputSchemaDigest: request.schemaDigest, values: { operation, inputName:"prism-input" } },
   50     cancellationId: `cancel-${randomUUID()}`, issuedAt: now.toISOString(), queueDeadline: expires.toISOString(),
   51   };
   52   return { ...unsigned, attemptSpecDigest: workerAttemptSpecDigest(unsigned) };
   53 }
