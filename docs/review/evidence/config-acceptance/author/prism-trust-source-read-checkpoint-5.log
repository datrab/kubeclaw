SOURCE skills/prism/server/control-server.ts sha256:079984af0571f48c51e191f099174c88922af6b6cfb392d56cce945b4688f5c3
    1 import {
    2   createServer,
    3   type IncomingMessage,
    4   type ServerResponse,
    5 } from "node:http";
    6 import { Console } from "node:console";
    7 import type { Database } from "../storage/index.ts";
    8 import { agentRoutes } from "./agent-routes.ts";
    9 import { approvalRoute } from "./approval-route.ts";
   10 import { artifactRoute } from "./artifact-route.ts";
   11 import { baselineRoute } from "./baseline-route.ts";
   12 import { loadControlCompositionConfig } from "./control-config.ts";
   13 import {
   14   authenticated,
   15   createControlContext,
   16   type ControlContext,
   17 } from "./control-context.ts";
   18 import { json } from "./control-http.ts";
   19 import { corpusRoutes } from "./corpus-routes.ts";
   20 import { directionRoutes } from "./direction-routes.ts";
   21 import { dispatchRoute } from "./dispatch-route.ts";
   22 import { documentHistoryRoutes, documentRoutes } from "./document-routes.ts";
   23 import { engineRoute } from "./engine-route.ts";
   24 import { handleInternalArtifact } from "./internal-artifacts.ts";
   25 import { preferenceRoutes } from "./preference-routes.ts";
   26 import { productAuthorityHandler } from "./product-decisions.ts";
   27 import { projectRoutes } from "./project-routes.ts";
   28 import { sessionRoutes } from "./session-routes.ts";
   29 // Match the original Console(ignoreErrors:true) policy. The closed-descriptor
   30 // regression verifies preserved responses and availability for that failure.
   31 const diagnostics = new Console({
   32   stdout: process.stdout,
   33   stderr: process.stderr,
   34   ignoreErrors: true,
   35 });
   36 
   37 async function handle(
   38   context: ControlContext,
   39   request: IncomingMessage,
   40   response: ServerResponse,
   41 ) {
   42   try {
   43     const url = new URL(request.url ?? "/", "http://prism-control");
   44     if (await handlePublic(context, request, response, url)) return;
   45     return await handleApplication(context, request, response, url);
   46   } catch (error) {
   47     diagnostics.error("[prism-control] request failed", {
   48       method: request.method,
   49       path: request.url,
   50       error: error instanceof Error ? error.message : "request failed",
   51     });
   52     return json(response, error instanceof SyntaxError ? 400 : 422, {
   53       error: error instanceof Error ? error.message : "request failed",
   54     });
   55   }
   56 }
   57 /** Compose the original HTTP service; the caller owns database/listener lifetime. */
   58 export async function createControlServer(
   59   pool: Database,
   60   environment?: NodeJS.ProcessEnv,
   61 ) {
   62   return createConfiguredControlServer(
   63     pool,
   64     await loadControlCompositionConfig(environment),
   65   );
   66 }
   67 
   68 /** Build the HTTP service from the already captured production composition. */
   69 export function createConfiguredControlServer(
   70   pool: Database,
   71   composition: Awaited<ReturnType<typeof loadControlCompositionConfig>>,
   72 ) {
   73   const { service: config, product: productConfig } = composition;
   74   const context = createControlContext(pool, config);
   75   return createServer(
   76     productAuthorityHandler(
   77       (request, response) => handle(context, request, response),
   78       { db: pool, config: productConfig, sessionSecret: config.sessionSecret },
   79     ),
   80   );
   81 }
   82 
   83 async function handlePublic(
   84   context: ControlContext,
   85   request: IncomingMessage,
   86   response: ServerResponse,
   87   url: URL,
   88 ): Promise<boolean> {
   89   if (url.pathname === "/health") {
   90     json(response, 200, { status: "ok" });
   91     return true;
   92   }
   93   if (url.pathname === "/ready") {
   94     await context.pool.query("SELECT 1");
   95     json(response, 200, { status: "ready" });
   96     return true;
   97   }
   98   const {
   99     spiffeEnabled,
  100     workerSecret,
  101     trustedWorkerSpiffeId,
  102     trustedControlSpiffeId,
  103     trustedPrismAgentSpiffeId,
  104   } = context.config;
  105   if (
  106     await handleInternalArtifact(request, response, url, {
  107       artifacts: context.artifacts,
  108       spiffeEnabled,
  109       workerSecret,
  110       trustedWorkerSpiffeId,
  111       trustedControlSpiffeId,
  112       trustedPrismAgentSpiffeId,
  113     })
  114   )
  115     return true;
  116   if (await sessionRoutes(context, request, response, url)) return true;
  117   if (await dispatchRoute(context, request, response, url)) return true;
  118   if (await agentRoutes(context, request, response, url)) return true;
  119   return false;
  120 }
  121 async function handleApplication(
  122   context: ControlContext,
  123   request: IncomingMessage,
  124   response: ServerResponse,
  125   url: URL,
  126 ) {
  127   const actor = authenticated(context, request);
  128   const application = { ...context, actor };
  129   if (await projectRoutes(application, request, response, url)) return;
  130   if (await documentRoutes(application, request, response, url)) return;
  131   if (await directionRoutes(application, request, response, url)) return;
  132   if (await documentHistoryRoutes(application, request, response, url)) return;
  133   if (await engineRoute(application, request, response, url)) return;
  134   if (await approvalRoute(application, request, response, url)) return;
  135   if (await baselineRoute(application, request, response, url)) return;
  136   if (await corpusRoutes(application, request, response, url)) return;
  137   if (await preferenceRoutes(application, request, response, url)) return;
  138   if (await artifactRoute(application, request, response, url)) return;
  139   return json(response, 404, { error: "not found" });
  140 }

SOURCE skills/prism/server/control-context.ts sha256:2444e6f0f22860aea6f109c984be4747a13421da2d33dd738ef7c29b71f04d02
    1 import type { IncomingMessage } from "node:http";
    2 import { runNativePrismOperation } from "../control/native-operation.ts";
    3 import { verifySession } from "../control/session.ts";
    4 import {
    5   ContentAddressedArtifactStore,
    6   RevisionRepository,
    7   type Database,
    8 } from "../storage/index.ts";
    9 import type { loadControlServerConfig } from "./control-config.ts";
   10 import { cookies } from "./control-http.ts";
   11 export function createControlContext(
   12   pool: Database,
   13   config: ReturnType<typeof loadControlServerConfig>,
   14 ) {
   15   const repository = new RevisionRepository(pool),
   16     artifacts = new ContentAddressedArtifactStore(config.artifactRoot);
   17   return Object.freeze({
   18     pool,
   19     repository,
   20     artifacts,
   21     config,
   22     runWorker: (
   23       operation: "generate" | "render" | "evaluate" | "ingest" | "publish",
   24       input: Record<string, unknown>,
   25       idempotencyKey: string,
   26     ) =>
   27       runNativePrismOperation(
   28         pool,
   29         artifacts,
   30         config,
   31         operation,
   32         input,
   33         idempotencyKey,
   34       ),
   35   });
   36 }
   37 export type ControlContext = ReturnType<typeof createControlContext>;
   38 export function authenticated(
   39   context: ControlContext,
   40   request: IncomingMessage,
   41 ) {
   42   const { sessionSecret } = context.config;
   43   const values = cookies(request);
   44   const session = verifySession(values.prism_session ?? "", sessionSecret);
   45   const csrf = values.prism_csrf ?? "";
   46   if (
   47     !["GET", "HEAD"].includes(request.method ?? "") &&
   48     (!csrf || request.headers["x-prism-csrf"] !== csrf)
   49   )
   50     throw new Error("invalid CSRF token");
   51   return { user: session.user, roles: session.roles, csrf };
   52 }
   53 export type AuthenticatedControlContext = ControlContext & {
   54   readonly actor: ReturnType<typeof authenticated>;
   55 };

SOURCE skills/prism/server/dispatch-route.ts sha256:407b0befbe8cbf6009f2cef6fe80ab10a2213258d4be5bddc578f24abdb47382
    1 import { validatePrism } from "@kubeclaw/prism-contracts-v1";
    2 import { authorizeProxiedSpiffePeer } from "@kubeclaw/worker-core";
    3 import { createHmac, randomUUID, timingSafeEqual } from "node:crypto";
    4 import { type IncomingMessage, type ServerResponse } from "node:http";
    5 import { admitDesignAgent } from "../control/agent-admission.ts";
    6 import {
    7   approvedRoundBaseline,
    8   assertArchitectureTransition,
    9   startDesignRound,
   10 } from "../control/design-generations.ts";
   11 import { authorizePipelinePreferenceSubject } from "../control/pipeline-preference-subject.ts";
   12 import { inTransaction } from "../storage/index.ts";
   13 
   14 import type { ControlContext } from "./control-context.ts";
   15 import { json } from "./control-http.ts";
   16 type RouteContext = Pick<ControlContext, "config" | "pool" | "artifacts">;
   17 
   18 export async function dispatchRoute(
   19   context: RouteContext,
   20   request: IncomingMessage,
   21   response: ServerResponse,
   22   url: URL,
   23 ): Promise<boolean> {
   24   if (url.pathname === "/v1/dispatch" && request.method === "POST") {
   25     await dispatchDesign(context, request, response);
   26     return true;
   27   }
   28   return false;
   29 }
   30 async function dispatchDesign(
   31   context: RouteContext,
   32   request: IncomingMessage,
   33   response: ServerResponse,
   34 ) {
   35   const controlConfig = context.config;
   36   const { pool, artifacts } = context;
   37   const { trustedControlSpiffeId } = context.config;
   38 
   39   const { raw, key } = await authenticateDispatch(context.config, request);
   40   const payload = JSON.parse(raw.toString("utf8")) as DispatchPayload;
   41   const preferenceSubjectId = authorizePipelinePreferenceSubject(
   42     payload.preferenceSubjectId,
   43     controlConfig.pipelinePreferenceSubject,
   44   );
   45   const designRequest = validatePrism<DesignRequest>(
   46     "designRequest",
   47     payload.request,
   48   );
   49   const projectKey = designRequest.projectId;
   50   const project = await persistDesignRequest(pool, designRequest);
   51   if (!designRequest.approvalId) {
   52     const preferences = await startDesignRound(pool, {
   53       projectId: projectKey,
   54       subjectId: preferenceSubjectId,
   55       startKey: `dispatch:${key}`,
   56       architectureDigest: designRequest.architecture.contentDigest,
   57       architectureRevision: designRequest.architecture.revision,
   58     });
   59     const agent = await admitDesignAgent(
   60       pool,
   61       `${trustedControlSpiffeId}/prism/main/v2`,
   62       projectKey,
   63       preferences,
   64     );
   65     return json(response, 202, {
   66       result: { status: "waiting", projectId: project.rows[0]!.id },
   67       preferences,
   68       agent,
   69     });
   70   }
   71   const baseline = await approvedRoundBaseline(
   72     pool,
   73     project.rows[0]!.id,
   74     designRequest.approvalId,
   75   );
   76   if (!baseline.rows[0]) throw new Error("approved Prism baseline not found");
   77   return json(response, 200, {
   78     result: {
   79       bundleDigest: baseline.rows[0].bundle_digest,
   80       artifactId: baseline.rows[0].bundle_artifact_id,
   81       archiveBase64: Buffer.from(
   82         await artifacts.get(baseline.rows[0].bundle_artifact_id),
   83       ).toString("base64"),
   84     },
   85   });
   86 }
   87 
   88 async function authenticateDispatch(
   89   config: ControlContext["config"],
   90   request: IncomingMessage,
   91 ) {
   92   const {
   93     spiffeEnabled,
   94     dispatchSecret,
   95     trustedNovaSpiffeId,
   96     trustedPrismAgentSpiffeId,
   97     trustedTestRunnerSpiffeId,
   98   } = config;
   99   if (spiffeEnabled) {
  100     try {
  101       authorizeProxiedSpiffePeer(
  102         request.headers,
  103         request.socket.remoteAddress,
  104         new Set(
  105           [
  106             trustedNovaSpiffeId,
  107             trustedPrismAgentSpiffeId,
  108             trustedTestRunnerSpiffeId,
  109           ].filter(Boolean),
  110         ),
  111       );
  112     } catch {
  113       throw new Error("invalid dispatch identity");
  114     }
  115   }
  116   if (
  117     !(request.headers["content-type"] ?? "")
  118       .toString()
  119       .toLowerCase()
  120       .startsWith("application/json")
  121   )
  122     throw new Error("application/json is required");
  123   const chunks: Buffer[] = [];
  124   let size = 0;
  125   for await (const chunk of request) {
  126     size += chunk.length;
  127     if (size > 2_000_000) throw new Error("request too large");
  128     chunks.push(chunk);
  129   }
  130   const raw = Buffer.concat(chunks);
  131   const key = String(request.headers["idempotency-key"] ?? "");
  132   if (!key) throw new Error("invalid dispatch idempotency key");
  133   if (!spiffeEnabled) {
  134     const supplied = String(
  135       request.headers["x-kubeclaw-signature"] ?? "",
  136     ).replace(/^v1=/, "");
  137     const expected = createHmac("sha256", dispatchSecret)
  138       .update(`${key}.${raw.toString("utf8")}`)
  139       .digest();
  140     const actual = Buffer.from(supplied, "hex");
  141     if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
  142       throw new Error("invalid dispatch signature");
  143   }
  144   return { raw, key };
  145 }
  146 
  147 type DesignRequest = {
  148   schema: "prism.design-request.v1";
  149   projectId: string;
  150   architecture: { artifactId: string; contentDigest: string; revision: number };
  151   architectureContent: Record<string, unknown>;
  152   approvalId?: string;
  153 };
  154 async function persistDesignRequest(
  155   pool: ControlContext["pool"],
  156   designRequest: DesignRequest,
  157 ) {
  158   const projectKey = designRequest.projectId;
  159   const project = await pool.query<{ id: string }>(
  160     "INSERT INTO prism.project(id,external_id,name) VALUES($1,$2,$3) ON CONFLICT(external_id) DO UPDATE SET updated_at=now() RETURNING id",
  161     [randomUUID(), projectKey, projectKey],
  162   );
  163   await inTransaction(pool, async (requestClient) => {
  164     await requestClient.query(
  165       "SELECT id FROM prism.project WHERE id=$1 FOR UPDATE",
  166       [project.rows[0]!.id],
  167     );
  168     const active = await requestClient.query<{
  169       architecture_digest: string;
  170       architecture_revision: number | string;
  171       request: Record<string, unknown>;
  172     }>(
  173       "SELECT architecture_digest,architecture_revision,request FROM prism.design_request WHERE project_id=$1 AND status='active' ORDER BY architecture_revision DESC LIMIT 1",
  174       [project.rows[0]!.id],
  175     );
  176     if (active.rows[0])
  177       assertArchitectureTransition(active.rows[0], designRequest);
  178     await requestClient.query(
  179       "UPDATE prism.design_request SET status='superseded' WHERE project_id=$1 AND architecture_revision<$2 AND status='active'",
  180       [project.rows[0]!.id, designRequest.architecture.revision],
  181     );
  182     await requestClient.query(
  183       "INSERT INTO prism.design_request(id,project_id,architecture_artifact_id,architecture_digest,architecture_revision,request,status) VALUES($1,$2,$3,$4,$5,$6::jsonb,'active') ON CONFLICT(project_id,architecture_revision) DO UPDATE SET architecture_artifact_id=excluded.architecture_artifact_id,architecture_digest=excluded.architecture_digest,request=excluded.request,status='active'",
  184       [
  185         randomUUID(),
  186         project.rows[0]!.id,
  187         designRequest.architecture.artifactId,
  188         designRequest.architecture.contentDigest,
  189         designRequest.architecture.revision,
  190         JSON.stringify(designRequest),
  191       ],
  192     );
  193   });
  194   return project;
  195 }
  196 
  197 interface DispatchPayload {
  198   preferenceSubjectId?: string;
  199   request?: {
  200     projectId?: string;
  201     approvalId?: string;
  202     schema?: string;
  203     architecture?: { artifactId?: string; contentDigest?: string };
  204     architectureContent?: unknown;
  205   };
  206 }

SOURCE skills/prism/server/internal-artifacts.ts sha256:16750a5eecea51781dc67e271cfc331550f1a0a03460917133226cd9c975dab8
    1 import type { IncomingMessage, ServerResponse } from 'node:http';
    2 import { createHash, timingSafeEqual } from 'node:crypto';
    3 import { authorizeProxiedSpiffePeer } from '@kubeclaw/worker-core';
    4 import type { ContentAddressedArtifactStore } from '../storage/artifacts.ts';
    5 
    6 export interface InternalArtifactOptions {
    7   readonly artifacts: ContentAddressedArtifactStore;
    8   readonly spiffeEnabled: boolean;
    9   readonly workerSecret: string;
   10   readonly trustedWorkerSpiffeId: string;
   11   readonly trustedControlSpiffeId: string;
   12   readonly trustedPrismAgentSpiffeId?: string;
   13 }
   14 function json(response: ServerResponse, status: number, value: unknown): void {
   15   response.writeHead(status, { 'content-type': 'application/json' }); response.end(JSON.stringify(value));
   16 }
   17 function authorized(request: IncomingMessage, options: InternalArtifactOptions): boolean {
   18   if (options.spiffeEnabled) {
   19     try {
   20       authorizeProxiedSpiffePeer(request.headers, request.socket.remoteAddress,
   21         new Set([options.trustedWorkerSpiffeId, options.trustedControlSpiffeId,...(options.trustedPrismAgentSpiffeId?[options.trustedPrismAgentSpiffeId]:[])]));
   22       return true;
   23     } catch { return false; }
   24   }
   25   const supplied = Buffer.from(String(request.headers.authorization ?? '').replace(/^Bearer /u, ''));
   26   const expected = Buffer.from(options.workerSecret);
   27   return expected.length > 0 && supplied.length === expected.length && timingSafeEqual(supplied, expected);
   28 }
   29 /** The actual Control artifact route, shared with native HTTP integration tests. */
   30 export async function handleInternalArtifact(request: IncomingMessage, response: ServerResponse,
   31   url: URL, options: InternalArtifactOptions): Promise<boolean> {
   32   const match = /^\/v1\/internal\/artifacts\/(sha256:[a-f0-9]{64})$/u.exec(url.pathname);
   33   if (!match) return false;
   34   if (!authorized(request, options)) { json(response, 401, { error: 'unauthorized' }); return true; }
   35   if (url.search || url.hash) throw new Error('Prism artifact URL must be canonical');
   36   if (request.method === 'GET') {
   37     const bytes = await options.artifacts.get(`artifact:${match[1]}`);
   38     response.writeHead(200, { 'content-type': 'application/octet-stream', 'cache-control': 'no-store' });
   39     response.end(bytes); return true;
   40   }
   41   if (request.method === 'POST') {
   42     const chunks: Buffer[] = []; let size = 0;
   43     for await (const chunk of request) {
   44       size += chunk.length;
   45       if (size > 134_217_728) throw new Error('evidence is too large');
   46       chunks.push(chunk);
   47     }
   48     const bytes = Buffer.concat(chunks);
   49     if (`sha256:${createHash('sha256').update(bytes).digest('hex')}` !== match[1]) throw new Error('evidence digest does not match URL');
   50     const stored = await options.artifacts.put(bytes); json(response, 201, stored); return true;
   51   }
   52   json(response, 405, { error: 'method not allowed' }); return true;
   53 }

SOURCE skills/prism/server/worker-service.ts sha256:90174f5edf19c85ef1642da95a51aac46854f9a1ce7172d876045a5bac1595e4
    1 import { type IncomingMessage, type ServerResponse } from "node:http";
    2 import {
    3   validateWorkerResourceContractV3,
    4   type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3,
    5 } from "@kubeclaw/pipeline-worker-core-contract";
    6 import { type WorkerNonceDatabase, WorkerDependencyUnavailable } from "./worker-readiness.ts";
    7 import { createManagedWorkerServer } from "./worker-lifecycle.ts";
    8 import { authorizeProxiedSpiffePeer, NativeWorkerAttemptBusy } from "@kubeclaw/worker-core";
    9 import { workerIngressLimits } from './worker-config.ts';
   10 
   11 export type WorkerAuthentication =
   12   | { mode: "hmac"; secret: string; database: WorkerNonceDatabase }
   13   | { mode: "spiffe"; trustedControlSpiffeId: string };
   14 
   15 export interface NativePrismWorkerExecution {
   16   ready(): boolean;
   17   execute(envelope: WorkerAttemptEnvelopeV3, signal: AbortSignal): Promise<WorkerAttemptResultV3>;
   18 }
   19 
   20 export function createWorkerServer(auth: WorkerAuthentication, execution: NativePrismWorkerExecution, limits = workerIngressLimits()) {
   21   return createManagedWorkerServer(
   22     (request, response, signal) => handleWorkerRequest(auth, request, response, signal, { maximumInputBytes: limits.maximumInputBytes, native: execution }),
   23     () => auth.mode === 'hmac' ? auth.database.close() : Promise.resolve(),
   24     limits,
   25   );
   26 }
   27 
   28 async function handleWorkerRequest(auth: WorkerAuthentication,
   29   request: IncomingMessage, response: ServerResponse, signal: AbortSignal,
   30   { maximumInputBytes, native }: { maximumInputBytes: number; native: NativePrismWorkerExecution }): Promise<WorkerAttemptResultV3 | void> {
   31   if (serveLocalHealth(request, response, native)) return;
   32   if (request.url === '/ready') return serveReadiness(auth, response, signal, native);
   33   if (request.url !== "/v1/attempts" || request.method !== "POST") {
   34     response.writeHead(404);
   35     return void response.end();
   36   }
   37   try {
   38     if (
   39       !(request.headers["content-type"] ?? "")
   40         .toString()
   41         .toLowerCase()
   42         .startsWith("application/json")
   43     ) {
   44       response.writeHead(415);
   45       return void response.end();
   46     }
   47     const chunks: Buffer[] = [];
   48     let size = 0;
   49     for await (const chunk of request) {
   50       size += chunk.length;
   51       if (size > maximumInputBytes)
   52         throw new Error("Prism attempt request is too large");
   53       chunks.push(chunk);
   54     }
   55     const raw = Buffer.concat(chunks);
   56     if (auth.mode === "spiffe") authorizeProxiedSpiffePeer(request.headers, request.socket.remoteAddress, new Set([auth.trustedControlSpiffeId]));
   57     else await auth.database.authenticate(auth.secret, raw, request.headers, signal);
   58     const result = await dispatchAttempt(JSON.parse(raw.toString('utf8')), signal, native);
   59     response.writeHead(200, { "content-type": "application/json" });
   60     response.end(JSON.stringify(result));
   61     return result;
   62   } catch (error) {
   63     response.writeHead(error instanceof WorkerDependencyUnavailable || error instanceof NativeWorkerAttemptBusy ? 503 : 422, { "content-type": "application/json" });
   64     response.end(
   65       JSON.stringify({
   66         error: error instanceof Error ? error.message : "failed",
   67       }),
   68     );
   69   }
   70 }
   71 
   72 async function serveReadiness(auth: WorkerAuthentication, response: ServerResponse, signal: AbortSignal,
   73   native: NativePrismWorkerExecution): Promise<void> {
   74   if (!native.ready()) {
   75     response.writeHead(503, { 'content-type': 'application/json' });
   76     response.end('{"status":"not-ready","error":"PRISM_NATIVE_RECONCILIATION_REQUIRED"}');
   77     return;
   78   }
   79   try {
   80     if (auth.mode === 'hmac') await auth.database.check(signal);
   81     response.writeHead(200, { 'content-type': 'application/json' });
   82     response.end('{"status":"ready"}');
   83   } catch {
   84     response.writeHead(503, { 'content-type': 'application/json' });
   85     response.end('{"status":"not-ready","error":"PRISM_NONCE_DATABASE_UNAVAILABLE"}');
   86   }
   87 }
   88 
   89 async function dispatchAttempt(input: unknown, signal: AbortSignal, native: NativePrismWorkerExecution): Promise<WorkerAttemptResultV3> {
   90   validateWorkerResourceContractV3('workerAttemptEnvelope', input);
   91   if (!native.ready()) throw new Error('PRISM_NATIVE_RECONCILIATION_REQUIRED');
   92   return native.execute(input as WorkerAttemptEnvelopeV3, signal);
   93 }
   94 
   95 function serveLocalHealth(request: IncomingMessage, response: ServerResponse, native: NativePrismWorkerExecution): boolean {
   96   if (request.url === "/health" || request.url === "/bootstrap") {
   97     if (request.url === '/bootstrap' && !native.ready()) {
   98       response.writeHead(503, { 'content-type': 'application/json' });
   99       response.end('{"status":"not-ready","error":"PRISM_NATIVE_RECONCILIATION_REQUIRED"}');
  100       return true;
  101     }
  102     response.writeHead(200, { "content-type": "application/json" });
  103     response.end(JSON.stringify({ status: request.url === "/health" ? "alive" : "initialized" }));
  104     return true;
  105   }
  106   return false;
  107 }

SOURCE skills/prism/server/worker-artifacts.ts sha256:01590555f760fde93addcaccefe6d7fec3c38415e5e37e17086f82748a01e950
    1 import { createHash } from 'node:crypto';
    2 import type { WorkerArtifactRefV1, WorkerEvidenceRefV1 } from '@kubeclaw/pipeline-worker-core-contract';
    3 const digest = (bytes: Uint8Array): string => `sha256:${createHash('sha256').update(bytes).digest('hex')}`;
    4 export function artifactLocation(artifact: WorkerArtifactRefV1, origin: URL): URL {
    5   const url = new URL(artifact.storageUrl);
    6   if (url.origin !== origin.origin || url.pathname !== `/v1/internal/artifacts/${artifact.contentDigest}`
    7     || url.search || url.hash || url.username || url.password || artifact.artifactId !== `artifact:${artifact.contentDigest}`) {
    8     throw new Error('Prism artifact location or identity is not allowed');
    9   }
   10   return url;
   11 }
   12 async function responseBytes(response: Response, maximum: number): Promise<Buffer> {
   13   if (Number(response.headers.get('content-length')) > maximum) {
   14     await response.body?.cancel(); throw new Error('Prism artifact response exceeds its byte limit');
   15   }
   16   const reader = response.body?.getReader(); if (!reader) throw new Error('Prism artifact response is empty');
   17   const chunks: Uint8Array[] = []; let size = 0;
   18   try {
   19     for (;;) {
   20       const { done, value } = await reader.read(); if (done) break;
   21       size += value.byteLength;
   22       if (size > maximum) throw new Error('Prism artifact response exceeds its byte limit');
   23       chunks.push(value);
   24     }
   25   } finally { try { await reader.cancel(); } finally { reader.releaseLock(); } }
   26   return Buffer.concat(chunks, size);
   27 }
   28 export class WorkerArtifactClient {
   29   readonly origin: URL;
   30   readonly #headers: Record<string, string>;
   31   constructor(origin: URL, secret: string, spiffeEnabled: boolean) {
   32     this.origin = new URL(origin);
   33     this.#headers = spiffeEnabled ? {} : { authorization: `Bearer ${secret}` };
   34   }
   35   async read(artifact: WorkerArtifactRefV1, signal: AbortSignal): Promise<Buffer> {
   36     const response = await fetch(artifactLocation(artifact, this.origin), { headers: this.#headers, signal, redirect: 'error' });
   37     if (!response.ok) { await response.body?.cancel(); throw new Error(`Prism artifact read failed: ${response.status}`); }
   38     const bytes = await responseBytes(response, artifact.sizeBytes);
   39     if (bytes.byteLength !== artifact.sizeBytes || digest(bytes) !== artifact.contentDigest) throw new Error('Prism artifact failed integrity validation');
   40     return bytes;
   41   }
   42   async upload(id: string, type: string, mediaType: string, content: Uint8Array, signal: AbortSignal): Promise<WorkerEvidenceRefV1> {
   43     const bytes = Buffer.from(content); const contentDigest = digest(bytes);
   44     const storageUrl = new URL(`/v1/internal/artifacts/${contentDigest}`, this.origin).toString();
   45     const response = await fetch(storageUrl, { method: 'POST', headers: { ...this.#headers, 'content-type': 'application/octet-stream' },
   46       body: new Uint8Array(bytes), signal, redirect: 'error' });
   47     const acknowledgment = await responseBytes(response, 8192);
   48     if (!response.ok) throw new Error(`Prism artifact upload failed: ${response.status}: ${acknowledgment.toString('utf8')}`);
   49     const stored = JSON.parse(acknowledgment.toString('utf8')) as { artifactId?: string; digest?: string; sizeBytes?: number };
   50     if (stored.artifactId !== `artifact:${contentDigest}` || stored.digest !== contentDigest || stored.sizeBytes !== bytes.byteLength) {
   51       throw new Error('Prism artifact upload acknowledgment failed integrity validation');
   52     }
   53     return { evidenceId: id, type, artifact: { artifactId: stored.artifactId, type, mediaType, contentDigest, sizeBytes: bytes.byteLength, storageUrl } };
   54   }
   55 }

SOURCE skills/worker/core/worker/trust.ts sha256:722f48ca75fb8546dbc4f4c9cc8eab8e31dfdfeafec7ea7aab587045e78b23fe
    1 const SPIFFE_ID = /^spiffe:\/\/[a-z0-9.-]+\/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$/u;
    2 
    3 export interface WorkerPrincipal {
    4   readonly authentication: 'spiffe-x509-svid';
    5   readonly spiffeId: string;
    6 }
    7 
    8 function headerValue(
    9   headers: Readonly<Record<string, string | string[] | undefined>>,
   10   name: string,
   11 ): string {
   12   const value = headers[name] ?? headers[name.toLowerCase()];
   13   if (Array.isArray(value)) return value.join(',');
   14   return value ?? '';
   15 }
   16 
   17 export function spiffePeerFromForwardedClientCertificate(
   18   headers: Readonly<Record<string, string | string[] | undefined>>,
   19 ): WorkerPrincipal {
   20   const forwarded = headerValue(headers, 'x-forwarded-client-cert');
   21   if (!forwarded || forwarded.includes(',')) throw new Error('WORKER_TRUST_PEER_MISSING');
   22   const uriFields = forwarded.split(';').map((field) => field.trim())
   23     .filter((field) => field.startsWith('URI='));
   24   if (uriFields.length !== 1) throw new Error('WORKER_TRUST_PEER_INVALID');
   25   const match = /^URI=(?:"([^"]+)"|([^";]+))$/u.exec(uriFields[0]!);
   26   const spiffeId = (match?.[1] ?? match?.[2] ?? '').trim();
   27   if (!SPIFFE_ID.test(spiffeId)) throw new Error('WORKER_TRUST_PEER_INVALID');
   28   return Object.freeze({ authentication: 'spiffe-x509-svid', spiffeId });
   29 }
   30 
   31 export function authorizeSpiffePeer(
   32   headers: Readonly<Record<string, string | string[] | undefined>>,
   33   allowedSpiffeIds: ReadonlySet<string>,
   34 ): WorkerPrincipal {
   35   if (allowedSpiffeIds.size === 0 || [...allowedSpiffeIds].some((id) => !SPIFFE_ID.test(id))) {
   36     throw new Error('WORKER_TRUST_POLICY_INVALID');
   37   }
   38   const principal = spiffePeerFromForwardedClientCertificate(headers);
   39   if (!allowedSpiffeIds.has(principal.spiffeId)) throw new Error('WORKER_TRUST_PEER_FORBIDDEN');
   40   return principal;
   41 }
   42 
   43 export function authorizeProxiedSpiffePeer(
   44   headers: Readonly<Record<string, string | string[] | undefined>>,
   45   remoteAddress: string | undefined,
   46   allowedSpiffeIds: ReadonlySet<string>,
   47 ): WorkerPrincipal {
   48   if (!remoteAddress || !['127.0.0.1', '::1', '::ffff:127.0.0.1'].includes(remoteAddress)) {
   49     throw new Error('WORKER_TRUST_PROXY_REQUIRED');
   50   }
   51   return authorizeSpiffePeer(headers, allowedSpiffeIds);
   52 }

SOURCE skills/worker/core/worker/native-worker-launcher.c sha256:69c04c62b0e3ae9e48d24280ffc53dfcbc883fc053db694e3d088230332ded63
    1 #define _GNU_SOURCE
    2 #include <errno.h>
    3 #include <fcntl.h>
    4 #include <grp.h>
    5 #include <linux/magic.h>
    6 #include <limits.h>
    7 #include <signal.h>
    8 #include <stdio.h>
    9 #include <stdlib.h>
   10 #include <string.h>
   11 #include <sys/prctl.h>
   12 #include <sys/stat.h>
   13 #include <sys/vfs.h>
   14 #include <unistd.h>
   15 
   16 /* Trusted supervisor entry only. Not setuid and never callable with retained privilege. */
   17 static void fail(const char *code) {
   18   fprintf(stderr, "%s\n", code);
   19   _exit(125);
   20 }
   21 
   22 static unsigned int identity(const char *text) {
   23   char *end = NULL;
   24   errno = 0;
   25   unsigned long value = strtoul(text, &end, 10);
   26   if (errno || !*text || *end || value == 0 || value >= 4294967295UL || text[0] == '-') {
   27     fail("WORKER_NATIVE_LAUNCH_IDENTITY_INVALID");
   28   }
   29   return (unsigned int)value;
   30 }
   31 
   32 static int uuid_name(const char *name, const char *prefix) {
   33   size_t offset = strlen(prefix);
   34   if (strlen(name) != offset + 36 || strncmp(name, prefix, offset)) return 0;
   35   for (int index = 0; index < 36; ++index) {
   36     char character = name[offset + index];
   37     if (index == 8 || index == 13 || index == 18 || index == 23) {
   38       if (character != '-') return 0;
   39     } else if (!((character >= '0' && character <= '9') || (character >= 'a' && character <= 'f'))) return 0;
   40   }
   41   return 1;
   42 }
   43 
   44 static void scope_parent(const char *value, char *parent) {
   45   char canonical[PATH_MAX];
   46   if (!realpath(value, canonical) || strcmp(value, canonical)) fail("WORKER_NATIVE_LAUNCH_SCOPE_INVALID");
   47   char *leaf = strrchr(canonical, '/');
   48   if (!leaf || (strcmp(leaf + 1, "host") && !uuid_name(leaf + 1, "helper-"))) fail("WORKER_NATIVE_LAUNCH_SCOPE_INVALID");
   49   *leaf = '\0';
   50   const char *name = strrchr(canonical, '/');
   51   if (!name || !uuid_name(name + 1, "worker-")) fail("WORKER_NATIVE_LAUNCH_SCOPE_INVALID");
   52   strcpy(parent, canonical);
   53 }
   54 
   55 static unsigned long long binding_number(const char *text) {
   56   char *end = NULL;
   57   errno = 0;
   58   unsigned long long value = strtoull(text, &end, 10);
   59   if (errno || !*text || *end || text[0] < '0' || text[0] > '9') fail("WORKER_NATIVE_LAUNCH_BINDING_INVALID");
   60   return value;
   61 }
   62 
   63 static int bound_scope(const char *value, const char *device, const char *inode) {
   64   int scope = open(value, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
   65   struct stat info;
   66   struct statfs filesystem;
   67   if (scope < 0 || fstatfs(scope, &filesystem) || filesystem.f_type != CGROUP2_SUPER_MAGIC
   68       || fstat(scope, &info) || info.st_uid != 0 || (info.st_mode & 0022)) fail("WORKER_NATIVE_LAUNCH_SCOPE_INVALID");
   69   if ((unsigned long long)info.st_dev != binding_number(device)
   70       || (unsigned long long)info.st_ino != binding_number(inode)) fail("WORKER_NATIVE_LAUNCH_BINDING_INVALID");
   71   return scope;
   72 }
   73 
   74 int main(int argc, char **argv) {
   75   if (argc < 9 || argv[1][0] != '/' || argv[8][0] != '/') fail("WORKER_NATIVE_LAUNCH_ARGUMENTS_INVALID");
   76   if (getuid() != 0 || geteuid() != 0) fail("WORKER_NATIVE_SUPERVISOR_IDENTITY_REQUIRED");
   77   const char *parent = getenv("KUBECLAW_NATIVE_SUPERVISOR_PID");
   78   if (!parent) fail("WORKER_NATIVE_LAUNCH_PARENT_REQUIRED");
   79   unsigned int supervisor = identity(parent);
   80   if (supervisor > INT_MAX || prctl(PR_SET_PDEATHSIG, SIGKILL) || getppid() != (pid_t)supervisor) {
   81     fail("WORKER_NATIVE_LAUNCH_PARENT_LOST");
   82   }
   83   uid_t uid = identity(argv[6]);
   84   gid_t gid = identity(argv[7]);
   85   char parent_path[PATH_MAX];
   86   scope_parent(argv[1], parent_path);
   87   int aggregate = bound_scope(parent_path, argv[2], argv[3]);
   88   int scope = bound_scope(argv[1], argv[4], argv[5]);
   89   /* Verify that the pinned child still belongs to the pinned aggregate. */
   90   int parent_fd = openat(scope, "..", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
   91   struct stat parent_info;
   92   struct stat info;
   93   if (parent_fd < 0 || fstat(parent_fd, &parent_info) || fstat(aggregate, &info)
   94       || parent_info.st_dev != info.st_dev || parent_info.st_ino != info.st_ino) fail("WORKER_NATIVE_LAUNCH_BINDING_INVALID");
   95   if (close(parent_fd) || close(aggregate)) fail("WORKER_NATIVE_LAUNCH_CLOSE_FAILED");
   96   int membership = openat(scope, "cgroup.procs", O_WRONLY | O_CLOEXEC | O_NOFOLLOW);
   97   if (membership < 0 || fstat(membership, &info) || info.st_uid != 0 || (info.st_mode & 0022)) {
   98     fail("WORKER_NATIVE_LAUNCH_MEMBERSHIP_INVALID");
   99   }
  100   /* The kernel treats 0 as the caller. No executable work or descendant precedes membership. */
  101   if (write(membership, "0", 1) != 1) fail("WORKER_NATIVE_LAUNCH_ATTACH_FAILED");
  102   if (close(membership) || close(scope)) fail("WORKER_NATIVE_LAUNCH_CLOSE_FAILED");
  103   if (setenv("KUBECLAW_NATIVE_SCOPE", parent_path, 1)) fail("WORKER_NATIVE_LAUNCH_ENVIRONMENT_FAILED");
  104   if (setgroups(0, NULL) || setresgid(gid, gid, gid) || setresuid(uid, uid, uid)
  105       || prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0)) fail("WORKER_NATIVE_LAUNCH_DROP_PRIVILEGE_FAILED");
  106   if (getuid() != uid || geteuid() != uid || getgid() != gid || getegid() != gid) {
  107     fail("WORKER_NATIVE_LAUNCH_PRIVILEGE_RETAINED");
  108   }
  109   /* Credential changes clear PDEATHSIG. Re-arm and check the original parent
  110      again, closing the death race before any trusted role code executes. */
  111   if (prctl(PR_SET_PDEATHSIG, SIGKILL) || getppid() != (pid_t)supervisor) {
  112     fail("WORKER_NATIVE_LAUNCH_PARENT_LOST");
  113   }
  114   execv(argv[8], &argv[8]);
  115   fail("WORKER_NATIVE_LAUNCH_EXEC_FAILED");
  116 }

SOURCE charts/prism/templates/workloads.yaml sha256:e7a7cee020d5fd6823b5a63039a9ba2e924ed63363a7bb7bad1d51dd59722e20
    1 {{- $swarm := include "prism.swarmConfig" . | fromJson }}
