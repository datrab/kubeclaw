  130 export async function handleStudioRequest(request: IncomingMessage, response: ServerResponse, options: StudioOptions): Promise<void> {
  131   let url: URL;
  132   try { url = new URL(request.url ?? '/', 'http://studio'); }
  133   catch (error) { throw new StudioRequestError(400, 'PRISM_STUDIO_URL_INVALID', error); }
  134   if (url.pathname === '/health' || url.pathname === '/ready') {
  135     response.writeHead(200, { 'content-type': 'application/json' }); response.end('{"status":"ready"}'); return;
  136   }
  137   if (url.pathname.startsWith('/v1/')) await proxy(request, response, url, options);
  138   else await staticFile(url, response, options);
  139 }

