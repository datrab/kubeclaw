    1 import { loadPrismSettings, loadPrismWorkerSettings, type PrismWorkerSettings } from '../../common/plugin-runtime/foundation/config/swarm.ts';
    2 
    3 /** Platform-owned configuration is captured once before starting the worker. */
    4 
    5 export function loadWorkerConfig(environment: NodeJS.ProcessEnv = process.env) {
    6   if (environment.PORT !== undefined) throw new Error('SWARM_CONFIG_LEGACY_OVERRIDE:PORT moved to prism-worker.config.json settings.ingress.port');
    7   const spiffeEnabled = environment.WORKER_TRUST_SPIFFE_ENABLED === 'true';
    8   const workerSecret = environment.PRISM_WORKER_SECRET ?? '';
    9   if (!spiffeEnabled && !workerSecret) throw new Error('PRISM_WORKER_SECRET is required');
   10   const trustedControlSpiffeId = environment.PRISM_TRUSTED_CONTROL_SPIFFE_ID ?? '';
   11   if (spiffeEnabled && !trustedControlSpiffeId) throw new Error('Prism worker SPIFFE trust policy is incomplete');
   12   const databaseUrl = environment.DATABASE_URL ?? '';
   13   if (!spiffeEnabled && !databaseUrl) throw new Error('DATABASE_URL is required');
   14   const snapshot = loadPrismSettings(environment);
   15   const settings = snapshot.worker;
   16   return Object.freeze({ spiffeEnabled, workerSecret, trustedControlSpiffeId, databaseUrl, shutdownTimeoutMs: settings.shutdownTimeoutMs,
   17     controlInternalUrl: new URL(environment.PRISM_CONTROL_INTERNAL_URL ?? 'http://prism-control:8080'),
   18     native: snapshot.native, port: settings.port, ingress: ingressLimits(settings),
   19   });
   20 }
   21 
   22 export function workerIngressLimits(environment: NodeJS.ProcessEnv = process.env) {
   23   return ingressLimits(loadPrismWorkerSettings(environment));
   24 }
   25 
   26 function ingressLimits(settings: PrismWorkerSettings) {
   27   return Object.freeze({
   28     maximumActiveRequests: settings.maximumActiveRequests,
   29     maximumProbeRequests: settings.maximumProbeRequests,
   30     maximumConnections: settings.maximumConnections,
   31     maximumInputBytes: settings.maximumInputBytes,
   32     requestTimeoutMs: settings.requestTimeoutMs,
   33   });
   34 }

