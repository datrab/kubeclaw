SOURCE skills/prism/server/studio-request.ts sha256:efca0f821ef3da9f441e9c6c5458a33d8c525f8e7db3a63aea1a8e7f37e93bbb
    1 import type { IncomingMessage, ServerResponse } from 'node:http';
    2 import { open, stat } from 'node:fs/promises';
    3 import { extname, resolve, sep } from 'node:path';
    4 import { once } from 'node:events';
    5 import { pipeline } from 'node:stream/promises';
    6 import { prismProxyResponseHeaders } from './proxy-headers.ts';
    7 
    8 export interface StudioOptions {
    9   readonly root: string;
   10   readonly control: URL;
   11   readonly ingressSecret: string;
   12   readonly controlTimeoutMs: number;
   13 }
   14 class StudioRequestError extends Error {
   15   readonly status: number;
   16   constructor(status: number, code: string, cause?: unknown) {
   17     super(code, cause === undefined ? undefined : { cause }); this.status = status;
   18   }
   19 }
   20 const types: Record<string, string> = { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml' };
   21 
   22 function errorDetails(error: unknown): { message: string; code?: string; cause?: string } {
   23   if (!(error instanceof Error)) return { message: String(error) };
   24   const code = 'code' in error && typeof error.code === 'string' ? error.code : undefined;
   25   return { message: error.message, ...(code ? { code } : {}),
   26     ...(error.cause instanceof Error ? { cause: error.cause.message } : {}) };
   27 }
   28 export function studioRequestFailed(error: unknown, response: ServerResponse): void {
   29   const causes = []; const seen = new Set<unknown>(); let current = error;
   30   while (current instanceof Error && !seen.has(current)) {
   31     seen.add(current); causes.push({ ...errorDetails(current), stack: current.stack }); current = current.cause;
   32   }
   33   process.stderr.write(`${JSON.stringify({ time: new Date().toISOString(), level: 'error', component: 'prism-studio',
   34     event: 'PRISM_STUDIO_REQUEST_FAILED', error: errorDetails(error), causes })}\n`);
   35   if (response.destroyed || response.writableEnded) return;
   36   if (response.headersSent) { response.destroy(error instanceof Error ? error : new Error(String(error))); return; }
   37   const status = error instanceof StudioRequestError ? error.status : 500;
   38   for (const name of response.getHeaderNames()) response.removeHeader(name);
   39   response.writeHead(status, { 'content-type': 'application/json' });
   40   response.end(JSON.stringify({ error: errorDetails(error),
   41     ...(error instanceof Error && error.cause !== undefined ? { cause: errorDetails(error.cause) } : {}) }));
   42 }
   43 
   44 async function requestBody(request: IncomingMessage): Promise<Buffer<ArrayBuffer> | undefined> {
   45   const chunks: Buffer[] = []; let size = 0;
   46   for await (const chunk of request) {
   47     size += chunk.length;
   48     if (size > 2_000_000) throw new StudioRequestError(413, 'PRISM_STUDIO_REQUEST_TOO_LARGE');
   49     chunks.push(chunk);
   50   }
   51   return chunks.length ? Buffer.concat(chunks) : undefined;
   52 }
   53 function upstreamHeaders(request: IncomingMessage, secret: string): Headers {
   54   const headers = new Headers();
   55   for (const name of ['origin', 'content-type', 'cookie', 'x-prism-csrf', 'idempotency-key', 'tailscale-user-login', 'tailscale-user-name', 'tailscale-user-profile-pic']) {
   56     const value = request.headers[name]; if (typeof value === 'string') headers.set(name, value);
   57   }
   58   headers.set('x-prism-ingress-secret', secret);
   59   return headers;
   60 }
   61 async function forwardBody(upstream: Response, response: ServerResponse, signal: AbortSignal): Promise<void> {
   62   const reader = upstream.body?.getReader();
   63   try {
   64     if (!reader) { response.end(); return; }
   65     for (;;) {
   66       signal.throwIfAborted();
   67       const part = await reader.read();
   68       if (part.done) break;
   69       if (!response.write(part.value)) await once(response, 'drain', { signal });
   70     }
   71     response.end();
   72   } finally {
   73     if (reader) {
   74       try { await reader.cancel(); }
   75       catch { /* INTENTIONAL_NONCRITICAL(upstream_already_failed): Preserve the primary fetch/stream error. */ }
   76       reader.releaseLock();
   77     }
   78   }
   79 }
   80 async function proxy(request: IncomingMessage, response: ServerResponse, url: URL, options: StudioOptions): Promise<void> {
   81   if (!options.ingressSecret) throw new StudioRequestError(503, 'PRISM_STUDIO_PROXY_NOT_CONFIGURED');
   82   const body = await requestBody(request);
   83   const controller = new AbortController();
   84   const timeoutError = new Error('PRISM_STUDIO_CONTROL_TIMEOUT');
   85   const timer = setTimeout(() => controller.abort(timeoutError), options.controlTimeoutMs);
   86   const disconnected = () => { if (!response.writableEnded) controller.abort(new Error('PRISM_STUDIO_CLIENT_DISCONNECTED')); };
   87   const responseFailed = (error: Error) => controller.abort(error);
   88   response.once('close', disconnected);
   89   response.once('error', responseFailed);
   90   try {
   91     if (response.destroyed) { disconnected(); controller.signal.throwIfAborted(); }
   92     const upstream = await fetch(new URL(`${url.pathname}${url.search}`, options.control), {
   93       method: request.method, headers: upstreamHeaders(request, options.ingressSecret), body, redirect: 'manual', signal: controller.signal,
   94     });
   95     response.statusCode = upstream.status;
   96     const forwarded = prismProxyResponseHeaders(upstream.headers);
   97     for (const [name, value] of forwarded.ordinary) response.setHeader(name, value);
   98     if (forwarded.setCookies.length) response.setHeader('set-cookie', forwarded.setCookies);
   99     await forwardBody(upstream, response, controller.signal);
  100   } catch (error) {
  101     throw new StudioRequestError(controller.signal.reason === timeoutError ? 504 : 502,
  102       controller.signal.reason === timeoutError ? 'PRISM_STUDIO_CONTROL_TIMEOUT' : 'PRISM_STUDIO_UPSTREAM_FAILED', error);
  103   } finally { clearTimeout(timer); response.off('close', disconnected); response.off('error', responseFailed); }
  104 }
  105 
  106 async function staticFile(url: URL, response: ServerResponse, options: StudioOptions): Promise<void> {
  107   let requested: string;
  108   try { requested = decodeURIComponent(url.pathname).replace(/^\/+/, ''); }
  109   catch (error) { throw new StudioRequestError(400, 'PRISM_STUDIO_PATH_ENCODING_INVALID', error); }
  110   const root = resolve(options.root); let file = resolve(root, requested || 'index.html');
  111   if (file !== root && !file.startsWith(`${root}${sep}`)) throw new StudioRequestError(403, 'PRISM_STUDIO_PATH_OUTSIDE_ROOT');
  112   try { if ((await stat(file)).isDirectory()) file = resolve(file, 'index.html'); }
  113   catch (error) {
  114     if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
  115     file = resolve(root, 'index.html');
  116   }
  117   let handle;
  118   try { handle = await open(file); }
  119   catch (error) {
  120     if ((error as NodeJS.ErrnoException).code === 'ENOENT') throw new StudioRequestError(404, 'PRISM_STUDIO_STATIC_NOT_FOUND', error);
  121     throw error;
  122   }
  123   try {
  124     response.setHeader('content-type', types[extname(file)] ?? 'application/octet-stream');
  125     response.setHeader('content-security-policy', "default-src 'self'; frame-src 'self'; connect-src 'self' https:; object-src 'none'; base-uri 'none'");
  126     await pipeline(handle.createReadStream(), response);
  127   } finally { await handle.close(); }
  128 }
