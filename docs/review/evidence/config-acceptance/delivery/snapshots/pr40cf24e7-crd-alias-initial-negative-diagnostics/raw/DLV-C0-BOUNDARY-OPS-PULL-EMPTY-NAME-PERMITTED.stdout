# Source: kubeclaw-ops/templates/workload.yaml
apiVersion: v1
kind: Service
metadata:
  name: delivery-ops-pod
spec:
  clusterIP: None
  selector: {app.kubernetes.io/name: delivery-ops-pod}
  ports:
    - name: health
      port: 8080
      targetPort: 8080
---
# Source: kubeclaw-ops/templates/workload.yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: delivery-ops-pod
spec:
  serviceName: delivery-ops-pod
  replicas: 1
  revisionHistoryLimit: 3
  # A single persistent CLI identity/workspace must never have two writers.
  updateStrategy: {type: RollingUpdate}
  selector:
    matchLabels: {app.kubernetes.io/name: delivery-ops-pod}
  template:
    metadata:
      labels: {app.kubernetes.io/name: delivery-ops-pod}
    spec:
      serviceAccountName: delivery-ops-pod
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: {type: RuntimeDefault}
      imagePullSecrets: 
        - name: ""
      containers:
        - name: codex
          image: "ghcr.io/datrab/kubeclaw-ops-codex@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          env:
            - {name: HOME, value: /home/node}
            - {name: OPS_DEFAULT_NAMESPACE, value: "default"}
            - {name: OPS_EXEC_NAMESPACES, value: "default"}
            - {name: KUBECONFIG, value: /var/run/kubeclaw-ops/kubeconfig/config}
            - name: GH_TOKEN
              valueFrom:
                secretKeyRef: {name: delivery-github-a, key: token}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources: 
            limits:
              cpu: "1"
              memory: 1Gi
            requests:
              cpu: 100m
              memory: 128Mi
          volumeMounts:
            - {name: home, mountPath: /home/node}
            - {name: workspace, mountPath: /workspace}
            - {name: codex-tmp, mountPath: /tmp}
            - {name: bearer, mountPath: /var/run/kubeclaw-ops/bearer, readOnly: true}
            - {name: kube-api, mountPath: /var/run/secrets/kubernetes.io/serviceaccount, readOnly: true}
            - {name: kubeconfig, mountPath: /var/run/kubeclaw-ops/kubeconfig, readOnly: true}
          readinessProbe:
            exec:
              command: [python3, -c, "import json; s=json.load(open('/tmp/codex-ops-status.json')); raise SystemExit(0 if s['phase']=='remote-process-running' else 1)"]
            periodSeconds: 10
            timeoutSeconds: 3
          # No auth/relay/API dependent liveness probe: kubectl exec must remain
          # available while login/pairing or the OpenAI service is unavailable.
        - name: ops-mcp
          image: "ghcr.io/datrab/kubeclaw-ops-mcp@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          env:
            - {name: HOST, value: "127.0.0.1"}
            - {name: OPS_LOCAL_ONLY, value: "1"}
            - {name: OPS_DEFAULT_NAMESPACE, value: "default"}
            - {name: OPS_ALLOWED_NAMESPACES, value: "default,argocd"}
            - {name: ARGOCD_NAMESPACE, value: "argocd"}
            - {name: OPS_MCP_BEARER_TOKEN_FILE, value: /var/run/kubeclaw-ops/bearer/token}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources: 
            limits:
              cpu: "1"
              memory: 1Gi
            requests:
              cpu: 100m
              memory: 128Mi
          volumeMounts:
            - {name: kube-api, mountPath: /var/run/secrets/kubernetes.io/serviceaccount, readOnly: true}
            - {name: bearer, mountPath: /var/run/kubeclaw-ops/bearer, readOnly: true}
          readinessProbe:
            exec:
              command: [node, -e, "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
            periodSeconds: 10
            timeoutSeconds: 3
          livenessProbe:
            exec:
              command: [node, -e, "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
            initialDelaySeconds: 20
            periodSeconds: 20
            timeoutSeconds: 3
        - name: tailscale
          image: "ghcr.io/tailscale/tailscale:v1.102.3"
          env:
            - {name: TS_USERSPACE, value: "true"}
            - {name: TS_AUTH_ONCE, value: "true"}
            - {name: TS_KUBE_SECRET, value: ""}
            - {name: TS_STATE_DIR, value: /var/lib/tailscale}
            - {name: TS_SOCKET, value: /tmp/tailscaled.sock}
            - {name: TS_SOCKS5_SERVER, value: "127.0.0.1:1055"}
            - {name: TS_HOSTNAME, value: "kubeclaw-ops"}
            - {name: TS_EXTRA_ARGS, value: "--accept-dns=false"}
            - name: TS_AUTHKEY
              valueFrom:
                secretKeyRef: {name: delivery-tailnet-a, key: authkey}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources: 
            limits:
              cpu: "1"
              memory: 1Gi
            requests:
              cpu: 100m
              memory: 128Mi
          volumeMounts:
            - {name: tailscale-state, mountPath: /var/lib/tailscale}
            - {name: tailscale-tmp, mountPath: /tmp}
      volumes:
        - name: kubeconfig
          configMap:
            name: delivery-ops-pod-kubeconfig
        - name: bearer
          secret:
            secretName: delivery-bearer-a
            defaultMode: 0440
        - name: kube-api
          projected:
            defaultMode: 0440
            sources:
              - serviceAccountToken: {path: token, expirationSeconds: 3600}
              - downwardAPI:
                  items:
                    - path: namespace
                      fieldRef: {fieldPath: metadata.namespace}
              - configMap:
                  name: kube-root-ca.crt
                  items: [{key: ca.crt, path: ca.crt}]
        - {name: codex-tmp, emptyDir: {sizeLimit: 1Gi}}
        - {name: tailscale-tmp, emptyDir: {sizeLimit: 64Mi}}
        - name: tailscale-state
          persistentVolumeClaim: {claimName: delivery-ops-pod-tailscale}
  volumeClaimTemplates:
    - metadata: {name: home}
      spec:
        accessModes: [ReadWriteOnce]
        storageClassName: "delivery-storage-a"
        resources:
          requests:
            storage: 2Gi
    - metadata: {name: workspace}
      spec:
        accessModes: [ReadWriteOnce]
        storageClassName: "delivery-storage-a"
        resources:
          requests:
            storage: 20Gi
