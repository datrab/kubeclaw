{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "leaseUID",
    "policyEpochDigest",
    "revision",
    "authorityReceiptRef",
    "phase",
    "operation",
    "cleanup",
    "readyRequestDigest",
    "productPayloadDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dlv-controller-lifecycle.v1-proposal"
    },
    "leaseUID": {
      "type": "string",
      "minLength": 1
    },
    "policyEpochDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authorityReceiptRef": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "active",
        "ready",
        "product",
        "cleanup-intent",
        "cleanup-uncertain",
        "cleanup-confirmed"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "requestDigest",
        "baseLeaseResourceVersion",
        "priorLifecycleDigest",
        "startedAt",
        "deadline",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "epoch-admission",
            "ready-admission",
            "product-admission",
            "namespace-delete"
          ]
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "baseLeaseResourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "priorLifecycleDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "startedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "deadline": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "outcome": {
          "enum": [
            "intent",
            "uncertain",
            "confirmed"
          ]
        }
      }
    },
    "cleanup": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespaceName",
            "namespaceUID",
            "namespaceResourceVersion",
            "grantReceiptRef",
            "originalTimeoutSeconds",
            "attemptId",
            "startedAt",
            "deadline",
            "confirmation"
          ],
          "properties": {
            "namespaceName": {
              "type": "string",
              "minLength": 1
            },
            "namespaceUID": {
              "type": "string",
              "minLength": 1
            },
            "namespaceResourceVersion": {
              "type": "string",
              "minLength": 1
            },
            "grantReceiptRef": {
              "type": "string",
              "minLength": 1
            },
            "originalTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036
            },
            "attemptId": {
              "type": "string",
              "minLength": 1
            },
            "startedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
            },
            "deadline": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
            },
            "confirmation": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "observerReceiptRef",
                    "observedAt",
                    "originalNamespaceUID"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "original-UID-absent",
                        "delete-status-confirmed"
                      ]
                    },
                    "observerReceiptRef": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observedAt": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
                    },
                    "originalNamespaceUID": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "readyRequestDigest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "productPayloadDigest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    }
  },
  "title": "Own proposed status.deliveryLifecycle; NOT installed CRD validation or authority proof"
}
