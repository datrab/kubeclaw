const fs=require('fs'),yaml=require('js-yaml'); const docs=yaml.loadAll(fs.readFileSync(process.argv[1],'utf8'));const c=docs.find(x=>x?.kind==='ConfigMap'&&x.data?.['openclaw.json']);const j=JSON.parse(c.data['openclaw.json']);const d=docs.find(x=>x?.kind==='Deployment'&&x.metadata.name==='kubeclaw-'+process.argv[2]);const main=d.spec.template.spec.containers.find(x=>x.name==='kubeclaw'); console.log(JSON.stringify({model:j.agents.defaults.model,gatewayPort:j.gateway.port,env:Object.fromEntries(main.env.filter(x=>x.value!==undefined).map(x=>[x.name,x.value]))}));
