# Source: prism/templates/ingestion.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prism-ingestion
  annotations:
    argocd.argoproj.io/sync-wave: "2"
spec:
  replicas: 2
  selector: { matchLabels: { app: prism-ingestion } }
  template:
    metadata: { labels: { app: prism-ingestion } }
    spec:
      serviceAccountName: prism-ingestion
      imagePullSecrets: 
        - name: ghcr-secret
      automountServiceAccountToken: false
      securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: ingestion
          image: "ghcr.io/datrab/kubeclaw-prism-ingestion@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          imagePullPolicy: IfNotPresent
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
          resources:
            requests:
              cpu: "250m"
              memory: "256Mi"
            limits:
              cpu: "1"
              memory: "1Gi"
          env:
            - { name: PORT, value: "8080" }
            - name: PRISM_INGESTION_SECRET
              valueFrom: { secretKeyRef: { name: prism-runtime, key: ingestion-secret } }
            - { name: PRISM_QUARANTINE_ROOT, value: /quarantine }
            - { name: PRISM_QUARANTINE_TTL_MS, value: "120000" }
          volumeMounts: [{ name: quarantine, mountPath: /quarantine }]
          readinessProbe: { httpGet: { path: /ready, port: 8080 }, initialDelaySeconds: 3 }
          livenessProbe: { httpGet: { path: /health, port: 8080 }, initialDelaySeconds: 3 }
      volumes: [{ name: quarantine, emptyDir: { sizeLimit: 4Gi } }]
---
