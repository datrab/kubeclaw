# Source: prism/templates/backup.yaml
apiVersion: batch/v1
kind: CronJob
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "2"
  name: prism-backup
spec:
  schedule: "0 1 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 0
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 1830
      template:
        metadata:
          labels: { app: prism-backup }
          annotations:
            checksum/backup-script: 4a0209b0ec2c7b68811d856c85b9519d0ea12151e5e17409ba963e4fda961bef
        spec:
          serviceAccountName: prism-backup
          imagePullSecrets: 
            - name: ghcr-secret
          automountServiceAccountToken: false
          # Immutable objects are mode 0600 and owned by Prism's UID 1000.
          # The source mount stays read-only; fsGroup only owns the backup PVC.
          securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: { type: RuntimeDefault } }
          restartPolicy: Never
          containers:
            # Container names are Kubernetes merge keys. Preserve the original
            # Helm identities so adoption updates the existing process instead
            # of retaining the old backup/restore program as a second container.
            - name: proof
              image: "pgvector/pgvector:pg17@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f"
              command: ["bash", "/backup-program/prism-backup.sh", "backup"]
              # The legacy containers put their shell program in args. Explicit
              # deletion is needed when it is absent from last-applied state.
              args: null
              env:
                - { name: BACKUP_ROOT, value: /backups }
                - { name: BACKUP_MAXIMUM_BYTES, value: "42949672960" }
                - { name: BACKUP_MAXIMUM_RETAINED_BYTES, value: "53687091200" }
                - { name: BACKUP_MAXIMUM_DURATION_SECONDS, value: "1800" }
                - { name: ARTIFACT_ROOT, value: /artifacts }
                - { name: PRISM_BACKUP_IMAGE, value: "ghcr.io/datrab/kubeclaw-prism-control@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }
                - { name: PGCONNECT_TIMEOUT, value: "15" }
                - { name: PGHOST, value: prism-postgresql }
                - { name: PGDATABASE, value: prism }
                - { name: PGUSER, value: postgres }
                - name: PGPASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: prism-postgresql-auth
                      key: password
              securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
              resources: 
                limits:
                  cpu: "2"
                  memory: 2Gi
                requests:
                  cpu: 250m
                  memory: 256Mi
              volumeMounts:
                - { name: backups, mountPath: /backups }
                - { name: program, mountPath: /backup-program, readOnly: true }
                - { name: artifacts, mountPath: /artifacts, readOnly: true }
          volumes:
            - name: backups
              persistentVolumeClaim: { claimName: prism-backups }
            - name: program
              configMap: { name: prism-backup-script }
            - name: artifacts
              persistentVolumeClaim: { claimName: prism-artifacts, readOnly: true }
---
