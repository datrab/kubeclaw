# Source: prism/templates/backup-storage-check.yaml
# Bind WaitForFirstConsumer backup storage during sync, not at the next nightly job.
apiVersion: batch/v1
kind: Job
metadata:
  name: prism-backup-storage-check
  annotations:
    helm.sh/hook: post-install,post-upgrade
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
    argocd.argoproj.io/hook: Sync
    argocd.argoproj.io/sync-wave: "2"
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation,HookSucceeded
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 120
  template:
    metadata:
      labels: { app: prism-backup }
    spec:
      serviceAccountName: prism-backup
      automountServiceAccountToken: false
      imagePullSecrets: 
        - name: ghcr-secret
      restartPolicy: Never
      securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: storage-check
          image: "pgvector/pgvector:pg17@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f"
          command: [/bin/sh, -ec]
          args:
            - |
              umask 077
              probe=$(mktemp /backups/.write-check-XXXXXX)
              trap 'rm -f -- "$probe"' EXIT
              printf verified > "$probe"
              test "$(cat "$probe")" = verified
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
          resources: { requests: { cpu: 50m, memory: 64Mi }, limits: { cpu: 200m, memory: 128Mi } }
          volumeMounts:
            - { name: backups, mountPath: /backups }
      volumes:
        - { name: backups, persistentVolumeClaim: { claimName: prism-backups } }
---
# Source: prism/templates/jobs.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: prism-migrate
  annotations:
    "helm.sh/hook": post-install,pre-upgrade
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
    # Argo treats every deployment as a sync. Run once, after the database is
    # healthy and before application workloads, including the first sync.
    argocd.argoproj.io/hook: Sync
    argocd.argoproj.io/sync-wave: "1"
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation,HookSucceeded
spec:
  backoffLimit: 3
  template:
    metadata: { labels: { app: prism-migrate } }
    spec:
      serviceAccountName: prism-control
      imagePullSecrets: 
        - name: ghcr-secret
      automountServiceAccountToken: false
      securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, seccompProfile: { type: RuntimeDefault } }
      restartPolicy: OnFailure
      initContainers:
        - name: bootstrap-database-roles
          image: "ghcr.io/datrab/kubeclaw-prism-control@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          imagePullPolicy: IfNotPresent
          command: ["node", "--experimental-strip-types", "skills/prism/server/bootstrap-database.ts"]
          env:
            - name: ADMIN_DATABASE_URL
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: admin-url } }
            - name: PRISM_RUNTIME_PASSWORD
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: runtime-password } }
            - name: PRISM_MIGRATOR_PASSWORD
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: migrator-password } }
            - name: PRISM_READONLY_PASSWORD
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: readonly-password } }
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
          resources: { requests: { cpu: 100m, memory: 128Mi }, limits: { cpu: "1", memory: 512Mi } }
          volumeMounts:
            - { name: tmp, mountPath: /tmp }
      containers:
        - name: migrate
          image: "ghcr.io/datrab/kubeclaw-prism-control@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          imagePullPolicy: IfNotPresent
          command: ["node", "--experimental-strip-types", "skills/prism/server/migrate.ts"]
          env:
            - name: DATABASE_URL
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: migrator-url } }
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
          resources: { requests: { cpu: 100m, memory: 128Mi }, limits: { cpu: "1", memory: 1Gi } }
          volumeMounts:
            - { name: tmp, mountPath: /tmp }
      volumes:
        - name: tmp
          emptyDir:
            sizeLimit: 256Mi
