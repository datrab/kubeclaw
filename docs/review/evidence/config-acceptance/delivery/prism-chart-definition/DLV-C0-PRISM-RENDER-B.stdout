apiVersion: apps/v1
kind: Deployment
metadata:
  name: prism-control
  annotations:
    argocd.argoproj.io/sync-wave: "2"
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector: { matchLabels: { app: prism-control } }
  template:
    metadata:
      labels:
        app: prism-control
      annotations:
        checksum/swarm-config: 289a7254ea6ba5e2a276fb8c9a5de93362dffdb8be8235c01740746b4308a88f
    spec:
      serviceAccountName: prism-control
      imagePullSecrets: 
        - name: ghcr-secret
      automountServiceAccountToken: false
      # The Prism images use the named `node` image user. Kubernetes cannot prove
      # that a named image user is non-root when runAsNonRoot is set, so make the
      # image's numeric runtime identity explicit for every Prism application pod.
      securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: { type: RuntimeDefault } }
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector: { matchLabels: { app: prism-control } }
      containers:
        - name: control
          image: "ghcr.io/datrab/kubeclaw-prism-control@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          imagePullPolicy: IfNotPresent
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
          env:
            - { name: PRISM_ENGINE_CONTENT_DIGEST, value: "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }
            - { name: SWARM_CONFIG, value: /etc/kubeclaw/swarm/swarm.config.json }
            - name: PRISM_WORKER_SECRET
              valueFrom: { secretKeyRef: { name: prism-runtime, key: worker-secret } }
            
            - name: DATABASE_URL
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: runtime-url } }
            - name: PRISM_SESSION_SECRET
              valueFrom: { secretKeyRef: { name: prism-runtime, key: session-secret } }
            - name: PRISM_INGRESS_SECRET
              valueFrom: { secretKeyRef: { name: prism-runtime, key: ingress-secret } }
            - name: PRISM_DISPATCH_SECRET
              valueFrom: { secretKeyRef: { name: prism-runtime, key: dispatch-secret } }
            - { name: PRISM_INGESTION_URL, value: "http://prism-ingestion:8080" }
            - name: PRISM_INGESTION_SECRET
              valueFrom: { secretKeyRef: { name: prism-runtime, key: ingestion-secret } }
          resources: 
            limits:
              cpu: "4"
              memory: 4Gi
            requests:
              cpu: 500m
              memory: 1Gi
          volumeMounts:
            - { name: tmp, mountPath: /tmp }
            - { name: swarm-config, mountPath: /etc/kubeclaw/swarm, readOnly: true }
            - { name: artifacts, mountPath: "/var/lib/prism/artifacts" }
          readinessProbe: { httpGet: { path: "/ready", port: 8080 }, initialDelaySeconds: 3 }
          livenessProbe: { httpGet: { path: /health, port: 8080 }, initialDelaySeconds: 10 }
      volumes:
        - { name: tmp, emptyDir: { sizeLimit: 4Gi } }
        - { name: swarm-config, configMap: { name: prism-swarm-config, defaultMode: 0444 } }
        - { name: artifacts, persistentVolumeClaim: { claimName: prism-artifacts } }
