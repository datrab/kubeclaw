# Source: prism/templates/workloads.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prism-worker
  annotations:
    argocd.argoproj.io/sync-wave: "2"
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector: { matchLabels: { app: prism-worker } }
  template:
    metadata:
      labels:
        app: prism-worker
      annotations:
        checksum/swarm-config: 289a7254ea6ba5e2a276fb8c9a5de93362dffdb8be8235c01740746b4308a88f
        kubeclaw.dev/native-worker-role: prism
        kubeclaw.dev/native-worker-policy: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    spec:
      serviceAccountName: prism-worker
      terminationGracePeriodSeconds: 150
      imagePullSecrets: 
        - name: ghcr-secret
      automountServiceAccountToken: false
      # The Prism images use the named `node` image user. Kubernetes cannot prove
      # that a named image user is non-root when runAsNonRoot is set, so make the
      # image's numeric runtime identity explicit for every Prism application pod.
      securityContext: { runAsNonRoot: false, runAsUser: 0, runAsGroup: 0, seccompProfile: { type: RuntimeDefault } }
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchFields:
                  - { key: metadata.name, operator: In, values: ["native-render-test"] }
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector: { matchLabels: { app: prism-worker } }
      containers:
        - name: worker
          image: "ghcr.io/datrab/kubeclaw-prism-worker@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          imagePullPolicy: IfNotPresent
          command: ["node", "skills/prism/server/worker.ts"]
          securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"], add: ["SETUID", "SETGID", "KILL"] } }
          env:
            - { name: PRISM_ENGINE_CONTENT_DIGEST, value: "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }
            - { name: SWARM_CONFIG, value: /etc/kubeclaw/swarm/swarm.config.json }
            - name: PRISM_WORKER_SECRET
              valueFrom: { secretKeyRef: { name: prism-runtime, key: worker-secret } }
            - { name: PRISM_CONTROL_INTERNAL_URL, value: "http://prism-control:8080" }
            - name: DATABASE_URL
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: runtime-url } }
          resources: 
            limits:
              cpu: "8"
              memory: 8Gi
            requests:
              cpu: "1"
              memory: 2Gi
          volumeMounts:
            - { name: tmp, mountPath: /tmp }
            - { name: swarm-config, mountPath: /etc/kubeclaw/swarm, readOnly: true }
            - { name: native-pool, mountPath: /sys/fs/cgroup/kubeclaw.slice/kubeclaw-native-pools.service/prism }
            - { name: native-ownership, mountPath: /var/lib/kubeclaw/native/prism }
            - { name: native-policy, mountPath: /etc/kubeclaw/prism-pool.json, readOnly: true }
            - { name: native-node-identity, mountPath: /etc/kubeclaw/native-node-id, readOnly: true }
            - { name: native-runtime-identity, mountPath: /etc/kubeclaw/native-runtime-identity.json, readOnly: true }
          # The migration is a post-install hook. On the first install the worker
          # must become ready before that hook can create its nonce table.
          readinessProbe: { httpGet: { path: "/bootstrap", port: 8080 }, initialDelaySeconds: 3 }
          livenessProbe: { httpGet: { path: /health, port: 8080 }, initialDelaySeconds: 10 }
      volumes:
        - { name: tmp, emptyDir: { sizeLimit: 4Gi } }
        - { name: swarm-config, configMap: { name: prism-swarm-config, defaultMode: 0444 } }
        - { name: native-pool, hostPath: { path: /sys/fs/cgroup/kubeclaw.slice/kubeclaw-native-pools.service/prism, type: Directory } }
        - { name: native-ownership, hostPath: { path: /var/lib/kubeclaw/native/prism, type: Directory } }
        - { name: native-policy, hostPath: { path: /etc/kubeclaw/prism-pool.json, type: File } }
        - { name: native-node-identity, hostPath: { path: /etc/kubeclaw/native-node-id, type: File } }
        - { name: native-runtime-identity, hostPath: { path: /etc/kubeclaw/native-runtime-identity.json, type: File } }
---
