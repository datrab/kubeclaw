apiVersion: apps/v1
kind: StatefulSet
metadata: { name: prism-postgresql }
spec:
  serviceName: prism-postgresql
  replicas: 1
  selector: { matchLabels: { app: prism-postgresql } }
  template:
    metadata: { labels: { app: prism-postgresql } }
    spec:
      imagePullSecrets: 
        - name: ghcr-secret
      automountServiceAccountToken: false
      securityContext: { runAsNonRoot: true, runAsUser: 999, runAsGroup: 999, fsGroup: 999, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: postgresql
          image: "pgvector/pgvector:pg17@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f"
          env:
            - { name: POSTGRES_DB, value: prism }
            - { name: POSTGRES_USER, value: postgres }
            # The fsGroup can make the PVC mount writable, but PostgreSQL
            # requires PGDATA itself to be owned by its runtime UID. The
            # non-root entrypoint creates this child directory as UID 999.
            - { name: PGDATA, value: /var/lib/postgresql/data/pgdata }
            - name: POSTGRES_PASSWORD
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: password } }
            - name: PRISM_RUNTIME_PASSWORD
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: runtime-password } }
            - name: PRISM_MIGRATOR_PASSWORD
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: migrator-password } }
            - name: PRISM_READONLY_PASSWORD
              valueFrom: { secretKeyRef: { name: prism-postgresql-auth, key: readonly-password } }
          readinessProbe: { exec: { command: ["pg_isready", "-U", "postgres", "-d", "prism"] }, initialDelaySeconds: 5 }
          livenessProbe: { exec: { command: ["pg_isready", "-U", "postgres", "-d", "prism"] }, initialDelaySeconds: 20 }
          securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: ["ALL"] } }
          resources: 
            limits:
              cpu: "4"
              memory: 8Gi
            requests:
              cpu: 500m
              memory: 1Gi
          volumeMounts:
            - { name: data, mountPath: /var/lib/postgresql/data }
            - { name: init, mountPath: /docker-entrypoint-initdb.d/010-prism-roles.sh, subPath: 010-prism-roles.sh, readOnly: true }
      volumes:
        - { name: init, configMap: { name: prism-postgresql-init, defaultMode: 365 } }
  volumeClaimTemplates:
    - metadata:
        name: data
        annotations:
          argocd.argoproj.io/sync-options: Prune=false,Delete=false
      spec:
        accessModes: [ReadWriteOnce]
        resources: { requests: { storage: 100Gi } }
