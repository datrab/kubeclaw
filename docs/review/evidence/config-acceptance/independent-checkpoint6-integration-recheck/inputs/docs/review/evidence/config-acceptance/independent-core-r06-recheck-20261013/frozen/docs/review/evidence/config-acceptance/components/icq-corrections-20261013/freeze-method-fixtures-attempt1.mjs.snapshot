import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import assert from 'node:assert/strict';import crypto from 'node:crypto';import {canonicalJson,producerRecordDigest} from '@kubeclaw/pipeline-observability-contract';import {FileProducerOutbox,FileObservabilityAdmissionStore} from '../../../../../skills/common/plugin-runtime/foundation/observability/durable-delivery.ts';
const dir='docs/review/evidence/config-acceptance/components/icq-corrections-20261013';const root=fs.mkdtempSync(path.join(os.tmpdir(),'icq-definition-only-'));const write=(n,x)=>fs.writeFileSync(dir+'/'+n,JSON.stringify(x,null,2)+'\n');const hash=x=>crypto.createHash('sha256').update(x).digest('hex');const freeze=(name,state)=>{const bytes=canonicalJson(state);fs.writeFileSync(dir+'/'+name,bytes);return{path:dir+'/'+name,sha256:hash(bytes),sizeBytes:Buffer.byteLength(bytes)};};
try{
const witness=JSON.parse(fs.readFileSync('docs/review/evidence/config-acceptance/independent-core-source-question-bce3f075-20261013/outbox-positive-witness.log'));const unsigned=witness.exactUnsignedRecord;const record={...unsigned,recordDigest:producerRecordDigest(unsigned)};const outbox=new FileProducerOutbox(root+'/outbox',{maximumRecords:3,maximumBytes:2048});const produced=await outbox.append(unsigned);assert.deepEqual(produced,record);const prior=fs.readFileSync(root+'/outbox/outbox.json');assert.equal(prior.length,1223);const before=freeze('outbox-pending-state.json',JSON.parse(prior));const pending=await outbox.pending();assert.equal(pending.length,1);const ack={schemaVersion:'admission-acknowledgement.v1',recordId:record.recordId,producer:record.producer,pipelineRunId:'run:1',sequence:1,state:'admitted',admittedAt:'2026-08-09T12:00:01Z',canonicalCursor:1,recordDigest:record.recordDigest};await outbox.acknowledge(ack);const acknowledged=freeze('outbox-acknowledged-state.json',JSON.parse(fs.readFileSync(root+'/outbox/outbox.json')));assert.equal(await outbox.compact(),1);const compacted=freeze('outbox-compacted-state.json',JSON.parse(fs.readFileSync(root+'/outbox/outbox.json')));
const oversized=Buffer.concat([prior,Buffer.alloc(2049-prior.length,32)]);fs.writeFileSync(dir+'/outbox-oversized-2049.bytes',oversized);
write('outbox-method-fixtures.json',{corrects:'ICQ-04',supersedesSelected1024Positive:true,existingQuota:2048,maximumRecords:3,exactUnsignedRecord:unsigned,exactRecord:record,exactAcknowledgement:ack,wholeStateBytes:1223,positive:[{method:'append',prior:'absent file/EMPTY_OUTBOX',input:unsigned,expectedState:before},{method:'pending',prior:before,input:[],expectedRecords:[record],expectedStateUnchanged:before},{method:'acknowledge',prior:before,input:ack,expectedState:acknowledged},{method:'compact',prior:acknowledged,input:[],return:1,expectedState:compacted}],negative:['append','pending','acknowledge','compact'].map(method=>({method,prior:{path:dir+'/outbox-oversized-2049.bytes',sha256:hash(oversized),sizeBytes:2049},input:method==='append'?unsigned:method==='acknowledge'?ack:[],expected:'OBSERVABILITY_REPLAY_INVALID:snapshot-size at bounded reader; no parse/mutation; exact bytes/hash unchanged',requireIndependentFreshCopy:true})),historical1024:{fixtureBytes:1223,expected:'OBSERVABILITY_OUTBOX_FULL',notClaimed:'No assertion every smaller valid record cannot fit'},observedCurrentPositiveControls:4,futureBoundedReadNegatives:'not implemented/not run; current four readers still omit cap'});
const limits={maximumIngressBytes:10000,maximumRecords:10,maximumBytes:100000,maximumQuarantineRecords:1,maximumQuarantineBytes:10000};const admission=new FileObservabilityAdmissionStore(root+'/admission',limits);await admission.admit(canonicalJson(record));const normal=JSON.parse(fs.readFileSync(root+'/admission/admission.json'));const normalRef=freeze('admission-normal-current-state.json',normal);await assert.rejects(admission.admit(canonicalJson(record)+'\n'));const quarantine=JSON.parse(fs.readFileSync(root+'/admission/admission.json'));const quarantineRef=freeze('admission-quarantine-current-state.json',quarantine);await assert.rejects(admission.admit(canonicalJson(record)+'  '));const overflow=JSON.parse(fs.readFileSync(root+'/admission/admission.json'));const overflowRef=freeze('admission-overflow-current-state.json',overflow);const gap={schemaVersion:'producer-gap-report.v1',producer:record.producer,pipelineRunId:'run:1',fromSequence:2,toSequence:2,state:'missing',reportedAt:'2026-08-09T12:01:00Z',reasonCode:'delivery-gap'};await admission.recordGap(gap);const gapRef=freeze('admission-gap-current-state.json',JSON.parse(fs.readFileSync(root+'/admission/admission.json')));
const binding=JSON.parse(fs.readFileSync(dir+'/serialization-envelope-contract.json')).inlineBinding;const states={empty:{schemaVersion:'observability-admission-store.v1',nextCursor:1,entries:[],quarantine:[],quarantineOverflow:null,gaps:[],unresolvedItems:[],overflowUnresolvedItems:[]},normal,quarantine,overflow};const refs={};for(const [name,state]of Object.entries(states))refs[name]=freeze('admission-'+name+'-bound-target-state.json',{...state,inlineBinding:binding});
const empty=states.empty;const normalDelta=Buffer.byteLength(canonicalJson(normal))-Buffer.byteLength(canonicalJson(empty));const quarantineDelta=Buffer.byteLength(canonicalJson(quarantine))-Buffer.byteLength(canonicalJson(normal));const overflowDelta=Buffer.byteLength(canonicalJson(overflow))-Buffer.byteLength(canonicalJson(quarantine));
write('admission-method-fixtures.json',{corrects:'ICQ-06',scope:'Exact captured current states/inputs plus proposed bound state projections; target consumers not executed',policy:{reserve:8192,threshold:256,prefix:180,quarantineCount:1,maximumRecords:10,maximumIngressBytes:10000},rawRecord:record,exactRawCanonical:canonicalJson(record),gap,observedCurrentStates:{normal:normalRef,quarantine:quarantineRef,overflow:overflowRef,gap:gapRef},targetStates:refs,subcases:[{id:'normal-admit',method:'admit',prior:refs.empty,input:canonicalJson(record),candidate:refs.normal,wholeCapFormula:'candidate.sizeBytes+8192',negativeCapFormula:'candidate.sizeBytes+8192-1',oracle:{cursor:1,nextCursor:2,entries:1,quarantine:0,bytes:refs.normal.sizeBytes},adjacentNegative:'FULL state/hash unchanged, no ack'},{id:'normal-admitAndRead',method:'admitAndRead',prior:refs.empty,input:canonicalJson(record),candidate:refs.normal,wholeCapFormula:'candidate.sizeBytes+8192',negativeCapFormula:'candidate.sizeBytes+8192-1',oracle:{records:[record],cursor:1,bytes:refs.normal.sizeBytes}},{id:'duplicate',method:'admit',prior:refs.normal,input:canonicalJson(record),wholeCapFormula:'prior.sizeBytes+8192',oracle:'duplicate cursor1; whole state/hash exactunchanged; no entry/nextCursor increment'},{id:'quarantine',method:'admit',prior:refs.normal,input:canonicalJson(record)+'\n',candidate:refs.quarantine,wholeCapFormula:'candidate.sizeBytes+8192',negativeCapFormula:'candidate.sizeBytes+8192-1',oracle:'decodererror remains; accepted quarantine one attributed unresolved item; returnedUUID/time controlled by exact specimen clock/UUID allocator in future harness, not production override; insufficient headroom falls into explicitly accounted overflow, not lostattribution'},{id:'overflow',method:'admit',prior:refs.quarantine,input:canonicalJson(record)+'  ',candidate:refs.overflow,wholeCapFormula:'candidate.sizeBytes',negativeCapFormula:'candidate.sizeBytes-1',oracle:'decodererror+overflow count1 andoneoverflowUnresolvedItem, total<=wholecap; adjacent negative FULL unchanged'},{id:'recordGap',method:'recordGap',prior:refs.normal,input:gap,candidateFormula:'{...prior,gaps:[exact gap]} canonical bytes',wholeCapFormula:'candidate.sizeBytes+8192',negativeCapFormula:'candidate.sizeBytes+8192-1',oracle:'newgap consumes ordinary payload, must preserve8192 reserve under target; wholecap-only CURRENT guard insufficient; adjacent negative FULL unchanged'},{id:'gap-restoration-unproved',method:'recordGap',priorFormula:'{...normalBoundState,gaps:[exactgap]}',input:{...gap,state:'restored',reportedAt:'2026-08-09T12:02:00Z'},oracle:'GAP_RESTORATION_UNPROVED exactstateunchanged because sequence2 absent'},{id:'oversized-history',method:'snapshot/admittedRecords/admit/recordGap',prior:refs.normal,mutation:'appendspaces to selected wholeCap+1, independently per method',oracle:'bounded replay snapshot-size rejects exactbytesunchanged; no shrink/latest substitution'},{id:'counter-overflow',method:'admit oversized ingress',priorFormula:'{...overflowBoundState,quarantineOverflow:{...original,count:9007199254740991}}',input:'x'.repeat(10001),oracle:'target rejects safe increment before any rewrite; exactstateunchanged, original1024/history retained'}],deltas:{normalDelta,quarantineDelta,overflowDelta},futureHeader:'inlineBinding v1 fixedschema accounted; newfield/version reject before allocation/write',retirement:'exact immutable source/argument generator and complete binding cases in retirement-method-fixtures.json'});
write('safe-current-method-controls.json',{passed:8,failed:0,actualConsumer:'FileProducerOutbox four methods + FileObservabilityAdmissionStore normal/quarantine/overflow/gap',outputs:['outbox-method-fixtures.json','admission-method-fixtures.json'],claim:'Current local disposable fixture observations only; not proposed reserve/header/readcap projection or F-MUT/F-EFFECT'});console.log(JSON.stringify({passed:8,outboxBytes:1223,cap:2048,ackBytes:acknowledged.sizeBytes,compactedBytes:compacted.sizeBytes,normalBytes:normalRef.sizeBytes,quarantineBytes:quarantineRef.sizeBytes,overflowBytes:overflowRef.sizeBytes}));
}finally{fs.rmSync(root,{recursive:true,force:true});}
