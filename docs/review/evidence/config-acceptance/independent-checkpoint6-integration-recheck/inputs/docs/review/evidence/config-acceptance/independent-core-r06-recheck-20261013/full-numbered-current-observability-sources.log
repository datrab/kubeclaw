138:     return {...metadata,result:resolveResult(item,record)};
139:   });
140:   const decoded=raw.schemaVersion==='durable-attempt-store.v3'?decodeClosures(raw.closures,projections):{closures:raw.closures,closureProjections:new Map()};
141:   const state:DurableAttemptStoreSnapshot={...raw,schemaVersion:'durable-attempt-store.v1',results,closures:decoded.closures};
142:   assertAttemptReplay(state,root,limits,projections.size,decoded.closureProjections.size);
143:   return {state,projections,closureProjections:decoded.closureProjections};
