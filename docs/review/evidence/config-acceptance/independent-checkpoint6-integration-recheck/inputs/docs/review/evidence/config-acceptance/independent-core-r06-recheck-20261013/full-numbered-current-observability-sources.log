333: export class FileProducerOutbox {
334:   readonly #file: string;
335:   readonly #limits: ProducerOutboxLimits;
336:   #queue: Promise<unknown> = Promise.resolve();
337:   constructor(directory: string, limits: ProducerOutboxLimits) {
338:     if (!validLimit(limits.maximumRecords) || !validLimit(limits.maximumBytes))
339:       throw new Error("OBSERVABILITY_OUTBOX_LIMIT_INVALID");
340:     this.#file = path.join(directory, "outbox.json");
341:     this.#limits = limits;
342:   }
343:   #serial<T>(operation: () => Promise<T>): Promise<T> {
344:     const locked = () => withDurableStoreLock(this.#file, operation);
345:     const result = this.#queue.then(locked, locked);
346:     this.#queue = result.then(
347:       () => undefined,
348:       () => undefined,
349:     );
350:     return result;
351:   }
352:   async append(
353:     unsigned: Omit<ProducerRecordV1, "recordDigest"> | ProducerRecordV1,
354:   ): Promise<ProducerRecordV1> {
355:     const input = structuredClone(unsigned);
356:     const candidateRecord = {
357:       ...input,
358:       recordDigest: producerRecordDigest(input as ProducerRecordV1),
359:     } as ProducerRecordV1;
360:     const bytes = canonicalJson(candidateRecord);
361:     const record = decodePipelineObservabilityContract(
362:       "producerRecord",
363:       bytes,
364:     ) as ProducerRecordV1;
365:     return this.#serial(async () => {
366:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
367:       const key = keyOf(record);
368:       const existing = state.entries.find(
369:         (entry) => keyOf(entry.record) === key,
370:       );
371:       if (existing) {
372:         if (existing.record.recordDigest !== record.recordDigest)
373:           throw new Error("OBSERVABILITY_OUTBOX_IDENTITY_CONFLICT");
374:         return structuredClone(existing.record);
375:       }
376:       const candidate = {
377:         ...state,
378:         entries: [
379:           ...state.entries,
380:           { record, bytes, acknowledged: false, canonicalCursor: null },
381:         ],
382:       };
383:       if (
384:         state.entries.length >= this.#limits.maximumRecords ||
385:         Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes
386:       )
387:         throw new Error("OBSERVABILITY_OUTBOX_FULL");
388:       await writeDurableState(this.#file, candidate);
389:       return structuredClone(record);
390:     });
391:   }
392:   async pending(): Promise<ReadonlyArray<OutboxEntry>> {
393:     return this.#serial(async () => {
394:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
395:       return state.entries
396:         .filter((entry) => !entry.acknowledged)
397:         .sort((left, right) => left.record.sequence - right.record.sequence);
398:     });
399:   }
400:   async acknowledge(ack: AdmissionAcknowledgementV1): Promise<void> {
401:     validatePipelineObservabilityContract("admissionAcknowledgement", ack);
402:     const snapshot = JSON.parse(
403:       canonicalJson(ack),
404:     ) as AdmissionAcknowledgementV1;
405:     await this.#serial(async () => {
406:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
407:       const entry = state.entries.find(
408:         (candidate) =>
409:           candidate.record.recordId === snapshot.recordId &&
410:           keyOf(candidate.record) ===
411:             [
412:               snapshot.producer.producerId,
413:               snapshot.producer.bootId,
414:               snapshot.producer.producerType,
415:               snapshot.pipelineRunId,
416:               String(snapshot.sequence),
417:             ].join("|"),
418:       );
419:       if (
420:         !entry ||
421:         entry.record.recordDigest !== snapshot.recordDigest ||
422:         entry.record.producer.producerType !== snapshot.producer.producerType
423:       )
424:         throw new Error("OBSERVABILITY_ACK_MISMATCH");
425:       entry.acknowledged = true;
426:       entry.canonicalCursor = snapshot.canonicalCursor;
427:       await writeDurableState(this.#file, state);
428:     });
429:   }
430:   async compact(): Promise<number> {
431:     return this.#serial(async () => {
432:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
433:       const before = state.entries.length;
434:       state.entries = state.entries.filter((entry) => !entry.acknowledged);
435:       await writeDurableState(this.#file, state);
436:       return before - state.entries.length;
437:     });
438:   }
439: }
