25: export async function storeResult(
26:   store: AttemptState,
27:   pipelineRunId: string,
28:   result: WorkerAttemptResultV1,
29:   completionIntent: DurableCompletionIntent | null = null,
30:   owner: DurableResultOwner | null = null,
31: ): Promise<DurableResultMetadata> {
32:   requireIdentity(pipelineRunId, "OBSERVABILITY_PIPELINE_RUN_ID_INVALID");
33:   const snapshot = structuredClone(result);
34:   const intent = structuredClone(completionIntent);
35:   const ownerSnapshot = structuredClone(owner);
36:   if (ownerSnapshot) {
37:     requireIdentity(ownerSnapshot.planId, "OBSERVABILITY_PLAN_ID_INVALID");
38:     requireIdentity(ownerSnapshot.nodeId, "OBSERVABILITY_NODE_ID_INVALID");
39:   }
40:   validatePipelineWorkerCoreContract("workerAttemptResult", snapshot);
41:   assertCompletionIntent(pipelineRunId, snapshot, intent);
42:   return store.serial(async () => {
43:     const state = await store.readState();
44:     await store.reclaimExpiredEvidence(state);
45:     await cleanupUnreferencedBlobs(store.root, state);
46:     const existing = findResult(state, pipelineRunId, snapshot);
47:     if (existing)
48:       return resumeResultCommit(
49:         store,
50:         state,
51:         existing,
52:         snapshot,
53:         intent,
54:         ownerSnapshot,
55:       );
56:     requireUnfinalizedAttempt(state, pipelineRunId, snapshot);
57:     await verifyResultEvidence(state, pipelineRunId, snapshot);
58:     return commitResult(
59:       store,
60:       state,
61:       pipelineRunId,
62:       snapshot,
63:       intent,
64:       ownerSnapshot,
65:     );
66:   });
67: }
68: export async function resumeCompletion(
69:   store: AttemptState,
70:   pipelineRunId: string,
71:   attemptId: string,
72:   claimGeneration: number,
73:   admission: FileObservabilityAdmissionStore,
74: ): Promise<ProducerClosureV1> {
75:   return store.serial(async () => {
76:     const state = await store.readState();
77:     await store.reclaimExpiredEvidence(state);
78:     if (
79:       state.results.some(
80:         (item) =>
81:           item.pipelineRunId === pipelineRunId &&
82:           item.attemptId === attemptId &&
83:           item.claimGeneration > claimGeneration,
84:       )
85:     )
86:       throw new Error("OBSERVABILITY_STALE_CLAIM_COMPLETION");
87:     const stored = state.results.find(
88:       (item) =>
89:         item.pipelineRunId === pipelineRunId &&
90:         item.attemptId === attemptId &&
91:         item.claimGeneration === claimGeneration,
92:     );
93:     if (!stored?.completionIntent)
94:       throw new Error("OBSERVABILITY_COMPLETION_INTENT_MISSING");
95:     if (typeof stored.storedAt !== "string")
96:       throw new Error("OBSERVABILITY_RESULT_COMMIT_PENDING");
97:     const { records: admitted } = await admission.admitAndRead(
98:       canonicalJson(stored.completionIntent.record),
99:     );
100:     return storeClosureUnlocked(
101:       store,
102:       state,
103:       stored.completionIntent.closure,
104:       admitted,
105:     );
106:   });
107: }
