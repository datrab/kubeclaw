82: /** Owner holds Run mutation ownership. This operation then holds Wait → Delivery. */
83: export async function projectWaitValue(store: FileDurableRecordStore, deliveries: FileDurableRecordStore,
84:   deliveryStream: string, intentInput: WaitProjectionIntent, authorityDigest: string, resolve: RetainedWaitResolver,
85:   authorize: (waits: readonly DurableRecord[], receipts: readonly DurableRecord[]) => void,
86: ): Promise<{ newlyProjected: boolean; releasedBytes: number }> {
87:   const intent = structuredClone(intentInput);
88:   assertWaitProjectionIntent(intent);
89:   if (!digest(authorityDigest) || !deliveryStream.startsWith('notifications/')) fail();
90:   const original = (await store.read<Payload>('waits/all')).find(record => record.idempotencyKey === intent.source.effectKey);
91:   if (!original) fail();
92:   const resolved = resolveWaitValue(original, resolve);
93:   if (payloadDigest(resolved) !== intent.source.originalPayloadDigest) fail();
94:   if (original.payload.schemaVersion === 'wait-value-projected.v1') {
95:     return store.withRetainedRecords<Payload, { newlyProjected: boolean; releasedBytes: number }>('waits/all',
96:       deliveries, deliveryStream, async (waits, receipts) => {
97:         const current = waits.find(record => record.idempotencyKey === intent.source.effectKey);
98:         if (!current || current.payload.schemaVersion !== 'wait-value-projected.v1') fail();
99:         resolveWaitValue(current, resolve);
100:         const value = current.payload as unknown as WaitValueProjection;
101:         if (payloadDigest(value.projection.intent) !== payloadDigest(intent) || value.projection.authorityDigest !== authorityDigest) fail();
102:         if (authorize(waits, receipts) !== undefined) fail();
103:         return { newlyProjected: false, releasedBytes: 0 };
104:       });
105:   }
106:   if (original.payloadDigest !== intent.source.originalPayloadDigest) fail();
107:   const value: WaitValueProjection = { schemaVersion: 'wait-value-projected.v1', originalDigest: original.payloadDigest,
108:     source: intent.source, projection: { schemaVersion: 'wait-value-projection-receipt.v1', intent,
109:       intentDigest: payloadDigest(intent), authorityDigest, releasedBytesHex: '0000000000000000' } };
110:   const replacement = { ...original, committedAt: '2000-01-01T00:00:00.000Z', payloadDigest: payloadDigest(value), payload: value };
111:   const releasedBytes = Buffer.byteLength(canonicalJson(original)) - Buffer.byteLength(canonicalJson(replacement));
112:   if (releasedBytes < 1) throw new Error('WAIT_PROJECTION_NO_NET_SAVINGS');
113:   const retained = { ...value, projection: { ...value.projection, releasedBytesHex: releasedBytes.toString(16).padStart(16, '0') } };
114:   await store.transitionWithRetainedStore('waits/all', intent.source.effectKey, original.payloadDigest, retained,
115:     deliveries, deliveryStream, (waits, receipts) => {
116:       if (payloadDigest(resolve(intent.source)) !== payloadDigest(resolved.wait)) fail();
117:       if (authorize(waits, receipts) !== undefined) fail();
118:     });
119:   return { newlyProjected: true, releasedBytes };
120: }