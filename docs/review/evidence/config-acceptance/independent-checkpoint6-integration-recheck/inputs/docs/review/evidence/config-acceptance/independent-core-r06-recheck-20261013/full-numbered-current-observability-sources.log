18: export interface WaitValueProjection {
19:   readonly schemaVersion: 'wait-value-projected.v1';
20:   readonly originalDigest: string;
21:   readonly source: RetainedWaitSource;
22:   readonly projection: {
23:     readonly schemaVersion: 'wait-value-projection-receipt.v1';
24:     readonly intent: WaitProjectionIntent;
25:     readonly intentDigest: string;
26:     readonly authorityDigest: string;
27:     readonly releasedBytesHex: string;
28:   };
