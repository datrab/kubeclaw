48: /** Existing store only: no await may split a journal-fenced validation/commit. */
49: export function replaceAttemptProjectionSync(file:string,value:PersistedAttempt):void {
50:   replayAssert(fs.realpathSync(file)===file&&fs.lstatSync(file).isFile(),'attempt-store-path');
51:   const directory=path.dirname(file),temporary=`${file}.${process.pid}.${randomUUID()}.tmp`;
52:   let renamed=false;
53:   try {
54:     const fd=fs.openSync(temporary,fs.constants.O_WRONLY|fs.constants.O_CREAT|fs.constants.O_EXCL|fs.constants.O_NOFOLLOW,0o600);
55:     try {fs.writeFileSync(fd,canonicalJson(value));fs.fsyncSync(fd);} finally {fs.closeSync(fd);}
56:     fs.renameSync(temporary,file);renamed=true;
57:     const dir=fs.openSync(directory,fs.constants.O_RDONLY|fs.constants.O_DIRECTORY|fs.constants.O_NOFOLLOW);
58:     try {fs.fsyncSync(dir);} finally {fs.closeSync(dir);}
59:   } finally {if(!renamed)removeUncommittedFile(temporary);}
60: }
