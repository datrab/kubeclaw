31:   for (const field of ['pipelineRunId', 'attemptId', 'evidenceId', 'type', 'mediaType'] as const) replayAssert(replayIdentity(item[field]), `attempt-evidence-${field}`);
32:   replayAssert(Number.isSafeInteger(item.claimGeneration) && item.claimGeneration > 0 && replayTimestamp(item.stagedAt), 'attempt-evidence-generation');
33:   validatePipelineObservabilityContract('producerIdentity', item.producer);
34:   validatePipelineWorkerCoreContract('workerEvidenceRef', { evidenceId: item.evidenceId, type: item.type, artifact: item.artifact });
35:   const hex = item.artifact.contentDigest.slice(7);
36:   replayAssert(item.artifact.artifactId === `artifact:${hex}` && item.artifact.type === item.type && item.artifact.mediaType === item.mediaType
37:     && item.artifact.storageUrl === pathToFileURL(path.join(root, 'blobs', hex.slice(0, 2), hex)).href, 'attempt-evidence-artifact');
38:   replayUnique(keys, evidenceKey(item), 'attempt-evidence-duplicate');
