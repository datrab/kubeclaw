49: /** Atomic source snapshots are immutable for this result identity. No nested store lock. */
50: async function readRetirementBytes(file:string,maximumBytes:number):Promise<Buffer> {
51:   replayAssert(await fs.realpath(file)===file,'admission-retirement-source-path');
52:   const handle=await fs.open(file,constants.O_RDONLY|constants.O_NOFOLLOW|constants.O_NONBLOCK);
53:   let bytes:Buffer;
54:   try {
55:     const stat=await handle.stat();
56:     replayAssert(stat.isFile() && stat.size<=maximumBytes,'admission-retirement-source-size');
57:     bytes=Buffer.alloc(stat.size);let offset=0;
58:     while(offset<bytes.length){const read=await handle.read(bytes,offset,bytes.length-offset,offset);replayAssert(read.bytesRead>0,'admission-retirement-source-truncated');offset+=read.bytesRead;}
59:     replayAssert((await handle.read(Buffer.alloc(1),0,1,offset)).bytesRead===0,'admission-retirement-source-grew');
60:   } finally {await handle.close();}
61:   replayAssert(await fs.realpath(file)===file,'admission-retirement-source-path');
62:   return bytes;
63: }
64: async function readSource(s:AdmissionCompletionReference):Promise<DurableAttemptStoreSnapshot> {
65:   const state=JSON.parse((await readRetirementBytes(s.file,s.maximumBytes)).toString()) as PersistedAttempt;
66:   return decodeAttemptState(state,path.dirname(s.file),{
67:     maximumEvidenceObjects:Number.MAX_SAFE_INTEGER,maximumEvidenceBytes:Number.MAX_SAFE_INTEGER,
68:     maximumEvidenceObjectBytes:Number.MAX_SAFE_INTEGER,maximumResults:Number.MAX_SAFE_INTEGER,
69:     maximumClosures:Number.MAX_SAFE_INTEGER,maximumMetadataBytes:s.maximumBytes,maximumPendingEvidenceAgeMs:Number.MAX_SAFE_INTEGER,
70:   }).state;
71: }
72: export function resolveAdmissionRetiredSnapshot(entry:AdmissionRetiredEntry,state:DurableAttemptStoreSnapshot):AdmittedRecordView {
73:   assertAdmissionRetiredEntry(entry);
74:   const s=entry.source;
75:   const result=state.results.find(item=>item.pipelineRunId===s.pipelineRunId && item.attemptId===s.attemptId && item.claimGeneration===s.claimGeneration);
76:   replayAssert(result?.storedAt && result.planId===s.planId && result.nodeId===s.nodeId && result.result.resultDigest===s.resultDigest,'admission-retirement-source-result');
77:   const intent=result.completionIntent;
78:   replayAssert(intent && intent.closure.closureDigest===s.closureDigest && state.closures.some(item=>canonicalJson(item)===canonicalJson(intent.closure)),'admission-retirement-source-closure');
79:   const record=intent.record,a=entry.acknowledgement;
80:   replayAssert(record.recordDigest===a.recordDigest && record.recordId===a.recordId && canonicalJson(record.producer)===canonicalJson(a.producer)
81:     && record.sequence===a.sequence && record.correlation.pipelineRunId===a.pipelineRunId,'admission-retirement-source-record');
82:   return {record:structuredClone(record),canonicalCursor:a.canonicalCursor,admittedAt:a.admittedAt};
83: }
