37: export function assertRetainedWaitSource(source: RetainedWaitSource): void {
38:   if (!shape(source, 'effectKey,effectsDigest,effectsPrefixBytes,eventsDigest,eventsPrefixBytes,inventoryLimits,originalPayloadDigest,rootIdentityDigest,runId,runJournalHead,schemaVersion,signalsDigest,signalsPrefixBytes,snapshotDigest,waitId')
39:     || source.schemaVersion !== 'retained-core-wait-source.v1'
40:     || ![source.runId, source.effectKey, source.waitId].every(id)
41:     || ![source.eventsDigest, source.effectsDigest, source.originalPayloadDigest, source.rootIdentityDigest, source.runJournalHead,
42:       source.signalsDigest, source.snapshotDigest].every(digest)
43:     || ![source.eventsPrefixBytes, source.effectsPrefixBytes, source.signalsPrefixBytes].every(value => Number.isSafeInteger(value) && value > 0)
44:     || !shape(source.inventoryLimits, 'maximumFiles,maximumSnapshotBytes,maximumTotalBytes')
45:     || !Object.values(source.inventoryLimits).every(value => Number.isSafeInteger(value) && value > 0)
46:     || source.waitId !== `wait:${crypto.createHash('sha256').update(source.effectKey).digest('hex')}`) fail();
47: }
48: export function assertWaitProjectionIntent(intent: WaitProjectionIntent): void {
49:   if (!shape(intent, 'actor,deliveryRoot,operationId,operatorEffectKey,source,terminalPayloadDigest,waitRoot')
50:     || ![intent.actor, intent.operationId, intent.operatorEffectKey].every(id)
51:     || !digest(intent.terminalPayloadDigest)
52:     || ![intent.waitRoot, intent.deliveryRoot].every(value => typeof value === 'string'
53:       && path.isAbsolute(value) && path.resolve(value) === value)
54:     || intent.waitRoot === intent.deliveryRoot) fail();
55:   assertRetainedWaitSource(intent.source);
56: }
57: export function assertWaitProjection(value: WaitValueProjection, key: string): void {
58:   if (!shape(value, 'originalDigest,projection,schemaVersion,source') || value.schemaVersion !== 'wait-value-projected.v1'
59:     || !shape(value.projection, 'authorityDigest,intent,intentDigest,releasedBytesHex,schemaVersion')) fail();
60:   assertRetainedWaitSource(value.source);
61:   const receipt = value.projection;
62:   assertWaitProjectionIntent(receipt.intent);
63:   if (receipt.schemaVersion !== 'wait-value-projection-receipt.v1' || !digest(receipt.authorityDigest)
64:     || receipt.intentDigest !== payloadDigest(receipt.intent) || payloadDigest(value.source) !== payloadDigest(receipt.intent.source)
65:     || value.originalDigest !== value.source.originalPayloadDigest || key !== value.source.effectKey
66:     || typeof receipt.releasedBytesHex !== 'string' || !/^[a-f0-9]{16}$/u.test(receipt.releasedBytesHex)
67:     || !Number.isSafeInteger(Number.parseInt(receipt.releasedBytesHex, 16))
68:     || Number.parseInt(receipt.releasedBytesHex, 16) < 1) fail();
69: }
70: /** Shared by the actual adapter and the operator authority reader. */
71: export function resolveWaitValue(record: DurableRecord<Payload>, resolve?: RetainedWaitResolver): { schemaVersion: 'wait-value.v1'; wait: WaitRequest } {
72:   if (record.payload.schemaVersion === 'wait-value.v1') return record.payload as { schemaVersion: 'wait-value.v1'; wait: WaitRequest };
73:   const value = record.payload as unknown as WaitValueProjection;
74:   assertWaitProjection(value, record.idempotencyKey);
75:   if (!resolve) fail();
76:   const wait = resolve(structuredClone(value.source));
77:   const original = { schemaVersion: 'wait-value.v1' as const, wait };
78:   if (wait.waitId !== value.source.waitId || payloadDigest(original) !== value.originalDigest) fail();
79:   return original;
80: }
