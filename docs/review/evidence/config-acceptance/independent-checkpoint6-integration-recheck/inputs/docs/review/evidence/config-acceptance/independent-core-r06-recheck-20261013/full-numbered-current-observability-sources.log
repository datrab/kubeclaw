146: export function encodeAttemptState(state:DurableAttemptStoreSnapshot,projections:AttemptProjections,closureProjections:ClosureProjections=new Map()):PersistedAttempt {
147:   if(!projections.size){replayAssert(!closureProjections.size,'closure-result-projection-required');return state;}
148:   let found=0;
149:   const results=state.results.map(item=>{
150:     const projected=projections.get(attemptProjectionKey(item));if(!projected)return item;
151:     const {result,...metadata}=item,{resultReference,...retained}=projected;
152:     replayAssert(result.resultDigest===resultReference.intent.resultDigest&&canonicalJson(metadata)===canonicalJson(retained),'attempt-projection-mutated');
153:     found++;return projected;
154:   });
155:   replayAssert(found===projections.size,'attempt-projection-removed');
156:   if(closureProjections.size)return {...state,schemaVersion:'durable-attempt-store.v3',results,closures:encodeClosures(state.closures,closureProjections,projections)};
157:   return {...state,schemaVersion:'durable-attempt-store.v2',results};
158: }
