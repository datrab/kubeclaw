SOURCE skills/common/plugin-runtime/foundation/observability/durable-blob-read.ts SHA256 5b736d337407890d27b547bc07bd514d378478589d4f56092ca9e5742fe2d285
1: import crypto from 'node:crypto';
2: import fs from 'node:fs/promises';
3: import { constants, type Stats } from 'node:fs';
4: import path from 'node:path';
5: 
6: const stamp = (value: Stats): string =>
7:   `${value.dev}:${value.ino}:${value.size}:${value.mtimeMs}:${value.ctimeMs}`;
8: 
9: async function statPath(file: string): Promise<Stats> {
10:   try { return await fs.lstat(file); }
11:   catch (error) {
12:     if ((error as NodeJS.ErrnoException).code === 'ENOENT') throw new Error('DURABLE_BLOB_NOT_FOUND');
13:     throw error;
14:   }
15: }
16: async function parentsOf(file: string): Promise<ReadonlyMap<string, string>> {
17:   const parents = new Map<string, string>();
18:   let directory = path.parse(file).root;
19:   for (const segment of path.dirname(file).slice(directory.length).split(path.sep).filter(Boolean)) {
20:     directory = path.join(directory, segment);
21:     const parent = await statPath(directory);
22:     if (!parent.isDirectory() || parent.isSymbolicLink()) throw new Error('DURABLE_BLOB_PATH_INVALID');
23:     parents.set(directory, `${parent.dev}:${parent.ino}`);
24:   }
25:   return parents;
26: }
27: async function verifyParents(parents: ReadonlyMap<string, string>): Promise<void> {
28:   // Observed identities reject changed/symlink parents, not race-proof path
29:   // confinement against an adversarial host.
30:   for (const [parentPath, identity] of parents) {
31:     const parent = await fs.lstat(parentPath);
32:     if (!parent.isDirectory() || parent.isSymbolicLink() || `${parent.dev}:${parent.ino}` !== identity) {
33:       throw new Error('DURABLE_BLOB_PATH_CHANGED');
34:     }
35:   }
36: }
37: async function boundedBytes(handle: Awaited<ReturnType<typeof fs.open>>, opened: Stats, maximum: number): Promise<Buffer> {
38:   if (!Number.isSafeInteger(opened.size) || opened.size < 0 || opened.size > maximum) {
39:     throw new Error('DURABLE_BLOB_SIZE_EXCEEDED');
40:   }
41:   const bounded = Buffer.alloc(opened.size + 1);
42:   let total = 0;
43:   while (total < bounded.byteLength) {
44:     const read = await handle.read(bounded, total, bounded.byteLength - total, total);
45:     if (!read.bytesRead) break;
46:     total += read.bytesRead;
47:   }
48:   if (total !== opened.size || stamp(await handle.stat()) !== stamp(opened)) throw new Error('DURABLE_BLOB_PATH_CHANGED');
49:   return bounded.subarray(0, total);
50: }
51: /** The original FileDurableBlobStore.get reader, factored only for readability. */
52: export async function readDurableBlob(file: string, digest: string, maximum: number): Promise<Buffer> {
53:   const parents = await parentsOf(file), stat = await statPath(file);
54:   if (!stat.isFile() || stat.isSymbolicLink()) throw new Error('DURABLE_BLOB_PATH_INVALID');
55:   const handle = await fs.open(file, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
56:   try {
57:     const opened = await handle.stat();
58:     if (!opened.isFile() || stamp(opened) !== stamp(stat)) throw new Error('DURABLE_BLOB_PATH_CHANGED');
59:     const bytes = await boundedBytes(handle, opened, maximum);
60:     if (stamp(await fs.lstat(file)) !== stamp(opened)) throw new Error('DURABLE_BLOB_PATH_CHANGED');
61:     await verifyParents(parents);
62:     if (`sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}` !== digest) {
63:       throw new Error('DURABLE_BLOB_INTEGRITY_FAILED');
64:     }
65:     return bytes;
66:   } finally { await handle.close(); }
67: }
SOURCE skills/common/plugin-runtime/foundation/observability/durable-blobs.ts SHA256 5e1af13ee56ba905355f7f84e58b25d6a8ea5a1c7e77f5863a1a1ad18506c2ea
1: import crypto from 'node:crypto';
2: import fs from 'node:fs/promises';
3: import path from 'node:path';
4: import { readDurableBlob } from './durable-blob-read.ts';
5: import { ensureDirectoryDurable, withDurableStoreLock } from './durable-delivery.ts';
6: 
7: export interface DurableBlobStore {
8:   put(bytes: Uint8Array): Promise<{
9:     readonly digest: string;
10:     readonly sizeBytes: number;
11:   }>;
12:   get(digest: string): Promise<Buffer>;
13: }
14: 
15: const DIGEST = /^sha256:[a-f0-9]{64}$/;
16: 
17: function positiveInteger(value: number, code: string): void {
18:   if (!Number.isSafeInteger(value) || value < 1) throw new Error(code);
19: }
20: 
21: async function syncDirectory(directory: string): Promise<void> {
22:   const handle = await fs.open(directory, "r");
23:   try { await handle.sync(); } finally { await handle.close(); }
24: }
25: 
26: export class FileDurableBlobStore implements DurableBlobStore {
27:   readonly #root: string;
28:   readonly #maximumBytes: number;
29:   readonly #maximumTotalBytes: number | undefined;
30: 
31:   constructor(root: string, maximumBytes: number, maximumTotalBytes?: number) {
32:     positiveInteger(maximumBytes, "DURABLE_BLOB_LIMIT_INVALID");
33:     if (maximumTotalBytes !== undefined) positiveInteger(maximumTotalBytes, "DURABLE_BLOB_TOTAL_LIMIT_INVALID");
34:     this.#maximumTotalBytes = maximumTotalBytes;
35:     this.#root = path.resolve(root);
36:     this.#maximumBytes = maximumBytes;
37:   }
38: 
39:   #path(digest: string): string {
40:     if (!DIGEST.test(digest)) throw new Error("DURABLE_BLOB_DIGEST_INVALID");
41:     const hash = digest.slice("sha256:".length);
42:     return path.join(this.#root, "blobs", "sha256", hash.slice(0, 2), hash.slice(2));
43:   }
44: 
45:   async put(input: Uint8Array): Promise<{ readonly digest: string; readonly sizeBytes: number }> {
46:     if (this.#maximumTotalBytes === undefined) return this.#put(input);
47:     await ensureDirectoryDurable(this.#root);
48:     return withDurableStoreLock(path.join(this.#root, 'blob-budget'), () => this.#put(input));
49:   }
50: 
51:   async #usedBytes(directory: string): Promise<number> {
52:     let entries;
53:     try { entries = await fs.readdir(directory, { withFileTypes: true }); }
54:     catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return 0; throw error; }
55:     let total = 0;
56:     for (const entry of entries) {
57:       const file = path.join(directory, entry.name);
58:       if (entry.isSymbolicLink()) throw new Error('DURABLE_BLOB_PATH_INVALID');
59:       if (entry.isDirectory()) total += await this.#usedBytes(file);
60:       else if (entry.isFile()) total += (await fs.lstat(file)).size;
61:       else throw new Error('DURABLE_BLOB_PATH_INVALID');
62:       if (!Number.isSafeInteger(total) || total > this.#maximumTotalBytes!) throw new Error('DURABLE_BLOB_STORE_LIMIT_EXCEEDED');
63:     }
64:     return total;
65:   }
66: 
67:   async #put(input: Uint8Array): Promise<{ readonly digest: string; readonly sizeBytes: number }> {
68:     const bytes = Buffer.from(input);
69:     if (bytes.byteLength > this.#maximumBytes) throw new Error("DURABLE_BLOB_SIZE_EXCEEDED");
70:     const digest = `sha256:${crypto.createHash("sha256").update(bytes).digest("hex")}`;
71:     const file = this.#path(digest);
72:     try {
73:       const existing = await this.get(digest);
74:       if (!existing.equals(bytes)) throw new Error('DURABLE_BLOB_DIGEST_COLLISION');
75:       return { digest, sizeBytes: bytes.byteLength };
76:     } catch (error) {
77:       if (!(error instanceof Error) || error.message !== 'DURABLE_BLOB_NOT_FOUND') throw error;
78:     }
79:     if (this.#maximumTotalBytes !== undefined
80:       && await this.#usedBytes(path.join(this.#root, 'blobs')) + bytes.byteLength > this.#maximumTotalBytes) {
81:       throw new Error('DURABLE_BLOB_STORE_LIMIT_EXCEEDED');
82:     }
83:     await ensureDirectoryDurable(path.dirname(file));
84:     const temporary = `${file}.${process.pid}.${crypto.randomUUID()}.tmp`;
85:     try {
86:       const handle = await fs.open(temporary, "wx", 0o600);
87:       try { await handle.writeFile(bytes); await handle.sync(); } finally { await handle.close(); }
88:       try { await fs.link(temporary, file); }
89:       catch (error) {
90:         if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
91:         const stat = await fs.lstat(file);
92:         if (!stat.isFile() || stat.isSymbolicLink()) throw new Error("DURABLE_BLOB_PATH_INVALID");
93:         if (!Buffer.from(await fs.readFile(file)).equals(bytes)) throw new Error("DURABLE_BLOB_DIGEST_COLLISION");
94:       }
95:       await syncDirectory(path.dirname(file));
96:     } finally {
97:       await fs.unlink(temporary).catch(() => undefined);
98:     }
99:     return { digest, sizeBytes: bytes.byteLength };
100:   }
101: 
102:   async get(digest: string): Promise<Buffer> {
103:     return readDurableBlob(this.#path(digest), digest, this.#maximumBytes);
104:   }
105: }
