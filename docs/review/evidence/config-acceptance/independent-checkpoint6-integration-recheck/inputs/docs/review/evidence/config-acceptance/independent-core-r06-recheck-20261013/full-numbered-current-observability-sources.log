49: export async function durableBlob(
50:   root: string,
51:   contentDigest: string,
52:   bytes: Uint8Array,
53: ): Promise<string> {
54:   const hex = contentDigest.slice("sha256:".length);
55:   const directory = path.join(root, "blobs", hex.slice(0, 2));
56:   const staging = path.join(root, "staging");
57:   await ensureDirectoryDurable(directory);
58:   await ensureDirectoryDurable(staging);
59:   const destination = path.join(directory, hex);
60:   try {
61:     const existing = await fs.readFile(destination);
62:     if (digest(existing) !== contentDigest)
63:       throw new Error("OBSERVABILITY_EVIDENCE_DIGEST_CONFLICT");
64:     return destination;
65:   } catch (error) {
66:     if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
67:   }
68:   const temporary = path.join(staging, `${hex}.${randomUUID()}.tmp`);
69:   let renamed = false;
70:   try {
71:     const handle = await fs.open(temporary, "wx", 0o600);
72:     try {
73:       await handle.writeFile(bytes);
74:       await handle.sync();
75:     } finally {
76:       await handle.close();
77:     }
78:     await fs.rename(temporary, destination);
79:     renamed = true;
80:     await syncDirectory(directory);
81:     return destination;
82:   } finally {
83:     if (!renamed) await fs.unlink(temporary).catch(() => undefined);
84:   }
85: }
