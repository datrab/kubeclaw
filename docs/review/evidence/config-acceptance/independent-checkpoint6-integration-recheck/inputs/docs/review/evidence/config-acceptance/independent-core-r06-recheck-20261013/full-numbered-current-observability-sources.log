21: export interface DurableRecordStore {
22:   append<T>(stream: string, idempotencyKey: string, payload: T, owner?: string): Promise<{
23:     readonly appended: boolean;
24:     readonly record: DurableRecord<T>;
25:   }>;
26:   transition<T>(stream: string, idempotencyKey: string, expectedPayloadDigest: string, payload: T): Promise<DurableRecord<T>>;
