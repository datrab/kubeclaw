8: type Payload = Readonly<Record<string, unknown>>;
9: export interface WaitProjectionIntent {
10:   readonly operationId: string;
11:   readonly actor: string;
12:   readonly waitRoot: string;
13:   readonly deliveryRoot: string;
14:   readonly operatorEffectKey: string;
15:   readonly terminalPayloadDigest: string;
16:   readonly source: RetainedWaitSource;
