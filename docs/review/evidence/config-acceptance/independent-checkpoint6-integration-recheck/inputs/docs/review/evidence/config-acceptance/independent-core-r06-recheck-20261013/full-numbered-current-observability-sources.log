30: const digest = (value: unknown): value is string => typeof value === 'string' && /^sha256:[a-f0-9]{64}$/u.test(value);
31: const id = (value: unknown): value is string => typeof value === 'string' && value.length > 0 && value.length <= 256
32:   && !/[\u0000-\u001f\u007f]/u.test(value);
33: const shape = (value: unknown, keys: string): boolean => value !== null && typeof value === 'object'
34:   && !Array.isArray(value) && Object.keys(value).sort().join(',') === keys;
35: function fail(): never { throw new Error('WAIT_PROJECTION_AUTHORITY_REQUIRED'); }
