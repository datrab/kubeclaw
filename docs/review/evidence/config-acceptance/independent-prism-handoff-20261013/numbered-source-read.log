26: /** Reconstruct the original producer order so PostgreSQL jsonb reordering preserves historical digests. */
27: export function prismRequestDigest(operation: WorkerAttemptEnvelopeV1['operation'], inputDigest: string): string {
28:   const values = JSON.parse(canonicalJson(operation.values)) as typeof operation.values;
29:   const ordered = { contractId: operation.contractId, inputSchemaId: operation.inputSchemaId, inputSchemaDigest: operation.inputSchemaDigest,
30:     values: { operation: values.operation, inputName: values.inputName, ...values } };
31:   return sha256Digest(JSON.stringify({ operation: ordered, inputDigest }));
