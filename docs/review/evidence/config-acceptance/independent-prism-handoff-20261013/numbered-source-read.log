177:           connect_timeout: 0.25s
178:           http2_protocol_options: {}
179:           load_assignment: { cluster_name: spire-agent, endpoints: [{ lb_endpoints: [{ endpoint: { address: { pipe: { path: {{ .Values.workerTrust.spiffe.socketPath | quote }} } } } }] }] }
180:         - name: worker-local
181:           connect_timeout: 1s
182:           type: STATIC
183:           load_assignment: { cluster_name: worker-local, endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: 127.0.0.1, port_value: {{ (include "prism.swarmConfig" . | fromJson).operator.prism.worker.port | int }} } } } }] }] }
184:         - name: control-mtls
185:           connect_timeout: 3s
186:           type: STRICT_DNS
187:           load_assignment: { cluster_name: control-mtls, endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: prism-control-internal, port_value: 8443 } } } }] }] }
188:           transport_socket:
189:             name: envoy.transport_sockets.tls
190:             typed_config:
191:               "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
192:               common_tls_context:
193:                 tls_certificate_sds_secret_configs:
194:                   - name: default
195:                     sds_config:
196:                       resource_api_version: V3
197:                       api_config_source: { api_type: GRPC, transport_api_version: V3, grpc_services: [{ envoy_grpc: { cluster_name: spire-agent } }] }
198:                 combined_validation_context:
199:                   default_validation_context: { match_typed_subject_alt_names: [{ san_type: URI, matcher: { exact: {{ printf "spiffe://%s/ns/%s/sa/prism-control" $trustDomain $namespace | quote }} } }] }
200:                   validation_context_sds_secret_config:
201:                     name: {{ printf "spiffe://%s" $trustDomain | quote }}
202:                     sds_config:
203:                       resource_api_version: V3
204:                       api_config_source: { api_type: GRPC, transport_api_version: V3, grpc_services: [{ envoy_grpc: { cluster_name: spire-agent } }] }
205:   runner.yaml: |
206:     node: { id: {{ printf "prism-test-runner.%s" $namespace | quote }}, cluster: prism-test-runner }
207:     admin: { address: { socket_address: { address: 127.0.0.1, port_value: 9901 } } }
208:     static_resources:
209:       listeners:
210:         - name: control-egress
211:           address: { socket_address: { address: 127.0.0.1, port_value: 18443 } }
212:           filter_chains: [{ filters: [{ name: envoy.filters.network.tcp_proxy, typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy, stat_prefix: control-egress, cluster: control-mtls } }] }]
213:         - name: prism-agent-egress
214:           address: { socket_address: { address: 127.0.0.1, port_value: 18444 } }
215:           filter_chains: [{ filters: [{ name: envoy.filters.network.tcp_proxy, typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy, stat_prefix: prism-agent-egress, cluster: prism-agent-mtls } }] }]
216:       clusters:
217:         - name: spire-agent
218:           connect_timeout: 0.25s
219:           http2_protocol_options: {}
220:           load_assignment: { cluster_name: spire-agent, endpoints: [{ lb_endpoints: [{ endpoint: { address: { pipe: { path: {{ .Values.workerTrust.spiffe.socketPath | quote }} } } } }] }] }
221:         - name: control-mtls
222:           connect_timeout: 3s
223:           type: STRICT_DNS
224:           load_assignment: { cluster_name: control-mtls, endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: prism-control-internal, port_value: 8443 } } } }] }] }
225:           transport_socket:
226:             name: envoy.transport_sockets.tls
227:             typed_config:
228:               "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
229:               common_tls_context:
230:                 tls_certificate_sds_secret_configs:
231:                   - name: default
232:                     sds_config:
233:                       resource_api_version: V3
234:                       api_config_source: { api_type: GRPC, transport_api_version: V3, grpc_services: [{ envoy_grpc: { cluster_name: spire-agent } }] }
235:                 combined_validation_context:
236:                   default_validation_context: { match_typed_subject_alt_names: [{ san_type: URI, matcher: { exact: {{ printf "spiffe://%s/ns/%s/sa/prism-control" $trustDomain $namespace | quote }} } }] }
237:                   validation_context_sds_secret_config:
238:                     name: {{ printf "spiffe://%s" $trustDomain | quote }}
239:                     sds_config:
240:                       resource_api_version: V3
241:                       api_config_source: { api_type: GRPC, transport_api_version: V3, grpc_services: [{ envoy_grpc: { cluster_name: spire-agent } }] }
242:         - name: prism-agent-mtls
243:           connect_timeout: 3s
244:           type: STRICT_DNS
245:           load_assignment: { cluster_name: prism-agent-mtls, endpoints: [{ lb_endpoints: [{ endpoint: { address: { socket_address: { address: agent-prism, port_value: 8080 } } } }] }] }
246:           transport_socket:
