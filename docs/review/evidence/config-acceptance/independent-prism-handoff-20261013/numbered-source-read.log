{"path": "skills/prism/server/direction-routes.ts", "sha256": "91e731766e8da39e82ce264dba3f9d904fdf77b211e480a3f56365aeef166812"}
1: import { type IncomingMessage, type ServerResponse } from "node:http";
2: import { admitDesignAgent, agentReceipt } from "../control/agent-admission.ts";
3: import { agentJob } from "../control/agent-jobs.ts";
4: import { startDesignRound } from "../control/design-generations.ts";
5: import {
6:   decideDirection,
7:   directionIdempotencyKey,
8: } from "../control/direction-decisions.ts";
9: 
10: import type { AuthenticatedControlContext } from "./control-context.ts";
11: import { body, json, userKey } from "./control-http.ts";
12: type RouteContext = Pick<
13:   AuthenticatedControlContext,
14:   "pool" | "actor" | "config"
15: >;
16: 
17: export async function directionRoutes(
18:   context: RouteContext,
19:   request: IncomingMessage,
20:   response: ServerResponse,
21:   url: URL,
22: ): Promise<boolean> {
23:   const directions = /^\/v1\/projects\/([0-9a-f-]+)\/directions$/.exec(
24:     url.pathname,
25:   );
26:   if (directions && request.method === "GET") {
27:     await listDirections(context, response, directions);
28:     return true;
29:   }
30:   if (directions && request.method === "POST") {
31:     await startDirectionRound(context, request, response, directions);
32:     return true;
33:   }
34:   const directionFeedback = /^\/v1\/directions\/([0-9a-f-]+)\/feedback$/.exec(
35:     url.pathname,
36:   );
37:   if (directionFeedback && request.method === "POST") {
38:     await recordDirectionFeedback(
39:       context,
40:       request,
41:       response,
42:       directionFeedback,
43:     );
44:     return true;
45:   }
46:   const selectDirection = /^\/v1\/directions\/([0-9a-f-]+)\/select$/.exec(
47:     url.pathname,
48:   );
49:   if (selectDirection && request.method === "POST") {
50:     await selectDesignDirection(context, request, response, selectDirection);
51:     return true;
52:   }
53:   return false;
54: }
55: async function listDirections(
56:   context: RouteContext,
57:   response: ServerResponse,
58:   directions: RegExpExecArray,
59: ) {
60:   const { pool } = context;
61: 
62:   const activeJob = await pool.query<{ id: string }>(
63:     "SELECT j.id FROM prism.agent_job j JOIN prism.design_request r ON r.current_round_id=j.id WHERE r.project_id=$1 AND r.status='active'",
64:     [directions[1]],
65:   );
66:   if (activeJob.rows[0])
67:     agentReceipt(await agentJob(pool, activeJob.rows[0].id));
68:   const result = await pool.query(
69:     "SELECT d.id,doc.design_round_id AS generation_id,d.source_document_id,d.direction_key,d.title,d.summary,d.proposal,d.state,d.content_digest,d.evidence FROM prism.direction d JOIN prism.design_document doc ON doc.id=d.source_document_id JOIN prism.design_request r ON r.id=doc.design_request_id AND r.status='active' AND doc.design_round_id IS NOT DISTINCT FROM r.current_round_id WHERE d.project_id=$1 ORDER BY d.created_at,d.id",
70:     [directions[1]],
71:   );
72:   return json(response, 200, { items: result.rows });
73: }
74: async function startDirectionRound(
75:   context: RouteContext,
76:   request: IncomingMessage,
77:   response: ServerResponse,
78:   directions: RegExpExecArray,
79: ) {
80:   const { pool, actor } = context;
81:   const { trustedControlSpiffeId } = context.config;
82: 
83:   const input = (await body(request)) as {
84:     documentId?: string;
85:     expectedRevision?: number;
86:     parentRoundId?: string;
87:     idempotencyKey?: string;
88:   };
89:   if (
90:     !input.documentId ||
91:     !Number.isSafeInteger(input.expectedRevision) ||
92:     !input.idempotencyKey
93:   )
94:     throw new Error(
95:       "documentId, expectedRevision and idempotencyKey are required",
96:     );
97:   const project = await pool.query<{ external_id: string }>(
98:     "SELECT external_id FROM prism.project WHERE id=$1",
99:     [directions[1]],
100:   );
101:   const requestResult = await pool.query<{
102:     request: Record<string, unknown>;
103:     architecture_digest: string;
104:     architecture_revision: number;
105:   }>(
106:     "SELECT request,architecture_digest,architecture_revision FROM prism.design_request WHERE project_id=$1 AND status='active' ORDER BY created_at DESC LIMIT 1",
107:     [directions[1]],
108:   );
109:   if (!project.rows[0] || !requestResult.rows[0])
110:     throw new Error("active Prism project not found");
111:   const preferences = await startDesignRound(pool, {
112:     projectId: project.rows[0].external_id,
113:     subjectId: userKey(actor.user),
114:     startKey: `studio:${userKey(actor.user)}:${input.idempotencyKey}`,
115:     architectureDigest: requestResult.rows[0].architecture_digest,
116:     architectureRevision: Number(requestResult.rows[0].architecture_revision),
117:     parentRoundId: input.parentRoundId,
118:     documentId: input.documentId,
119:     expectedRevision: input.expectedRevision,
120:   });
121:   return json(
122:     response,
123:     202,
124:     await admitDesignAgent(
125:       pool,
126:       `${trustedControlSpiffeId}/prism/main/v2`,
127:       project.rows[0].external_id,
128:       preferences,
129:     ),
130:   );
131: }
132: async function recordDirectionFeedback(
133:   context: RouteContext,
134:   request: IncomingMessage,
135:   response: ServerResponse,
136:   directionFeedback: RegExpExecArray,
137: ) {
138:   const { pool, actor } = context;
139: 
140:   const input = (await body(request)) as {
141:     action?: "rejected" | "liked" | "disliked" | "preserved";
142:     trait?: string;
143:   };
144:   if (
145:     !input.action ||
146:     !["rejected", "liked", "disliked", "preserved"].includes(input.action)
147:   )
148:     throw new Error("supported direction feedback action is required");
149:   const result = await decideDirection(
150:     pool,
151:     userKey(actor.user),
152:     directionFeedback[1]!,
153:     directionIdempotencyKey(request.headers["idempotency-key"]),
154:     {
155:       action: input.action,
156:       ...(input.trait === undefined ? {} : { trait: input.trait }),
157:     },
158:   );
159:   return json(response, 201, result);
160: }
161: async function selectDesignDirection(
162:   context: RouteContext,
163:   request: IncomingMessage,
164:   response: ServerResponse,
165:   selectDirection: RegExpExecArray,
166: ) {
167:   const { pool, actor } = context;
168: 
169:   const input = (await body(request)) as { documentId?: string };
170:   if (!input.documentId) throw new Error("documentId is required");
171:   const result = await decideDirection(
172:     pool,
173:     userKey(actor.user),
174:     selectDirection[1]!,
175:     directionIdempotencyKey(request.headers["idempotency-key"]),
176:     { action: "selected", documentId: input.documentId },
177:   );
178:   return json(response, 200, result);
179: }
{"path": "skills/prism/server/dispatch-route.ts", "sha256": "407b0befbe8cbf6009f2cef6fe80ab10a2213258d4be5bddc578f24abdb47382"}
1: import { validatePrism } from "@kubeclaw/prism-contracts-v1";
2: import { authorizeProxiedSpiffePeer } from "@kubeclaw/worker-core";
3: import { createHmac, randomUUID, timingSafeEqual } from "node:crypto";
4: import { type IncomingMessage, type ServerResponse } from "node:http";
5: import { admitDesignAgent } from "../control/agent-admission.ts";
6: import {
7:   approvedRoundBaseline,
8:   assertArchitectureTransition,
9:   startDesignRound,
10: } from "../control/design-generations.ts";
11: import { authorizePipelinePreferenceSubject } from "../control/pipeline-preference-subject.ts";
12: import { inTransaction } from "../storage/index.ts";
13: 
14: import type { ControlContext } from "./control-context.ts";
15: import { json } from "./control-http.ts";
16: type RouteContext = Pick<ControlContext, "config" | "pool" | "artifacts">;
17: 
18: export async function dispatchRoute(
19:   context: RouteContext,
20:   request: IncomingMessage,
21:   response: ServerResponse,
22:   url: URL,
23: ): Promise<boolean> {
24:   if (url.pathname === "/v1/dispatch" && request.method === "POST") {
25:     await dispatchDesign(context, request, response);
26:     return true;
27:   }
28:   return false;
29: }
30: async function dispatchDesign(
31:   context: RouteContext,
32:   request: IncomingMessage,
33:   response: ServerResponse,
34: ) {
35:   const controlConfig = context.config;
36:   const { pool, artifacts } = context;
37:   const { trustedControlSpiffeId } = context.config;
38: 
39:   const { raw, key } = await authenticateDispatch(context.config, request);
40:   const payload = JSON.parse(raw.toString("utf8")) as DispatchPayload;
41:   const preferenceSubjectId = authorizePipelinePreferenceSubject(
42:     payload.preferenceSubjectId,
43:     controlConfig.pipelinePreferenceSubject,
44:   );
45:   const designRequest = validatePrism<DesignRequest>(
46:     "designRequest",
47:     payload.request,
48:   );
49:   const projectKey = designRequest.projectId;
50:   const project = await persistDesignRequest(pool, designRequest);
51:   if (!designRequest.approvalId) {
52:     const preferences = await startDesignRound(pool, {
53:       projectId: projectKey,
54:       subjectId: preferenceSubjectId,
55:       startKey: `dispatch:${key}`,
56:       architectureDigest: designRequest.architecture.contentDigest,
57:       architectureRevision: designRequest.architecture.revision,
58:     });
59:     const agent = await admitDesignAgent(
60:       pool,
61:       `${trustedControlSpiffeId}/prism/main/v2`,
62:       projectKey,
63:       preferences,
64:     );
65:     return json(response, 202, {
66:       result: { status: "waiting", projectId: project.rows[0]!.id },
67:       preferences,
68:       agent,
69:     });
70:   }
71:   const baseline = await approvedRoundBaseline(
72:     pool,
73:     project.rows[0]!.id,
74:     designRequest.approvalId,
75:   );
76:   if (!baseline.rows[0]) throw new Error("approved Prism baseline not found");
77:   return json(response, 200, {
78:     result: {
79:       bundleDigest: baseline.rows[0].bundle_digest,
80:       artifactId: baseline.rows[0].bundle_artifact_id,
81:       archiveBase64: Buffer.from(
82:         await artifacts.get(baseline.rows[0].bundle_artifact_id),
83:       ).toString("base64"),
84:     },
85:   });
86: }
87: 
88: async function authenticateDispatch(
89:   config: ControlContext["config"],
90:   request: IncomingMessage,
91: ) {
92:   const {
93:     spiffeEnabled,
94:     dispatchSecret,
95:     trustedNovaSpiffeId,
96:     trustedPrismAgentSpiffeId,
97:     trustedTestRunnerSpiffeId,
98:   } = config;
99:   if (spiffeEnabled) {
100:     try {
101:       authorizeProxiedSpiffePeer(
102:         request.headers,
103:         request.socket.remoteAddress,
104:         new Set(
105:           [
106:             trustedNovaSpiffeId,
107:             trustedPrismAgentSpiffeId,
108:             trustedTestRunnerSpiffeId,
109:           ].filter(Boolean),
110:         ),
111:       );
112:     } catch {
113:       throw new Error("invalid dispatch identity");
114:     }
115:   }
116:   if (
117:     !(request.headers["content-type"] ?? "")
118:       .toString()
119:       .toLowerCase()
120:       .startsWith("application/json")
121:   )
122:     throw new Error("application/json is required");
123:   const chunks: Buffer[] = [];
124:   let size = 0;
125:   for await (const chunk of request) {
126:     size += chunk.length;
127:     if (size > 2_000_000) throw new Error("request too large");
128:     chunks.push(chunk);
129:   }
130:   const raw = Buffer.concat(chunks);
131:   const key = String(request.headers["idempotency-key"] ?? "");
132:   if (!key) throw new Error("invalid dispatch idempotency key");
133:   if (!spiffeEnabled) {
134:     const supplied = String(
