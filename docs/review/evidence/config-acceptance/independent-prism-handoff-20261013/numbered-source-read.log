199: function busterPreparationSettingsFromConfig(value: unknown): BusterPreparationSettings {
200:   const settings = (value as SwarmConfig).operator.buster?.preparation;
201:   if (!settings) throw new Error('SWARM_CONFIG_BUSTER_PREPARATION_REQUIRED');
202:   return validateBusterPreparationSettings(settings);
203: }
