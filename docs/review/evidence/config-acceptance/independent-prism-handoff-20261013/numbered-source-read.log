{"path": "docker/Dockerfile.prism-studio", "sha256": "a2acdc718f9becd23c4f90bfc361c26115f67363677665248cc96647e7180d2f"}
1: # Version defaults are generated from versions.json; run npm run versions:sync.
2: ARG NODE_BASE=node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
3: FROM ${NODE_BASE} AS build
4: USER root
5: WORKDIR /build
6: COPY . /build
7: RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund \
8:  && npm run build:studio --prefix skills/prism \
9:  && npm prune --omit=dev --ignore-scripts
10: 
11: FROM ${NODE_BASE}
12: USER root
13: WORKDIR /app/prism
14: COPY --from=build /build/skills/prism/dist-studio /app/prism/skills/prism/dist-studio
15: COPY --from=build /build/skills/prism/server /app/prism/skills/prism/server
16: COPY --from=build /build/node_modules/ajv /app/prism/node_modules/ajv
17: COPY --from=build /build/node_modules/fast-deep-equal /app/prism/node_modules/fast-deep-equal
18: COPY --from=build /build/node_modules/fast-uri /app/prism/node_modules/fast-uri
19: COPY --from=build /build/node_modules/json-schema-traverse /app/prism/node_modules/json-schema-traverse
20: COPY --from=build /build/node_modules/require-from-string /app/prism/node_modules/require-from-string
21: COPY --from=build /build/skills/common/plugin-runtime/foundation/config /app/prism/skills/common/plugin-runtime/foundation/config
22: COPY --from=build /build/skills/prism/package.json /app/prism/skills/prism/package.json
23: RUN chown -R node:node /app/prism
24: USER node
25: ENV NODE_ENV=production STUDIO_ROOT=/app/prism/skills/prism/dist-studio
26: # Exercise the packaged service as its runtime user, without build dependencies.
27: RUN --mount=type=bind,source=skills/prism/tests/studio-service.test.mts,target=/app/prism/skills/prism/tests/studio-service.test.mts \
28:     --mount=type=bind,source=skills/prism/tests/fixtures/studio-service.mts,target=/app/prism/skills/prism/tests/fixtures/studio-service.mts \
29:     --mount=type=bind,source=skills/prism/tests/studio-canonical-image.mts,target=/app/prism/skills/prism/tests/studio-canonical-image.mts \
30:     --mount=type=bind,source=tests/fixtures/config/swarm-bundle.mjs,target=/app/prism/tests/fixtures/config/swarm-bundle.mjs \
31:     --mount=type=bind,source=charts/kubeclaw/files/config,target=/tmp/studio-authored \
32:     SWARM_CONFIG=/tmp/studio-authored/swarm.config.json node --test --test-concurrency=1 /app/prism/skills/prism/tests/studio-service.test.mts /app/prism/skills/prism/tests/studio-canonical-image.mts
33: EXPOSE 8080
34: CMD ["node","--experimental-strip-types","skills/prism/server/studio.ts"]
{"path": "docker/Dockerfile.prism-worker", "sha256": "820d8c1b9cb0784113fbd4c2ceb206b40cb0e2381d3fad3df647d7dcc784bb80"}
1: # Version defaults are generated from versions.json; run npm run versions:sync.
2: ARG NODE_BASE=node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
3: FROM ${NODE_BASE} AS native-launcher
4: ARG DEBIAN_SNAPSHOT=20260901T000000Z
5: USER root
6: RUN printf '%s\n' \
7:       'Types: deb' \
8:       "URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" \
9:       'Suites: bookworm bookworm-updates' \
10:       'Components: main' \
11:       'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
12:       '' \
13:       'Types: deb' \
14:       "URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" \
15:       'Suites: bookworm-security' \
16:       'Components: main' \
17:       'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
18:       > /etc/apt/sources.list.d/debian.sources \
19:  && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot \
20:  && apt-get update \
21:  && apt-get install -y --no-install-recommends gcc libc6-dev \
22:  && rm -rf /var/lib/apt/lists/*
23: COPY skills/worker/core/worker/native-worker-launcher.c /build/native-worker-launcher.c
24: RUN cc -std=c11 -O2 -Wall -Wextra -Werror -fstack-protector-strong -D_FORTIFY_SOURCE=3 \
25:       -fPIE -pie -Wl,-z,relro,-z,now /build/native-worker-launcher.c -o /native-worker-launcher \
26:  && chmod 0755 /native-worker-launcher
27: 
28: FROM ${NODE_BASE} AS build
29: USER root
30: WORKDIR /build
31: COPY . /build
32: RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund \
33:  && npm run typecheck --prefix skills/prism \
34:  && npm prune --omit=dev --ignore-scripts
35: 
36: FROM ${NODE_BASE}
37: ARG TARGETARCH
38: USER root
39: COPY --from=native-launcher /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list.d/debian.sources
40: COPY --from=native-launcher /etc/apt/apt.conf.d/99snapshot /etc/apt/apt.conf.d/99snapshot
41: WORKDIR /app/prism
42: COPY --from=build /build/node_modules /app/prism/node_modules
43: COPY --from=build /build/contracts /app/prism/contracts
44: COPY --from=build /build/skills/prism /app/prism/skills/prism
45: COPY --from=build /build/skills/worker/core /app/prism/skills/worker/core
46: COPY --from=build /build/skills/common/plugin-runtime /app/prism/skills/common/plugin-runtime
47: COPY --from=native-launcher /native-worker-launcher /usr/local/libexec/kubeclaw-native-worker-launcher
48: ENV PRISM_NATIVE_LAUNCHER=/usr/local/libexec/kubeclaw-native-worker-launcher \
49:     PRISM_NATIVE_POOL_POLICY_FILE=/etc/kubeclaw/prism-pool.json
50: COPY package-lock.json versions.json /app/prism/
51: COPY docker/browser-archives.lock.json /app/prism/docker/browser-archives.lock.json
52: COPY scripts/browser-archive-lock.mjs /app/prism/scripts/browser-archive-lock.mjs
53: ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
54: RUN rm -f /etc/apt/sources.list \
55:  && node ./node_modules/playwright/cli.js install-deps chromium \
56:  && node scripts/browser-archive-lock.mjs --install "$TARGETARCH" prism /ms-playwright \
57:  && test -d /ms-playwright \
58:  && chown -R node:node /app/prism /ms-playwright
59: USER node
60: ENV NODE_ENV=production
61: EXPOSE 8080
62: CMD ["node","--experimental-strip-types","skills/prism/server/worker.ts"]
