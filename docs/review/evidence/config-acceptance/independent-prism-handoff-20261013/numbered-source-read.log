22: export default function register(api) {
23:   api.registerTool({
24:     name: "prism_create_design_set",
25:     description: "Persist exactly three materially distinct, complete Prism design documents for one project. This tool must be called once for every new Nova architecture request.",
26:     parameters: {
27:       type: "object",
28:       additionalProperties: false,
29:       required: ["jobId", "fence", "generationId", "projectId", "designs"],
30:       properties: {
31:         jobId: { type: "string", format: "uuid" },
32:         fence: { type: "string", format: "uuid" },
33:         generationId: { type: "string", minLength: 1 },
34:         projectId: { type: "string", minLength: 1 },
35:         designs: {
36:           type: "array",
37:           minItems: 3,
38:           maxItems: 3,
39:           items: {
40:             type: "object",
41:             additionalProperties: false,
42:             required: ["key", "title", "summary", "document"],
43:             properties: {
44:               key: { type: "string", pattern: "^[a-z0-9][a-z0-9-]{1,62}$" },
45:               title: { type: "string", minLength: 1 },
46:               summary: { type: "string", minLength: 1 },
47:               document: documentSchema,
48:               evidence: { type: "object", additionalProperties: true }
49:             }
50:           }
51:         }
52:       }
53:     },
54:     async execute(_id, params, context) {
55:       return textResult(await post("/v1/agent/design-sets", params, context?.config));
56:     }
57:   });
58: 
