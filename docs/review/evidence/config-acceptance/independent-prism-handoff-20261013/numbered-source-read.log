10: async function post(path, payload, config) {
11:   const base = config?.controlUrl || process.env.PRISM_CONTROL_URL || "http://127.0.0.1:28080";
12:   const response = await fetch(new URL(path, base), {
13:     method: "POST",
14:     headers: { "content-type": "application/json" },
15:     body: JSON.stringify(payload),
16:   });
17:   const value = await response.json().catch(() => ({ error: `HTTP ${response.status}` }));
18:   if (!response.ok) throw new Error(value.error || `Prism control returned HTTP ${response.status}`);
19:   return value;
20: }
