{"path": "skills/prism/studio/design-round-client.ts", "sha256": "0a37517165fad75fd049dafc9a3519cbd8a7c0f2351c6adaeaab4c4fc2281f46"}
1: import {roundResponse,responseObject} from "./round-response.ts";
2: import type {PrismDocument} from '@kubeclaw/prism-contracts-v1';
3: export type StudioDirection={id:string;generation_id?:string;source_document_id?:string;title:string;summary:string;state:string;evidence?:{thesis?:string;tradeoffs?:string[];references?:Array<{id?:string;summary?:string}>}};
4: export type PendingRound={documentId:string;expectedRevision:number;parentRoundId?:string;idempotencyKey:string;generationId?:string};
5: export type RoundClient={projectId:string;userId:string;csrf:string;origin:string;storage:Pick<Storage,'getItem'|'setItem'|'removeItem'>};
6: const key=(client:RoundClient)=>`prism-round:${client.userId}:${client.projectId}`;
7: const route=(client:RoundClient,path:string)=>new URL(path,client.origin);
8: export function savedRound(client:RoundClient):PendingRound|null {
9:  const raw=client.storage.getItem(key(client));if(!raw)return null;
10:  const value=JSON.parse(raw) as PendingRound;
11:  if(!value.documentId || !Number.isSafeInteger(value.expectedRevision) || !value.idempotencyKey)throw new Error('Stored round request is invalid; it was retained for inspection');
12:  return value;
13: }
14: export function saveRound(client:RoundClient,pending:PendingRound){client.storage.setItem(key(client),JSON.stringify(pending));}
15: export function pendingRound(client:RoundClient,source:Omit<PendingRound,'idempotencyKey'|'generationId'>):PendingRound {
16:  const pending=savedRound(client) ?? {...source,idempotencyKey:crypto.randomUUID()};saveRound(client,pending);return pending;
17: }
18: export async function submitRound(client:RoundClient,pending:PendingRound) {
19:  const response=await fetch(route(client,`/v1/projects/${encodeURIComponent(client.projectId)}/directions`),{method:'POST',headers:{'content-type':'application/json','x-prism-csrf':client.csrf},body:JSON.stringify(pending)});
20:  const receipt=await roundResponse<{generationId:string}>(response,`Submit design round for project ${client.projectId}`,value=>responseObject(value)&&typeof value.generationId==='string'&&value.generationId.length>0,'a nonempty generationId');
21:  if(pending.generationId && pending.generationId!==receipt.generationId)throw new Error('Round identity changed unexpectedly');
22:  const accepted={...pending,generationId:receipt.generationId};saveRound(client,accepted);return accepted;
23: }
24: export async function currentDirections(client:RoundClient) {
25:  const response=await fetch(route(client,`/v1/projects/${encodeURIComponent(client.projectId)}/directions`));
26:  return (await roundResponse<{items:StudioDirection[]}>(response,`Load design directions for project ${client.projectId}`,value=>responseObject(value)&&Array.isArray(value.items)&&value.items.every(item=>responseObject(item)&&typeof item.id==='string'&&typeof item.state==='string'),'an items array of direction objects with id and state')).items;
27: }
28: export async function loadRoundDocument(client:RoundClient,directions:StudioDirection[],currentId?:string) {
29:  const documentId=directions.find(item=>item.source_document_id===currentId)?.source_document_id ?? directions[0]?.source_document_id;
30:  if(!documentId)throw new Error('Round document identity is missing');
31:  const response=await fetch(route(client,`/v1/documents/${encodeURIComponent(documentId)}`));
32:  const value=await roundResponse<{document:PrismDocument}>(response,`Load design document ${documentId}`,value=>responseObject(value)&&responseObject(value.document)&&responseObject(value.document.meta),'a document object with metadata');
33:  return {directions,documentId,document:value.document};
34: }
35: export function completeRound(client:RoundClient,directions:StudioDirection[]) {
36:  const pending=savedRound(client);
37:  if(!pending || !directions.length || !directions.every(item=>item.generation_id===pending.generationId))return false;
38:  client.storage.removeItem(key(client));return true;
39: }
40: export async function waitForRound(client:RoundClient,pending:PendingRound,attempts=30) {
41:  for(let attempt=0;attempt<attempts;attempt++){
42:   const directions=await currentDirections(client);
43:   if(directions.length && directions[0]?.generation_id!==pending.generationId)throw new Error('Pending round was superseded; the request key is retained');
44:   if(directions.length===3 && directions.every(item=>item.generation_id===pending.generationId)){
45:    const loaded=await loadRoundDocument(client,directions);completeRound(client,directions);return loaded;
46:   }
47:   if(attempt+1<attempts)await new Promise(resolve=>setTimeout(resolve,2000));
48:  }
49:  return null;
50: }
