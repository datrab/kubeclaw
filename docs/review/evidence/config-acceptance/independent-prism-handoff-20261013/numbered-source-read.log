{"path": "charts/prism/templates/workloads.yaml", "sha256": "e7a7cee020d5fd6823b5a63039a9ba2e924ed63363a7bb7bad1d51dd59722e20"}
1: {{- $swarm := include "prism.swarmConfig" . | fromJson }}
2: {{- $shutdownTimeoutMs := $swarm.operator.prism.worker.shutdownTimeoutMs }}
3: {{- if ne (int .Values.control.replicas) 1 }}
4: {{- fail "control.replicas must be 1 while prism-artifacts uses ReadWriteOnce storage" }}
5: {{- end }}
6: {{- include "prism.productDecisions.validate" . }}
7: {{- if or (ne (int .Values.worker.replicas) 1) (ne .Values.worker.native.namespace .Release.Namespace) (not .Values.worker.native.nodeName) (not (regexMatch "^[a-f0-9]{64}$" .Values.worker.native.policyDigest)) }}
8: {{- fail "native Prism requires one worker, its selected namespace/node and generated policy digest" }}
9: {{- end }}
10: {{- if or (le (int $shutdownTimeoutMs) (add (int $swarm.operator.prism.native.supervisor.closeTimeoutMs) (int $swarm.operator.prism.native.supervisor.drainTimeoutMs))) (le (mul (int .Values.worker.terminationGracePeriodSeconds) 1000) (int $shutdownTimeoutMs)) }}
11: {{- fail "worker shutdown must cover native close plus scope drain, and fit within pod termination grace" }}
12: {{- end }}
13: {{- range $name := list "control" "studio" "worker" }}
14: {{- $image := index $.Values.images $name }}
15: apiVersion: apps/v1
16: kind: Deployment
17: metadata:
18:   name: prism-{{ $name }}
19:   annotations:
20:     argocd.argoproj.io/sync-wave: "2"
21: spec:
22:   replicas: {{ (index $.Values $name).replicas }}
23:   {{- if or (eq $name "control") (eq $name "worker") }}
24:   strategy: { type: Recreate }
25:   {{- end }}
26:   selector: { matchLabels: { app: prism-{{ $name }} } }
27:   template:
28:     metadata:
29:       labels:
30:         app: prism-{{ $name }}
31:         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
32:         kubeclaw.dev/worker-trust: "true"
33:         {{- end }}
34:       {{- if or (and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker"))) (eq $name "control") (eq $name "worker") (eq $name "studio") }}
35:       annotations:
36:         {{- if has $name (list "control" "worker" "studio") }}
37:         checksum/swarm-config: {{ include "kubeclaw.swarmBundle" $ | sha256sum }}
38:         {{- end }}
39:         {{- if eq $name "worker" }}
40:         kubeclaw.dev/native-worker-role: prism
41:         kubeclaw.dev/native-worker-policy: {{ $.Values.worker.native.policyDigest | quote }}
42:         {{- end }}
43:         {{- if and (eq $name "control") $.Values.control.productDecisions.enabled }}
44:         checksum/product-decisions: {{ toJson $.Values.control.productDecisions | sha256sum }}
45:         {{- end }}
46:         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
47:         checksum/worker-trust: {{ index ((include (print $.Template.BasePath "/configmap-worker-trust.yaml") $) | fromYaml).data (printf "%s.yaml" $name) | sha256sum }}
48:         {{- end }}
49:       {{- end }}
50:     spec:
51:       serviceAccountName: prism-{{ $name }}
52:       {{- if eq $name "worker" }}
53:       terminationGracePeriodSeconds: {{ $.Values.worker.terminationGracePeriodSeconds }}
54:       {{- end }}
55:       imagePullSecrets: {{ toYaml $.Values.imagePullSecrets | nindent 8 }}
56:       automountServiceAccountToken: false
57:       # The Prism images use the named `node` image user. Kubernetes cannot prove
58:       # that a named image user is non-root when runAsNonRoot is set, so make the
59:       # image's numeric runtime identity explicit for every Prism application pod.
60:       {{- if eq $name "worker" }}
61:       securityContext: { runAsNonRoot: false, runAsUser: 0, runAsGroup: 0, seccompProfile: { type: RuntimeDefault } }
62:       affinity:
63:         nodeAffinity:
64:           requiredDuringSchedulingIgnoredDuringExecution:
65:             nodeSelectorTerms:
66:               - matchFields:
67:                   - { key: metadata.name, operator: In, values: [{{ $.Values.worker.native.nodeName | quote }}] }
68:       {{- else }}
69:       securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, fsGroup: 1000, seccompProfile: { type: RuntimeDefault } }
70:       {{- end }}
71:       topologySpreadConstraints:
72:         - maxSkew: 1
73:           topologyKey: kubernetes.io/hostname
74:           whenUnsatisfiable: ScheduleAnyway
75:           labelSelector: { matchLabels: { app: prism-{{ $name }} } }
76:       containers:
77:         - name: {{ $name }}
78:           image: {{ include "prism.imageRef" $image | quote }}
79:           imagePullPolicy: {{ $image.pullPolicy }}
80:           {{- if eq $name "worker" }}
81:           command: ["node", "skills/prism/server/worker.ts"]
82:           securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"], add: ["SETUID", "SETGID", "KILL"] } }
83:           {{- else }}
84:           securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
85:           {{- end }}
86:           env:
87:             {{- if or (eq $name "control") (eq $name "worker") }}
88:             - { name: PRISM_ENGINE_CONTENT_DIGEST, value: {{ $.Values.images.worker.digest | quote }} }
89:             {{- end }}
90:             - { name: SWARM_CONFIG, value: /etc/kubeclaw/swarm/swarm.config.json }
91:             {{- if and (or (eq $name "control") (eq $name "worker")) (not $.Values.workerTrust.spiffe.enabled) }}
92:             - name: PRISM_WORKER_SECRET
93:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: worker-secret } }
94:             {{- end }}
95:             {{- if eq $name "control" }}
96:             {{- include "prism.productDecisions.env" $ | nindent 12 }}
97:             {{- if $.Values.workerTrust.spiffe.enabled }}
98:             - { name: PRISM_WORKER_URL, value: "http://127.0.0.1:18081" }
99:             - { name: PRISM_CONTROL_INTERNAL_URL, value: "http://127.0.0.1:18080" }
100:             - { name: PRISM_AGENT_URL, value: "http://127.0.0.1:18082" }
101:             {{- end }}
102:             - name: DATABASE_URL
103:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.database }}, key: runtime-url } }
104:             - name: PRISM_SESSION_SECRET
105:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: session-secret } }
106:             - name: PRISM_INGRESS_SECRET
107:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: ingress-secret } }
108:             {{- if not $.Values.workerTrust.spiffe.enabled }}
109:             - name: PRISM_DISPATCH_SECRET
110:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: dispatch-secret } }
111:             {{- end }}
112:             - { name: PRISM_INGESTION_URL, value: "http://prism-ingestion:8080" }
113:             - name: PRISM_INGESTION_SECRET
114:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: ingestion-secret } }
115:             {{- end }}
116:             {{- if eq $name "studio" }}
117:             - name: PRISM_INGRESS_SECRET
118:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.runtime }}, key: ingress-secret } }
119:             {{- end }}
120:             {{- if eq $name "worker" }}
121:             - { name: PRISM_CONTROL_INTERNAL_URL, value: {{ ternary "http://127.0.0.1:18080" "http://prism-control:8080" $.Values.workerTrust.spiffe.enabled | quote }} }
122:             - name: DATABASE_URL
123:               valueFrom: { secretKeyRef: { name: {{ $.Values.secrets.database }}, key: runtime-url } }
124:             {{- end }}
125:             {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
126:             - { name: SPIFFE_ENDPOINT_SOCKET, value: {{ printf "unix://%s" $.Values.workerTrust.spiffe.socketPath | quote }} }
127:             - { name: WORKER_TRUST_SPIFFE_ENABLED, value: "true" }
128:             {{- if eq $name "control" }}
129:             - { name: PRISM_TRUSTED_NOVA_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/%s" $.Values.workerTrust.spiffe.trustDomain $.Values.workerTrust.spiffe.novaNamespace $.Values.workerTrust.spiffe.novaServiceAccount | quote }} }
130:             - { name: PRISM_TRUSTED_TEST_RUNNER_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/prism-test-runner" $.Values.workerTrust.spiffe.trustDomain $.Release.Namespace | quote }} }
131:             - { name: PRISM_TRUSTED_WORKER_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/prism-worker" $.Values.workerTrust.spiffe.trustDomain $.Release.Namespace | quote }} }
132:             - { name: PRISM_CONTROL_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/prism-control" $.Values.workerTrust.spiffe.trustDomain $.Release.Namespace | quote }} }
133:             - { name: PRISM_TRUSTED_AGENT_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/%s" $.Values.workerTrust.spiffe.trustDomain $.Values.workerTrust.spiffe.agentNamespace $.Values.workerTrust.spiffe.agentServiceAccount | quote }} }
134:             {{- else }}
135:             - { name: PRISM_TRUSTED_CONTROL_SPIFFE_ID, value: {{ printf "spiffe://%s/ns/%s/sa/prism-control" $.Values.workerTrust.spiffe.trustDomain $.Release.Namespace | quote }} }
136:             {{- end }}
137:             {{- end }}
138:           resources: {{ toYaml (index $.Values $name).resources | nindent 12 }}
139:           volumeMounts:
140:             - { name: tmp, mountPath: /tmp }
141:             {{- if has $name (list "control" "worker" "studio") }}
142:             - { name: swarm-config, mountPath: /etc/kubeclaw/swarm, readOnly: true }
143:             {{- end }}
144:             {{- if eq $name "worker" }}
145:             - { name: native-pool, mountPath: /sys/fs/cgroup/kubeclaw.slice/kubeclaw-native-pools.service/prism }
146:             - { name: native-ownership, mountPath: /var/lib/kubeclaw/native/prism }
147:             - { name: native-policy, mountPath: /etc/kubeclaw/prism-pool.json, readOnly: true }
148:             - { name: native-node-identity, mountPath: /etc/kubeclaw/native-node-id, readOnly: true }
149:             - { name: native-runtime-identity, mountPath: /etc/kubeclaw/native-runtime-identity.json, readOnly: true }
150:             {{- end }}
151:             {{- if eq $name "control" }}
152:             - { name: artifacts, mountPath: {{ $swarm.operator.prism.control.artifactRoot | quote }} }
153:             {{- if $.Values.control.productDecisions.enabled }}
154:             - { name: product-decision-signing, mountPath: /var/run/prism/product-signing, readOnly: true }
155:             - { name: product-decision-controller, mountPath: /var/run/prism/product-controller, readOnly: true }
156:             {{- end }}
157:             {{- end }}
158:           {{- if eq $name "worker" }}
159:           # The migration is a post-install hook. On the first install the worker
160:           # must become ready before that hook can create its nonce table.
161:           {{- end }}
162:           readinessProbe: { httpGet: { path: {{ ternary "/bootstrap" "/ready" (eq $name "worker") | quote }}, port: {{ ternary (int $swarm.operator.prism.control.port) (ternary (int $swarm.operator.prism.studio.port) (int $swarm.operator.prism.worker.port) (eq $name "studio")) (eq $name "control") }} }, initialDelaySeconds: 3 }
163:           livenessProbe: { httpGet: { path: /health, port: {{ ternary (int $swarm.operator.prism.control.port) (ternary (int $swarm.operator.prism.studio.port) (int $swarm.operator.prism.worker.port) (eq $name "studio")) (eq $name "control") }} }, initialDelaySeconds: 10 }
164:         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
165:         - name: worker-trust-proxy
166:           image: "{{ $.Values.workerTrust.spiffe.envoy.repository }}:{{ $.Values.workerTrust.spiffe.envoy.tag }}@{{ $.Values.workerTrust.spiffe.envoy.digest }}"
167:           imagePullPolicy: {{ $.Values.workerTrust.spiffe.envoy.pullPolicy }}
168:           args: ["-c", {{ printf "/etc/kubeclaw-worker-trust/%s.yaml" $name | quote }}, "--service-cluster", {{ printf "prism-%s" $name | quote }}]
169:           ports: [{ name: worker-trust, containerPort: 8443, protocol: TCP }, { name: envoy-health, containerPort: 19000, protocol: TCP }]
170:           startupProbe:
171:             httpGet: { path: /bootstrap, port: envoy-health }
172:             periodSeconds: 2
173:             failureThreshold: 30
174:             timeoutSeconds: 3
175:           readinessProbe:
176:             httpGet: { path: /ready, port: envoy-health }
177:             initialDelaySeconds: 3
178:             timeoutSeconds: 3
179:           livenessProbe:
180:             httpGet: { path: /health, port: envoy-health }
181:             initialDelaySeconds: 10
182:             timeoutSeconds: 3
183:           securityContext: { runAsNonRoot: true, runAsUser: 1000, runAsGroup: 1000, allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
184:           resources: {{ toYaml $.Values.workerTrust.spiffe.envoy.resources | nindent 12 }}
185:           volumeMounts:
186:             - { name: worker-trust-envoy, mountPath: /etc/kubeclaw-worker-trust, readOnly: true }
187:             - { name: spiffe-workload-api, mountPath: /run/spire/sockets, readOnly: true }
188:             - { name: worker-trust-tmp, mountPath: /tmp }
189:         {{- end }}
190:       volumes:
191:         - { name: tmp, emptyDir: { sizeLimit: 4Gi } }
192:         {{- if has $name (list "control" "worker" "studio") }}
193:         - { name: swarm-config, configMap: { name: prism-swarm-config, defaultMode: 0444 } }
194:         {{- end }}
195:         {{- if eq $name "worker" }}
196:         - { name: native-pool, hostPath: { path: /sys/fs/cgroup/kubeclaw.slice/kubeclaw-native-pools.service/prism, type: Directory } }
197:         - { name: native-ownership, hostPath: { path: /var/lib/kubeclaw/native/prism, type: Directory } }
198:         - { name: native-policy, hostPath: { path: /etc/kubeclaw/prism-pool.json, type: File } }
199:         - { name: native-node-identity, hostPath: { path: /etc/kubeclaw/native-node-id, type: File } }
200:         - { name: native-runtime-identity, hostPath: { path: /etc/kubeclaw/native-runtime-identity.json, type: File } }
201:         {{- end }}
202:         {{- if eq $name "control" }}
203:         - { name: artifacts, persistentVolumeClaim: { claimName: prism-artifacts } }
204:         {{- include "prism.productDecisions.volumes" $ | nindent 8 }}
205:         {{- end }}
206:         {{- if and $.Values.workerTrust.spiffe.enabled (or (eq $name "control") (eq $name "worker")) }}
207:         - { name: worker-trust-envoy, configMap: { name: prism-worker-trust, defaultMode: 0444 } }
208:         - name: spiffe-workload-api
209:           csi: { driver: {{ $.Values.workerTrust.spiffe.csiDriver | quote }}, readOnly: true }
210:         - { name: worker-trust-tmp, emptyDir: { sizeLimit: 64Mi } }
211:         {{- end }}
212: ---
213: {{- end }}
214: {{- range $name := list "studio" "worker" }}
215: apiVersion: policy/v1
216: kind: PodDisruptionBudget
217: metadata: { name: prism-{{ $name }} }
218: spec: { minAvailable: 1, selector: { matchLabels: { app: prism-{{ $name }} } } }
219: ---
220: {{- end }}
221: apiVersion: v1
222: kind: PersistentVolumeClaim
223: metadata:
224:   name: prism-artifacts
225:   annotations:
226:     helm.sh/resource-policy: keep
227:     argocd.argoproj.io/sync-options: Prune=false,Delete=false
228:     argocd.argoproj.io/sync-wave: "2"
229: spec:
230:   accessModes: [ReadWriteOnce]
231:   {{- if .Values.artifactStorage.storageClass }}
232:   storageClassName: {{ .Values.artifactStorage.storageClass | quote }}
233:   {{- end }}
234:   resources: { requests: { storage: {{ .Values.artifactStorage.storage }} } }
{"path": "charts/prism/values.yaml", "sha256": "8b13da5c725b9eff02d1e12dae6f799ca74a6b01a83cb714a2777a915e98cee8"}
1: busterComponentFile: files/config/buster-engine.config.json
2: images:
3:   control: { repository: ghcr.io/datrab/kubeclaw-prism-control, digest: "", pullPolicy: IfNotPresent }
4:   studio: { repository: ghcr.io/datrab/kubeclaw-prism-studio, digest: "", pullPolicy: IfNotPresent }
5:   worker: { repository: ghcr.io/datrab/kubeclaw-prism-worker, digest: "", pullPolicy: IfNotPresent }
6:   ingestion: { repository: ghcr.io/datrab/kubeclaw-prism-ingestion, digest: "", pullPolicy: IfNotPresent }
7: imagePullSecrets:
8:   - name: ghcr-secret
9: control:
10:   # Explicit human decision authority. No operator, issuer or endpoint is inferred.
11:   productDecisions:
12:     enabled: false
13:     issuer: ""
14:     operators: []
15:     origin: ""
16:     authorityRevision: ""
17:     signingSecretName: ""
18:     signingSecretKey: private-key.pem
19:     controllerUrl: ""
20:     controllerNamespace: ""
21:     controllerRelease: ""
22:     controllerCaSecretName: ""
23:     controllerCaSecretKey: ca.crt
24:     tokenAudience: ""
25:     tokenExpirationSeconds: 600
26:   replicas: 1
27:   resources: { requests: { cpu: 500m, memory: 1Gi }, limits: { cpu: "4", memory: 4Gi } }
28: studio:
29:   replicas: 1
30:   resources: { requests: { cpu: 250m, memory: 256Mi }, limits: { cpu: "2", memory: 1Gi } }
31: worker:
32:   # Required host binding for the sole native worker runtime.
33:   # Use the generated prism-native-values.yaml after host preflight.
34:   native:
35:     nodeName: ""
36:     namespace: ""
37:     policyDigest: ""
38:   terminationGracePeriodSeconds: 150
39:   replicas: 1
40:   resources: { requests: { cpu: "1", memory: 2Gi }, limits: { cpu: "8", memory: 8Gi } }
41: ingestion:
42:   enabled: false
43:   replicas: 1
44:   # Required operator sizing when enabled; no host capacity is assumed.
45:   resources:
46:     requests: { cpu: "", memory: "" }
47:     limits: { cpu: "", memory: "" }
48:   # Acquired quarantine content only; this does not expire logs or reports.
49:   quarantineTtlMs: 3600000
50: postgresql:
51:   enabled: true
52:   image: pgvector/pgvector:pg17@sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f
53:   storage: 100Gi
54:   storageClass: ""
55:   existingSecret: ""
56:   resources: { requests: { cpu: 500m, memory: 1Gi }, limits: { cpu: "4", memory: 8Gi } }
57: secrets:
58:   runtime: prism-runtime
59:   database: prism-postgresql-auth
60: artifactStorage: { storage: 100Gi, storageClass: "" }
61: backup:
62:   schedule: "0 2 * * *"
63:   verificationSchedule: "0 3 * * 0"
64:   databaseProofSchedule: "0 4 * * 0"
65:   # Local capacity ceilings; no automatic expiry. Independent off-host copies
66:   # and the complete external credential/journal recovery set remain required.
67:   maximumBytes: "85899345920"
68:   maximumRetainedBytes: "96636764160"
69:   maximumDurationSeconds: 3600
70:   resources: { requests: { cpu: 250m, memory: 256Mi }, limits: { cpu: "2", memory: 2Gi } }
71: tailscale: { enabled: true, hostname: prism-studio, operatorNamespace: tailscale }
72: workerTrust:
73:   spiffe:
74:     enabled: false
75:     trustDomain: kubeclaw.internal
76:     novaNamespace: kubeclaw
77:     novaServiceAccount: agent-nova
78:     agentNamespace: kubeclaw
79:     agentServiceAccount: agent-prism
80:     socketPath: /run/spire/sockets/spire-agent.sock
81:     csiDriver: csi.spiffe.io
82:     envoy:
83:       repository: envoyproxy/envoy
84:       tag: v1.39.0
85:       digest: "sha256:d59f7f5fa10cff6d5892b6c5e7df5c9297ddfb2c3683e33fbfb82da24de4fa66"
86:       pullPolicy: IfNotPresent
87:       resources:
88:         requests: { cpu: 50m, memory: 64Mi }
89:         limits: { cpu: 500m, memory: 256Mi }
