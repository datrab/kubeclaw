{"path": "skills/prism/server/agent-job-runner.mjs", "sha256": "f97926e67b1737be717db6a549ca60920232b7fbd2da23f73c0a15597c331bfb"}
1: import { randomUUID } from 'node:crypto';
2: import { checkWorkerResourceResultBinding } from '@kubeclaw/pipeline-worker-core-contract';
3: import { WorkerAttemptExecutor } from '@kubeclaw/worker-core';
4: import { agentAttempt } from './agent-attempt.ts';
5: import { AgentProcess } from './agent-process.ts';
6: import { WorkerArtifactClient } from './worker-artifacts.ts';
7: import { agentPrompt } from './agent-prompt.mjs';
8: 
9: export async function controlRequest(controlUrl,path,body,signal) {
10:   const response=await fetch(new URL(path,controlUrl),{method:body===undefined?'GET':'POST',headers:{'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body),signal,redirect:'error'});
11:   const text=await response.text();
12:   if(!response.ok)throw new Error(`Prism Control ${path}: HTTP ${response.status}: ${text}`);
13:   return JSON.parse(text);
14: }
15: 
16: /** A boot receives a new owner ID. Only the durable store may select provably unstarted work. */
17: export class AgentJobRunner {
18:   runnerId=`prism-bridge-${randomUUID()}`;
19:   stopping=new AbortController();
20:   active;
21:   constructor(controlUrl){this.controlUrl=controlUrl;}
22:   async tick(){
23:     if(this.active || this.stopping.signal.aborted)return;
24:     this.active=this.runOne();
25:     try{await this.active;}finally{this.active=undefined;}
26:   }
27:   async runOne(){
28:     const {job}=await controlRequest(this.controlUrl,'/v1/agent/jobs/claim',{runnerId:this.runnerId},AbortSignal.timeout(10_000));
29:     if(!job)return;
30:     // Once this claim is durable, any uncertainty is NeedsNova. Never replay a failed launch.
31:     let outcome;
32:     try{
33:       const envelope=job.attempt_envelope;
34:       if(!envelope || envelope.claim.workerId!==this.runnerId || envelope.attemptId!==job.fence || envelope.executionId!==job.id)throw new Error('Prism accepted attempt identity is missing or conflicts with claim');
35:       const localProfile=(await agentAttempt(job,this.runnerId)).profile;
36:       if(localProfile.profileDigest!==envelope.profile.profileDigest)throw new Error('Prism local launcher implementation does not match Control accepted profile');
37:       const artifacts=new WorkerArtifactClient(new URL(this.controlUrl),'',true);
38:       const executor=new WorkerAttemptExecutor({envelope,operation:new AgentProcess('openclaw',['agent','--agent','main','--session-key',job.session_key,'--message',agentPrompt(job),'--json','--timeout','900']),signal:this.stopping.signal,receiptNamespace:'prism-agent-launcher',
39:         storeFullLog:(id,content,{signal})=>artifacts.upload(`${id}-logs`,'worker-log','text/plain',Buffer.from(content),signal)});
40:       outcome=await executor.execute();
41:       const binding=checkWorkerResourceResultBinding(envelope,outcome);
42:       if(!binding.ok)throw new Error(`Prism agent resource receipt binding failed: ${binding.errors.join('; ')}`);
43:     }catch(error){outcome={state:'errored',error:error instanceof Error?error.message:String(error)};}
44:     await controlRequest(this.controlUrl,`/v1/agent/jobs/${job.id}/finish`,{fence:job.fence,outcome},AbortSignal.timeout(10_000));
45:   }
46:   async stop(){this.stopping.abort(new Error('Prism bridge is shutting down; external gateway outcome may be unresolved'));await this.active;}
47: }
{"path": "skills/prism/server/agent-prompt.mjs", "sha256": "3bcd6b4b2bb25d82c9ec767a03fd08ea1c17420eca3ce1742410359ed2d1aea9"}
1: import { preferencePrompt } from './preference-prompt.mjs';
2: 
3: export function agentPrompt(job) {
4:   const input=job.request;
5:   const action=job.operation==='design-set' ? [
6:     'You are Prism, the single OpenClaw design agent. Create exactly three materially different, complete Prism design documents.',
7:     'Read /app/skills/packages/prism-contract/schemas/prism-v1.schema.json and /app/skills/packages/prism-contract/fixtures/minimal-web.json from the versioned bundle before drafting.',
8:     `Design request: ${JSON.stringify(input.preferences.request)}`,
9:     'Finish by calling prism_create_design_set exactly once. Do not return a prose-only answer.'
10:   ] : [
11:     'Continue this Prism project in its v2 session. The complete current document is supplied; do not adopt a legacy session.',
12:     `Apply this Studio feedback: ${input.instruction}`,
13:     `Target documentId: ${input.documentId}; expected revision: ${input.expectedRevision}`,
14:     `Current document: ${JSON.stringify(input.document)}`,
15:     'Finish by calling prism_apply_revision with the complete updated document.'
16:   ];
17:   return [...action,`External projectId: ${input.projectId}`,
18:     'Do not call any model provider directly; the OpenClaw gateway owns model routing.',
19:     preferencePrompt(input.preferences),
20:     `Every Prism result tool call MUST include jobId ${job.id} and fence ${job.fence}. These identify this exact action, not a reusable project authority.`
21:   ].join('\n\n');
22: }
{"path": "skills/prism/server/agent-routes.ts", "sha256": "55c4c77fc4ff7b981287c433c126d9754dffd3df1de464ec0d83bb0294caec17"}
1: import {
2:   validatePrism,
3:   type PrismDocument,
4: } from "@kubeclaw/prism-contracts-v1";
5: import { authorizeProxiedSpiffePeer } from "@kubeclaw/worker-core";
6: import { type IncomingMessage, type ServerResponse } from "node:http";
7: import { requirePreferenceGeneration } from "../control/preference-snapshot.ts";
8: import { assertMaterialDirectionDiversity } from "../directions/index.ts";
9: import { handleAgentJobs } from "./agent-job-routes.ts";
10: 
11: import type { ControlContext } from "./control-context.ts";
12: import { body, json } from "./control-http.ts";
13: type RouteContext = Pick<ControlContext, "config" | "pool" | "repository">;
14: 
15: export async function agentRoutes(
16:   context: RouteContext,
17:   request: IncomingMessage,
18:   response: ServerResponse,
19:   url: URL,
20: ): Promise<boolean> {
21:   const { pool } = context;
22:   const { spiffeEnabled, trustedPrismAgentSpiffeId } = context.config;
23: 
24:   if (
25:     await handleAgentJobs(request, response, url, {
26:       db: pool,
27:       spiffeEnabled,
28:       trustedAgentId: trustedPrismAgentSpiffeId,
29:       readBody: body,
30:     })
31:   )
32:     return true;
33:   if (url.pathname === "/v1/agent/design-sets" && request.method === "POST") {
34:     await createAgentDesignSet(context, request, response);
35:     return true;
36:   }
37:   if (url.pathname === "/v1/agent/revisions" && request.method === "POST") {
38:     await reviseAgentDocument(context, request, response);
39:     return true;
40:   }
41:   return false;
42: }
43: async function createAgentDesignSet(
44:   context: RouteContext,
45:   request: IncomingMessage,
46:   response: ServerResponse,
47: ) {
48:   const { pool, repository } = context;
49:   const { spiffeEnabled, trustedPrismAgentSpiffeId, studioPublicUrl } =
50:     context.config;
51: 
52:   if (!spiffeEnabled)
53:     throw new Error("Prism agent tools require SPIFFE worker trust");
54:   authorizeProxiedSpiffePeer(
55:     request.headers,
56:     request.socket.remoteAddress,
57:     new Set([trustedPrismAgentSpiffeId]),
58:   );
59:   const input = (await body(request)) as DesignSetInput;
60:   if (!input.projectId || input.designs?.length !== 3)
61:     throw new Error("exactly three Prism designs are required");
62:   if (new Set(input.designs.map((item) => item.key)).size !== 3)
63:     throw new Error("Prism direction keys must be unique");
64:   const generation = await requirePreferenceGeneration(
65:     pool,
66:     input.generationId,
67:     input.projectId,
68:     { operation: "design-set" },
69:   );
70:   const documents = input.designs.map((item) =>
71:     validatePrism<PrismDocument>("designDocument", item.document),
72:   );
73:   assertMaterialDirectionDiversity(documents);
74:   const designs = input.designs.map((item, index) => {
75:     if (!item.key || !item.title || !item.summary)
76:       throw new Error("each Prism design requires key, title, and summary");
77:     return {
78:       key: item.key,
79:       title: item.title,
80:       summary: item.summary,
81:       document: documents[index]!,
82:       evidence: { ...item.evidence, ...generation },
83:     };
84:   });
85:   const result = await repository.createDirectionSet(
86:     input.projectId,
87:     input.generationId!,
88:     designs,
89:     { jobId: input.jobId, fence: input.fence, payload: input },
90:   );
91:   return json(response, result.status === "created" ? 201 : 200, {
92:     ...result,
93:     studioUrl: `${studioPublicUrl}?project=${result.projectId}&document=${result.documentId}`,
94:   });
95: }
96: async function reviseAgentDocument(
97:   context: RouteContext,
98:   request: IncomingMessage,
99:   response: ServerResponse,
100: ) {
101:   const { pool, repository } = context;
102:   const { spiffeEnabled, trustedPrismAgentSpiffeId } = context.config;
103: 
104:   if (!spiffeEnabled)
105:     throw new Error("Prism agent tools require SPIFFE worker trust");
106:   authorizeProxiedSpiffePeer(
107:     request.headers,
108:     request.socket.remoteAddress,
109:     new Set([trustedPrismAgentSpiffeId]),
110:   );
111:   const input = (await body(request)) as AgentRevisionInput;
112:   if (
113:     !input.projectId ||
114:     !input.documentId ||
115:     !input.instruction ||
116:     !Number.isSafeInteger(input.expectedRevision)
117:   )
118:     throw new Error("complete Prism revision input is required");
119:   const owner = await pool.query<{ external_id: string }>(
120:     "SELECT p.external_id FROM prism.design_document d JOIN prism.project p ON p.id=d.project_id WHERE d.id=$1",
121:     [input.documentId],
122:   );
123:   if (owner.rows[0]?.external_id !== input.projectId)
124:     throw new Error("document does not belong to the Prism project");
125:   const generation = await requirePreferenceGeneration(
126:     pool,
127:     input.generationId,
128:     input.projectId,
129:     {
130:       operation: "revise",
131:       documentId: input.documentId,
132:       expectedRevision: input.expectedRevision,
133:     },
134:   );
135:   const current = await repository.revision(
136:     input.documentId,
137:     input.expectedRevision!,
138:   );
139:   const document = validatePrism<PrismDocument>(
140:     "designDocument",
141:     input.document,
142:   );
143:   if (document.meta.revision !== input.expectedRevision! + 1)
144:     throw new Error(
145:       "Prism agent must increment the document revision exactly once",
146:     );
147:   const updated = await repository.replace(
148:     input.documentId,
149:     current.id,
150:     document,
151:     { type: "agent.revision", instruction: input.instruction, ...generation },
152:     "agent:prism",
153:     { jobId: input.jobId, fence: input.fence, payload: input },
154:   );
155:   return json(response, 200, { status: "updated", document: updated });
156: }
157: 
158: interface DesignSetInput {
159:   projectId?: string;
160:   generationId?: string;
161:   jobId: string;
162:   fence: string;
163:   designs?: Array<{
164:     key?: string;
165:     title?: string;
166:     summary?: string;
167:     document?: PrismDocument;
168:     evidence?: Record<string, unknown>;
169:   }>;
170: }
171: interface AgentRevisionInput {
172:   jobId: string;
173:   fence: string;
174:   generationId?: string;
175:   projectId?: string;
176:   documentId?: string;
177:   expectedRevision?: number;
178:   instruction?: string;
179:   document?: PrismDocument;
180: }
{"path": "skills/prism/server/control-config.ts", "sha256": "35df538b2a10a2781116eb9eb6ee2e98a6ed7180ba876d536ad0f2e7ff64a9d4"}
1: import { loadProductConfig, type ProductConfig } from '../control/product-decisions.ts';
2: import { authorizePipelinePreferenceSubject } from '../control/pipeline-preference-subject.ts';
3: import { loadPrismSettings } from '../../common/plugin-runtime/foundation/config/swarm.ts';
4: 
5: export interface ControlConfig {
6:   readonly pipelinePreferenceSubject: string | undefined;
7: }
8: 
9: /** Load and validate platform-owned Control configuration once at startup. */
10: export function loadControlConfig(environment: NodeJS.ProcessEnv = process.env): ControlConfig {
11:   return controlPolicy(loadPrismSettings(environment).control);
12: }
13: 
14: function controlPolicy(settings: ReturnType<typeof loadPrismSettings>['control']): ControlConfig {
15:   const pipelinePreferenceSubject = settings.pipelinePreferenceSubject ?? undefined;
16:   authorizePipelinePreferenceSubject(undefined, pipelinePreferenceSubject);
17:   return Object.freeze({pipelinePreferenceSubject});
18: }
19: 
20: function required(environment: NodeJS.ProcessEnv, name: string): string {
21:   const value = environment[name];
22:   if (!value) throw new Error(`${name} is required`);
23:   return value;
24: }
25: 
26: function loadTrustConfig(environment: NodeJS.ProcessEnv) {
27:   const spiffeEnabled = environment.WORKER_TRUST_SPIFFE_ENABLED === 'true';
28:   const trustedNovaSpiffeId = environment.PRISM_TRUSTED_NOVA_SPIFFE_ID ?? '';
29:   const trustedWorkerSpiffeId = environment.PRISM_TRUSTED_WORKER_SPIFFE_ID ?? '';
30:   const trustedControlSpiffeId = environment.PRISM_CONTROL_SPIFFE_ID ?? '';
31:   const trustedPrismAgentSpiffeId = environment.PRISM_TRUSTED_AGENT_SPIFFE_ID ?? '';
32:   if (spiffeEnabled && (!trustedNovaSpiffeId || !trustedWorkerSpiffeId || !trustedControlSpiffeId || !trustedPrismAgentSpiffeId)) {
33:     throw new Error('Prism SPIFFE trust policy is incomplete');
34:   }
35:   return {
36:     spiffeEnabled, trustedNovaSpiffeId, trustedWorkerSpiffeId,
37:     trustedControlSpiffeId, trustedPrismAgentSpiffeId,
38:     trustedTestRunnerSpiffeId: environment.PRISM_TRUSTED_TEST_RUNNER_SPIFFE_ID ?? '',
39:     dispatchSecret: spiffeEnabled ? '' : required(environment, 'PRISM_DISPATCH_SECRET'),
40:     workerSecret: spiffeEnabled ? '' : required(environment, 'PRISM_WORKER_SECRET'),
41:   };
42: }
43: 
44: /** Resolve authored native settings and service credentials once, at composition. */
45: export function loadControlServerConfig(environment: NodeJS.ProcessEnv = process.env) {
46:   if (environment.PORT !== undefined) throw new Error("SWARM_CONFIG_LEGACY_OVERRIDE:PORT:use prism-control.config.json settings.port");
47:   const { native: settings, control } = loadPrismSettings(environment);
48:   return Object.freeze({
49:     ...controlPolicy(control),
50:     port: control.port,
51:     nativeResourcePolicy: settings.resourcePolicy,
52:     maximumWorkerResponseBytes: settings.maximumResultBytes,
53:     nativeWorkerDispatchTimeoutMs: settings.dispatchTimeoutMs,
54:     sessionSecret: required(environment, 'PRISM_SESSION_SECRET'),
55:     ingressSecret: required(environment, 'PRISM_INGRESS_SECRET'),
56:     ...loadTrustConfig(environment),
57:     ingestionSecret: required(environment, 'PRISM_INGESTION_SECRET'),
58:     artifactRoot: control.artifactRoot,
59:     workerUrl: new URL(environment.PRISM_WORKER_URL ?? 'http://prism-worker:8080'),
60:     ingestionUrl: new URL(environment.PRISM_INGESTION_URL ?? 'http://prism-ingestion:8080'),
61:     controlInternalUrl: new URL(environment.PRISM_CONTROL_INTERNAL_URL ?? 'http://prism-control:8080'),
62:     studioPublicUrl: control.studioPublicUrl,
63:   });
64: }
65: 
66: export function loadProductAuthorityConfig(environment: NodeJS.ProcessEnv = process.env): Promise<ProductConfig | undefined> {
67:   return loadProductConfig(environment);
68: }
69: 
70: /** Capture one startup configuration before asynchronous signing-key I/O. */
71: export async function loadControlCompositionConfig(environment: NodeJS.ProcessEnv = process.env) {
72:   const snapshot = {...environment};
73:   const service = loadControlServerConfig(snapshot);
74:   const product = await loadProductAuthorityConfig(snapshot);
75:   return Object.freeze({service, product, listener: Object.freeze({port: service.port, databaseUrl: snapshot.DATABASE_URL})});
76: }
{"path": "skills/prism/server/control-context.ts", "sha256": "2444e6f0f22860aea6f109c984be4747a13421da2d33dd738ef7c29b71f04d02"}
1: import type { IncomingMessage } from "node:http";
2: import { runNativePrismOperation } from "../control/native-operation.ts";
3: import { verifySession } from "../control/session.ts";
4: import {
5:   ContentAddressedArtifactStore,
6:   RevisionRepository,
7:   type Database,
8: } from "../storage/index.ts";
9: import type { loadControlServerConfig } from "./control-config.ts";
10: import { cookies } from "./control-http.ts";
11: export function createControlContext(
12:   pool: Database,
13:   config: ReturnType<typeof loadControlServerConfig>,
14: ) {
15:   const repository = new RevisionRepository(pool),
16:     artifacts = new ContentAddressedArtifactStore(config.artifactRoot);
17:   return Object.freeze({
18:     pool,
19:     repository,
20:     artifacts,
21:     config,
22:     runWorker: (
23:       operation: "generate" | "render" | "evaluate" | "ingest" | "publish",
24:       input: Record<string, unknown>,
25:       idempotencyKey: string,
26:     ) =>
27:       runNativePrismOperation(
28:         pool,
29:         artifacts,
30:         config,
31:         operation,
32:         input,
33:         idempotencyKey,
34:       ),
35:   });
36: }
37: export type ControlContext = ReturnType<typeof createControlContext>;
38: export function authenticated(
39:   context: ControlContext,
40:   request: IncomingMessage,
41: ) {
42:   const { sessionSecret } = context.config;
43:   const values = cookies(request);
44:   const session = verifySession(values.prism_session ?? "", sessionSecret);
45:   const csrf = values.prism_csrf ?? "";
46:   if (
47:     !["GET", "HEAD"].includes(request.method ?? "") &&
48:     (!csrf || request.headers["x-prism-csrf"] !== csrf)
49:   )
50:     throw new Error("invalid CSRF token");
51:   return { user: session.user, roles: session.roles, csrf };
52: }
53: export type AuthenticatedControlContext = ControlContext & {
54:   readonly actor: ReturnType<typeof authenticated>;
55: };
{"path": "skills/prism/server/control-server.ts", "sha256": "079984af0571f48c51e191f099174c88922af6b6cfb392d56cce945b4688f5c3"}
1: import {
2:   createServer,
3:   type IncomingMessage,
4:   type ServerResponse,
5: } from "node:http";
6: import { Console } from "node:console";
7: import type { Database } from "../storage/index.ts";
8: import { agentRoutes } from "./agent-routes.ts";
9: import { approvalRoute } from "./approval-route.ts";
10: import { artifactRoute } from "./artifact-route.ts";
11: import { baselineRoute } from "./baseline-route.ts";
12: import { loadControlCompositionConfig } from "./control-config.ts";
13: import {
14:   authenticated,
15:   createControlContext,
16:   type ControlContext,
17: } from "./control-context.ts";
18: import { json } from "./control-http.ts";
19: import { corpusRoutes } from "./corpus-routes.ts";
20: import { directionRoutes } from "./direction-routes.ts";
21: import { dispatchRoute } from "./dispatch-route.ts";
22: import { documentHistoryRoutes, documentRoutes } from "./document-routes.ts";
23: import { engineRoute } from "./engine-route.ts";
24: import { handleInternalArtifact } from "./internal-artifacts.ts";
25: import { preferenceRoutes } from "./preference-routes.ts";
26: import { productAuthorityHandler } from "./product-decisions.ts";
27: import { projectRoutes } from "./project-routes.ts";
28: import { sessionRoutes } from "./session-routes.ts";
29: // Match the original Console(ignoreErrors:true) policy. The closed-descriptor
30: // regression verifies preserved responses and availability for that failure.
31: const diagnostics = new Console({
32:   stdout: process.stdout,
33:   stderr: process.stderr,
34:   ignoreErrors: true,
35: });
36: 
37: async function handle(
38:   context: ControlContext,
39:   request: IncomingMessage,
40:   response: ServerResponse,
41: ) {
42:   try {
43:     const url = new URL(request.url ?? "/", "http://prism-control");
44:     if (await handlePublic(context, request, response, url)) return;
45:     return await handleApplication(context, request, response, url);
46:   } catch (error) {
47:     diagnostics.error("[prism-control] request failed", {
48:       method: request.method,
49:       path: request.url,
50:       error: error instanceof Error ? error.message : "request failed",
51:     });
52:     return json(response, error instanceof SyntaxError ? 400 : 422, {
53:       error: error instanceof Error ? error.message : "request failed",
54:     });
55:   }
56: }
57: /** Compose the original HTTP service; the caller owns database/listener lifetime. */
58: export async function createControlServer(
59:   pool: Database,
60:   environment?: NodeJS.ProcessEnv,
61: ) {
62:   return createConfiguredControlServer(
63:     pool,
64:     await loadControlCompositionConfig(environment),
65:   );
66: }
67: 
68: /** Build the HTTP service from the already captured production composition. */
69: export function createConfiguredControlServer(
70:   pool: Database,
71:   composition: Awaited<ReturnType<typeof loadControlCompositionConfig>>,
72: ) {
73:   const { service: config, product: productConfig } = composition;
74:   const context = createControlContext(pool, config);
75:   return createServer(
76:     productAuthorityHandler(
77:       (request, response) => handle(context, request, response),
78:       { db: pool, config: productConfig, sessionSecret: config.sessionSecret },
79:     ),
80:   );
81: }
82: 
83: async function handlePublic(
84:   context: ControlContext,
85:   request: IncomingMessage,
86:   response: ServerResponse,
87:   url: URL,
88: ): Promise<boolean> {
89:   if (url.pathname === "/health") {
90:     json(response, 200, { status: "ok" });
91:     return true;
92:   }
93:   if (url.pathname === "/ready") {
94:     await context.pool.query("SELECT 1");
95:     json(response, 200, { status: "ready" });
96:     return true;
97:   }
98:   const {
99:     spiffeEnabled,
100:     workerSecret,
101:     trustedWorkerSpiffeId,
102:     trustedControlSpiffeId,
103:     trustedPrismAgentSpiffeId,
104:   } = context.config;
105:   if (
106:     await handleInternalArtifact(request, response, url, {
107:       artifacts: context.artifacts,
108:       spiffeEnabled,
109:       workerSecret,
110:       trustedWorkerSpiffeId,
111:       trustedControlSpiffeId,
112:       trustedPrismAgentSpiffeId,
113:     })
114:   )
115:     return true;
116:   if (await sessionRoutes(context, request, response, url)) return true;
117:   if (await dispatchRoute(context, request, response, url)) return true;
118:   if (await agentRoutes(context, request, response, url)) return true;
119:   return false;
120: }
121: async function handleApplication(
122:   context: ControlContext,
123:   request: IncomingMessage,
124:   response: ServerResponse,
125:   url: URL,
126: ) {
127:   const actor = authenticated(context, request);
128:   const application = { ...context, actor };
129:   if (await projectRoutes(application, request, response, url)) return;
130:   if (await documentRoutes(application, request, response, url)) return;
131:   if (await directionRoutes(application, request, response, url)) return;
132:   if (await documentHistoryRoutes(application, request, response, url)) return;
133:   if (await engineRoute(application, request, response, url)) return;
134:   if (await approvalRoute(application, request, response, url)) return;
135:   if (await baselineRoute(application, request, response, url)) return;
136:   if (await corpusRoutes(application, request, response, url)) return;
137:   if (await preferenceRoutes(application, request, response, url)) return;
138:   if (await artifactRoute(application, request, response, url)) return;
139:   return json(response, 404, { error: "not found" });
140: }
