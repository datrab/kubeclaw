{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "hostInstanceId",
    "ownerPath",
    "profileId",
    "nodeName"
  ],
  "properties": {
    "owner": {
      "const": "native-host"
    },
    "hostInstanceId": {
      "const": "native-host"
    },
    "ownerPath": {
      "const": "my-values/infra/native-worker-pools-ax41.yaml"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "nodeName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
    }
  }
}
