{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["purpose","routes","settingsFile","profile"],
  "properties":{
    "purpose":{"enum":["performance","seo","best-practices"]},
    "url":{"type":"string","pattern":"^https?://","maxLength":2048},
    "endpointName":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":64},
    "routes":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^/(?!/)[^?#\\r\\n]*$","maxLength":1024}},
    "settingsFile":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "profile":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":64},
    "budget":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":64},
    "runs":{"enum":[1,3,5]},
    "acceptances":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["audit","route","reason","expiresAt"],"properties":{
      "audit":{"type":"string","minLength":1,"maxLength":256},"route":{"type":"string","pattern":"^/(?!/)[^?#\\r\\n]*$","maxLength":1024},
      "reason":{"type":"string","minLength":8,"maxLength":1024},"expiresAt":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
    }},"default":[]},
    "timeoutMs":{"type":"integer","minimum":10000,"maximum":180000,"default":120000}
  },
  "allOf":[
    {"if":{"properties":{"purpose":{"const":"performance"}}},"then":{"properties":{"runs":{"enum":[3,5],"default":3}}}},
    {"if":{"properties":{"purpose":{"enum":["seo","best-practices"]}}},"then":{"properties":{"runs":{"const":1,"default":1},"budget":false}}}
  ]
}
