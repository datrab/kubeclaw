{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "endpointName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 64
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?!/)[^?#\\r\\n]*$",
        "maxLength": 1024
      }
    }
  },
  "required": [
    "routes"
  ]
}
