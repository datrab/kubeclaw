{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "purpose": {
      "enum": [
        "performance",
        "seo",
        "best-practices"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "endpointName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 64
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?!/)[^?#\\r\\n]*$",
        "maxLength": 1024
      }
    }
  },
  "required": [
    "purpose",
    "routes"
  ]
}
