{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "pipeline-package-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.playwright"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workers",
              "timeoutMs",
              "minimumExecutedTests",
              "requiredTests"
            ],
            "properties": {
              "workers": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 3600000
              },
              "minimumExecutedTests": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "requiredTests": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          },
          "declarations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "retrySafe": {
                "enum": [
                  false
                ]
              },
              "matrixFields": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "type": "string"
                }
              },
              "evidenceDefaults": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "onPass": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "test-report",
                        "screenshot",
                        "video",
                        "trace",
                        "test-artifact"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-report"
                        }
                      },
                      {
                        "contains": {
                          "const": "screenshot"
                        }
                      },
                      {
                        "contains": {
                          "const": "video"
                        }
                      },
                      {
                        "contains": {
                          "const": "trace"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-artifact"
                        }
                      }
                    ]
                  },
                  "onFail": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "test-report",
                        "screenshot",
                        "video",
                        "trace",
                        "test-artifact"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-report"
                        }
                      },
                      {
                        "contains": {
                          "const": "screenshot"
                        }
                      },
                      {
                        "contains": {
                          "const": "video"
                        }
                      },
                      {
                        "contains": {
                          "const": "trace"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-artifact"
                        }
                      }
                    ]
                  },
                  "onError": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "test-report",
                        "screenshot",
                        "video",
                        "trace",
                        "test-artifact"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "onPass",
                  "onFail",
                  "onError"
                ]
              }
            },
            "required": [
              "retrySafe",
              "matrixFields",
              "evidenceDefaults"
            ]
          }
        },
        "required": [
          "processing",
          "declarations"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "instanceId",
    "profiles"
  ]
}
