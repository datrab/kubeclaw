{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "instanceId",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pipeline-package-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.prism-design"
    },
    "instanceId": {
      "const": "fixture.prism-design"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "processing"
        ],
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kubeclaw.prism-design:design"
            ],
            "properties": {
              "kubeclaw.prism-design:design": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent",
                  "target",
                  "issuerId",
                  "timeoutMinutes"
                ],
                "properties": {
                  "agent": {
                    "const": "prism"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "issuerId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeoutMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 525600
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
