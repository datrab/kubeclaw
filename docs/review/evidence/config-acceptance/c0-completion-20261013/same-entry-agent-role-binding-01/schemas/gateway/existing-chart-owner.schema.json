{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "kubeclaw-gateway-owner.v1-proposal"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "instanceId",
          "settings",
          "readonlyBindings"
        ],
        "properties": {
          "role": {
            "enum": [
              "nova",
              "buster",
              "prism"
            ]
          },
          "instanceId": {
            "type": "string",
            "minLength": 1
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gatewayOpenClaw",
              "litellm",
              "agent"
            ],
            "properties": {
              "gatewayOpenClaw": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "memory",
                  "agents",
                  "acp",
                  "tools",
                  "commands",
                  "session",
                  "channels",
                  "gateway",
                  "plugins",
                  "messages"
                ],
                "properties": {
                  "memory": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "search"
                    ],
                    "properties": {
                      "search": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled",
                          "experimental",
                          "sources",
                          "provider",
                          "remote",
                          "model"
                        ],
                        "properties": {
                          "enabled": {
                            "type": "boolean"
                          },
                          "experimental": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "sessionMemory"
                            ],
                            "properties": {
                              "sessionMemory": {
                                "type": "boolean"
                              }
                            }
                          },
                          "sources": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                              "enum": [
                                "memory",
                                "sessions"
                              ]
                            },
                            "minItems": 0
                          },
                          "provider": {
                            "type": "string",
                            "minLength": 1
                          },
                          "remote": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "apiKey"
                            ],
                            "properties": {
                              "apiKey": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "source",
                                  "provider",
                                  "id"
                                ],
                                "properties": {
                                  "source": {
                                    "enum": [
                                      "env",
                                      "file",
                                      "exec",
                                      "store"
                                    ]
                                  },
                                  "provider": {
                                    "type": "string",
                                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                                  },
                                  "id": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          },
                          "model": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  },
                  "agents": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "defaults",
                      "entries"
                    ],
                    "properties": {
                      "defaults": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "thinkingDefault",
                          "reasoningDefault",
                          "modelPolicy",
                          "models",
                          "workspace",
                          "embeddedAgent",
                          "contextPruning",
                          "compaction",
                          "subagents",
                          "contextInjection",
                          "timeoutSeconds"
                        ],
                        "properties": {
                          "thinkingDefault": {
                            "enum": [
                              "off",
                              "minimal",
                              "low",
                              "medium",
                              "high",
                              "xhigh",
                              "adaptive",
                              "max",
                              "ultra"
                            ]
                          },
                          "reasoningDefault": {
                            "enum": [
                              "off",
                              "on",
                              "stream"
                            ]
                          },
                          "modelPolicy": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "allow"
                            ],
                            "properties": {
                              "allow": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "uniqueItems": true
                              }
                            }
                          },
                          "models": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "openai/gpt-5.6-sol",
                              "openai/gpt-5.5"
                            ],
                            "properties": {
                              "openai/gpt-6-astra": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "agentRuntime"
                                ],
                                "properties": {
                                  "agentRuntime": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "id"
                                    ],
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "enum": [
                                          "openclaw",
                                          "codex"
                                        ]
                                      }
                                    }
                                  }
                                }
                              },
                              "openai/gpt-5.6-sol": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "agentRuntime"
                                ],
                                "properties": {
                                  "agentRuntime": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "id"
                                    ],
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "enum": [
                                          "openclaw",
                                          "codex"
                                        ]
                                      }
                                    }
                                  }
                                }
                              },
                              "openai/gpt-5.5": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "agentRuntime"
                                ],
                                "properties": {
                                  "agentRuntime": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "id"
                                    ],
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "enum": [
                                          "openclaw",
                                          "codex"
                                        ]
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "workspace": {
                            "type": "string",
                            "minLength": 1
                          },
                          "embeddedAgent": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "executionContract"
                            ],
                            "properties": {
                              "executionContract": {
                                "enum": [
                                  "default",
                                  "strict-agentic"
                                ]
                              }
                            }
                          },
                          "contextPruning": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "mode",
                              "ttl"
                            ],
                            "properties": {
                              "mode": {
                                "enum": [
                                  "off",
                                  "cache-ttl"
                                ]
                              },
                              "ttl": {
                                "type": "string"
                              }
                            }
                          },
                          "compaction": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "mode",
                              "keepRecentTokens",
                              "memoryFlush"
                            ],
                            "properties": {
                              "mode": {
                                "enum": [
                                  "default",
                                  "safeguard"
                                ]
                              },
                              "keepRecentTokens": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              },
                              "memoryFlush": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "enabled"
                                ],
                                "properties": {
                                  "enabled": {
                                    "type": "boolean"
                                  }
                                }
                              }
                            }
                          },
                          "subagents": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "maxConcurrent",
                              "archiveAfterMinutes",
                              "runTimeoutSeconds",
                              "maxSpawnDepth"
                            ],
                            "properties": {
                              "maxConcurrent": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 9007199254740991
                              },
                              "archiveAfterMinutes": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 144000000000
                              },
                              "runTimeoutSeconds": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 2147483
                              },
                              "maxSpawnDepth": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 5
                              }
                            }
                          },
                          "contextInjection": {
                            "enum": [
                              "always",
                              "continuation-skip",
                              "never"
                            ]
                          },
                          "timeoutSeconds": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 2147483
                          }
                        }
                      },
                      "entries": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "main"
                        ],
                        "properties": {
                          "main": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "subagents",
                              "skills",
                              "skillsLimits"
                            ],
                            "properties": {
                              "subagents": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "allowAgents"
                                ],
                                "properties": {
                                  "allowAgents": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    },
                                    "uniqueItems": true
                                  }
                                }
                              },
                              "skills": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "uniqueItems": true
                              },
                              "skillsLimits": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "maxSkillsPromptChars"
                                ],
                                "properties": {
                                  "maxSkillsPromptChars": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "acp": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "enabled",
                      "backend",
                      "defaultAgent",
                      "allowedAgents"
                    ],
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "backend": {
                        "type": "string",
                        "minLength": 1
                      },
                      "defaultAgent": {
                        "type": "string",
                        "minLength": 1
                      },
                      "allowedAgents": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      }
                    }
                  },
                  "tools": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "profile",
                      "sessions",
                      "sessions_spawn",
                      "exec",
                      "agentToAgent"
                    ],
                    "properties": {
                      "profile": {
                        "enum": [
                          "minimal",
                          "coding",
                          "messaging",
                          "full"
                        ]
                      },
                      "sessions": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "visibility"
                        ],
                        "properties": {
                          "visibility": {
                            "enum": [
                              "self",
                              "tree",
                              "agent",
                              "all"
                            ]
                          }
                        }
                      },
                      "sessions_spawn": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "attachments"
                        ],
                        "properties": {
                          "attachments": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "enabled"
                            ],
                            "properties": {
                              "enabled": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      },
                      "exec": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "timeoutSeconds",
                          "mode"
                        ],
                        "properties": {
                          "timeoutSeconds": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2147483
                          },
                          "mode": {
                            "enum": [
                              "deny",
                              "allowlist",
                              "ask",
                              "auto",
                              "full"
                            ]
                          }
                        }
                      },
                      "agentToAgent": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled"
                        ],
                        "properties": {
                          "enabled": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  },
                  "commands": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "native",
                      "nativeSkills",
                      "restart"
                    ],
                    "properties": {
                      "native": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "const": "auto"
                          }
                        ]
                      },
                      "nativeSkills": {
                        "anyOf": [
                          {
                            "type": "boolean"
                          },
                          {
                            "const": "auto"
                          }
                        ]
                      },
                      "restart": {
                        "type": "boolean"
                      }
                    }
                  },
                  "session": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "dmScope",
                      "resetByType",
                      "threadBindings"
                    ],
                    "properties": {
                      "dmScope": {
                        "enum": [
                          "main",
                          "per-peer",
                          "per-channel-peer",
                          "per-account-channel-peer"
                        ]
                      },
                      "resetByType": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "group"
                        ],
                        "properties": {
                          "group": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "mode",
                              "idleMinutes"
                            ],
                            "properties": {
                              "mode": {
                                "enum": [
                                  "none",
                                  "daily",
                                  "idle"
                                ]
                              },
                              "idleMinutes": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 144000000000
                              }
                            }
                          }
                        }
                      },
                      "threadBindings": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled",
                          "idleHours",
                          "maxAgeHours"
                        ],
                        "properties": {
                          "enabled": {
                            "type": "boolean"
                          },
                          "idleHours": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 2400000000.0
                          },
                          "maxAgeHours": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 2400000000.0
                          }
                        }
                      }
                    }
                  },
                  "channels": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "discord"
                    ],
                    "properties": {
                      "discord": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "groupPolicy",
                          "streaming",
                          "guilds",
                          "threadBindings",
                          "execApprovals"
                        ],
                        "properties": {
                          "groupPolicy": {
                            "enum": [
                              "open",
                              "disabled",
                              "allowlist"
                            ]
                          },
                          "streaming": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "mode"
                            ],
                            "properties": {
                              "mode": {
                                "enum": [
                                  "off",
                                  "partial",
                                  "block",
                                  "progress"
                                ]
                              }
                            }
                          },
                          "guilds": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "*"
                            ],
                            "properties": {
                              "*": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "requireMention"
                                ],
                                "properties": {
                                  "requireMention": {
                                    "type": "boolean"
                                  }
                                }
                              }
                            }
                          },
                          "threadBindings": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "enabled",
                              "idleHours",
                              "spawnSessions"
                            ],
                            "properties": {
                              "enabled": {
                                "type": "boolean"
                              },
                              "idleHours": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 2400000000.0
                              },
                              "spawnSessions": {
                                "type": "boolean"
                              }
                            }
                          },
                          "execApprovals": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "enabled",
                              "target"
                            ],
                            "properties": {
                              "enabled": {
                                "anyOf": [
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "const": "auto"
                                  }
                                ]
                              },
                              "target": {
                                "enum": [
                                  "dm",
                                  "channel",
                                  "both"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "gateway": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode",
                      "bind",
                      "controlUi",
                      "auth",
                      "tools",
                      "tailscale"
                    ],
                    "properties": {
                      "mode": {
                        "enum": [
                          "local",
                          "remote"
                        ]
                      },
                      "bind": {
                        "enum": [
                          "auto",
                          "lan",
                          "loopback",
                          "custom",
                          "tailnet"
                        ]
                      },
                      "controlUi": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "dangerouslyAllowHostHeaderOriginFallback"
                        ],
                        "properties": {
                          "dangerouslyAllowHostHeaderOriginFallback": {
                            "type": "boolean"
                          }
                        }
                      },
                      "auth": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "mode"
                        ],
                        "properties": {
                          "mode": {
                            "enum": [
                              "none",
                              "token",
                              "password",
                              "trusted-proxy"
                            ]
                          }
                        }
                      },
                      "tools": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "allow"
                        ],
                        "properties": {
                          "allow": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "uniqueItems": true
                          }
                        }
                      },
                      "tailscale": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "mode"
                        ],
                        "properties": {
                          "mode": {
                            "enum": [
                              "off",
                              "serve",
                              "funnel"
                            ]
                          }
                        }
                      }
                    }
                  },
                  "plugins": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "entries"
                    ],
                    "properties": {
                      "entries": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "acpx",
                          "openai",
                          "codex"
                        ],
                        "properties": {
                          "acpx": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "enabled",
                              "config"
                            ],
                            "properties": {
                              "enabled": {
                                "type": "boolean"
                              },
                              "config": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "permissionMode"
                                ],
                                "properties": {
                                  "permissionMode": {
                                    "enum": [
                                      "approve-all",
                                      "approve-reads",
                                      "deny-all"
                                    ]
                                  }
                                }
                              }
                            }
                          },
                          "openai": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "enabled"
                            ],
                            "properties": {
                              "enabled": {
                                "type": "boolean"
                              }
                            }
                          },
                          "codex": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "enabled"
                            ],
                            "properties": {
                              "enabled": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "messages": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "groupChat"
                    ],
                    "properties": {
                      "groupChat": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "visibleReplies"
                        ],
                        "properties": {
                          "visibleReplies": {
                            "enum": [
                              "automatic",
                              "message_tool"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              "litellm": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "endpoint",
                  "existingSecret",
                  "existingSecretKey"
                ],
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "format": "uri"
                  },
                  "existingSecret": {
                    "type": "string",
                    "minLength": 1
                  },
                  "existingSecretKey": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "agent": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "primary",
                      "fallbacks"
                    ],
                    "properties": {
                      "primary": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fallbacks": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    }
                  }
                }
              }
            }
          },
          "readonlyBindings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modelRoute",
              "embedding",
              "installedRuntime",
              "deployment",
              "bootstrapContextRef",
              "originalRunAndRecoveryAuthority"
            ],
            "properties": {
              "modelRoute": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "primary",
                  "fallbacks",
                  "sourceRef"
                ],
                "properties": {
                  "primary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fallbacks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "embedding": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "providerRef",
                  "modelCatalogueReceipt",
                  "serviceSourceRef",
                  "credential"
                ],
                "properties": {
                  "providerRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "modelCatalogueReceipt": {
                    "const": "external-required"
                  },
                  "serviceSourceRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "credential": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "authoritySourceRef",
                      "locator",
                      "revisionCapability",
                      "originalRevisionReceipt",
                      "accessGrantReceipt",
                      "confidentialTransport"
                    ],
                    "properties": {
                      "authoritySourceRef": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revisionCapability": {
                        "const": "requires-authentic-supported-original-revision-retention-or-block"
                      },
                      "originalRevisionReceipt": {
                        "const": "external-required-not-fake-pin"
                      },
                      "accessGrantReceipt": {
                        "const": "external-required"
                      },
                      "confidentialTransport": {
                        "const": "original-authenticated-host-provider-to-native-resolved-runtime-snapshot-no-plaintext-config"
                      }
                    }
                  }
                }
              },
              "installedRuntime": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "nativePackageSourceReceipt",
                  "actualImageEqualityReceipt",
                  "agentOwnerReceipt",
                  "harnessModelToolPluginGrantReceipt"
                ],
                "properties": {
                  "version": {
                    "const": "2026.9.5"
                  },
                  "nativePackageSourceReceipt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actualImageEqualityReceipt": {
                    "const": "external-required"
                  },
                  "agentOwnerReceipt": {
                    "const": "external-required"
                  },
                  "harnessModelToolPluginGrantReceipt": {
                    "const": "external-required"
                  }
                }
              },
              "deployment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "instanceId",
                  "namespace",
                  "gatewayPort",
                  "sourceRef"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "nova",
                      "buster",
                      "prism"
                    ]
                  },
                  "instanceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "gatewayPort": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "sourceRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "bootstrapContextRef": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "pointer",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "const": "managed-bootstrap-context.json"
                  },
                  "pointer": {
                    "type": "string",
                    "pattern": "^/contexts/[A-Za-z0-9][A-Za-z0-9._-]*$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "originalRunAndRecoveryAuthority": {
                "const": "original-service/run/session/agent/model/source/trust/grants/credential-revision/deadline/cleanup; no latest or hot-M rebinding"
              }
            }
          }
        }
      }
    }
  }
}
