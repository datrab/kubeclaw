{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "features",
    "tuning",
    "overrides",
    "schemaVersion",
    "components",
    "bindings",
    "pluginSelections",
    "infrastructureSelections",
    "deploymentSelections",
    "engineSelections"
  ],
  "properties": {
    "profile": {
      "const": "standard"
    },
    "features": {
      "const": {
        "observability": true,
        "buster": true,
        "discord_alerts": true
      }
    },
    "tuning": {
      "const": {
        "safety_margins": "high",
        "retention": "high",
        "alerts": "rich",
        "logs": "verbose",
        "checks": "strict",
        "determinism": "strict"
      }
    },
    "overrides": {
      "const": {}
    },
    "schemaVersion": {
      "const": "pipeline-entry.v9"
    },
    "components": {
      "const": {
        "prism-control": "components/prism-control.config.json",
        "prism-studio": "components/prism-studio.config.json",
        "prism-worker": "components/prism-worker.config.json",
        "prism-execution": "components/prism-execution.config.json",
        "buster-engine": "components/buster-engine.config.json",
        "worker-core": "components/worker-core.config.json"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "owner",
          "instanceId",
          "profileId"
        ],
        "properties": {
          "role": {
            "enum": [
              "prism",
              "buster"
            ]
          },
          "owner": {
            "enum": [
              "prism-control",
              "prism-studio",
              "prism-worker",
              "prism-execution",
              "buster-engine",
              "worker-core"
            ]
          },
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "profileId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    },
    "pluginSelections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "packageId",
          "registrationId",
          "instanceId",
          "ownerPath",
          "profileId",
          "serviceInstanceId"
        ],
        "properties": {
          "kind": {
            "enum": [
              "adapter",
              "test-provider",
              "stage"
            ]
          },
          "packageId": {
            "enum": [
              "kubeclaw.api-flow",
              "kubeclaw.http",
              "kubeclaw.openapi",
              "kubeclaw.network-http",
              "kubeclaw.security-providers",
              "kubeclaw.axe",
              "kubeclaw.lighthouse",
              "kubeclaw.playwright",
              "kubeclaw.visual",
              "kubeclaw.architecture-validator",
              "kubeclaw.case-study",
              "kubeclaw.implementation-agent",
              "kubeclaw.pipeline-review",
              "kubeclaw.prism-design",
              "kubeclaw.project-summary",
              "kubeclaw.runtime-dispatch"
            ]
          },
          "registrationId": {
            "enum": [
              "kubeclaw.api-flow:flow",
              "kubeclaw.http:request",
              "kubeclaw.openapi:operations",
              "kubeclaw.network-http:http",
              "kubeclaw.security-providers:headers",
              "kubeclaw.security-providers:dependency-trivy",
              "kubeclaw.security-providers:image-trivy",
              "kubeclaw.security-providers:kubernetes-policy",
              "kubeclaw.security-providers:kubernetes-runtime",
              "kubeclaw.axe:axe",
              "kubeclaw.lighthouse:lighthouse",
              "kubeclaw.playwright:playwright",
              "kubeclaw.visual:visual",
              "kubeclaw.architecture-validator:architecture",
              "kubeclaw.case-study:case-study",
              "kubeclaw.implementation-agent:implementation",
              "kubeclaw.pipeline-review:evidence",
              "kubeclaw.pipeline-review:review",
              "kubeclaw.prism-design:design",
              "kubeclaw.project-summary:summary",
              "kubeclaw.runtime-dispatch:openclaw"
            ]
          },
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "ownerPath": {
            "enum": [
              "plugins/kubeclaw.api-flow.config.json",
              "plugins/kubeclaw.http.config.json",
              "plugins/kubeclaw.openapi.config.json",
              "plugins/kubeclaw.network-http.config.json",
              "plugins/kubeclaw.security-providers.config.json",
              "plugins/kubeclaw.axe.config.json",
              "plugins/kubeclaw.lighthouse.config.json",
              "plugins/kubeclaw.playwright.config.json",
              "plugins/kubeclaw.visual.config.json",
              "plugins/kubeclaw.architecture-validator.config.json",
              "plugins/kubeclaw.case-study.config.json",
              "plugins/kubeclaw.implementation-agent.config.json",
              "plugins/kubeclaw.pipeline-review.config.json",
              "plugins/kubeclaw.prism-design.config.json",
              "plugins/kubeclaw.project-summary.config.json",
              "plugins/kubeclaw.runtime-dispatch.config.json"
            ]
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "serviceInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          }
        }
      }
    },
    "infrastructureSelections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "deploymentInstanceId",
          "ownerPath",
          "profileId"
        ],
        "properties": {
          "role": {
            "const": "postgresql-recovery"
          },
          "deploymentInstanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "ownerPath": {
            "const": "my-values/infra/postgresql-recovery.yaml"
          },
          "profileId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    },
    "deploymentSelections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "deploymentInstanceId",
              "ownerPath",
              "profileId",
              "consumer",
              "serviceInstanceId",
              "busterComponentInstanceId",
              "controlComponentInstanceId"
            ],
            "properties": {
              "role": {
                "const": "buster"
              },
              "deploymentInstanceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "ownerPath": {
                "const": "charts/kubeclaw/values.yaml"
              },
              "profileId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "consumer": {
                "const": "namespace-controller"
              },
              "serviceInstanceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "busterComponentInstanceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "controlComponentInstanceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          },
          {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "deploymentInstanceId",
              "ownerPath",
              "profileId",
              "consumer",
              "serviceInstanceId"
            ],
            "properties": {
              "role": {
                "enum": [
                  "nova",
                  "buster",
                  "prism"
                ]
              },
              "deploymentInstanceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "ownerPath": {
                "const": "charts/kubeclaw/values.yaml"
              },
              "profileId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "consumer": {
                "const": "openclaw-gateway"
              },
              "serviceInstanceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          }
        ]
      }
    },
    "engineSelections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "role",
          "engineId",
          "engineInstanceId",
          "serviceInstanceId",
          "consumer",
          "ownerPath",
          "profileId",
          "controlComponentInstanceId"
        ],
        "properties": {
          "kind": {
            "const": "service-launcher"
          },
          "role": {
            "const": "prism-agent"
          },
          "engineId": {
            "const": "prism-openclaw-launcher"
          },
          "consumer": {
            "const": "prism-agent-bridge"
          },
          "ownerPath": {
            "const": "engines/prism-agent.config.json"
          },
          "engineInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "serviceInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "controlComponentInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          }
        }
      }
    }
  }
}
