{
  "schemaVersion": "gateway-openclaw-profile.v1-proposal",
  "profileId": "NovaCurrent",
  "role": "nova",
  "instanceId": "agent-nova-gateway",
  "managedOpenClaw": {
    "memory": {
      "search": {
        "enabled": true,
        "experimental": {
          "sessionMemory": true
        },
        "sources": [
          "memory",
          "sessions"
        ],
        "provider": "openai-compatible",
        "remote": {
          "baseUrl": "http://litellm.kubeclaw.svc.cluster.local:4000/v1",
          "apiKey": {
            "source": "env",
            "provider": "default",
            "id": "LITELLM_API_KEY"
          }
        },
        "model": "gemini-embedding-001"
      }
    },
    "agents": {
      "defaults": {
        "thinkingDefault": "off",
        "reasoningDefault": "off",
        "modelPolicy": {
          "allow": [
            "openai/gpt-6-astra",
            "openai/gpt-5.6-sol",
            "openai/gpt-5.5"
          ]
        },
        "models": {
          "openai/gpt-6-astra": {
            "agentRuntime": {
              "id": "codex"
            }
          },
          "openai/gpt-5.6-sol": {
            "agentRuntime": {
              "id": "codex"
            }
          },
          "openai/gpt-5.5": {
            "agentRuntime": {
              "id": "codex"
            }
          }
        },
        "workspace": "/home/node/.openclaw/workspace",
        "embeddedAgent": {
          "executionContract": "strict-agentic"
        },
        "contextPruning": {
          "mode": "cache-ttl",
          "ttl": "2h"
        },
        "compaction": {
          "mode": "safeguard",
          "keepRecentTokens": 140000,
          "memoryFlush": {
            "enabled": true
          }
        },
        "subagents": {
          "maxConcurrent": 20,
          "archiveAfterMinutes": 240,
          "runTimeoutSeconds": 43200,
          "maxSpawnDepth": 3
        },
        "contextInjection": "never",
        "timeoutSeconds": 172800
      },
      "entries": {
        "main": {
          "subagents": {
            "allowAgents": [
              "*"
            ]
          },
          "skills": [],
          "skillsLimits": {
            "maxSkillsPromptChars": 1200
          }
        }
      }
    },
    "acp": {
      "enabled": true,
      "backend": "acpx",
      "defaultAgent": "codex",
      "allowedAgents": [
        "claude",
        "codex",
        "kimi",
        "gemini",
        "pi"
      ]
    },
    "tools": {
      "profile": "coding",
      "sessions": {
        "visibility": "all"
      },
      "sessions_spawn": {
        "attachments": {
          "enabled": true
        }
      },
      "exec": {
        "timeoutSeconds": 604800,
        "mode": "full"
      },
      "agentToAgent": {
        "enabled": true
      }
    },
    "commands": {
      "native": "auto",
      "nativeSkills": "auto",
      "restart": true
    },
    "session": {
      "dmScope": "per-channel-peer",
      "resetByType": {
        "group": {
          "mode": "idle",
          "idleMinutes": 43200
        }
      },
      "threadBindings": {
        "enabled": true,
        "idleHours": 999,
        "maxAgeHours": 0
      }
    },
    "channels": {
      "discord": {
        "groupPolicy": "allowlist",
        "streaming": {
          "mode": "partial"
        },
        "guilds": {
          "*": {
            "requireMention": true
          }
        },
        "threadBindings": {
          "enabled": true,
          "idleHours": 999,
          "spawnSessions": true
        },
        "execApprovals": {
          "enabled": true,
          "target": "dm"
        }
      }
    },
    "gateway": {
      "mode": "local",
      "bind": "loopback",
      "controlUi": {
        "dangerouslyAllowHostHeaderOriginFallback": true
      },
      "auth": {
        "mode": "token"
      },
      "tools": {
        "allow": [
          "sessions_spawn",
          "sessions_send",
          "session_status",
          "group:openclaw"
        ]
      },
      "tailscale": {
        "mode": "off"
      }
    },
    "plugins": {
      "entries": {
        "acpx": {
          "enabled": true,
          "config": {
            "permissionMode": "approve-all"
          }
        },
        "openai": {
          "enabled": true
        },
        "codex": {
          "enabled": true
        }
      }
    },
    "messages": {
      "groupChat": {
        "visibleReplies": "automatic"
      }
    }
  },
  "readonlyBindings": {
    "modelRoute": {
      "primary": "openai/gpt-6-astra",
      "fallbacks": [
        "openai/gpt-5.5"
      ],
      "sourceRef": "my-values/nova-values.yaml#/agent/model -> same existing Chart agent.model; current actual source"
    },
    "embedding": {
      "providerRef": "original-registered-core.openai-compatible",
      "modelCatalogueReceipt": "external-required",
      "serviceSourceRef": "my-values/nova-values.yaml#/litellm/endpoint override or charts/kubeclaw/values.yaml#/litellm/endpoint",
      "credential": {
        "authoritySourceRef": "my-values/nova-values.yaml#/litellm/existingSecret+existingSecretKey",
        "locator": "kubernetes-secret:kubeclaw/openclaw-shared-secrets#litellmApiKey",
        "revisionCapability": "requires-authentic-supported-original-revision-retention-or-block",
        "originalRevisionReceipt": "external-required-not-fake-pin",
        "accessGrantReceipt": "external-required",
        "confidentialTransport": "original-authenticated-host-provider-to-native-resolved-runtime-snapshot-no-plaintext-config"
      }
    },
    "installedRuntime": {
      "version": "2026.9.5",
      "nativePackageSourceReceipt": "npm archive1fb6ef4fae447af14f1e3b1028334f39146d181a66a4cce2848d4f741c636340; exact selected OCI bytes/source closure STILL external",
      "actualImageEqualityReceipt": "external-required",
      "agentOwnerReceipt": "external-required",
      "harnessModelToolPluginGrantReceipt": "external-required"
    },
    "deployment": {
      "role": "nova",
      "instanceId": "agent-nova-gateway",
      "namespace": "kubeclaw",
      "gatewayPort": 18789,
      "sourceRef": "my-values/nova-values.yaml + charts/kubeclaw/values.yaml; authentic deployed role/image/grant missing"
    },
    "bootstrapContextRef": {
      "path": "generated-contexts/nova-bootstrap-context.json",
      "pointer": "/contexts/NovaCurrent",
      "sha256": "4313f96e6257d38cc2cdf6599439d1b0cb46dc1780d9c4064e3650edc9cf75b0"
    },
    "originalRunAndRecoveryAuthority": "original-service/run/session/agent/model/source/trust/grants/credential-revision/deadline/cleanup; no latest or hot-M rebinding"
  }
}
