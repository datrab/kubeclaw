{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paths"
  ],
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/(?!/)",
        "maxLength": 2048
      }
    }
  }
}
