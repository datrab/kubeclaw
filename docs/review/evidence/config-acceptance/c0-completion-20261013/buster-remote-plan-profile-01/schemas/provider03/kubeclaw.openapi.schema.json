{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "registrationId",
    "instanceId",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pipeline-registration-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.openapi"
    },
    "registrationId": {
      "const": "kubeclaw.openapi:operations"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "processing",
          "declarations"
        ],
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestTimeoutMs",
              "maximumResponseBytes",
              "maximumSpecFileBytes",
              "maximumSelections",
              "maximumPatternCodeUnits",
              "maximumPatternQuantifier",
              "maximumRequestTimeoutMs",
              "maximumSchemaGraphDepth",
              "maximumRefChainDepth",
              "maximumPayloadDepth"
            ],
            "properties": {
              "requestTimeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300000
              },
              "maximumResponseBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216
              },
              "maximumSpecFileBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "maximumSelections": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "maximumPatternCodeUnits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "maximumPatternQuantifier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "maximumRequestTimeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300000
              },
              "maximumSchemaGraphDepth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "maximumRefChainDepth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "maximumPayloadDepth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          },
          "declarations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceDefaults",
              "retrySafe",
              "matrixFields"
            ],
            "properties": {
              "evidenceDefaults": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "onPass",
                  "onFail",
                  "onError"
                ],
                "properties": {
                  "onPass": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "enum": [
                        "log",
                        "test-report"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-report"
                        }
                      }
                    ]
                  },
                  "onFail": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "enum": [
                        "log",
                        "test-report"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-report"
                        }
                      }
                    ]
                  },
                  "onError": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "enum": [
                        "log"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      }
                    ]
                  }
                }
              },
              "retrySafe": {
                "const": false
              },
              "matrixFields": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
