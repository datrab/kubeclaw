{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "installationRoots",
    "trustedBuiltinRoots",
    "externalTrust"
  ],
  "properties": {
    "schemaVersion": {
      "const": "buster-registry-selection.v1"
    },
    "installationRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trustedBuiltinRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "externalTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedSourceDigests",
        "verifiedAttestations"
      ],
      "properties": {
        "allowedSourceDigests": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "verifiedAttestations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
