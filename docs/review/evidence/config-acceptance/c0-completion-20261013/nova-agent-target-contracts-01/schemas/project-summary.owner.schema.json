{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "instanceId",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pipeline-package-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.project-summary"
    },
    "instanceId": {
      "const": "fixture.project-summary"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "processing"
        ],
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kubeclaw.project-summary:summary"
            ],
            "properties": {
              "kubeclaw.project-summary:summary": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "agentRole": {
                    "type": "string",
                    "minLength": 1
                  },
                  "deliveryManifestEncoding": {
                    "const": "delivery-manifest.utf16-v1"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
