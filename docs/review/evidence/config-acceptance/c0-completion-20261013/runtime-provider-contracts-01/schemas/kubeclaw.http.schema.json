{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "registrationId",
    "instanceId",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pipeline-registration-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.http"
    },
    "registrationId": {
      "const": "kubeclaw.http:request"
    },
    "instanceId": {
      "const": "fixture.http"
    },
    "profiles": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "processing",
          "declarations"
        ],
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestTimeoutMs",
              "maximumResponseBytes"
            ],
            "properties": {
              "requestTimeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300000
              },
              "maximumResponseBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216
              }
            }
          },
          "declarations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceDefaults",
              "retrySafe",
              "matrixFields"
            ],
            "properties": {
              "evidenceDefaults": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "onPass",
                  "onFail",
                  "onError"
                ],
                "properties": {
                  "onPass": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log"
                      ]
                    }
                  },
                  "onFail": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log"
                      ]
                    }
                  },
                  "onError": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log"
                      ]
                    }
                  }
                }
              },
              "retrySafe": {
                "type": "boolean"
              },
              "matrixFields": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "url",
                    "endpointName",
                    "path",
                    "method",
                    "accept",
                    "expectedStatuses",
                    "expectedText",
                    "expectedContentType"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
