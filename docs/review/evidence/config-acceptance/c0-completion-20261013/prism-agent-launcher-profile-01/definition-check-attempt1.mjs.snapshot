// Finite source-specific JSON/Ajv/conservation/serialization+inspected pure host arithmetic.
// No launcher/PG/CLI/gateway/native source module is imported or invoked.
import fs from 'node:fs';import crypto from 'node:crypto';import {createRequire} from 'node:module';
import {parseTimeoutSeconds,resolveGatewayAgentTimeoutMs} from './extracted-host-timeout-helpers.mjs';
const root='/home/node/.openclaw/workspace/kubeclaw-config-c0/';const require=createRequire(root+'package.json');const Ajv=require('ajv/dist/2020.js');
const base=new URL('.',import.meta.url), read=name=>JSON.parse(fs.readFileSync(new URL(name,base),'utf8')),hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
const assert=(v,s)=>{if(!v)throw Error(s);};const ajv=new Ajv({strict:true,allErrors:true});const validate=ajv.compile(read('schemas/prism-agent-launcher.schema.json'));
const current=JSON.parse(fs.readFileSync(root+'contracts/pipeline-worker-core/v1/schemas/pipeline-worker-core.v2.schema.json','utf8'));const validateLimits=ajv.compile(current.$defs.workerAttemptLimits);
let schemaProfiles=0,relationProfiles=0,negatives=0,parserControls=0;
const relation=p=>Number.isSafeInteger(p.limits.timeoutMs+4*p.limits.cleanupTimeoutMs)&&p.claimLifetimeMs>p.limits.timeoutMs+4*p.limits.cleanupTimeoutMs&&p.terminationGraceMs<=p.limits.cleanupTimeoutMs&&p.limits.evidenceBytes>=p.limits.logBytes&&p.limits.evidenceFiles>=1;
const idx=read('profile-index.json');const files=[idx.baseWholeDocument,idx.diagnosticTimeoutWholeDocument,...idx.pairs.map(x=>x.file)];
for(const path of files){const doc=read(path);assert(validate(doc),path+JSON.stringify(validate.errors));for(const p of Object.values(doc.profiles)){assert(validateLimits(p.limits),'native Core limit shape');schemaProfiles++;assert(relation(p),'whole profile relations');relationProfiles++;const seconds=p.limits.timeoutMs/1000;assert(parseTimeoutSeconds({timeout:String(seconds),cfg:{}})===seconds,'verbatim positive host parser');assert(resolveGatewayAgentTimeoutMs(seconds)===(seconds+30)*1000,'no host wait clamp');parserControls+=2;}}
const baseline=read(idx.baseWholeDocument);for(const key of Object.keys(baseline.profiles.standard)){const missing=structuredClone(baseline);delete missing.profiles.standard[key];assert(!validate(missing),'missing'+key);negatives++;}
for(const key of Object.keys(baseline.profiles.standard.limits)){const missing=structuredClone(baseline);delete missing.profiles.standard.limits[key];assert(!validate(missing),'missing'+key);negatives++;}
for(const [key,value] of [['timeoutMs',0],['timeoutMs',999],['timeoutMs',1001],['timeoutMs',2146971000],['logBytes',16777217],['resultBytes',170]]){const bad=structuredClone(baseline);bad.profiles.standard.limits[key]=value;assert(!validate(bad),'typed domain'+key);negatives++;}
for(const mutate of [p=>p.terminationGraceMs=p.limits.cleanupTimeoutMs+1,p=>p.claimLifetimeMs=p.limits.timeoutMs+4*p.limits.cleanupTimeoutMs,p=>p.limits.evidenceBytes=p.limits.logBytes-1]){const bad=structuredClone(baseline);mutate(bad.profiles.standard);assert(!relation(bad.profiles.standard),'relation negative');negatives++;}
const alias=structuredClone(baseline);alias.profiles.standard.timeoutSeconds=900;assert(!validate(alias),'editable CLI alias rejected');negatives++;
assert(parseTimeoutSeconds({timeout:'900',cfg:{agents:{defaults:{timeoutSeconds:0}}}})===900,'explicit positive prevents config fallback');assert(parseTimeoutSeconds({timeout:'0',cfg:{}})===0,'host zero accepted but target excludes');assert(parseTimeoutSeconds({timeout:'900.5',cfg:{}})===undefined||(()=>{try{parseTimeoutSeconds({timeout:'900.5',cfg:{}});return false;}catch{return true;}})(),'fractional parser rejection');
for(const seconds of [1,900,600,2146970]){assert(resolveGatewayAgentTimeoutMs(seconds)===(seconds+30)*1000,'bound no-clamp');parserControls++;}assert(resolveGatewayAgentTimeoutMs(2146971)===2147000000,'actual parser clamps outside selected domain');parserControls++;
const original=read('original-bodies.json');const old=JSON.parse(fs.readFileSync(new URL('../prism-agent-launcher-source-adjudication-01/original-bodies.json',base),'utf8'));assert(JSON.stringify(original)===JSON.stringify(old),'all original bodies/results preserved');const fields=read('field-contracts.json').fields,cases=read('case-contracts.json').cases;assert(fields.length===12&&cases.length===13,'exact count');for(const x of fields)assert(JSON.stringify(x.originalBody)===JSON.stringify(original.fields.find(y=>y.id===x.id)),'field original');for(const x of cases)assert(JSON.stringify(x.originalBody)===JSON.stringify(original.cases.find(y=>y.id===x.id))&&x.status==='not-run','case original/notrun');
const codec=read('serialization-witnesses.json');assert(Buffer.byteLength(JSON.stringify(codec.fixedLocalClosureObject))===171&&codec.JSONstringifySpecialistResultBytes===171,'fixed actual source closure shape');assert(12*(65536+9)===786540,'declared chunk arithmetic not native observation');
for(const x of read('input-identities.json').inputs)assert(hash(x.path)===x.sha256&&x.endSha256===x.sha256,'input/endpin');for(const x of read('source-witnesses.json').sourceLines)assert(hash(x.path)===x.sha256&&fs.readFileSync(x.path,'utf8').split('\n')[x.line-1]===x.expression,'source exactline');
console.log(JSON.stringify({fields:12,cases:13,fullProfileShapeChecks:schemaProfiles,fullProfileRelationChecks:relationProfiles,negativeDefinitionControls:negatives,hostParserArithmeticControls:parserControls,sourceLines:read('source-witnesses.json').sourceLines.length,inputEndPins:read('input-identities.json').inputs.length,fixedClosureBytes:171,currentClaimMs:960000,currentRequiredMs:940000,startupSlackMs:20000,node:process.version,executedFutureCases:0,meaning:'Only definition/source-qualified arithmetic; no productive/native/agent roster/root acceptance'}));
