     1	{{/* Render one immutable OCI image reference. */}}
     2	{{- define "prism.imageRef" -}}
     3	{{- $repository := required "Prism image repository is required" .repository -}}
     4	{{- $digest := required "Prism image digest is required" .digest -}}
     5	{{- if not (regexMatch "^sha256:[0-9a-f]{64}$" $digest) -}}
     6	{{- fail "Prism image digest must be sha256:<64 lowercase hex characters>" -}}
     7	{{- end -}}
     8	{{- printf "%s@%s" $repository $digest -}}
     9	{{- end -}}
