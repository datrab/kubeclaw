{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registryHealth",
    "allowedOrigins",
    "allowedHostSuffixes",
    "allowedPorts",
    "allowedMethods",
    "allowedRequestHeaders",
    "allowWebSocket",
    "maximumRequestBytes",
    "maximumResponseBytes",
    "maximumExecutionMs"
  ],
  "properties": {
    "registryHealth": {
      "const": true
    },
    "allowedOrigins": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https?://[^/?#\\s@]+$"
      }
    },
    "allowedHostSuffixes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
      }
    },
    "allowedPorts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "allowedMethods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DELETE",
          "GET",
          "HEAD",
          "OPTIONS",
          "PATCH",
          "POST",
          "PUT"
        ]
      }
    },
    "allowedRequestHeaders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
      }
    },
    "allowWebSocket": {
      "type": "boolean"
    },
    "maximumRequestBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "maximumResponseBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "maximumExecutionMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    }
  }
}
