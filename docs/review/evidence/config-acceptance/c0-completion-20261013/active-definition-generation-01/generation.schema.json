{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubeclaw.invalid/evidence/config-active-definition-generation.v1.schema.json",
  "title": "C0 active definition generation; shape is not acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "baselineManifestRef",
    "baselineCatalogSha256",
    "inputManifestRef",
    "requirementContextSha256",
    "records",
    "contentSha256",
    "reviewerConfirmation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "config-active-definition-generation.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baselineManifestRef": {
      "$ref": "#/$defs/fileReference"
    },
    "baselineCatalogSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputManifestRef": {
      "$ref": "#/$defs/fileReference"
    },
    "requirementContextSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewerConfirmation": {
      "$ref": "#/$defs/reviewReference"
    }
  },
  "$defs": {
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "bodyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "pointer",
        "bodySha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(|/.*)$"
        },
        "bodySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reviewReference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiptPath",
            "receiptSha256",
            "revisionSha256",
            "kind",
            "id"
          ],
          "properties": {
            "receiptPath": {
              "type": "string",
              "minLength": 1
            },
            "receiptSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "revisionSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "origin",
        "activeBodyRef",
        "change",
        "reviewerConfirmation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "setting",
            "case",
            "requirement",
            "source",
            "candidate",
            "coordinate",
            "native-package",
            "native-map",
            "supplemental",
            "definition-observation"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tag",
                "bodySha256"
              ],
              "properties": {
                "tag": {
                  "const": "baseline"
                },
                "bodySha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tag",
                "sourceEvidenceRefs",
                "requirementIds",
                "reason"
              ],
              "properties": {
                "tag": {
                  "const": "discovered"
                },
                "sourceEvidenceRefs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/bodyReference"
                  }
                },
                "requirementIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "activeBodyRef": {
          "$ref": "#/$defs/bodyReference"
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason",
            "preservedOriginalCaseIds",
            "refinementEvidenceRefs"
          ],
          "properties": {
            "kind": {
              "enum": [
                "unchanged",
                "refined",
                "corrected",
                "discovered"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "preservedOriginalCaseIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "refinementEvidenceRefs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/bodyReference"
              }
            }
          }
        },
        "reviewerConfirmation": {
          "$ref": "#/$defs/reviewReference"
        }
      }
    }
  }
}
