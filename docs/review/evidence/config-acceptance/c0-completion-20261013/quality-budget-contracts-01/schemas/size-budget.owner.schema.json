{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "registrationId",
    "instanceId",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pipeline-registration-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.size-budget"
    },
    "registrationId": {
      "const": "kubeclaw.size-budget:artifact"
    },
    "instanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "processing",
          "declarations"
        ],
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "auto",
                  "file",
                  "tar",
                  "tar-gzip"
                ]
              },
              "maximumTotalBytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maximumFileCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "matchingFiles": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "pattern",
                    "maximumBytes",
                    "requireMatch"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/name"
                    },
                    "pattern": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^[^\\u0000]+$"
                    },
                    "maximumBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "requireMatch": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "maximumGrowthBytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maximumGrowthPercent": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "largestFiles": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "format",
              "maximumTotalBytes",
              "maximumFileCount",
              "matchingFiles",
              "maximumGrowthBytes",
              "maximumGrowthPercent",
              "largestFiles"
            ]
          },
          "declarations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceDefaults",
              "retrySafe",
              "matrixFields"
            ],
            "properties": {
              "evidenceDefaults": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "onPass",
                  "onFail",
                  "onError"
                ],
                "properties": {
                  "onPass": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "size-budget-baseline"
                      ]
                    }
                  },
                  "onFail": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "size-budget-baseline"
                      ]
                    }
                  },
                  "onError": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "size-budget-baseline"
                      ]
                    }
                  }
                }
              },
              "retrySafe": {
                "type": "boolean"
              },
              "matrixFields": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
