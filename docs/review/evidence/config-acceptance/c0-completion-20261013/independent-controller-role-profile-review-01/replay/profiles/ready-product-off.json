{
  "schemaVersion": "controller-role-profile.v1-proposal",
  "profileId": "ready-product-off",
  "role": "buster",
  "settings": {
    "busterNamespaceBroker": {
      "enabled": true,
      "allowedPrefixes": [
        "test"
      ],
      "defaultTtlSeconds": 7200,
      "maxTtlSeconds": 86400,
      "controller": {
        "imageRef": {
          "reference": "namespace-controller",
          "sourceRef": "existing-selected-controller-image-author",
          "receiptStatus": "external-required-no-invented-OCI-digest"
        },
        "imagePullPolicy": "Always",
        "allowedAccess": [
          {
            "subject": "kubeclaw/agent-nova",
            "modes": [
              "deployer"
            ]
          },
          {
            "subject": "kubeclaw/agent-buster",
            "modes": [
              "deployer",
              "tester"
            ]
          }
        ],
        "allowedSourceSecrets": [
          "kubeclaw-fixture-preflight",
          "prism-test-provider",
          "prism-test-runtime",
          "prism-test-postgresql-auth",
          "prism-test-ghcr"
        ],
        "pollIntervalMs": 3000,
        "resources": {
          "requests": {
            "cpu": "50m",
            "memory": "128Mi"
          },
          "limits": {
            "cpu": "500m",
            "memory": "512Mi"
          }
        },
        "readiness": {
          "enabled": false
        },
        "policy": {
          "httpClientTimeoutSeconds": 60,
          "runtimeSecurityRefreshSeconds": 5,
          "runtimeSecurityFutureSkewSeconds": 5,
          "runtimeSecurityMaximumFindings": 4096,
          "runtimeSecurityMaximumSerializedBytes": 65536,
          "apiResponseMaximumBytes": 8388608,
          "apiRequestMaximumBytes": 4194304,
          "apiDiagnosticMaximumBytes": 1024,
          "namespaceDeletionTimeoutSeconds": 120
        }
      }
    }
  },
  "readonlyBindings": {
    "roleApplicability": "enabled-buster-controller",
    "releaseNamespace": "kubeclaw",
    "releaseName": "agent-buster",
    "sharedLease": {
      "apiGroup": "kubeclaw.forgestack.ai",
      "apiVersion": "v1alpha1",
      "groupSettingId": "CMP-buster-engine-clusterInvokers.shared.leaseApiGroup",
      "versionSettingId": "CMP-buster-engine-clusterInvokers.shared.leaseApiVersion"
    },
    "api": {
      "host": "127.0.0.1",
      "port": 18443,
      "origin": "https://127.0.0.1:18443",
      "providerRef": "fixture-cluster-authority",
      "credentialRoot": "/var/run/secrets/kubernetes.io/serviceaccount",
      "namespaceFile": "/var/run/secrets/kubernetes.io/serviceaccount/namespace",
      "tokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token",
      "caFile": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
      "receiptStatus": "external-required"
    },
    "roles": {
      "controllerServiceAccount": "agent-buster-namespace-controller",
      "secretRole": "agent-buster-controller-secrets",
      "deployerRole": "agent-buster-namespace-deployer",
      "testerRole": "agent-buster-namespace-tester"
    },
    "product": {
      "enabled": false,
      "sourceSettingId": "AUTH-PRISM-PRODUCT-ENABLE",
      "selectedControlSourceRef": "config/components/prism-control.config.json#/profiles/local-A/settings/productAuthority/enabled"
    },
    "maximumDemoRetentionSeconds": 9223372036,
    "executionModel": {
      "mode": "serial-reconcileAll-then-sleep",
      "workers": 1,
      "queue": "no-independent-queue-author"
    },
    "storage": {
      "mode": "kubernetes-api-CR-status",
      "epochSeam": "BusterNamespaceLease.status.deliveryPolicyEpoch",
      "localBusinessPVCorStore": false
    },
    "shutdown": {
      "graceSeconds": 180,
      "sourceRef": "charts/kubeclaw/values.yaml#/settings/shutdown/terminationGracePeriodSeconds",
      "mode": "stop-new-admissions-join-original-uncertain-effects-reconcile"
    },
    "resourceNamePrefix": "agent-buster"
  }
}
