    63	func readyText(s string) bool {
    64		return len(s) > 0 && len(s) <= 1024 && !strings.ContainsAny(s, "\x00\r\n")
    65	}
    97	func (c *controller) authenticateReady(ctx context.Context, authorization string) error {
    98		return c.authenticateTransport(ctx, authorization, c.readiness)
    99	}
   100	
   101	func (c *controller) authenticateTransport(ctx context.Context, authorization string, cfg *readinessConfig) error {
   102		if cfg == nil || !strings.HasPrefix(authorization, "Bearer ") || len(authorization) > 16384 {
   103			return errors.New("DEMO_READY_UNAUTHORIZED")
   104		}
   105		token := strings.TrimPrefix(authorization, "Bearer ")
   106		if token == "" || strings.ContainsAny(token, " \r\n\t") {
   107			return errors.New("DEMO_READY_UNAUTHORIZED")
   108		}
   109		var review struct {
   110			Status struct {
   111				Authenticated bool     `json:"authenticated"`
   112				Audiences     []string `json:"audiences"`
   113				User          struct {
   114					Username string `json:"username"`
   115				} `json:"user"`
   116			} `json:"status"`
   117		}
   118		err := c.kube(ctx, http.MethodPost, "/apis/authentication.k8s.io/v1/tokenreviews", map[string]interface{}{"apiVersion": "authentication.k8s.io/v1", "kind": "TokenReview", "spec": map[string]interface{}{"token": token, "audiences": []string{cfg.Audience}}}, "application/json", &review)
   119		if err != nil || !review.Status.Authenticated || review.Status.User.Username != cfg.Producer || !contains(review.Status.Audiences, cfg.Audience) {
   120			return errors.New("DEMO_READY_UNAUTHORIZED")
   121		}
   122		return nil
   123	}
    17	func (c *controller) configureReadiness() error {
    18		if os.Getenv("BUSTER_READY_LISTEN") == "" {
    19			return nil
    20		}
    21		config := &readinessConfig{Address: os.Getenv("BUSTER_READY_LISTEN"), Audience: os.Getenv("BUSTER_READY_AUDIENCE"), Producer: os.Getenv("BUSTER_READY_PRODUCER"), Certificate: os.Getenv("BUSTER_READY_TLS_CERT"), Key: os.Getenv("BUSTER_READY_TLS_KEY")}
    22		parts := strings.Split(config.Producer, ":")
    23		if len(parts) != 4 || parts[0] != "system" || parts[1] != "serviceaccount" || !readyName.MatchString(parts[2]) || !readyName.MatchString(parts[3]) || !readyText(config.Audience) || config.Certificate == "" || config.Key == "" {
    24			return errors.New("Ready server requires explicit audience, ServiceAccount identity and TLS certificate")
    25		}
    26		if _, _, err := net.SplitHostPort(config.Address); err != nil {
    27			return errors.New("invalid Ready listen address")
    28		}
    29		c.readiness = config
    30		return nil
    31	}
    32	func (c *controller) startReadinessServer(ctx context.Context) error {
    33		if c.readiness == nil {
    34			return nil
    35		}
    36		certificate, err := tls.LoadX509KeyPair(c.readiness.Certificate, c.readiness.Key)
    37		if err != nil {
    38			return errors.New("Ready TLS certificate unavailable")
    39		}
    40		listener, err := tls.Listen("tcp", c.readiness.Address, &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{certificate}})
    58	func (c *controller) configureProduct() error {
    59		enabled := os.Getenv("BUSTER_PRODUCT_ENABLED")
    60		if enabled == "" || enabled == "false" {
    61			return nil
    62		}
    63		if enabled != "true" || c.readiness == nil {
    64			return errors.New("DEMO_PRODUCT_CONFIG_INVALID")
    65		}
    66		key, err := base64.StdEncoding.Strict().DecodeString(os.Getenv("BUSTER_PRODUCT_VERIFY_KEY"))
    67		var actors []string
    68		cfg := &productConfig{Audience: os.Getenv("BUSTER_PRODUCT_AUDIENCE"), Producer: os.Getenv("BUSTER_PRODUCT_PRODUCER"), Issuer: os.Getenv("BUSTER_PRODUCT_ISSUER"), PublicKey: key, Actors: map[string]bool{}}
    69		parts := strings.Split(cfg.Producer, ":")
    70		if err != nil || len(key) != ed25519.PublicKeySize || !readyText(cfg.Audience) || !readyText(cfg.Issuer) || len(parts) != 4 || parts[0] != "system" || parts[1] != "serviceaccount" || !readyName.MatchString(parts[2]) || !readyName.MatchString(parts[3]) || cfg.Producer == c.readiness.Producer || json.Unmarshal([]byte(os.Getenv("BUSTER_PRODUCT_ACTORS_JSON")), &actors) != nil || len(actors) == 0 {
    71			return errors.New("DEMO_PRODUCT_CONFIG_INVALID")
    72		}
    73		for _, actor := range actors {
    74			if !readyText(actor) || cfg.Actors[actor] {
    75				return errors.New("DEMO_PRODUCT_CONFIG_INVALID")
    76			}
    77			cfg.Actors[actor] = true
    78		}
    79		c.product = cfg
    80		return nil
    81	}
   163	func (c *controller) verifyProduct(envelope productEnvelope) (productDecision, string, error) {
   164		var d productDecision
   165		invalid := errors.New("DEMO_PRODUCT_SIGNATURE_INVALID")
   166		if c.product == nil || envelope.SchemaVersion != "demo-product-decision-envelope.v1" {
   167			return d, "", invalid
   168		}
   169		raw, e := base64.StdEncoding.Strict().DecodeString(envelope.Payload)
   170		sig, se := base64.StdEncoding.Strict().DecodeString(envelope.Signature)
   171		if e != nil || se != nil || len(raw) > 8192 || base64.StdEncoding.EncodeToString(raw) != envelope.Payload || base64.StdEncoding.EncodeToString(sig) != envelope.Signature || !ed25519.Verify(c.product.PublicKey, append([]byte(productDomain), raw...), sig) {
   172			return d, "", invalid
   173		}
   174		if e = productJSON(raw, &d); e != nil {
   175			return d, "", e
   176		}
   177		if d.SchemaVersion != "demo-product-decision.v1" || d.Issuer != c.product.Issuer || !c.product.Actors[d.ActorID] || !readyName.MatchString(d.LeaseName) || d.Generation < 1 || d.Generation > 9007199254740991 || !readyText(d.LeaseUID) || !productDecisionID.MatchString(d.DecisionID) || !readyText(d.ExpectedRevision) || len(strings.TrimSpace(d.Reason)) < 1 || len(d.Reason) > 2000 || strings.ContainsAny(d.Reason, "\x00") {
   178			return d, "", errors.New("DEMO_PRODUCT_REQUEST_INVALID")
