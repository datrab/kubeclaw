  1896	func splitCSV(value string) []string {
  1897		parts := strings.Split(value, ",")
  1898		out := []string{}
  1899		for _, part := range parts {
  1900			trimmed := strings.TrimSpace(part)
  1901			if trimmed != "" {
  1902				out = append(out, trimmed)
  1903			}
  1904		}
  1905		return out
    60	var readyDigest = regexp.MustCompile(`^sha256:[a-f0-9]{64}$`)
    61	var readyName = regexp.MustCompile(`^[a-z0-9][a-z0-9.-]{0,252}$`)
