  1883	
  1884	func controllerPollInterval() (time.Duration, error) {
  1885		value := strings.TrimSpace(os.Getenv("BUSTER_CONTROLLER_POLL_MS"))
  1886		if value == "" {
  1887			value = "3000"
  1888		}
  1889		pollMs, err := strconv.ParseInt(value, 10, 64)
  1890		if err != nil || pollMs <= 0 || pollMs > (1<<63-1)/int64(time.Millisecond) {
  1891			return 0, errors.New("BUSTER_CONTROLLER_POLL_MS must be positive")
  1892		}
  1893		return time.Duration(pollMs) * time.Millisecond, nil
  1894	}
