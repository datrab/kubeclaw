function codec(members){const parts=[Buffer.from('kubeclaw.same-entry.input.v1\0')],seen=new Set();for(const m of [...members].sort((a,b)=>Buffer.compare(Buffer.from(a.relativePath),Buffer.from(b.relativePath)))){assert(!seen.has(m.relativePath)&&!path.isAbsolute(m.relativePath)&&m.relativePath.split('/').every(x=>x&&x!=='.'&&x!=='..')&&/^[a-f0-9]{64}$/.test(m.sha256),'CODEC_PATH_HASH');seen.add(m.relativePath);const p=Buffer.from(m.relativePath),l=Buffer.alloc(4),n=Buffer.alloc(8);assert(Number.isSafeInteger(m.byteLength)&&m.byteLength>=0,'CODEC_LENGTH');l.writeUInt32BE(p.length);n.writeBigUInt64BE(BigInt(m.byteLength));parts.push(l,p,n,Buffer.from(m.sha256,'hex'));}return crypto.createHash('sha256').update(Buffer.concat(parts)).digest('hex');}
