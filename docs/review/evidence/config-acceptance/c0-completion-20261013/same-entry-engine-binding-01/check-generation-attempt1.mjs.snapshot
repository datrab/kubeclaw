function authorize(g,caller,request=caller){const keys=caller.scope==='launcher'?['scope','role','engineInstanceId','serviceInstanceId','consumer','controlComponentInstanceId']:caller.scope==='controller'?['scope','role','deploymentInstanceId','consumer','serviceInstanceId']:caller.scope==='recovery'?['scope','role','deploymentInstanceId']:caller.scope==='provider'?['scope','kind','packageId','registrationId','instanceId','serviceInstanceId']:[];assert(keys.length&&keys.length===Object.keys(caller).length&&keys.every(k=>Object.hasOwn(caller,k)),'COMPOSITE_OR_UNKNOWN_CALLER');assert(eq(caller,request),'FOREIGN_OR_CROSS_SCOPE');const selected=g.resolved.filter(x=>x.kind===caller.scope&&keys.every(k=>k==='scope'||x.tuple[k]===caller[k]));assert(selected.length===1,'MISSING_OR_AMBIGUOUS_CALLER_TUPLE');return {oneResolved:selected[0],wholeGenerationValidated:true,authorization:'PUBLIC_STRUCTURE_ONLY_NOT_GRANT',activationAllowed:false};}
