const schemas=new Map();function valid(name,value){if(name==='provider03/kubeclaw.security-providers.schema.json')name='security/kubeclaw.security-providers.schema.json';if(!schemas.has(name)){const a=new Ajv({strict:true,allErrors:true,allowUnionTypes:true,useDefaults:false,coerceTypes:false,removeAdditional:false});formats(a);schemas.set(name,a.compile(read(base+'/schemas/'+name)));}const v=schemas.get(name);assert(v(value),'SCHEMA:'+name+':'+JSON.stringify(v.errors));}
