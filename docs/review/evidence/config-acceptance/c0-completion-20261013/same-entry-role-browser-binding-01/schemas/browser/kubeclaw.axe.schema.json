{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "pipeline-package-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.axe"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profiles",
              "selectedProfiles",
              "tags",
              "exclude",
              "acceptances",
              "timeoutMs"
            ],
            "properties": {
              "profiles": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 34,
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "browser",
                    "viewport",
                    "colorScheme",
                    "reducedMotion",
                    "locale",
                    "timezoneId",
                    "hasTouch",
                    "isMobile",
                    "deviceScaleFactor"
                  ],
                  "properties": {
                    "browser": {
                      "enum": [
                        "chromium",
                        "firefox",
                        "webkit"
                      ]
                    },
                    "viewport": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "width",
                        "height"
                      ],
                      "properties": {
                        "width": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3840
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2160
                        }
                      }
                    },
                    "colorScheme": {
                      "enum": [
                        "light",
                        "dark",
                        "no-preference"
                      ]
                    },
                    "reducedMotion": {
                      "enum": [
                        "reduce",
                        "no-preference"
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "timezoneId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "hasTouch": {
                      "type": "boolean"
                    },
                    "isMobile": {
                      "type": "boolean"
                    },
                    "deviceScaleFactor": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 4
                    }
                  }
                },
                "description": "Derived complete owned merged business map domain: current2 builtin presets plus up to32 distinct custom profiles can expose34 total. Fixed raw legacy import custom32 guard remains current-only; future captured map has no unowned builtin fallback. No native combination/browser/grant cap is raised."
              },
              "selectedProfiles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                  "maxLength": 64
                }
              },
              "tags": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "exclude": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "acceptances": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rule",
                    "route",
                    "selector",
                    "reason",
                    "expiresAt"
                  ],
                  "properties": {
                    "rule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "route": {
                      "type": "string",
                      "pattern": "^/(?!/)[^?#\\r\\n]*$",
                      "maxLength": 1024
                    },
                    "selector": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 1024
                    },
                    "expiresAt": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    }
                  }
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 120000
              }
            }
          },
          "declarations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "retrySafe": {
                "enum": [
                  true,
                  false
                ]
              },
              "matrixFields": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "type": "string"
                }
              },
              "evidenceDefaults": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "onPass": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "test-report",
                        "screenshot"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-report"
                        }
                      }
                    ]
                  },
                  "onFail": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "test-report",
                        "screenshot"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-report"
                        }
                      },
                      {
                        "contains": {
                          "const": "screenshot"
                        }
                      }
                    ]
                  },
                  "onError": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "test-report",
                        "screenshot"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "onPass",
                  "onFail",
                  "onError"
                ]
              }
            },
            "required": [
              "retrySafe",
              "matrixFields",
              "evidenceDefaults"
            ]
          }
        },
        "required": [
          "processing",
          "declarations"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "instanceId",
    "profiles"
  ]
}
