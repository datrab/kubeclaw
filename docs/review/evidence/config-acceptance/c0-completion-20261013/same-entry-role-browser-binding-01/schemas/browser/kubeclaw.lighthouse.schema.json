{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "pipeline-package-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.lighthouse"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "settings",
              "byPurpose"
            ],
            "properties": {
              "settings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schemaVersion",
                  "profiles",
                  "budgets"
                ],
                "properties": {
                  "schemaVersion": {
                    "const": "kubeclaw.lighthouse-settings.v1"
                  },
                  "profiles": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 32,
                    "propertyNames": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "formFactor",
                        "screen",
                        "throttling"
                      ],
                      "properties": {
                        "formFactor": {
                          "enum": [
                            "desktop",
                            "mobile"
                          ]
                        },
                        "screen": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "width",
                            "height",
                            "deviceScaleFactor",
                            "mobile"
                          ],
                          "properties": {
                            "width": {
                              "type": "integer",
                              "minimum": 240,
                              "maximum": 3840
                            },
                            "height": {
                              "type": "integer",
                              "minimum": 240,
                              "maximum": 2160
                            },
                            "deviceScaleFactor": {
                              "type": "number",
                              "minimum": 0.5,
                              "maximum": 4
                            },
                            "mobile": {
                              "type": "boolean"
                            }
                          }
                        },
                        "throttling": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "rttMs",
                            "throughputKbps",
                            "cpuSlowdownMultiplier"
                          ],
                          "properties": {
                            "rttMs": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 5000
                            },
                            "throughputKbps": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 1000000
                            },
                            "cpuSlowdownMultiplier": {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 32
                            }
                          }
                        }
                      }
                    }
                  },
                  "budgets": {
                    "type": "object",
                    "maxProperties": 32,
                    "propertyNames": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [],
                      "properties": {
                        "minimumScore": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "maximumLcpMs": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 120000
                        },
                        "maximumCls": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 10
                        },
                        "maximumTbtMs": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 120000
                        }
                      },
                      "minProperties": 1
                    }
                  }
                }
              },
              "byPurpose": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "performance",
                  "seo",
                  "best-practices"
                ],
                "properties": {
                  "performance": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "runs",
                      "timeoutMs",
                      "selectedProfile",
                      "selectedBudget",
                      "acceptances"
                    ],
                    "properties": {
                      "runs": {
                        "enum": [
                          3,
                          5
                        ]
                      },
                      "timeoutMs": {
                        "type": "integer",
                        "minimum": 10000,
                        "maximum": 180000
                      },
                      "selectedProfile": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                        "type": "string"
                      },
                      "selectedBudget": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "acceptances": {
                        "type": "array",
                        "maxItems": 128,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "audit",
                            "route",
                            "reason",
                            "expiresAt"
                          ],
                          "properties": {
                            "audit": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "route": {
                              "type": "string",
                              "pattern": "^/(?!/)[^?#\\r\\n]*$",
                              "maxLength": 1024
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 8,
                              "maxLength": 1024
                            },
                            "expiresAt": {
                              "type": "string",
                              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "seo": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "runs",
                      "timeoutMs",
                      "selectedProfile",
                      "selectedBudget",
                      "acceptances"
                    ],
                    "properties": {
                      "runs": {
                        "enum": [
                          1
                        ]
                      },
                      "timeoutMs": {
                        "type": "integer",
                        "minimum": 10000,
                        "maximum": 180000
                      },
                      "selectedProfile": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                        "type": "string"
                      },
                      "selectedBudget": {
                        "type": "null"
                      },
                      "acceptances": {
                        "type": "array",
                        "maxItems": 128,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "audit",
                            "route",
                            "reason",
                            "expiresAt"
                          ],
                          "properties": {
                            "audit": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "route": {
                              "type": "string",
                              "pattern": "^/(?!/)[^?#\\r\\n]*$",
                              "maxLength": 1024
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 8,
                              "maxLength": 1024
                            },
                            "expiresAt": {
                              "type": "string",
                              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "best-practices": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "runs",
                      "timeoutMs",
                      "selectedProfile",
                      "selectedBudget",
                      "acceptances"
                    ],
                    "properties": {
                      "runs": {
                        "enum": [
                          1
                        ]
                      },
                      "timeoutMs": {
                        "type": "integer",
                        "minimum": 10000,
                        "maximum": 180000
                      },
                      "selectedProfile": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                        "type": "string"
                      },
                      "selectedBudget": {
                        "type": "null"
                      },
                      "acceptances": {
                        "type": "array",
                        "maxItems": 128,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "audit",
                            "route",
                            "reason",
                            "expiresAt"
                          ],
                          "properties": {
                            "audit": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "route": {
                              "type": "string",
                              "pattern": "^/(?!/)[^?#\\r\\n]*$",
                              "maxLength": 1024
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 8,
                              "maxLength": 1024
                            },
                            "expiresAt": {
                              "type": "string",
                              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "declarations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "retrySafe": {
                "enum": [
                  true,
                  false
                ]
              },
              "matrixFields": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "type": "string"
                }
              },
              "evidenceDefaults": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "onPass": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "performance-report",
                        "performance-report-representative"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "performance-report"
                        }
                      },
                      {
                        "contains": {
                          "const": "performance-report-representative"
                        }
                      }
                    ]
                  },
                  "onFail": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "performance-report",
                        "performance-report-representative"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "performance-report"
                        }
                      },
                      {
                        "contains": {
                          "const": "performance-report-representative"
                        }
                      }
                    ]
                  },
                  "onError": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "performance-report",
                        "performance-report-representative"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "onPass",
                  "onFail",
                  "onError"
                ]
              }
            },
            "required": [
              "retrySafe",
              "matrixFields",
              "evidenceDefaults"
            ]
          }
        },
        "required": [
          "processing",
          "declarations"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "instanceId",
    "profiles"
  ]
}
