{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "pipeline-package-policy.v1"
    },
    "packageId": {
      "const": "kubeclaw.visual"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "processing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profiles",
              "masks",
              "timeoutMs",
              "comparisonProfiles",
              "selectedComparisonProfile",
              "overrides"
            ],
            "properties": {
              "profiles": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 32,
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "browser",
                    "viewport",
                    "colorScheme",
                    "reducedMotion",
                    "locale",
                    "timezoneId",
                    "hasTouch",
                    "isMobile",
                    "deviceScaleFactor"
                  ],
                  "properties": {
                    "browser": {
                      "enum": [
                        "chromium",
                        "firefox",
                        "webkit"
                      ]
                    },
                    "viewport": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "width",
                        "height"
                      ],
                      "properties": {
                        "width": {
                          "type": "integer",
                          "minimum": 240,
                          "maximum": 3840
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 240,
                          "maximum": 2160
                        }
                      }
                    },
                    "colorScheme": {
                      "enum": [
                        "light",
                        "dark",
                        "no-preference"
                      ]
                    },
                    "reducedMotion": {
                      "enum": [
                        "reduce",
                        "no-preference"
                      ]
                    },
                    "locale": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "timezoneId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "hasTouch": {
                      "type": "boolean"
                    },
                    "isMobile": {
                      "type": "boolean"
                    },
                    "deviceScaleFactor": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 4
                    }
                  }
                }
              },
              "masks": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target",
                    "selectors"
                  ],
                  "properties": {
                    "target": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    "selectors": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    }
                  }
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 120000
              },
              "comparisonProfiles": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "strict-v1": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "maximumDifferencePercent",
                      "pixelThreshold",
                      "uncertaintyMarginPercent"
                    ],
                    "properties": {
                      "maximumDifferencePercent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "pixelThreshold": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "uncertaintyMarginPercent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    }
                  },
                  "balanced-v1": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "maximumDifferencePercent",
                      "pixelThreshold",
                      "uncertaintyMarginPercent"
                    ],
                    "properties": {
                      "maximumDifferencePercent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "pixelThreshold": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "uncertaintyMarginPercent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    }
                  }
                },
                "required": [
                  "strict-v1",
                  "balanced-v1"
                ]
              },
              "selectedComparisonProfile": {
                "enum": [
                  "strict-v1",
                  "balanced-v1"
                ]
              },
              "overrides": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maximumDifferencePercent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "pixelThreshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "uncertaintyMarginPercent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          },
          "declarations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "retrySafe": {
                "enum": [
                  true,
                  false
                ]
              },
              "matrixFields": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "type": "string"
                }
              },
              "evidenceDefaults": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "onPass": {
                    "type": "array",
                    "minItems": 5,
                    "maxItems": 5,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "visual-baseline",
                        "visual-current",
                        "visual-difference",
                        "test-report"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "visual-baseline"
                        }
                      },
                      {
                        "contains": {
                          "const": "visual-current"
                        }
                      },
                      {
                        "contains": {
                          "const": "visual-difference"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-report"
                        }
                      }
                    ]
                  },
                  "onFail": {
                    "type": "array",
                    "minItems": 5,
                    "maxItems": 5,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "visual-baseline",
                        "visual-current",
                        "visual-difference",
                        "test-report"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      },
                      {
                        "contains": {
                          "const": "visual-baseline"
                        }
                      },
                      {
                        "contains": {
                          "const": "visual-current"
                        }
                      },
                      {
                        "contains": {
                          "const": "visual-difference"
                        }
                      },
                      {
                        "contains": {
                          "const": "test-report"
                        }
                      }
                    ]
                  },
                  "onError": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "log",
                        "visual-baseline",
                        "visual-current",
                        "visual-difference",
                        "test-report"
                      ]
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "log"
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "onPass",
                  "onFail",
                  "onError"
                ]
              }
            },
            "required": [
              "retrySafe",
              "matrixFields",
              "evidenceDefaults"
            ]
          }
        },
        "required": [
          "processing",
          "declarations"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "instanceId",
    "profiles"
  ]
}
