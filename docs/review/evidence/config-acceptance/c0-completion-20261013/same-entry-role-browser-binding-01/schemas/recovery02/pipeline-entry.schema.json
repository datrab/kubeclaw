{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "features",
    "tuning",
    "overrides",
    "schemaVersion",
    "components",
    "bindings",
    "pluginSelections",
    "infrastructureSelections"
  ],
  "properties": {
    "profile": {
      "const": "standard"
    },
    "features": {
      "const": {
        "observability": true,
        "buster": true,
        "discord_alerts": true
      }
    },
    "tuning": {
      "const": {
        "safety_margins": "high",
        "retention": "high",
        "alerts": "rich",
        "logs": "verbose",
        "checks": "strict",
        "determinism": "strict"
      }
    },
    "overrides": {
      "const": {}
    },
    "schemaVersion": {
      "const": "pipeline-entry.v6"
    },
    "components": {
      "const": {
        "prism-control": "components/prism-control.config.json",
        "prism-studio": "components/prism-studio.config.json",
        "prism-worker": "components/prism-worker.config.json",
        "prism-execution": "components/prism-execution.config.json",
        "buster-engine": "components/buster-engine.config.json",
        "worker-core": "components/worker-core.config.json"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "owner",
          "instanceId",
          "profileId"
        ],
        "properties": {
          "role": {
            "enum": [
              "prism",
              "buster"
            ]
          },
          "owner": {
            "enum": [
              "prism-control",
              "prism-studio",
              "prism-worker",
              "prism-execution",
              "buster-engine",
              "worker-core"
            ]
          },
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "profileId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    },
    "pluginSelections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "packageId",
          "registrationId",
          "instanceId",
          "ownerPath",
          "profileId",
          "serviceInstanceId"
        ],
        "properties": {
          "kind": {
            "enum": [
              "adapter",
              "test-provider"
            ]
          },
          "packageId": {
            "enum": [
              "kubeclaw.api-flow",
              "kubeclaw.http",
              "kubeclaw.openapi",
              "kubeclaw.network-http"
            ]
          },
          "registrationId": {
            "enum": [
              "kubeclaw.api-flow:flow",
              "kubeclaw.http:request",
              "kubeclaw.openapi:operations",
              "kubeclaw.network-http:http"
            ]
          },
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "ownerPath": {
            "enum": [
              "plugins/kubeclaw.api-flow.config.json",
              "plugins/kubeclaw.http.config.json",
              "plugins/kubeclaw.openapi.config.json",
              "plugins/kubeclaw.network-http.config.json"
            ]
          },
          "profileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "serviceInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          }
        }
      }
    },
    "infrastructureSelections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "deploymentInstanceId",
          "ownerPath",
          "profileId"
        ],
        "properties": {
          "role": {
            "const": "postgresql-recovery"
          },
          "deploymentInstanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "ownerPath": {
            "const": "my-values/infra/postgresql-recovery.yaml"
          },
          "profileId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    }
  },
  "$id": "https://kubeclaw.invalid/proposed/recovery-policy-profile-02/entry"
}
