{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receipts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "postgresql-recovery-task-authority.v1"
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "origin",
          "operation",
          "argvSha256",
          "generationRootSha256",
          "policyDocumentSha256",
          "selectedProfileId",
          "deploymentInstanceId",
          "originalC1TaskBindingRef",
          "clock",
          "executionIdentity",
          "inheritedOriginalCeilingTicks",
          "hostCeilingTicks"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "origin": {
            "enum": [
              "scheduled",
              "manual"
            ]
          },
          "operation": {
            "enum": [
              "backup",
              "scheduled",
              "verify",
              "restore",
              "migrate"
            ]
          },
          "argvSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "generationRootSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "policyDocumentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "selectedProfileId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "deploymentInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "originalC1TaskBindingRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactSha256",
              "memberPointer"
            ],
            "properties": {
              "artifactSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "memberPointer": {
                "type": "string",
                "pattern": "^(?:/(?:[^~\u0000]|~[01])*)*$"
              }
            }
          },
          "clock": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "bootId",
              "anchorTicks",
              "expiresTicks",
              "budgetTicks"
            ],
            "properties": {
              "kind": {
                "const": "linux-boot-uptime-10ms.v1"
              },
              "bootId": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "anchorTicks": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "expiresTicks": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "budgetTicks": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
              }
            }
          },
          "executionIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestOrJobUid",
              "originalProcessScopeRef",
              "firstAdmissionId"
            ],
            "properties": {
              "requestOrJobUid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "originalProcessScopeRef": {
                "type": "string",
                "minLength": 1
              },
              "firstAdmissionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "inheritedOriginalCeilingTicks": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
          },
          "hostCeilingTicks": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubeclaw.invalid/proposed/recovery-policy-profile-02/task-authority"
}
