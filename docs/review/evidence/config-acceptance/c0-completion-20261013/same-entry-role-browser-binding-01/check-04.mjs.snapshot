for(const [raw,want]of [['1h30m',5400000],['2147483648ms',2147483648],['100000d',8640000000000],['0',0],['0.4ms',0],['9007199254740991ms',9007199254740991]])record('exact pinned native elapsed TTL parser '+raw,()=>assert(parseDurationMs(raw,{defaultUnit:'m'})===want,'SOURCE_DURATION'));
