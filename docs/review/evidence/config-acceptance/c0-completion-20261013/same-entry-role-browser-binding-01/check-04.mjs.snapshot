const gatewayCaller={scope:'gateway',role:'buster',deploymentInstanceId:'agent-buster',consumer:'openclaw-gateway',serviceInstanceId:'agent-buster-gateway'},oldProvider={scope:'provider',...Object.fromEntries(Object.entries(original.pluginSelections[0]).filter(([k])=>['kind','packageId','registrationId','instanceId','serviceInstanceId'].includes(k)))},browserCaller={scope:'provider',...Object.fromEntries(Object.entries(original.pluginSelections.find(x=>x.packageId==='kubeclaw.axe')).filter(([k])=>['kind','packageId','registrationId','instanceId','serviceInstanceId'].includes(k)))};
const allCallers=[controller,launcher,recovery,oldProvider,provider,browserCaller,gatewayCaller];
