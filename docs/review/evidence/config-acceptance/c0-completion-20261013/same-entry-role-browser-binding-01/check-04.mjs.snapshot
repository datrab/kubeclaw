const launcher={scope:'launcher',role:'prism-agent',engineInstanceId:'fixture.engine.prism-agent',serviceInstanceId:'fixture.service.prism-agent',consumer:'prism-agent-bridge',controlComponentInstanceId:'fixture.service.prism-control'},controller={scope:'controller',role:'buster',deploymentInstanceId:'agent-buster',consumer:'namespace-controller',serviceInstanceId:'agent-buster-namespace-controller'},recovery={scope:'recovery',role:'postgresql-recovery',deploymentInstanceId:'fixture.recovery'},provider={scope:'provider',...Object.fromEntries(Object.entries(original.pluginSelections.at(-1)).filter(([k])=>['kind','packageId','registrationId','instanceId','serviceInstanceId'].includes(k)))};


