const set=read(base+'/file-set-stand.json');function nofollow(p){const segments=path.resolve(p).split(path.sep).filter(Boolean);let current='/';for(const segment of segments){current=path.join(current,segment);assert(!fs.lstatSync(current).isSymbolicLink(),'AUTHOR_SYMLINK');}const fd=fs.openSync(p,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW|fs.constants.O_NONBLOCK);try{const b=fs.fstatSync(fd);assert(b.isFile(),'AUTHOR_NOT_REGULAR');const raw=fs.readFileSync(fd);const a=fs.fstatSync(fd);assert(b.ino===a.ino&&b.dev===a.dev&&b.size===a.size&&b.mtimeMs===a.mtimeMs&&b.ctimeMs===a.ctimeMs,'AUTHOR_READ_DRIFT');return raw;}finally{fs.closeSync(fd);}}
function codec(members){const parts=[Buffer.from('kubeclaw.same-entry.input.v1\0')],seen=new Set();for(const m of [...members].sort((a,b)=>Buffer.compare(Buffer.from(a.relativePath),Buffer.from(b.relativePath)))){assert(!seen.has(m.relativePath)&&!path.isAbsolute(m.relativePath)&&m.relativePath.split('/').every(x=>x&&x!=='.'&&x!=='..')&&/^[a-f0-9]{64}$/.test(m.sha256),'CODEC_PATH_HASH');seen.add(m.relativePath);const p=Buffer.from(m.relativePath),l=Buffer.alloc(4),n=Buffer.alloc(8);assert(Number.isSafeInteger(m.byteLength)&&m.byteLength>=0,'CODEC_LENGTH');l.writeUInt32BE(p.length);n.writeBigUInt64BE(BigInt(m.byteLength));parts.push(l,p,n,Buffer.from(m.sha256,'hex'));}return crypto.createHash('sha256').update(Buffer.concat(parts)).digest('hex');}
record('one physical nofollow input tree exact codec not root-only hash',()=>{for(const m of set.inputMembers){const p=m.relativePath.startsWith('schemas/')?base+'/'+m.relativePath:stand+'/'+m.relativePath,raw=nofollow(p);assert(raw.length===m.byteLength&&crypto.createHash('sha256').update(raw).digest('hex')===m.sha256,'CAPTURED_INPUT');}assert(codec(set.inputMembers)===set.inputGenerationSha256&&set.rootRawSha256===sha(stand+'/config/pipeline.config.json'),'FULL_CODEC');return set.inputMembers.length;});
