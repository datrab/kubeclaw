for(const c of allCallers)for(const d of allCallers)if(!eq(c,d))record('exact caller equality '+c.scope+'/'+c.serviceInstanceId+' vs '+d.scope+'/'+d.serviceInstanceId,()=>authorize(validateGeneration(original),c,d),true);
for(const family of ['Security','Browser'])for(const change of ['foreign-instance','missing-selected-profile'])for(const caller of allCallers)record('same supplied current '+family+'/'+change+' before '+caller.scope,()=>{const slot=family==='Security'?'config/plugins/kubeclaw.security-providers.config.json':'config/plugins/kubeclaw.axe.config.json',o=structuredClone(read(stand+'/'+slot));if(change==='foreign-instance')o.instanceId='foreign.actual.owner';else delete o.profiles.A;valid(family==='Security'?'security/kubeclaw.security-providers.schema.json':'browser/kubeclaw.axe.schema.json',o);let phase='generation';try{const g=validateGeneration(original,{[slot]:o});phase='scope';authorize(g,caller);}catch(e){assert(phase==='generation'&&e.message.includes(family==='Security'?'SECURITY_SERVICE_CLOSURE':'BROWSER_CURRENT_ENTRY'),'CURRENT_OWNER_PHASE');throw e;}},true);
