169:         }
170:       } catch (persistenceError) {
171:         throw new AggregateError([error, persistenceError], 'WORKER_NATIVE_RECONCILIATION_RECORD_FAILED');
172:       }
173:       throw error;
174:     }
175:   }
176: }
