1: import { validatePrism } from "@kubeclaw/prism-contracts-v1";
2: import { authorizeProxiedSpiffePeer } from "@kubeclaw/worker-core";
3: import { createHmac, randomUUID, timingSafeEqual } from "node:crypto";
4: import { type IncomingMessage, type ServerResponse } from "node:http";
5: import { admitDesignAgent } from "../control/agent-admission.ts";
6: import {
7:   approvedRoundBaseline,
8:   assertArchitectureTransition,
9:   startDesignRound,
10: } from "../control/design-generations.ts";
11: import { authorizePipelinePreferenceSubject } from "../control/pipeline-preference-subject.ts";
12: import { inTransaction } from "../storage/index.ts";
13: 
14: import type { ControlContext } from "./control-context.ts";
15: import { json } from "./control-http.ts";
16: type RouteContext = Pick<ControlContext, "config" | "pool" | "artifacts">;
17: 
18: export async function dispatchRoute(
19:   context: RouteContext,
20:   request: IncomingMessage,
21:   response: ServerResponse,
22:   url: URL,
23: ): Promise<boolean> {
24:   if (url.pathname === "/v1/dispatch" && request.method === "POST") {
25:     await dispatchDesign(context, request, response);
26:     return true;
27:   }
28:   return false;
29: }
30: async function dispatchDesign(
31:   context: RouteContext,
32:   request: IncomingMessage,
33:   response: ServerResponse,
34: ) {
35:   const controlConfig = context.config;
36:   const { pool, artifacts } = context;
37:   const { trustedControlSpiffeId } = context.config;
38: 
39:   const { raw, key } = await authenticateDispatch(context.config, request);
40:   const payload = JSON.parse(raw.toString("utf8")) as DispatchPayload;
41:   const preferenceSubjectId = authorizePipelinePreferenceSubject(
42:     payload.preferenceSubjectId,
43:     controlConfig.pipelinePreferenceSubject,
44:   );
45:   const designRequest = validatePrism<DesignRequest>(
46:     "designRequest",
47:     payload.request,
48:   );
49:   const projectKey = designRequest.projectId;
50:   const project = await persistDesignRequest(pool, designRequest);
51:   if (!designRequest.approvalId) {
52:     const preferences = await startDesignRound(pool, {
53:       projectId: projectKey,
54:       subjectId: preferenceSubjectId,
55:       startKey: `dispatch:${key}`,
56:       architectureDigest: designRequest.architecture.contentDigest,
57:       architectureRevision: designRequest.architecture.revision,
58:     });
59:     const agent = await admitDesignAgent(
60:       pool,
61:       `${trustedControlSpiffeId}/prism/main/v2`,
62:       projectKey,
63:       preferences,
64:     );
65:     return json(response, 202, {
66:       result: { status: "waiting", projectId: project.rows[0]!.id },
67:       preferences,
68:       agent,
69:     });
70:   }
71:   const baseline = await approvedRoundBaseline(
72:     pool,
73:     project.rows[0]!.id,
74:     designRequest.approvalId,
75:   );
76:   if (!baseline.rows[0]) throw new Error("approved Prism baseline not found");
77:   return json(response, 200, {
78:     result: {
79:       bundleDigest: baseline.rows[0].bundle_digest,
80:       artifactId: baseline.rows[0].bundle_artifact_id,
81:       archiveBase64: Buffer.from(
82:         await artifacts.get(baseline.rows[0].bundle_artifact_id),
83:       ).toString("base64"),
84:     },
85:   });
86: }
87: 
88: async function authenticateDispatch(
89:   config: ControlContext["config"],
90:   request: IncomingMessage,
91: ) {
92:   const {
93:     spiffeEnabled,
94:     dispatchSecret,
95:     trustedNovaSpiffeId,
96:     trustedPrismAgentSpiffeId,
97:     trustedTestRunnerSpiffeId,
98:   } = config;
99:   if (spiffeEnabled) {
100:     try {
101:       authorizeProxiedSpiffePeer(
102:         request.headers,
103:         request.socket.remoteAddress,
104:         new Set(
105:           [
106:             trustedNovaSpiffeId,
107:             trustedPrismAgentSpiffeId,
108:             trustedTestRunnerSpiffeId,
109:           ].filter(Boolean),
110:         ),
111:       );
112:     } catch {
113:       throw new Error("invalid dispatch identity");
114:     }
115:   }
116:   if (
117:     !(request.headers["content-type"] ?? "")
118:       .toString()
119:       .toLowerCase()
120:       .startsWith("application/json")
121:   )
122:     throw new Error("application/json is required");
123:   const chunks: Buffer[] = [];
124:   let size = 0;
125:   for await (const chunk of request) {
126:     size += chunk.length;
127:     if (size > 2_000_000) throw new Error("request too large");
128:     chunks.push(chunk);
129:   }
130:   const raw = Buffer.concat(chunks);
131:   const key = String(request.headers["idempotency-key"] ?? "");
132:   if (!key) throw new Error("invalid dispatch idempotency key");
133:   if (!spiffeEnabled) {
134:     const supplied = String(
135:       request.headers["x-kubeclaw-signature"] ?? "",
136:     ).replace(/^v1=/, "");
137:     const expected = createHmac("sha256", dispatchSecret)
138:       .update(`${key}.${raw.toString("utf8")}`)
139:       .digest();
140:     const actual = Buffer.from(supplied, "hex");
141:     if (actual.length !== expected.length || !timingSafeEqual(actual, expected))
142:       throw new Error("invalid dispatch signature");
143:   }
144:   return { raw, key };
145: }
146: 
147: type DesignRequest = {
148:   schema: "prism.design-request.v1";
149:   projectId: string;
150:   architecture: { artifactId: string; contentDigest: string; revision: number };
151:   architectureContent: Record<string, unknown>;
152:   approvalId?: string;
153: };
154: async function persistDesignRequest(
155:   pool: ControlContext["pool"],
156:   designRequest: DesignRequest,
157: ) {
158:   const projectKey = designRequest.projectId;
159:   const project = await pool.query<{ id: string }>(
160:     "INSERT INTO prism.project(id,external_id,name) VALUES($1,$2,$3) ON CONFLICT(external_id) DO UPDATE SET updated_at=now() RETURNING id",
161:     [randomUUID(), projectKey, projectKey],
162:   );
163:   await inTransaction(pool, async (requestClient) => {
164:     await requestClient.query(
165:       "SELECT id FROM prism.project WHERE id=$1 FOR UPDATE",
166:       [project.rows[0]!.id],
167:     );
168:     const active = await requestClient.query<{
169:       architecture_digest: string;
170:       architecture_revision: number | string;
171:       request: Record<string, unknown>;
172:     }>(
173:       "SELECT architecture_digest,architecture_revision,request FROM prism.design_request WHERE project_id=$1 AND status='active' ORDER BY architecture_revision DESC LIMIT 1",
174:       [project.rows[0]!.id],
175:     );
176:     if (active.rows[0])
177:       assertArchitectureTransition(active.rows[0], designRequest);
178:     await requestClient.query(
179:       "UPDATE prism.design_request SET status='superseded' WHERE project_id=$1 AND architecture_revision<$2 AND status='active'",
180:       [project.rows[0]!.id, designRequest.architecture.revision],
181:     );
182:     await requestClient.query(
183:       "INSERT INTO prism.design_request(id,project_id,architecture_artifact_id,architecture_digest,architecture_revision,request,status) VALUES($1,$2,$3,$4,$5,$6::jsonb,'active') ON CONFLICT(project_id,architecture_revision) DO UPDATE SET architecture_artifact_id=excluded.architecture_artifact_id,architecture_digest=excluded.architecture_digest,request=excluded.request,status='active'",
184:       [
185:         randomUUID(),
186:         project.rows[0]!.id,
187:         designRequest.architecture.artifactId,
188:         designRequest.architecture.contentDigest,
189:         designRequest.architecture.revision,
190:         JSON.stringify(designRequest),
191:       ],
192:     );
193:   });
194:   return project;
195: }
196: 
197: interface DispatchPayload {
198:   preferenceSubjectId?: string;
199:   request?: {
200:     projectId?: string;
201:     approvalId?: string;
202:     schema?: string;
203:     architecture?: { artifactId?: string; contentDigest?: string };
204:     architectureContent?: unknown;
205:   };
206: }

SOURCE skills/prism/server/native-worker-execution.ts SHA256 d87eb7d05cdc40f3eb353dba63236fa8c20a02adf1b70512c81944bb7cb71a56
1: import { prismAttemptResourceLimits } from '../config/resource-policy.ts';
2: import { fileURLToPath } from 'node:url';
3: import path from 'node:path';
4: import { executeNativeWorkerAttempt, NativeAttemptJournal, recoverNativeWorkerAttempts, type NativeWorkerOwnership } from '@kubeclaw/worker-core';
5: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
6: import { prismNativeWorkerProfile } from '../engine/worker-envelope.ts';
7: import type { nativePrismSupervisorConfig } from '../config/native-worker.ts';
8: import type { loadWorkerConfig } from './worker-config.ts';
9: 
10: /** Only serializable trusted configuration crosses into the per-attempt host. */
11: export async function nativePrismExecution(owner: NativeWorkerOwnership, native: ReturnType<typeof nativePrismSupervisorConfig>,
12:   config: ReturnType<typeof loadWorkerConfig>) {
13:   const journal = new NativeAttemptJournal(path.join(native.ownershipRoot, 'attempt-journal'), {
14:     maximumRecords: native.maximumRecords, maximumStateBytes: native.maximumBytes,
15:     maximumTotalBytes: native.maximumJournalBytes, maximumInputBytes: native.maximumInputBytes,
16:     maximumOutputBytes: native.maximumOutputBytes, maximumResultBytes: native.maximumResultBytes,
17:   });
18:   await recoverNativeWorkerAttempts(journal, owner);
19:   const command = nativePrismCommand(native, config);
20:   return {
21:     ready: () => owner.isReady(),
22:     async execute(envelope: WorkerAttemptEnvelopeV3, signal: AbortSignal) {
23:       validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
24:       const recovered = await journal.hasAttempt(envelope);
25:       if (!recovered && envelope.profile.profileDigest !== prismNativeWorkerProfile.profileDigest) throw new Error('PRISM_NATIVE_PROFILE_NOT_ACCEPTED');
26:       const resourceLimits = prismAttemptResourceLimits(envelope, native.policy, recovered);
27:       return executeNativeWorkerAttempt({ envelope, journal, process: { owner, command, signal,
28:         limits: { ...resourceLimits,
29:           timeoutMs: envelope.limits.timeoutMs + 8 * envelope.limits.cleanupTimeoutMs,
30:           maximumInputBytes: native.maximumInputBytes, maximumOutputBytes: native.maximumOutputBytes,
31:           pollIntervalMs: native.pollIntervalMs, closeTimeoutMs: native.closeTimeoutMs },
32:       } });
33:     },
34:   };
35: }
36: 
37: /** Build a closed child environment from the startup snapshot, never process.env. */
38: export function nativePrismCommand(native: ReturnType<typeof nativePrismSupervisorConfig>, config: ReturnType<typeof loadWorkerConfig>) {
39:   return { launcher: native.launcher, uid: native.uid, gid: native.gid, executable: process.execPath,
40:     arguments: [fileURLToPath(new URL('./native-worker-host.ts', import.meta.url))], cwd: process.cwd(),
41:     environment: { PATH: '/usr/local/bin:/usr/bin:/bin', HOME: '/tmp', NODE_ENV: 'production',
42:       PRISM_ENGINE_CONTENT_DIGEST: native.engineContentDigest,
43:       PLAYWRIGHT_BROWSERS_PATH: native.browserPath, PRISM_CONTROL_INTERNAL_URL: config.controlInternalUrl.toString(),
44:       PRISM_WORKER_SECRET: config.workerSecret, WORKER_TRUST_SPIFFE_ENABLED: String(config.spiffeEnabled),
45:       PRISM_NATIVE_ASSIGNED_INPUT_BYTES: String(native.maximumInputBytes) },
46:   };
47: }

SOURCE skills/prism/server/native-worker-host.ts SHA256 485118712479bd2991724c4787acb4bf111ddd56866d0d584f608482a3b4ba34
1: import { WorkerAttemptExecutor } from '@kubeclaw/worker-core';
2: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { PrismEngine, DeterministicDesignProvider } from '../engine/index.ts';
4: import { WorkerArtifactClient } from './worker-artifacts.ts';
5: import { nativeOperationFor } from './worker-operation.ts';
6: import { nativePrismHostConfig } from '../config/native-worker.ts';
7: 
8: const cancellation = new AbortController();
9: const cancel = () => cancellation.abort(new Error('WORKER_ATTEMPT_CANCELLED'));
10: process.once('SIGTERM', cancel); process.once('SIGINT', cancel);
11: 
12: async function main(): Promise<void> {
13: const config = nativePrismHostConfig();
14: const chunks: Buffer[] = [];
15: let bytes = 0;
16: for await (const chunk of process.stdin) {
17:   bytes += chunk.length;
18:   if (bytes > config.maximumInputBytes) throw new Error('PRISM_NATIVE_INPUT_LIMIT');
19:   chunks.push(Buffer.from(chunk));
20: }
21: const envelope = JSON.parse(Buffer.concat(chunks).toString('utf8')) as WorkerAttemptEnvelopeV3;
22: validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
23: const artifacts = new WorkerArtifactClient(config.controlInternalUrl, config.workerSecret, config.spiffeEnabled);
24: const engine = new PrismEngine(new DeterministicDesignProvider());
25: const result = await new WorkerAttemptExecutor({ envelope, signal: cancellation.signal,
26:   operation: nativeOperationFor(envelope, engine, artifacts, config.scope), receiptNamespace: 'prism-native-provisional',
27:   storeFullLog(attemptId, content, { signal }) {
28:     if (attemptId !== envelope.attemptId) throw new Error('Prism log attempt identity mismatch');
29:     return artifacts.upload('prism-full-log', 'log', 'text/plain', Buffer.from(content), signal);
30:   },
31: }).execute();
32: // Closing stdout is not the completion boundary: the supervisor drains the tree and reseals.
33: process.stdout.write(JSON.stringify(result));
34: }
35: try { await main(); }
36: finally { process.removeListener('SIGTERM', cancel); process.removeListener('SIGINT', cancel); }

