198:     const hostname = payload.hostname === undefined ? undefined : text(payload.hostname, 'hostname', 63);
199:     if (hostname !== undefined && !DNS_LABEL.test(hostname)) throw new Error('TAILSCALE_EXPOSURE_HOSTNAME_INVALID');
200:     return {leaseName,namespace,timeoutMs,path,hostname};
201:   }
202:   async #prepare(payload: JsonObject, resourceId: string, signal: AbortSignal): Promise<Readonly<Record<string, unknown>>> {
203:     const {leaseName,namespace,timeoutMs,path,hostname}=this.#prepareInput(payload);
204:     const resource = `busternamespaceleases.${this.#apiGroup}`;
205:     for (const verb of ['get', 'patch']) {
206:       const allowed = (await this.#run(['auth', 'can-i', verb, resource, '-n', this.#controllerNamespace], null, signal, this.#shortCommandTimeoutMs)).trim();
207:       if (allowed !== 'yes') throw new Error(`TAILSCALE_EXPOSURE_RBAC_DENIED:${verb}`);
208:     }
209:     const before = await this.#lease(leaseName, signal); const verified = this.#verifyLease(before, payload, namespace);
210:     const identity = exposureIdentity(resourceId, payload); const { owner } = identity;
211:     assertHandoffSourceRequest(before,identity);
212:     const pending = payload.retentionMode === 'await-readiness' ? existingExposureHandoff(before,identity) : undefined;
213:     if(pending){
214:       assertRequestedExposure(before,payload);
215:       const ready=await this.#wait(leaseName,'Ready',pending.owner,signal,timeoutMs);
216:       this.#verifyLease(ready,payload,namespace);
217:       const {urlText,publicHost}=this.#publicURL(object(ready.status,'lease.status'),path,hostname);
218:       return {ok:true,leaseName,namespace,url:urlText,hostname:publicHost,createdAt:object(ready.status,'lease.status').createdAt,expiresAt:verified.expiresAt,
219:         releaseAction:ownedReleaseAction(leaseName,this.#controllerNamespace,pending.owner),handoff:observedExposureHandoff(ready,identity)};
220:     }
221:     assertExposureRequest(before, identity);
222:     const metadata = object(before.metadata, 'lease.metadata');
223:     const resourceVersion = text(metadata.resourceVersion, 'lease.resourceVersion', 64);
224:     const alreadyOwned = object(metadata.annotations ?? {}, 'lease.annotations')[EXPOSURE_OWNER_ANNOTATION] === owner;
225:     if (alreadyOwned) assertRequestedExposure(before, payload);
226:     const patch = { metadata: { resourceVersion, annotations: { [EXPOSURE_OWNER_ANNOTATION]: owner,
227:       [EXPOSURE_REQUEST_ANNOTATION]: identity.request, [EXPOSURE_PREDECESSORS_ANNOTATION]: exposurePredecessors(before) } },
228:       spec: { purpose: 'final-preview', exposure: { provider: 'tailscale-ingress',
229:         serviceName: verified.serviceName, servicePort: verified.servicePort, path, hostname: hostname ?? null } } };
230:     try {
231:       if (!alreadyOwned) await this.#run(['patch', 'busternamespacelease', leaseName, '-n', this.#controllerNamespace,
232:         '--type=merge', '-p', JSON.stringify(patch)], null, signal, this.#shortCommandTimeoutMs);
233:       const ready = await this.#wait(leaseName, 'Ready', owner, signal, timeoutMs);
234:       assertRequestedExposure(ready, payload);
235:       this.#verifyLease(ready, payload, namespace);
236:       const status = object(ready.status, 'lease.status');
237:       const { urlText, publicHost } = this.#publicURL(status, path, hostname);
238:       let handoff;
239:       if(payload.retentionMode==='await-readiness'){
240:         const transfer=exposureHandoffPatch(ready,identity);
241:         await this.#run(['patch','busternamespacelease',leaseName,'-n',this.#controllerNamespace,'--type=merge','-p',JSON.stringify(transfer.patch)],null,signal,this.#shortCommandTimeoutMs);
242:         const transferred=await this.#wait(leaseName,'Ready',transfer.handoff.owner,signal,timeoutMs);
243:         this.#verifyLease(transferred,payload,namespace);assertRequestedExposure(transferred,payload);
244:         handoff=observedExposureHandoff(transferred,identity);
245:       }
246:       return Object.freeze({ ok: true, leaseName, namespace, url: urlText, hostname: publicHost,
247:         createdAt: text(status.createdAt, 'createdAt', 64), expiresAt: verified.expiresAt,
248:         releaseAction: ownedReleaseAction(leaseName, this.#controllerNamespace, handoff?.owner ?? owner),...(handoff?{handoff}:{}) });
249:     } catch (error) {
250:       await this.#rollbackFailedPrepare(leaseName, owner, error);
251:       throw error;
252:     }
253:   }
254:   #publicURL(status: JsonObject, path: string, hostname: string | undefined): { urlText: string; publicHost: string } {
255:     const urlText = text(status.previewUrl, 'previewUrl', 2048); const url = new URL(urlText);
256:     if (url.protocol !== 'https:' || url.username || url.password || url.hash || url.origin + url.pathname !== urlText) {
257:       throw new Error('TAILSCALE_EXPOSURE_URL_INVALID');
258:     }
259:     const publicHost = url.hostname.toLowerCase();
260:     if (!this.#suffixes.some((item) => publicHost.endsWith(item) && publicHost.length > item.length)) throw new Error('TAILSCALE_EXPOSURE_HOST_DENIED');
261:     if (status.exposureHostname !== publicHost || url.pathname !== path
262:       || (hostname !== undefined && publicHost !== hostname && !publicHost.startsWith(`${hostname}.`))) throw new Error('TAILSCALE_EXPOSURE_HOST_MISMATCH');
263:     return { urlText, publicHost };
264:   }
265:   async #release(payload: JsonObject, resourceId: string, signal: AbortSignal): Promise<Readonly<Record<string, unknown>>> {
266:     const leaseName = text(payload.leaseName, 'leaseName', 63); if (!DNS_LABEL.test(leaseName)) throw new Error('TAILSCALE_EXPOSURE_LEASE_NAME_INVALID');
267:     const namespace = this.#namespace(payload.namespace);
268:     const before = await this.#lease(leaseName, signal);
269:     const identity = exposureIdentity(resourceId, payload);
270:     const metadata = object(before.metadata, 'lease.metadata');
271:     const annotations = object(metadata.annotations ?? {}, 'lease.annotations');
272:     if (annotations[EXPOSURE_OWNER_ANNOTATION] !== identity.owner) return Object.freeze({ ok: true, leaseName, released: false, superseded: true });
273:     assertExposureRequest(before, identity);
274:     const verified = this.#verifyLease(before, payload, namespace);
275:     const resourceVersion = text(metadata.resourceVersion, 'lease.resourceVersion', 64);
276:     const patch = JSON.stringify({ metadata: { resourceVersion }, spec: { purpose: 'gate', exposure: { provider: 'off' } } });
277:     await this.#run(['patch', 'busternamespacelease', leaseName, '-n', this.#controllerNamespace, '--type=merge', '-p', patch], null, signal, this.#shortCommandTimeoutMs);
278:     const released = await this.#wait(leaseName, 'Off', identity.owner, signal, this.#maximumExecutionMs);
279:     const status = object(released.status, 'lease.status');
280:     if (status.namespaceName !== namespace || status.expiresAt !== verified.expiresAt) throw new Error('TAILSCALE_EXPOSURE_LEASE_CHANGED');
281:     return Object.freeze({ ok: true, leaseName, released: true });
282:   }
283:   async invoke(capability: string, request: TestProviderCapabilityRequest, signal: AbortSignal): Promise<Readonly<Record<string, unknown>>> {
284:     if (capability !== 'kubernetes.exposure' || request.resource.type !== 'kubernetes.exposure'
285:       || !/^kubernetes-exposure:attempt:[A-Za-z0-9._:-]+$/u.test(request.resource.canonicalId)) {
286:       throw new Error('TAILSCALE_EXPOSURE_CAPABILITY_REQUEST_INVALID');
287:     }
288:     const payload = object(request.payload, 'payload');
289:     if (request.operation === 'prepare') return this.#prepare(payload, request.resource.canonicalId, signal);
290:     if (request.operation === 'release') return this.#release(payload, request.resource.canonicalId, signal);
291:     throw new Error('TAILSCALE_EXPOSURE_OPERATION_INVALID');
292:   }
293: }

