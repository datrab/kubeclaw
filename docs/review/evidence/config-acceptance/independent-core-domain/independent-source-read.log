2: import fs from 'node:fs';
3: import path from 'node:path';
4: import { spawn } from 'node:child_process';
5: import type { TestProviderCapabilityInvoker } from './runner.ts';
6: import { kubernetesCredentialEnvironment } from './kubernetes-command-environment.ts';
