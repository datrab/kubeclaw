1: import fs from 'node:fs/promises';
2: import path from 'node:path';
3: import { FileDurableRecordStore, FileDurableBlobStore, type DurableRecord } from '@kubeclaw/plugin-foundation/observability/durable-records';
4: import { ensureDirectoryDurable, withDurableStoreLock } from '@kubeclaw/plugin-foundation/observability/durable-delivery';
5: import { canonicalJson, sha256Digest, checkWorkerNativeResultBinding, validateWorkerResourceContractV3,
6:   type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
7: import { readNativeWorkerOutput } from './native-output-spool.ts';
8: import type { NativeWorkerProcessResult } from './native-worker-process.ts';
9: import { journalIdentity, journalKey, validateJournalState, usedJournalBytes,
10:   type NativeAttemptJournalLimits, type NativeAttemptJournalState } from './native-journal-state.ts';
11: 
12: import { nativeJournalStream, nativeJournalMaximumRecordBytes, reserveNativeJournalMetadata } from './native-journal-capacity.ts';
13: 
14: export type { NativeAttemptJournalLimits } from './native-journal-state.ts';
15: const stream = nativeJournalStream;
16: export class NativeWorkerAttemptBusy extends Error {
17:   constructor() { super('WORKER_NATIVE_ATTEMPT_BUSY'); }
18: }
19: 
20: /** Accepted identity, original output and sealed result outlive the serving process. */
21: export class NativeAttemptJournal {
22:   readonly #root: string;
23:   readonly #limits: NativeAttemptJournalLimits;
24:   readonly #records: FileDurableRecordStore;
25:   readonly #blobs: FileDurableBlobStore;
26: 
27:   constructor(root: string, limits: NativeAttemptJournalLimits) {
28:     if (!path.isAbsolute(root) || Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1)) {
29:       throw new Error('WORKER_NATIVE_JOURNAL_CONFIG_INVALID');
30:     }
31:     this.#root = path.resolve(root); this.#limits = { ...limits };
32:     this.#records = new FileDurableRecordStore(path.join(this.#root, 'metadata'), {
33:       maximumRecords: limits.maximumRecords, maximumBytes: limits.maximumStateBytes, maximumRecordBytes: nativeJournalMaximumRecordBytes,
34:     });
35:     this.#blobs = new FileDurableBlobStore(path.join(this.#root, 'data'), Math.max(limits.maximumInputBytes, limits.maximumResultBytes), limits.maximumTotalBytes);
36:   }
37: 
38:   async withAttempt<T>(input: WorkerAttemptEnvelopeV3,
39:     operation: (context: { envelope: WorkerAttemptEnvelopeV3; newlyAccepted: boolean; acceptedAt: string; outputRoot: string }) => Promise<T>,
40:     validateNewAdmission: (envelope: WorkerAttemptEnvelopeV3) => void = () => {}): Promise<T> {
41:     const envelope = structuredClone(input);
42:     validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
43:     const bytes = Buffer.from(canonicalJson(envelope));
44:     if (bytes.byteLength > this.#limits.maximumInputBytes) throw new Error('WORKER_NATIVE_JOURNAL_INPUT_LIMIT');
45:     await this.#initialize();
46:     const key = journalKey(envelope);
47:     // 256 fixed lock stripes bound rejected-request lock metadata. Equal claims
48:     // serialize across real processes; unrelated stripes can execute together.
49:     let entered = false;
50:     try {
51:       return await withDurableStoreLock(path.join(this.#root, 'fences', key.slice(-2), 'lifetime'), async () => {
52:         entered = true;
53:         const reserved = await this.#reserve(envelope, bytes, validateNewAdmission);
54:         return operation({ envelope, newlyAccepted: reserved.newlyAccepted, acceptedAt: reserved.record.payload.acceptedAt,
55:           outputRoot: this.outputRoot(envelope) });
56:       });
57:     } catch (error) {
58:       if (!entered && error instanceof Error && error.message.startsWith('OBSERVABILITY_STORE_LOCK_FAILED:')
59:         && error.message.endsWith(':OBSERVABILITY_STORE_LOCKED:1:')) throw new NativeWorkerAttemptBusy();
60:       throw error;
61:     }
62:   }
63: 
64:   outputRoot(envelope: WorkerAttemptEnvelopeV3): string { return path.join(this.#root, 'outputs', journalKey(envelope).slice(7)); }
65: 
66:   async *acceptedEnvelopes(): AsyncGenerator<WorkerAttemptEnvelopeV3> {
67:     await this.#initialize();
68:     for (const record of await this.#all()) {
69:       const bytes = await this.#blobs.get(record.payload.envelope.digest);
70:       if (bytes.byteLength !== record.payload.envelope.sizeBytes) throw new Error('WORKER_NATIVE_JOURNAL_ENVELOPE_SIZE_CHANGED');
71:       const envelope = JSON.parse(bytes.toString('utf8')) as WorkerAttemptEnvelopeV3;
72:       validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
73:       if (journalKey(envelope) !== record.idempotencyKey || sha256Digest(envelope) !== record.payload.envelopeDigest
74:         || canonicalJson(journalIdentity(envelope)) !== canonicalJson(record.payload.identity)) throw new Error('WORKER_NATIVE_JOURNAL_IDENTITY_CONFLICT');
75:       yield envelope;
76:     }
77:   }
78: 
79:   async hasAttempt(envelope: WorkerAttemptEnvelopeV3): Promise<boolean> { return (await this.#lookup(envelope)) !== undefined; }
80: 
81:   async readResult(envelope: WorkerAttemptEnvelopeV3): Promise<WorkerAttemptResultV3 | null> {
82:     const record = await this.#lookup(envelope);
83:     if (!record?.payload.result) return null;
84:     const bytes = await this.#blobs.get(record.payload.result.digest);
85:     if (bytes.byteLength !== record.payload.result.sizeBytes) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_SIZE_CHANGED');
86:     const result = JSON.parse(bytes.toString('utf8')) as WorkerAttemptResultV3;
87:     if (!checkWorkerNativeResultBinding(envelope, result).ok) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_BINDING_INVALID');
88:     return result;
89:   }
90: 
91:   async readProcess(envelope: WorkerAttemptEnvelopeV3): Promise<{ process: NativeWorkerProcessResult; completedAt: string } | null> {
92:     const record = await this.#lookup(envelope);
93:     const process = record?.payload.process;
94:     if (!process) return null;
95:     const output = await readNativeWorkerOutput(this.outputRoot(envelope), this.#limits.maximumOutputBytes);
96:     for (const channel of ['stdout', 'stderr'] as const) {
97:       if (output[channel].digest !== process[channel].digest || output[channel].sizeBytes !== process[channel].sizeBytes) {
98:         throw new Error('WORKER_NATIVE_JOURNAL_OUTPUT_CHANGED');
99:       }
100:     }
101:     return { process: { ...process, stdout: output.stdout.bytes, stderr: output.stderr.bytes }, completedAt: record!.payload.processCompletedAt! };
102:   }
103: 
104:   async recordProcess(envelope: WorkerAttemptEnvelopeV3, input: NativeWorkerProcessResult, completedAt: Date): Promise<void> {
105:     const process = structuredClone(input);
106:     const timestamp = completedAt.toISOString();
107:     const record = await this.#required(envelope);
108:     if (record.payload.result || record.payload.process) throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_ALREADY_RECORDED');
109:     const output = await readNativeWorkerOutput(this.outputRoot(envelope), this.#limits.maximumOutputBytes);
110:     if (!output.stdout.bytes.equals(Buffer.from(process.stdout)) || !output.stderr.bytes.equals(Buffer.from(process.stderr))) {
111:       throw new Error('WORKER_NATIVE_JOURNAL_OUTPUT_INCOMPLETE');
112:     }
113:     const reference = (channel: 'stdout' | 'stderr') => ({ digest: output[channel].digest, sizeBytes: output[channel].sizeBytes });
114:     const payload = { ...record.payload, processCompletedAt: timestamp, process: { ...process, stdout: reference('stdout'), stderr: reference('stderr') } };
115:     validateJournalState(payload);
116:     await this.#records.transition(stream, record.idempotencyKey, record.payloadDigest, payload);
117:   }
118: 
119:   async seal(envelope: WorkerAttemptEnvelopeV3, input: WorkerAttemptResultV3): Promise<WorkerAttemptResultV3> {
120:     const result = structuredClone(input);
121:     if (!checkWorkerNativeResultBinding(envelope, result).ok) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_BINDING_INVALID');
122:     const bytes = Buffer.from(canonicalJson(result));
123:     if (bytes.byteLength > this.#limits.maximumResultBytes) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_LIMIT');
124:     return withDurableStoreLock(path.join(this.#root, 'admission', 'lifetime'), async () => {
125:       const record = await this.#required(envelope);
126:       if (record.payload.result) {
127:         if (record.payload.result.digest !== sha256Digest(result)) throw new Error('WORKER_NATIVE_JOURNAL_RESULT_ALREADY_SEALED');
128:         return result;
129:       }
130:       const reference = await this.#blobs.put(bytes);
131:       await this.#records.transition(stream, record.idempotencyKey, record.payloadDigest, { ...record.payload, result: reference });
132:       return result;
133:     });
134:   }
135: 
136:   async #initialize(): Promise<void> {
137:     await ensureDirectoryDurable(path.dirname(this.#root));
138:     try { await fs.mkdir(this.#root, { mode: 0o700 }); }
139:     catch (error) { if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error; }
140:     const stat = await fs.lstat(this.#root);
141:     if (!stat.isDirectory() || stat.uid !== process.getuid!() || (stat.mode & 0o077) !== 0) throw new Error('WORKER_NATIVE_JOURNAL_NOT_PRIVATE');
142:   }
143: 
144:   async #all(): Promise<readonly DurableRecord<NativeAttemptJournalState>[]> {
145:     const records = await this.#records.read<NativeAttemptJournalState>(stream);
146:     for (const record of records) validateJournalState(record.payload);
147:     return records;
148:   }
149: 
150:   async #lookup(envelope: WorkerAttemptEnvelopeV3): Promise<DurableRecord<NativeAttemptJournalState> | undefined> {
151:     await this.#initialize();
152:     const record = (await this.#all()).find(record => record.idempotencyKey === journalKey(envelope));
153:     if (record && (record.payload.envelopeDigest !== sha256Digest(envelope)
154:       || canonicalJson(record.payload.identity) !== canonicalJson(journalIdentity(envelope)))) throw new Error('WORKER_NATIVE_JOURNAL_IDENTITY_CONFLICT');
155:     return record;
156:   }
157: 
158:   async #required(envelope: WorkerAttemptEnvelopeV3): Promise<DurableRecord<NativeAttemptJournalState>> {
159:     const record = await this.#lookup(envelope);
160:     if (!record) throw new Error('WORKER_NATIVE_JOURNAL_RESERVATION_REQUIRED');
161:     return record;
162:   }
163: 
164:   async #reserve(envelope: WorkerAttemptEnvelopeV3, bytes: Buffer, validateNewAdmission: (envelope: WorkerAttemptEnvelopeV3) => void) {
165:     return withDurableStoreLock(path.join(this.#root, 'admission', 'lifetime'), async () => {
166:       const existing = await this.#lookup(envelope);
167:       if (existing) return { newlyAccepted: false, record: existing };
168:       // Reject expired or unsupported new work under the admission lock, before
169:       // retaining input or accepting an identity. Historical replay bypasses it.
170:       validateNewAdmission(envelope);
171:       const reservationBytes = bytes.byteLength + this.#limits.maximumOutputBytes + this.#limits.maximumResultBytes + 65536;
172:       const records = await this.#all();
173:       const pending = records.filter(record => record.payload.result === null).reduce((sum, record) => sum + record.payload.reservationBytes, 0);
174:       const requested = await usedJournalBytes(this.#root) + pending + reservationBytes + 2 * this.#limits.maximumStateBytes;
175:       if (!Number.isSafeInteger(requested) || requested > this.#limits.maximumTotalBytes) throw new Error('WORKER_NATIVE_JOURNAL_CAPACITY_EXCEEDED');
176:       const payload: NativeAttemptJournalState = { schemaVersion: 'native-attempt-journal.v1', identity: journalIdentity(envelope),
177:         envelopeDigest: sha256Digest(envelope), envelope: { digest: sha256Digest(envelope), sizeBytes: bytes.byteLength },
178:         acceptedAt: new Date().toISOString(), reservationBytes, process: null, processCompletedAt: null, result: null };
179:       const owner = `native-worker:${sha256Digest(envelope.claim.workerId).slice(7)}`;
180:       await reserveNativeJournalMetadata(path.join(this.#root, 'metadata', 'records', 'store.json'),
181:         payload, journalKey(envelope), owner, this.#limits);
182:       // The global admission lock holds the checked disk reservation while the
183:       // input is fsynced. A crash can leave an unreferenced original blob, which
184:       // remains counted, but never an accepted identity with no recoverable input.
185:       await this.#blobs.put(bytes);
186:       const appended = await this.#records.append(stream, journalKey(envelope), payload, owner);
187:       return { newlyAccepted: true, record: appended.record };
188:     });
189:   }
190: }

SOURCE skills/worker/core/worker/native-attempt-recovery.ts SHA256 f6cef5767983497edd3865667a6b480e8ea75ed34b847bc4f44e8fae02d807bc
1: import { canonicalJson, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
2: import type { WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import type { NativeAttemptJournal } from './native-attempt-journal.ts';
4: import type { NativeWorkerOwnership } from './native-worker-ownership.ts';
5: import { journalIdentity } from './native-journal-state.ts';
6: import { finalizeNativeWorkerResult, interruptedNativeWorkerResult } from './native-result.ts';
7: import { reconcileNativeCleanup, resolveFailedNativeCleanup, type NativeCleanupReconciliation } from './native-cleanup-reconciliation.ts';
8: 
9: /** Called only after native ownership recovery, before exposing HTTP admission. */
10: export async function recoverNativeWorkerAttempts(journal: NativeAttemptJournal, owner: NativeWorkerOwnership,
11:   reconciliation?: NativeCleanupReconciliation): Promise<void> {
12:   try {
13:     // The accepted journal is already bounded by its existing record/state limits.
14:     // Defer only failed cleanup rows so an earlier insertion cannot prevent the
15:     // original operation from producing its separately owned retry proof.
16:     const deferred: Array<{ envelope: WorkerAttemptEnvelopeV3; result: WorkerAttemptResultV3 }> = [];
17:     for await (const envelope of journal.acceptedEnvelopes()) {
18:       const result = await journal.withAttempt(envelope, async context => {
19:         const cached = await journal.readResult(envelope);
20:         if (cached) return cached;
21:         const recovered = await recoverNativeAttempt(journal, owner, envelope, new Date(context.acceptedAt), false);
22:         if (!recovered) throw new Error('WORKER_NATIVE_JOURNAL_RECOVERY_REQUIRED');
23:         return journal.seal(envelope, recovered);
24:       });
25:       if (result.cleanup.state === 'failed' && envelope.operation.contractId === 'kubeclaw.native-source-cleanup@1') {
26:         deferred.push({ envelope, result });
27:         continue;
28:       }
29:       if (result.cleanup.state === 'failed'
30:         && (!reconciliation || !await reconcileNativeCleanup(owner, envelope, result, reconciliation))) owner.fenceAdmission();
31:     }
32:     for (const { envelope, result } of deferred) {
33:       if (!reconciliation || !await resolveFailedNativeCleanup(journal, owner, envelope, result, reconciliation)) {
34:         owner.fenceAdmission();
35:       }
36:     }
37:   } catch (error) { owner.fenceAdmission(); throw error; }
38: }
39: 
40: export async function recoverNativeAttempt(journal: NativeAttemptJournal, ownership: NativeWorkerOwnership, envelope: WorkerAttemptEnvelopeV3,
41:   started: Date, newlyAccepted: boolean): Promise<WorkerAttemptResultV3 | null> {
42:   const owner = await ownership.record(journalIdentity(envelope));
43:   const archived = await journal.readProcess(envelope);
44:   if (archived) {
45:     if (!owner || owner.phase !== 'disposed' || owner.finalObservation === null
46:       || canonicalJson(owner.finalObservation) !== canonicalJson(archived.process.resources)) {
47:       throw new Error('WORKER_NATIVE_JOURNAL_OWNERSHIP_UNPROVEN');
48:     }
49:     return finalizeNativeWorkerResult(envelope, archived.process, started, new Date(archived.completedAt));
50:   }
51:   if (newlyAccepted && !owner) return null;
52:   if (owner && !['disposed', 'abandoned'].includes(owner.phase)) throw new Error('WORKER_NATIVE_RECOVERY_NOT_QUIESCENT');
53:   // The durable journal admission precedes ownership reservation. With intact
54:   // stores, a missing owner means no launch crossed that boundary.
55:   const notLaunched = !owner || ['WORKER_NATIVE_ALLOCATION_NOT_LAUNCHED', 'WORKER_NATIVE_RESERVATION_NOT_LAUNCHED'].includes(owner.diagnosis ?? '');
56:   return interruptedNativeWorkerResult(envelope, started, 'WORKER_NATIVE_INTERRUPTED_RESULT_UNAVAILABLE', owner?.finalObservation ?? null, notLaunched);
57: }

