SOURCE scripts/native-worker-node-policy.mjs SHA256 7986bb2f84676e74098092187514663594bd604096228064dafaecd7af278dc1
1: import fs from 'node:fs';
2: import { load } from 'js-yaml';
3: import { createHash } from 'node:crypto';
4: 
5: export const nativePoolRoot = '/sys/fs/cgroup/kubeclaw.slice/kubeclaw-native-pools.service';
6: 
7: function positive(value) {
8:   if (!Number.isSafeInteger(value) || value < 1) throw new Error('NATIVE_NODE_POLICY_LIMIT_INVALID');
9: }
10: 
11: function resources(value) {
12:   positive(value?.cpuMillicores); positive(value?.memoryBytes);
13:   if (value.memoryBytes % 4096 !== 0) throw new Error('NATIVE_NODE_MEMORY_ALIGNMENT_INVALID');
14: }
15: 
16: export function validateNativeNodePolicy(policy) {
17:   if (policy?.schemaVersion !== 1 || typeof policy.nodeName !== 'string'
18:     || !/^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$/.test(policy.nodeName)) throw new Error('NATIVE_NODE_IDENTITY_REQUIRED');
19:   resources(policy.systemReserve); resources(policy.kubernetesReserve);
20:   positive(policy.systemReserve.tasks); positive(policy.kubernetesReserve.tasks);
21:   if (Object.keys(policy.pools ?? {}).sort().join(',') !== 'buster,prism') throw new Error('NATIVE_NODE_ROLE_SET_INVALID');
22:   for (const pool of Object.values(policy.pools)) {
23:     if (typeof pool.namespace !== 'string' || !/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(pool.namespace)) throw new Error('NATIVE_NODE_NAMESPACE_REQUIRED');
24:     resources(pool); positive(pool.tasks); positive(pool.maximumActiveScopes);
25:     if (pool.cpuMillicores > Number.MAX_SAFE_INTEGER / 100) throw new Error('NATIVE_NODE_CPU_RANGE_INVALID');
26:   }
27:   const result = structuredClone(policy);
28:   for (const key of ['cpuMillicores', 'memoryBytes', 'tasks']) {
29:     const total = Object.values(result.pools).reduce((sum, pool) => sum + BigInt(pool[key]), 0n)
30:       + BigInt(result.systemReserve[key]) + BigInt(result.kubernetesReserve[key]);
31:     if (total > BigInt(Number.MAX_SAFE_INTEGER)) throw new Error('NATIVE_NODE_TOTAL_RANGE_INVALID');
32:   }
33:   return result;
34: }
35: 
36: export function loadNativeNodePolicy(file) { return validateNativeNodePolicy(load(fs.readFileSync(file, 'utf8'))); }
37: 
38: export function nativePoolPolicy(policy, role) {
39:   const selected = validateNativeNodePolicy(policy);
40:   const pool = selected.pools[role];
41:   if (!pool) throw new Error('NATIVE_NODE_ROLE_INVALID');
42:   return { schemaVersion: 1, role, nodeName: selected.nodeName,
43:     policyDigest: createHash('sha256').update(JSON.stringify(selected)).digest('hex'),
44:     cgroupRoot: `${nativePoolRoot}/${role}`, ownershipRoot: `/var/lib/kubeclaw/native/${role}`,
45:     nodeIdentityFile: '/etc/kubeclaw/native-node-id', runtimeIdentityFile: '/etc/kubeclaw/native-runtime-identity.json',
46:     maximumActiveScopes: pool.maximumActiveScopes,
47:     limits: { memoryBytes: pool.memoryBytes, tasks: pool.tasks,
48:       cpuQuotaMicroseconds: pool.cpuMillicores * 100, cpuPeriodMicroseconds: 100000 } };
49: }
50: 
51: export function nativeNodeReservation(policy) {
52:   const selected = validateNativeNodePolicy(policy);
53:   const system = { ...selected.systemReserve };
54:   for (const pool of Object.values(selected.pools)) {
55:     system.cpuMillicores += pool.cpuMillicores; system.memoryBytes += pool.memoryBytes; system.tasks += pool.tasks;
56:   }
57:   return { systemReserved: { cpu: `${system.cpuMillicores}m`, memory: String(system.memoryBytes), pid: String(system.tasks) },
58:     kubeReserved: { cpu: `${selected.kubernetesReserve.cpuMillicores}m`, memory: String(selected.kubernetesReserve.memoryBytes), pid: String(selected.kubernetesReserve.tasks) } };
59: }

