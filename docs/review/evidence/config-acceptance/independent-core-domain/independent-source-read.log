1: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
2: import type { WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { canonicalJson } from '@kubeclaw/pipeline-observability-contract';
4: import type { PreparationGateBinding } from './preparation-gate.ts';
5: 
6: export interface PreparationCleanupEffects {
7:   readonly schemaVersion: 'buster-preparation-cleanup-effects.v1';
8:   readonly admissionId: string;
9:   readonly originalEnvelopeDigest: string;
10:   readonly gate: PreparationGateBinding;
11:   readonly data: { readonly device: number; readonly inode: number; readonly uid: number } | null;
12: }
13: 
14: /** Every retry keeps its immutable predecessor identity; no receipt is replaced. */
15: export interface PreparationCleanupAssociation {
16:   readonly envelope: WorkerAttemptEnvelopeV3;
17:   readonly settings: BusterPreparationSettings;
18:   readonly effects: PreparationCleanupEffects;
19:   readonly previousEnvelopeDigest: string | null;
20:   readonly previousResultDigest: string | null;
21:   readonly resultDigest: string | null;
22: }
23: 
24: /** Journal admission independently enforces this complete serialized-envelope ceiling. */
25: export function preparationCleanupMetadataCapacity(maximumInputBytes: number): number {
26:   const digest = `sha256:${'f'.repeat(64)}`;
27:   const maximum = {
28:     envelope: null, settings: null,
29:     effects: { schemaVersion: 'buster-preparation-cleanup-effects.v1', admissionId: 'f'.repeat(32),
30:       originalEnvelopeDigest: digest,
31:       gate: { preparationUid: 1004, device: Number.MAX_SAFE_INTEGER, inode: Number.MAX_SAFE_INTEGER, markerDigest: digest },
32:       data: { device: Number.MAX_SAFE_INTEGER, inode: Number.MAX_SAFE_INTEGER, uid: 1004 } },
33:     previousEnvelopeDigest: digest, previousResultDigest: digest, resultDigest: digest,
34:   };
35:   // Both the complete envelope and its execution-settings snapshot are bounded by maximumInputBytes.
36:   const bytes = 2 * maximumInputBytes + Buffer.byteLength(canonicalJson(maximum)) - 8 + 1;
37:   if (!Number.isSafeInteger(bytes)) throw new Error('BUSTER_PREPARATION_CLEANUP_CAPACITY_INVALID');
38:   return bytes;
39: }
40: 
41: export function assertPreparationCleanupEffects(value: unknown): asserts value is PreparationCleanupEffects {
42:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('BUSTER_PREPARATION_CLEANUP_EFFECTS_INVALID');
43:   const effects = value as PreparationCleanupEffects;
44:   if (Object.keys(effects).sort().join(',') !== 'admissionId,data,gate,originalEnvelopeDigest,schemaVersion'
45:     || effects.schemaVersion !== 'buster-preparation-cleanup-effects.v1'
46:     || typeof effects.admissionId !== 'string' || !/^[a-f0-9]{32}$/u.test(effects.admissionId)
47:     || typeof effects.originalEnvelopeDigest !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(effects.originalEnvelopeDigest)) {
48:     throw new Error('BUSTER_PREPARATION_CLEANUP_EFFECTS_INVALID');
49:   }
50:   assertGateEffect(effects.gate);
51:   assertDataEffect(effects.data, effects.gate.preparationUid);
52: } 
53: 
54: function assertGateEffect(gate: PreparationGateBinding): void {
55:   const integer = (item: unknown) => typeof item === 'number' && Number.isSafeInteger(item) && item >= 0;
56:   if (!gate || Object.keys(gate).sort().join(',') !== 'device,inode,markerDigest,preparationUid'
57:     || ![1003, 1004].includes(gate.preparationUid)
58:     || ![gate.device, gate.inode].every(integer)
59:     || typeof gate.markerDigest !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(gate.markerDigest)) {
60:     throw new Error('BUSTER_PREPARATION_CLEANUP_EFFECTS_INVALID');
61:   }
62: }
63: 
64: function assertDataEffect(data: PreparationCleanupEffects['data'], uid: number): void {
65:   if (data === null) return;
66:   const integer = (item: unknown) => typeof item === 'number' && Number.isSafeInteger(item) && item >= 0;
67:   if (!data || Object.keys(data).sort().join(',') !== 'device,inode,uid'
68:     || ![data.device, data.inode].every(integer) || data.uid !== uid) {
69:     throw new Error('BUSTER_PREPARATION_CLEANUP_EFFECTS_INVALID');
70:   }
71: }

SOURCE skills/buster/engine/test-gates/preparation-cleanup-envelope.ts SHA256 837f2b0c6acf2ab0afb56e6a54857fefc15272f8c5c026a3c796e4fd55d9e166
1: import { randomBytes } from 'node:crypto';
2: import { nativeSourceCleanupOperation, workerAttemptSpecDigest, workerProfileDigest } from '@kubeclaw/worker-core';
3: import { validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3,
4:   type WorkerAttemptResultV3, type WorkerProfileV3 } from '@kubeclaw/pipeline-worker-core-contract';
5: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
6: import { preparationEnvelope, preparationProfile } from './preparation-envelope.ts';
7: import { preparationDigest } from './preparation-header.ts';
8: import { assertPreparationCleanupEffects, type PreparationCleanupEffects } from './preparation-cleanup-binding.ts';
9: 
10: export function preparationCleanupProfile(engineContentDigest: string): WorkerProfileV3 {
11:   const base = preparationProfile(engineContentDigest);
12:   const profile = { ...base, profileId: 'buster-native-source-cleanup-v1',
13:     engine: { ...base.engine, engineId: 'buster-native-source-cleanup', contractId: 'kubeclaw.native-source-cleanup@1' } };
14:   return { ...profile, profileDigest: workerProfileDigest(profile) };
15: }
16: 
17: /** A fresh attempt has fresh claim identity, while the original effect and receipt stay exact. */
18: export function preparationCleanupEnvelope(original: WorkerAttemptEnvelopeV3, result: WorkerAttemptResultV3,
19:   effects: PreparationCleanupEffects, settings: BusterPreparationSettings, engineContentDigest: string): WorkerAttemptEnvelopeV3 {
20:   assertPreparationCleanupEffects(effects);
21:   const base = preparationEnvelope(randomBytes(16).toString('hex'), preparationCleanupProfile(engineContentDigest),
22:     settings, new Date(), effects.gate.preparationUid, { kind: 'stage' });
23:   const unsigned = { ...base, nodeId: 'cleanup-source',
24:     operation: nativeSourceCleanupOperation(original, result, preparationDigest(effects)) };
25:   const envelope = { ...unsigned, attemptSpecDigest: workerAttemptSpecDigest(unsigned) };
26:   validateWorkerResourceContractV3('workerAttemptEnvelope', envelope);
27:   return envelope;
28: }

SOURCE skills/buster/engine/test-gates/preparation-cleanup-execution.ts SHA256 7f68045db88cfea003fb204b06c61b5cef0d48ff0bb416fa060dceeb33249365
1: import { executeNativeWorkerAttempt, recoverNativeAttempt, verifyNativeSourceCleanupResult } from '@kubeclaw/worker-core';
2: import type { WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import type { PreparationCleanupAssociation } from './preparation-cleanup-binding.ts';
4: import type { PreparationExecutionOptions } from './preparation-execution.ts';
5: import { preparationCommand } from './preparation-command.ts';
6: import { preparationDigest } from './preparation-header.ts';
7: 
8: /** Existing predecessor recovery reuses Core's exact finalizer without launching or unfencing. */
9: export async function recoverPreparationCleanup(options: PreparationExecutionOptions,
10:   association: PreparationCleanupAssociation): Promise<WorkerAttemptResultV3 | null> {
11:   if (!await options.journal.hasAttempt(association.envelope)) return null;
12:   return options.journal.withAttempt(association.envelope, async context => {
13:     if (context.newlyAccepted) throw new Error('BUSTER_PREPARATION_CLEANUP_PREDECESSOR_MISSING');
14:     const cached = await options.journal.readResult(association.envelope);
15:     if (cached) return cached;
16:     const result = await recoverNativeAttempt(options.journal, options.owner, association.envelope,
17:       new Date(context.acceptedAt), false);
18:     if (!result) throw new Error('BUSTER_PREPARATION_CLEANUP_RECOVERY_REQUIRED');
19:     return options.journal.seal(association.envelope, result);
20:   });
21: }
22: 
23: /** Only this invocation's new cleanup may launch; a new failure keeps the owner fenced. */
24: export async function executePreparationCleanup(options: PreparationExecutionOptions,
25:   association: PreparationCleanupAssociation): Promise<WorkerAttemptResultV3> {
26:   const { envelope, settings, effects } = association;
27:   const command = preparationCommand(effects.admissionId, settings, options.command, effects.gate.preparationUid, 'cleanup');
28:   const encoded = JSON.stringify({ effects, settings });
29:   if (Buffer.byteLength(encoded) > settings.maximumInputBytes) throw new Error('BUSTER_PREPARATION_CLEANUP_INPUT_LIMIT');
30:   const result = await executeNativeWorkerAttempt({ envelope, journal: options.journal, process: {
31:     owner: options.owner,
32:     command: { ...command, environment: { ...command.environment, BUSTER_PREPARATION_ASSIGNED_CLEANUP: encoded } },
33:     limits: { cpuTimeMs: settings.resourcePolicy.cpuTimeMs, memoryBytes: settings.resourcePolicy.memoryBytes,
34:       tasks: settings.resourcePolicy.tasks, timeoutMs: settings.timeoutMs + 8 * settings.cleanupTimeoutMs,
35:       maximumInputBytes: settings.maximumInputBytes, maximumOutputBytes: settings.maximumOutputBytes,
36:       pollIntervalMs: settings.pollIntervalMs, closeTimeoutMs: settings.closeTimeoutMs },
37:   } });
38:   await options.ledger.recordCleanupResult(effects.admissionId, preparationDigest(envelope), result.resultDigest);
39:   await verifyNativeSourceCleanupResult(options.journal, options.owner, envelope);
40:   return result;
41: }

