238:   /** Caller must first verify the exact native cleanup receipt and retained archive identity. */
239:   async repositoryReleased(admissionId: string, archiveBytes: number, metadataBytes: number): Promise<void> {
240:     if (![archiveBytes, metadataBytes].every(value => Number.isSafeInteger(value) && value >= 0)) {
241:       throw new Error('BUSTER_PREPARATION_RELEASE_INVALID');
242:     }
243:     await this.#transition(admissionId, current => {
244:       if (!current.source || current.source.archiveBytes !== archiveBytes || current.phase === 'released') {
245:         throw new Error('BUSTER_PREPARATION_RELEASE_INVALID');
246:       }
247:       const bytes = archiveBytes + metadataBytes + 6 * this.#settings.sourceEntryReservationBytes;
248:       if (bytes > current.bytes) throw new Error('BUSTER_PREPARATION_RELEASE_INVALID');
249:       return { ...current, phase: 'repository-released', bytes, entries: 6 };
250:     });
251:   }
252: 
253:   /** Never called merely because a child exited; exact quiescence and owned absence are prerequisites. */
254:   async released(admissionId: string): Promise<void> {
255:     await this.#transition(admissionId, current => ({ ...current, phase: 'released', slotReleased: true, bytes: 0, entries: 0 }));
256:   }
257: 
258:   /** The association is fsynced before any cleanup process can remove owned source. */
259:   async reserveCleanup(admissionId: string, association: PreparationCleanupAssociation): Promise<void> {
260:     association = structuredClone(association);
261:     await this.#transition(admissionId, current => {
262:       if (current.slotReleased || !['staging', 'reserved'].includes(current.phase) || !current.gate) {
263:         throw new Error('BUSTER_PREPARATION_CLEANUP_INELIGIBLE');
264:       }
265:       const existing = current.cleanup.find(item => item.envelope.attemptId === association.envelope.attemptId);
266:       if (existing) {
267:         if (preparationDigest(existing) !== preparationDigest(association)) throw new Error('BUSTER_PREPARATION_CLEANUP_CONFLICT');
268:         return current;
269:       }
270:       return { ...current, cleanup: [...current.cleanup, association] };
271:     });
272:   }
273: 
274:   /** A result digest is write-once. Failed predecessor receipts remain bound on retry. */
275:   async recordCleanupResult(admissionId: string, envelopeDigest: string, resultDigest: string): Promise<void> {
276:     await this.#transition(admissionId, current => {
277:       const index = current.cleanup.findIndex(item => preparationDigest(item.envelope) === envelopeDigest);
278:       const association = current.cleanup[index];
279:       if (!association || (association.resultDigest !== null && association.resultDigest !== resultDigest)) {
280:         throw new Error('BUSTER_PREPARATION_CLEANUP_CONFLICT');
281:       }
282:       const cleanup = [...current.cleanup];
283:       cleanup[index] = { ...association, resultDigest };
284:       return { ...current, cleanup };
285:     });
286:   }
287: 
288:   async reservations(): Promise<readonly SourceReservation[]> {
289:     return withDurableStoreLock(this.#file, async () => structuredClone((await this.#read()).reservations));
290:   }
291: 
292:   async #transition(admissionId: string, update: (value: SourceReservation) => SourceReservation): Promise<void> {
293:     await withDurableStoreLock(this.#file, async () => {
294:       const state = await this.#read();
295:       const index = state.reservations.findIndex(item => item.admissionId === admissionId);
296:       if (index < 0) throw new Error('BUSTER_PREPARATION_RESERVATION_MISSING');
297:       const reservations = [...state.reservations];
298:       reservations[index] = update(reservations[index]!);
299:       await this.#write({ ...state, reservations });
300:     });
301:   }
302: 
303:   async #read(): Promise<SourceLedger> {
304:     const state = await readDurableState<SourceLedger>(this.#file, empty, this.#settings.maximumMetadataBytes);
305:     validateSourceLedger(state);
306:     return state;
307:   }
308: 
309: 
310:   async #write(state: SourceLedger): Promise<void> {
311:     validateSourceLedger(state);
312:     const bytes = state.reservations.reduce((sum, item) => sum + item.bytes, 0);
313:     const entries = state.reservations.reduce((sum, item) => sum + item.entries, 0);
314:     // Every admitted slot reserves its future terminal reference before native launch.
315:     const metadata = Math.max(Buffer.byteLength(canonicalJson(state)), Buffer.byteLength(canonicalJson({ ...state,
316:       reservations: state.reservations.map(terminalMetadataProjection) })))
317:       + state.reservations.filter(item => item.phase === 'staging' && item.input === null).length
318:         * (this.#settings.maximumHeaderBytes + this.#settings.maximumInputBytes)
319:       + state.reservations.reduce((sum, item) => sum + item.groupMetadataBytes, 0)
320:       + state.reservations.filter(item => !item.slotReleased).length
321:         * preparationCleanupMetadataCapacity(this.#settings.maximumInputBytes);
322:     if (state.reservations.length + state.reservations.reduce((sum, item) => sum + item.groupRecords + item.cleanup.length
323:       + (item.slotReleased ? 0 : 1), 0) > this.#settings.maximumRecords || metadata > this.#settings.maximumMetadataBytes
324:       || !Number.isSafeInteger(bytes) || bytes > this.#settings.maximumSourceBytes
325:       || !Number.isSafeInteger(entries) || entries > this.#settings.maximumSourceEntries) {
326:       throw new Error('BUSTER_PREPARATION_SOURCE_CAPACITY');
327:     }
328:     await writeDurableState(this.#file, state);
329:   }
330: }

SOURCE skills/buster/engine/test-gates/preparation-native-phase.ts SHA256 20362a6d9a4147be607c1006cd42a33465d5b56b7df5acfef04562009abba179
1: import { historicalChannelLimits } from './preparation-historical-channel.ts';
2: import { assertHistoricalImportDescriptor, type HistoricalImportDescriptor } from './preparation-historical-reference.ts';
3: import { validateBusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
4: import { executeNativeWorkerAttempt, type NativeWorkerControlChannel } from '@kubeclaw/worker-core';
5: import type { WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
6: import { assertPreparationSlot } from './preparation-slots.ts';
7: import { preparationCommand } from './preparation-command.ts';
8: import { preparationHostChannelLimits } from './preparation-host-channel.ts';
9: import type { PreparationExecutionOptions } from './preparation-execution.ts';
10: 
11: /** Both source phases use the same native owner, journal and quiescence requirement. */
12: export async function runPreparationPhase(options: PreparationExecutionOptions,
13:   envelope: WorkerAttemptEnvelopeV3, signal: AbortSignal,
14:   exchange: (channel: NativeWorkerControlChannel, cancelled: AbortSignal) => Promise<void>) {
15:   const { owner, journal } = options;
16:   const settings = validateBusterPreparationSettings(envelope.operation.values.settings);
17:   const slot = envelope.operation.values.preparationUid;
18:   const admissionId = envelope.operation.values.admissionId;
19:   assertPreparationSlot(slot);
20:   if (typeof admissionId !== 'string') throw new Error('BUSTER_PREPARATION_ADMISSION_ID_INVALID');
21:   const phase = envelope.operation.values.phase as { kind?: unknown; descriptor?: unknown };
22:   const historical = phase?.kind === 'historical';
23:   if (historical) assertHistoricalImportDescriptor(phase.descriptor);
24:   const channelLimits = historical
25:     ? historicalChannelLimits(phase.descriptor as HistoricalImportDescriptor, settings)
26:     : preparationHostChannelLimits(settings);
27:   const result = await executeNativeWorkerAttempt({ envelope, journal, process: {
28:     owner, signal, command: preparationCommand(admissionId, settings, options.command, slot, historical ? 'historical' : 'prepare'),
29:     limits: { cpuTimeMs: settings.resourcePolicy.cpuTimeMs, memoryBytes: settings.resourcePolicy.memoryBytes,
30:       tasks: settings.resourcePolicy.tasks, timeoutMs: settings.timeoutMs + 8 * settings.cleanupTimeoutMs,
31:       maximumInputBytes: settings.maximumInputBytes, maximumOutputBytes: settings.maximumOutputBytes,
32:       pollIntervalMs: settings.pollIntervalMs, closeTimeoutMs: settings.closeTimeoutMs },
33:     control: { limits: channelLimits, run: exchange },
34:   } });
35:   if (result.state !== 'completed' || result.cleanup.state !== 'completed') {
36:     throw new Error(result.error?.code ?? 'BUSTER_PREPARATION_FAILED');
37:   }
38:   const ownership = await owner.record({ workerId: envelope.claim.workerId, attemptId: envelope.attemptId,
39:     claimId: envelope.claim.claimId, generation: envelope.claim.generation,
40:     profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest });
41:   if (ownership?.phase !== 'disposed' || ownership.finalObservation?.populated !== false) {
42:     throw new Error('BUSTER_PREPARATION_PUBLICATION_QUIESCENCE_UNPROVEN');
43:   }
44:   return result;
45: }

SOURCE skills/buster/engine/test-gates/preparation-recovery.ts SHA256 3bc1d7f6787a1917ea471b55c4f7075618ae16459b6f9d85825493bc98ca10de
1: import type { WorkerOwnershipRecord } from '@kubeclaw/worker-core';
2: import type { WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { assertPreparedSource, preparationDigest } from './preparation-header.ts';
4: import { removeEmptyPreparationGate, retainPreparationGate, publishPreparationGate } from './preparation-gate.ts';
5: import { assertStagedInput, type StagedAdmission } from './preparation-input.ts';
6: import type { PreparedSource } from './preparation-source.ts';
7: import type { PreparationExecutionOptions } from './preparation-execution.ts';
8: import type { SourceReservation } from './preparation-ledger-state.ts';
9: 
10: async function reclaimEmpty(options: PreparationExecutionOptions, record: SourceReservation,
11:   result: WorkerAttemptResultV3): Promise<void> {
12:   if (!record.gate) throw new Error('BUSTER_PREPARATION_EMPTY_GATE_PROOF_INVALID');
13:   await options.ledger.beginEmptyGateReclaim(record.admissionId, preparationDigest(result));
14:   await removeEmptyPreparationGate(options.command.sourceRoot, record.admissionId, record.gate);
15:   await options.ledger.released(record.admissionId);
16: }
17: 
18: async function restoreCompleted(options: PreparationExecutionOptions, record: SourceReservation,
19:   result: WorkerAttemptResultV3): Promise<void> {
20:   if (!record.gate) throw new Error('BUSTER_PREPARATION_RECOVERY_REQUIRED');
21:   if (record.phase === 'empty-gate-reclaiming') {
22:     if (preparationDigest(result) !== record.emptyGateResultDigest) throw new Error('BUSTER_PREPARATION_EMPTY_GATE_PROOF_INVALID');
23:     await reclaimEmpty(options, record, result);
24:     return;
25:   }
26:   if (record.phase === 'staging') {
27:     await restoreStaging(options, record, result);
28:     return;
29:   }
30:   if (!['reserved', 'prepared', 'published'].includes(record.phase)
31:     || result.specialistResult?.schemaId !== 'buster-preparation-result.v1') {
32:     throw new Error('BUSTER_PREPARATION_RECOVERY_REQUIRED');
33:   }
34:   const prepared = result.specialistResult.values as unknown as PreparedSource;
35:   assertPreparedSource(prepared.source, prepared.job);
36:   if (prepared.source.admissionId !== record.admissionId
37:     || prepared.source.attemptSpecDigest !== record.attemptSpecDigest
38:     || prepared.source.preparationUid !== record.slot) throw new Error('BUSTER_PREPARATION_RESULT_IDENTITY_INVALID');
39:   await options.ledger.prepared(prepared.source);
40:   await options.ledger.published(prepared.source);
41:   await publishPreparationGate(options.command.sourceRoot, record.admissionId, record.gate);
42:   await options.ledger.releasePublishedSlot(prepared.source);
43: }
44: 
45: async function restoreStaging(options: PreparationExecutionOptions, record: SourceReservation,
46:   result: WorkerAttemptResultV3): Promise<void> {
47:   if (record.input === null && result.specialistResult?.schemaId === 'buster-declined-input-result.v1'
48:     && preparationDigest(result.specialistResult.values) === preparationDigest({ declined: true })) {
49:     await reclaimEmpty(options, record, result);
50:     return;
51:   }
52:   if (!record.gate || result.specialistResult?.schemaId !== 'buster-staged-input-result.v1') {
53:     throw new Error('BUSTER_PREPARATION_RECOVERY_REQUIRED');
54:   }
55:   const staged = result.specialistResult.values as unknown as StagedAdmission;
56:   assertStagedInput(staged.input, staged.job);
57:   if (preparationDigest(staged) !== preparationDigest(record.input)) throw new Error('BUSTER_PREPARATION_INPUT_BINDING_INVALID');
58:   await retainPreparationGate(options.command.sourceRoot, record.admissionId, record.gate);
59:   await options.ledger.retainInput(staged);
60: }
61: 
62: 
63: function canReclaimUnlaunched(record: SourceReservation, result: WorkerAttemptResultV3 | null,
64:   owner: WorkerOwnershipRecord | null): boolean {
65:   const neverLaunched = !owner || (['disposed', 'abandoned'].includes(owner.phase)
66:     && ['WORKER_NATIVE_ALLOCATION_NOT_LAUNCHED', 'WORKER_NATIVE_RESERVATION_NOT_LAUNCHED'].includes(owner.diagnosis ?? ''));
67:   return record.gate !== null && ['staging', 'reserved', 'empty-gate-reclaiming'].includes(record.phase)
68:     && record.input === null && result?.cleanup.state === 'not_required' && neverLaunched;
69: }
70: 
71: function canReclaimCompletedFailure(record: SourceReservation, result: WorkerAttemptResultV3 | null,
72:   owner: WorkerOwnershipRecord | null): boolean {
73:   // A validation/prepare failure may allocate no source. The marker-only
74:   // remover still rejects every host-created or foreign filesystem entry.
75:   return record.gate !== null && ['staging', 'reserved', 'empty-gate-reclaiming'].includes(record.phase)
76:     && result !== null && result.state !== 'completed' && result.cleanup.state === 'completed'
77:     && owner?.phase === 'disposed' && owner.finalObservation?.populated === false;
78: }
79: 
80: async function recoverReservation(options: PreparationExecutionOptions, record: SourceReservation): Promise<void> {
81:   const envelope = record.envelope;
82:   const result = await options.journal.readResult(envelope);
83:   const owner = await options.owner.record({ workerId: envelope.claim.workerId, attemptId: envelope.attemptId,
84:     claimId: envelope.claim.claimId, generation: envelope.claim.generation,
85:     profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest });
86:   if (canReclaimUnlaunched(record, result, owner) || canReclaimCompletedFailure(record, result, owner)) {
87:     await reclaimEmpty(options, record, result!);
88:     return;
89:   }
90:   if (!record.gate || !result || result.state !== 'completed' || result.cleanup.state !== 'completed'
91:     || owner?.phase !== 'disposed' || owner.finalObservation?.populated !== false) {
92:     throw new Error('BUSTER_PREPARATION_RECOVERY_REQUIRED');
93:   }
94:   await restoreCompleted(options, record, result);
95: }
96: 
97: /** Resume only positively bound completed phases; uncertain effects remain charged and fenced. */
98: export async function recoverPreparationLedger(options: PreparationExecutionOptions): Promise<void> {
99:   try {
100:     for (const record of await options.ledger.reservations()) {
101:       if (!record.slotReleased) await recoverReservation(options, record);
102:     }
103:   } catch (error) {
104:     options.owner.fenceAdmission();
105:     throw error;
106:   }
107: }

SOURCE skills/buster/engine/test-gates/preparation-reservations.ts SHA256 2f079e6521872c056e44fad666efef8e38e4ba07ef9772aa4118d38c3c5df04d
1: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
2: import type { BusterStagedAdmission } from './preparation-input.ts';
3: 
4: export interface PreparationStorageReservation {
5:   readonly bytes: number;
6:   readonly entries: number;
7: }
8: 
9: function reservation(payloadBytes: number, entries: number,
10:   settings: BusterPreparationSettings): PreparationStorageReservation {
11:   const bytes = payloadBytes + entries * settings.sourceEntryReservationBytes;
12:   if (!Number.isSafeInteger(bytes) || bytes < 1 || !Number.isSafeInteger(entries) || entries < 1) {
13:     throw new Error('BUSTER_PREPARATION_RESERVATION_INVALID');
14:   }
15:   return { bytes, entries };
16: }
17: 
18: /** Gate and its fixed marker exist before validation; no archive has been allocated. */
19: export function gateReservation(settings: BusterPreparationSettings): PreparationStorageReservation {
20:   return reservation(settings.maximumInputBytes, 2, settings);
21: }
22: 
23: /** Original wire and bounded metadata stay charged after the native staging host exits. */
24: export function stagedInputReservation(staged: BusterStagedAdmission,
25:   settings: BusterPreparationSettings): PreparationStorageReservation {
26:   if (staged.input.wireBytes > settings.maximumRequestBytes) throw new Error('BUSTER_REMOTE_REQUEST_SIZE_EXCEEDED');
27:   // gate, gate marker, data directory, exact request, input identity/header
28:   return reservation(staged.input.wireBytes + Buffer.byteLength(JSON.stringify(staged))
29:     + settings.maximumInputBytes, 5, settings);
30: }
31: 
32: /** This is an additional reservation; the separately retained input is not credited away. */
33: export function extractedSourceReservation(staged: BusterStagedAdmission,
34:   settings: BusterPreparationSettings): PreparationStorageReservation {
35:   if (staged.job.repositoryArchive.sizeBytes > settings.maximumArchiveBytes) {
36:     throw new Error('BUSTER_REMOTE_ARCHIVE_SIZE_EXCEEDED');
37:   }
38:   // gate, marker, data, owner, repository root, archive, source identity/header, archive descendants
39:   return reservation(staged.job.repositoryArchive.sizeBytes + settings.maximumExtractedBytes
40:     + settings.maximumHeaderBytes + settings.maximumInputBytes,
41:   settings.maximumArchiveEntries + 7, settings);
42: }

SOURCE skills/buster/engine/test-gates/preparation-slots.ts SHA256 cca405b4dac32f2292483815880fb2e0d1d58c5d5134957864fd1bf65f8ed897
