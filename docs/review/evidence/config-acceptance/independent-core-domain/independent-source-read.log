10: type JsonObject = Record<string, unknown>;
11: 
12: export interface KubernetesRuntimeSecurityCapabilityInvokerOptions extends BusterRuntimeSecuritySettings {
13:   readonly workspaceRoot: string;
14:   readonly kubectlExecutable: string;
15:   readonly controllerNamespace: string;
16:   readonly leaseApiGroup: string;
17: }
18: 
19: function capturedOptions(options: KubernetesRuntimeSecurityCapabilityInvokerOptions): BusterRuntimeSecuritySettings {
20:   const { workspaceRoot, kubectlExecutable, controllerNamespace, leaseApiGroup, ...settings } = options;
21:   const policy = validateBusterRuntimeSecuritySettings(settings);
22:   if (typeof workspaceRoot !== 'string' || workspaceRoot.length === 0
23:     || typeof kubectlExecutable !== 'string' || kubectlExecutable.length === 0
24:     || typeof controllerNamespace !== 'string' || !/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/u.test(controllerNamespace)
25:     || typeof leaseApiGroup !== 'string' || !/^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/u.test(leaseApiGroup)) {
26:     throw new Error('KUBERNETES_RUNTIME_SECURITY_CONFIG_INVALID');
27:   }
28:   return policy;
29: }
30: 
31: function object(value: unknown, code = 'KUBERNETES_RUNTIME_SECURITY_RESPONSE_INVALID'): JsonObject {
32:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error(code);
33:   return value as JsonObject;
34: }
35: 
36: function text(value: unknown, label: string, maximum = 2048): string {
37:   if (typeof value !== 'string' || value.length < 1 || value.length > maximum) {
38:     throw new Error(`KUBERNETES_RUNTIME_SECURITY_REQUEST_INVALID:${label}`);
39:   }
40:   return value;
41: }
42: 
43: function canonicalJson(value: unknown): string {
44:   const normalized = (entry: unknown): unknown => {
45:     if (Array.isArray(entry)) return entry.map(normalized);
46:     if (entry && typeof entry === 'object') return Object.fromEntries(Object.entries(entry as JsonObject)
47:       .sort(([left], [right]) => left.localeCompare(right)).map(([key, item]) => [key, normalized(item)]));
48:     return entry;
49:   };
50:   return JSON.stringify(normalized(value));
51: }
52: 
53: export function runtimeSecurityResultDigest(snapshot: JsonObject): string {
54:   const payload = { findings: snapshot.findings, omittedFindingCount: snapshot.omittedFindingCount,
55:     podCount: snapshot.podCount, serviceCount: snapshot.serviceCount,
56:     totalFindingCount: snapshot.totalFindingCount };
57:   return `sha256:${crypto.createHash('sha256').update(canonicalJson(payload)).digest('hex')}`;
58: }
59: 
60: export function runtimeSecurityObservationHasValidAccounting(snapshot: JsonObject): boolean {
61:   if (!Array.isArray(snapshot.findings) || !Number.isSafeInteger(snapshot.totalFindingCount)
62:     || Number(snapshot.totalFindingCount) < 0 || !Number.isSafeInteger(snapshot.omittedFindingCount)
63:     || Number(snapshot.omittedFindingCount) < 0) return false;
64:   const total = Number(snapshot.totalFindingCount); const omitted = Number(snapshot.omittedFindingCount);
65:   if (omitted === 0) return total === snapshot.findings.length;
66:   const overflow = snapshot.findings.at(-1);
67:   return snapshot.findings.length > 0 && total - omitted === snapshot.findings.length - 1
68:     && Boolean(overflow && typeof overflow === 'object' && !Array.isArray(overflow)
69:       && (overflow as JsonObject).id === 'runtime:findings:overflow'
70:       && (overflow as JsonObject).severity === 'critical');
71: }
72: 
73: export function containedRuntimeSecurityManifest(root: string, value: unknown): string {
74:   const requested = text(value, 'manifestPath', 4096);
75:   const resolved = fs.realpathSync(path.isAbsolute(requested) ? requested : path.resolve(root, requested));
76:   if (!fs.statSync(resolved).isFile() || (resolved !== root && !resolved.startsWith(`${root}${path.sep}`))) {
77:     throw new Error('KUBERNETES_RUNTIME_SECURITY_PATH_DENIED');
78:   }
79:   return resolved;
80: }
