1: import fs from "node:fs/promises";
2: import {
3:   canonicalJson,
4:   type ProducerClosureV1,
5: } from "@kubeclaw/pipeline-observability-contract";
6: import {
7:   validatePipelineWorkerCoreContract,
8:   type WorkerAttemptResultV1,
9: } from "@kubeclaw/pipeline-worker-core-contract";
10: import { assertCompletionIntent } from "./attempt-replay.ts";
11: import {
12:   requireIdentity,
13:   digest,
14:   cleanupUnreferencedBlobs,
15: } from "./attempt-evidence.ts";
16: import { storeClosureUnlocked } from "./attempt-completeness.ts";
17: import type {
18:   DurableCompletionIntent,
19:   DurableResultMetadata,
20:   DurableAttemptStoreSnapshot,
21:   DurableResultOwner,
22: } from "./durable-attempts.ts";
23: import type { AttemptState } from "./attempt-state.ts";
24: import type { FileObservabilityAdmissionStore } from "./durable-delivery.ts";
25: export async function storeResult(
26:   store: AttemptState,
27:   pipelineRunId: string,
28:   result: WorkerAttemptResultV1,
29:   completionIntent: DurableCompletionIntent | null = null,
30:   owner: DurableResultOwner | null = null,
31: ): Promise<DurableResultMetadata> {
32:   requireIdentity(pipelineRunId, "OBSERVABILITY_PIPELINE_RUN_ID_INVALID");
33:   const snapshot = structuredClone(result);
34:   const intent = structuredClone(completionIntent);
35:   const ownerSnapshot = structuredClone(owner);
36:   if (ownerSnapshot) {
37:     requireIdentity(ownerSnapshot.planId, "OBSERVABILITY_PLAN_ID_INVALID");
38:     requireIdentity(ownerSnapshot.nodeId, "OBSERVABILITY_NODE_ID_INVALID");
39:   }
40:   validatePipelineWorkerCoreContract("workerAttemptResult", snapshot);
41:   assertCompletionIntent(pipelineRunId, snapshot, intent);
42:   return store.serial(async () => {
43:     const state = await store.readState();
44:     await store.reclaimExpiredEvidence(state);
45:     await cleanupUnreferencedBlobs(store.root, state);
46:     const existing = findResult(state, pipelineRunId, snapshot);
47:     if (existing)
48:       return resumeResultCommit(
49:         store,
50:         state,
51:         existing,
52:         snapshot,
53:         intent,
54:         ownerSnapshot,
55:       );
56:     requireUnfinalizedAttempt(state, pipelineRunId, snapshot);
57:     await verifyResultEvidence(state, pipelineRunId, snapshot);
58:     return commitResult(
59:       store,
60:       state,
61:       pipelineRunId,
62:       snapshot,
63:       intent,
64:       ownerSnapshot,
65:     );
66:   });
67: }
68: export async function resumeCompletion(
69:   store: AttemptState,
70:   pipelineRunId: string,
71:   attemptId: string,
72:   claimGeneration: number,
73:   admission: FileObservabilityAdmissionStore,
74: ): Promise<ProducerClosureV1> {
75:   return store.serial(async () => {
76:     const state = await store.readState();
77:     await store.reclaimExpiredEvidence(state);
78:     if (
79:       state.results.some(
80:         (item) =>
81:           item.pipelineRunId === pipelineRunId &&
82:           item.attemptId === attemptId &&
83:           item.claimGeneration > claimGeneration,
84:       )
85:     )
86:       throw new Error("OBSERVABILITY_STALE_CLAIM_COMPLETION");
87:     const stored = state.results.find(
88:       (item) =>
89:         item.pipelineRunId === pipelineRunId &&
90:         item.attemptId === attemptId &&
91:         item.claimGeneration === claimGeneration,
92:     );
93:     if (!stored?.completionIntent)
94:       throw new Error("OBSERVABILITY_COMPLETION_INTENT_MISSING");
95:     if (typeof stored.storedAt !== "string")
96:       throw new Error("OBSERVABILITY_RESULT_COMMIT_PENDING");
97:     const { records: admitted } = await admission.admitAndRead(
98:       canonicalJson(stored.completionIntent.record),
99:     );
100:     return storeClosureUnlocked(
101:       store,
102:       state,
103:       stored.completionIntent.closure,
104:       admitted,
105:     );
106:   });
107: }
108: 
109: function findResult(
110:   state: DurableAttemptStoreSnapshot,
111:   pipelineRunId: string,
112:   snapshot: WorkerAttemptResultV1,
113: ): DurableResultMetadata | undefined {
114:   const generations = state.results
115:     .filter(
116:       (item) =>
117:         item.pipelineRunId === pipelineRunId &&
118:         item.attemptId === snapshot.attemptId,
119:     )
120:     .map((item) => item.claimGeneration);
121:   const highest = generations.length ? Math.max(...generations) : 0;
122:   if (snapshot.claimGeneration < highest)
123:     throw new Error("OBSERVABILITY_STALE_CLAIM_RESULT");
124:   return state.results.find(
125:     (item) =>
126:       item.pipelineRunId === pipelineRunId &&
127:       item.attemptId === snapshot.attemptId &&
128:       item.claimGeneration === snapshot.claimGeneration,
129:   );
130: }
131: 
132: async function resumeResultCommit(
133:   store: AttemptState,
134:   state: DurableAttemptStoreSnapshot,
135:   existing: DurableResultMetadata,
136:   snapshot: WorkerAttemptResultV1,
137:   intent: DurableCompletionIntent | null,
138:   ownerSnapshot: DurableResultOwner | null,
139: ): Promise<DurableResultMetadata> {
140:   if (
141:     existing.result.resultDigest !== snapshot.resultDigest ||
142:     canonicalJson(existing.completionIntent) !== canonicalJson(intent) ||
143:     existing.planId !== (ownerSnapshot?.planId ?? null) ||
144:     existing.nodeId !== (ownerSnapshot?.nodeId ?? null)
145:   )
146:     throw new Error("OBSERVABILITY_RESULT_IDENTITY_CONFLICT");
147:   if (existing.storedAt === null) {
148:     existing.storedAt = new Date().toISOString();
149:     store.checkSize(state);
150:     await store.writeState(state);
151:   }
152:   return structuredClone(existing);
153: }
154: 
155: function requireUnfinalizedAttempt(
156:   state: DurableAttemptStoreSnapshot,
157:   pipelineRunId: string,
158:   snapshot: WorkerAttemptResultV1,
159: ): void {
160:   const finalizedGeneration = state.results.find(
161:     (item) =>
162:       item.pipelineRunId === pipelineRunId &&
163:       item.attemptId === snapshot.attemptId &&
164:       item.claimGeneration < snapshot.claimGeneration &&
165:       item.completionIntent !== null &&
166:       state.closures.some(
167:         (closure) =>
168:           closure.pipelineRunId === pipelineRunId &&
169:           closure.closureId === item.completionIntent!.closure.closureId,
170:       ),
171:   );
172:   if (finalizedGeneration)
173:     throw new Error("OBSERVABILITY_ATTEMPT_ALREADY_COMPLETED");
174: }
175: 
176: async function verifyResultEvidence(
177:   state: DurableAttemptStoreSnapshot,
178:   pipelineRunId: string,
179:   snapshot: WorkerAttemptResultV1,
180: ): Promise<void> {
181:   for (const evidence of snapshot.evidence) {
182:     const metadata = state.evidence.find(
183:       (item) =>
184:         item.pipelineRunId === pipelineRunId &&
185:         item.attemptId === snapshot.attemptId &&
186:         item.claimGeneration === snapshot.claimGeneration &&
187:         item.evidenceId === evidence.evidenceId,
188:     );
189:     if (
190:       !metadata ||
191:       canonicalJson(metadata.artifact) !== canonicalJson(evidence.artifact)
192:     )
193:       throw new Error(
194:         `OBSERVABILITY_RESULT_EVIDENCE_MISSING:${evidence.evidenceId}`,
195:       );
196:     const file = new URL(metadata.artifact.storageUrl);
197:     const evidenceBytes = await fs.readFile(file);
198:     if (
199:       evidenceBytes.byteLength !== metadata.artifact.sizeBytes ||
200:       digest(evidenceBytes) !== metadata.artifact.contentDigest
201:     )
202:       throw new Error(
203:         `OBSERVABILITY_RESULT_EVIDENCE_CORRUPT:${evidence.evidenceId}`,
204:       );
205:   }
206: }
207: 
208: async function commitResult(
209:   store: AttemptState,
210:   state: DurableAttemptStoreSnapshot,
211:   pipelineRunId: string,
212:   snapshot: WorkerAttemptResultV1,
213:   intent: DurableCompletionIntent | null,
214:   ownerSnapshot: DurableResultOwner | null,
215: ): Promise<DurableResultMetadata> {
216:   if (
217:     state.results.length - store.projections.size >=
218:     store.limits.maximumResults
219:   )
220:     throw new Error("OBSERVABILITY_RESULT_STORE_FULL");
221:   const metadata: DurableResultMetadata = {
222:     pipelineRunId,
223:     planId: ownerSnapshot?.planId ?? null,
224:     nodeId: ownerSnapshot?.nodeId ?? null,
225:     attemptId: snapshot.attemptId,
226:     claimGeneration: snapshot.claimGeneration,
227:     workerId: snapshot.workerId,
228:     result: snapshot,
229:     completionIntent: intent,
230:     storedAt: null,
231:   };
232:   const pending = { ...state, results: [...state.results, metadata] };
233:   const reservedCommit: DurableResultMetadata = {
234:     ...metadata,
235:     storedAt: "9999-12-31T23:59:59.999Z",
236:   };
237:   store.checkSize({
238:     ...state,
239:     results: [...state.results, reservedCommit],
240:   });
241:   await store.writeState(pending);
242:   const committed: DurableResultMetadata = {
243:     ...metadata,
244:     storedAt: new Date().toISOString(),
245:   };
246:   const committedState = {
247:     ...state,
248:     results: [...state.results, committed],
249:   };
250:   store.checkSize(committedState);
251:   await store.writeState(committedState);
252:   return structuredClone(committed);
253: }

