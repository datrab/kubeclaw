24: export interface BusterRemotePlanServiceOptions extends BusterCapabilityRuntimeOptions {
25:   readonly store: PreparedBusterPlanJobStore;
26:   readonly preparation: BusterPreparation;
27:   readonly registry: RegistrySnapshot;
28:   readonly workerRevision: string;
29:   readonly runtimeRoot: string;
30:   readonly admission: BusterAdmissionSettings;
31:   readonly workerLocalRuntime: LocalWorkerRuntimePolicy;
32:   readonly executionPolicy: BusterExecutionSettings;
33:   readonly dependencyReadiness: BusterDependencyReadinessSettings;
34:   readonly now?: () => Date;
35:   readonly execute?: (
36:     job: PreparedPlanJob,
37:     paths: Readonly<{ jobRoot: string; repositoryRoot: string; sourceRepositoryRoot: string; workspaceRoot: string; artifactRoot: string; observabilityRoot: string }>,
38:     signal: AbortSignal,
