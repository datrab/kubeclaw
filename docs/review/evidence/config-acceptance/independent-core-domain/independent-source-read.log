95:     this.#scope.verifyChildren(this.#record.topology.children, false);
96:     const limits = this.#scope.childLimits(command.resourceLimits);
97:     this.#record = await this.#options.store.reserveChild(this.#record, name, limits);
98:     if (this.#closing) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
99:     const reserved = this.#record.topology.children.find(child => child.name === name)!;
