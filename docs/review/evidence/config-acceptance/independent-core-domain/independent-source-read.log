SOURCE contracts/pipeline-worker-core/v1/scripts/generate-resource-schema-v2.mjs SHA256 6c3c5720647cc3b74394d0ca7d3dd2fdd42728dd3b9217f31e033ca20518d56a
1: import {readFile,writeFile} from 'node:fs/promises';
2: import assert from 'node:assert/strict';
3: const source=new URL('../schemas/pipeline-worker-core.v1.schema.json',import.meta.url);
4: const output=new URL('../schemas/pipeline-worker-core.v2.schema.json',import.meta.url);
5: const schema=JSON.parse(await readFile(source,'utf8'));
6: schema.$id='https://kubeclaw.dev/contracts/pipeline-worker-core/v2/schema.json';
7: schema.title='KubeClaw explicit resource-aware worker attempts v2 (generated from V1 common protocol)';
8: const defs=schema.$defs;
9: const text={type:'string',minLength:1,maxLength:4096};
10: const object=properties=>({type:'object',additionalProperties:false,required:Object.keys(properties),properties});
11: const ref=name=>({$ref:`#/$defs/${name}`});
12: const metrics={cpuTimeMs:'milliseconds',maximumMemoryBytes:'bytes',maximumProcesses:'processes'};
13: defs.resourceObservation={oneOf:[object({status:{const:'observed'},value:{type:'integer',minimum:0}}),object({status:{const:'unavailable'},reason:text})]};
14: defs.resourceBudget={oneOf:[object({state:{const:'requested'},limit:{type:'integer',minimum:1}}),object({state:{const:'unrequested'}})]};
15: defs.resourceCapabilities=object({schemaVersion:{const:'worker-resource-capabilities.v1'},...Object.fromEntries(Object.entries(metrics).map(([metric,unit])=>[metric,{oneOf:[
16:  object({scope:text,unit:{const:unit},measurement:{const:'measured'}}),
17:  object({scope:text,unit:{const:unit},measurement:{const:'sampled'},sampleIntervalMs:{type:'integer',minimum:1}}),
18:  object({scope:text,unit:{const:unit},measurement:{const:'unavailable'},reason:text})]}]))});
19: defs.resourceBudgets=object({schemaVersion:{const:'worker-resource-budgets.v1'},...Object.fromEntries(Object.keys(metrics).map(metric=>[metric,ref('resourceBudget')]))});
20: defs.resourceObservations=object(Object.fromEntries(Object.keys(metrics).map(metric=>[metric,ref('resourceObservation')])));
21: defs.resourceAccounting=object({schemaVersion:{const:'worker-resource-accounting.v1'},capabilities:ref('resourceCapabilities'),budgets:ref('resourceBudgets'),observations:ref('resourceObservations')});
22: defs.workerProfile.properties.schemaVersion={const:'worker-profile.v2'};
23: defs.workerProfile.required.push('resourceCapabilities');defs.workerProfile.properties.resourceCapabilities=ref('resourceCapabilities');
24: for(const name of ['cpuMillis','memoryBytes','processes']){delete defs.workerAttemptLimits.properties[name];defs.workerAttemptLimits.required=defs.workerAttemptLimits.required.filter(key=>key!==name);}
25: defs.workerAttemptEnvelope.properties.schemaVersion={const:'worker-attempt-envelope.v2'};
26: defs.workerAttemptEnvelope.required.push('resourceBudgets');defs.workerAttemptEnvelope.properties.resourceBudgets=ref('resourceBudgets');
27: defs.workerAttemptResult.properties.schemaVersion={const:'worker-attempt-result.v2'};
28: Object.assign(defs.workerAttemptResult.properties,{profileDigest:ref('digest'),attemptSpecDigest:ref('digest'),resourceAccounting:ref('resourceAccounting')});
29: defs.workerAttemptResult.required.push('profileDigest','attemptSpecDigest','resourceAccounting');
30: // Expose only the opted-in profile/attempt/result graph. Existing remote registration stays V1.
31: const reachable=new Set();
32: function include(name){
33:  if(reachable.has(name))return;reachable.add(name);
34:  const scan=value=>{if(!value || typeof value!=='object')return;if(typeof value.$ref==='string' && value.$ref.startsWith('#/$defs/'))include(value.$ref.slice(8));Object.values(value).forEach(scan);};
35:  scan(defs[name]);
36: }
37: ['workerProfile','workerAttemptEnvelope','workerAttemptResult'].forEach(include);
38: for(const name of Object.keys(defs))if(!reachable.has(name))delete defs[name];
39: const generated=JSON.stringify(schema,null,2)+'\n';
40: if(process.argv.includes('--check'))assert.equal(await readFile(output,'utf8'),generated,'generated V2 schema is stale');
41: else await writeFile(output,generated);

SOURCE contracts/pipeline-worker-core/v1/scripts/generate-resource-schema-v3.mjs SHA256 38ccfa7b89a2f759cb600308309357337ed22be14f48398a1761517889d327c6
1: import { readFile, writeFile } from 'node:fs/promises';
2: import assert from 'node:assert/strict';
3: 
4: const source = JSON.parse(await readFile(new URL('../schemas/pipeline-worker-core.v2.schema.json', import.meta.url), 'utf8'));
5: // V1 and V2 remain immutable historical protocols; V3 explicitly names the new unit.
6: function migrate(value) {
7:   if (Array.isArray(value)) return value.map(migrate);
8:   if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value)
9:     .map(([key, child]) => [key === 'maximumProcesses' ? 'maximumTasks' : key, migrate(child)]));
10:   if (value === 'maximumProcesses') return 'maximumTasks';
11:   return value;
12: }
13: const schema = migrate(source), defs = schema.$defs;
14: schema.$id = 'https://kubeclaw.dev/contracts/pipeline-worker-core/v3/schema.json';
15: schema.title = 'KubeClaw native attempt tree resources with explicit Linux task units';
16: for (const [name, version] of Object.entries({ workerProfile: 'worker-profile.v3', workerAttemptEnvelope: 'worker-attempt-envelope.v3',
17:   workerAttemptResult: 'worker-attempt-result.v3', resourceCapabilities: 'worker-resource-capabilities.v2',
18:   resourceBudgets: 'worker-resource-budgets.v2', resourceAccounting: 'worker-resource-accounting.v2' })) {
19:   defs[name].properties.schemaVersion.const = version;
20: }
21: for (const [metric, unit] of Object.entries({ cpuTimeMs: 'milliseconds', maximumMemoryBytes: 'bytes', maximumTasks: 'linux-tasks' })) {
22:   defs.resourceCapabilities.properties[metric] = { type: 'object', additionalProperties: false,
