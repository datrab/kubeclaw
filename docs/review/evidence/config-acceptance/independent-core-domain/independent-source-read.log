629:   #result(started: Date, completed: Date, fault: AttemptFault | null, operationResult: WorkerAttemptOperationResult | null,
630:     evidence: readonly WorkerEvidenceRefV1[], resources: WorkerResourceUseV1,
631:     cleanup: WorkerAttemptResultV1['cleanup']): WorkerAttemptResult {
632:     const { envelope } = this.#options;
633:     const finalCompleted = completed.getTime() < started.getTime() ? started : completed;
634:     const unsigned = {
635:       ...resourceResultFields(envelope, this.#accounting),
636:       protocolVersion: envelope.protocolVersion,
637:       attemptId: envelope.attemptId,
638:       claimId: envelope.claim.claimId,
639:       claimGeneration: envelope.claim.generation,
640:       workerId: envelope.claim.workerId,
641:       state: fault?.state ?? 'completed' as const,
642:       startedAt: started.toISOString(),
643:       completedAt: finalCompleted.toISOString(),
644:       durationMs: Math.max(0, finalCompleted.getTime() - started.getTime()),
645:       summary: boundedText(fault?.message ?? operationResult?.summary, 'Attempt completed.'),
646:       specialistResult: fault ? null : operationResult?.specialistResult ?? null,
647:       error: fault ? { code: fault.code, message: boundedText(fault.message, fault.code) } : null,
648:       evidence: [...evidence],
649:       resources,
650:       cleanup: {
651:         state: cleanup.state,
652:         summary: cleanup.summary === null ? null : boundedText(cleanup.summary, 'Cleanup failed.'),
653:       },
654:       exitCode: fault ? null : operationResult?.exitCode ?? null,
655:       signal: fault ? null : (typeof operationResult?.signal === 'string' && operationResult.signal.length > 0
