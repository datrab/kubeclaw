20: }
21: 
22: export type WorkerOwnershipPhase = 'reserved' | 'allocated' | 'running' | 'quiescing' | 'empty' | 'disposed' | 'unresolved' | 'abandoned';
23: 
24: export interface WorkerScopeBinding {
25:   readonly scopeName: string;
26:   readonly bootId: string;
27:   readonly device: number;
28:   readonly inode: number;
29: }
30: 
31: export interface WorkerOwnershipRecord {
32:   readonly identity: WorkerOwnershipIdentity;
33:   readonly scopeName: string;
34:   readonly revision: number;
35:   readonly phase: WorkerOwnershipPhase;
36:   readonly binding: WorkerScopeBinding | null;
37:   readonly diagnosis: string | null;
38:   readonly finalObservation: NativeWorkerResourceObservation | null;
39:   readonly topology: WorkerScopeTopology;
40: }
41: 
42: 
43: type TransitionChange = { binding?: WorkerScopeBinding; diagnosis?: string; finalObservation?: NativeWorkerResourceObservation };
44: 
45: function validateTransitionChange(current: WorkerOwnershipRecord, phase: WorkerOwnershipPhase, change: TransitionChange): void {
46:   if (change.binding !== undefined && (current.phase !== 'reserved' || phase !== 'allocated')) {
47:     throw new Error('WORKER_OWNERSHIP_REBIND_FORBIDDEN');
48:   }
49:   if (change.finalObservation !== undefined && (current.finalObservation !== null || phase !== 'empty'
50:     || !['quiescing', 'empty'].includes(current.phase))) throw new Error('WORKER_OWNERSHIP_OBSERVATION_REWRITE_FORBIDDEN');
51:   if (current.phase === phase && change.finalObservation === undefined) throw new Error('WORKER_OWNERSHIP_TRANSITION_INVALID');
52: }
53: 
54: /**
55:  * Durable neutral ownership metadata. The trusted coordinator must supply
56:  * native lifecycle evidence; recording a phase is not proof of kernel state.
57:  * Disposed identities remain reserved so stale requests cannot restart work.
58:  */
59: export class FileWorkerOwnershipStore {
60:   readonly #file: string;
61:   readonly #maximumRecords: number;
62:   readonly #maximumBytes: number;
63: 
64:   constructor(root: string, limits: { maximumRecords: number; maximumBytes: number }) {
65:     if (!path.isAbsolute(root) || !Number.isSafeInteger(limits.maximumRecords) || limits.maximumRecords < 1
66:       || !Number.isSafeInteger(limits.maximumBytes) || limits.maximumBytes < 1) {
67:       throw new Error('WORKER_OWNERSHIP_CONFIG_INVALID');
68:     }
69:     this.#file = path.join(path.resolve(root), 'owners.json');
70:     this.#maximumRecords = limits.maximumRecords;
71:     this.#maximumBytes = limits.maximumBytes;
72:   }
73: 
74:   async records(): Promise<readonly WorkerOwnershipRecord[]> {
75:     return withDurableStoreLock(this.#file, async () => structuredClone((await this.#read()).records));
76:   }
77: 
78:   /** A changed boot is only a reboot proof after this store is bound to one host. */
79:   async bindHostIdentity(hostIdentity: string, currentBootId: string): Promise<void> {
80:     validateOwnershipHostIdentity(hostIdentity);
81:     if (!/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u.test(currentBootId)) throw new Error('WORKER_OWNERSHIP_BOOT_IDENTITY_INVALID');
82:     await withDurableStoreLock(this.#file, async () => {
83:       const state = await this.#read();
84:       if (state.hostIdentity !== null) {
85:         if (state.hostIdentity !== hostIdentity) throw new Error('WORKER_OWNERSHIP_DIFFERENT_HOST_UNRESOLVED');
86:         return;
87:       }
88:       if (state.records.some(record => record.binding !== null && record.binding.bootId !== currentBootId)) {
89:         throw new Error('WORKER_OWNERSHIP_LEGACY_HOST_UNPROVEN');
90:       }
91:       state.hostIdentity = hostIdentity;
92:       await this.#write(state);
93:     });
94:   }
95: 
96:   /** Held for the entire supervisor lifetime, including recovery and admission. */
97:   async withSupervisor<T>(operation: () => Promise<T>): Promise<T> {
98:     return withDurableStoreLock(path.join(path.dirname(this.#file), 'supervisor', 'lifetime'), operation);
99:   }
100: 
101:   async reserve(input: WorkerOwnershipIdentity): Promise<WorkerOwnershipRecord> {
102:     const identity = structuredClone(input);
103:     identityValid(identity);
104:     return withDurableStoreLock(this.#file, async () => {
105:       const state = await this.#read();
106:       const same = state.records.find(record => key(record.identity) === key(identity));
107:       if (same) {
108:         if (canonicalJson(same.identity) !== canonicalJson(identity)) throw new Error('WORKER_OWNERSHIP_CONFLICT');
109:         return structuredClone(same);
110:       }
111:       const previous = state.records.filter(record => record.identity.workerId === identity.workerId
112:         && record.identity.attemptId === identity.attemptId);
113:       if (previous.some(record => record.identity.generation >= identity.generation)) {
114:         throw new Error('WORKER_OWNERSHIP_STALE_GENERATION');
115:       }
116:       if (previous.some(record => !['disposed', 'abandoned'].includes(record.phase))) throw new Error('WORKER_OWNERSHIP_RECONCILIATION_REQUIRED');
117:       const record: WorkerOwnershipRecord = {
118:         identity, scopeName: `worker-${randomUUID()}`, revision: 1, phase: 'reserved', binding: null, diagnosis: null, finalObservation: null,
119:         topology: { kind: 'aggregate.v1', children: [] },
120:       };
121:       state.records.push(record);
122:       ownershipTerminalCapacityBytes(state, this.#maximumBytes);
123:       await this.#write(state);
124:       return structuredClone(record);
125:     });
126:   }
127: 
128:   async transition(input: WorkerOwnershipRecord, phase: WorkerOwnershipPhase,
129:     options: TransitionChange = {}): Promise<WorkerOwnershipRecord> {
130:     const expected = structuredClone(input);
131:     const change = structuredClone(options);
132:     validateRecord(expected);
133:     if (!Object.hasOwn(transitions, phase)) throw new Error('WORKER_OWNERSHIP_PHASE_INVALID');
134:     return withDurableStoreLock(this.#file, async () => {
135:       const state = await this.#read();
136:       const index = state.records.findIndex(record => key(record.identity) === key(expected.identity));
137:       const current = state.records[index];
138:       if (!current || canonicalJson(current) !== canonicalJson(expected)) throw new Error('WORKER_OWNERSHIP_CAS_CONFLICT');
139:       if (!transitions[current.phase].includes(phase)) throw new Error('WORKER_OWNERSHIP_TRANSITION_INVALID');
140:       validateTransitionChange(current, phase, change);
141:       const updated: WorkerOwnershipRecord = {
142:         ...current, revision: current.revision + 1, phase,
143:         binding: change.binding ?? current.binding, diagnosis: change.diagnosis ?? current.diagnosis,
144:         finalObservation: change.finalObservation ?? current.finalObservation,
145:       };
146:       validateRecord(updated);
147:       state.records[index] = updated;
148:       await this.#write(state);
149:       return structuredClone(updated);
150:     });
151:   }
152: 
153:   /** The entire topology is CAS-bound and charged to the same durable metadata quota. */
154:   async reserveChild(input: WorkerOwnershipRecord, name: string, limits: NativeWorkerScopeLimits): Promise<WorkerOwnershipRecord> {
155:     validateChildLimits(limits);
156:     if (!childNameValid(name)) throw new Error('WORKER_OWNERSHIP_CHILD_INVALID');
157:     const child = { name, limits: { ...limits }, binding: null };
158:     return this.#changeChildren(input, current => {
159:       if (current.phase !== 'running' || current.topology.children.some(item => item.name === name)) {
160:         throw new Error('WORKER_OWNERSHIP_CHILD_RESERVATION_INVALID');
161:       }
162:       return [...current.topology.children, child];
163:     }, true);
164:   }
165: 
166:   async bindChild(input: WorkerOwnershipRecord, name: string, binding: WorkerScopeBinding): Promise<WorkerOwnershipRecord> {
167:     const captured = { ...binding };
168:     return this.#changeChildren(input, current => {
169:       const child = current.topology.children.find(item => item.name === name);
170:       if (!child || child.binding !== null || current.phase !== 'running') throw new Error('WORKER_OWNERSHIP_CHILD_REBIND_FORBIDDEN');
171:       return current.topology.children.map(item => item.name === name ? { ...item, binding: captured } : item);
172:     }, false);
173:   }
174: 
175:   async #changeChildren(input: WorkerOwnershipRecord,
176:     update: (current: WorkerOwnershipRecord) => WorkerScopeTopology['children'], admission: boolean): Promise<WorkerOwnershipRecord> {
177:     const expected = structuredClone(input);
178:     validateRecord(expected);
179:     return withDurableStoreLock(this.#file, async () => {
180:       const state = await this.#read();
181:       const index = state.records.findIndex(record => key(record.identity) === key(expected.identity));
182:       const current = state.records[index];
183:       if (!current || canonicalJson(current) !== canonicalJson(expected)) throw new Error('WORKER_OWNERSHIP_CAS_CONFLICT');
184:       if (current.topology.kind !== 'aggregate.v1') throw new Error('WORKER_OWNERSHIP_LEGACY_LAUNCH_FORBIDDEN');
185:       const updated = { ...current, revision: current.revision + 1,
186:         topology: { kind: current.topology.kind, children: update(current) } };
187:       validateRecord(updated);
188:       state.records[index] = updated;
189:       if (admission) ownershipTerminalCapacityBytes(state, this.#maximumBytes);
190:       await this.#write(state);
191:       return structuredClone(updated);
192:     });
193:   }
194: 
195:   async #read(): Promise<State> {
196:     let handle;
197:     try { handle = await fs.open(this.#file, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK); }
198:     catch (error) {
199:       if ((error as NodeJS.ErrnoException).code === 'ENOENT') return { schemaVersion: 'worker-ownership-store.v3', hostIdentity: null, records: [] };
200:       throw error;
201:     }
202:     let value: unknown;
203:     try {
204:       const stat = await handle.stat();
205:       if (!stat.isFile() || stat.nlink !== 1 || stat.size > this.#maximumBytes) throw new Error('WORKER_OWNERSHIP_CAPACITY_EXCEEDED');
206:       const bytes = await handle.readFile();
207:       if (bytes.byteLength > this.#maximumBytes) throw new Error('WORKER_OWNERSHIP_CAPACITY_EXCEEDED');
208:       value = JSON.parse(bytes.toString('utf8'));
209:     } finally { await handle.close(); }
210:     return decodeOwnershipState(value, this.#maximumRecords);
211:   }
212: 
213:   async #write(state: State): Promise<void> {
214:     if (state.records.length > this.#maximumRecords || Buffer.byteLength(canonicalJson(state)) > this.#maximumBytes) {
215:       throw new Error('WORKER_OWNERSHIP_CAPACITY_EXCEEDED');
216:     }
217:     await writeDurableState(this.#file, state);
218:   }
219: }

SOURCE skills/worker/core/worker/phase-deadline.ts SHA256 13ead2817f0277f8bb7a45b09f42df228bc62e8a0d43e26eabbcbc4f2365e456
1: /** A timeout cannot kill JavaScript. Unsettled hooks remain explicitly unresolved. */
2: export class WorkerPhaseUnresolved extends Error {
3:   constructor(phase: string) { super(`WORKER_PHASE_UNRESOLVED:${phase}`); }
4: }
5: 
6: export class WorkerPhaseDeadline {
7:   #unresolved = false;
8:   readonly expiresAt: number;
9:   readonly timeoutMs: number;
10:   readonly now: () => number;
11:   readonly signal: AbortSignal | undefined;
12:   constructor(expiresAt: number, timeoutMs: number, now: () => number, signal?: AbortSignal) {
13:     this.expiresAt = expiresAt; this.timeoutMs = timeoutMs; this.now = now; this.signal = signal;
14:   }
15:   get unresolved(): boolean { return this.#unresolved; }
16:   quarantine(): void { this.#unresolved = true; }
17: 
18:   async run<T>(phase: string, work: (signal: AbortSignal) => Promise<T>, maintenance = false): Promise<T> {
19:     this.#assertStart(phase, maintenance);
20:     const controller = new AbortController();
21:     const end = maintenance ? this.now() + this.timeoutMs : Math.min(this.expiresAt, this.now() + this.timeoutMs);
22:     const abort = (): void => controller.abort(this.signal?.reason ?? new Error('WORKER_ATTEMPT_CANCELLED'));
23:     this.signal?.addEventListener('abort', abort, { once: true });
24:     let timer: NodeJS.Timeout | undefined;
25:     let settled = false;
26:     const operation = Promise.resolve().then(() => { controller.signal.throwIfAborted(); return work(controller.signal); });
27:     const settlement = operation.then(() => { settled = true; }, () => { settled = true; });
28:     const cancelled = new Promise<never>((_resolve, reject) => {
29:       controller.signal.addEventListener('abort', () => reject(controller.signal.reason), { once: true });
30:       timer = setTimeout(() => controller.abort(this.#timeoutError(phase, maintenance)), Math.max(1, end - this.now()));
31:     });
32:     try {
33:       const value = await Promise.race([operation, cancelled]);
34:       if (this.now() >= end) throw this.#timeoutError(phase, maintenance);
35:       return value;
36:     } catch (error) {
37:       controller.abort(error);
38:       if (!settled && !(await this.#drain(settlement))) { this.#unresolved = true; throw new WorkerPhaseUnresolved(phase); }
39:       if (maintenance && this.signal?.aborted && this.now() < end) return await operation;
40:       throw error;
41:     } finally {
42:       if (timer) clearTimeout(timer);
43:       this.signal?.removeEventListener('abort', abort);
44:       controller.abort(new Error(`${phase}_COMPLETE`));
45:     }
46:   }
47: 
48:   #assertStart(phase: string, maintenance: boolean): void {
49:     if (this.#unresolved) throw new WorkerPhaseUnresolved(phase);
50:     if (!maintenance && this.now() >= this.expiresAt) throw new Error('WORKER_CLAIM_EXPIRED');
51:     if (!maintenance && this.signal?.aborted) throw this.signal.reason ?? new Error('WORKER_ATTEMPT_CANCELLED');
52:   }
53:   #timeoutError(phase: string, maintenance: boolean): Error {
54:     return new Error(!maintenance && this.now() >= this.expiresAt ? 'WORKER_CLAIM_EXPIRED' : `${phase}_TIMEOUT`);
55:   }
56: 
57:   async #drain(settlement: Promise<void>): Promise<boolean> {
58:     let timer: NodeJS.Timeout | undefined;
59:     try { return await Promise.race([settlement.then(() => true), new Promise<boolean>(resolve => {
60:       timer = setTimeout(() => resolve(false), this.timeoutMs);
61:     })]); } finally { if (timer) clearTimeout(timer); }
62:   }
63: }
64: 
65: export async function settlesWithin(operation: Promise<unknown>, timeoutMs: number): Promise<boolean> {
66:   let timer: NodeJS.Timeout | undefined;
67:   try { return await Promise.race([operation.then(() => true, () => true), new Promise<boolean>(resolve => {
68:     timer = setTimeout(() => resolve(false), timeoutMs);
69:   })]); } finally { if (timer) clearTimeout(timer); }
70: }
71: 
72: export function armWorkerClaimDeadline(expiresAt: number, now: () => number, expire: () => void): () => void {
73:   let timer: NodeJS.Timeout | undefined;
74:   const schedule = (): void => {
75:     const remaining = expiresAt - now();
76:     if (remaining <= 0) { expire(); return; }
77:     timer = setTimeout(schedule, Math.min(remaining, 2_147_483_647));
78:   };
79:   schedule(); return () => { if (timer) clearTimeout(timer); };
80: }

SOURCE skills/worker/core/worker/resource-accounting.ts SHA256 eaed91f776bfdbf1daac4faa7b2e56848b5f1b1f83d2737622048cd4426837ef
1: import {workerResourceMetrics,type WorkerAttemptEnvelope,type WorkerResourceObservations,type WorkerResourceUseV1,type WorkerResourceAccounting} from '@kubeclaw/pipeline-worker-core-contract';
2: import type { WorkerNativeResourceAccounting } from '@kubeclaw/pipeline-worker-core-contract';
3: import { assessNativeWorkerResources } from './native-resource-accounting.ts';
4: 
5: export type ResourceCheck={resources:Partial<WorkerResourceUseV1>;error?:{code:string;message:string}};
6: const positiveObservation=(value:unknown):value is number=>Number.isSafeInteger(value)&&Number(value)>=0;
7: function invalid(accounting?:WorkerResourceAccounting,message='Worker resource observation is missing or invalid'):ResourceCheck{
8:  if(accounting)for(const metric of workerResourceMetrics)accounting.observations[metric]={status:'unavailable',reason:message};
9:  return {resources:{},error:{code:'WORKER_RESOURCE_MEASUREMENT_INVALID',message}};
10: }
11: function regressed(current:Partial<WorkerResourceUseV1>,previous:Partial<WorkerResourceUseV1>):boolean {
12:  return workerResourceMetrics.some(metric=>current[metric]!==undefined && previous[metric]!==undefined && current[metric]!<previous[metric]!);
13: }
14: 
15: /** V1 remains strictly bounded. V2 never converts an unavailable observation to zero. */
16: export function assessWorkerResources(envelope:WorkerAttemptEnvelope,measured:unknown,accounting?:WorkerResourceAccounting | WorkerNativeResourceAccounting,previous:Partial<WorkerResourceUseV1>={}):ResourceCheck {
17:  if(envelope.schemaVersion==='worker-attempt-envelope.v1'){
18:   const values=measured as Record<string,unknown>|null;
19:   if(!values || !workerResourceMetrics.every(metric=>positiveObservation(values[metric])))return invalid();
20:   const resources=Object.fromEntries(workerResourceMetrics.map(metric=>[metric,values[metric]])) as Partial<WorkerResourceUseV1>;
21:   if(regressed(resources,previous))return invalid(undefined,'Cumulative worker resource observation regressed');
22:   const limits={cpuTimeMs:envelope.limits.cpuMillis,maximumMemoryBytes:envelope.limits.memoryBytes,maximumProcesses:envelope.limits.processes};
23:   const codes={cpuTimeMs:'WORKER_CPU_LIMIT',maximumMemoryBytes:'WORKER_MEMORY_LIMIT',maximumProcesses:'WORKER_PROCESS_LIMIT'};
24:   const exceeded=workerResourceMetrics.find(metric=>Number(resources[metric])>limits[metric]);
25:   return exceeded?{resources,error:{code:codes[exceeded],message:codes[exceeded]}}:{resources};
26:  }
27:  if(envelope.schemaVersion==='worker-attempt-envelope.v3'){
28:   if(accounting?.schemaVersion!=='worker-resource-accounting.v2')return invalid();
29:   return assessNativeWorkerResources(measured,accounting,previous);
30:  }
31:  if(accounting?.schemaVersion==='worker-resource-accounting.v2')return invalid();
32:  if(!accounting || !measured || typeof measured!=='object')return invalid(accounting);
33:  return assessDeclaredResources(measured as WorkerResourceObservations,accounting,previous);
34: }
35: 
36: function validObservation(observation:WorkerResourceObservations['cpuTimeMs'],capability:WorkerResourceAccounting['capabilities']['cpuTimeMs']):boolean {
37:  if(observation?.status==='observed')return positiveObservation(observation.value) && capability.measurement!=='unavailable';
38:  return observation?.status==='unavailable' && typeof observation.reason==='string' && observation.reason.length>0 && observation.reason.length<=4096;
39: }
40: function budgetError(metric:typeof workerResourceMetrics[number],observation:WorkerResourceObservations['cpuTimeMs'],budget:WorkerResourceAccounting['budgets']['cpuTimeMs']):ResourceCheck['error'] {
41:  if(budget.state==='unrequested')return undefined;
42:  if(observation.status==='unavailable')return {code:'WORKER_RESOURCE_MEASUREMENT_UNAVAILABLE',message:`Requested ${metric} budget cannot be established: ${observation.reason}`};
43:  if(observation.value>budget.limit)return {code:'WORKER_RESOURCE_LIMIT',message:`Requested ${metric} limit ${budget.limit} exceeded by ${observation.value}`};
44:  return undefined;
45: }
46: function assessDeclaredResources(measured:WorkerResourceObservations,accounting:WorkerResourceAccounting,previous:Partial<WorkerResourceUseV1>):ResourceCheck {
47:  // Validate the complete batch before mutating receipt accounting.
48:  if(!workerResourceMetrics.every(metric=>validObservation(measured[metric],accounting.capabilities[metric])))return invalid(accounting);
49:  const resources:Partial<WorkerResourceUseV1>={};let error:ResourceCheck['error'];
50:  for(const metric of workerResourceMetrics){
51:   const observation=measured[metric];
52:   if(observation.status==='observed')resources[metric]=observation.value;
53:   accounting.observations[metric]=structuredClone(observation);
54:   error??=budgetError(metric,observation,accounting.budgets[metric]);
55:  }
56:  if(regressed(resources,previous))return invalid(accounting,'Cumulative worker resource observation regressed');
57:  return {...(error?{error}:{}),resources};
58: }
59: 
60: export function unsupportedWorkerBudget(envelope:WorkerAttemptEnvelope):string|undefined {
61:  if(envelope.schemaVersion!=='worker-attempt-envelope.v2')return undefined;
62:  return workerResourceMetrics.find(metric=>envelope.resourceBudgets[metric].state==='requested' && envelope.profile.resourceCapabilities[metric].measurement==='unavailable');
63: }

SOURCE skills/worker/core/worker/resource-reservations.ts SHA256 781ba82f68942a44ba3c40652adffb76d8ceb369c279909dc826fbc361fd63e9
1: import type { NativeWorkerScopeLimits } from './native-resource-scope.ts';
2: 
3: export class NativeWorkerCapacityExceeded extends Error {
4:   constructor() { super('WORKER_NATIVE_CAPACITY_EXCEEDED'); }
5: }
6: 
7: function positive(value: number): void {
8:   if (!Number.isSafeInteger(value) || value < 1) throw new Error('WORKER_NATIVE_CAPACITY_INVALID');
9: }
10: 
11: /** Synchronous reservations include pending filesystem allocation, not just running hosts. */
12: export class WorkerResourceReservations {
13:   readonly #maximum: NativeWorkerScopeLimits;
14:   readonly #maximumScopes: number;
15:   #memoryBytes = 0;
16:   #tasks = 0;
17:   #scopes = 0;
18: 
19:   constructor(maximum: NativeWorkerScopeLimits, maximumScopes: number) {
20:     positive(maximum.memoryBytes); positive(maximum.tasks); positive(maximumScopes);
21:     this.#maximum = Object.freeze({ ...maximum });
22:     this.#maximumScopes = maximumScopes;
23:   }
24: 
25:   reserve(limits: NativeWorkerScopeLimits): () => void {
26:     const { memoryBytes, tasks } = limits;
27:     positive(memoryBytes); positive(tasks);
28:     if (this.#scopes >= this.#maximumScopes || memoryBytes > this.#maximum.memoryBytes - this.#memoryBytes
29:       || tasks > this.#maximum.tasks - this.#tasks) throw new NativeWorkerCapacityExceeded();
30:     this.#memoryBytes += memoryBytes; this.#tasks += tasks; this.#scopes++;
31:     let released = false;
32:     return () => {
33:       if (released) return;
34:       released = true;
35:       this.#memoryBytes -= memoryBytes; this.#tasks -= tasks; this.#scopes--;
36:     };
37:   }
38: }

SOURCE skills/worker/core/worker/resource-result-fields.ts SHA256 d109f3aedf33fca9a84eab376d96ae714ea4134af5cfebf7c495cb7db89e218f
1: import type { WorkerAttemptEnvelope, WorkerNativeResourceAccounting, WorkerResourceAccounting } from '@kubeclaw/pipeline-worker-core-contract';
2: 
3: /** Keep the accepted discriminator and its matching policy together in terminal receipts. */
4: export function resourceResultFields(envelope: WorkerAttemptEnvelope,
5:   accounting: WorkerResourceAccounting | WorkerNativeResourceAccounting | undefined) {
6:   if (envelope.schemaVersion === 'worker-attempt-envelope.v1') return { schemaVersion: 'worker-attempt-result.v1' as const };
7:   const identity = { profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest };
8:   if (envelope.schemaVersion === 'worker-attempt-envelope.v3') {
9:     if (accounting?.schemaVersion !== 'worker-resource-accounting.v2') throw new Error('WORKER_NATIVE_ACCOUNTING_POLICY_MISSING');
10:     return { ...identity, schemaVersion: 'worker-attempt-result.v3' as const, resourceAccounting: structuredClone(accounting) };
11:   }
12:   if (accounting?.schemaVersion !== 'worker-resource-accounting.v1') throw new Error('WORKER_ACCOUNTING_POLICY_MISSING');
13:   return { ...identity, schemaVersion: 'worker-attempt-result.v2' as const, resourceAccounting: structuredClone(accounting) };
14: }

SOURCE skills/worker/core/worker/trust.ts SHA256 722f48ca75fb8546dbc4f4c9cc8eab8e31dfdfeafec7ea7aab587045e78b23fe
1: const SPIFFE_ID = /^spiffe:\/\/[a-z0-9.-]+\/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+$/u;
2: 
3: export interface WorkerPrincipal {
4:   readonly authentication: 'spiffe-x509-svid';
5:   readonly spiffeId: string;
6: }
7: 
8: function headerValue(
9:   headers: Readonly<Record<string, string | string[] | undefined>>,
10:   name: string,
11: ): string {
12:   const value = headers[name] ?? headers[name.toLowerCase()];
13:   if (Array.isArray(value)) return value.join(',');
14:   return value ?? '';
15: }
16: 
17: export function spiffePeerFromForwardedClientCertificate(
18:   headers: Readonly<Record<string, string | string[] | undefined>>,
19: ): WorkerPrincipal {
20:   const forwarded = headerValue(headers, 'x-forwarded-client-cert');
21:   if (!forwarded || forwarded.includes(',')) throw new Error('WORKER_TRUST_PEER_MISSING');
22:   const uriFields = forwarded.split(';').map((field) => field.trim())
23:     .filter((field) => field.startsWith('URI='));
24:   if (uriFields.length !== 1) throw new Error('WORKER_TRUST_PEER_INVALID');
25:   const match = /^URI=(?:"([^"]+)"|([^";]+))$/u.exec(uriFields[0]!);
26:   const spiffeId = (match?.[1] ?? match?.[2] ?? '').trim();
27:   if (!SPIFFE_ID.test(spiffeId)) throw new Error('WORKER_TRUST_PEER_INVALID');
28:   return Object.freeze({ authentication: 'spiffe-x509-svid', spiffeId });
29: }
30: 
31: export function authorizeSpiffePeer(
32:   headers: Readonly<Record<string, string | string[] | undefined>>,
33:   allowedSpiffeIds: ReadonlySet<string>,
34: ): WorkerPrincipal {
35:   if (allowedSpiffeIds.size === 0 || [...allowedSpiffeIds].some((id) => !SPIFFE_ID.test(id))) {
36:     throw new Error('WORKER_TRUST_POLICY_INVALID');
37:   }
38:   const principal = spiffePeerFromForwardedClientCertificate(headers);
39:   if (!allowedSpiffeIds.has(principal.spiffeId)) throw new Error('WORKER_TRUST_PEER_FORBIDDEN');
40:   return principal;
41: }
42: 
43: export function authorizeProxiedSpiffePeer(
44:   headers: Readonly<Record<string, string | string[] | undefined>>,
45:   remoteAddress: string | undefined,
46:   allowedSpiffeIds: ReadonlySet<string>,
47: ): WorkerPrincipal {
48:   if (!remoteAddress || !['127.0.0.1', '::1', '::ffff:127.0.0.1'].includes(remoteAddress)) {
49:     throw new Error('WORKER_TRUST_PROXY_REQUIRED');
50:   }
51:   return authorizeSpiffePeer(headers, allowedSpiffeIds);
52: }
