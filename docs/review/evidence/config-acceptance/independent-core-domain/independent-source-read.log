36: function providerWorkspace(workspaceRootValue: string, allowed: ProviderInvocationV1['workspace']) {
37:     const workspaceRoot = fs.realpathSync(workspaceRootValue);
38:     const repository = path.resolve(workspaceRoot, allowed.repository);
39:     const scratch = path.resolve(workspaceRoot, allowed.scratch);
40:     const evidence = path.resolve(workspaceRoot, allowed.evidence);
41:     for (const item of [repository, scratch, evidence]) {
42:       if (!item.startsWith(`${workspaceRoot}${path.sep}`)) throw new Error('TEST_PROVIDER_WORKSPACE_FORBIDDEN');
43:     }
44:     return { repository, scratch, evidence };
45: }
