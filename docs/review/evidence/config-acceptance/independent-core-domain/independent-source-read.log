107: export class RegisteredReportAdapterRuntime {
108:   readonly #policy: BusterReportExecutionSettings;
109:   readonly #processInputPolicy: BusterProcessInputSettings;
110:   readonly #reader: ReportArtifactReader;
111:   readonly #runtimeRoot: string;
112:   readonly #runtimeRootIdentity: { readonly dev: number; readonly ino: number };
113: 
114:   constructor(reader: ReportArtifactReader, runtimeRoot: string, policy: BusterReportExecutionSettings, processInputPolicy: BusterProcessInputSettings) {
115:     this.#processInputPolicy = validateBusterProcessInputSettings(processInputPolicy);
116:     this.#policy = validateBusterReportSettings(policy);
117:     if (!path.isAbsolute(runtimeRoot)) throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_NOT_ABSOLUTE');
118:     const resolvedRoot = path.resolve(runtimeRoot);
119:     if (resolvedRoot === path.parse(resolvedRoot).root) throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_TOO_BROAD');
120:     fs.mkdirSync(runtimeRoot, { recursive: true, mode: 0o700 });
121:     const rootStat = fs.lstatSync(runtimeRoot);
122:     if (!rootStat.isDirectory() || rootStat.isSymbolicLink()) throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_FORBIDDEN');
123:     if (typeof process.getuid === 'function' && rootStat.uid !== process.getuid()) {
124:       throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_OWNER_MISMATCH');
125:     }
126:     const parentStat = fs.statSync(path.dirname(runtimeRoot));
127:     const sticky = (parentStat.mode & 0o1000) !== 0;
128:     const writableByOthers = (parentStat.mode & 0o022) !== 0;
129:     if (writableByOthers) {
130:       const currentUid = typeof process.getuid === 'function' ? process.getuid() : undefined;
131:       const trustedOwner = currentUid === undefined || parentStat.uid === currentUid || parentStat.uid === 0;
132:       if (!sticky || !trustedOwner) throw new Error('REPORT_ADAPTER_RUNTIME_PARENT_FORBIDDEN');
133:     }
134:     fs.chmodSync(runtimeRoot, 0o700);
135:     this.#reader = reader;
136:     this.#runtimeRoot = fs.realpathSync(runtimeRoot);
137:     const identity = fs.statSync(this.#runtimeRoot);
138:     this.#runtimeRootIdentity = { dev: identity.dev, ino: identity.ino };
139:   }
140: 
141:   #assertRuntimeRoot(): void {
142:     const current = fs.lstatSync(this.#runtimeRoot);
143:     const canonical = fs.realpathSync(this.#runtimeRoot);
144:     if (!current.isDirectory() || current.isSymbolicLink() || canonical !== this.#runtimeRoot
145:       || current.dev !== this.#runtimeRootIdentity.dev || current.ino !== this.#runtimeRootIdentity.ino) {
146:       throw new Error('REPORT_ADAPTER_RUNTIME_ROOT_CHANGED');
147:     }
148:   }
149: 
150:   async adapt(entry: ReportAdapterRegistryEntry, artifact: ArtifactRefV1,
151:     limits: ReportAdapterRuntimeLimits, signal?: AbortSignal): Promise<ReportAdapterResultV1> {
152:     validateLimits(limits, this.#policy);
153:     const deadline = new AbortController();
154:     const timer = setTimeout(() => deadline.abort(new Error('REPORT_ADAPTER_TIMEOUT')), limits.timeoutMs);
155:     const boundedSignal = signal ? AbortSignal.any([signal, deadline.signal]) : deadline.signal;
156:     try {
157:       return await this.#adaptWithinDeadline(entry, artifact, limits, boundedSignal);
158:     } catch (error) {
159:       // The process helper wraps signal aborts after drain; preserve our own deadline identity.
160:       if (deadline.signal.aborted && boundedSignal.reason === deadline.signal.reason
161:         && error instanceof Error && error.message === 'REPORT_ADAPTER_CANCELLED'
162:         && error.cause === deadline.signal.reason) throw deadline.signal.reason;
163:       throw error;
164:     } finally {
165:       clearTimeout(timer);
166:     }
167:   }
168: 
169:   async #readSource(entry: ReportAdapterRegistryEntry, artifact: ArtifactRefV1,
170:     limits: ReportAdapterRuntimeLimits, signal: AbortSignal): Promise<Buffer> {
171:     if (artifact.type !== 'test-report') {
172:       throw new Error(`REPORT_ADAPTER_ARTIFACT_TYPE_FORBIDDEN:${artifact.type}`);
173:     }
174:     if (!entry.registration.mediaTypes.includes(artifact.mediaType)) {
175:       throw new Error(`REPORT_ADAPTER_MEDIA_TYPE_UNSUPPORTED:${artifact.mediaType}`);
176:     }
177:     if (signal.aborted) throw signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED');
178:     const bytes = await abortable(this.#reader.read(artifact, limits.maximumSourceBytes, signal), signal);
179:     if (signal.aborted) throw signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED');
180:     if (bytes.byteLength !== artifact.sizeBytes || bytes.byteLength > limits.maximumSourceBytes) {
181:       throw new Error('REPORT_ARTIFACT_SIZE_MISMATCH');
182:     }
183:     const sourceDigest = `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}`;
184:     if (sourceDigest !== artifact.contentDigest) throw new Error('REPORT_ARTIFACT_DIGEST_MISMATCH');
185:     return bytes;
186:   }
187: 
188:   async #adaptWithinDeadline(entry: ReportAdapterRegistryEntry, artifact: ArtifactRefV1,
189:     limits: ReportAdapterRuntimeLimits, signal: AbortSignal): Promise<ReportAdapterResultV1> {
190:     this.#assertRuntimeRoot();
191:     const bytes = await this.#readSource(entry, artifact, limits, signal);
192:     const expectedDigest = entry.registration.package.contentDigest;
193:     const sourcePackage = await abortable(readPackage(entry.package.root, signal), signal);
194:     if (sourcePackage.digest !== expectedDigest) {
195:       throw new Error(`REPORT_ADAPTER_PACKAGE_DIGEST_MISMATCH:${entry.registration.adapterId}`);
196:     }
197: 
198:     const snapshot = path.join(this.#runtimeRoot, `adapter-${crypto.randomUUID()}`);
199:     let disposalConfirmed = true;
200:     try {
201:       await abortable(writePackageSnapshot(snapshot, sourcePackage.files, signal), signal);
202:       this.#assertRuntimeRoot();
203:       const copiedPackage = await abortable(readPackage(snapshot, signal), signal);
204:       if (copiedPackage.digest !== expectedDigest) throw new Error('REPORT_ADAPTER_PACKAGE_SNAPSHOT_MISMATCH');
205:       if (signal.aborted) throw signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED');
206:       const packageRoot = fs.realpathSync(snapshot);
207:       const modulePath = fs.realpathSync(path.resolve(packageRoot, entry.registration.entrypoint.module));
208:       if (!modulePath.startsWith(`${packageRoot}${path.sep}`) || !fs.statSync(modulePath).isFile()) {
209:         throw new Error('REPORT_ADAPTER_MODULE_FORBIDDEN');
210:       }
211:       const value = await this.#run(entry, artifact, bytes, limits, packageRoot, modulePath, signal);
212:       return bindReportResult(value, entry, artifact, limits);
213:     } catch (error) {
214:       if (error instanceof ProcessInputCleanupError) disposalConfirmed = false;
215:       throw error;
216:     } finally {
217:       if (disposalConfirmed) fs.rmSync(snapshot, { recursive: true, force: true });
218:     }
219:   }
220: 
221:   async #run(entry: ReportAdapterRegistryEntry, artifact: ArtifactRefV1, bytes: Buffer,
222:     limits: ReportAdapterRuntimeLimits, packageRoot: string, modulePath: string,
223:     signal?: AbortSignal): Promise<ReportAdapterOutput> {
224:     if (signal?.aborted) return Promise.reject(signal.reason ?? new Error('REPORT_ADAPTER_CANCELLED'));
225:     if (limits.cpuMillis % 1000 !== 0) return Promise.reject(new Error('REPORT_ADAPTER_CPU_LIMIT_GRANULARITY'));
226:     const runtime = runtimePaths();
227:     const result = await runProcessInput(runtime.launcher, [
228:         String(limits.memoryBytes), String(limits.cpuMillis / 1000),
229:         String(limits.openFiles), process.execPath,
230:         `--max-old-space-size=${Math.max(this.#policy.minimumHeapMiB, Math.floor(limits.memoryBytes / (1024 * 1024) * this.#policy.heapFraction))}`,
231:         '--permission', `--allow-fs-read=${runtime.child}`, `--allow-fs-read=${packageRoot}`,
232:         '--no-addons', '--no-experimental-sqlite', runtime.child,
233:       ], {
234:       processInputPolicy: this.#processInputPolicy, cwd: packageRoot, env: { NODE_NO_WARNINGS: '1' }, ...(signal ? { signal } : {}),
235:       timeoutMs: limits.timeoutMs, maximumOutputBytes: limits.maximumResultBytes,
236:       prefix: 'REPORT_ADAPTER', outputLimitError: 'REPORT_ADAPTER_RESULT_LIMIT', input: `${JSON.stringify({
237:         kind: 'adapt',
238:         modulePath,
239:         exportName: entry.registration.entrypoint.export,
240:         mediaType: artifact.mediaType,
241:         contentBase64: bytes.toString('base64'),
242:         limits: {
243:           maximumCases: limits.maximumCases,
244:           maximumFindings: limits.maximumFindings,
245:           maximumCaseFindings: limits.maximumCaseFindings,
246:         },
247:       })}\n`,
248:     });
249:     const lines = result.stdout.toString('utf8').trim().split('\n');
250:     if (lines.length !== 1) throw new Error('REPORT_ADAPTER_PROTOCOL_INVALID');
251:     let message: { kind?: string; value?: ReportAdapterOutput; error?: string };
252:     try { message = JSON.parse(lines[0]!) as typeof message; }
253:     catch (error) { throw new Error(`REPORT_ADAPTER_PROTOCOL_INVALID:${String(result.code)}:${String(result.signal)}`, { cause: error }); }
254:     if (message.kind === 'result' && result.code === 0 && message.value) return message.value;
255:     throw new Error(`REPORT_ADAPTER_FAILED:${message.error ?? `${String(result.code)}:${String(result.signal)}`}`);
256:   }
257: }

SOURCE skills/buster/engine/test-gates/runner-attempt-envelope.ts SHA256 15994d9caebf7f98f2e23740a66ad105ec721c0ebbe01aba22def8a9e4c5bad4
1: import type { ProviderInvocationV1, ResolvedPlanNodeV1 } from '@kubeclaw/pipeline-test-gate-contract';
2: import type { WorkerAttemptEnvelopeV1 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { sha256Digest, workerAttemptSpecDigest, type WorkerAttemptOperation } from '@kubeclaw/worker-core';
4: import { createBusterWorkerProfile } from './runner-worker-profile.ts';
5: import type { TestPlanRunnerOptions } from './runner-types.ts';
6: interface EnvelopeInput {
7:  readonly options: TestPlanRunnerOptions;
8:  readonly node: ResolvedPlanNodeV1;
9:  readonly attemptId: string;
10:  readonly attemptNumber: number;
11:  readonly granted: readonly string[];
12:  readonly cleanupTimeoutMs: number;
13:  readonly providerResultLimit: number;
14:  readonly invocation: ProviderInvocationV1;
15:  readonly operation: WorkerAttemptOperation;
16:  readonly issuedAt: Date;
17: }
18: function envelopeLimits(node: ResolvedPlanNodeV1, cleanupTimeoutMs: number, providerResultLimit: number, reportResultLimit: number, workerResultWrapperBytes: number) {
19:  return {
20:         timeoutMs: node.timeoutMs,
21:         cleanupTimeoutMs,
22:         cpuMillis: node.limits.cpuMillis,
23:         memoryBytes: node.limits.memoryBytes,
24:         processes: node.limits.processes,
25:         logBytes: node.limits.logBytes,
26:         resultBytes: providerResultLimit + reportResultLimit + workerResultWrapperBytes,
27:         evidenceBytes: node.limits.artifactBytes,
28:         evidenceFiles: node.limits.artifactFiles,
29:       };
30: }
31: function envelopeOperation(invocation: ProviderInvocationV1) {
32:  return {
33:         contractId: "kubeclaw.buster-provider-attempt@1",
34:         inputSchemaId: "kubeclaw.buster-provider-attempt.v1",
35:         inputSchemaDigest: sha256Digest({
36:           schemaId: "kubeclaw.buster-provider-attempt.v1",
37:         }),
38:         values: { invocation: structuredClone(invocation) } as never,
39:       };
40: }
41: export function createRunnerEnvelope(input: EnvelopeInput): WorkerAttemptEnvelopeV1 {
42:  const { options, node, attemptId, attemptNumber, granted, cleanupTimeoutMs, providerResultLimit,
43:    invocation, operation, issuedAt } = input;
44:     const profile = createBusterWorkerProfile(options.registry, granted);
45:     const completionPhases = 3 + Number(Boolean(operation.cleanup)) + Number(Boolean(operation.collectEvidence)) + Number(Boolean(operation.finalizeResult));
46:     const claimWindowMs = node.timeoutMs + completionPhases * cleanupTimeoutMs + options.executionPolicy.provider.claimGraceMs;
47:     const envelopeBase = {
48:       schemaVersion: "worker-attempt-envelope.v1" as const,
49:       protocolVersion: "worker-protocol.v1" as const,
50:       pipelineRunId: options.plan.runId,
51:       moduleId: options.plan.scope.moduleId,
52:       gateId: options.plan.scope.gateId,
53:       planId: options.plan.planId,
54:       nodeId: node.id,
55:       executionId: node.executionId,
56:       attemptId,
57:       attemptNumber,
58:       claim: {
59:         schemaVersion: "attempt-claim.v1" as const,
60:         claimId: `claim:${attemptId}`,
61:         attemptId,
62:         generation: 1,
63:         workerId: "worker:buster:local",
64:         claimedAt: issuedAt.toISOString(),
65:         expiresAt: new Date(issuedAt.getTime() + claimWindowMs).toISOString(),
66:       },
67:       profile,
68:       packages: [
69:         {
70:           packageId: node.provider.packageId,
71:           packageVersion: node.provider.packageVersion,
72:           contentDigest: node.provider.contentDigest,
73:         },
74:       ],
75:       grantedCapabilities: [...granted],
76:       limits: envelopeLimits(node, cleanupTimeoutMs, providerResultLimit, options.executionPolicy.reports.maximumAggregateResultBytes, options.executionPolicy.provider.workerResultWrapperBytes),
77:       inputs: [],
78:       operation: envelopeOperation(invocation),
79:       cancellationId: `cancel:${attemptId}`,
80:       issuedAt: issuedAt.toISOString(),
81:       queueDeadline: new Date(issuedAt.getTime() + options.executionPolicy.provider.queueTimeoutMs).toISOString(),
82:     };
83:     const workerEnvelope: WorkerAttemptEnvelopeV1 = {
84:       ...envelopeBase,
85:       attemptSpecDigest: workerAttemptSpecDigest({
86:         ...envelopeBase,
87:         attemptSpecDigest: "",
88:       }),
89:     };
90:  return workerEnvelope;
91: }

SOURCE skills/buster/engine/test-gates/runner-attempt-execution.ts SHA256 9012607f67aeb7abe5aa29ae6687ea1e43b091b3bea3c1b57b0ed9d01fa6c705
1: import fs from 'node:fs';
2: import { WorkerAttemptExecutor, type WorkerAttemptOperation } from '@kubeclaw/worker-core';
3: import type { WorkerAttemptEnvelopeV1, WorkerAttemptResultV1 } from '@kubeclaw/pipeline-worker-core-contract';
4: import type { TestPlanRunnerOptions, WorkerAttemptRuntime } from './runner-types.ts';
5: import { canonical } from './canonical-value.ts';
6: import { detail } from './runner-values.ts';
7: import { persistRunnerCompletion, type CompletionOwner } from './runner-completion.ts';
8: interface ExecutionOwner {
9:  readonly options: TestPlanRunnerOptions;
10:  readonly workerRuntime: WorkerAttemptRuntime;
11:  readonly now: () => Date;
12:  readonly id: () => string;
13:  readonly authorityId: string;
14:  readonly completion: CompletionOwner;
15: }
16: export async function executeRunnerAttempt(owner: ExecutionOwner, workerEnvelope: WorkerAttemptEnvelopeV1,
17:   operation: WorkerAttemptOperation, stagingBase: string) {
18:     let workerResult: WorkerAttemptResultV1 | null = null;
19:     let completedWorkerResult: WorkerAttemptResultV1 | null = null;
20:     let workerRuntimeFault: string | null = null;
21:     try {
22:       workerResult = await owner.workerRuntime.runAttempt(
23:         workerEnvelope,
24:         async (workerSignal) => {
25:           const signals = [
26:             workerSignal,
27:             ...(owner.options.signal ? [owner.options.signal] : []),
28:           ];
29:           const signal =
30:             signals.length === 1 ? workerSignal : AbortSignal.any(signals);
31:           completedWorkerResult = await new WorkerAttemptExecutor({
32:             envelope: workerEnvelope,
33:             operation,
34:             signal,
35:             retainLogs: false,
36:             now: owner.now,
37:             id: owner.id,
38:             receiptNamespace: owner.authorityId,
39:           }).execute();
40:           return completedWorkerResult;
41:         },
42:       );
43:       if (
44:         !workerResult ||
45:         !completedWorkerResult ||
46:         canonical(workerResult) !== canonical(completedWorkerResult)
47:       )
48:         throw new Error("WORKER_RUNTIME_RESULT_MISMATCH");
49:       // The authoritative completion intent remains durable even if admission is pending.
50:       workerResult = await persistRunnerCompletion(owner.completion, workerEnvelope, workerResult);
51:       completedWorkerResult = workerResult;
52:     } catch (error) {
53:       workerRuntimeFault = detail(error);
54:       workerResult = completedWorkerResult;
55:     } finally {
56:       await fs.promises.rm(stagingBase, { recursive: true, force: true });
57:     }
58:     return { workerResult, workerRuntimeFault };
59: }

SOURCE skills/buster/engine/test-gates/runner-provider-operation.ts SHA256 332e73e5e35b28800ab7ad70331adf8c2ed683f819a0ea6504eea0abbb61645c
1: import fs from 'node:fs';
2: import type { TestProviderExecutionContext } from '@kubeclaw/plugin-sdk';
3: import { sha256Digest, type WorkerAttemptOperation, type WorkerAttemptOperationResult } from '@kubeclaw/worker-core';
4: import { stageEvidenceFiles } from './artifacts.ts';
5: import { validateBusterProviderResult } from './provider-result-validation.ts';
6: import { finalizeBusterReports } from './specialist-report-finalization.ts';
7: import { freeze, selectedEvidenceTypes } from './runner-values.ts';
8: import { addOutputEvidenceTypes, collectRunnerAttemptEvidence } from './runner-attempt-evidence.ts';
9: import type { RunnerProviderInput, RunnerProviderState } from './runner-provider-state.ts';
10: 
11: type ExecutionContext = Parameters<WorkerAttemptOperation['execute']>[0];
12: 
13: function providerContext(input: RunnerProviderInput, context: ExecutionContext): TestProviderExecutionContext {
14:   return input.context(context.signal, (stream, value) => {
15:     input.busterLog.contextLog(stream, value);
16:     context.log(stream, value);
17:   }, new Set(input.granted), input.invocation.inputs);
18: }
19: 
20: function assertNotAborted(signal: AbortSignal): void {
21:   if (signal.aborted) throw signal.reason ?? new Error('TEST_PROVIDER_CANCELLED');
22: }
23: 
24: async function initializeProvider(input: RunnerProviderInput, state: RunnerProviderState,
25:   workerContext: ExecutionContext, context: TestProviderExecutionContext): Promise<void> {
26:   state.loadWork = input.loader.load(input.entry, input.invocation, input.workspaceRoot, workerContext.signal);
27:   state.instance = await state.loadWork;
28:   assertNotAborted(workerContext.signal);
29:   if (input.node.kind === 'fixture') {
30:     state.fixtureInitializationStarted = true;
31:     const supportsCleanup = await state.instance.supportsCleanup(context);
32:     assertNotAborted(workerContext.signal);
33:     if (!supportsCleanup) throw new Error('TEST_PROVIDER_FIXTURE_CLEANUP_REQUIRED');
34:   }
35:   assertNotAborted(workerContext.signal);
36: }
37: 
38: async function stageProviderEvidence(input: RunnerProviderInput, state: RunnerProviderState,
39:   selected: Set<string>, signal: AbortSignal): Promise<void> {
40:   const candidates = state.providerResult!.evidenceFiles.filter(item => input.node.evidence.onError.includes(item.type));
41:   try {
42:     await stageEvidenceFiles(input.evidenceDirectory, input.stagedErrorEvidenceDirectory, candidates,
43:       input.node.limits.artifactFiles, input.node.limits.artifactBytes, signal);
44:     state.stagedErrorFiles = candidates;
45:   } catch (error) {
46:     await fs.promises.rm(input.stagedErrorEvidenceDirectory, { recursive: true, force: true });
47:     state.stagedErrorFiles = [];
48:     if (signal.aborted) throw error;
49:   }
50:   state.stagedFiles = state.providerResult!.evidenceFiles.filter(item => selected.has(item.type));
51:   await stageEvidenceFiles(input.evidenceDirectory, input.stagedEvidenceDirectory, state.stagedFiles,
52:     input.node.limits.artifactFiles, input.node.limits.artifactBytes, signal);
53: }
54: 
55: async function executeProvider(input: RunnerProviderInput, state: RunnerProviderState,
56:   workerContext: ExecutionContext): Promise<WorkerAttemptOperationResult> {
57:   const context = providerContext(input, workerContext);
58:   await initializeProvider(input, state, workerContext, context);
59:   state.executionStarted = true;
60:   state.providerResult = await state.instance!.execute(input.invocation, context);
61:   validateBusterProviderResult(input.entry, state.providerResult, input.providerResultLimit);
62:   state.providerResult = freeze(structuredClone(state.providerResult));
63:   const selected = selectedEvidenceTypes(input.node, 'completed', state.providerResult.outcome);
64:   addOutputEvidenceTypes(state.providerResult, selected);
65:   state.stagingWork = stageProviderEvidence(input, state, selected, workerContext.signal);
66:   await state.stagingWork;
67:   state.retainFixture = input.node.kind === 'fixture' && state.providerResult.outcome === 'passed';
68:   return {
69:     summary: state.providerResult.summary,
70:     specialistResult: {
71:       schemaId: 'kubeclaw.buster-provider-result.v1',
72:       schemaDigest: sha256Digest({ schemaId: 'kubeclaw.buster-provider-result.v1' }),
73:       values: { providerResult: structuredClone(state.providerResult) } as never,
74:     },
75:     evidence: [], exitCode: state.providerResult.exitCode, signal: state.providerResult.signal,
76:   };
77: }
78: 
79: async function cleanupProviderOperation(input: RunnerProviderInput, state: RunnerProviderState,
80:   workerContext: ExecutionContext): Promise<void> {
81:   if (!state.executionStarted && !state.fixtureInitializationStarted) {
82:     await state.instance?.discard?.();
83:     return;
84:   }
85:   if (!state.instance?.cleanup || state.retainFixture) return;
86:   await state.instance.cleanup(input.invocation, providerContext(input, workerContext), 'incomplete');
87: }
88: 
89: export function createRunnerProviderOperation(input: RunnerProviderInput, state: RunnerProviderState,
90:   preparationFault: Error | null, missingCapability: string | undefined): WorkerAttemptOperation {
91:   return {
92:     prepare: () => {
93:       if (preparationFault) throw preparationFault;
94:       if (missingCapability) throw new Error(`TEST_PROVIDER_CAPABILITY_DENIED:${missingCapability}`);
95:       return undefined;
96:     },
97:     execute: context => executeProvider(input, state, context),
98:     terminate: async () => {
99:       const loaded = state.instance ?? (await state.loadWork?.catch(() => null));
100:       await loaded?.terminate();
101:       await state.stagingWork?.catch(() => undefined);
102:     },
103:     measure: async () => {
104:       const measured = state.instance?.resources() ?? { cpuTimeMs: 0, maximumMemoryBytes: 0, maximumProcesses: 0 };
105:       return { cpuTimeMs: Math.ceil(measured.cpuTimeMs ?? 0),
106:         maximumMemoryBytes: Math.ceil(measured.maximumMemoryBytes ?? 0),
107:         maximumProcesses: Math.ceil(measured.maximumProcesses ?? 0) };
108:     },
109:     cleanup: context => cleanupProviderOperation(input, state, context),
110:     collectEvidence: phase => collectRunnerAttemptEvidence(input, state, phase),
111:     finalizeResult: ({ evidence, specialistResult, signal }) => finalizeBusterReports(
112:       { node: input.node, providerResult: state.providerResult, evidence, specialistResult, cleanupTimeoutMs: input.cleanupTimeoutMs, reportPolicy: input.options.executionPolicy.reports },
113:       { registry: input.options.registry, reportAdapterRuntime: input.reportAdapterRuntime, signal },
114:     ),
115:   };
116: }

SOURCE skills/buster/engine/test-gates/runner-worker-profile.ts SHA256 4e7cc1f1206047bf768b1826d979fc5384fe1edc7e3e4fa9bb71e24e5d31a648
1: import crypto from 'node:crypto';
2: import type { ResolvedPlanNodeV1, ResolvedTestPlanV1 } from '@kubeclaw/pipeline-test-gate-contract';
3: import type { RegistrySnapshot, TestProviderRegistryEntry } from '@kubeclaw/plugin-foundation/registry/types';
4: import type { WorkerProfileV1 } from '@kubeclaw/pipeline-worker-core-contract';
5: import { workerProfileDigest } from '@kubeclaw/worker-core';
6: import { compareText } from './runner-values.ts';
7: export function providerEntry(
8:   registry: RegistrySnapshot,
9:   node: ResolvedPlanNodeV1,
10: ): TestProviderRegistryEntry {
11:   const entry = registry.testProviderContracts.get(node.provider.contractId);
12:   if (!entry)
13:     throw new Error(`TEST_PROVIDER_MISSING:${node.provider.contractId}`);
14:   return entry;
15: }
16: 
17: function registrationGrants(grants: ReadonlyMap<string, readonly string[]> | undefined,
18:   registrationId: string): readonly string[] {
19:   const selected = grants?.get(registrationId);
20:   return selected === undefined || selected === null ? [] : selected;
21: }
22: 
23: export function grantedCapabilities(
24:   options: {
25:     readonly registry: RegistrySnapshot;
26:     readonly grants: ReadonlyMap<string, readonly string[]> | undefined;
27:   },
28:   node: ResolvedPlanNodeV1,
29: ): string[] {
30:   const entry = providerEntry(options.registry, node);
31:   const registrationId = `${entry.registration.package.packageId}:${entry.registration.registrationId}`;
32:   const nodeGrants = options.grants?.get(node.id);
33:   const configured = new Set(nodeGrants !== undefined && nodeGrants !== null
34:     ? nodeGrants
35:     : registrationGrants(options.grants, registrationId));
36:   return entry.registration.capabilities
37:     .filter((capability) => configured.has(capability))
38:     .sort();
39: }
40: 
41: export function createBusterWorkerProfile(
42:   registry: RegistrySnapshot,
43:   granted: readonly string[],
44: ): WorkerProfileV1 {
45:   const capabilities = [...new Set(["provider.execute", ...granted])].sort();
46:   const capabilityKey = crypto.createHash('sha256').update(capabilities.join('\0')).digest('hex').slice(0, 16);
47:   const base = {
48:     schemaVersion: "worker-profile.v1" as const,
49:     profileId: `buster.local.${capabilityKey}`,
50:     workerType: "buster",
51:     coreContractId: "kubeclaw.worker-core@1",
52:     engine: {
53:       engineId: "buster-test-engine",
54:       contractId: "kubeclaw.buster-engine@1",
55:       engineVersion: "1.0.0",
56:       contentDigest: registry.snapshotDigest,
57:     },
58:     capabilities,
59:   };
60:   return { ...base, profileDigest: workerProfileDigest(base) };
61: }
62: 
63: export function createBusterWorkerProfiles(
64:   plan: ResolvedTestPlanV1,
65:   registry: RegistrySnapshot,
66:   grants?: ReadonlyMap<string, readonly string[]>,
67: ): WorkerProfileV1[] {
68:   const profiles = new Map<string, WorkerProfileV1>();
69:   for (const node of plan.nodes) {
70:     const granted = grantedCapabilities({ registry, grants }, node);
71:     const profile = createBusterWorkerProfile(registry, granted);
72:     profiles.set(profile.profileDigest, profile);
73:   }
74:   return [...profiles.values()].sort((left, right) =>
75:     compareText(left.profileDigest, right.profileDigest),
76:   );
77: }
78: 

SOURCE skills/buster/engine/test-gates/runner.ts SHA256 8db6fb069648014e1cfb2c63f33de1382219279b1358a76a15a1936e3b80732a
