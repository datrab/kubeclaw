597:       claimId: envelope.claim.claimId,
598:       claimGeneration: envelope.claim.generation,
599:       workerId: envelope.claim.workerId,
600:       sequence: this.#progressSequence++,
601:       state,
602:       message,
603:       progressPercent: null,
604:       details: {} as Record<string, JsonValue>,
