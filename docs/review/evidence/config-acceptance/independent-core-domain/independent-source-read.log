1: import { createServer, type IncomingMessage, type Server, type ServerResponse } from 'node:http';
2: import type { WorkerAttemptResult } from '@kubeclaw/pipeline-worker-core-contract';
3: import { workerIngressLimits } from './worker-config.ts';
4: 
5: type Handler = (request: IncomingMessage, response: ServerResponse, signal: AbortSignal) => Promise<WorkerAttemptResult | void>;
6: export type ManagedWorkerServer = Server & { shutdown(timeoutMs: number): Promise<void> };
7: 
8: /** A fulfilled HTTP handler is not evidence that unresolved Core work stopped. */
9: function unresolved(result: WorkerAttemptResult | void): boolean {
10:   return Boolean(result && (result.cleanup.state === 'failed'
11:     || result.error?.code === 'WORKER_PHASE_UNRESOLVED'
12:     || result.error?.code === 'WORKER_TERMINATION_FAILED'));
13: }
14: function unavailable(response: ServerResponse, code = 'PRISM_WORKER_STOPPING'): void {
15:   response.writeHead(503, { 'content-type': 'application/json', connection: 'close' });
16:   response.end(JSON.stringify({ status: 'not-ready', error: code }));
17: }
18: 
19: export function createManagedWorkerServer(handler: Handler, closeDependencies: () => Promise<void>,
20:   limits = workerIngressLimits()): ManagedWorkerServer {
21:   return new WorkerLifecycle(handler, closeDependencies, limits).server;
22: }
23: 
24: class WorkerLifecycle {
25:   readonly server: ManagedWorkerServer;
26:   private readonly active = new Map<Promise<void>, { controller: AbortController; response: ServerResponse }>();
27:   private stopping = false;
28:   private unsafe = false;
29:   private shutdownWork: Promise<void> | undefined;
30:   private readonly handler: Handler;
31:   private readonly closeDependencies: () => Promise<void>;
32:   private readonly limits: ReturnType<typeof workerIngressLimits>;
33:   constructor(handler: Handler, closeDependencies: () => Promise<void>, limits: ReturnType<typeof workerIngressLimits>) {
34:     if (Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1 || value > 2_147_483_647)) throw new Error('PRISM_WORKER_INGRESS_INVALID');
35:     this.limits = { ...limits };
36:     this.handler = handler;
37:     this.closeDependencies = closeDependencies;
38:     this.server = Object.assign(createServer((request, response) => this.accept(request, response)), {
39:       shutdown: (timeoutMs: number) => this.shutdown(timeoutMs),
40:     });
41:     this.server.maxConnections = limits.maximumConnections;
42:     this.server.requestTimeout = limits.requestTimeoutMs;
43:     this.server.headersTimeout = Math.min(this.server.headersTimeout, limits.requestTimeoutMs);
44:   }
45:   private accept(request: IncomingMessage, response: ServerResponse): void {
46:     if (this.stopping || this.unsafe) { unavailable(response); return; }
47:     const probe = request.method === 'GET' && ['/health', '/bootstrap', '/ready'].includes(request.url ?? '')
48:       && !request.headers['transfer-encoding'] && Number(request.headers['content-length'] ?? 0) === 0;
49:     const capacity = this.limits.maximumActiveRequests + (probe ? this.limits.maximumProbeRequests : 0);
50:     if (this.active.size >= capacity) { unavailable(response, 'PRISM_WORKER_CAPACITY_EXCEEDED'); return; }
51:     const cancellation = new AbortController();
52:     const disconnect = () => { if (!response.writableEnded) cancellation.abort(); };
53:     const interruptBody = () => { if (!request.complete) request.destroy(); };
54:     response.once('close', disconnect);
55:     cancellation.signal.addEventListener('abort', interruptBody, { once: true });
56:     const work = this.handler(request, response, cancellation.signal)
57:       .then(result => { if (unresolved(result)) this.unsafe = true; })
58:       .catch(() => { this.unsafe = true; response.destroy(); })
59:       .finally(() => {
60:         response.removeListener('close', disconnect);
61:         cancellation.signal.removeEventListener('abort', interruptBody);
62:         this.active.delete(work);
63:       });
64:     this.active.set(work, { controller: cancellation, response });
65:   }
66:   private shutdown(timeoutMs: number): Promise<void> {
67:     if (this.shutdownWork) return this.shutdownWork;
68:     if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 2_147_483_647) {
69:       return Promise.reject(new Error('Invalid Prism worker shutdown deadline'));
70:     }
71:     // Admission closes synchronously, including already connected keepalive peers.
72:     this.stopping = true;
73:     const deadline = performance.now() + timeoutMs;
74:     const closed = new Promise<void>((resolve, reject) => this.server.close(error => {
75:       if (error && !("code" in error && error.code === 'ERR_SERVER_NOT_RUNNING')) reject(error); else resolve();
76:     }));
77:     this.server.closeIdleConnections();
78:     for (const { controller, response } of this.active.values()) {
79:       response.shouldKeepAlive = false;
80:       controller.abort(new Error('PRISM_WORKER_SHUTDOWN'));
81:     }
82:     this.shutdownWork = this.drain(closed, deadline);
83:     return this.shutdownWork;
84:   }
85:   private async drain(closed: Promise<void>, deadline: number): Promise<void> {
86:     let timer: NodeJS.Timeout | undefined;
87:     const dependencies = (async () => {
88:       await Promise.all(this.active.keys());
89:       this.server.closeIdleConnections();
90:       await this.closeDependencies();
91:     })();
92:     const work = Promise.all([dependencies, closed]).then(() => {
93:       if (this.unsafe) throw new Error('PRISM_WORKER_SHUTDOWN_UNRESOLVED');
94:     });
95:     try {
96:       await Promise.race([work, new Promise<never>((_, reject) => {
97:         timer = setTimeout(() => reject(new Error('PRISM_WORKER_SHUTDOWN_DEADLINE')), Math.max(1, deadline - performance.now()));
98:       })]);
99:     } catch (error) {
100:       // This is a connection cutoff, never a claim that arbitrary work was reaped.
101:       this.server.closeAllConnections();
102:       throw error;
103:     } finally { if (timer) clearTimeout(timer); }
104:   }
105: }

SOURCE skills/prism/server/worker-operation.ts SHA256 1987bd75921ce43775dc43e0a83e776be7624d6a1dc510ed572fdfce02c57471
1: import type { WorkerAttemptEnvelopeV3, WorkerAttemptLimitsV2 } from '@kubeclaw/pipeline-worker-core-contract';
2: import { observeNativeWorkerResources } from '@kubeclaw/worker-core';
3: import type { WorkerAttemptContext, WorkerAttemptOperation, WorkerAttemptOperationResult } from '@kubeclaw/worker-core';
4: import type { PrismEngine } from '../engine/index.ts';
5: import { executePrismOperation } from '../engine/worker-binding.ts';
6: import type { WorkerArtifactClient } from './worker-artifacts.ts';
7: import { PrismBrowserCloseError } from '../engine/browser-capture.ts';
8: 
9: /** The same Prism lifecycle runs inside the dedicated native host. */
10: export function nativeOperationFor(envelope: WorkerAttemptEnvelopeV3, engine: PrismEngine,
11:   artifacts: WorkerArtifactClient, scope: string): WorkerAttemptOperation<WorkerAttemptEnvelopeV3> {
12:   const operation = new PrismWorkerOperation(envelope, engine, artifacts);
13:   return {
14:     prepare: limits => operation.prepare(limits), execute: context => operation.execute(context),
15:     terminate: () => operation.terminate(),
16:     async measure({ signal }) {
17:       signal.throwIfAborted();
18:       const resources = observeNativeWorkerResources(scope);
19:       return { cpuTimeMs: { status: 'observed', value: Math.ceil(resources.cpuTimeMicroseconds / 1000) },
20:         maximumMemoryBytes: { status: 'observed', value: resources.maximumMemoryBytes },
21:         maximumTasks: { status: 'observed', value: resources.maximumTasks } };
22:     },
23:   };
24: }
25: 
26: export class PrismWorkerOperation implements Omit<WorkerAttemptOperation<WorkerAttemptEnvelopeV3>, 'measure'> {
27:   private prepared = false;
28:   private terminated = false;
29:   private readonly controller = new AbortController();
30:   private execution: Promise<WorkerAttemptOperationResult> | undefined;
31:   private settlement: Promise<{ ok: true } | { ok: false; error: unknown }> | undefined;
32:   private readonly envelope: WorkerAttemptEnvelopeV3;
33:   private readonly engine: PrismEngine;
34:   private readonly artifacts: WorkerArtifactClient;
35:   constructor(envelope: WorkerAttemptEnvelopeV3, engine: PrismEngine, artifacts: WorkerArtifactClient) {
36:     this.envelope = envelope; this.engine = engine; this.artifacts = artifacts;
37:   }
38:   prepare(_limits: WorkerAttemptLimitsV2) {
39:     if (this.prepared || this.terminated) throw new Error('Prism attempt cannot be prepared again');
40:     this.prepared = true;
41:     return undefined;
42:   }
43:   execute(context: Pick<WorkerAttemptContext, 'signal' | 'log'>) {
44:     if (this.execution) throw new Error('Prism attempt execution already started');
45:     const signal = AbortSignal.any([context.signal, this.controller.signal]);
46:     this.execution = this.run({ ...context, signal });
47:     this.settlement = this.execution.then(() => ({ ok: true as const }),
48:       (error: unknown) => ({ ok: false as const, error }));
49:     return this.execution;
50:   }
51:   async terminate() {
52:     this.terminated = true;
53:     this.controller.abort(new Error('Prism attempt terminated'));
54:     // Core bounds this drain and reports unresolved work; do not detach I/O.
55:     const settled = await this.settlement;
56:     if (settled && !settled.ok && settled.error instanceof PrismBrowserCloseError) throw settled.error;
57:   }
58:   private async run(context: Pick<WorkerAttemptContext, 'signal' | 'log'>) {
59:     if (!this.prepared || this.terminated || context.signal.aborted)
60:       throw new Error("Prism attempt cannot start");
61:     if (this.envelope.operation.values.operation === "generate")
62:       throw new Error("Prism generation requires the OpenClaw agent gateway");
63:     context.log(
64:       "system",
65:       `Prism ${String(this.envelope.operation.values.operation)} operation started`,
66:     );
67:     const hydratedInput = await readInput(this.envelope, this.artifacts, context.signal);
68:     const specialistResult = await executePrismOperation(
69:       this.engine,
70:       this.envelope.operation,
71:       this.envelope.executionId,
72:       hydratedInput,
73:       context.signal,
74:     );
75:     if (this.terminated || context.signal.aborted)
76:       throw new Error("Prism attempt was cancelled");
77:     const values={...specialistResult.values};const evidence=[];
78:     if(typeof values.screenshotBase64==="string"){evidence.push(await this.artifacts.upload("render-screenshot","preview","image/png",Buffer.from(values.screenshotBase64,"base64"), context.signal));delete values.screenshotBase64;}
79:     if(typeof values.ariaSnapshot==="string"){evidence.push(await this.artifacts.upload("render-aria","accessibility-tree","text/plain",Buffer.from(values.ariaSnapshot), context.signal));delete values.ariaSnapshot;}
80:     const boundedResult={...specialistResult,values};
81:     return {
82:       summary: "Prism operation completed",
83:       specialistResult:boundedResult,
84:       evidence,
85:       exitCode: 0,
86:       signal: null,
87:     };
88:   }
89: }
90: 
91: async function readInput(envelope: WorkerAttemptEnvelopeV3, artifacts: WorkerArtifactClient,
92:   signal: AbortSignal): Promise<Record<string, unknown>> {
93:   const inputName = String(envelope.operation.values.inputName ?? '');
94:   const declared = envelope.inputs.find((item) => item.name === inputName && item.kind === 'artifact');
95:   if (!declared || declared.kind !== 'artifact' || declared.artifact.mediaType !== 'application/json'
96:     || declared.artifact.type !== 'prism-engine-input') throw new Error('Prism input artifact is missing or invalid');
97:   const bytes = await artifacts.read(declared.artifact, signal);
98:   return JSON.parse(bytes.toString('utf8')) as Record<string, unknown>;
99: }

SOURCE skills/prism/server/worker-service.ts SHA256 90174f5edf19c85ef1642da95a51aac46854f9a1ce7172d876045a5bac1595e4
1: import { type IncomingMessage, type ServerResponse } from "node:http";
2: import {
3:   validateWorkerResourceContractV3,
4:   type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3,
5: } from "@kubeclaw/pipeline-worker-core-contract";
6: import { type WorkerNonceDatabase, WorkerDependencyUnavailable } from "./worker-readiness.ts";
7: import { createManagedWorkerServer } from "./worker-lifecycle.ts";
8: import { authorizeProxiedSpiffePeer, NativeWorkerAttemptBusy } from "@kubeclaw/worker-core";
9: import { workerIngressLimits } from './worker-config.ts';
10: 
11: export type WorkerAuthentication =
12:   | { mode: "hmac"; secret: string; database: WorkerNonceDatabase }
13:   | { mode: "spiffe"; trustedControlSpiffeId: string };
14: 
15: export interface NativePrismWorkerExecution {
16:   ready(): boolean;
17:   execute(envelope: WorkerAttemptEnvelopeV3, signal: AbortSignal): Promise<WorkerAttemptResultV3>;
18: }
19: 
20: export function createWorkerServer(auth: WorkerAuthentication, execution: NativePrismWorkerExecution, limits = workerIngressLimits()) {
21:   return createManagedWorkerServer(
22:     (request, response, signal) => handleWorkerRequest(auth, request, response, signal, { maximumInputBytes: limits.maximumInputBytes, native: execution }),
23:     () => auth.mode === 'hmac' ? auth.database.close() : Promise.resolve(),
24:     limits,
25:   );
26: }
27: 
28: async function handleWorkerRequest(auth: WorkerAuthentication,
29:   request: IncomingMessage, response: ServerResponse, signal: AbortSignal,
30:   { maximumInputBytes, native }: { maximumInputBytes: number; native: NativePrismWorkerExecution }): Promise<WorkerAttemptResultV3 | void> {
31:   if (serveLocalHealth(request, response, native)) return;
32:   if (request.url === '/ready') return serveReadiness(auth, response, signal, native);
33:   if (request.url !== "/v1/attempts" || request.method !== "POST") {
34:     response.writeHead(404);
35:     return void response.end();
36:   }
37:   try {
38:     if (
39:       !(request.headers["content-type"] ?? "")
40:         .toString()
41:         .toLowerCase()
42:         .startsWith("application/json")
43:     ) {
44:       response.writeHead(415);
45:       return void response.end();
46:     }
47:     const chunks: Buffer[] = [];
48:     let size = 0;
49:     for await (const chunk of request) {
50:       size += chunk.length;
51:       if (size > maximumInputBytes)
52:         throw new Error("Prism attempt request is too large");
53:       chunks.push(chunk);
54:     }
55:     const raw = Buffer.concat(chunks);
56:     if (auth.mode === "spiffe") authorizeProxiedSpiffePeer(request.headers, request.socket.remoteAddress, new Set([auth.trustedControlSpiffeId]));
57:     else await auth.database.authenticate(auth.secret, raw, request.headers, signal);
58:     const result = await dispatchAttempt(JSON.parse(raw.toString('utf8')), signal, native);
59:     response.writeHead(200, { "content-type": "application/json" });
60:     response.end(JSON.stringify(result));
61:     return result;
62:   } catch (error) {
63:     response.writeHead(error instanceof WorkerDependencyUnavailable || error instanceof NativeWorkerAttemptBusy ? 503 : 422, { "content-type": "application/json" });
64:     response.end(
65:       JSON.stringify({
66:         error: error instanceof Error ? error.message : "failed",
67:       }),
68:     );
69:   }
70: }
71: 
72: async function serveReadiness(auth: WorkerAuthentication, response: ServerResponse, signal: AbortSignal,
73:   native: NativePrismWorkerExecution): Promise<void> {
74:   if (!native.ready()) {
75:     response.writeHead(503, { 'content-type': 'application/json' });
76:     response.end('{"status":"not-ready","error":"PRISM_NATIVE_RECONCILIATION_REQUIRED"}');
77:     return;
78:   }
79:   try {
80:     if (auth.mode === 'hmac') await auth.database.check(signal);
81:     response.writeHead(200, { 'content-type': 'application/json' });
82:     response.end('{"status":"ready"}');
83:   } catch {
84:     response.writeHead(503, { 'content-type': 'application/json' });
85:     response.end('{"status":"not-ready","error":"PRISM_NONCE_DATABASE_UNAVAILABLE"}');
86:   }
87: }
88: 
89: async function dispatchAttempt(input: unknown, signal: AbortSignal, native: NativePrismWorkerExecution): Promise<WorkerAttemptResultV3> {
90:   validateWorkerResourceContractV3('workerAttemptEnvelope', input);
91:   if (!native.ready()) throw new Error('PRISM_NATIVE_RECONCILIATION_REQUIRED');
92:   return native.execute(input as WorkerAttemptEnvelopeV3, signal);
93: }
94: 
95: function serveLocalHealth(request: IncomingMessage, response: ServerResponse, native: NativePrismWorkerExecution): boolean {
96:   if (request.url === "/health" || request.url === "/bootstrap") {
97:     if (request.url === '/bootstrap' && !native.ready()) {
98:       response.writeHead(503, { 'content-type': 'application/json' });
99:       response.end('{"status":"not-ready","error":"PRISM_NATIVE_RECONCILIATION_REQUIRED"}');
100:       return true;
101:     }
102:     response.writeHead(200, { "content-type": "application/json" });
103:     response.end(JSON.stringify({ status: request.url === "/health" ? "alive" : "initialized" }));
104:     return true;
105:   }
106:   return false;
107: }

SOURCE skills/prism/server/worker.ts SHA256 cfecfaa12715e48f923af86b69a6a7582024246d4df619be90e9270d95d96d5d
1: import { FileWorkerOwnershipStore, NativeWorkerOwnership, requireNativeWorkerSupervisorAuthority, requireNativeWorkerLauncher } from '@kubeclaw/worker-core';
2: import { fileURLToPath } from 'node:url';
3: import path from 'node:path';
4: import { nativePrismSupervisorConfig } from '../config/native-worker.ts';
5: import { nativePrismExecution } from './native-worker-execution.ts';
6: import { createWorkerServer } from './worker-service.ts';
7: import type { ManagedWorkerServer } from './worker-lifecycle.ts';
8: import { WorkerNonceDatabase } from './worker-readiness.ts';
9: import { loadWorkerConfig } from './worker-config.ts';
10: 
11: /** Native-only startup: durable ownership and journal recovery precede HTTP admission. */
12: export async function runNativePrismWorker(): Promise<void> {
13:   const config = loadWorkerConfig();
14:   const native = nativePrismSupervisorConfig(config);
15:   requireNativeWorkerSupervisorAuthority();
16:   requireNativeWorkerLauncher(native.launcher);
17:   const store = new FileWorkerOwnershipStore(native.ownershipRoot, {
18:     maximumRecords: native.maximumRecords, maximumBytes: native.maximumBytes,
19:   });
20:   await NativeWorkerOwnership.supervise({ ...native, store }, async owner => {
21:     const execution = await nativePrismExecution(owner, native, config);
22:     const authentication = config.spiffeEnabled
23:       ? { mode: 'spiffe' as const, trustedControlSpiffeId: config.trustedControlSpiffeId }
24:       : { mode: 'hmac' as const, secret: config.workerSecret, database: new WorkerNonceDatabase(config.databaseUrl) };
25:     const server = createWorkerServer(authentication, execution, config.ingress);
26:     await serve(server, owner, config);
27:   });
28: }
29: 
30: async function serve(server: ManagedWorkerServer, owner: NativeWorkerOwnership, config: ReturnType<typeof loadWorkerConfig>): Promise<void> {
31:   let stop: () => void = () => {};
32:   try {
33:     await new Promise<void>((resolve, reject) => {
34:       let stopping = false;
35:       stop = () => {
36:         if (stopping) return;
37:         stopping = true;
38:         owner.fenceAdmission();
39:         void server.shutdown(config.shutdownTimeoutMs).then(resolve, reject);
40:       };
41:       process.once('SIGTERM', stop); process.once('SIGINT', stop);
42:       server.once('error', reject);
43:       server.listen(config.port, '0.0.0.0');
44:     });
45:   } finally {
46:     owner.fenceAdmission();
47:     process.removeListener('SIGTERM', stop); process.removeListener('SIGINT', stop);
48:     await server.shutdown(config.shutdownTimeoutMs);
49:   }
50: }
51: 
52: if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
53:   runNativePrismWorker().then(() => {
54:     process.stderr.write('{"event":"prism_native_worker_shutdown","state":"ownership_reconciled"}\n');
55:   }, (error: unknown) => {
56:     process.stderr.write(`${JSON.stringify({ event: 'prism_native_worker_failure',
57:       code: error instanceof Error ? error.message : 'PRISM_NATIVE_UNKNOWN_FAILURE' })}\n`);
58:     process.exitCode = 1;
59:   });
60: }

