16: export function assertCleanupDisposition(value: unknown): asserts value is TestProviderCleanupDisposition {
17:   if (value !== 'incomplete' && value !== 'completed-fixture') throw new Error('TEST_PROVIDER_CLEANUP_DISPOSITION_INVALID');
18: }
