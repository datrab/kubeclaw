1: import fs from 'node:fs';
2: import Ajv2020 from 'ajv/dist/2020.js';
3: import addFormats from 'ajv-formats';
4: import { canonicalJson } from './digest.ts';
5: import { workerCoreRelationErrors,PipelineWorkerCoreContractError } from './validation.ts';
6: import type { ContractValidationResult } from './types.ts';
7: import type {WorkerAttemptEnvelopeV2,WorkerAttemptResultV2,WorkerResourceAccounting,WorkerResourceMetric} from './resource-types-v2.ts';
8: 
9: export const workerResourceMetrics:readonly WorkerResourceMetric[]=['cpuTimeMs','maximumMemoryBytes','maximumProcesses'];
10: type Definition='workerProfile'|'workerAttemptEnvelope'|'workerAttemptResult';
11: type Validator=((value:unknown)=>boolean)&{errors?:unknown};
12: const Constructor=Ajv2020 as unknown as new(options:object)=>{addSchema(schema:unknown):void;compile(schema:unknown):Validator};
13: const ajv=new Constructor({strict:true,allErrors:true});
14: (addFormats as unknown as (value:unknown)=>void)(ajv);
15: const schema=JSON.parse(fs.readFileSync(new URL('../schemas/pipeline-worker-core.v2.schema.json',import.meta.url),'utf8')) as {$id:string};
16: ajv.addSchema(schema);
17: const validators=new Map<Definition,Validator>();
18: 
19: /** Numeric receipt values and their scoped observations must be identical, never invented zeros. */
20: function accountingErrors(result:WorkerAttemptResultV2):string[]{
21:  const errors:string[]=[];const accounting=result.resourceAccounting;
22:  for(const metric of workerResourceMetrics){
23:   const observed=accounting.observations[metric];const capability=accounting.capabilities[metric];const budget=accounting.budgets[metric];
24:   if(observed.status==='observed'){
25:    if(capability.measurement==='unavailable')errors.push(`${metric}: unavailable capability cannot claim observation`);
26:    if(result.resources[metric]!==observed.value)errors.push(`${metric}: numeric receipt does not match observation`);
27:   }else if(result.resources[metric]!==undefined)errors.push(`${metric}: unavailable observation cannot claim numeric resource use`);
28:   if(result.state==='completed' && budget.state==='requested' && (observed.status!=='observed' || capability.measurement==='unavailable' || observed.value>budget.limit))errors.push(`${metric}: requested resource budget was not satisfied`);
29:  }
30:  return errors;
31: }
32: 
33: export function checkWorkerResourceContractV2(definition:Definition,value:unknown):ContractValidationResult {
34:  let validate=validators.get(definition);if(!validate){validate=ajv.compile({$ref:`${schema.$id}#/$defs/${definition}`});validators.set(definition,validate);}
35:  if(!validate(value))return {ok:false,errors:[JSON.stringify(validate.errors)]};
36:  const errors=workerCoreRelationErrors(definition,value);
37:  if(definition==='workerAttemptResult')errors.push(...accountingErrors(value as WorkerAttemptResultV2));
38:  return {ok:errors.length===0,errors};
39: }
40: export function validateWorkerResourceContractV2(definition:Definition,value:unknown):void {
41:  const checked=checkWorkerResourceContractV2(definition,value);
42:  if(!checked.ok)throw new PipelineWorkerCoreContractError(`${definition}.v2`,checked.errors);
43: }
44: 
45: function resultLimitErrors(envelope:WorkerAttemptEnvelopeV2,result:WorkerAttemptResultV2):string[]{
46:  const errors:string[]=[];
47:  if(result.evidence.length>envelope.limits.evidenceFiles)errors.push('evidence file limit exceeded');
48:  if(new Set(result.evidence.map(item=>item.evidenceId)).size!==result.evidence.length)errors.push('duplicate evidence identity');
49:  const evidenceBytes=result.evidence.reduce((sum,item)=>sum+item.artifact.sizeBytes,0);
50:  if(evidenceBytes>envelope.limits.evidenceBytes || evidenceBytes!==result.resources.evidenceBytes)errors.push('evidence bytes do not match accepted limits and receipt');
51:  if(result.resources.logBytes>envelope.limits.logBytes || result.resources.resultBytes>envelope.limits.resultBytes)errors.push('log/result bytes exceed accepted limits');
52:  if(result.specialistResult!==null){
53:   const actualResultBytes=Buffer.byteLength(JSON.stringify(result.specialistResult),'utf8');
54:   if(actualResultBytes!==result.resources.resultBytes || actualResultBytes>envelope.limits.resultBytes)errors.push('actual specialist result bytes do not match accepted limit and receipt');
55:  }
56:  if(result.state==='completed' && (Date.parse(result.startedAt)<Date.parse(envelope.claim.claimedAt) || Date.parse(result.completedAt)>=Date.parse(envelope.claim.expiresAt)))errors.push('completed result falls outside accepted claim window');
57:  return errors;
58: }
59: 
60: /** Consumers opting in to V2 must bind resource policy as well as ordinary attempt/claim identity. */
61: export function checkWorkerResourceResultBinding(envelope:WorkerAttemptEnvelopeV2,result:WorkerAttemptResultV2):ContractValidationResult {
62:  const errors=[...checkWorkerResourceContractV2('workerAttemptEnvelope',envelope).errors,...checkWorkerResourceContractV2('workerAttemptResult',result).errors];
63:  if(errors.length)return {ok:false,errors};
64:  errors.push(...resultLimitErrors(envelope,result));
65:  const pairs=[['protocolVersion',envelope.protocolVersion,result.protocolVersion],['attemptId',envelope.attemptId,result.attemptId],['claimId',envelope.claim.claimId,result.claimId],['claimGeneration',envelope.claim.generation,result.claimGeneration],['workerId',envelope.claim.workerId,result.workerId],['profileDigest',envelope.profile.profileDigest,result.profileDigest],['attemptSpecDigest',envelope.attemptSpecDigest,result.attemptSpecDigest]];
66:  for(const [field,expected,actual] of pairs)if(expected!==actual)errors.push(`${field}: does not match accepted attempt`);
67:  if(canonicalJson(envelope.resourceBudgets)!==canonicalJson(result.resourceAccounting.budgets))errors.push('resource budgets do not match accepted attempt');
68:  if(canonicalJson(envelope.profile.resourceCapabilities)!==canonicalJson(result.resourceAccounting.capabilities))errors.push('resource capabilities do not match accepted profile');
69:  return {ok:errors.length===0,errors};
70: }
71: 
72: export function initialWorkerResourceAccounting(envelope:WorkerAttemptEnvelopeV2):WorkerResourceAccounting {
73:  return {schemaVersion:'worker-resource-accounting.v1',capabilities:structuredClone(envelope.profile.resourceCapabilities),budgets:structuredClone(envelope.resourceBudgets),observations:{
74:   cpuTimeMs:{status:'unavailable',reason:'Operation has not supplied child resource observations'},
75:   maximumMemoryBytes:{status:'unavailable',reason:'Operation has not supplied child resource observations'},
76:   maximumProcesses:{status:'unavailable',reason:'Operation has not supplied child resource observations'},
77:  }};
78: }

SOURCE contracts/pipeline-worker-core/v1/src/resource-validation-v3.ts SHA256 00332a01a4674616f0859a83d704771b497d0c0d4220629a35b9a7414f924784
1: import fs from 'node:fs';
2: import Ajv2020 from 'ajv/dist/2020.js';
3: import addFormats from 'ajv-formats';
4: import { canonicalJson } from './digest.ts';
5: import { workerCoreRelationErrors, PipelineWorkerCoreContractError } from './validation.ts';
6: import type { ContractValidationResult } from './types.ts';
7: import type { WorkerAttemptEnvelopeV3, WorkerAttemptResultV3, WorkerNativeResourceAccounting, WorkerNativeResourceMetric } from './resource-types-v3.ts';
8: 
9: export const workerNativeResourceMetrics: readonly WorkerNativeResourceMetric[] = ['cpuTimeMs', 'maximumMemoryBytes', 'maximumTasks'];
10: type Definition = 'workerProfile' | 'workerAttemptEnvelope' | 'workerAttemptResult';
11: type Validator = ((value: unknown) => boolean) & { errors?: unknown };
12: const Constructor = Ajv2020 as unknown as new(options: object) => { addSchema(schema: unknown): void; compile(schema: unknown): Validator };
13: const ajv = new Constructor({ strict: true, allErrors: true });
14: (addFormats as unknown as (value: unknown) => void)(ajv);
15: const schema = JSON.parse(fs.readFileSync(new URL('../schemas/pipeline-worker-core.v3.schema.json', import.meta.url), 'utf8')) as { $id: string };
16: ajv.addSchema(schema);
17: const validators = new Map<Definition, Validator>();
18: 
19: function accountingErrors(result: WorkerAttemptResultV3): string[] {
20:   const errors: string[] = [];
21:   for (const metric of workerNativeResourceMetrics) {
22:     const observation = result.resourceAccounting.observations[metric];
23:     const budget = result.resourceAccounting.budgets[metric];
24:     if (observation.status === 'observed') {
25:       if (!Number.isSafeInteger(observation.value) || result.resources[metric] !== observation.value) errors.push(`${metric}: invalid or inconsistent observation`);
26:     } else if (result.resources[metric] !== undefined) errors.push(`${metric}: unavailable observation cannot claim numeric use`);
27:     if (result.state === 'completed' && budget.state === 'requested'
28:       && (observation.status !== 'observed' || observation.value > budget.limit)) errors.push(`${metric}: requested budget was not satisfied`);
29:   }
30:   return errors;
31: }
32: 
33: export function checkWorkerResourceContractV3(definition: Definition, value: unknown): ContractValidationResult {
34:   let validate = validators.get(definition);
35:   if (!validate) { validate = ajv.compile({ $ref: `${schema.$id}#/$defs/${definition}` }); validators.set(definition, validate); }
36:   if (!validate(value)) return { ok: false, errors: [JSON.stringify(validate.errors)] };
37:   const errors = workerCoreRelationErrors(definition, value);
38:   if (definition === 'workerAttemptResult') errors.push(...accountingErrors(value as WorkerAttemptResultV3));
39:   if (definition === 'workerAttemptEnvelope') {
40:     const envelope = value as WorkerAttemptEnvelopeV3;
41:     for (const metric of workerNativeResourceMetrics) {
42:       const budget = envelope.resourceBudgets[metric];
43:       if (budget.state === 'requested' && !Number.isSafeInteger(budget.limit)) errors.push(`${metric}: unsafe budget integer`);
44:     }
45:   }
46:   return { ok: errors.length === 0, errors };
47: }
48: 
49: export function validateWorkerResourceContractV3(definition: Definition, value: unknown): void {
50:   const checked = checkWorkerResourceContractV3(definition, value);
51:   if (!checked.ok) throw new PipelineWorkerCoreContractError(`${definition}.v3`, checked.errors);
52: }
53: 
54: export function initialWorkerNativeResourceAccounting(envelope: WorkerAttemptEnvelopeV3): WorkerNativeResourceAccounting {
55:   const unavailable = { status: 'unavailable' as const, reason: 'Native attempt has not supplied final kernel observations' };
56:   return { schemaVersion: 'worker-resource-accounting.v2', capabilities: structuredClone(envelope.profile.resourceCapabilities),
57:     budgets: structuredClone(envelope.resourceBudgets), observations: {
58:       cpuTimeMs: { ...unavailable }, maximumMemoryBytes: { ...unavailable }, maximumTasks: { ...unavailable },
59:     } };
60: }
61: 
62: export function checkWorkerNativeResultBinding(envelope: WorkerAttemptEnvelopeV3, result: WorkerAttemptResultV3): ContractValidationResult {
63:   const errors = [...checkWorkerResourceContractV3('workerAttemptEnvelope', envelope).errors,
64:     ...checkWorkerResourceContractV3('workerAttemptResult', result).errors];
65:   if (errors.length) return { ok: false, errors };
66:   const expected = [envelope.protocolVersion, envelope.attemptId, envelope.claim.claimId, envelope.claim.generation,
67:     envelope.claim.workerId, envelope.profile.profileDigest, envelope.attemptSpecDigest];
68:   const actual = [result.protocolVersion, result.attemptId, result.claimId, result.claimGeneration,
69:     result.workerId, result.profileDigest, result.attemptSpecDigest];
70:   if (canonicalJson(expected) !== canonicalJson(actual)) errors.push('native result identity does not match accepted attempt');
71:   if (canonicalJson(envelope.resourceBudgets) !== canonicalJson(result.resourceAccounting.budgets)
72:     || canonicalJson(envelope.profile.resourceCapabilities) !== canonicalJson(result.resourceAccounting.capabilities)) errors.push('native result policy does not match accepted attempt');
73:   errors.push(...resultLimits(envelope, result));
74:   return { ok: errors.length === 0, errors };
75: }
76: 
77: function resultLimits(envelope: WorkerAttemptEnvelopeV3, result: WorkerAttemptResultV3): string[] {
78:   const errors: string[] = [];
79:   const evidenceBytes = result.evidence.reduce((sum, item) => sum + item.artifact.sizeBytes, 0);
80:   if (result.evidence.length > envelope.limits.evidenceFiles || new Set(result.evidence.map(item => item.evidenceId)).size !== result.evidence.length
81:     || evidenceBytes !== result.resources.evidenceBytes || evidenceBytes > envelope.limits.evidenceBytes) errors.push('native result evidence exceeds or differs from accepted limits');
82:   if (result.resources.logBytes > envelope.limits.logBytes || result.resources.resultBytes > envelope.limits.resultBytes) errors.push('native result output exceeds accepted limits');
83:   if (result.specialistResult !== null && Buffer.byteLength(JSON.stringify(result.specialistResult)) !== result.resources.resultBytes) errors.push('native specialist result byte count mismatch');
84:   if (result.state === 'completed' && (Date.parse(result.startedAt) < Date.parse(envelope.claim.claimedAt)
85:     || Date.parse(result.completedAt) >= Date.parse(envelope.claim.expiresAt))) errors.push('native result outside accepted claim window');
86:   return errors;
87: }

SOURCE contracts/pipeline-worker-core/v1/src/trust.ts SHA256 c650fdbe7f43b422f36d050df291d2a00fdd4bc694a1dae5d6236b4814743cd5
1: import crypto from 'node:crypto';
2: import { canonicalJson } from './digest.ts';
3: import type { WorkerTrustEnvelopeV1 } from './types.ts';
4: 
5: export type UnsignedWorkerTrustEnvelopeV1 = Omit<WorkerTrustEnvelopeV1, 'algorithm' | 'signature'>;
6: 
7: function signingMessage(value: UnsignedWorkerTrustEnvelopeV1 | WorkerTrustEnvelopeV1): Buffer {
8:   const { algorithm: _algorithm, signature: _signature, ...unsigned } = value as WorkerTrustEnvelopeV1;
9:   return Buffer.from(`kubeclaw-worker-trust-v1\0${canonicalJson(unsigned)}`, 'utf8');
10: }
11: 
12: export function signWorkerTrustEnvelope(
13:   value: UnsignedWorkerTrustEnvelopeV1,
14:   privateKey: crypto.KeyLike,
15: ): WorkerTrustEnvelopeV1 {
16:   const key = privateKey instanceof crypto.KeyObject ? privateKey : crypto.createPrivateKey(privateKey);
17:   if (key.asymmetricKeyType !== 'ed25519') throw new Error('WORKER_TRUST_PRIVATE_KEY_INVALID');
18:   return Object.freeze({
19:     ...value,
20:     algorithm: 'ed25519',
21:     signature: crypto.sign(null, signingMessage(value), key).toString('base64'),
22:   });
23: }
24: 
25: export function verifyWorkerTrustEnvelope(
26:   value: WorkerTrustEnvelopeV1,
27:   publicKey: crypto.KeyLike,
28:   expected: Readonly<{ issuer: string; audience: string; purpose: string }>,
29:   now = Date.now(),
30: ): boolean {
31:   const issuedAt = Date.parse(value.issuedAt);
32:   const expiresAt = Date.parse(value.expiresAt);
33:   if (value.schemaVersion !== 'worker-trust-envelope.v1' || value.algorithm !== 'ed25519'
34:     || value.issuer !== expected.issuer || value.audience !== expected.audience
35:     || value.purpose !== expected.purpose || !Number.isFinite(issuedAt) || !Number.isFinite(expiresAt)
36:     || expiresAt <= issuedAt || issuedAt > now || expiresAt <= now) return false;
37:   try {
38:     const key = publicKey instanceof crypto.KeyObject ? publicKey : crypto.createPublicKey(publicKey);
39:     return key.asymmetricKeyType === 'ed25519'
40:       && crypto.verify(null, signingMessage(value), key, Buffer.from(value.signature, 'base64'));
41:   } catch {
42:     return false;
43:   }
44: }

