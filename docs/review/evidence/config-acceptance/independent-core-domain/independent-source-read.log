46: function object(value: unknown, label: string): JsonObject {
47:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error(`TAILSCALE_EXPOSURE_REQUEST_INVALID:${label}`);
48:   return value as JsonObject;
49: }
50: function text(value: unknown, label: string, maximum = 1024): string {
51:   if (typeof value !== 'string' || value.length < 1 || value.length > maximum || value.includes('\0')) {
52:     throw new Error(`TAILSCALE_EXPOSURE_REQUEST_INVALID:${label}`);
53:   }
54:   return value;
55: }
56: function integer(value: unknown, label: string, minimum: number, maximum: number): number {
57:   if (!Number.isSafeInteger(value) || Number(value) < minimum || Number(value) > maximum) {
58:     throw new Error(`TAILSCALE_EXPOSURE_REQUEST_INVALID:${label}`);
59:   }
60:   return Number(value);
61: }
62: function suffix(value: string): string {
63:   const normalized = value.toLowerCase();
64:   if (!/^\.[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/u.test(normalized) || normalized.includes('..')) {
65:     throw new Error('TAILSCALE_EXPOSURE_HOST_SUFFIX_INVALID');
66:   }
67:   return normalized;
68: }
