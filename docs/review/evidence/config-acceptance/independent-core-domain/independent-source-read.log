1: import {
2:   canonicalJson, checkWorkerNativeResultBinding, sha256Digest,
3:   validateWorkerResourceContractV3, type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3,
4: } from '@kubeclaw/pipeline-worker-core-contract';
5: import type { NativeAttemptJournal } from './native-attempt-journal.ts';
6: import type { NativeWorkerOwnership } from './native-worker-ownership.ts';
7: import type { WorkerOwnershipRecord } from './ownership-store.ts';
8: import { journalIdentity } from './native-journal-state.ts';
9: import { finalizeNativeWorkerResult } from './native-result.ts';
10: 
11: const contractId = 'kubeclaw.native-source-cleanup@1';
12: const inputSchemaId = 'native-source-cleanup-input.v1';
13: const inputSchemaDigest = sha256Digest({ schemaVersion: inputSchemaId,
14:   fields: ['reconciles', 'effectsDigest'], referenceFields: [
15:     'envelopeDigest', 'attemptId', 'attemptSpecDigest', 'profileDigest', 'claimId',
16:     'claimGeneration', 'workerId', 'resultDigest', 'receipt',
17:   ] });
18: export const nativeSourceCleanupResultSchema = Object.freeze({
19:   schemaId: 'native-source-cleanup-result.v1',
20:   schemaDigest: sha256Digest({ schemaVersion: 'native-source-cleanup-result.v1', fields: ['reconciliationDigest'] }),
21: });
22: 
23: export interface NativeCleanupReconciliation {
24:   readonly journal: NativeAttemptJournal;
25:   readonly cleanupProfileDigest: string;
26:   /** The role must durably bind this cleanup before launch under its publication fence. */
27:   reconcile(input: Readonly<{
28:     envelope: WorkerAttemptEnvelopeV3;
29:     result: WorkerAttemptResultV3;
30:     ownership: WorkerOwnershipRecord;
31:   }>): Promise<WorkerAttemptEnvelopeV3 | null>;
32:   /** Lookup only, after ordinary recovery; must not launch cleanup of a cleanup. */
33:   resolveFailedCleanup?(input: Readonly<{
34:     envelope: WorkerAttemptEnvelopeV3;
35:     result: WorkerAttemptResultV3;
36:   }>): Promise<Readonly<{
37:     original: WorkerAttemptEnvelopeV3;
38:     successfulCleanup: WorkerAttemptEnvelopeV3;
39:   }> | null>;
40: }
41: 
42: /** Fixed source-only proof identity; this never changes the original failed receipt. */
43: export function nativeSourceCleanupOperation(envelope: WorkerAttemptEnvelopeV3,
44:   result: WorkerAttemptResultV3, effectsDigest: string): WorkerAttemptEnvelopeV3['operation'] {
45:   if (!/^sha256:[a-f0-9]{64}$/u.test(effectsDigest)) throw new Error('WORKER_NATIVE_RECONCILIATION_EFFECTS_INVALID');
46:   return { contractId, inputSchemaId, inputSchemaDigest, values: {
47:     reconciles: { envelopeDigest: sha256Digest(envelope), attemptId: envelope.attemptId,
48:       attemptSpecDigest: envelope.attemptSpecDigest, profileDigest: envelope.profile.profileDigest,
49:       claimId: envelope.claim.claimId, claimGeneration: envelope.claim.generation,
50:       workerId: envelope.claim.workerId, resultDigest: result.resultDigest,
51:       receipt: { receiptId: result.receipt.receiptId, receiptDigest: result.receipt.receiptDigest } },
52:     effectsDigest,
53:   } };
54: }
55: 
56: async function quiescentOwner(owner: NativeWorkerOwnership, envelope: WorkerAttemptEnvelopeV3): Promise<WorkerOwnershipRecord> {
57:   const identity = journalIdentity(envelope);
58:   const record = await owner.record(identity);
59:   if (!record || canonicalJson(record.identity) !== canonicalJson(identity) || record.phase !== 'disposed'
60:     || record.binding === null || record.finalObservation === null || record.finalObservation.populated) {
61:     throw new Error('WORKER_NATIVE_RECONCILIATION_OWNERSHIP_UNPROVEN');
62:   }
63:   return record;
64: }
65: 
66: function validateCleanupEnvelope(cleanup: WorkerAttemptEnvelopeV3, envelope: WorkerAttemptEnvelopeV3,
67:   result: WorkerAttemptResultV3, profileDigest: string): void {
68:   validateWorkerResourceContractV3('workerAttemptEnvelope', cleanup);
69:   const effectsDigest = cleanup.operation.values.effectsDigest;
70:   if (typeof effectsDigest !== 'string' || cleanup.profile.profileDigest !== profileDigest
71:     || cleanup.attemptId === envelope.attemptId || cleanup.claim.claimId === envelope.claim.claimId
72:     || cleanup.attemptSpecDigest === envelope.attemptSpecDigest
73:     || canonicalJson(cleanup.operation) !== canonicalJson(nativeSourceCleanupOperation(envelope, result, effectsDigest))) {
74:     throw new Error('WORKER_NATIVE_RECONCILIATION_BINDING_INVALID');
75:   }
76: }
77: 
78: /** Role-side durable release must follow these same archived-result and ownership checks. */
79: export async function verifyNativeSourceCleanupResult(journal: NativeAttemptJournal, owner: NativeWorkerOwnership,
80:   cleanup: WorkerAttemptEnvelopeV3): Promise<void> {
81:   const result = await journal.readResult(cleanup);
82:   const archived = await journal.readProcess(cleanup);
83:   const ownership = await quiescentOwner(owner, cleanup);
84:   if (!result || !archived || archived.process.fault !== null || archived.process.exitCode !== 0
85:     || archived.process.signal !== null || result.state !== 'completed' || result.cleanup.state !== 'completed'
86:     || !checkWorkerNativeResultBinding(cleanup, result).ok
87:     || canonicalJson(ownership.finalObservation) !== canonicalJson(archived.process.resources)) {
88:     throw new Error('WORKER_NATIVE_RECONCILIATION_RESULT_UNPROVEN');
89:   }
90:   const expected = { ...nativeSourceCleanupResultSchema,
91:     values: { reconciliationDigest: sha256Digest(cleanup.operation.values) } };
92:   if (canonicalJson(result.specialistResult) !== canonicalJson(expected)) {
93:     throw new Error('WORKER_NATIVE_RECONCILIATION_RESULT_BINDING_INVALID');
94:   }
95:   // A separately sealed success cannot replace an invalid or different process
96:   // output. Reuse the actual executor finalizer, including measured accounting.
97:   await journal.withAttempt(cleanup, async context => {
98:     const recovered = finalizeNativeWorkerResult(cleanup, archived.process,
99:       new Date(context.acceptedAt), new Date(archived.completedAt));
100:     if (recovered.resultDigest !== result.resultDigest) {
101:       throw new Error('WORKER_NATIVE_RECONCILIATION_ARCHIVE_MISMATCH');
102:     }
103:   });
104: }
105: 
106: /** Called outside the original journal stripe. A failure leaves admission fenced. */
107: export async function reconcileNativeCleanup(owner: NativeWorkerOwnership, envelope: WorkerAttemptEnvelopeV3,
108:   result: WorkerAttemptResultV3, capability: NativeCleanupReconciliation): Promise<boolean> {
109:   if (envelope.operation.contractId === contractId || result.cleanup.state !== 'failed'
110:     || !checkWorkerNativeResultBinding(envelope, result).ok) {
111:     throw new Error('WORKER_NATIVE_RECONCILIATION_ORIGINAL_INVALID');
112:   }
113:   const journal = capability.journal;
114:   const profileDigest = capability.cleanupProfileDigest;
115:   const ownership = await quiescentOwner(owner, envelope);
116:   const candidate = await capability.reconcile(structuredClone({ envelope, result, ownership }));
117:   if (candidate === null) return false;
118:   const cleanup = structuredClone(candidate);
119:   validateCleanupEnvelope(cleanup, envelope, result, profileDigest);
120:   await verifyNativeSourceCleanupResult(journal, owner, cleanup);
121:   return true;
122: }
123: 
124: 
125: /** A failed cleanup receipt remains failed; a separate exact proof resolves its source effect. */
126: export async function resolveFailedNativeCleanup(originalJournal: NativeAttemptJournal,
127:   owner: NativeWorkerOwnership, failed: WorkerAttemptEnvelopeV3,
128:   failedResult: WorkerAttemptResultV3, capability: NativeCleanupReconciliation): Promise<boolean> {
129:   if (failed.operation.contractId !== contractId || failedResult.cleanup.state !== 'failed'
130:     || !checkWorkerNativeResultBinding(failed, failedResult).ok) {
131:     throw new Error('WORKER_NATIVE_RECONCILIATION_PREDECESSOR_INVALID');
132:   }
133:   const { resolveFailedCleanup, journal, cleanupProfileDigest } = capability;
134:   if (!resolveFailedCleanup) return false;
135:   const candidate = await resolveFailedCleanup(structuredClone({ envelope: failed, result: failedResult }));
136:   if (candidate === null) return false;
137:   const { original, successfulCleanup } = structuredClone(candidate);
138:   validateWorkerResourceContractV3('workerAttemptEnvelope', original);
139:   const originalResult = await originalJournal.readResult(original);
140:   if (original.operation.contractId === contractId || !originalResult || originalResult.cleanup.state !== 'failed') {
141:     throw new Error('WORKER_NATIVE_RECONCILIATION_ORIGINAL_INVALID');
142:   }
143:   validateCleanupEnvelope(failed, original, originalResult, cleanupProfileDigest);
144:   validateCleanupEnvelope(successfulCleanup, original, originalResult, cleanupProfileDigest);
145:   if (failed.operation.values.effectsDigest !== successfulCleanup.operation.values.effectsDigest
146:     || failed.attemptId === successfulCleanup.attemptId
147:     || failed.claim.claimId === successfulCleanup.claim.claimId) {
148:     throw new Error('WORKER_NATIVE_RECONCILIATION_PREDECESSOR_INVALID');
149:   }
150:   await quiescentOwner(owner, original);
151:   await quiescentOwner(owner, failed);
152:   await verifyNativeSourceCleanupResult(journal, owner, successfulCleanup);
153:   return true;
154: }

SOURCE skills/worker/core/worker/native-control-channel.ts SHA256 253ecc17f153e13e6e00aad3f842565ad17a01e85cac15db910d9b4b2ea9edc8
1: import { Duplex } from 'node:stream';
2: 
3: export interface NativeWorkerControlLimits {
4:   readonly maximumMessageBytes: number;
5:   readonly maximumSessionBytes: number;
6: }
7: 
8: export function validateNativeWorkerControlLimits(limits: NativeWorkerControlLimits): void {
9:   if ([limits.maximumMessageBytes, limits.maximumSessionBytes].some(value => !Number.isSafeInteger(value) || value < 1)
10:     || limits.maximumMessageBytes > 0xffffffff || limits.maximumMessageBytes > limits.maximumSessionBytes) {
11:     throw new Error('WORKER_NATIVE_CONTROL_CONFIG_INVALID');
12:   }
13: }
14: 
15: /** Bounded binary framing only. Roles own message meaning and durable phase acknowledgment. */
16: export class NativeWorkerControlChannel {
17:   readonly #stream: Duplex;
18:   readonly #limits: NativeWorkerControlLimits;
19:   #sent = 0;
20:   #received = 0;
21:   #reading = false;
22:   #closed = false;
23:   #writes: Promise<void> = Promise.resolve();
24: 
25:   constructor(stream: unknown, limits: NativeWorkerControlLimits) {
26:     validateNativeWorkerControlLimits(limits);
27:     if (!(stream instanceof Duplex)) throw new Error('WORKER_NATIVE_CONTROL_CONFIG_INVALID');
28:     this.#stream = stream; this.#limits = { ...limits };
29:     // Read/write operations retain the failure; a closed pipe must not become an uncaught event.
30:     stream.on('error', () => {});
31:   }
32: 
33:   send(input: Uint8Array): Promise<void> {
34:     if (this.#closed) return Promise.reject(new Error('WORKER_NATIVE_CONTROL_CLOSED'));
35:     if (!input.byteLength || input.byteLength > this.#limits.maximumMessageBytes
36:       || this.#sent + input.byteLength + 4 > this.#limits.maximumSessionBytes) return Promise.reject(new Error('WORKER_NATIVE_CONTROL_OUTPUT_LIMIT'));
37:     const bytes = Buffer.from(input);
38:     this.#sent += bytes.byteLength + 4;
39:     const header = Buffer.alloc(4); header.writeUInt32BE(bytes.byteLength);
40:     const operation = this.#writes.then(() => new Promise<void>((resolve, reject) => {
41:       this.#stream.write(Buffer.concat([header, bytes]), error => { if (error) reject(error); else resolve(); });
42:     }));
43:     this.#writes = operation; void operation.catch(() => {}); return operation;
44:   }
45: 
46:   async *messages(): AsyncGenerator<Buffer> {
47:     if (this.#reading) throw new Error('WORKER_NATIVE_CONTROL_READER_ALREADY_USED');
48:     this.#reading = true;
49:     let pending = Buffer.alloc(0);
50:     for await (const raw of this.#stream) {
51:       const bytes = Buffer.from(raw); this.#received += bytes.byteLength;
52:       if (this.#received > this.#limits.maximumSessionBytes) throw new Error('WORKER_NATIVE_CONTROL_INPUT_LIMIT');
53:       pending = Buffer.concat([pending, bytes]);
54:       while (pending.byteLength >= 4) {
55:         const length = pending.readUInt32BE();
56:         if (!length || length > this.#limits.maximumMessageBytes) throw new Error('WORKER_NATIVE_CONTROL_MESSAGE_LIMIT');
57:         if (pending.byteLength < length + 4) break;
58:         yield Buffer.from(pending.subarray(4, length + 4));
59:         pending = pending.subarray(length + 4);
60:       }
61:     }
62:     if (pending.byteLength) throw new Error('WORKER_NATIVE_CONTROL_TRUNCATED');
63:   }
64: 
65:   async end(): Promise<void> {
66:     this.#closed = true;
67:     await this.#writes;
68:     await new Promise<void>((resolve, reject) => {
69:       this.#stream.end((error?: Error | null) => { if (error) reject(error); else resolve(); });
70:     });
71:   }
72: 
73:   destroy(): void { this.#closed = true; this.#stream.destroy(); }
74: }

SOURCE skills/worker/core/worker/native-hierarchy-events.ts SHA256 de9626356ef4ffca272c1bb534b29e13c9a3845df0ff34b33783b71320e32aea
1: import fs from 'node:fs';
2: import path from 'node:path';
3: 
4: /** Mountinfo vectors test parsing only; they are not cgroup enforcement evidence. */
5: export function validateHierarchicalCgroupEvents(mountinfo: string, scope: string): void {
6:   const mounts = mountinfo.trim().split('\n').map(line => {
7:     const [location, filesystem] = line.split(' - ');
8:     const fields = location?.split(' '); const tail = filesystem?.split(' ');
9:     if (!fields || fields.length < 6 || !tail || tail.length < 3) throw new Error('WORKER_NATIVE_MOUNTINFO_INVALID');
10:     const target = fields[4]!.replace(/\\([0-7]{3})/gu, (_match, octal: string) => String.fromCharCode(parseInt(octal, 8)));
11:     return { target, type: tail[0], options: tail[2]!.split(',') };
12:   }).filter(mount => scope === mount.target || scope.startsWith(mount.target.endsWith('/') ? mount.target : mount.target + '/'));
13:   const length = Math.max(...mounts.map(mount => mount.target.length));
14:   const covering = mounts.filter(mount => mount.target.length === length);
15:   if (covering.length !== 1 || covering[0]!.type !== 'cgroup2' || !path.isAbsolute(scope)) {
16:     throw new Error('WORKER_NATIVE_MOUNTINFO_INVALID');
17:   }
18:   if (covering[0]!.options.some(option => option === 'memory_localevents' || option === 'pids_localevents')) {
19:     throw new Error('WORKER_NATIVE_HIERARCHICAL_EVENTS_REQUIRED');
20:   }
21: }
22: 
23: export function requireHierarchicalCgroupEvents(scope: string): void {
24:   validateHierarchicalCgroupEvents(fs.readFileSync('/proc/self/mountinfo', 'utf8'), scope);
25: }

SOURCE skills/worker/core/worker/native-journal-capacity.ts SHA256 a0369d6ac33fa5607b03125d52e50aa8172e0b338c528c90b4e1e13fac47b65a
1: import { canonicalJson } from '@kubeclaw/pipeline-worker-core-contract';
2: import { assertDurableRecordReplay, type DurableRecord, type DurableRecordState } from '@kubeclaw/plugin-foundation/observability/durable-records';
3: import { readDurableState } from '@kubeclaw/plugin-foundation/observability/durable-delivery';
4: import { nativeJournalMaximumDiagnosticUnits, validateJournalState, type NativeAttemptJournalLimits, type NativeAttemptJournalState } from './native-journal-state.ts';
5: 
6: export const nativeJournalStream = 'native-worker-attempts.v1';
7: export const nativeJournalMaximumRecordBytes = 65536;
8: const maximumInteger = Number.MAX_SAFE_INTEGER;
9: const maximumDate = '+275760-09-13T00:00:00.000Z';
10: const digest = `sha256:${'0'.repeat(64)}`;
11: const diagnostic = '\u0000'.repeat(nativeJournalMaximumDiagnosticUnits);
12: 
13: function futurePayload(payload: NativeAttemptJournalState, limits: NativeAttemptJournalLimits) {
14:   if (payload.result !== null) return payload;
15:   // Per-field envelopes intentionally allow both output references their full
16:   // limit; no synthetic output, observations or diagnostics are ever persisted.
17:   const output = { digest, sizeBytes: limits.maximumOutputBytes };
18:   return { ...payload, process: payload.process ?? {
19:     schemaVersion: 'worker-native-process-result.v1', stdout: output, stderr: output,
20:     exitCode: null, signal: diagnostic, fault: diagnostic,
21:     resources: { unit: 'linux-tasks', cpuTimeMicroseconds: maximumInteger,
22:       maximumMemoryBytes: maximumInteger, maximumTasks: maximumInteger,
23:       populated: false, oomKills: maximumInteger, taskLimitHits: maximumInteger },
24:   }, processCompletedAt: payload.processCompletedAt ?? maximumDate,
25:   result: { digest, sizeBytes: limits.maximumResultBytes } };
26: }
27: 
28: function futureRecordBytes(record: DurableRecord, limits: NativeAttemptJournalLimits): number {
29:   const actual = Buffer.byteLength(canonicalJson(record));
30:   if (record.stream !== nativeJournalStream) return actual;
31:   validateJournalState(record.payload);
32:   if (record.payload.result !== null) return actual;
33:   const payload = futurePayload(record.payload, limits);
34:   if (Buffer.byteLength(canonicalJson(payload)) > nativeJournalMaximumRecordBytes) {
35:     throw new Error('WORKER_NATIVE_JOURNAL_METADATA_CAPACITY_EXCEEDED');
36:   }
37:   return Math.max(actual, Buffer.byteLength(canonicalJson({ ...record,
38:     committedAt: maximumDate, payloadDigest: digest, payload })));
39: }
40: 
41: /** Real durable-store framing, including retained foreign rows/retirement data.
42:  * Caller holds the journal admission fence; serialize only one projected row at
43:  * a time and stop at the existing ceiling. Historical rows are not rewritten. */
44: export function nativeJournalTerminalMetadataBytes(state: DurableRecordState,
45:   limits: NativeAttemptJournalLimits): number {
46:   let total = Buffer.byteLength(canonicalJson({ ...state, records: [] }));
47:   for (const [index, record] of state.records.entries()) {
48:     const bytes = futureRecordBytes(record, limits) + (index === 0 ? 0 : 1);
49:     if (bytes > limits.maximumStateBytes - total) throw new Error('WORKER_NATIVE_JOURNAL_METADATA_CAPACITY_EXCEEDED');
50:     total += bytes;
51:   }
52:   if (total > limits.maximumStateBytes) throw new Error('WORKER_NATIVE_JOURNAL_METADATA_CAPACITY_EXCEEDED');
53:   return total;
54: }
55: 
56: /** Check before the journal writes an input blob or accepts a new identity. */
57: export async function reserveNativeJournalMetadata(file: string, payload: NativeAttemptJournalState,
58:   idempotencyKey: string, owner: string, limits: NativeAttemptJournalLimits): Promise<void> {
59:   const state = await readDurableState<DurableRecordState>(file,
60:     { schemaVersion: 'pipeline-durable-record-store.v1', records: [] }, limits.maximumStateBytes);
61:   assertDurableRecordReplay(state);
62:   const sequence = state.records.filter(row => row.stream === nativeJournalStream).length
63:     + (state.tombstones?.filter(row => row.stream === nativeJournalStream).length ?? 0) + 1;
64:   const record: DurableRecord = { schemaVersion: 'pipeline-durable-record.v2', owner,
65:     stream: nativeJournalStream, sequence, idempotencyKey, committedAt: maximumDate,
66:     payloadDigest: digest, payload };
67:   nativeJournalTerminalMetadataBytes({ ...state, schemaVersion: 'pipeline-durable-record-store.v2',
68:     records: [...state.records, record], tombstones: state.tombstones ?? [], retirements: state.retirements ?? [] }, limits);
69: }

SOURCE skills/worker/core/worker/native-journal-state.ts SHA256 ae5cca21eb24261fa5389c7081bc3534e8e12b411d5bda0e97a69a94ead424d2
1: import fs from 'node:fs/promises';
2: import path from 'node:path';
3: import { sha256Digest, type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
4: import type { WorkerOwnershipIdentity } from './ownership-store.ts';
5: import type { NativeWorkerProcessResult } from './native-worker-process.ts';
6: import { identityValid, exact } from './ownership-state.ts';
7: import { validateNativeWorkerResourceObservation } from './native-resource-observation.ts';
8: 
9: export const nativeJournalMaximumDiagnosticUnits = 4096;
10: 
11: export interface NativeAttemptJournalLimits {
12:   readonly maximumRecords: number;
13:   readonly maximumStateBytes: number;
14:   readonly maximumTotalBytes: number;
15:   readonly maximumInputBytes: number;
16:   readonly maximumOutputBytes: number;
17:   readonly maximumResultBytes: number;
18: }
19: 
20: interface BlobReference { readonly digest: string; readonly sizeBytes: number }
21: type ProcessRecord = Omit<NativeWorkerProcessResult, 'stdout' | 'stderr'> & { stdout: BlobReference; stderr: BlobReference };
22: export interface NativeAttemptJournalState {
23:   readonly schemaVersion: 'native-attempt-journal.v1';
24:   readonly identity: WorkerOwnershipIdentity;
25:   readonly envelopeDigest: string;
26:   readonly envelope: BlobReference;
27:   readonly acceptedAt: string;
28:   readonly reservationBytes: number;
29:   readonly process: ProcessRecord | null;
30:   readonly processCompletedAt: string | null;
31:   readonly result: BlobReference | null;
32: }
33: 
34: export function journalIdentity(envelope: WorkerAttemptEnvelopeV3): WorkerOwnershipIdentity {
35:   return { workerId: envelope.claim.workerId, attemptId: envelope.attemptId, claimId: envelope.claim.claimId,
36:     generation: envelope.claim.generation, profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest };
37: }
38: 
39: export function journalKey(envelope: WorkerAttemptEnvelopeV3): string {
40:   return sha256Digest([envelope.claim.workerId, envelope.attemptId, envelope.claim.generation]);
41: }
42: 
43: function blobReference(value: unknown): void {
44:   exact(value, ['digest', 'sizeBytes']);
45:   if (typeof value.digest !== 'string' || !/^sha256:[a-f0-9]{64}$/u.test(value.digest)
46:     || !Number.isSafeInteger(value.sizeBytes) || Number(value.sizeBytes) < 0) throw new Error('WORKER_NATIVE_JOURNAL_BLOB_INVALID');
47: }
48: 
49: export function validateJournalState(value: unknown): asserts value is NativeAttemptJournalState {
50:   exact(value, ['schemaVersion', 'identity', 'envelopeDigest', 'envelope', 'acceptedAt', 'reservationBytes', 'process', 'processCompletedAt', 'result']);
51:   if (value.schemaVersion !== 'native-attempt-journal.v1' || typeof value.acceptedAt !== 'string'
52:     || !Number.isFinite(Date.parse(value.acceptedAt)) || !Number.isSafeInteger(value.reservationBytes) || Number(value.reservationBytes) < 1) {
53:     throw new Error('WORKER_NATIVE_JOURNAL_STATE_INVALID');
54:   }
55:   identityValid(value.identity);
56:   blobReference(value.envelope);
57:   if (value.envelopeDigest !== (value.envelope as BlobReference).digest) throw new Error('WORKER_NATIVE_JOURNAL_ENVELOPE_DIGEST_INVALID');
58:   if (value.result !== null) blobReference(value.result);
59:   if (value.process !== null) {
60:     validateProcess(value.process);
61:     if (typeof value.processCompletedAt !== 'string' || !Number.isFinite(Date.parse(value.processCompletedAt))) throw new Error('WORKER_NATIVE_JOURNAL_COMPLETION_TIME_INVALID');
62:   } else if (value.processCompletedAt !== null) throw new Error('WORKER_NATIVE_JOURNAL_COMPLETION_TIME_INVALID');
63: }
64: 
65: function validateProcess(value: unknown): void {
66:   exact(value, ['schemaVersion', 'stdout', 'stderr', 'exitCode', 'signal', 'fault', 'resources']);
67:   if (value.schemaVersion !== 'worker-native-process-result.v1') throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_INVALID');
68:   blobReference(value.stdout); blobReference(value.stderr);
69:   validateNativeWorkerResourceObservation(value.resources);
70:   if (value.resources.populated) throw new Error('WORKER_NATIVE_JOURNAL_PROCESS_NOT_QUIESCENT');
71:   if (value.exitCode !== null && (!Number.isInteger(value.exitCode) || Number(value.exitCode) < 0 || Number(value.exitCode) > 255)) throw new Error('WORKER_NATIVE_JOURNAL_EXIT_INVALID');
72:   if (value.exitCode !== 0 && value.fault === null) throw new Error('WORKER_NATIVE_JOURNAL_MISSING_PROCESS_FAILURE');
73:   for (const key of ['signal', 'fault']) {
74:     if (value[key] !== null && (typeof value[key] !== 'string' || value[key].length < 1 || value[key].length > nativeJournalMaximumDiagnosticUnits)) throw new Error('WORKER_NATIVE_JOURNAL_FAULT_INVALID');
75:   }
76: }
77: 
78: /** Count actual retained bytes, including crash leftovers, before new admission. */
79: export async function usedJournalBytes(root: string): Promise<number> {
80:   let total = 0;
81:   const pending = [root];
82:   while (pending.length) {
83:     const directory = pending.pop()!;
84:     for (const entry of await fs.readdir(directory, { withFileTypes: true })) {
85:       const file = path.join(directory, entry.name);
86:       if (entry.isDirectory()) { pending.push(file); continue; }
87:       if (!entry.isFile()) throw new Error('WORKER_NATIVE_JOURNAL_PATH_INVALID');
88:       total += await retainedFileSize(file);
89:       if (!Number.isSafeInteger(total)) throw new Error('WORKER_NATIVE_JOURNAL_CAPACITY_EXCEEDED');
90:     }
91:   }
92:   return total;
93: }
94: 
95: async function retainedFileSize(file: string): Promise<number> {
96:   try { return (await fs.lstat(file)).size; }
97:   catch (error) {
98:     // Atomic durable writes may unlink their temporary name during this scan.
99:     if ((error as NodeJS.ErrnoException).code === 'ENOENT') return 0;
100:     throw error;
101:   }
102: }

SOURCE skills/worker/core/worker/native-node-identity.ts SHA256 6ea78a96f82fa25ad27b26a2a48911e1e7a625fe9c0b25db76af39f49f2394f3
1: import fs from 'node:fs';
2: import path from 'node:path';
3: 
4: /** Root-managed host identity, mounted read-only by trusted deployment setup. */
5: export function readNativeWorkerNodeIdentity(file: string): string {
6:   if (!path.isAbsolute(file)) throw new Error('WORKER_NATIVE_NODE_IDENTITY_PATH_REQUIRED');
7:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
8:   try {
9:     const stat = fs.fstatSync(fd);
10:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || stat.size < 1 || stat.size > 128) {
11:       throw new Error('WORKER_NATIVE_NODE_IDENTITY_NOT_TRUSTED');
12:     }
13:     const identity = fs.readFileSync(fd, 'utf8').trim();
14:     if (!/^(?:[a-f0-9]{32}|[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12})$/u.test(identity)) {
15:       throw new Error('WORKER_NATIVE_NODE_IDENTITY_INVALID');
16:     }
17:     return `native-node:${identity}`;
18:   } finally { fs.closeSync(fd); }
19: }

SOURCE skills/worker/core/worker/native-output-spool.ts SHA256 da9b2bdd9f5b8f9418e98a451eb3275aadec117a9ee7ca733566e571870898c7
1: import fs, { type FileHandle } from 'node:fs/promises';
2: import { constants } from 'node:fs';
3: import path from 'node:path';
4: import { createHash } from 'node:crypto';
5: import { ensureDirectoryDurable } from '@kubeclaw/plugin-foundation/observability/durable-delivery';
6: 
7: export type NativeWorkerOutputChannel = 'stdout' | 'stderr';
8: export interface NativeWorkerOutputCapture {
9:   append(channel: NativeWorkerOutputChannel, bytes: Uint8Array): Promise<void>;
10:   flush(): Promise<void>;
11: }
12: 
13: /** Private, bounded, fsynced original host output. Never truncate or silently rotate. */
14: export class NativeWorkerOutputSpool implements NativeWorkerOutputCapture {
15:   readonly #handles: Record<NativeWorkerOutputChannel, FileHandle>;
16:   readonly #maximumBytes: number;
17:   #acceptedBytes = 0;
18:   #queue: Promise<void> = Promise.resolve();
19:   #closed = false;
20:   #closing: Promise<void> | undefined;
21: 
22:   private constructor(handles: Record<NativeWorkerOutputChannel, FileHandle>, maximumBytes: number) {
23:     this.#handles = handles;
24:     this.#maximumBytes = maximumBytes;
25:   }
26: 
27:   static async create(root: string, maximumBytes: number): Promise<NativeWorkerOutputSpool> {
28:     if (!path.isAbsolute(root) || !Number.isSafeInteger(maximumBytes) || maximumBytes < 1) throw new Error('WORKER_OUTPUT_SPOOL_CONFIG_INVALID');
29:     await ensureDirectoryDurable(path.dirname(root));
30:     await fs.mkdir(root, { mode: 0o700 });
31:     const handles: FileHandle[] = [];
32:     try {
33:       for (const channel of ['stdout', 'stderr']) handles.push(await fs.open(path.join(root, channel),
34:         constants.O_WRONLY | constants.O_APPEND | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, 0o600));
35:       await Promise.all(handles.map(handle => handle.sync()));
36:       await syncDirectories([root, path.dirname(root)]);
37:       return new NativeWorkerOutputSpool({ stdout: handles[0]!, stderr: handles[1]! }, maximumBytes);
38:     } catch (error) {
39:       const closed = await Promise.allSettled(handles.map(handle => handle.close()));
40:       throw new AggregateError([error, ...closed.filter(value => value.status === 'rejected').map(value => value.reason)], 'WORKER_OUTPUT_SPOOL_CREATE_FAILED');
41:     }
42:   }
43: 
44:   append(channel: NativeWorkerOutputChannel, input: Uint8Array): Promise<void> {
45:     if (this.#closed) return Promise.reject(new Error('WORKER_OUTPUT_SPOOL_CLOSED'));
46:     if (!['stdout', 'stderr'].includes(channel)) return Promise.reject(new Error('WORKER_OUTPUT_CHANNEL_INVALID'));
47:     if (this.#acceptedBytes + input.byteLength > this.#maximumBytes) return Promise.reject(new Error('WORKER_OUTPUT_SPOOL_LIMIT'));
48:     const bytes = Buffer.from(input);
49:     this.#acceptedBytes += bytes.byteLength;
50:     const operation = this.#queue.then(async () => {
51:       await this.#handles[channel].writeFile(bytes);
52:       await this.#handles[channel].sync();
53:     });
54:     this.#queue = operation;
55:     // Preserve the rejected queue for every subsequent flush/append, while the
56:     // caller handles this operation's failure and terminates its owned process.
57:     void operation.catch(() => undefined);
58:     return operation;
59:   }
60: 
61:   flush(): Promise<void> { return this.#queue; }
62: 
63:   close(): Promise<void> {
64:     this.#closed = true;
65:     this.#closing ??= this.#queue.finally(async () => {
66:       await Promise.all([this.#handles.stdout.close(), this.#handles.stderr.close()]);
67:     });
68:     return this.#closing;
69:   }
70: }
71: 
72: async function syncDirectories(directories: readonly string[]): Promise<void> {
73:   for (const directory of directories) {
74:     const handle = await fs.open(directory, 'r');
75:     try { await handle.sync(); } finally { await handle.close(); }
76:   }
77: }
78: 
79: export async function readNativeWorkerOutput(root: string, maximumBytes: number) {
80:   if (!path.isAbsolute(root) || !Number.isSafeInteger(maximumBytes) || maximumBytes < 1) throw new Error('WORKER_OUTPUT_SPOOL_CONFIG_INVALID');
81:   let total = 0;
82:   const read = async (channel: NativeWorkerOutputChannel) => {
83:     const handle = await fs.open(path.join(root, channel), constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
84:     try {
85:       const stat = await handle.stat();
86:       if (!stat.isFile() || stat.nlink !== 1 || stat.size > maximumBytes - total) throw new Error('WORKER_OUTPUT_SPOOL_FILE_INVALID');
87:       const bytes = await handle.readFile();
88:       total += bytes.byteLength;
89:       if (total > maximumBytes) throw new Error('WORKER_OUTPUT_SPOOL_LIMIT');
90:       return { bytes, sizeBytes: bytes.byteLength, digest: `sha256:${createHash('sha256').update(bytes).digest('hex')}` };
91:     } finally { await handle.close(); }
92:   };
93:   const stdout = await read('stdout');
94:   const stderr = await read('stderr');
95:   return { stdout, stderr };
96: }

SOURCE skills/worker/core/worker/native-owned-children.ts SHA256 631594461634def759607c57e4a7407c062bd1d5e837a28d7f83c5fcde5e204d
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import type { WorkerScopeBinding } from './ownership-store.ts';
4: import { childNameValid, validateChildLimits, type WorkerOwnedChild } from './ownership-children.ts';
5: import type { NativeWorkerScopeLimits } from './native-resource-scope.ts';
6: import { observeNativeWorkerResources } from './native-resource-observation.ts';
7: 
8: export function configureNativeLimits(scope: string, limits: NativeWorkerScopeLimits): void {
9:   validateChildLimits(limits);
10:   for (const [name, value] of Object.entries({ 'memory.max': limits.memoryBytes,
11:     'memory.swap.max': 0, 'memory.oom.group': 1, 'pids.max': limits.tasks })) {
12:     const file = path.join(scope, name);
13:     fs.writeFileSync(file, String(value));
14:     if (fs.readFileSync(file, 'utf8').trim() !== String(value)) throw new Error(`WORKER_NATIVE_LIMIT_MISMATCH:${name}`);
15:   }
16: }
17: 
18: export function aggregateChildLimits(parentPath: string, requested?: NativeWorkerScopeLimits): NativeWorkerScopeLimits {
19:   const parent = { memoryBytes: Number(fs.readFileSync(path.join(parentPath, 'memory.max'), 'utf8').trim()),
20:     tasks: Number(fs.readFileSync(path.join(parentPath, 'pids.max'), 'utf8').trim()) };
21:   validateChildLimits(parent);
22:   const limits = requested ? { ...requested } : parent;
23:   validateChildLimits(limits);
24:   if (limits.memoryBytes > parent.memoryBytes || limits.tasks > parent.tasks) throw new Error('WORKER_NATIVE_CHILD_LIMIT_EXCEEDS_PARENT');
25:   return limits;
26: }
27: 
28: export function createNativeChild(parentPath: string, parent: WorkerScopeBinding,
29:   child: WorkerOwnedChild): WorkerScopeBinding {
30:   if (!childNameValid(child.name) || child.binding !== null) throw new Error('WORKER_NATIVE_CHILD_RESERVATION_INVALID');
31:   const limits = aggregateChildLimits(parentPath, child.limits);
32:   const target = path.join(parentPath, child.name);
33:   fs.mkdirSync(target);
34:   // Keep partial creation for drain-only recovery under its durable reservation.
35:   configureNativeLimits(target, limits);
36:   if (observeNativeWorkerResources(target).populated) throw new Error('WORKER_NATIVE_UNBOUND_SCOPE_POPULATED');
37:   return readChildBinding(target, parent, child.name);
38: }
39: 
40: function readChildBinding(target: string, parent: WorkerScopeBinding, name: string): WorkerScopeBinding {
41:   const stat = fs.lstatSync(target);
42:   if (!stat.isDirectory() || stat.dev !== parent.device || fs.statfsSync(target).type !== 0x63677270) {
43:     throw new Error('WORKER_NATIVE_CHILD_BINDING_CHANGED');
44:   }
45:   return { scopeName: name, bootId: parent.bootId, device: stat.dev, inode: stat.ino };
46: }
47: 
48: export function verifyNativeChild(parentPath: string, parent: WorkerScopeBinding, child: WorkerOwnedChild): string {
49:   if (!childNameValid(child.name)) throw new Error('WORKER_NATIVE_CHILD_NAME_INVALID');
50:   const target = path.join(parentPath, child.name);
51:   const actual = readChildBinding(target, parent, child.name);
52:   if (child.binding && (actual.bootId !== child.binding.bootId || actual.device !== child.binding.device
53:     || actual.inode !== child.binding.inode || actual.scopeName !== child.binding.scopeName)) {
54:     throw new Error('WORKER_NATIVE_CHILD_BINDING_CHANGED');
55:   }
56:   if (fs.readdirSync(target, { withFileTypes: true }).some(entry => entry.isDirectory() || entry.isSymbolicLink())) {
57:     throw new Error('WORKER_NATIVE_UNKNOWN_CHILD');
58:   }
59:   if (!child.binding && observeNativeWorkerResources(target).populated) throw new Error('WORKER_NATIVE_UNBOUND_SCOPE_POPULATED');
60:   return target;
61: }
62: 
63: /** Missing bound children are legal only after the aggregate empty observation is durable. */
64: export function verifyNativeChildren(parentPath: string, parent: WorkerScopeBinding,
65:   children: readonly WorkerOwnedChild[], removalStarted: boolean): readonly string[] {
66:   const present = fs.readdirSync(parentPath, { withFileTypes: true })
67:     .filter(entry => entry.isDirectory() || entry.isSymbolicLink()).map(entry => entry.name);
68:   if (present.some(name => !children.some(child => child.name === name))) throw new Error('WORKER_NATIVE_UNKNOWN_CHILD');
69:   const paths: string[] = [];
70:   for (const child of children) {
71:     if (present.includes(child.name)) paths.push(verifyNativeChild(parentPath, parent, child));
72:     else if (child.binding && !removalStarted) throw new Error('WORKER_NATIVE_OWNED_CHILD_MISSING');
73:   }
74:   return paths;
75: }

SOURCE skills/worker/core/worker/native-pool-policy.ts SHA256 3b64878629a5ee897e8dd71ae6b592bc1c89df36677fc2860f8d7f4bb4227307
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import type { NativeWorkerPoolLimits } from './native-resource-pool.ts';
4: 
5: export interface NativeWorkerPoolPolicy {
6:   readonly schemaVersion: 1;
7:   readonly role: string;
8:   readonly nodeName: string;
9:   readonly policyDigest: string;
10:   readonly cgroupRoot: string;
11:   readonly ownershipRoot: string;
12:   readonly nodeIdentityFile: string;
13:   readonly runtimeIdentityFile: string;
14:   readonly maximumActiveScopes: number;
15:   readonly limits: NativeWorkerPoolLimits;
16: }
17: 
18: /** Generated by host preparation; no envelope or mutable worker environment defines aggregate capacity. */
19: export function readNativeWorkerPoolPolicy(file: string, role: string): NativeWorkerPoolPolicy {
20:   if (!path.isAbsolute(file)) throw new Error('WORKER_NATIVE_POOL_POLICY_PATH_REQUIRED');
21:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
22:   try {
23:     const stat = fs.fstatSync(fd);
24:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || stat.size < 1 || stat.size > 65536) {
25:       throw new Error('WORKER_NATIVE_POOL_POLICY_NOT_TRUSTED');
26:     }
27:     const value = JSON.parse(fs.readFileSync(fd, 'utf8')) as NativeWorkerPoolPolicy;
28:     validate(value, role);
29:     return Object.freeze({ ...value, limits: Object.freeze({ ...value.limits }) });
30:   } finally { fs.closeSync(fd); }
31: }
32: 
33: function validate(value: NativeWorkerPoolPolicy, role: string): void {
34:   if (value?.schemaVersion !== 1 || value.role !== role || typeof value.nodeName !== 'string' || !value.nodeName
35:     || typeof value.policyDigest !== 'string' || !/^[a-f0-9]{64}$/u.test(value.policyDigest)) throw new Error('WORKER_NATIVE_POOL_POLICY_INVALID');
36:   validatePaths(value);
37:   validateLimits(value);
38: }
39: 
40: function validatePaths(value: NativeWorkerPoolPolicy): void {
41:   for (const location of [value.cgroupRoot, value.ownershipRoot, value.nodeIdentityFile, value.runtimeIdentityFile]) {
42:     if (typeof location !== 'string' || !path.isAbsolute(location) || location === '/' || path.resolve(location) !== location) {
43:       throw new Error('WORKER_NATIVE_POOL_POLICY_PATH_INVALID');
44:     }
45:   }
46: }
47: 
48: function validateLimits(value: NativeWorkerPoolPolicy): void {
49:   for (const number of [value.maximumActiveScopes, value.limits?.memoryBytes, value.limits?.tasks,
50:     value.limits?.cpuQuotaMicroseconds, value.limits?.cpuPeriodMicroseconds]) {
51:     if (!Number.isSafeInteger(number) || number < 1) throw new Error('WORKER_NATIVE_POOL_POLICY_LIMIT_INVALID');
52:   }
53: }

SOURCE skills/worker/core/worker/native-process-cancellation.ts SHA256 1a3295c2220b82b3c06047151df0a6ca4e126f747f5eaabb57ddb5a753cd1bf5
1: import type { ChildProcess } from 'node:child_process';
2: 
3: /** Give the admitted host a bounded opportunity to close role-owned effects.
4:  * Resource violations still terminate the scope immediately in the supervisor.
5:  */
6: export function cancelNativeProcess(child: ChildProcess, timeoutMs: number, forceDrain: () => void): () => void {
7:   if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 2_147_483_647) {
8:     throw new Error('WORKER_NATIVE_CANCELLATION_DEADLINE_INVALID');
9:   }
10:   const timer = setTimeout(forceDrain, timeoutMs);
11:   const dispose = () => { clearTimeout(timer); child.removeListener('exit', dispose); };
12:   child.once('exit', dispose);
13:   try {
14:     if (!child.kill('SIGTERM')) { dispose(); forceDrain(); }
15:   } catch (error) { dispose(); throw error; }
16:   return dispose;
17: }

SOURCE skills/worker/core/worker/native-process-control.ts SHA256 3cfd56d48a2f70fb80072692a133fb0c8490bd94ec79d5270b771dd2e2717d2e
1: import type { ChildProcessWithoutNullStreams } from 'node:child_process';
2: import { NativeWorkerControlChannel, type NativeWorkerControlLimits } from './native-control-channel.ts';
3: import type { NativeWorkerLaunchAuthority } from './native-worker-ownership.ts';
4: 
5: export interface NativeWorkerProcessControl {
6:   readonly limits: NativeWorkerControlLimits;
7:   readonly run: (channel: NativeWorkerControlChannel, signal: AbortSignal, launch: NativeWorkerLaunchAuthority | undefined) => Promise<void>;
8: }
9: 
10: /** The optional fourth pipe carries role-owned phases, not a second completion boundary. */
11: export function startNativeProcessControl(child: ChildProcessWithoutNullStreams, options: NativeWorkerProcessControl | undefined,
12:   stop: (code: string) => void, closeTimeoutMs: number, launch?: NativeWorkerLaunchAuthority): { finish: () => Promise<void> } {
13:   if (!options) return { finish: async () => {} };
14:   const channel = new NativeWorkerControlChannel(child.stdio[3], options.limits);
15:   const controller = new AbortController();
16:   const work = Promise.resolve().then(() => options.run(channel, controller.signal, launch)).catch(() => {
17:     stop('WORKER_NATIVE_CONTROL_FAILED');
18:     channel.destroy();
19:   });
20:   let completion: Promise<void> | undefined;
21:   const finish = async () => {
22:     controller.abort(new Error('WORKER_NATIVE_CONTROL_PROCESS_CLOSED')); channel.destroy();
23:     let timer: NodeJS.Timeout | undefined;
24:     try {
25:       await Promise.race([work, new Promise<never>((_resolve, reject) => {
26:         timer = setTimeout(() => reject(new Error('WORKER_NATIVE_CONTROL_UNSETTLED')), closeTimeoutMs);
27:       })]);
28:     } finally { if (timer) clearTimeout(timer); }
29:   };
30:   return { finish: () => completion ??= finish() };
31: }

SOURCE skills/worker/core/worker/native-process-launches.ts SHA256 4b4ea9b64584e43f2f791d97872430f0d2dcf917d5ada11c0a8bb2ecd4456155
1: import { spawn, type ChildProcessWithoutNullStreams, type SpawnOptionsWithoutStdio } from 'node:child_process';
2: 
3: /** Own the launcher interval before kernel scope membership, as well as the host. */
4: export class NativeProcessLaunches {
5:   readonly #children = new Map<ChildProcessWithoutNullStreams, Promise<void>>();
6:   #closed = false;
7:   #drain: Promise<void> | undefined;
8: 
9:   spawn(executable: string, args: readonly string[], options: SpawnOptionsWithoutStdio,
10:     controlPipe = false): ChildProcessWithoutNullStreams {
11:     if (this.#closed) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
12:     const child = spawn(executable, [...args], { ...options,
13:       stdio: controlPipe ? ['pipe', 'pipe', 'pipe', 'pipe'] : 'pipe' }) as ChildProcessWithoutNullStreams;
14:     const exited = new Promise<void>(resolve => {
15:       const done = () => { this.#children.delete(child); resolve(); };
16:       child.once('exit', done);
17:       // A failed spawn has no process to reap. Later signal/IPC errors do not
18:       // prove termination: an existing child is retained until its exit event.
19:       child.on('error', () => { if (child.pid === undefined) done(); });
20:     });
21:     this.#children.set(child, exited);
22:     return child;
23:   }
24: 
25:   drain(timeoutMs: number): Promise<void> {
26:     if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 2_147_483_647) {
27:       return Promise.reject(new Error('WORKER_NATIVE_DRAIN_LIMIT_INVALID'));
28:     }
29:     this.#closed = true;
30:     this.#drain ??= this.#stop(timeoutMs);
31:     return this.#drain;
32:   }
33: 
34:   async #stop(timeoutMs: number): Promise<void> {
35:     const children = [...this.#children];
36:     // A failed spawn still has an error event pending but owns no process.
37:     // Signalling its uninitialized handle can replace the spawn error with EPERM.
38:     for (const [child] of children) if (child.pid !== undefined) child.kill('SIGKILL');
39:     let timer: NodeJS.Timeout | undefined;
40:     try {
41:       await Promise.race([Promise.all(children.map(([, exited]) => exited)), new Promise<never>((_resolve, reject) => {
42:         timer = setTimeout(() => reject(new Error('WORKER_NATIVE_LAUNCHER_DRAIN_TIMEOUT')), timeoutMs);
43:       })]);
44:     } finally { if (timer) clearTimeout(timer); }
45:   }
46: }

SOURCE skills/worker/core/worker/native-process-output.ts SHA256 5f7a4e1cdd9424fefe249775886a34019da38f7a76c486b38005c5d727f14350
1: import type { ChildProcessWithoutNullStreams } from 'node:child_process';
2: import type { NativeWorkerOutputCapture, NativeWorkerOutputChannel } from './native-output-spool.ts';
3: 
4: /** Backpressure reaches the real host pipes while durable output is being synced. */
5: export function captureNativeWorkerOutput(child: ChildProcessWithoutNullStreams, maximumBytes: number,
6:   stop: (code: string) => void, capture?: NativeWorkerOutputCapture) {
7:   if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 1) throw new Error('WORKER_NATIVE_OUTPUT_LIMIT_INVALID');
8:   const stdout: Buffer[] = [], stderr: Buffer[] = [];
9:   let totalBytes = 0;
10:   const receive = (channel: NativeWorkerOutputChannel, target: Buffer[], bytes: Buffer) => {
11:     totalBytes += bytes.byteLength;
12:     if (totalBytes > maximumBytes) { stop('WORKER_NATIVE_OUTPUT_LIMIT'); return; }
13:     target.push(Buffer.from(bytes));
14:     if (!capture) return;
15:     child[channel].pause();
16:     void capture.append(channel, bytes).then(() => { child[channel].resume(); }, () => {
17:       stop('WORKER_NATIVE_OUTPUT_PERSISTENCE_FAILED');
18:       child.stdout.destroy(); child.stderr.destroy();
19:     });
20:   };
21:   child.stdout.on('data', (bytes: Buffer) => receive('stdout', stdout, bytes));
22:   child.stderr.on('data', (bytes: Buffer) => receive('stderr', stderr, bytes));
23:   return {
24:     snapshot: () => ({ stdout: Buffer.concat(stdout), stderr: Buffer.concat(stderr) }),
25:     flush: () => capture ? capture.flush() : Promise.resolve(),
26:   };
27: }

SOURCE skills/worker/core/worker/native-resource-accounting.ts SHA256 c92b1246dd5b924b71147314257063eba2478838abe4ddcb3a9453a2e9abe448
