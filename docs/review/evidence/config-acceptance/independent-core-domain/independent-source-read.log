43: /** A lease is available only after its reservation and native identity are durable. */
44: export class NativeWorkerOwnershipLease {
45:   readonly #scope: NativeWorkerResourceScope;
46:   readonly #options: NativeWorkerOwnershipOptions;
47:   readonly #settled: (failed: boolean) => void;
48:   #record: WorkerOwnershipRecord;
49:   #started = false;
50:   #closing = false;
51:   #launch: Promise<ChildProcessWithoutNullStreams> | undefined;
52:   #completion: Promise<NativeWorkerResourceObservation> | undefined;
53:   #launcher: string | undefined;
54:   #childLaunches: Promise<unknown> = Promise.resolve();
55:   readonly #launchers = new NativeProcessLaunches();
56: 
57:   constructor(scope: NativeWorkerResourceScope, record: WorkerOwnershipRecord, options: NativeWorkerOwnershipOptions,
58:     settled: (failed: boolean) => void = () => {}) {
59:     this.#scope = scope;
60:     this.#record = record;
61:     this.#options = options;
62:     this.#settled = settled;
63:   }
64: 
65:   /** Spawn is inside the launch fence; callers never receive a reusable admission path. */
66:   launch(command: NativeWorkerLaunchCommand & { readonly launcher: string }, controlPipe = false): Promise<ChildProcessWithoutNullStreams> {
67:     if (this.#record.topology.kind !== 'aggregate.v1') return Promise.reject(new Error('WORKER_OWNERSHIP_LEGACY_LAUNCH_FORBIDDEN'));
68:     if (this.#started || this.#closing) return Promise.reject(new Error('WORKER_NATIVE_LAUNCH_FENCED'));
69:     const input = structuredClone(command);
70:     this.#launcher = input.launcher;
71:     this.#started = true;
72:     this.#launch = this.#options.store.transition(this.#record, 'running').then(async record => {
73:       this.#record = record;
74:       if (this.#closing) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
75:       return this.#startChild('host', input, controlPipe);
76:     });
77:     return this.#launch;
78:   }
79: 
80:   /** Only trusted supervisor callbacks receive this capability. No scope path crosses IPC. */
81:   launchAuthority(): NativeWorkerLaunchAuthority {
82:     return Object.freeze({ launch: async (command: NativeWorkerLaunchCommand) => {
83:       const input = structuredClone(command);
84:       if (this.#closing || !this.#started || !this.#launch) throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
85:       await this.#launch;
86:       if (this.#closing || this.#record.phase !== 'running') throw new Error('WORKER_NATIVE_LAUNCH_FENCED');
87:       const pending = this.#childLaunches.then(() => this.#startChild(`helper-${randomUUID()}`, input, false));
