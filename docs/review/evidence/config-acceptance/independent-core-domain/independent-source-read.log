57:             item.claimGeneration,
58:             item.evidenceId,
59:           ) === evidenceId,
60:       )
61:     )
62:       throw new Error(`OBSERVABILITY_CLOSURE_EVIDENCE_MISSING:${evidenceId}`);
63:   }
64:   if (
65:     state.closures.length - store.closureProjections.size >=
66:     store.limits.maximumClosures
67:   )
68:     throw new Error("OBSERVABILITY_CLOSURE_STORE_FULL");
69:   const candidate = { ...state, closures: [...state.closures, snapshot] };
70:   store.checkSize(candidate);
71:   await store.writeState(candidate);
72:   return structuredClone(snapshot);
73: }
74: export async function storeClosure(
75:   store: AttemptState,
76:   closure: ProducerClosureV1,
77:   admission: FileObservabilityAdmissionStore,
78: ): Promise<ProducerClosureV1> {
79:   const snapshot = structuredClone(closure);
80:   validatePipelineObservabilityContract("producerClosure", snapshot);
81:   const admitted = await admission.admittedRecords();
82:   return store.serial(async () => {
83:     const state = await store.readState();
84:     await store.reclaimExpiredEvidence(state);
85:     return storeClosureUnlocked(store, state, snapshot, admitted);
86:   });
87: }
88: export async function evaluateCompleteness(
89:   store: AttemptState,
90:   pipelineRunId: string,
91:   required: ReadonlyArray<RequiredProducerClosure>,
92:   admission: FileObservabilityAdmissionStore,
93:   missingRanges: ReadonlyArray<ProducerGapReportV1> = [],
94:   unresolvedItems: ReadonlyArray<UnresolvedObservabilityItemV1> = [],
95: ): Promise<ObservabilityCompletenessV1> {
96:   const requirements = structuredClone(required);
97:   const durableIssues = await admission.observabilityIssues(pipelineRunId);
98:   const rangeSnapshot = [
99:     ...durableIssues.missingRanges,
100:     ...structuredClone(missingRanges),
101:   ].filter(
102:     (item, index, items) =>
103:       items.findIndex(
104:         (candidate) => canonicalJson(candidate) === canonicalJson(item),
105:       ) === index,
106:   );
107:   const unresolvedSnapshot = uniqueUnresolvedItems([
108:     ...durableIssues.unresolvedItems,
109:     ...structuredClone(unresolvedItems),
110:   ]);
111:   const admittedRecords = await admission.admittedTail(pipelineRunId, 1);
112:   return store.serial(async () => {
113:     const state = await store.readState();
114:     await store.reclaimExpiredEvidence(state);
115:     return evaluateStoredClosures(state, {
116:       pipelineRunId,
117:       requirements,
118:       admittedRecords,
119:       rangeSnapshot,
120:       unresolvedSnapshot,
121:     });
122:   });
123: }
124: 
125: interface CompletenessRequest {
126:   pipelineRunId: string;
127:   requirements: ReadonlyArray<RequiredProducerClosure>;
128:   admittedRecords: ReadonlyArray<AdmittedRecordView>;
129:   rangeSnapshot: ProducerGapReportV1[];
130:   unresolvedSnapshot: UnresolvedObservabilityItemV1[];
131: }
132: async function evaluateStoredClosures(
133:   state: DurableAttemptStoreSnapshot,
134:   request: CompletenessRequest,
135: ): Promise<ObservabilityCompletenessV1> {
136:   const {
137:     pipelineRunId,
138:     requirements,
139:     admittedRecords,
140:     rangeSnapshot,
141:     unresolvedSnapshot,
142:   } = request;
143:   const requiredClosureIds = requirements.map((item) => item.closureId);
144:   if (new Set(requiredClosureIds).size !== requiredClosureIds.length)
145:     throw new Error("OBSERVABILITY_REQUIRED_CLOSURE_DUPLICATE");
146:   const admittedClosureIds: string[] = [];
147:   const evidenceItems: UnresolvedObservabilityItemV1[] = [];
148:   for (const requirement of requirements) {
149:     const evaluated = await evaluateClosure(
150:       state,
151:       pipelineRunId,
152:       requirement,
153:       admittedRecords,
154:     );
155:     evidenceItems.push(...evaluated.evidenceItems);
156:     if (evaluated.valid) admittedClosureIds.push(requirement.closureId);
157:   }
158:   const missingClosureIds = requiredClosureIds.filter(
159:     (id) => !admittedClosureIds.includes(id),
160:   );
161:   const closureItems = missingClosureIssues(
162:     state,
163:     missingClosureIds,
164:     requirements,
165:   );
166:   const allItems = uniqueUnresolvedItems([
167:     ...closureItems,
168:     ...evidenceItems,
169:     ...unresolvedSnapshot,
170:   ]);
171:   const completeness: ObservabilityCompletenessV1 = {
172:     schemaVersion: "observability-completeness.v1",
173:     pipelineRunId,
174:     state:
175:       missingClosureIds.length || rangeSnapshot.length || allItems.length
176:         ? "partial"
177:         : "complete",
178:     requiredClosureIds,
179:     admittedClosureIds,
180:     missingClosureIds,
181:     missingRanges: rangeSnapshot,
182:     unresolvedItems: allItems,
183:     evaluatedAt: new Date().toISOString(),
184:   };
185:   validatePipelineObservabilityContract(
186:     "observabilityCompleteness",
187:     completeness,
188:   );
189:   return completeness;
190: }
191: 
192: async function evaluateClosure(
193:   state: DurableAttemptStoreSnapshot,
194:   pipelineRunId: string,
195:   requirement: RequiredProducerClosure,
196:   admittedRecords: ReadonlyArray<AdmittedRecordView>,
197: ): Promise<{ valid: boolean; evidenceItems: UnresolvedObservabilityItemV1[] }> {
198:   const evidenceItems: UnresolvedObservabilityItemV1[] = [];
199:   const closure = state.closures.find(
200:     (item) =>
201:       item.pipelineRunId === pipelineRunId &&
202:       item.closureId === requirement.closureId &&
203:       sameProducer(item.producer, requirement.producer),
204:   );
205:   if (!closure) return { valid: false, evidenceItems: [] };
206:   const records = admittedRecords.filter(
207:     (item) =>
208:       item.record.correlation.pipelineRunId === pipelineRunId &&
209:       sameProducer(item.record.producer, requirement.producer),
210:   );
211:   let valid =
212:     records.length === closure.recordCount &&
213:     records.every(
214:       (item) =>
215:         item.record.sequence >= closure.firstSequence &&
216:         item.record.sequence <= closure.finalSequence,
217:     );
218:   for (const evidenceId of closure.requiredEvidenceIds) {
219:     const issue = await evidenceIssue(
220:       state,
221:       pipelineRunId,
222:       requirement,
223:       evidenceId,
224:     );
225:     if (issue) {
226:       valid = false;
227:       evidenceItems.push(issue);
228:     }
229:   }
230:   return { valid, evidenceItems };
231: }
232: 
233: async function evidenceIssue(
234:   state: DurableAttemptStoreSnapshot,
235:   pipelineRunId: string,
236:   requirement: RequiredProducerClosure,
237:   evidenceId: string,
238: ): Promise<UnresolvedObservabilityItemV1 | null> {
239:   const metadata = state.evidence.find(
240:     (item) =>
241:       item.pipelineRunId === pipelineRunId &&
242:       sameProducer(item.producer, requirement.producer) &&
243:       scopedEvidenceId(
244:         item.attemptId,
245:         item.claimGeneration,
246:         item.evidenceId,
247:       ) === evidenceId,
248:   );
249:   let reasonCode: string | null = null;
250:   if (!metadata) reasonCode = "evidence-missing";
251:   else {
252:     try {
253:       const bytes = await fs.readFile(new URL(metadata.artifact.storageUrl));
254:       if (
255:         bytes.byteLength !== metadata.artifact.sizeBytes ||
256:         digest(bytes) !== metadata.artifact.contentDigest
257:       )
258:         reasonCode = "evidence-corrupt";
259:     } catch {
260:       reasonCode = "evidence-unavailable";
261:     }
262:   }
263:   if (!reasonCode) return null;
264:   return {
265:     itemId: `evidence:${createHash("sha256").update(evidenceId).digest("hex")}`,
266:     kind: "missing-evidence",
267:     producer: requirement.producer,
268:     subjectId: evidenceId,
269:     reasonCode,
270:   };
271: }
272: 
273: function missingClosureIssues(
274:   state: DurableAttemptStoreSnapshot,
275:   missingClosureIds: readonly string[],
276:   requirements: readonly RequiredProducerClosure[],
277: ): UnresolvedObservabilityItemV1[] {
278:   return missingClosureIds.map((id) => {
279:     const requirement = requirements.find((item) => item.closureId === id)!;
280:     return {
281:       itemId: `gap:${id}`,
282:       kind: "missing-closure" as const,
283:       producer: requirement.producer,
284:       subjectId: id,
285:       reasonCode: state.closures.some((item) => item.closureId === id)
286:         ? "producer-closure-stale"
287:         : "producer-closure-missing",
288:     };
289:   });
290: }
291: 
292: function uniqueUnresolvedItems(
293:   items: UnresolvedObservabilityItemV1[],
294: ): UnresolvedObservabilityItemV1[] {
295:   return items.filter(
296:     (item, index, items) =>
297:       items.findIndex((candidate) => candidate.itemId === item.itemId) ===
298:       index,
299:   );
300: }

SOURCE skills/common/plugin-runtime/foundation/observability/attempt-evidence.ts SHA256 e232178fab57c5f55742d9b8ccec88cdbccada7b77f6ec8a653ee1ad56972f95
1: import fs from "node:fs/promises";
2: import type { Dirent } from "node:fs";
3: import path from "node:path";
4: import { createHash, randomUUID } from "node:crypto";
5: import { pathToFileURL } from "node:url";
6: import type { WorkerEvidenceRefV1 } from "@kubeclaw/pipeline-worker-core-contract";
7: import { ensureDirectoryDurable } from "./durable-delivery.ts";
8: import {
9:   canonicalJson,
10:   validatePipelineObservabilityContract,
11:   type ProducerIdentityV1,
12: } from "@kubeclaw/pipeline-observability-contract";
13: import type {
14:   DurableAttemptStoreLimits,
15:   DurableEvidenceInput,
16:   DurableEvidenceMetadata,
17:   DurableAttemptStoreSnapshot,
18: } from "./durable-attempts.ts";
19: import type { AttemptState } from "./attempt-state.ts";
20: export function requireIdentity(value: string, code: string): void {
21:   if (typeof value !== "string" || value.length < 1 || value.length > 512)
22:     throw new Error(code);
23: }
24: 
25: export function digest(bytes: Uint8Array): string {
26:   return `sha256:${createHash("sha256").update(bytes).digest("hex")}`;
27: }
28: 
29: export function sameProducer(
30:   left: ProducerIdentityV1,
31:   right: ProducerIdentityV1,
32: ): boolean {
33:   return (
34:     left.producerId === right.producerId &&
35:     left.bootId === right.bootId &&
36:     left.producerType === right.producerType
37:   );
38: }
39: 
40: export async function syncDirectory(directory: string): Promise<void> {
41:   const handle = await fs.open(directory, "r");
42:   try {
43:     await handle.sync();
44:   } finally {
45:     await handle.close();
46:   }
47: }
48: 
49: export async function durableBlob(
50:   root: string,
51:   contentDigest: string,
52:   bytes: Uint8Array,
53: ): Promise<string> {
54:   const hex = contentDigest.slice("sha256:".length);
55:   const directory = path.join(root, "blobs", hex.slice(0, 2));
56:   const staging = path.join(root, "staging");
57:   await ensureDirectoryDurable(directory);
58:   await ensureDirectoryDurable(staging);
59:   const destination = path.join(directory, hex);
60:   try {
61:     const existing = await fs.readFile(destination);
62:     if (digest(existing) !== contentDigest)
63:       throw new Error("OBSERVABILITY_EVIDENCE_DIGEST_CONFLICT");
64:     return destination;
65:   } catch (error) {
66:     if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
67:   }
68:   const temporary = path.join(staging, `${hex}.${randomUUID()}.tmp`);
69:   let renamed = false;
70:   try {
71:     const handle = await fs.open(temporary, "wx", 0o600);
72:     try {
73:       await handle.writeFile(bytes);
74:       await handle.sync();
75:     } finally {
76:       await handle.close();
77:     }
78:     await fs.rename(temporary, destination);
79:     renamed = true;
80:     await syncDirectory(directory);
81:     return destination;
82:   } finally {
83:     if (!renamed) await fs.unlink(temporary).catch(() => undefined);
84:   }
85: }
86: 
87: export async function cleanupStaging(root: string): Promise<void> {
88:   const staging = path.join(root, "staging");
89:   await fs.mkdir(staging, { recursive: true });
90:   for (const entry of await fs.readdir(staging, { withFileTypes: true })) {
91:     if (entry.isFile() && entry.name.endsWith(".tmp"))
92:       await fs.unlink(path.join(staging, entry.name));
93:   }
94: }
95: 
96: export async function cleanupUnreferencedBlobs(
97:   root: string,
98:   state: DurableAttemptStoreSnapshot,
99: ): Promise<void> {
100:   const blobs = path.join(root, "blobs");
101:   const referenced = new Set(
102:     state.evidence.map((item) => item.artifact.contentDigest.slice(7)),
103:   );
104:   let prefixes: Dirent<string>[] = [];
105:   try {
106:     prefixes = await fs.readdir(blobs, {
107:       withFileTypes: true,
108:       encoding: "utf8",
109:     });
110:   } catch (error) {
111:     if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
112:     throw error;
113:   }
114:   for (const prefix of prefixes) {
115:     if (!prefix.isDirectory() || !/^[0-9a-f]{2}$/.test(prefix.name)) continue;
116:     const directory = path.join(blobs, prefix.name);
117:     for (const entry of await fs.readdir(directory, {
118:       withFileTypes: true,
119:       encoding: "utf8",
120:     })) {
121:       if (
122:         entry.isFile() &&
123:         /^[0-9a-f]{64}$/.test(entry.name) &&
124:         !referenced.has(entry.name)
125:       )
126:         await fs.unlink(path.join(directory, entry.name));
127:     }
128:   }
129: }
130: 
131: export function scopedEvidenceId(
132:   attemptId: string,
133:   claimGeneration: number,
134:   evidenceId: string,
135: ): string {
136:   return `evidence:${createHash("sha256").update(canonicalJson({ attemptId, claimGeneration, evidenceId })).digest("hex")}`;
137: }
138: export async function storeEvidence(
139:   store: AttemptState,
140:   input: DurableEvidenceInput,
141:   bytes: Uint8Array,
142: ): Promise<WorkerEvidenceRefV1> {
143:   const snapshot = structuredClone(input);
144:   validateEvidenceInput(snapshot);
145:   const content = Uint8Array.from(bytes);
146:   if (content.byteLength > store.limits.maximumEvidenceObjectBytes)
147:     throw new Error("OBSERVABILITY_EVIDENCE_OBJECT_TOO_LARGE");
148:   return store.serial(() => persistEvidence(store, snapshot, content));
149: }
150: 
151: function validateEvidenceInput(snapshot: DurableEvidenceInput): void {
152:   requireIdentity(
153:     snapshot.pipelineRunId,
154:     "OBSERVABILITY_PIPELINE_RUN_ID_INVALID",
155:   );
156:   requireIdentity(snapshot.attemptId, "OBSERVABILITY_ATTEMPT_ID_INVALID");
157:   requireIdentity(snapshot.evidenceId, "OBSERVABILITY_EVIDENCE_ID_INVALID");
158:   requireIdentity(snapshot.type, "OBSERVABILITY_EVIDENCE_TYPE_INVALID");
159:   requireIdentity(
160:     snapshot.mediaType,
161:     "OBSERVABILITY_EVIDENCE_MEDIA_TYPE_INVALID",
162:   );
163:   if (
164:     !Number.isSafeInteger(snapshot.claimGeneration) ||
165:     snapshot.claimGeneration < 1
166:   )
167:     throw new Error("OBSERVABILITY_CLAIM_GENERATION_INVALID");
168:   validatePipelineObservabilityContract("producerIdentity", snapshot.producer);
169: }
170: 
171: async function persistEvidence(
172:   store: AttemptState,
173:   snapshot: DurableEvidenceInput,
174:   content: Uint8Array,
175: ): Promise<WorkerEvidenceRefV1> {
176:   const state = await store.readState();
177:   await store.reclaimExpiredEvidence(state);
178:   await cleanupUnreferencedBlobs(store.root, state);
179:   const existing = state.evidence.find(
180:     (item) =>
181:       item.pipelineRunId === snapshot.pipelineRunId &&
182:       item.attemptId === snapshot.attemptId &&
183:       item.claimGeneration === snapshot.claimGeneration &&
184:       item.evidenceId === snapshot.evidenceId,
185:   );
186:   const contentDigest = digest(content);
187:   if (existing) {
188:     if (
189:       existing.artifact.contentDigest !== contentDigest ||
190:       existing.type !== snapshot.type ||
191:       existing.mediaType !== snapshot.mediaType ||
192:       !sameProducer(existing.producer, snapshot.producer)
193:     )
194:       throw new Error("OBSERVABILITY_EVIDENCE_IDENTITY_CONFLICT");
195:     return structuredClone({
196:       evidenceId: existing.evidenceId,
197:       type: existing.type,
198:       artifact: existing.artifact,
199:     });
200:   }
201:   assertEvidenceCapacity(state, store.limits, content);
202:   const hex = contentDigest.slice(7);
203:   const destination = path.join(store.root, "blobs", hex.slice(0, 2), hex);
204:   const artifact = {
205:     artifactId: `artifact:${hex}`,
206:     type: snapshot.type,
207:     mediaType: snapshot.mediaType,
208:     contentDigest,
209:     sizeBytes: content.byteLength,
210:     storageUrl: pathToFileURL(destination).href,
211:   };
212:   const metadata: DurableEvidenceMetadata = {
213:     ...snapshot,
214:     artifact,
215:     stagedAt: new Date().toISOString(),
216:   };
217:   const candidate = { ...state, evidence: [...state.evidence, metadata] };
218:   store.checkSize(candidate);
219:   await durableBlob(store.root, contentDigest, content);
220:   await store.writeState(candidate);
221:   return structuredClone({
222:     evidenceId: snapshot.evidenceId,
223:     type: snapshot.type,
224:     artifact,
225:   });
226: }
227: 
228: function assertEvidenceCapacity(
229:   state: DurableAttemptStoreSnapshot,
230:   limits: DurableAttemptStoreLimits,
231:   content: Uint8Array,
232: ): void {
233:   const total = state.evidence.reduce(
234:     (sum, item) => sum + item.artifact.sizeBytes,
235:     0,
236:   );
237:   if (
238:     state.evidence.length >= limits.maximumEvidenceObjects ||
239:     total + content.byteLength > limits.maximumEvidenceBytes
240:   )
241:     throw new Error("OBSERVABILITY_EVIDENCE_STORE_FULL");
242: }

