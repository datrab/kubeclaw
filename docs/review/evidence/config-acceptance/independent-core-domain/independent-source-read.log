47: export class ProviderProcessSession {
48:   readonly #policy: BusterProviderRuntimeSettings;
49:   readonly #entry: TestProviderRegistryEntry;
50:   readonly #invocation: ProviderInvocationV1;
51:   readonly #child: ChildProcessWithoutNullStreams;
52:   readonly #lines: readline.Interface;
53:   readonly #sampleTimer: NodeJS.Timeout;
54:   readonly #modulePath: string;
55:   #context: TestProviderExecutionContext | null = null;
56:   #contextAbort: (() => void) | null = null;
57:   #initializeResolve: ((supportsCleanup: boolean) => void) | null = null;
58:   #initializeReject: ((error: Error) => void) | null = null;
59:   #initialized: boolean | null = null;
60:   #initializationFailure: Error | null = null;
61:   #resultResolve: ((value: ProviderResultV1) => void) | null = null;
62:   #resultReject: ((error: Error) => void) | null = null;
63:   #cleanupResolve: (() => void) | null = null;
64:   #cleanupReject: ((error: Error) => void) | null = null;
65:   #closed = false;
66:   #disposalConfirmed = false;
67:   readonly #capabilities: ProviderCapabilities;
68:   #termination: Promise<void> | null = null;
69:   #protocolBytes = 0;
70:   #protocolFailure: Error | null = null;
71:   #resources: ProviderProcessResources = { cpuTimeMs: 0, maximumMemoryBytes: 0, maximumProcesses: 1 };
72: 
73:   constructor(entry: TestProviderRegistryEntry, invocation: ProviderInvocationV1, workspaceRootValue: string, policy: BusterProviderRuntimeSettings) {
74:     this.#policy = validateBusterProviderRuntimeSettings(policy);
75:     this.#capabilities = new ProviderCapabilities(this.#policy.provider.maximumPendingCapabilities);
76:     this.#entry = entry;
77:     this.#invocation = invocation;
78:     if (!Number.isSafeInteger(invocation.limits.artifactFiles + this.#policy.provider.artifactFileDescriptorReserve)) {
79:       throw new Error('TEST_PROVIDER_DESCRIPTOR_BUDGET_INVALID');
80:     }
81:     const runtime = runtimePaths();
82:     const modulePath = canonicalModule(entry);
83:     this.#modulePath = modulePath;
84:     const { repository, scratch, evidence } = providerWorkspace(workspaceRootValue, invocation.workspace);
85:     const artifactInputs = invocation.inputs.filter((input) => input.kind === 'artifact').map((input) => {
86:       if (!input.artifact.storageUrl.startsWith('file:')) throw new Error('TEST_PROVIDER_ARTIFACT_INPUT_UNSUPPORTED');
87:       const artifact = fs.realpathSync(fileURLToPath(input.artifact.storageUrl));
88:       if (!fs.statSync(artifact).isFile()) throw new Error('TEST_PROVIDER_ARTIFACT_INPUT_INVALID');
89:       return artifact;
90:     });
91:     this.#child = spawn(runtime.launcher, [
92:       String(invocation.limits.memoryBytes), String(Math.max(1, Math.ceil(invocation.limits.cpuMillis / 1000))),
93:       // Artifact files are provider outputs, not the process-wide descriptor budget. Node
94:       // needs a stable descriptor floor for its loader, IPC, and runtime internals even
95:       // when a provider is allowed to publish only a few artifacts.
96:       String(Math.max(this.#policy.provider.minimumOpenFiles, invocation.limits.artifactFiles + this.#policy.provider.artifactFileDescriptorReserve)), process.execPath,
97:       `--max-old-space-size=${Math.max(this.#policy.provider.minimumHeapMiB, Math.floor(invocation.limits.memoryBytes / (1024 * 1024) * this.#policy.provider.heapFraction))}`,
98:       '--permission', `--allow-fs-read=${runtime.child}`, `--allow-fs-read=${entry.package.root}`,
99:       `--allow-fs-read=${repository}`, `--allow-fs-read=${scratch}`, `--allow-fs-read=${evidence}`,
100:       ...artifactInputs.map((artifact) => `--allow-fs-read=${artifact}`),
101:       `--allow-fs-write=${scratch}`, `--allow-fs-write=${evidence}`, '--no-addons', runtime.child,
102:     ], { cwd: entry.package.root, detached: process.platform !== 'win32',
103:       env: { NODE_NO_WARNINGS: '1' }, stdio: ['pipe', 'pipe', 'pipe'] });
104:     // Enforce the byte budget before readline dispatches any message in the chunk.
105:     this.#child.stdout.on('data', (chunk: Buffer) => {
106:       this.#protocolBytes += chunk.byteLength;
107:       if (this.#protocolBytes > this.#policy.provider.maximumProtocolBytes) { this.#protocolFailure ??= new Error('TEST_PROVIDER_PROTOCOL_LIMIT'); this.#fail(this.#protocolFailure); void this.terminate().catch((error) => this.#fail(error instanceof Error ? error : new Error(String(error)))); }
108:     });
109:     this.#lines = readline.createInterface({ input: this.#child.stdout, crlfDelay: Infinity });
110:     this.#lines.on('line', (line) => {
111:       void this.#message(line).catch(async (error) => {
112:         this.#fail(error instanceof Error ? error : new Error(String(error)));
113:         await this.terminate();
114:       }).catch((error) => this.#fail(error instanceof Error ? error : new Error(String(error))));
115:     });
116:     this.#child.stderr.on('data', (chunk: Buffer) => this.#context?.log('stderr', chunk));
117:     this.#child.stdin.on('error', (error) => {
118:       if (!this.#closed) { this.#fail(error); void this.terminate().catch((failure) => this.#fail(failure)); }
119:     });
120:     this.#child.once('error', (error) => this.#fail(error));
121:     this.#child.once('close', (code, signal) => {
122:       this.#closed = true;
123:       this.#capabilities.abort(new Error('TEST_PROVIDER_PROCESS_CLOSED'));
124:       if (this.#initializeReject) { this.#initializeReject(new Error(`TEST_PROVIDER_INITIALIZE_EXITED:${String(code)}:${String(signal)}`)); this.#clearInitialize(); }
125:       if (this.#resultReject) this.#fail(new Error(`TEST_PROVIDER_PROCESS_EXITED:${String(code)}:${String(signal)}`));
126:       if (this.#cleanupReject) { this.#cleanupReject(new Error(`TEST_PROVIDER_CLEANUP_EXITED:${String(code)}:${String(signal)}`)); this.#clearCleanup(); }
127:       clearInterval(this.#sampleTimer); this.#lines.close();
128:       this.#detachContext();
129:     });
130:     this.#sampleTimer = setInterval(() => this.#sample(), this.#policy.observation.processSampleIntervalMs);
131:     this.#sample();
132:   }
133: 
134:   initialize(context: TestProviderExecutionContext): Promise<boolean> {
135:     this.#setContext(context);
136:     if (this.#protocolFailure) return Promise.reject(this.#protocolFailure);
137:     if (this.#initializationFailure) return Promise.reject(this.#initializationFailure);
138:     if (this.#initialized !== null) return Promise.resolve(this.#initialized);
139:     if (this.#initializeResolve) throw new Error('TEST_PROVIDER_INITIALIZE_DUPLICATE');
140:     const operation = new Promise<boolean>((resolve, reject) => { this.#initializeResolve = resolve; this.#initializeReject = reject; });
141:     if (!this.#send({ kind: 'initialize', modulePath: this.#modulePath, exportName: this.#entry.registration.entrypoint.export,
142:       invocation: this.#invocation, workspaceRoot: context.workspaceRoot,
143:       observation: { resourceSampleIntervalMs: this.#policy.observation.resourceSampleIntervalMs } })) this.#fail(new Error('TEST_PROVIDER_PROCESS_CLOSED'));
144:     return operation;
145:   }
146: 
147:   async execute(context: TestProviderExecutionContext): Promise<ProviderResultV1> {
148:     await this.initialize(context);
149:     if (this.#resultResolve) throw new Error('TEST_PROVIDER_EXECUTE_DUPLICATE');
150:     this.#setContext(context);
151:     const operation = new Promise<ProviderResultV1>((resolve, reject) => { this.#resultResolve = resolve; this.#resultReject = reject; });
152:     if (!this.#send({ kind: 'execute' })) this.#fail(new Error('TEST_PROVIDER_PROCESS_CLOSED'));
153:     return operation;
154:   }
155: 
156:   async cleanup(context: TestProviderExecutionContext, disposition: TestProviderCleanupDisposition): Promise<void> {
157:     assertCleanupDisposition(disposition);
158:     this.#setContext(context);
159:     if (this.#protocolFailure) return Promise.reject(this.#protocolFailure);
160:     if (this.#closed) return Promise.reject(new Error('TEST_PROVIDER_PROCESS_NOT_AVAILABLE'));
161:     const supported = await this.initialize(context);
162:     if (!supported) return;
163:     const operation = new Promise<void>((resolve, reject) => { this.#cleanupResolve = resolve; this.#cleanupReject = reject; });
164:     if (!this.#send({ kind: 'cleanup', schemaVersion: 'provider-cleanup.v1', disposition })) this.#fail(new Error('TEST_PROVIDER_PROCESS_CLOSED'));
165:     return operation;
166:   }
167: 
168:   terminate(): Promise<void> {
169:     this.#termination ??= this.#terminate();
170:     return this.#termination;
171:   }
172: 
173:   get disposalConfirmed(): boolean { return this.#disposalConfirmed; }
174: 
175:   async #terminate(): Promise<void> {
176:     this.#capabilities.abort(new Error('TEST_PROVIDER_TERMINATED'));
177:     if (this.#closed) { await this.#confirmDisposal(); return; }
178:     let signalFailure: Error | undefined;
179:     await new Promise<void>((resolve, reject) => {
180:       const signal = (value: NodeJS.Signals): void => {
181:         try { signalProvider(this.#child, value); }
182:         catch (cause) { signalFailure ??= new Error('TEST_PROVIDER_SIGNAL_FAILED', { cause }); }
183:       };
184:       const force = setTimeout(() => signal('SIGKILL'), this.#policy.provider.terminationGraceMs);
185:       const bound = setTimeout(() => { signal('SIGKILL'); reject(new Error('TEST_PROVIDER_TERMINATION_TIMEOUT')); }, this.#policy.provider.terminationTimeoutMs);
186:       this.#child.once('close', () => {
187:         clearTimeout(force); clearTimeout(bound);
188:         resolve();
189:       });
190:       try { this.#send({ kind: 'abort', reason: 'TEST_PROVIDER_TERMINATED' }); signal('SIGTERM'); }
191:       catch (cause) { signalFailure ??= new Error('TEST_PROVIDER_ABORT_SEND_FAILED', { cause }); signal('SIGKILL'); }
192:     });
193:     // Only confirmed process closure reaches this bounded drain. A signal
194:     // failure must not discard ownership of still-settling capability calls.
195:     await this.#confirmDisposal();
196:     if (signalFailure) throw signalFailure;
197:   }
198: 
199:   async #confirmDisposal(): Promise<void> {
200:     await this.#capabilities.drain(this.#policy.provider.capabilityDrainTimeoutMs);
201:     // Called only after actual close, never after a timeout or failed drain.
202:     this.#disposalConfirmed = true;
203:   }
204: 
205:   resources(): ProviderProcessResources { this.#sample(); return { ...this.#resources }; }
206: 
207:   #sample(): void {
208:     // After native close the PID can be reused. Retain the observations owned
209:     // by this session instead of sampling an unrelated future process.
210:     if (this.#closed) return;
211:     let facts: ReturnType<typeof processFacts>;
212:     try { facts = processFacts(this.#child.pid ?? -1); }
213:     catch (cause) {
214:       this.#fail(new Error('TEST_PROVIDER_OBSERVATION_FAILED', { cause }));
215:       void this.terminate().catch(error => this.#fail(error instanceof Error ? error : new Error(String(error))));
216:       return;
217:     }
218:     if (!facts) return;
219:     this.#resources = {
220:       cpuTimeMs: Math.max(this.#resources.cpuTimeMs, facts.cpuTimeMs),
221:       maximumMemoryBytes: Math.max(this.#resources.maximumMemoryBytes, facts.memoryBytes),
222:       maximumProcesses: Math.max(this.#resources.maximumProcesses, facts.processes),
223:     };
224:     const limit = facts.cpuTimeMs > this.#invocation.limits.cpuMillis ? 'TEST_PROVIDER_CPU_LIMIT'
225:       : facts.memoryBytes > this.#invocation.limits.memoryBytes ? 'TEST_PROVIDER_MEMORY_LIMIT'
226:         : facts.processes > this.#invocation.limits.processes ? 'TEST_PROVIDER_PROCESS_LIMIT' : null;
227:     if (limit !== null) { this.#fail(new Error(limit)); void this.terminate().catch((error) => this.#fail(error instanceof Error ? error : new Error(String(error)))); }
228:   }
229: 
230:   async #message(line: string): Promise<void> {
231:     if (this.#protocolBytes > this.#policy.provider.maximumProtocolBytes) return;
232:     let message: Record<string, unknown>;
233:     try { message = JSON.parse(line) as Record<string, unknown>; }
234:     catch { this.#fail(new Error('TEST_PROVIDER_PROTOCOL_INVALID')); await this.terminate(); return; }
235:     this.#reportedResources(message);
236:     if (this.#logMessage(message)) return;
237:     if (message.kind === 'capability-abort' && typeof message.id === 'string') {
238:       this.#capabilities.cancel(message.id, new Error(String(message.reason ?? 'TEST_PROVIDER_CAPABILITY_CANCELLED')));
239:       return;
240:     }
241:     if (message.kind === 'capability' && typeof message.id === 'string' && typeof message.capability === 'string') {
242:       if (!this.#context) throw new Error('TEST_PROVIDER_CONTEXT_MISSING');
243:       await this.#capabilities.handle(message.id, message.capability, message.request as never,
244:         this.#context, (value) => this.#send(value));
245:       return;
246:     }
247:     this.#terminalMessage(message);
248:   }
249: 
250:   #reportedResources(message: Record<string, unknown>): void {
251:     const reported = message.resources as Partial<ProviderProcessResources> | undefined;
252:     if (reported) this.#resources = {
253:       cpuTimeMs: Math.max(this.#resources.cpuTimeMs, Number(reported.cpuTimeMs ?? 0)),
254:       maximumMemoryBytes: Math.max(this.#resources.maximumMemoryBytes, Number(reported.maximumMemoryBytes ?? 0)),
255:       maximumProcesses: Math.max(this.#resources.maximumProcesses, Number(reported.maximumProcesses ?? 1)),
256:     };
257:   }
258: 
259:   #logMessage(message: Record<string, unknown>): boolean {
260:     if (message.kind === 'log' && (message.stream === 'stdout' || message.stream === 'stderr') && typeof message.content === 'string') {
261:       this.#context?.log(message.stream, message.encoding === 'base64' ? Buffer.from(message.content, 'base64') : message.content); return true;
262:     }
263:     return false;
264:   }
265: 
266:   #terminalMessage(message: Record<string, unknown>): void {
267:     if ((message.kind === 'result' || message.kind === 'cleanup-result') && this.#capabilities.pending > 0) {
268:       throw new Error('TEST_PROVIDER_UNAWAITED_CAPABILITIES');
269:     }
270:     if (message.kind === 'initialized' && typeof message.supportsCleanup === 'boolean') {
271:       this.#initialized = message.supportsCleanup;
272:       const resolve = this.#initializeResolve; this.#clearInitialize(); resolve?.(message.supportsCleanup); return;
273:     }
274:     if (message.kind === 'result') { const resolve = this.#resultResolve; this.#clearResult(); resolve?.(message.value as ProviderResultV1); return; }
275:     if (message.kind === 'cleanup-result') { const resolve = this.#cleanupResolve; this.#clearCleanup(); resolve?.(); return; }
276:     if (message.kind === 'error') this.#fail(new Error(`TEST_PROVIDER_FAILED:${String(message.error)}`));
277:   }
278: 
279:   #send(value: unknown): boolean {
280:     if (this.#closed || this.#termination || this.#child.stdin.destroyed || this.#child.stdin.writableEnded) return false;
281:     this.#child.stdin.write(`${JSON.stringify(value)}\n`);
282:     return true;
283:   }
284: 
285:   #setContext(context: TestProviderExecutionContext): void {
286:     this.#detachContext(); this.#context = context;
287:     this.#contextAbort = () => {
288:       if (this.#closed) return;
289:       const reason = context.signal.reason instanceof Error ? context.signal.reason
290:         : new Error('TEST_PROVIDER_CANCELLED', { cause: context.signal.reason });
291:       this.#capabilities.abort(reason);
292:       this.#fail(reason);
293:       void this.terminate().catch((error) => this.#fail(error instanceof Error ? error : new Error(String(error))));
294:     };
295:     if (context.signal.aborted) this.#contextAbort();
296:     else context.signal.addEventListener('abort', this.#contextAbort, { once: true });
297:   }
298: 
299:   #detachContext(): void {
300:     if (this.#context && this.#contextAbort) this.#context.signal.removeEventListener('abort', this.#contextAbort);
301:     this.#contextAbort = null;
302:   }
303: 
304:   #fail(error: Error): void {
305:     // The constructor samples before initialize has installed its callbacks.
306:     // Preserve that failure without preventing cleanup after an execution error.
307:     if (this.#initialized === null) this.#initializationFailure ??= error;
308:     const initializeReject = this.#initializeReject; const resultReject = this.#resultReject; const cleanupReject = this.#cleanupReject;
309:     this.#clearInitialize(); this.#clearResult(); this.#clearCleanup();
310:     initializeReject?.(error); resultReject?.(error); cleanupReject?.(error);
311:   }
312: 
313:   #clearInitialize(): void { this.#initializeResolve = null; this.#initializeReject = null; }
314: 
315:   #clearResult(): void { this.#resultResolve = null; this.#resultReject = null; }
316:   #clearCleanup(): void {
317:     this.#cleanupResolve = null; this.#cleanupReject = null;
318:   }
319: }
