2: 
3: export interface BuildkitReadinessOptions {
4:   readonly buildctlExecutable: string;
5:   readonly buildkitHost: string;
6:   readonly maximumExecutionMs: number;
7:   readonly maximumOutputBytes: number;
8: }
9: 
10: /** One current native check shared by concurrent callers; no completed result cache. */
11: export class BuildkitReadiness {
12:   readonly #options: BuildkitReadinessOptions;
13:   #lastCode: DependencyProcessResult['code'] | undefined;
14:   #checking: Promise<DependencyProcessResult> | undefined;
15:   readonly #cancellation = new AbortController();
16: 
17:   constructor(options: BuildkitReadinessOptions) {
18:     if (!options.buildctlExecutable.startsWith('/') || /[\0\r\n]/u.test(options.buildctlExecutable) || !options.buildkitHost || /[\0\r\n]/u.test(options.buildkitHost)) {
19:       throw new Error('BUSTER_READINESS_BUILDKIT_CONFIG_INVALID');
20:     }
21:     validateDependencyProcessLimits(options);
22:     this.#options = { ...options };
23:   }
24: 
25:   async shutdown(): Promise<void> {
26:     this.#cancellation.abort();
27:     await this.#checking;
28:   }
29: 
30:   check(): Promise<DependencyProcessResult> {
31:     this.#checking ??= runDependencyProcess({ executable: this.#options.buildctlExecutable,
32:       signal: this.#cancellation.signal,
33:       args: ['--addr', this.#options.buildkitHost, 'debug', 'workers'],
34:       maximumExecutionMs: this.#options.maximumExecutionMs, maximumOutputBytes: this.#options.maximumOutputBytes,
35:     }).then(result => {
36:       if (result.code !== this.#lastCode) {
37:         this.#lastCode = result.code;
38:         process.stderr.write(JSON.stringify({ event: 'buster.dependency-readiness', dependency: 'buildkit', ...result }) + '\n');
39:       }
40:       return result;
41:     }).finally(() => { this.#checking = undefined; });
42:     return this.#checking;
43:   }
44: }

