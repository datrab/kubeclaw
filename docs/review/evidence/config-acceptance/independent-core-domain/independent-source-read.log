151: 
152: if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
153: const serve = process.argv.length === 4 && process.argv[3] === '--serve';
154: const browserOnly = process.argv.length === 4 && process.argv[3] === '--browser-only';
155: if (process.argv.length !== 3 && !serve && !browserOnly) throw new Error('Usage: prepare-native-worker-pools.mjs ROOT_OWNED_GENERATED_POLICY_JSON [--serve|--browser-only]');
156: const selected = configuration(process.argv[2]);
157: if (browserOnly) prepareBrowserOnly(selected);
158: else prepare(selected);
159: if (serve) {
160:   // RemainAfterExit retains the unit state, not an empty delegated cgroup.
161:   // Keep the setup subgroup populated for the entire pool lifetime. Notify only
162:   // after both pools and their identities have been successfully verified.
163:   execFileSync('/usr/bin/systemd-notify', ['--ready', '--status=Native worker pools prepared; capacity preflight still required'], { stdio: 'inherit' });
164:   setInterval(() => {}, 60_000);
165: }
166: }

SOURCE skills/buster/engine/test-gates/buildkit-readiness.ts SHA256 7f50b4c1c6c1e661319dd2f9ba1afecf27dd19a26c06ac51ef52abc0d97703f3
