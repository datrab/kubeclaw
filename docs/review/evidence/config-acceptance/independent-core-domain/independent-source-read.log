1: import { canonicalJson, validateWorkerResourceContractV3,
2:   type WorkerAttemptEnvelopeV3 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { validateBusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
4: import { preparationDigest } from './preparation-header.ts';
5: import { assertPreparationCleanupEffects, type PreparationCleanupAssociation } from './preparation-cleanup-binding.ts';
6: import type { PreparationGateBinding } from './preparation-gate.ts';
7: 
8: function invalid(): never { throw new Error('BUSTER_PREPARATION_CLEANUP_ASSOCIATION_INVALID'); }
9: const digest = (value: unknown) => typeof value === 'string' && /^sha256:[a-f0-9]{64}$/u.test(value);
10: 
11: function validateAssociation(value: PreparationCleanupAssociation): void {
12:   if (!value || Object.keys(value).sort().join(',')
13:     !== 'effects,envelope,previousEnvelopeDigest,previousResultDigest,resultDigest,settings') invalid();
14:   assertPreparationCleanupEffects(value.effects);
15:   validateWorkerResourceContractV3('workerAttemptEnvelope', value.envelope);
16:   const settings = validateBusterPreparationSettings(value.settings);
17:   if ([value.envelope, value.settings].some(item => Buffer.byteLength(canonicalJson(item)) > settings.maximumInputBytes)) invalid();
18:   for (const item of [value.previousEnvelopeDigest, value.previousResultDigest, value.resultDigest]) {
19:     if (item !== null && !digest(item)) invalid();
20:   }
21:   const operation = value.envelope.operation;
22:   if (operation.contractId !== 'kubeclaw.native-source-cleanup@1'
23:     || operation.inputSchemaId !== 'native-source-cleanup-input.v1'
24:     || Object.keys(operation.values).sort().join(',') !== 'effectsDigest,reconciles'
25:     || operation.values.effectsDigest !== preparationDigest(value.effects)) invalid();
26: }
27: 
28: function validateOriginal(association: PreparationCleanupAssociation, original: WorkerAttemptEnvelopeV3): void {
29:   const reference = association.envelope.operation.values.reconciles as Record<string, unknown>;
30:   if (!reference || Object.keys(reference).sort().join(',') !== [
31:     'attemptId', 'attemptSpecDigest', 'claimGeneration', 'claimId', 'envelopeDigest',
32:     'profileDigest', 'receipt', 'resultDigest', 'workerId',
33:   ].sort().join(',')) invalid();
34:   const expected = { envelopeDigest: preparationDigest(original), attemptId: original.attemptId,
35:     attemptSpecDigest: original.attemptSpecDigest, profileDigest: original.profile.profileDigest,
36:     claimId: original.claim.claimId, claimGeneration: original.claim.generation, workerId: original.claim.workerId };
37:   if (Object.entries(expected).some(([key, value]) => reference[key] !== value) || !digest(reference.resultDigest)) invalid();
38:   const receipt = reference.receipt as Record<string, unknown>;
39:   if (!receipt || Object.keys(receipt).sort().join(',') !== 'receiptDigest,receiptId'
40:     || typeof receipt.receiptId !== 'string' || !digest(receipt.receiptDigest)) invalid();
41:   if (association.envelope.attemptId === original.attemptId
42:     || association.envelope.claim.claimId === original.claim.claimId) invalid();
43: }
44: 
45: /** This validates durable identity only; release additionally requires actual journal/owner verification. */
46: export function validatePreparationCleanupChain(value: readonly PreparationCleanupAssociation[],
47:   original: WorkerAttemptEnvelopeV3, gate: PreparationGateBinding | null): void {
48:   if (!Array.isArray(value)) invalid();
49:   let previous: PreparationCleanupAssociation | null = null;
50:   const attempts = new Set<string>();
51:   for (const association of value) {
52:     validateAssociation(association);
53:     validateOriginal(association, original);
54:     if (association.effects.originalEnvelopeDigest !== preparationDigest(original)
55:       || association.effects.admissionId !== original.operation.values.admissionId
56:       || preparationDigest(association.effects.gate) !== preparationDigest(gate)) invalid();
57:     if (association.previousEnvelopeDigest !== (previous ? preparationDigest(previous.envelope) : null)
58:       || association.previousResultDigest !== (previous?.resultDigest ?? null)) invalid();
59:     if (previous && (previous.resultDigest === null
60:       || preparationDigest(previous.effects) !== preparationDigest(association.effects))) invalid();
61:     if (attempts.has(association.envelope.attemptId)) invalid();
62:     attempts.add(association.envelope.attemptId);
63:     previous = association;
64:   }
65: }

