8:   type PreparationMessage, type PreparationMessageKind } from './preparation-channel.ts';
9: 
10: export interface PreparedAdmission {
11:   readonly job: PreparedPlanJob;
12:   readonly source: PreparedSourceReference;
13: }
14: 
15: export interface BusterPreparation {
16:   stage(chunks: AsyncIterable<Uint8Array>, admit: (job: PreparedPlanJob) => Promise<boolean>): Promise<BusterStagedAdmission | null>;
17:   extract(staged: BusterStagedAdmission): Promise<PreparedAdmission>;
18:   repository(source: PreparedSourceReference): Promise<string>;
19: }
20: 
21: interface Reply {
22:   readonly kind: PreparationMessageKind;
23:   readonly pending: ReturnType<typeof Promise.withResolvers<PreparationMessage>>;
24: }
25: 
26: /** Unprivileged HTTP transport only: it never parses or decodes the submitted archive. */
27: export class BusterPreparationClient {
28:   readonly #channel: NativeWorkerControlChannel;
29:   readonly #maximumPending: number;
30:   readonly #maximumRequestBytes: number;
31:   readonly #sourceRoot: string;
32:   readonly #maximumMetadataBytes: number;
33:   readonly #requests = new Map<string, Error | null>();
34:   readonly #replies = new Map<string, Reply>();
35:   readonly #reader: Promise<void>;
36:   #failure: Error | undefined;
37: 
38:   constructor(channel: NativeWorkerControlChannel, limits: {
39:     maximumPendingAdmissions: number; maximumRequestBytes: number; maximumResultBytes: number;
40:   }, sourceRoot: string) {
41:     this.#channel = channel;
42:     this.#maximumPending = limits.maximumPendingAdmissions;
43:     this.#maximumRequestBytes = limits.maximumRequestBytes;
44:     this.#sourceRoot = sourceRoot;
45:     this.#maximumMetadataBytes = limits.maximumResultBytes;
46:     this.#reader = this.#read().catch(error => {
47:       this.#failure = error instanceof Error ? error : new Error('BUSTER_PREPARATION_PARENT_LOST');
48:       for (const reply of this.#replies.values()) reply.pending.reject(this.#failure);
49:       this.#replies.clear();
50:       this.#channel.destroy();
51:     });
52:   }
53: 
54:   async stage(chunks: AsyncIterable<Uint8Array>, admit: (job: PreparedPlanJob) => Promise<boolean>): Promise<BusterStagedAdmission | null> {
55:     if (this.#failure) throw this.#failure;
56:     if (this.#requests.size >= this.#maximumPending) throw new Error('BUSTER_PREPARATION_ADMISSION_FULL');
57:     // This is a transport correlation only. Root chooses the source admission identity.
58:     const requestId = randomBytes(16).toString('hex');
59:     this.#requests.set(requestId, null);
60:     try {
61:       await this.#exchange(requestId, 'begin', 'ready');
62:       for await (const chunk of preparationChunks(chunks, this.#maximumRequestBytes)) {
63:         await this.#exchange(requestId, 'bytes', 'ack', chunk);
64:       }
65:       const preview = await this.#exchange(requestId, 'end', 'validated');
66:       const job: unknown = JSON.parse(preview.content.toString('utf8'));
67:       assertPreparedHeader(job);
68:       const previewDigest = preparationDigest(job);
69:       const accepted = await admit(structuredClone(job));
70:       const reply = await this.#exchange(requestId, accepted ? 'proceed' : 'decline', 'result');
71:       const staged = JSON.parse(reply.content.toString('utf8')) as BusterStagedAdmission | null;
72:       if (staged === null && !accepted) return null;
73:       if (!accepted || !staged || Object.keys(staged).sort().join(',') !== 'input,job') {
74:         throw new Error('BUSTER_PREPARATION_RESULT_INVALID');
75:       }
76:       assertBusterInput(staged.input, staged.job);
77:       if (preparationDigest(staged.job) !== previewDigest) throw new Error('BUSTER_PREPARATION_HEADER_CHANGED');
78:       return staged;
79:     } catch (error) {
80:       await this.#channel.send(encodePreparationMessage('cancel', requestId)).catch(() => {});
81:       throw error;
82:     } finally {
83:       this.#replies.delete(requestId);
84:       this.#requests.delete(requestId);
85:     }
86:   }
87: 
88:   async extract(staged: BusterStagedAdmission): Promise<PreparedAdmission> {
89:     staged = structuredClone(staged);
90:     assertBusterInput(staged.input, staged.job);
91:     if (this.#failure) throw this.#failure;
92:     if (this.#requests.size >= this.#maximumPending) throw new Error('BUSTER_PREPARATION_ADMISSION_FULL');
93:     const requestId = randomBytes(16).toString('hex');
94:     this.#requests.set(requestId, null);
95:     try {
96:       const reply = await this.#exchange(requestId, 'extract', 'result', Buffer.from(JSON.stringify(staged)));
97:       const prepared = JSON.parse(reply.content.toString('utf8')) as PreparedAdmission;
98:       if (!prepared || Object.keys(prepared).sort().join(',') !== 'job,source') throw new Error('BUSTER_PREPARATION_RESULT_INVALID');
99:       assertPreparedSource(prepared.source, prepared.job);
100:       if (preparationDigest(prepared.job) !== staged.input.headerDigest) throw new Error('BUSTER_PREPARATION_HEADER_CHANGED');
101:       return prepared;
102:     } catch (error) {
103:       await this.#channel.send(encodePreparationMessage('cancel', requestId)).catch(() => {});
104:       throw error;
105:     } finally {
106:       this.#replies.delete(requestId);
107:       this.#requests.delete(requestId);
108:     }
109:   }
110: 
111:   async disconnected(): Promise<void> {
112:     await this.#reader;
113:     throw this.#failure ?? new Error('BUSTER_PREPARATION_PARENT_LOST');
114:   }
115: 
116:   async close(): Promise<void> { this.#channel.destroy(); await this.#reader; }
117: 
118:   repository(source: PreparedSourceReference): Promise<string> {
119:     return publishedPreparationRepository(this.#sourceRoot, source, this.#maximumMetadataBytes);
120:   }
121: 
122:   async #exchange(id: string, sent: PreparationMessageKind, expected: PreparationMessageKind,
123:     content: Buffer = Buffer.alloc(0)): Promise<PreparationMessage> {
124:     if (this.#failure) throw this.#failure;
125:     const failure = this.#requests.get(id);
126:     if (failure) throw failure;
127:     const pending = Promise.withResolvers<PreparationMessage>();
128:     // Observe a reply rejection even when the simultaneous send fails first.
129:     void pending.promise.catch(() => {});
130:     this.#replies.set(id, { kind: expected, pending });
131:     await this.#channel.send(encodePreparationMessage(sent, id, content));
132:     return pending.promise;
133:   }
134: 
135:   async #read(): Promise<void> {
136:     for await (const bytes of this.#channel.messages()) {
137:       const message = decodePreparationMessage(bytes);
138:       const reply = this.#replies.get(message.admissionId);
139:       if (message.kind === 'failure') {
140:         const failure = new Error(message.content.toString('utf8'));
141:         if (this.#requests.has(message.admissionId)) this.#requests.set(message.admissionId, failure);
142:         reply?.pending.reject(failure);
143:         this.#replies.delete(message.admissionId);
144:         continue;
145:       }
146:       if (!reply) throw new Error('BUSTER_PREPARATION_REPLY_UNEXPECTED');
147:       if (message.kind !== reply.kind) throw new Error('BUSTER_PREPARATION_REPLY_UNEXPECTED');
148:       this.#replies.delete(message.admissionId);
149:       reply.pending.resolve(message);
150:     }
151:     throw new Error('BUSTER_PREPARATION_PARENT_LOST');
152:   }
153: }

