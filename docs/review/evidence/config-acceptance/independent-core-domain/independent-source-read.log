2: 
3: type NativeUse = Partial<WorkerResourceUseV1> & { maximumTasks?: number };
4: function validBatch(batch: WorkerNativeResourceAccounting['observations'], previous: NativeUse): boolean {
5:   for (const metric of workerNativeResourceMetrics) {
6:     const item = batch[metric];
7:     if (item?.status === 'observed') {
8:       if (!Number.isSafeInteger(item.value) || item.value < 0 || item.value < (previous[metric] ?? 0)) return false;
9:     } else if (item?.status !== 'unavailable' || typeof item.reason !== 'string' || !item.reason || item.reason.length > 4096) return false;
10:   }
11:   return true;
12: }
13: 
14: export function assessNativeWorkerResources(measured: unknown, accounting: WorkerNativeResourceAccounting, previous: NativeUse): {
15:   resources: NativeUse; error?: { code: string; message: string };
16: } {
17:   const invalid = () => {
18:     for (const metric of workerNativeResourceMetrics) accounting.observations[metric] = {
19:       status: 'unavailable', reason: 'Native worker observation is missing, invalid or regressed',
20:     };
21:     return { resources: {}, error: { code: 'WORKER_RESOURCE_MEASUREMENT_INVALID', message: 'Native worker observation is missing, invalid or regressed' } };
22:   };
23:   if (!measured || typeof measured !== 'object' || Array.isArray(measured)) return invalid();
24:   const batch = measured as WorkerNativeResourceAccounting['observations'];
25:   if (!validBatch(batch, previous)) return invalid();
26:   const resources: NativeUse = {};
27:   let error: { code: string; message: string } | undefined;
28:   const codes = { cpuTimeMs: 'WORKER_CPU_LIMIT', maximumMemoryBytes: 'WORKER_MEMORY_LIMIT', maximumTasks: 'WORKER_TASK_LIMIT' };
29:   for (const metric of workerNativeResourceMetrics) {
30:     const item = batch[metric], budget = accounting.budgets[metric];
31:     accounting.observations[metric] = structuredClone(item);
32:     if (item.status === 'observed') resources[metric] = item.value;
33:     if (budget.state !== 'requested') continue;
34:     if (item.status === 'unavailable') error ??= { code: 'WORKER_RESOURCE_MEASUREMENT_UNAVAILABLE', message: item.reason };
35:     else if (item.value > budget.limit) error ??= { code: codes[metric], message: codes[metric] };
36:   }
37:   return { resources, ...(error ? { error } : {}) };
38: }

SOURCE skills/worker/core/worker/native-resource-observation.ts SHA256 903fe22c2b9c51c908111361bb0423819a32ce1a4bf99b49b08cb39f490b976c
1: import fs from 'node:fs';
2: import path from 'node:path';
3: 
4: /** Native task units are deliberately distinct from V1 maximumProcesses. */
5: export interface NativeWorkerResourceObservation {
6:   readonly unit: 'linux-tasks';
7:   readonly cpuTimeMicroseconds: number;
8:   readonly maximumMemoryBytes: number;
9:   readonly maximumTasks: number;
10:   readonly populated: boolean;
11:   readonly oomKills: number;
12:   readonly taskLimitHits: number;
13: }
14: 
15: export function validateNativeWorkerResourceObservation(value: unknown): asserts value is NativeWorkerResourceObservation {
16:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('WORKER_NATIVE_OBSERVATION_INVALID');
17:   const observation = value as Record<string, unknown>;
18:   const counters = ['cpuTimeMicroseconds', 'maximumMemoryBytes', 'maximumTasks', 'oomKills', 'taskLimitHits'];
19:   if (Object.keys(observation).length !== 7 || observation.unit !== 'linux-tasks' || typeof observation.populated !== 'boolean'
20:     || counters.some(key => !Number.isSafeInteger(observation[key]) || Number(observation[key]) < 0)) {
21:     throw new Error('WORKER_NATIVE_OBSERVATION_INVALID');
22:   }
23: }
24: 
25: const CGROUP2_SUPER_MAGIC = 0x63677270;
26: 
27: function unsigned(value: string, field: string): number {
28:   if (!/^(0|[1-9]\d*)$/u.test(value)) throw new Error(`WORKER_NATIVE_COUNTER_INVALID:${field}`);
29:   const number = Number(value);
30:   if (!Number.isSafeInteger(number)) throw new Error(`WORKER_NATIVE_COUNTER_OVERFLOW:${field}`);
31:   return number;
32: }
33: 
34: function scalar(root: string, file: string): number {
35:   return unsigned(fs.readFileSync(path.join(root, file), 'utf8').trim(), file);
36: }
37: 
38: function counter(root: string, file: string, key: string): number {
39:   const lines = fs.readFileSync(path.join(root, file), 'utf8').trim().split('\n');
40:   const matches = lines.map(line => line.trim().split(/\s+/u)).filter(parts => parts[0] === key);
41:   if (matches.length !== 1 || matches[0]?.length !== 2) {
42:     throw new Error(`WORKER_NATIVE_COUNTER_MISSING:${file}:${key}`);
43:   }
44:   return unsigned(matches[0][1]!, `${file}:${key}`);
45: }
46: 
47: /**
48:  * Read an actual kernel scope without removing it. The caller owns scope
49:  * identity, launch fencing and quiescence; this reader grants no such authority.
50:  * Missing counters fail instead of becoming zero or sampled substitutes.
51:  */
52: export function observeNativeWorkerResources(scope: string): NativeWorkerResourceObservation {
53:   if (!path.isAbsolute(scope) || fs.statfsSync(scope).type !== CGROUP2_SUPER_MAGIC) {
54:     throw new Error('WORKER_NATIVE_CGROUP_REQUIRED');
55:   }
56:   const populated = counter(scope, 'cgroup.events', 'populated');
57:   if (populated !== 0 && populated !== 1) throw new Error('WORKER_NATIVE_POPULATED_INVALID');
58:   return {
59:     unit: 'linux-tasks',
60:     cpuTimeMicroseconds: counter(scope, 'cpu.stat', 'usage_usec'),
61:     maximumMemoryBytes: scalar(scope, 'memory.peak'),
62:     maximumTasks: scalar(scope, 'pids.peak'),
63:     populated: populated === 1,
64:     oomKills: counter(scope, 'memory.events', 'oom_kill'),
65:     taskLimitHits: counter(scope, 'pids.events', 'max'),
66:   };
67: }

SOURCE skills/worker/core/worker/native-resource-pool.ts SHA256 2a002b796bae216210186f258d32f5dd267ec10a4940f4d0fc2f12ea72bd93ee
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import { NativeWorkerResourceScope, type NativeWorkerScopeLimits } from './native-resource-scope.ts';
4: import { WorkerResourceReservations } from './resource-reservations.ts';
5: import { observeNativeWorkerResources } from './native-resource-observation.ts';
6: 
7: export interface NativeWorkerPoolLimits extends NativeWorkerScopeLimits {
8:   readonly cpuQuotaMicroseconds: number;
9:   readonly cpuPeriodMicroseconds: number;
10: }
11: 
12: /** Host setup owns configuration. Workers only verify the real aggregate boundary. */
13: export class NativeWorkerResourcePool {
14:   readonly #root: string;
15:   readonly #device: number;
16:   readonly #inode: number;
17:   readonly #limits: NativeWorkerPoolLimits;
18:   readonly #reservations: WorkerResourceReservations;
19: 
20:   constructor(root: string, limits: NativeWorkerPoolLimits, maximumScopes: number) {
21:     NativeWorkerResourceScope.inventory(root); // Reject substituted filesystems before any capacity claim.
22:     this.#root = fs.realpathSync(root);
23:     const stat = fs.statSync(this.#root);
24:     this.#device = stat.dev; this.#inode = stat.ino;
25:     this.#limits = Object.freeze({ ...limits });
26:     this.#reservations = new WorkerResourceReservations(limits, maximumScopes);
27:     if (!Number.isSafeInteger(limits.cpuQuotaMicroseconds) || limits.cpuQuotaMicroseconds < 1000
28:       || !Number.isSafeInteger(limits.cpuPeriodMicroseconds) || limits.cpuPeriodMicroseconds < 1000
29:       || limits.cpuPeriodMicroseconds > 1000000) throw new Error('WORKER_NATIVE_POOL_CPU_INVALID');
30:     this.verify();
31:   }
32: 
33:   verify(): void {
34:     const stat = fs.statSync(this.#root);
35:     if (stat.dev !== this.#device || stat.ino !== this.#inode || fs.statfsSync(this.#root).type !== 0x63677270) {
36:       throw new Error('WORKER_NATIVE_POOL_IDENTITY_CHANGED');
37:     }
38:     const values: Record<string, string> = {
39:       'memory.max': String(this.#limits.memoryBytes), 'memory.swap.max': '0',
40:       'pids.max': String(this.#limits.tasks),
41:       'cpu.max': `${this.#limits.cpuQuotaMicroseconds} ${this.#limits.cpuPeriodMicroseconds}`,
42:     };
43:     for (const [file, expected] of Object.entries(values)) {
44:       if (fs.readFileSync(path.join(this.#root, file), 'utf8').trim() !== expected) {
45:         throw new Error(`WORKER_NATIVE_POOL_LIMIT_MISMATCH:${file}`);
46:       }
47:     }
48:     if (fs.readFileSync(path.join(this.#root, 'cgroup.type'), 'utf8').trim() !== 'domain') {
49:       throw new Error('WORKER_NATIVE_POOL_DOMAIN_REQUIRED');
50:     }
51:     // Readiness must reject missing peak counters or a read-only kill boundary,
52:     // before an accepted attempt discovers those prerequisites during allocation.
53:     observeNativeWorkerResources(this.#root);
54:     fs.accessSync(path.join(this.#root, 'cgroup.kill'), fs.constants.W_OK);
55:     NativeWorkerResourceScope.inventory(this.#root);
56:     const after = fs.statSync(this.#root);
57:     if (after.dev !== this.#device || after.ino !== this.#inode) throw new Error('WORKER_NATIVE_POOL_IDENTITY_CHANGED');
58:   }
59: 
60:   reserve(limits: NativeWorkerScopeLimits): () => void {
61:     this.verify();
62:     return this.#reservations.reserve(limits);
63:   }
64: }

SOURCE skills/worker/core/worker/native-resource-scope.ts SHA256 f10a3700c82322b4f426f520c8bd01dde8bdbd45678f36fa7b88292f1f419e0c
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import { requireHierarchicalCgroupEvents } from './native-hierarchy-events.ts';
4: import { randomUUID } from 'node:crypto';
5: import type { WorkerOwnedChild } from './ownership-children.ts';
6: import { aggregateChildLimits, configureNativeLimits, createNativeChild, verifyNativeChild, verifyNativeChildren } from './native-owned-children.ts';
7: import { setTimeout as delay } from 'node:timers/promises';
8: import { performance } from 'node:perf_hooks';
9: import { observeNativeWorkerResources, type NativeWorkerResourceObservation } from './native-resource-observation.ts';
10: import type { WorkerScopeBinding } from './ownership-store.ts';
11: 
12: export interface NativeWorkerScopeLimits {
13:   readonly memoryBytes: number;
14:   readonly tasks: number;
15: }
16: 
17: const scopeNamePattern = /^worker-[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/u;
18: 
19: function delegatedRoot(rootValue: string): string {
20:   if (!path.isAbsolute(rootValue)) throw new Error('WORKER_NATIVE_ROOT_INVALID');
21:   const root = fs.realpathSync(rootValue);
22:   if (root === '/' || root === '/sys/fs/cgroup' || fs.statfsSync(root).type !== 0x63677270) {
23:     throw new Error('WORKER_NATIVE_ROOT_INVALID');
24:   }
25:   if (fs.readFileSync(path.join(root, 'cgroup.procs'), 'utf8').trim()) {
26:     throw new Error('WORKER_NATIVE_ROOT_POPULATED');
27:   }
28:   const controllers = fs.readFileSync(path.join(root, 'cgroup.subtree_control'), 'utf8').trim().split(/\s+/u);
29:   if (!['cpu', 'memory', 'pids'].every(controller => controllers.includes(controller))) {
30:     throw new Error('WORKER_NATIVE_ROOT_NOT_DELEGATED');
31:   }
32:   return root;
33: }
34: 
35: function bootId(): string {
36:   return fs.readFileSync('/proc/sys/kernel/random/boot_id', 'utf8').trim();
37: }
38: 
39: function positive(value: number): void {
40:   if (!Number.isSafeInteger(value) || value < 1) throw new Error('WORKER_NATIVE_LIMIT_INVALID');
41: }
42: 
43: /** A kernel scope, not an attempt/fixture registry or a process launcher. */
44: export class NativeWorkerResourceScope {
45:   readonly #path: string;
46:   readonly #device: number;
47:   readonly #inode: number;
48:   readonly #aggregate: boolean;
49:   #disposed = false;
50:   #quiescing = false;
51: 
52:   private constructor(scope: string, aggregate: boolean) {
53:     this.#aggregate = aggregate;
54:     this.#path = scope;
55:     const stat = fs.statSync(scope);
56:     this.#device = stat.dev;
57:     this.#inode = stat.ino;
58:   }
59: 
60:   /** The root is chosen by deployment, never by an attempt envelope. */
61:   static create(rootValue: string, limits: NativeWorkerScopeLimits): NativeWorkerResourceScope {
62:     positive(limits.memoryBytes);
63:     positive(limits.tasks);
64:     const root = delegatedRoot(rootValue);
65:     requireHierarchicalCgroupEvents(root);
66:     // Existing roots are never chmod/chowned, remounted or reconfigured here.
67:     const scope = path.join(root, `worker-${randomUUID()}`);
68:     fs.mkdirSync(scope);
69:     return NativeWorkerResourceScope.#configure(scope, limits);
70:   }
71: 
72:   /** Reservation is persisted before mkdir; no process may enter before binding is durable. */
73:   static createReserved(rootValue: string, scopeName: string, limits: NativeWorkerScopeLimits): NativeWorkerResourceScope {
74:     positive(limits.memoryBytes);
75:     positive(limits.tasks);
76:     if (!scopeNamePattern.test(scopeName)) throw new Error('WORKER_NATIVE_SCOPE_NAME_INVALID');
77:     const root = delegatedRoot(rootValue);
78:     requireHierarchicalCgroupEvents(root);
79:     const scope = path.join(root, scopeName);
80:     fs.mkdirSync(scope); // Exclusive. Never adopt a pre-existing directory during admission.
81:     return NativeWorkerResourceScope.#configure(scope, limits);
82:   }
83: 
84:   static #configure(scope: string, limits: NativeWorkerScopeLimits): NativeWorkerResourceScope {
85:     try {
86:       configureNativeLimits(scope, limits);
87:       fs.writeFileSync(path.join(scope, 'cgroup.subtree_control'), '+cpu +memory +pids');
88:       const enabled = fs.readFileSync(path.join(scope, 'cgroup.subtree_control'), 'utf8').trim().split(/\s+/u);
89:       if (!['cpu', 'memory', 'pids'].every(name => enabled.includes(name))) throw new Error('WORKER_NATIVE_CONTROLLERS_MISSING');
90:       fs.accessSync(path.join(scope, 'cgroup.kill'), fs.constants.W_OK);
91:       const owner = new NativeWorkerResourceScope(scope, true);
92:       if (owner.observe().populated) throw new Error('WORKER_NATIVE_SCOPE_NOT_EMPTY');
93:       return owner;
94:     } catch (cause) {
95:       try { fs.rmdirSync(scope); }
96:       catch (cleanup) { throw new AggregateError([cause, cleanup], 'WORKER_NATIVE_SETUP_CLEANUP_FAILED'); }
97:       throw cause;
98:     }
99:   }
100: 
101:   static inventory(rootValue: string): readonly string[] {
102:     return fs.readdirSync(delegatedRoot(rootValue), { withFileTypes: true })
103:       .filter(entry => entry.isDirectory()).map(entry => entry.name).sort();
104:   }
105: 
106:   /** Recovery before the durable launch fence: only an empty reservation can be adopted. */
107:   static recoverEmptyReservation(rootValue: string, scopeName: string, aggregate = false): NativeWorkerResourceScope {
108:     if (!scopeNamePattern.test(scopeName)) throw new Error('WORKER_NATIVE_SCOPE_NAME_INVALID');
109:     const scope = path.join(delegatedRoot(rootValue), scopeName);
110:     if (!fs.lstatSync(scope).isDirectory()) throw new Error('WORKER_NATIVE_SCOPE_BINDING_CHANGED');
111:     const owner = new NativeWorkerResourceScope(scope, aggregate);
112:     if (owner.observe().populated) throw new Error('WORKER_NATIVE_UNBOUND_SCOPE_POPULATED');
113:     return owner;
114:   }
115: 
116:   /** An inode alone can be reused across boots. Both identities must match. */
117:   static reopen(rootValue: string, binding: WorkerScopeBinding, aggregate = false): NativeWorkerResourceScope {
118:     if (!scopeNamePattern.test(binding.scopeName) || binding.bootId !== bootId()) {
119:       throw new Error('WORKER_NATIVE_SCOPE_BINDING_CHANGED');
120:     }
121:     const scope = path.join(delegatedRoot(rootValue), binding.scopeName);
122:     const stat = fs.lstatSync(scope);
123:     if (!stat.isDirectory() || stat.dev !== binding.device || stat.ino !== binding.inode) {
124:       throw new Error('WORKER_NATIVE_SCOPE_BINDING_CHANGED');
125:     }
126:     return new NativeWorkerResourceScope(scope, aggregate);
127:   }
128: 
129:   binding(): WorkerScopeBinding {
130:     this.#checkIdentity();
131:     return { scopeName: path.basename(this.#path), bootId: bootId(), device: this.#device, inode: this.#inode };
132:   }
133: 
134:   childLimits(requested?: NativeWorkerScopeLimits): NativeWorkerScopeLimits {
135:     this.#checkIdentity();
136:     return aggregateChildLimits(this.#path, requested);
137:   }
138: 
139:   createChild(child: WorkerOwnedChild): WorkerScopeBinding {
140:     this.#checkIdentity();
141:     if (this.#quiescing) throw new Error('WORKER_NATIVE_SCOPE_QUIESCING');
142:     return createNativeChild(this.#path, this.binding(), child);
143:   }
144: 
145:   /** The caller must persist the returned child binding before obtaining launch arguments. */
146:   childLaunchArguments(child: WorkerOwnedChild): readonly string[] {
147:     this.#checkIdentity();
148:     if (this.#quiescing) throw new Error('WORKER_NATIVE_SCOPE_QUIESCING');
149:     if (!child.binding) throw new Error('WORKER_NATIVE_CHILD_BINDING_REQUIRED');
150:     const target = verifyNativeChild(this.#path, this.binding(), child);
151:     return [target, String(this.#device), String(this.#inode), String(child.binding.device), String(child.binding.inode)];
152:   }
153: 
154:   verifyChildren(children: readonly WorkerOwnedChild[], removalStarted: boolean): void {
155:     this.#checkIdentity();
156:     verifyNativeChildren(this.#path, this.binding(), children, removalStarted);
157:   }
158: 
159:   disposeChildren(children: readonly WorkerOwnedChild[]): void {
160:     this.#checkIdentity();
161:     if (!this.#quiescing || this.observe().populated) throw new Error('WORKER_NATIVE_SCOPE_NOT_QUIESCENT');
162:     for (const target of verifyNativeChildren(this.#path, this.binding(), children, true)) fs.rmdirSync(target);
163:   }
164: 
165:   observe(): NativeWorkerResourceObservation {
166:     this.#checkIdentity();
167:     return observeNativeWorkerResources(this.#path);
168:   }
169: 
170:   /** Keep cumulative counters available until the caller seals its result. */
171:   async terminateAndDrain(timeoutMs: number, signal?: AbortSignal): Promise<NativeWorkerResourceObservation> {
172:     positive(timeoutMs);
173:     signal?.throwIfAborted();
174:     this.#checkIdentity();
175:     this.#quiescing = true;
176:     fs.writeFileSync(path.join(this.#path, 'cgroup.kill'), '1');
177:     const deadline = performance.now() + timeoutMs;
178:     for (;;) {
179:       signal?.throwIfAborted();
180:       const observation = this.observe();
181:       if (!observation.populated) return observation;
182:       const remaining = deadline - performance.now();
183:       if (remaining <= 0) throw new Error('WORKER_NATIVE_DRAIN_TIMEOUT');
184:       await delay(Math.min(10, remaining), undefined, signal ? { signal } : undefined);
185:     }
186:   }
187: 
188:   /** Disposal cannot stand in for confirmed termination or erase a live scope. */
189:   dispose(): void {
190:     if (this.#disposed) return;
191:     if (!this.#quiescing || this.observe().populated) throw new Error('WORKER_NATIVE_SCOPE_NOT_QUIESCENT');
192:     fs.rmdirSync(this.#path);
193:     this.#disposed = true;
194:   }
195: 
196:   #checkIdentity(): void {
197:     if (this.#disposed) throw new Error('WORKER_NATIVE_SCOPE_DISPOSED');
198:     if (this.#aggregate) requireHierarchicalCgroupEvents(this.#path);
199:     const stat = fs.lstatSync(this.#path);
200:     if (!stat.isDirectory() || stat.dev !== this.#device || stat.ino !== this.#inode) {
201:       throw new Error('WORKER_NATIVE_SCOPE_IDENTITY_CHANGED');
202:     }
203:   }
204: }

SOURCE skills/worker/core/worker/native-result.ts SHA256 11c8074a973fec8f764e64668e29c7d4907a5b9e605b6bad04cbfa0454d318bd
1: import { randomUUID } from 'node:crypto';
2: import { checkWorkerNativeResultBinding, initialWorkerNativeResourceAccounting, workerAttemptResultDigest, sha256Digest,
3:   type WorkerAttemptEnvelopeV3, type WorkerAttemptResultV3 } from '@kubeclaw/pipeline-worker-core-contract';
4: import { validateNativeWorkerResourceObservation, type NativeWorkerResourceObservation } from './native-resource-observation.ts';
5: import type { NativeWorkerProcessResult } from './native-worker-process.ts';
6: 
7: export function finalizeNativeWorkerResult(envelope: WorkerAttemptEnvelopeV3, process: NativeWorkerProcessResult,
8:   started: Date, completed: Date): WorkerAttemptResultV3 {
9:   const candidate = provisionalResult(envelope, process);
10:   const result = candidate.result ?? failedHostResult(envelope, started, completed, process.fault ?? candidate.fault!, false);
11:   if (!candidate.result) { result.exitCode = process.exitCode; result.signal = process.signal; }
12:   applyNativeObservation(result, process.resources);
13:   const fault = process.fault ?? (completed.getTime() >= Date.parse(envelope.claim.expiresAt) ? 'WORKER_CLAIM_EXPIRED' : null);
14:   if (fault && result.state === 'completed') {
15:     result.state = 'errored'; result.error = { code: fault, message: fault }; result.summary = fault;
16:     result.specialistResult = null; result.resources.resultBytes = 0;
17:   }
18:   result.startedAt = started.toISOString();
19:   result.completedAt = completed.toISOString();
20:   result.durationMs = Math.max(0, completed.getTime() - started.getTime());
21:   return sealResult(envelope, result);
22: }
23: 
24: export function interruptedNativeWorkerResult(envelope: WorkerAttemptEnvelopeV3, started: Date, code: string,
25:   observation: NativeWorkerResourceObservation | null, notLaunched: boolean): WorkerAttemptResultV3 {
26:   const result = failedHostResult(envelope, started, new Date(), code, notLaunched);
27:   if (observation !== null) applyNativeObservation(result, observation);
28:   return sealResult(envelope, result);
29: }
30: 
31: function applyNativeObservation(result: WorkerAttemptResultV3, observation: NativeWorkerResourceObservation): void {
32:   validateNativeWorkerResourceObservation(observation);
33:   if (observation.populated) throw new Error('WORKER_NATIVE_RESULT_SCOPE_POPULATED');
34:   result.resources.cpuTimeMs = Math.ceil(observation.cpuTimeMicroseconds / 1000);
35:   result.resources.maximumMemoryBytes = observation.maximumMemoryBytes;
36:   result.resources.maximumTasks = observation.maximumTasks;
37:   result.resourceAccounting.observations = {
38:     cpuTimeMs: { status: 'observed', value: result.resources.cpuTimeMs },
39:     maximumMemoryBytes: { status: 'observed', value: observation.maximumMemoryBytes },
40:     maximumTasks: { status: 'observed', value: observation.maximumTasks },
41:   };
42: }
43: 
44: function sealResult(envelope: WorkerAttemptEnvelopeV3, result: WorkerAttemptResultV3): WorkerAttemptResultV3 {
45:   result.resultDigest = workerAttemptResultDigest(result);
46:   const receiptId = `receipt:${randomUUID()}`;
47:   result.receipt = { receiptId, receiptDigest: sha256Digest({ namespace: 'native-worker', receiptId, resultDigest: result.resultDigest }) };
48:   const binding = checkWorkerNativeResultBinding(envelope, result);
49:   if (!binding.ok) throw new Error(`WORKER_NATIVE_FINAL_RESULT_INVALID:${binding.errors.join(';')}`);
50:   return result;
51: }
52: 
53: function provisionalResult(envelope: WorkerAttemptEnvelopeV3, process: NativeWorkerProcessResult): { result: WorkerAttemptResultV3 | null; fault: string | null } {
54:   try {
55:     const result = JSON.parse(Buffer.from(process.stdout).toString('utf8')) as WorkerAttemptResultV3;
56:     return checkWorkerNativeResultBinding(envelope, result).ok ? { result, fault: null }
57:       : { result: null, fault: 'WORKER_NATIVE_RESULT_BINDING_INVALID' };
58:   } catch (error) {
59:     if (!(error instanceof SyntaxError)) throw error;
60:     return { result: null, fault: 'WORKER_NATIVE_RESULT_INVALID_JSON' };
61:   }
62: }
63: 
64: function failedHostResult(envelope: WorkerAttemptEnvelopeV3, started: Date, completed: Date, code: string,
65:   notLaunched: boolean): WorkerAttemptResultV3 {
66:   return { schemaVersion: 'worker-attempt-result.v3', protocolVersion: envelope.protocolVersion, attemptId: envelope.attemptId,
67:     claimId: envelope.claim.claimId, claimGeneration: envelope.claim.generation, workerId: envelope.claim.workerId,
68:     profileDigest: envelope.profile.profileDigest, attemptSpecDigest: envelope.attemptSpecDigest,
69:     state: 'errored', startedAt: started.toISOString(), completedAt: completed.toISOString(), durationMs: Math.max(0, completed.getTime() - started.getTime()),
70:     summary: code, specialistResult: null, error: { code, message: code }, evidence: [],
71:     resources: { logBytes: 0, resultBytes: 0, evidenceBytes: 0 },
72:     cleanup: notLaunched ? { state: 'not_required', summary: null }
73:       : { state: 'failed', summary: 'Native host has no validated specialist cleanup result; external effects require reconciliation' },
74:     exitCode: null, signal: null, resourceAccounting: initialWorkerNativeResourceAccounting(envelope),
75:     resultDigest: '', receipt: { receiptId: '', receiptDigest: '' },
76:   };
77: }

SOURCE skills/worker/core/worker/native-runtime-identity.ts SHA256 4bb8600bf48477411e75148e6edbd0dae345809316d60a3d3cd4b8ad6f8a057e
1: import fs from 'node:fs';
2: import path from 'node:path';
3: 
4: interface RuntimeIdentity {
5:   schemaVersion: 1;
6:   bootId: string;
7:   cgroupNamespace: { device: string; inode: string };
8: }
9: 
10: /** Compare the actual namespace with root-managed host evidence; never enter a namespace here. */
11: export function requireNativeWorkerRuntimeIdentity(file: string): void {
12:   if (!path.isAbsolute(file)) throw new Error('WORKER_NATIVE_RUNTIME_IDENTITY_PATH_REQUIRED');
13:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
14:   try {
15:     const stat = fs.fstatSync(fd);
16:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0 || stat.size < 1 || stat.size > 4096) {
17:       throw new Error('WORKER_NATIVE_RUNTIME_IDENTITY_NOT_TRUSTED');
18:     }
19:     const identity = JSON.parse(fs.readFileSync(fd, 'utf8')) as RuntimeIdentity;
20:     const bootId = fs.readFileSync('/proc/sys/kernel/random/boot_id', 'utf8').trim();
21:     const namespace = fs.statSync('/proc/self/ns/cgroup', { bigint: true });
22:     if (identity?.schemaVersion !== 1 || identity.bootId !== bootId
23:       || identity.cgroupNamespace?.device !== String(namespace.dev)
24:       || identity.cgroupNamespace?.inode !== String(namespace.ino)) {
25:       throw new Error('WORKER_NATIVE_HOST_CGROUP_NAMESPACE_REQUIRED');
26:     }
27:   } finally { fs.closeSync(fd); }
28: }

SOURCE skills/worker/core/worker/native-supervisor-authority.ts SHA256 2a710c00d935777144fc2055e435f1610bc66a01976a002047de751862e18650
1: import fs from 'node:fs';
2: import path from 'node:path';
3: 
4: /** These are the same narrowly scoped privileges required by the non-setuid launcher. */
5: export function requireNativeWorkerSupervisorAuthority(): void {
6:   const capabilities = /^CapEff:\s*([a-f0-9]+)$/mu.exec(fs.readFileSync('/proc/self/status', 'utf8'))?.[1];
7:   const required = (1n << 5n) | (1n << 6n) | (1n << 7n); // KILL, SETGID, SETUID
8:   if (process.getuid?.() !== 0 || process.geteuid?.() !== 0 || !capabilities
9:     || (BigInt(`0x${capabilities}`) & required) !== required) throw new Error('WORKER_NATIVE_SUPERVISOR_AUTHORITY_REQUIRED');
10: }
11: 
12: /** Only an immutable-image, root-owned ordinary executable is accepted; never a setuid helper. */
13: export function requireNativeWorkerLauncher(file: string): void {
14:   if (!path.isAbsolute(file) || fs.realpathSync(file) !== file) throw new Error('WORKER_NATIVE_LAUNCHER_PATH_INVALID');
15:   const fd = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
16:   try {
17:     const stat = fs.fstatSync(fd);
18:     if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o6022) !== 0 || (stat.mode & 0o100) === 0) {
19:       throw new Error('WORKER_NATIVE_LAUNCHER_NOT_TRUSTED');
20:     }
21:   } finally { fs.closeSync(fd); }
22: }

