17: /** Immutable image entrypoints, fixed identity and own-gate filesystem authority. */
18: export function preparationCommand(admissionId: string, settings: BusterPreparationSettings,
19:   config: PreparationCommandConfig, preparationUid: PreparationSlot, phase: 'prepare' | 'historical' | 'cleanup' = 'prepare') {
20:   assertPreparationSlot(preparationUid);
21:   const directory = preparationSourceDirectory(config.sourceRoot, admissionId);
22:   const gate = path.dirname(directory);
23:   const sandbox = fileURLToPath(new URL('../../../common/plugin-runtime/foundation/isolation/plugin-sandbox', import.meta.url));
24:   const hostFiles = { prepare: './preparation-host.ts', historical: './preparation-historical-host.ts',
25:     cleanup: './preparation-cleanup-host.ts' } as const;
26:   const host = fileURLToPath(new URL(hostFiles[phase], import.meta.url));
27:   const app = fileURLToPath(new URL('../../../../', import.meta.url));
28:   const readRoots = [app, '/usr', '/lib', '/lib64', '/etc/ssl', '/proc', config.cgroupRoot]
29:     .filter(root => fs.existsSync(root));
30:   if (!readRoots.includes(config.cgroupRoot)) throw new Error('BUSTER_PREPARATION_CGROUP_ROOT_MISSING');
31:   for (const root of readRoots) {
32:     const real = fs.realpathSync(root);
33:     if (real === config.sourceRoot || config.sourceRoot.startsWith(`${real}${path.sep}`)) {
34:       throw new Error('BUSTER_PREPARATION_SOURCE_ANCESTOR_READ_FORBIDDEN');
35:     }
36:   }
37:   return { launcher: config.launcher, uid: preparationUid, gid: preparationUid, executable: sandbox,
38:     arguments: [String(settings.resourcePolicy.memoryBytes), String(Math.max(1, Math.ceil(settings.resourcePolicy.cpuTimeMs / 1000))),
39:       String(settings.maximumOpenFiles), ...readRoots.flatMap(root => ['--read-root', root]),
40:       '--write-root', gate, process.execPath, host],
41:     cwd: gate,
42:     environment: {
43:       PATH: '/usr/local/bin:/usr/bin:/bin', HOME: gate, TMPDIR: gate, NODE_ENV: 'production',
44:       BUSTER_PREPARATION_ASSIGNED_INPUT_BYTES: String(settings.maximumInputBytes),
45:       BUSTER_PREPARATION_ASSIGNED_SOURCE_ROOT: config.sourceRoot,
46:       BUSTER_PREPARATION_ASSIGNED_TAR: config.tarExecutable,
47:       BUSTER_PREPARATION_ASSIGNED_SOURCE_AUTHORITY: config.trustedSourceAuthority,
48:       BUSTER_PREPARATION_ASSIGNED_SOURCE_PUBLIC_KEY: config.sourceAttestationPublicKey,
49:     },
50:   };
51: }

SOURCE skills/buster/engine/test-gates/preparation-config.ts SHA256 f2b088c3fef62010e6d867f6610ccc2392fdb7d6fa6be2bd43ad8e320d099835
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import { fileURLToPath } from 'node:url';
4: import { createPublicKey } from 'node:crypto';
5: import { readNativeWorkerNodeIdentity, readNativeWorkerPoolPolicy, requireNativeWorkerRuntimeIdentity,
6:   requireNativeWorkerLauncher } from '@kubeclaw/worker-core';
7: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
8: 
9: export const preparationStateRoot = '/var/lib/buster-v2/plan-jobs';
10: export const preparationSourceRoot = '/var/lib/buster-v2/native-sources';
11: export const preparationRuntimeConfig = '/run/kubeclaw-buster/config/runtime.json';
12: 
13: /** The root parent reads only bounded immutable configuration; it never constructs providers. */
14: export function nativeBusterPreparationConfig(settings: BusterPreparationSettings, environment: NodeJS.ProcessEnv) {
15:   const poolFile = environment.BUSTER_NATIVE_POOL_POLICY_FILE;
16:   if (!poolFile) throw new Error('BUSTER_NATIVE_POOL_POLICY_REQUIRED');
17:   const pool = readNativeWorkerPoolPolicy(poolFile, 'buster');
18:   requireNativeWorkerRuntimeIdentity(pool.runtimeIdentityFile);
19:   if (pool.limits.memoryBytes < settings.resourcePolicy.memoryBytes || pool.limits.tasks < settings.resourcePolicy.tasks
20:     || pool.maximumActiveScopes < settings.maximumActivePreparations) throw new Error('BUSTER_NATIVE_POOL_CAPACITY_INVALID');
21:   const engineContentDigest = environment.BUSTER_ENGINE_CONTENT_DIGEST;
22:   if (!/^sha256:[a-f0-9]{64}$/u.test(engineContentDigest ?? '')) throw new Error('BUSTER_NATIVE_ENGINE_IDENTITY_REQUIRED');
23:   const launcher = '/usr/local/libexec/kubeclaw-native-worker-launcher';
24:   requireNativeWorkerLauncher(launcher);
25:   requireNativeWorkerLauncher(process.execPath);
26:   requireNativeWorkerLauncher(fileURLToPath(new URL('../../../common/plugin-runtime/foundation/isolation/plugin-sandbox', import.meta.url)));
27:   const runtime = readRootConfiguration(settings.maximumInputBytes);
28:   const publicKeyName = runtime.sourceAttestationPublicKeyEnvironmentVariable;
29:   if (typeof publicKeyName !== 'string' || !/^[A-Z][A-Z0-9_]*$/u.test(publicKeyName)
30:     || typeof runtime.trustedSourceAuthority !== 'string' || !runtime.trustedSourceAuthority) throw new Error('BUSTER_SOURCE_ATTESTATION_CONFIG_INVALID');
31:   const sourceAttestationPublicKey = environment[publicKeyName];
32:   if (!sourceAttestationPublicKey || createPublicKey(sourceAttestationPublicKey).asymmetricKeyType !== 'ed25519') {
33:     throw new Error('BUSTER_SOURCE_ATTESTATION_CONFIG_INVALID');
34:   }
35:   if ((runtime.stateRoot !== preparationStateRoot || runtime.runtimeRoot !== '/var/lib/buster-v2/runs')) throw new Error('BUSTER_NATIVE_STATE_ROOT_INVALID');
36:   return Object.freeze({ pool, launcher, engineContentDigest: engineContentDigest!, sourceAttestationPublicKey,
37:     trustedSourceAuthority: runtime.trustedSourceAuthority, stateRoot: runtime.stateRoot,
38:     nodeIdentity: readNativeWorkerNodeIdentity(pool.nodeIdentityFile), tarExecutable: '/usr/bin/tar' });
39: }
40: 
41: function readRootConfiguration(maximumBytes: number): Record<string, unknown> {
42:   let current = '/';
43:   for (const component of path.dirname(preparationRuntimeConfig).split('/').filter(Boolean)) {
44:     current = path.join(current, component);
45:     const stat = fs.lstatSync(current);
46:     if (!stat.isDirectory() || stat.uid !== 0 || (stat.mode & 0o022) !== 0) throw new Error('BUSTER_NATIVE_CONFIG_ANCESTOR_INVALID');
47:   }
48:   const fd = fs.openSync(preparationRuntimeConfig, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW);
49:   try {
50:     const stat = fs.fstatSync(fd);
51:     if (!stat.isFile() || stat.uid !== 0 || stat.nlink !== 1 || (stat.mode & 0o022) !== 0 || stat.size > maximumBytes) {
52:       throw new Error('BUSTER_NATIVE_CONFIG_NOT_TRUSTED');
53:     }
54:     const value: unknown = JSON.parse(fs.readFileSync(fd, 'utf8'));
55:     if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('BUSTER_NATIVE_CONFIG_INVALID');
56:     return value as Record<string, unknown>;
57:   } finally { fs.closeSync(fd); }
58: }
59: 
60: /** ConfigMap symlinks may resolve only through root-controlled immutable ancestry. */
61: export function requireRootBusterSettings(environment: NodeJS.ProcessEnv): void {
62:   const file = environment.SWARM_CONFIG;
63:   if (!file || !path.isAbsolute(file) || path.resolve(file) !== file) throw new Error('BUSTER_NATIVE_SWARM_CONFIG_REQUIRED');
64:   for (const candidate of [path.dirname(file), path.dirname(fs.realpathSync(file))]) {
65:     let current = '/';
66:     for (const component of candidate.split('/').filter(Boolean)) {
67:       current = path.join(current, component);
68:       const stat = fs.lstatSync(current);
69:       if (!stat.isDirectory() || stat.uid !== 0 || (stat.mode & 0o022) !== 0) {
70:         throw new Error('BUSTER_NATIVE_SWARM_CONFIG_NOT_TRUSTED');
71:       }
72:     }
73:   }
74:   const stat = fs.statSync(file);
75:   if (!stat.isFile() || stat.uid !== 0 || (stat.mode & 0o022) !== 0) {
76:     throw new Error('BUSTER_NATIVE_SWARM_CONFIG_NOT_TRUSTED');
77:   }
78: }

