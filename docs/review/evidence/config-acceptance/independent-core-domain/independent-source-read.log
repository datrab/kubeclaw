211: export class WorkerAttemptExecutor<E extends WorkerAttemptEnvelope = WorkerAttemptEnvelopeV1> {
212:   readonly #options: WorkerAttemptExecutorOptions<E>;
213:   readonly #accounting: WorkerResourceAccounting | WorkerNativeResourceAccounting | undefined;
214:   readonly #now: () => Date;
215:   readonly #id: () => string;
216:   #progressSequence = 0;
217:   #logSequence = 0;
218:   #execution: Promise<WorkerAttemptResult> | null = null;
219: 
220:   constructor(options: WorkerAttemptExecutorOptions<E>) {
221:     preflightJson(options.envelope, MAX_ATTEMPT_ENVELOPE_BYTES, 'WORKER_ATTEMPT_INPUT');
222:     const envelope = freeze(structuredClone(options.envelope));
223:     validateEnvelopeDigests(envelope);
224:     if (envelope.limits.logBytes > MAX_ATTEMPT_LOG_BYTES) throw new Error('WORKER_LOG_LIMIT_INVALID');
225:     if (options.receiptNamespace !== undefined
226:       && (options.receiptNamespace.length === 0 || options.receiptNamespace.length > 4096
227:         || options.receiptNamespace !== options.receiptNamespace.toWellFormed())) {
228:       throw new Error('WORKER_RECEIPT_NAMESPACE_INVALID');
229:     }
230:     this.#options = { ...options, envelope };
231:     this.#accounting=envelope.schemaVersion==='worker-attempt-envelope.v3'?initialWorkerNativeResourceAccounting(envelope)
232:       :envelope.schemaVersion==='worker-attempt-envelope.v2'?initialWorkerResourceAccounting(envelope):undefined;
233:     this.#now = options.now ?? (() => new Date());
234:     this.#id = options.id ?? (() => crypto.randomUUID());
235:   }
236: 
237:   async execute(): Promise<WorkerResultFor<E>> {
238:     this.#execution ??= this.#executeOnce();
239:     return this.#execution as Promise<WorkerResultFor<E>>;
240:   }
241: 
242:   async #executeOnce(): Promise<WorkerAttemptResult> {
243:     const { envelope, operation } = this.#options;
244:     const started = this.#now();
245:     if (started.getTime() >= Date.parse(envelope.queueDeadline)) {
246:       // No operation is prepared or started after queue expiry. Zero resource
247:       // use is authoritative here; calling the adapter would violate that rule.
248:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_QUEUE_DEADLINE_EXPIRED'), null, [], {
249:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
250:       }, { state: 'not_required', summary: null });
251:     }
252:     if (started.getTime() >= Date.parse(envelope.claim.expiresAt)) {
253:       // An expired claim owns no work. Do not touch the operation adapter.
254:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_CLAIM_EXPIRED'), null, [], {
255:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
256:       }, { state: 'not_required', summary: null });
257:     }
258:     if (started.getTime() < Date.parse(envelope.claim.claimedAt)) {
259:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_CLAIM_NOT_ACTIVE'), null, [], {
260:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
261:       }, { state: 'not_required', summary: null });
262:     }
263:     const completionPhases = 3 + Number(Boolean(operation.cleanup)) + Number(Boolean(operation.collectEvidence))
264:       + Number(this.#options.retainLogs !== false && Boolean(this.#options.storeFullLog)) + Number(Boolean(operation.finalizeResult));
265:     const requiredClaimWindow = envelope.limits.timeoutMs + (completionPhases * envelope.limits.cleanupTimeoutMs);
266:     if (Date.parse(envelope.claim.expiresAt) - started.getTime() < requiredClaimWindow) {
267:       // The local executor cannot renew a claim. It starts only when the claim
268:       // covers execution, termination, both measurements and every configured completion hook.
269:       return this.#result(started, started, new AttemptFault('interrupted', 'WORKER_CLAIM_WINDOW_INSUFFICIENT'), null, [], {
270:         logBytes: 0, resultBytes: 0, evidenceBytes: 0,
271:       }, { state: 'not_required', summary: null });
272:     }
273: 
274:     const unsupportedBudget = unsupportedWorkerBudget(envelope);
275:     if (unsupportedBudget) return this.#result(started, started,
276:       new AttemptFault('errored', 'WORKER_RESOURCE_MEASUREMENT_UNAVAILABLE', `Requested ${unsupportedBudget} has no declared measurement capability`),
277:       null, [], {logBytes: 0, resultBytes: 0, evidenceBytes: 0}, {state: 'not_required', summary: null});
278:     const controller = new AbortController();
279:     const logParts: WorkerLogPartV1[] = [];
280:     const decoder = new WorkerLogDecoder(envelope.limits.logBytes);
281:     let logPartCount = 0;
282:     let logBytes = 0;
283:     let logClosed = false;
284:     let logFault: AttemptFault | null = null;
285:     let timedOut = false;
286:     let claimExpired = false;
287:     let timer: NodeJS.Timeout | undefined;
288:     let termination: Promise<string | null> | null = null;
289:     const terminate = (): Promise<string | null> => {
290:       termination ??= this.#terminate(operation, envelope.limits.cleanupTimeoutMs);
291:       return termination;
292:     };
293:     const abort = (): void => {
294:       controller.abort(this.#options.signal?.reason ?? new Error('WORKER_ATTEMPT_CANCELLED'));
295:       void terminate();
296:     };
297:     this.#options.signal?.addEventListener('abort', abort, { once: true });
298:     if (this.#options.signal?.aborted) abort();
299:     const log: WorkerAttemptContext['log'] = (stream, value) => {
300:       if (logClosed || logFault) return;
301:       let text: string;
302:       try { text = decoder.decode(stream, value); }
303:       catch (error) { logFault = new AttemptFault('errored', detail(error)); controller.abort(logFault); void terminate(); return; }
304:       if (!text && typeof value !== 'string') return;
305:       let offset = 0;
306:       do {
307:         if (logPartCount >= MAX_ATTEMPT_LOG_PARTS) {
308:           logFault = new AttemptFault('errored', 'WORKER_LOG_LIMIT');
309:           controller.abort(logFault);
310:           void terminate();
311:           return;
312:         }
313:         logPartCount += 1;
314:         let end = Math.min(offset + 65_536, text.length);
315:         if (end < text.length && end > offset && /[\uD800-\uDBFF]/u.test(text[end - 1]!)) end -= 1;
316:         const chunk = text.slice(offset, end);
317:         const rendered = `[${stream}] ${chunk}`;
318:         logBytes += Buffer.byteLength(rendered);
319:         if (logBytes > envelope.limits.logBytes) {
320:           logFault = new AttemptFault('errored', 'WORKER_LOG_LIMIT');
321:           controller.abort(logFault);
322:           void terminate();
323:           return;
324:         }
325:         if (this.#options.retainLogs === false) {
326:           offset = end;
327:           continue;
328:         }
329:         const part = freeze({
330:           schemaVersion: 'worker-log-part.v1' as const,
331:           protocolVersion: envelope.protocolVersion,
332:           attemptId: envelope.attemptId,
333:           claimId: envelope.claim.claimId,
334:           claimGeneration: envelope.claim.generation,
335:           workerId: envelope.claim.workerId,
336:           sequence: this.#logSequence++,
337:           stream,
338:           text: chunk,
339:           contentDigest: sha256Text(chunk),
340:           final: false,
341:           sentAt: this.#now().toISOString(),
342:         });
343:         validatePipelineWorkerCoreContract('workerLogPart', part);
344:         logParts.push(part);
345:         try {
346:           void Promise.resolve(this.#options.onLogPart?.(part)).catch(() => undefined);
347:         } catch {
348:           // Live delivery is best effort. The full log is stored before completion.
349:         }
350:         offset = end;
351:       } while (offset < text.length);
352:     };
353: 
354:     let operationResult: WorkerAttemptOperationResult | null = null;
355:     let operationWork: Promise<WorkerAttemptOperationResult> | undefined;
356:     let executionUnresolved = false;
357:     let fault: AttemptFault | null = null;
358:     let cleanup: WorkerAttemptResultV1['cleanup'] = { state: 'not_required', summary: null };
359:     const timeoutAt = started.getTime() + envelope.limits.timeoutMs;
360:     const claimExpiresAt = Date.parse(envelope.claim.expiresAt);
361:     const phases = new WorkerPhaseDeadline(claimExpiresAt, envelope.limits.cleanupTimeoutMs, () => this.#now().getTime(), this.#options.signal);
362:     const clearClaimTimer = armWorkerClaimDeadline(claimExpiresAt, () => this.#now().getTime(), () => {
363:       claimExpired = true; controller.abort(new Error('WORKER_CLAIM_EXPIRED')); void terminate();
364:     });
365:     const deadlineAt = Math.min(timeoutAt, claimExpiresAt);
366:     timer = setTimeout(() => {
367:       claimExpired = claimExpiresAt <= timeoutAt;
368:       timedOut = !claimExpired;
369:       controller.abort(new Error(claimExpired ? 'WORKER_CLAIM_EXPIRED' : 'WORKER_ATTEMPT_TIMEOUT'));
370:       void terminate();
371:     }, Math.max(1, deadlineAt - started.getTime()));
372:     const cancellation = new Promise<never>((_resolve, reject) => {
373:       const rejectCancellation = (): void => {
374:         if (logFault) reject(logFault);
375:         else if (claimExpired) reject(new AttemptFault('interrupted', 'WORKER_CLAIM_EXPIRED'));
376:         else if (timedOut) reject(new AttemptFault('timed_out', 'WORKER_ATTEMPT_TIMEOUT'));
377:         else reject(new AttemptFault('cancelled', 'WORKER_ATTEMPT_CANCELLED'));
378:       };
379:       controller.signal.addEventListener('abort', rejectCancellation, { once: true });
380:     });
381:     try {
382:       if (controller.signal.aborted) throw new AttemptFault('cancelled', 'WORKER_ATTEMPT_CANCELLED');
383:       this.#progress('accepted', 'Attempt accepted.');
384:       this.#progress('started', 'Attempt started.');
385:       const preparationResult = operation.prepare(envelope.limits) as unknown;
386:       if (preparationResult !== undefined) {
387:         if ((typeof preparationResult === 'object' && preparationResult !== null)
388:           || typeof preparationResult === 'function') {
389:           try {
390:             const then = Reflect.get(preparationResult, 'then');
391:             if (typeof then === 'function') void Promise.resolve(preparationResult).catch(() => undefined);
392:           } catch {
393:             // The invalid return is rejected below. A hostile then getter cannot escape.
394:           }
395:         }
396:         throw new AttemptFault('errored', 'WORKER_PREPARATION_INVALID');
397:       }
398:       const preparedAt = this.#now().getTime();
399:       const queueDeadlineAt = Date.parse(envelope.queueDeadline);
400:       const firstDeadlineAt = Math.min(queueDeadlineAt, timeoutAt, claimExpiresAt);
401:       if (preparedAt >= firstDeadlineAt) {
402:         if (queueDeadlineAt === firstDeadlineAt) {
403:           throw new AttemptFault('interrupted', 'WORKER_QUEUE_DEADLINE_EXPIRED');
