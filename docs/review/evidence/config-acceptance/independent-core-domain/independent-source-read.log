82: async function kubectl(executable: string, args: readonly string[], timeoutMs: number, policy: BusterRuntimeSecuritySettings,
83:   signal: AbortSignal): Promise<Buffer> {
84:   return await new Promise<Buffer>((resolve, reject) => {
85:     const controller = new AbortController();
86:     const combined = AbortSignal.any([signal, controller.signal]);
87:     const child = spawn(executable, [...args], { signal: combined, stdio: ['ignore', 'pipe', 'pipe'],
88:       env: { PATH: policy.executableSearchPath.join(path.delimiter), ...kubernetesCredentialEnvironment(), LANG: 'C.UTF-8', LC_ALL: 'C.UTF-8' } });
89:     const stdout: Buffer[] = []; const stderr: Buffer[] = []; let bytes = 0; let settled = false;
90:     const timer = setTimeout(() => controller.abort(), timeoutMs);
91:     const finish = (error?: Error, output?: Buffer): void => {
92:       if (settled) return; settled = true; clearTimeout(timer); error ? reject(error) : resolve(output!);
93:     };
94:     const collect = (target: Buffer[]) => (chunk: Buffer): void => {
95:       bytes += chunk.byteLength;
96:       if (bytes > policy.maximumOutputBytes) { finish(new Error('KUBERNETES_RUNTIME_SECURITY_OUTPUT_LIMIT_EXCEEDED')); controller.abort(); }
97:       else target.push(Buffer.from(chunk));
98:     };
99:     child.stdout.on('data', collect(stdout)); child.stderr.on('data', collect(stderr));
100:     child.on('error', (error) => finish(signal.aborted ? new Error('KUBERNETES_RUNTIME_SECURITY_CANCELLED')
101:       : controller.signal.aborted ? new Error('KUBERNETES_RUNTIME_SECURITY_TIMEOUT')
102:         : new Error('KUBERNETES_RUNTIME_SECURITY_EXECUTION_FAILED', { cause: error })));
103:     child.on('close', (code, childSignal) => {
104:       if (settled) return;
105:       if (signal.aborted) return finish(new Error('KUBERNETES_RUNTIME_SECURITY_CANCELLED'));
106:       if (controller.signal.aborted) return finish(new Error('KUBERNETES_RUNTIME_SECURITY_TIMEOUT'));
107:       if (code !== 0 || childSignal) return finish(new Error(`KUBERNETES_RUNTIME_SECURITY_EXECUTION_FAILED:${Buffer.concat(stderr).toString('utf8').slice(0, policy.diagnosticCodeUnits)}`));
108:       finish(undefined, Buffer.concat(stdout));
109:     });
110:   });
111: }
112: 
113: function runtimeSecuritySnapshot(lease: JsonObject, namespace: string): JsonObject | null {
114:   const status = object(lease.status);
115:   if (status.namespaceName !== namespace || object(lease.spec).namespaceName !== namespace) {
116:     throw new Error('KUBERNETES_RUNTIME_SECURITY_LEASE_MISMATCH');
117:   }
118:   return status.runtimeSecurity && typeof status.runtimeSecurity === 'object'
119:     && !Array.isArray(status.runtimeSecurity) ? object(status.runtimeSecurity) : null;
120: }
121: 
122: function observationMatches(snapshot: JsonObject | null, digest: string, immutableImage: string,
123:   policy: BusterRuntimeSecuritySettings): snapshot is JsonObject {
124:   return snapshot?.phase === 'Observed' && snapshot.manifestDigest === digest
125:     && snapshot.immutableImage === immutableImage && Array.isArray(snapshot.findings)
126:     && Number.isSafeInteger(snapshot.podCount) && Number(snapshot.podCount) > 0
127:     && Number.isSafeInteger(snapshot.serviceCount) && Number(snapshot.serviceCount) > 0
128:     && runtimeSecurityObservationHasValidAccounting(snapshot)
129:     && runtimeSecurityObservationIsFresh(snapshot.observedAt, Date.now(), policy.maximumObservationAgeMs, policy.maximumFutureSkewMs)
130:     && typeof snapshot.resultDigest === 'string' && /^sha256:[a-f0-9]{64}$/u.test(snapshot.resultDigest);
131: }
