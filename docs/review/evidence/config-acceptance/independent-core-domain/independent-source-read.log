100:   identity();
101:   runtimeIdentity();
102:   fs.writeFileSync(`${root}/cgroup.subtree_control`, required.map(controller => `+${controller}`).join(' '));
103:   for (const [role, pool] of Object.entries(policy.pools)) {
104:     if (existing.has(role)) continue;
105:     const directory = `${root}/${role}`;
106:     fs.mkdirSync(directory);
107:     for (const [file, value] of Object.entries(controls(pool))) fs.writeFileSync(`${directory}/${file}`, value);
108:     fs.writeFileSync(`${directory}/cgroup.subtree_control`, required.map(controller => `+${controller}`).join(' '));
109:     verifyExisting(role, pool);
110:   }
111:   prepareBrowser();
112:   process.stdout.write('NATIVE_HOST_POOLS_PREPARED_NODE_CAPACITY_PREFLIGHT_REQUIRED\n');
113: }
114: 
115: function prepareBrowser() {
116:   // Browser delegation must never chown the role pool itself: its limits and
117:   // ownership belong to the host. Descendants remain bounded by that pool.
118:   const browser = `${root}/buster/browser`;
119:   if (!fs.existsSync(browser)) fs.mkdirSync(browser);
120:   if (fs.lstatSync(browser).isSymbolicLink() || fs.statfsSync(browser).type !== 0x63677270
121:     || read(`${browser}/cgroup.procs`)) throw new Error('NATIVE_BROWSER_SUBTREE_INVALID');
122:   fs.writeFileSync(`${browser}/cgroup.subtree_control`, required.map(controller => `+${controller}`).join(' '));
123: }
124: 
125: export function requireRunningPoolService(facts) {
126:   if (facts.uid !== 0 || facts.subState !== 'running'
127:     || facts.controlGroup !== root.slice('/sys/fs/cgroup'.length)
128:     || !Number.isSafeInteger(facts.mainPid) || facts.mainPid <= 0
129:     || !facts.mainCgroup.split('\n').includes(`0::${root.slice('/sys/fs/cgroup'.length)}/setup`)
130:     || !facts.hostNamespaceMatches) throw new Error('NATIVE_BROWSER_RUNNING_POOL_REQUIRED');
131: }
132: 
133: function prepareBrowserOnly(policy) {
134:   const show = key => execFileSync('systemctl', ['show', 'kubeclaw-native-pools.service', '-p', key, '--value'], {encoding:'utf8'}).trim();
135:   const mainPid = Number(show('MainPID'));
136:   if (!Number.isSafeInteger(mainPid) || mainPid <= 0) throw new Error('NATIVE_BROWSER_RUNNING_POOL_REQUIRED');
137:   const own = fs.statSync('/proc/self/ns/cgroup', {bigint:true});
138:   const host = fs.statSync('/proc/1/ns/cgroup', {bigint:true});
139:   requireRunningPoolService({uid:process.getuid(), subState:show('SubState'), controlGroup:show('ControlGroup'),
140:     mainPid, mainCgroup:read(`/proc/${mainPid}/cgroup`), hostNamespaceMatches:own.dev===host.dev && own.ino===host.ino});
