103: 
104:   if (!spiffeEnabled)
105:     throw new Error("Prism agent tools require SPIFFE worker trust");
106:   authorizeProxiedSpiffePeer(
107:     request.headers,
108:     request.socket.remoteAddress,
109:     new Set([trustedPrismAgentSpiffeId]),
110:   );
111:   const input = (await body(request)) as AgentRevisionInput;
112:   if (
113:     !input.projectId ||
114:     !input.documentId ||
115:     !input.instruction ||
116:     !Number.isSafeInteger(input.expectedRevision)
117:   )
118:     throw new Error("complete Prism revision input is required");
119:   const owner = await pool.query<{ external_id: string }>(
120:     "SELECT p.external_id FROM prism.design_document d JOIN prism.project p ON p.id=d.project_id WHERE d.id=$1",
121:     [input.documentId],
122:   );
123:   if (owner.rows[0]?.external_id !== input.projectId)
124:     throw new Error("document does not belong to the Prism project");
125:   const generation = await requirePreferenceGeneration(
126:     pool,
127:     input.generationId,
128:     input.projectId,
129:     {
130:       operation: "revise",
131:       documentId: input.documentId,
132:       expectedRevision: input.expectedRevision,
133:     },
134:   );
135:   const current = await repository.revision(
136:     input.documentId,
137:     input.expectedRevision!,
138:   );
139:   const document = validatePrism<PrismDocument>(
140:     "designDocument",
141:     input.document,
142:   );
143:   if (document.meta.revision !== input.expectedRevision! + 1)
144:     throw new Error(
145:       "Prism agent must increment the document revision exactly once",
146:     );
147:   const updated = await repository.replace(
148:     input.documentId,
149:     current.id,
150:     document,
151:     { type: "agent.revision", instruction: input.instruction, ...generation },
152:     "agent:prism",
153:     { jobId: input.jobId, fence: input.fence, payload: input },
154:   );
155:   return json(response, 200, { status: "updated", document: updated });
156: }
157: 
158: interface DesignSetInput {
159:   projectId?: string;
160:   generationId?: string;
161:   jobId: string;
162:   fence: string;
163:   designs?: Array<{
164:     key?: string;
165:     title?: string;
166:     summary?: string;
167:     document?: PrismDocument;
168:     evidence?: Record<string, unknown>;
169:   }>;
170: }
171: interface AgentRevisionInput {
172:   jobId: string;
173:   fence: string;
174:   generationId?: string;
175:   projectId?: string;
176:   documentId?: string;
177:   expectedRevision?: number;
178:   instruction?: string;
179:   document?: PrismDocument;
180: }

SOURCE skills/prism/server/control-context.ts SHA256 2444e6f0f22860aea6f109c984be4747a13421da2d33dd738ef7c29b71f04d02
1: import type { IncomingMessage } from "node:http";
2: import { runNativePrismOperation } from "../control/native-operation.ts";
3: import { verifySession } from "../control/session.ts";
4: import {
5:   ContentAddressedArtifactStore,
6:   RevisionRepository,
7:   type Database,
8: } from "../storage/index.ts";
9: import type { loadControlServerConfig } from "./control-config.ts";
10: import { cookies } from "./control-http.ts";
11: export function createControlContext(
12:   pool: Database,
13:   config: ReturnType<typeof loadControlServerConfig>,
14: ) {
15:   const repository = new RevisionRepository(pool),
16:     artifacts = new ContentAddressedArtifactStore(config.artifactRoot);
17:   return Object.freeze({
18:     pool,
19:     repository,
20:     artifacts,
21:     config,
22:     runWorker: (
23:       operation: "generate" | "render" | "evaluate" | "ingest" | "publish",
24:       input: Record<string, unknown>,
25:       idempotencyKey: string,
26:     ) =>
27:       runNativePrismOperation(
28:         pool,
29:         artifacts,
30:         config,
31:         operation,
32:         input,
33:         idempotencyKey,
34:       ),
35:   });
36: }
37: export type ControlContext = ReturnType<typeof createControlContext>;
38: export function authenticated(
39:   context: ControlContext,
40:   request: IncomingMessage,
41: ) {
42:   const { sessionSecret } = context.config;
43:   const values = cookies(request);
44:   const session = verifySession(values.prism_session ?? "", sessionSecret);
45:   const csrf = values.prism_csrf ?? "";
46:   if (
47:     !["GET", "HEAD"].includes(request.method ?? "") &&
48:     (!csrf || request.headers["x-prism-csrf"] !== csrf)
49:   )
50:     throw new Error("invalid CSRF token");
51:   return { user: session.user, roles: session.roles, csrf };
52: }
53: export type AuthenticatedControlContext = ControlContext & {
54:   readonly actor: ReturnType<typeof authenticated>;
55: };

