51: export class BusterRemotePlanService {
52:   readonly #options: BusterRemotePlanServiceOptions;
53:   readonly #now: () => Date;
54:   readonly #active = new Map<string, AbortController>();
55:   readonly #executions = new Map<string, Promise<void>>();
56:   readonly #queue = new Map<string, BusterStagedAdmission>();
57:   readonly #weights = new Map<string, number>();
58:   #submission: Promise<void> = Promise.resolve();
59:   #stopping = false;
60:   #executionFailure: Error | null = null;
61:   #recovered = false;
62:   readonly #buildkitReadiness: BuildkitReadiness | undefined;
63:   readonly #maximumActiveJobs: number;
64:   readonly #maximumQueuedJobs: number;
65:   readonly #maximumConcurrentAttempts: number;
66: 
67:   constructor(options: BusterRemotePlanServiceOptions) {
68:     const executionPolicy = validateBusterExecutionSettings(options.executionPolicy);
69:     const workerLocalRuntime = validateLocalWorkerRuntimePolicy(options.workerLocalRuntime);
70:     const dependencyReadiness = validateBusterDependencyReadinessSettings(options.dependencyReadiness);
71:     if (!/^[a-f0-9]{40,64}$/u.test(options.workerRevision)) throw new Error('BUSTER_REMOTE_WORKER_REVISION_INVALID');
72:     this.#options = { ...options, workerLocalRuntime, dependencyReadiness, executionPolicy };
73:     this.#buildkitReadiness = configuredBuildkitReadiness(this.#options);
74:     this.#now = options.now ?? (() => new Date());
75:     const admission = validateBusterAdmissionSettings(options.admission);
76:     this.#maximumActiveJobs = admission.maximumActiveJobs;
77:     this.#maximumQueuedJobs = admission.maximumQueuedJobs;
78:     this.#maximumConcurrentAttempts = admission.maximumConcurrentAttempts;
79:   }
80: 
81:   #validateAuthority(job: PreparedPlanJob): void {
82:     if (job.plan.registrySnapshotDigest !== this.#options.registry.snapshotDigest) {
83:       throw new Error('BUSTER_REMOTE_REGISTRY_SNAPSHOT_MISMATCH');
84:     }
85:     for (const node of job.plan.nodes) {
86:       const entry = this.#options.registry.testProviderContracts.get(node.provider.contractId);
87:       if (!entry) throw new Error(`BUSTER_REMOTE_PROVIDER_MISSING:${node.id}`);
88:       if (
89:         entry.registration.registrationId !== node.provider.registrationId
90:         || entry.registration.package.packageId !== node.provider.packageId
91:         || entry.registration.package.packageVersion !== node.provider.packageVersion
92:         || entry.registration.package.contentDigest !== node.provider.contentDigest
93:       ) throw new Error(`BUSTER_REMOTE_PROVIDER_IDENTITY_MISMATCH:${node.id}`);
94:       const allowed = new Set(entry.registration.capabilities);
95:       for (const capability of job.grants[node.id] ?? []) {
96:         if (!allowed.has(capability) || !this.#options.allowedCapabilities.has(capability)) {
97:           throw new Error(`BUSTER_REMOTE_CAPABILITY_DENIED:${node.id}:${capability}`);
98:         }
99:       }
100:     }
101:   }
102: 
103:   bootstrapReady(): boolean { return this.#recovered && !this.#stopping; }
104: 
105:   async readiness() {
106:     const initialized = this.bootstrapReady();
107:     const dependency = initialized ? await this.#buildkitReadiness?.check() : undefined;
108:     const currentInitialized = this.bootstrapReady();
109:     const ready = currentInitialized && dependency?.ok !== false;
110:     return { schemaVersion: 'buster-plan-readiness.v1', ready,
111:       code: ready ? 'BUSTER_READY' : currentInitialized ? 'BUSTER_DEPENDENCY_UNAVAILABLE' : 'BUSTER_NOT_BOOTSTRAPPED' };
112:   }
113: 
114:   async #assertDependencies(): Promise<void> {
115:     if ((await this.#buildkitReadiness?.check())?.ok === false) throw new Error('BUSTER_DEPENDENCY_UNAVAILABLE');
116:   }
117: 
118:   async submit(chunks: AsyncIterable<Uint8Array>): Promise<RemotePlanStatusV1> {
119:     if (this.#stopping) throw new Error('BUSTER_REMOTE_SHUTTING_DOWN');
120:     let release!: () => void;
121:     const prior = this.#submission;
122:     this.#submission = new Promise<void>((resolve) => { release = resolve; });
123:     await prior;
124:     try {
125:       let replay: RemotePlanStatusV1 | undefined;
126:       const staged = await this.#options.preparation.stage(chunks, async job => {
127:         this.#validateAuthority(job);
128:         if (this.#stopping) throw new Error('BUSTER_REMOTE_SHUTTING_DOWN');
129:         const known = (await this.#options.store.records()).find(record => record.payload.job.jobId === job.jobId);
130:         if (known) {
131:           if (known.payload.job.requestDigest !== job.requestDigest) throw new Error('BUSTER_REMOTE_JOB_CONFLICT');
132:           replay = known.payload.status;
133:           if (replay.state === 'accepted' && !this.#active.has(job.jobId)) {
134:             await this.#assertDependencies();
135:             if (known.payload.input === null) throw new Error('BUSTER_JOB_RECORD_INVALID');
136:             this.#start(known.payload);
137:           }
138:           return false;
139:         }
140:         if (job.maximumConcurrency > this.#maximumConcurrentAttempts) throw new Error('BUSTER_REMOTE_CONCURRENCY_EXCEEDS_SERVICE_LIMIT');
141:         if (this.#queue.size >= this.#maximumQueuedJobs) throw new Error('BUSTER_REMOTE_ADMISSION_FULL');
142:         await this.#assertDependencies();
143:         return true;
144:       });
145:       if (!staged) {
146:         if (!replay) throw new Error('BUSTER_PREPARATION_DECLINE_INVALID');
147:         return replay;
148:       }
149:       if (this.#stopping) throw new Error('BUSTER_REMOTE_SHUTTING_DOWN');
150:       const status = await this.#options.store.accept(staged, this.#now().toISOString());
151:       if (status.state === 'accepted' && !this.#active.has(staged.job.jobId)) this.#start(staged);
152:       return status;
153:     } finally { release(); }
154:   }
155: 
156:   async status(jobId: string): Promise<RemotePlanStatusV1> {
157:     return (await this.#options.store.get(jobId)).payload.status;
158:   }
159: 
160:   async evidence(jobId: string, contentDigest: string, maximumBytes: number): Promise<Buffer> {
161:     if (!/^sha256:[a-f0-9]{64}$/u.test(contentDigest)) throw new Error('BUSTER_REMOTE_EVIDENCE_DIGEST_INVALID');
162:     if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 0) throw new Error('BUSTER_REMOTE_EVIDENCE_LIMIT_INVALID');
163:     const stored = await this.#options.store.get(jobId);
164:     const status = stored.payload.status;
165:     if (status.state !== 'completed' || !status.result) throw new Error('BUSTER_REMOTE_EVIDENCE_NOT_READY');
166:     const result = JSON.parse((await this.#options.store.result(jobId, status.result.contentDigest,
167:       status.result.sizeBytes)).toString('utf8')) as RemotePlanResultV1;
168:     const matches = resultArtifacts(result).filter(artifact => artifact.contentDigest === contentDigest);
169:     if (matches.length === 0) throw new Error('BUSTER_REMOTE_EVIDENCE_NOT_FOUND');
170:     if (matches.some(item => item.sizeBytes !== matches[0]!.sizeBytes)) throw new Error('BUSTER_REMOTE_EVIDENCE_IDENTITY_CONFLICT');
171:     const runtimeRoot = stored.payload.resultOrigin?.kind === 'historical'
172:       ? this.#options.runtimeRoot : preparedPlanRuntimeRoot(this.#options.runtimeRoot);
173:     let bytes!: Buffer;
174:     for (const artifact of matches) bytes = await readJobArtifact(runtimeRoot, jobId, artifact, maximumBytes);
175:     return bytes;
176:   }
177: 
178:   async result(jobId: string, contentDigest: string, maximumBytes: number): Promise<Buffer> {
179:     return this.#options.store.result(jobId, contentDigest, maximumBytes);
180:   }
181: 
182:   async cancel(jobId: string): Promise<RemotePlanStatusV1> {
183:     const status = await this.#options.store.requestCancellation(jobId, this.#now().toISOString());
184:     if (status.state !== 'cancelling') return status;
185:     this.#queue.delete(jobId);
186:     this.#active.get(jobId)?.abort(new Error('BUSTER_REMOTE_CANCELLED'));
187:     if (!this.#active.has(jobId)) {
188:       return this.#options.store.transition(
189:         jobId, ['cancelling'], 'cancelled', this.#now().toISOString(), { error: 'cancelled before execution' },
190:       );
191:     }
192:     return status;
193:   }
194: 
195:   async recover(): Promise<void> {
196:     this.#recovered = false;
197:     for (const record of await this.#options.store.records()) {
198:       const prepared = record.payload;
199:       const { job, status } = prepared;
200:       if (status.state === 'accepted') await this.#recoverAccepted(prepared);
201:       else if (status.state === 'running') {
202:         await this.#options.store.transition(job.jobId, ['running'], 'failed', this.#now().toISOString(), {
203:           error: 'BUSTER_REMOTE_EXECUTION_INTERRUPTED',
204:         });
205:       } else if (status.state === 'cancelling') {
206:         await this.#options.store.transition(job.jobId, ['cancelling'], 'cancelled', this.#now().toISOString(), {
207:           error: 'cancelled during restart recovery',
208:         });
209:       }
210:       // A previous host's terminal record does not prove orphan quiescence.
211:       // Retain workspace inputs until an ownership reconciliation can prove it.
212:     }
213:     this.#recovered = true;
214:   }
215: 
216:   async shutdown(timeoutMs: number): Promise<void> {
217:     if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1) {
218:       throw new Error('BUSTER_REMOTE_SHUTDOWN_TIMEOUT_INVALID');
219:     }
220:     this.#stopping = true; this.#queue.clear();
221:     for (const controller of this.#active.values()) {
222:       controller.abort(new Error('BUSTER_REMOTE_SHUTDOWN'));
223:     }
224:     const dependencyShutdown = this.#buildkitReadiness?.shutdown();
225:     let timer: NodeJS.Timeout | undefined;
226:     try {
227:       const outcomes = await Promise.race([
228:         Promise.allSettled([this.#submission, ...this.#executions.values(), dependencyShutdown]),
229:         new Promise<never>((_resolve, reject) => {
230:           timer = setTimeout(() => reject(new Error('BUSTER_REMOTE_SHUTDOWN_TIMEOUT')), timeoutMs);
231:         }),
232:       ]);
233:       if (this.#executionFailure) throw this.#executionFailure;
234:       for (const outcome of outcomes) {
235:         if (outcome.status === 'rejected') throw outcome.reason;
236:       }
237:     } finally {
238:       if (timer) clearTimeout(timer);
239:     }
240:   }
241: 
242:   #start(prepared: BusterStagedAdmission): void {
243:     const { job } = prepared;
244:     if (this.#stopping || this.#active.has(job.jobId)) return;
245:     this.#queue.set(job.jobId, prepared); this.#drain();
246:   }
247: 
248:   #drain(): void {
249:     if (this.#stopping) return;
250:     for (const [id, prepared] of this.#queue) {
251:       const { job } = prepared;
252:       const used = [...this.#weights.values()].reduce((a, b) => a + b, 0);
253:       if (this.#active.size >= this.#maximumActiveJobs || used + job.maximumConcurrency > this.#maximumConcurrentAttempts) return;
254:       this.#queue.delete(id);
255:       const controller = new AbortController(); this.#active.set(id, controller); this.#weights.set(id, job.maximumConcurrency);
256:       const execution = this.#execute(prepared, controller).catch((error: unknown) => {
257:         // Normal execution failures are persisted by #execute. A rejection here
258:         // means that durable failure recording failed; retain its ownership even
259:         // after this execution leaves the active map.
260:         this.#executionFailure ??= error instanceof Error ? error : new Error('BUSTER_REMOTE_EXECUTION_PERSISTENCE_FAILED', { cause: error });
261:         this.#stopping = true;
262:         this.#queue.clear();
263:       }).finally(() => {
264:         this.#active.delete(id); this.#executions.delete(id); this.#weights.delete(id); this.#drain();
265:       });
266:       this.#executions.set(id, execution);
267:     }
268:   }
269: 
270:   async #recoverAccepted(prepared: StoredPreparedPlanJob): Promise<void> {
271:     const { job } = prepared;
272:     try {
273:       if (prepared.input === null) throw new Error('BUSTER_JOB_RECORD_INVALID');
274:       this.#options.store.validate(prepared);
275:       this.#validateAuthority(job);
276:       if (job.maximumConcurrency > this.#maximumConcurrentAttempts) throw new Error('BUSTER_REMOTE_CONCURRENCY_EXCEEDS_SERVICE_LIMIT');
277:       this.#start(prepared);
278:     } catch (error) {
279:       await this.#options.store.transition(job.jobId, ['accepted'], 'failed', this.#now().toISOString(), {
280:         error: error instanceof Error ? error.message : String(error),
281:       });
282:     }
283:   }
284: 
285:   async #execute(prepared: BusterStagedAdmission, controller: AbortController): Promise<void> {
286:     await executeBusterPreparedJob(this.#options, prepared, controller.signal, this.#now);
287:   }
288: }

