78	    if (!state || state.size !== buffer.length) throw new Error(`JOURNAL_CHANGED_DURING_READ:${this.#file}`);
79	    return { records, offset: buffer.length, identity: state.identity, mtimeMs: state.mtimeMs, ctimeMs: state.ctimeMs };
80	  }
81	
82	  #adoptReloaded(loaded: { records: JournalRecord<T>[]; offset: number; identity: string | undefined; mtimeMs: number | undefined; ctimeMs: number | undefined }): void {
83	    if (loaded.records.length < this.#records.length
84	      || this.#records.some((record, index) => loaded.records[index]?.hash !== record.hash)) {
