6	
7	export interface JournalRecord<T> {
8	  readonly sequence: number;
9	  readonly previousHash: string | null;
10	  readonly hash: string;
11	  readonly entry: T;
12	}
13	
14	export function parseJournalRecords<T>(buffer: Buffer, records: JournalRecord<T>[], file: string): void {
