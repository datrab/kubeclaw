152	/** Product-owned compiler; the lifecycle core remains independent of stage names.
153	 * A project is a single repository publication lane. Explicit pipeline graphs
154	 * retain their existing concurrency semantics.
155	 */
156	export function compileProject(value: unknown, sourceIdentity: 'legacy' | typeof PORTABLE_JSON_ENCODING = PORTABLE_JSON_ENCODING,
157	  reportArtifactEncoding: 'legacy' | typeof PORTABLE_JSON_ENCODING = PORTABLE_JSON_ENCODING,
158	  reviewSemanticMode: ProjectReviewSemanticMode = 'legacy',
159	  deliveryManifestEncoding: ProjectDeliveryManifestMode = 'legacy'): { runId: string; definition: PipelineDefinition } {
160	  assertProjectReviewModes(reportArtifactEncoding, reviewSemanticMode);
161	  assertProjectDeliveryManifestMode(deliveryManifestEncoding);
162	  const project = object(value, ['schemaVersion', 'id', 'runId', 'repositoryRoot', 'workspaceRoot', 'baseRevision', 'modules', 'final', 'architecture', 'demo'], 'project');
163	  if (project.schemaVersion !== 'nova-project.v2') throw new Error('PROJECT_SCHEMA_UNSUPPORTED:nova-project.v2 requires explicit architecture and module blueprint declarations; legacy inputs need authored migration');
164	  const projectId = id(project.id);
165	  const runId = text(project.runId, 'runId');
166	  const repository = absolute(project.repositoryRoot, 'repositoryRoot');
167	  const workspaces = absolute(project.workspaceRoot, 'workspaceRoot');
168	  if (workspaces === repository || workspaces.startsWith(`${repository}${path.sep}`)) throw new Error('PROJECT_WORKSPACES_INSIDE_REPOSITORY');
169	  const baseline = text(project.baseRevision, 'baseRevision');
170	  if (!/^[a-f0-9]{40}$/u.test(baseline)) throw new Error('PROJECT_BASE_REVISION_INVALID');
171	  const ordered = orderedModules(projectModules(project, runId, projectId));
172	  const final = object(project.final, ['lint', 'test', 'review', 'integrationRequirements'], 'final');
173	  if (!Array.isArray(final.integrationRequirements)) throw new Error('PROJECT_INTEGRATION_REQUIREMENTS_REQUIRED');
174	  const finalLint = object(final.lint, ['policyPath', 'policyProject'], 'final.lint');
175	  absolute(finalLint.policyPath, 'final.lint.policyPath'); text(finalLint.policyProject, 'final.lint.policyProject');
176	  if (final.review !== undefined) { object(final.review, ['agent'], 'final.review'); text(final.review.agent, 'final.review.agent'); }
177	  object(final.test, ['agent', 'agentRole', 'testAgentEnabled', 'requiredChecks', 'providerPlan'], 'final.test');
178	  object(final.test.providerPlan, ['repositoryId', 'plan', 'grants', 'maximumConcurrency', 'submittedAt', 'timeoutMs'], 'final.providerPlan');
179	  const demo = normalizeDemo(project.demo);
180	  const source = sourceStages(project, ordered, demo, sourceIdentity);
181	  const stages: StageDefinition[] = [...source.stages];
182	  let previousGate: string | undefined = 'blueprint-sync';
183	  for (const module of ordered) {
184	    stages.push(...moduleStages(module, { projectId, runId, repository, workspaces, baseline, previousGate, sourceBinding: source.binding, reportArtifactEncoding, reviewSemanticMode }));
185	    previousGate = `test-${module.id}`;
186	  }
187	  stages.push(...cumulativeStages(project, ordered, `implement-${ordered.at(-1)!.id}`, reportArtifactEncoding,
188	    reviewSemanticMode, deliveryManifestEncoding));
189	  stages.push(...demoStages(demo,final.test.providerPlan.plan));
190	  const definition = { schemaVersion: 'pipeline-definition.v2', id: `project:${projectId}`, maxConcurrency: 1, stages } as PipelineDefinition;
191	  validateContractValue('pipelineDefinition', definition);
192	  return { runId, definition: structuredClone(definition) };
193	}
