1	import crypto from 'node:crypto';
2	
3	function compareText(left: string, right: string): number {
4	  // RFC 8785 section 3.2.3 requires raw UTF-16 code-unit ordering.
5	  return left < right ? -1 : left > right ? 1 : 0;
6	}
7	
8	function encodeString(value: string): string {
9	  for (let index = 0; index < value.length; index += 1) {
10	    const unit = value.charCodeAt(index);
11	    if (unit >= 0xd800 && unit <= 0xdbff) {
12	      const next = value.charCodeAt(index + 1);
13	      if (!(next >= 0xdc00 && next <= 0xdfff)) throw new TypeError('RFC8785_INVALID_UNICODE');
14	      index += 1;
15	    } else if (unit >= 0xdc00 && unit <= 0xdfff) {
16	      throw new TypeError('RFC8785_INVALID_UNICODE');
17	    }
18	  }
19	  return JSON.stringify(value);
20	}
21	
22	export function canonicalJson(value: unknown): string {
23	  if (value === null) return 'null';
24	  if (typeof value === 'string') return encodeString(value);
25	  if (typeof value === 'boolean') return value ? 'true' : 'false';
26	  if (typeof value === 'number') {
27	    if (!Number.isFinite(value)) throw new TypeError('RFC8785_INVALID_NUMBER');
28	    return JSON.stringify(value);
29	  }
30	  if (typeof value !== 'object') throw new TypeError('RFC8785_INVALID_TYPE');
31	  if (Array.isArray(value)) {
32	    const items: string[] = [];
33	    for (let index = 0; index < value.length; index += 1) {
34	      if (!Object.hasOwn(value, index)) throw new TypeError('RFC8785_INVALID_ARRAY');
35	      items.push(canonicalJson(value[index]));
36	    }
37	    return `[${items.join(',')}]`;
38	  }
39	  const prototype = Object.getPrototypeOf(value);
40	  if (prototype !== Object.prototype && prototype !== null) throw new TypeError('RFC8785_INVALID_OBJECT');
41	  return `{${Object.entries(value as Record<string, unknown>)
42	    .sort(([left], [right]) => compareText(left, right))
43	    .map(([key, child]) => `${encodeString(key)}:${canonicalJson(child)}`)
44	    .join(',')}}`;
45	}
46	
47	export function sha256Digest(value: unknown): string {
48	  return `sha256:${crypto.createHash('sha256').update(canonicalJson(value)).digest('hex')}`;
49	}
50	
51	export function sha256Text(value: string): string {
52	  return `sha256:${crypto.createHash('sha256').update(value, 'utf8').digest('hex')}`;
53	}
54	
55	export function workerProfileDigest(profile: Readonly<object>): string {
56	  const { profileDigest: _profileDigest, ...unsigned } = profile as Readonly<Record<string, unknown>>;
57	  return sha256Digest(unsigned);
58	}
59	
60	export function workerAttemptSpecDigest(envelope: Readonly<object>): string {
61	  const { attemptSpecDigest: _attemptSpecDigest, claim: _claim, ...unsigned }
62	    = envelope as Readonly<Record<string, unknown>>;
63	  return sha256Digest(unsigned);
64	}
65	
66	export function workerAttemptResultDigest(result: Readonly<object>): string {
67	  const { resultDigest: _resultDigest, receipt: _receipt, ...unsigned }
68	    = result as Readonly<Record<string, unknown>>;
69	  return sha256Digest(unsigned);
70	}
docs/review/remediation/decisions.md SHA256 b4d9b29911643d08fc6ef439b88dec4ef3e6a4f355ea591ff3f6db9e3f152d1b
1	# Bestätigte Zielentscheidungen
2	
3	Stand: 2026-09-09. Vom Auftraggeber in der Planungssitzung ausdrücklich bestätigt, einschließlich seiner Korrekturen. **Zielvorgaben für die Behebung, keine Behauptung bereits implementierten Verhaltens.** Historische Reviewberichte bleiben unverändert. Technische Ausgestaltung erfolgt in den zugeordneten Arbeitspaketen; Abweichungen von diesen Entscheidungen benötigen eine neue ausdrückliche Entscheidung.
4	
5	## D01 — Vollständige Diagnose, Demo-Credentials und Logsammlung
6	
7	- Relevant ausgeführte Aktionen nachvollziehbar erfassen: wer, was, wo, wann und wie; Projekt, Run, Modul, Stage, Versuch und externe Auftragsidentität soweit anwendbar mitführen. Eingaben, Ausgaben, Zustandsänderungen, Fehlerursache und Fortsetzung müssen nachvollziehbar bleiben.
8	- Fehler explizit berichten: betroffene Operation, Originalursache und Diagnose erhalten; nicht hinter generischen Fehlermeldungen verbergen.
9	- Ausschließlich **von der Pipeline erzeugte Demo-Zugangsdaten** dürfen ungeschwärzt in Logs und autorisierten Operatorbenachrichtigungen stehen. Langlebige Plattform-Secrets, GitHub-/Modellanbieter-/Tailscale-Tokens, Plattform-DBzugänge und echte Benutzerdaten bleiben geschützt. Kein pauschales Abschalten von Schutzmechanismen. Die Ausnahme richtet sich nach Herkunft/Zweck des Credentials, nicht allein nach Namespace oder Feldname.
10	- Clawdeck übernimmt die dauerhafte Logsammlung. Es wird kein zusätzlicher zentraler Pipeline-Logspeicher als Produktanforderung eingeführt. Vorhandene lokale Log-/Artefaktverträge müssen dennoch konsistent funktionieren; keine Dummy-Speicherung oder stiller Logverlust zur Erfüllung eines Pflichtcallbacks.
11	- Große Ausgaben vollständig als Dateien/Artefakte erhalten und aus Ereignissen/Benachrichtigungen verlinken. Anzeigeverkürzung ausdrücklich kennzeichnen; sie darf keine unbemerkte Kürzung des gespeicherten Originals sein. Relevante konkrete Fehler und Ergebnisse bleiben in Nachrichten sichtbar.
12	- Diese Regel erlaubt keine öffentliche Veröffentlichung von Logs, Secrets oder Betreiberkonfiguration. Sie betrifft den vorgesehenen privaten Diagnose-/Operatorpfad.
13	
14	## D02 — Technische Lieferung und menschliche Abnahme
15	
16	- **Bereit zur Abnahme:** Implementation abgeschlossen, verpflichtende Prüfungen bestanden, exakt der geprüfte Stand als Demo erreichbar und URL samt Demo-Zugangsdaten dem Operator zugestellt.
17	- **Abgenommen:** ausdrückliche Zustimmung des Operators zu genau dieser Version.
18	- Änderungswünsche erzeugen weitere Arbeit und erneute Prüfung des geänderten Stands. Eine alte Abnahme ist keine Freigabe einer neuen Version.
19	- Pipeline Review und Case Study bleiben optional. Eine abgelaufene Demo wird als abgelaufen dargestellt; bereits erteilte Abnahme bleibt historisch gültig.
20	
21	## D03 — Pflichtprüfungen und optionale Agenten
22	
23	- Lint nach jeder Moduländerung verpflichtend, einschließlich Reparaturen.
24	- Deterministische Tests mit ausdrücklich definiertem Pflichtumfang pro Modul. Vor technischer Lieferung zusätzlich kumulative Prüfung des integrierten Projekts. Testauswahl ist projektspezifisch; nicht jede vorhandene Suite muss für jede Anwendung laufen. Übersprungene Pflichtprüfungen zählen nicht als bestanden. Pflichtumfang nicht stillschweigend reduzieren.
25	- Architektur: **nur der deterministische Teil ist Pflicht**, um erforderliche Struktur, Konfiguration und Referenzen zu prüfen. Agentisches Architekturreview ist optional. Die frühere Empfehlung eines generell verpflichtenden agentischen Architekturreviews wurde ausdrücklich korrigiert.
26	- Echo-Code-Review: optional, standardmäßig **aus**.
27	- Buster einschließlich Test-Agent: standardmäßig **an**. Der Test-Agent bleibt separat abschaltbar; vereinbarte deterministische Pflichtprüfungen bleiben verbindlich. Buster ist nicht allein mit seinem optionalen Test-Agent gleichzusetzen.
28	- Aktivierte Review-/Agentprüfungen sind verbindlich gemäß D10. Pipeline Review und Case Study sind optionale Abschlussauswertungen, keine Ersatztests.
29	
30	## D04 — Getrennte Reparaturbudgets und einmalige Nova-Eskalation
31	
32	- Pro Modul gibt es getrennte Budgets: **zwei Lint-Reparaturrunden, zwei Review-Reparaturrunden und zwei Test-Reparaturrunden**. Reviewbudget nur bei aktiviertem Review. Keine gemeinsame Zweiergrenze und keine drei Standardrunden.
33	- Erstimplementation und reine Wiederprüfungen zählen nicht als Reparatur. Eine Reparatur wird dem auslösenden Prüfschritt zugerechnet; danach erforderliche andere Prüfungen bleiben verpflichtend. Bereits verbrauchte Budgets bleiben erhalten, auch bei Invalidierung oder Neustart.
34	- Eine weitere notwendige Reparatur über ein ausgeschöpftes Kategorienbudget führt zu **Needs Nova** mit vollständiger Fehler-/Änderungshistorie. Erfolg nach der letzten erlaubten Reparatur wird nicht allein wegen des Zählerstands blockiert.
35	- Nova darf **einmal pro Modul genau einen zusätzlichen Reparaturauftrag** geben. Führt dieser einschließlich aller notwendigen Wiederprüfungen nicht zum Erfolg, folgt **blocked**; weitere Arbeit benötigt die Entscheidung des Operators. Keine zwei zusätzlichen Nova-Runden und kein automatischer Reset aller Budgets.
36	- Nova darf Anforderungen oder Pflichtprüfungen nicht eigenständig abschwächen. Fachliche Entscheidung und bewilligter zusätzlicher Auftrag müssen dauerhaft nachvollziehbar sein.
37	
38	## D05 — Parallele Module und kontrollierte Integration
39	
40	- Unabhängige Module in getrennten autorisierten Worktrees parallel bearbeiten.
41	- Kurze gemeinsame Gitintegrationen serialisieren; normale Lockkonkurrenz kontrolliert behandeln.
42	- Abhängige Module erst nach bestandenen Pflichtprüfungen ihrer Voraussetzungen starten.
43	- Maximalparallelität konfigurierbar. Den tatsächlich integrierten Stand anschließend kumulativ prüfen.
44	
45	## D06 — Demo-Lebensdauer
46	
47	- Standardmäßig **eine Woche (sieben Tage) ab Bereit zur Abnahme**, pro Projekt konfigurierbar und verlängerbar.
48	- Operator kann jederzeit vorzeitig bereinigen. Vor Ablauf benachrichtigen.
49	- Namespace, Zugangs-URL/Exposure und Demo-Credentials haben denselben Lebenszyklus. Planende darf die übertragene Operator-Exposure nicht vorzeitig löschen.
50	- Nach Ablauf beziehungsweise expliziter Bereinigung Demo-Ressourcen entfernen. Code, Berichte, Logs und Abnahmestatus folgen D07; die Demo-TTL ist keine Log-TTL.
51	
52	## D07 — Aufbewahrung ohne automatische Loglöschung
53	
54	- Logs auf Disk oder in Git bleiben **auf unbestimmte Zeit bis zur manuellen Bereinigung durch den Operator**. Die vorgeschlagene automatische 30-Tage-Löschung wurde verworfen.
55	- Code, finale Berichte, Entscheidungen und Abnahmehistorie bleiben bis zur ausdrücklichen Projektlöschung erhalten.
56	- Solange ein Run auf Entscheidung wartet, seine zur Fortsetzung/Prüfung erforderlichen Belege erhalten. Explizite Bereinigung darf nicht unbemerkt einen fortsetzbaren Run unbrauchbar machen; Konsequenz sichtbar machen.
57	- Vollständige große Ausgaben wie in D01; Clawdeck bleibt Logsammlung. Eine konkrete Clawdeck-interne Löschfrist wurde nicht festgelegt.
58	- Nicht alle Caches, entpackten Quellen oder temporären Buildverzeichnisse sind Logs. D07 erklärt diese nicht pauschal für unbefristet aufzubewahren. Speicherbudgets, Backpressure und explizite Kapazitätsfehler dürfen Datenverlust nicht durch stille Kürzung/Löschung verdecken.
59	
60	## D08 — Technische Wiederaufnahme
61	
62	- Sicher wiederholbare Arbeit automatisch fortsetzen.
63	- Bei möglicherweise bereits ausgeführten externen Aktionen zuerst tatsächlichen Zustand ermitteln und vorhandene Arbeit übernehmen, beispielsweise Git-Push oder angenommener Buster-Auftrag.
64	- Bleibt der Ausgang unklar: Needs Nova mit konkreter Diagnose, keine blinde Wiederholung ungewisser Seiteneffekte. Auch ein zusätzlicher Auftrag nach D04 hebt diese Integritätsgrenze nicht auf.
65	- Technische Wiederholungen verbrauchen kein fachliches Reparaturbudget; eigene konfigurierbare Zeit-/Versuchslimits verhindern Endlosschleifen.
66	
67	## D09 — Generischer Worker-Core
68	
69	- Derselbe Core für Buster, Prism und weitere Worker: Auftragsidentität, Status, Timeout, Abbruch, Wiederaufnahme und Ergebnisübergabe.
70	- Fachlogik in getrennten Engines. Workerfähigkeiten und Ressourcen pro Worker konfigurierbar.
71	- Nova steuert den Gesamtprozess; Worker führen Aufträge aus. Generischer Core importiert keine konkreten Plugins.
72	- Dauerhafter Ausführungszustand besteht unabhängig von Clawdeck. Logsammlung ist keine Voraussetzung für korrekte Recovery; benötigte Auftrags-/Ergebnisbelege sind trotzdem zuverlässig zu persistieren.
73	
74	## D10 — Bewusste Risikoakzeptanz
75	
76	- Ausschließlich der Operator darf fachliche Qualitätsrisiken bewusst akzeptieren, mit Begründung und Bindung an den geprüften Stand. Nova darf diese Freigabe nicht selbst erteilen.
77	- Fehlgeschlagene Pflichtprüfungen bleiben fehlgeschlagen. Änderungen an Anforderungen/Pflichtumfang ausdrücklich entscheiden und betroffenen Stand erneut prüfen; kein force-passed.
78	- Beschädigte Evidenz, falsche Ergebniszuordnung oder fehlende Autorisierung sind nicht durch Risikoakzeptanz übersteuerbar.
79	
80	## D11 — Persönliche Designpräferenzen
81	
82	- Gespeicherte persönliche Präferenzen gelten projektübergreifend; pro Projekt überschreibbar oder deaktivierbar.
83	- Explizite Projektvorgaben haben Vorrang. Jede Generierung hält fest, welchen Präferenzstand sie tatsächlich verwendet hat.
84	- Projektübergreifende Verwendung hebt Nutzer-, Projekt-/Ereignisherkunft und Generationsidentität nicht auf. Keine zufällige Aggregation durch kollidierende Schlüssel.
85	
86	## Noch benötigte Umgebungsdaten, keine neuen stillen Produktentscheidungen
87	
88	Die Pipelinevorgaben reichen für den Behebungsplan. Konkrete Hostkapazität/Paperless-Reserve, externe Tailnetregeln, unabhängiger Recoveryzugang, Backupziel und akzeptierte Wiederherstellungszeiten sowie verfügbare Clawdeck-Schnittstelle sind vor den jeweiligen Betriebsnachweisen zu erheben. Keine neue VM, kostenpflichtige Ressource, Backupgarantie oder externe Zugriffsregel wird aus diesem Dokument als bereits genehmigt/vorhanden abgeleitet. Technische Vorschläge hierfür gehören mit Begründung in WP09/WP12/WP13.
89	
90	## D12 — Lokaler Abschluss und separate Live-Abnahme
91	
92	Am2026-09-12 vom Auftraggeber ausdrücklich bestätigt: Wenn Code vollständig
93	korrigiert und ausreichend lokal getestet ist, gilt das Finding als **lokal
94	verifiziert und für diesen Behebungsauftrag abgeschlossen**. Die Live-Tests
95	führt der Auftraggeber am Ende nach dem Open-Sourcing aus; GitHub-Actions-Gates
96	bleiben dafür erhalten. Lokale Nachweise und ausstehende Live-Nachweise werden
97	getrennt geführt. Fehlende Implementierung oder unzureichende lokale Abdeckung
98	bleiben offen. Nicht ausgeführte Tests werden nicht als bestanden bezeichnet.
99	
100	Diese Entscheidung ersetzt frühere Anforderungen, bereits für den lokalen
101	Findingabschluss sämtliche Live-/Cluster-/Empfängerprüfungen auszuführen. Sie
102	ändert weder Runtime-Sicherheitsgates noch D02-Produktabnahme und autorisiert
103	keine Deployments, Nachrichten oder Umgehung einer gesperrten Aktion. Umsetzung
104	und [Einzelbewertung](implementation/pr6-local-acceptance.md) bleiben in PR #6;
105	keine zusätzlichen Branches.
106	
107	## D13 — Explizite Tasklimits und großzügige Reserve
108	
109	Am 2026-09-12 vom Auftraggeber nach Abwägung ausdrücklich bestätigt:
110	
111	- Der neue native Worker-Ressourcenpfad begrenzt Linux-Tasks, also alle Threads
112	  einschließlich des Hauptthreads jedes Prozesses. Prozesse werden nicht noch
113	  einmal zusätzlich zu ihren Threads gezählt.
114	- Die Einheit wird im Ressourcenvertrag und in Profilen ausdrücklich gebunden.
115	  Bestehende Prozessbudgets und historische Receipts werden nicht stillschweigend
116	  als Taskbudgets umgedeutet; die Migration muss versioniert beziehungsweise
117	  eindeutig diskriminiert sein und alte Nachweise lesbar erhalten.
118	- Limits mit großzügiger Reserve anhand tatsächlicher Worker-Arbeit wählen,
119	  nicht knapp am Normalverbrauch und nicht durch eine feste Umrechnung alter
120	  Prozesszahlen. Fehlende Messungen erlauben keine Behauptung einer bereits
121	  erfolgten Kalibrierung. CPU, Speicher und Parallelität bleiben separat begrenzt.
122	- Die Prüfung und vollständige Zentralisierung aller Betreiber-Einstellungen
123	  über die vorhandene `swarm.config.json` ist ein eigener Roadmap-Schritt nach
124	  den vier verbleibenden Findings in PR #6. Keine zweite Betreiberdatei einführen.
125	
126	Dies ist die freigegebene Zielentscheidung, noch kein implementierter oder
127	verifizierter Ressourcenpfad. D09 und D12 bleiben unverändert; keine Deployment-
128	oder Privilegienänderung ist damit autorisiert.
129	
130	## D14 — Eigene dauerhafte Fixture-Lebensdauer in Buster
131	
132	Der Auftraggeber hat den Vorschlag ausdrücklich bestätigt: Retained Fixtures
133	erhalten eine eigene dauerhafte Lebensdauer in Buster mit großzügigem separatem
134	Ressourcenbudget und einem Abschlussbeleg nach dem Cleanup. Bereitschaft nach
135	dem Setup ist kein Nachweis abgeschlossener Bereinigung. Buster führt
136	Abhängigkeiten, Bereitschaft und Fixture-Abschluss; Worker Core stellt neutrale
137	Prozessbesitz-, Messungs- und Recoverymechanismen bereit. Prism behält seine
138	normale Attempt-Lebensdauer. Die bereits freigegebene Core/Buster-Aufteilung und
139	Task-Einheit müssen nicht erneut bestätigt werden.
140	
141	Die physische Ressourcenbindung bleibt während der Fixture-Lebensdauer erhalten;
142	ein Prozesswechsel zwischen Cgroups darf nicht als Übertragung bereits
143	angefallener Speicherbelastung behauptet werden. Historische Setup-Receipts und
144	Budgets bleiben unverändert lesbar; neue Lebensdauerbelege sind explizit
145	versioniert und gebunden.
146	
147	## D15 — Vollständiger verbleibender 23er-Umfang
148	
149	Der Auftrag umfasst jetzt alle 23 noch nicht verifizierten Findings der
150	ursprünglichen 154: die vier laufenden Implementierungen und die 19 bislang
151	offenen Infrastrukturfindings. Arbeit weiter direkt in PR #6. Vollständige
152	Implementierung und echte ausreichende lokale Verifikation sind erforderlich;
153	Live-Gates bleiben vorbereitet für die abschließende Ausführung durch den
154	Auftraggeber. Kein Live-Nachweis wird aus Konfiguration oder lokalen Ersatzdaten
155	abgeleitet. Die gewünschte Mindestarbeitsdauer von acht Stunden ist kein Beleg
156	für Abschluss und wird nur bei tatsächlich geleisteter Zeit behauptet.
157	
158	## D16 — Feste Host-Reservierung für native Worker
159	
160	Der Auftraggeber hat Variante A aus `implementation/pr6-node-accounting-decision.md`
161	ausdrücklich bestätigt: hostverwaltete Rollenbereiche mit festen, tatsächlich
162	schedulerwirksamen Kapazitätsreservierungen. Die Umsetzung betrifft Buster und
163	Prism. Gesamtlimits und vollständige Admission-Reservierungen verhindern, dass
164	Parallelität großzügige Einzelbudgets unkontrolliert vervielfacht. Kubernetes darf
165	diese Hostkapazität nicht nochmals an Pods vergeben. Andere Hostdienste behalten
166	eine getrennte Reserve. Konkrete verfügbare Kapazität wird geprüft, nicht erfunden.
167	
168	D13/D14 bleiben unverändert. Die Entscheidung autorisiert die Implementierung in
169	PR #6, keinen Hosteingriff, Deployment oder Kauf zusätzlicher Ressourcen. Die
170	Node-/Runtime-Anbindung muss fehlende Voraussetzungen vor Aktivierung abweisen.
171	
172	## D17 — Config als alleinige Autorität, klare Komponentengrenzen
173	
174	Der Auftraggeber präzisiert den laufenden CONFIG-Auftrag: Code und Konfiguration
175	müssen klar getrennt sein. Für konfigurierbare Werte dürfen keine hardcodierten
176	Fallbacks, lokalen Ersatzdefaults oder konkurrierenden Autoren im Code verbleiben.
177	Fehlende erforderliche oder ungültige Konfiguration muss vor Aktivierung abgewiesen
178	werden. Auch Loader, Schemas, Environment, Entrypoints und Charts dürfen keinen
179	versteckten zweiten Defaultpfad bereitstellen. Gewünschte Standardwerte stehen
180	ausdrücklich in der gepflegten Konfiguration.
181	
182	Gewünschte Struktur sind klar zugeordnete zentrale Config-Dateien pro Plugin und
183	entsprechend für Worker Core, Engine, Orchestrator Core und weitere Komponenten.
184	Jede Einstellung hat genau eine editierbare Autorenquelle. Ein gemeinsamer
185	Einstiegspunkt darf diese Komponentenreferenzen zusammenführen und validieren;
186	er darf ihre Werte nicht parallel pflegen oder durch lokale Defaults ersetzen.
187	Die bisherige zentrale swarm-Autorität ist bei dieser Aufteilung nachvollziehbar
188	zu migrieren, nicht durch zusätzliche konkurrierende Dateien zu ergänzen.
189	Externe Secretwerte und die getrennte Softwareversionsautorität bleiben erhalten;
190	ihre erforderlichen Referenzen und Zuständigkeiten müssen eindeutig sein.
191	
192	F1–F6 und F-DOC bleiben verpflichtend. Die Inventur muss jede konfigurierbare
193	Einstellung, ihren einzigen Autor und alle tatsächlichen Consumer zuordnen.
194	Positive Profile müssen den echten Consumer verändern; fehlende Werte und
195	wieder eingeführte Fallbacks müssen durch passende Negativ-/Mutationstests
196	auffallen. Ersetzte Ladepfade und widersprüchliche Anleitungen sind zu entfernen
197	oder ausdrücklich als historische Belege zu kennzeichnen. Die Entscheidung
198	beschreibt das Ziel, keinen bereits abgeschlossenen Implementierungsstand.
199	
200	## D18 — Kubernetes-Ausführung statt eigener nativer Hostpools
201	
202	Am 2026-10-12 hat der Auftraggeber den Zielwechsel und die fünf vorgeschlagenen
203	Vertragsanpassungen ausdrücklich akzeptiert, **sofern die Lösung wesentlich
204	weniger komplex und einfacher skalierbar wird**. Einsatzprofil ist generell
205	eigener generierter Code. Die [detaillierte Architektur- und Migrationsbeschreibung](worker-execution-simplification-20261012.md)
206	und der [beschlossene Arbeitsplan](implementation-order-20261012.md) konkretisieren
207	Umfang, Gründe, Grenzen und Abnahme.
208	
209	- Prism führt jeweils einen Auftrag/Attempt in einem Kubernetes-Job aus.
210	- Buster führt zunächst einen ganzen Testplan mit lokalen Fixtures in einem
211	  Job aus. Seine harte Ausführungsgrenze ist zunächst der Plan, nicht jeder
212	  einzelne Testnode. Nodefristen, Outputgrenzen und fachliche Ergebniszuordnung
213	  bleiben erhalten. Ein fehlerhafter Test kann den ganzen Plan beeinträchtigen.
214	- Kubernetes/Runtime verwalten die Cgroups und schedulbaren Containerressourcen.
215	  Eigene hostverwaltete Buster-/Prism-Rollenpools, deren NRI-Anpassung und die
216	  ausschließlich dafür nötigen Sonderpfade werden nach geprüftem Cutover entfernt.
217	  Allgemeiner Host-/Kubeletschutz bleibt bestehen. Dies **ersetzt D16 als
218	  zukünftige Zielarchitektur**; D16 und historische Belege bleiben unverändert lesbar.
219	- Für die neue Ausführung gelten CPU-Rate plus endliche Laufzeit statt eines
220	  identischen kumulativen CPU-Zeitbudgets, einheitlicher Podtaskschutz mit
221	  nachgewiesenem aggregiertem Node-/Hostschutz statt frei unterschiedlicher
222	  harter Attempttasklimits und Busters Planbudget statt isolierter Nodebudgets.
223	  Linux-Tasksemantik aus D13 bleibt; historische Einheiten werden nicht umgedeutet.
224	- Bei Crash/Nodeverlust nicht zuverlässig erfasste finale Kernelwerte werden
225	  ausdrücklich als unbekannt ausgewiesen. Keine erfundenen Nullwerte, keine
226	  Behauptung einer vollständigen Endabrechnung aus periodischen Metriken.
227	- Bei Controllerneustart wird lebende Job-/Fixturearbeit übernommen. Bei Verlust
228	  des Planpods erlischt lokale Fixturebereitschaft; erst nach sicherer
229	  Zustandsklärung rekonstruieren oder blockieren. D14/B4 werden insoweit angepasst:
230	  kein Versprechen physisch weiterlebender lokaler Fixtures über Podverlust hinweg.
231	  Bereitschaft, eigene ausgewiesene Ressourcen und bestätigtes Cleanup bleiben Pflicht.
232	
233	Erhalten bleiben dauerhafte Auftragsidentität, Claims, Deduplizierung, Resultate,
234	externes Effekt-Reconciliation, D08, Plugin-/Capability-/Credentialgrenzen,
235	Retention nach D01/D07 und separate Live-Abnahme nach D12. Ein Job garantiert
236	keine Exactly-once-Ausführung und ein unerreichbarer Node kein Prozessende.
237	Die innere Buster-Berechtigungsgrenze, Storagezugriff und BuildKit-Isolation
238	sind vor ihrer jeweiligen Umsetzung konkret zu lösen und echt nachzuweisen.
239	
240	Die Anpassungen benötigen versionierte Contracts und explizit aktualisierte
241	Abnahmematrizen; ursprüngliche Befunde dürfen daraus nicht automatisch geschlossen
242	werden. Ist eine wesentliche Vereinfachung nur durch neue große Sonderinfrastruktur
243	erreichbar, wird der Zielkonflikt erneut vorgelegt. Diese Zielentscheidung ist
244	keine Behauptung bereits migrierter oder abgenommener Ausführung und autorisiert
245	keinen vorzeitigen Hosteingriff oder Deployment.
246	
247	## D19 — Reihenfolge und Test-Refactoring vor Ausführungsmigration
248	
249	Am 2026-10-12 hat der Auftraggeber folgende Priorität vorgegeben:
250	
251	1. **CONFIG-Zentralisierung** gemäß D17.
252	2. **Test-Refactoring**, dessen genaue Vorgaben in einer anderen Session geplant werden.
253	3. **Cgroup-/Worker-Ausführungsrefactoring** gemäß D18.
254	4. **Die zwölf weiterhin offenen historischen Findings** mit erneuter Bewertung
255	   nach den vorangehenden Änderungen.
256	
257	Das Test-Refactoring ist als eigener Arbeitspunkt aufgenommen. Es soll vermeiden,
258	dass Tests späterer Implementierungen erst nachträglich neu kategorisiert werden
259	müssen. Kategorien, Verzeichnisse, Runner-/CI-Verträge und weitere Testvorgaben
260	werden aus dem tatsächlich freigegebenen Ergebnis dieser anderen Session übernommen,
261	nicht in diesem Dokument erfunden. Bis dahin bleiben bestehende echte Tests Pflicht,
262	auch für die vorgelagerte CONFIG-Arbeit. Diese vorhandenen Tests werden in Phase 2
263	in den neuen Standard überführt; Phase 3/4 erstellen neue Tests nach diesem Standard.
264	
265	Die Reihenfolge ersetzt die frühere vorgeschlagene Reihenfolge in der
266	Bestandsaufnahme. Sie ist keine Statuspromotion und kein Grund, vorhandene
267	Änderungen zu verwerfen. Überschneidungen, insbesondere ENGINE001/ENGINE004/
268	IFR10/IFR16 und CONFIG/IFR29, erhalten genau eine Zuordnung und gemeinsame Belege.
269	Eine Teilbehebung in Phase 1 oder 3 zählt in Phase 4 erst nach vollständiger
270	Findingabnahme; keine doppelte Umsetzung oder automatische Schließung.
271	
272	Der unmittelbare Auftrag ist die dauerhafte Dokumentation dieser Entscheidungen
273	und des detaillierten Umfangs. Beginn und konkreter Umfang einzelner
274	Implementierungspakete werden im gemeinsamen Entscheidungsmodus anhand ihrer
275	Abnahmekriterien festgelegt; diese Nachricht startet noch keine Codeumsetzung.
276	
277	## D20 — Zentraler Systemeinstieg und dynamische Modulprofile
278	
279	Am 2026-10-12 hat der Auftraggeber die CONFIG-Definition anhand des tatsächlichen
280	Codes beauftragt und folgende Präzisierungen bestätigt:
281	
282	- `pipeline.json` ist der gemeinsame Systemeinstieg mit Referenzen auf
283	  Komponenten, Pipelineabläufe und Profile. Konkrete Settings liegen in der
284	  jeweils zuständigen Engine-/Plugin-/Core-/Worker-Core-Konfiguration;
285	  keine zweite Kopie dieser Settings im Einstieg.
286	- Möglichst alle sinnvoll anpassbaren Komponentenparameter sollen ohne
287	  Quellcodeänderung konfigurierbar und für spätere Komponentenevals nutzbar sein.
288	  Dazu gehören geeignete Agent-/Modell-/Prompt-/Providerprofile, nicht nur Limits.
289	- Geeignete Tuningänderungen gelten ab dem **nächsten Modulstart**, einschließlich
290	  noch nicht gestarteter Module einer laufenden Pipeline. Die bereits gestartete
291	  fachliche Moduleinheit behält ihren dokumentierten Stand. Graph-/Berechtigungs-/
292	  Recoverygrundlagen bleiben stabil. Evals verwenden eine feste Generation.
293	- Profile bleiben validiert, vollständig und in ihren Zuständigkeiten eindeutig.
294	  Neue Generationen resetten keine verbrauchten Reparaturbudgets, beseitigen
295	  keine ungewissen Seiteneffekte und setzen historische Abnahmen nicht außer Kraft.
296	
297	Die [codegestützte CONFIG-Definition](config-definition-20261012.md) beschreibt
298	den vorgeschlagenen vollständigen Scope, Änderungen, Bedienung und Abnahme;
299	die [Inventuranlage](config-scope-inventory-20261012.json) erfasst die heutigen
300	48 deklarierten Plugins und ihre 57 Configschemas. Sie ist keine fertige
301	semantische F1-Feld-/Consumerabnahme. Die physische Autorenwurzel, exakte
302	Scopezuordnung und konkreten Migrationspakete werden daraus gemeinsam festgelegt.
303	
304	D17 bleibt maßgeblich. Der derzeitige `--pipeline`-Eingang für konkrete Graphen
305	ist vom neuen Systemeinstieg ausdrücklich zu unterscheiden und zu migrieren.
306	Kein generisches Hotreload laufender Arbeit, keine stillen Fallbacks und keine
307	neue große Configserverinfrastruktur aus dieser Entscheidung ableiten.
308	Dieser Auftrag definiert CONFIG; noch keine neue Codebehebung integriert.
309	
