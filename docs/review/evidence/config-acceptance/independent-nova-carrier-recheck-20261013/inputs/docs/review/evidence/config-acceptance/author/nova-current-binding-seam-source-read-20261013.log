116	function projectModules(project: ObjectValue, runId: string, projectId: string): Map<string, ObjectValue> {
117	  if (!Array.isArray(project.modules) || !project.modules.length || project.modules.length > 128) throw new Error('PROJECT_MODULES_INVALID');
118	  const modules = new Map<string, ObjectValue>();
119	  const owned: { module: string; prefix: string }[] = [];
120	  for (const value of project.modules) {
121	    const module = object(value, ['id', 'dependsOn', 'task', 'ownedPaths', 'requirements', 'implementation', 'lint', 'review', 'test', 'blueprint'], 'module');
122	    const moduleId = id(module.id);
123	    if (modules.has(moduleId)) throw new Error(`PROJECT_MODULE_DUPLICATE:${moduleId}`);
124	    text(module.task, 'task');
125	    strings(module.dependsOn, 'dependsOn', true).forEach(id);
126	    for (const prefix of strings(module.ownedPaths, 'ownedPaths').map(relative)) {
127	      if (owned.some(item => prefix === item.prefix || prefix.startsWith(`${item.prefix}/`) || item.prefix.startsWith(`${prefix}/`))) throw new Error(`PROJECT_OWNERSHIP_OVERLAP:${moduleId}:${prefix}`);
128	      owned.push({ module: moduleId, prefix });
129	    }
130	    validateRequirements(module, moduleId);
131	    validateModuleRuntime(module, moduleId, runId, projectId);
132	    modules.set(moduleId, module);
133	  }
134	  return modules;
135	}
136	
137	function orderedModules(modules: ReadonlyMap<string, ObjectValue>): ObjectValue[] {
138	  // Stable topological order, independent of JSON object/array declaration order.
139	  const ordered: ObjectValue[] = [];
140	  const remaining = new Set([...modules.keys()].sort());
141	  for (const module of modules.values()) for (const dependency of module.dependsOn) {
142	    if (!modules.has(dependency)) throw new Error(`PROJECT_DEPENDENCY_UNKNOWN:${dependency}`);
143	  }
144	  while (remaining.size) {
145	    const next = [...remaining].find(key => modules.get(key)!.dependsOn.every((dependency: string) => !remaining.has(dependency)));
146	    if (next === undefined) throw new Error('PROJECT_DEPENDENCY_CYCLE');
147	    ordered.push(modules.get(next)!); remaining.delete(next);
148	  }
149	  return ordered;
150	}
