25	  const reviewCacheProfile = snapshot.schemaVersion === 'run-snapshot.v4' ? snapshot.reviewCacheProfile : undefined;
26	  await assertEffectRecoverySafe(context.runRoot, context.runId, context.definition, context.events);
27	  const adapters = createAdapterRuntime(context.platform, context.runRoot, context.runtime, context.events); await adapters.start();
28	  const flush = serializedObserverDrainer(context.platform, context.runRoot, context.runtime, adapters, context.events);
29	  try { return await new PipelineRunner({ definition: context.definition, registry: context.runtime.granted, activated: context.runtime.activated,
30	    adapters, journal: context.events, orchestratorIssuerId: context.platform.orchestratorIssuerId, signal: context.leaseSignal,
31	    onEventsCommitted: flush, ...options, graphSnapshotVersion: pinnedGraph.schemaVersion,
32	    runtimeDispatchProfile, reviewCacheProfile }).run(context.runId); }
33	  finally { try { await flush(); } finally { await adapters.shutdown(); } }
34	}
