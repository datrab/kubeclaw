72	function dueRecoveryStates(recovered: ReadonlyMap<string, StageRuntimeState>): Map<string, StageRuntimeState> {
73	  const states = new Map<string, StageRuntimeState>();
74	  for (const [stageId, state] of recovered) {
75	    if (!state.retryAt) { states.set(stageId, state); continue; }
76	    if (Date.now() < Date.parse(state.retryAt)) throw new Error(`RECOVERY_COOLDOWN_NOT_DUE:${stageId}:${state.retryAt}`);
77	    const { retryAt: _retryAt, ...withoutCooldown } = state; states.set(stageId, { ...withoutCooldown, status: 'pending' });
78	  }
79	  return states;
80	}
