108: async function invokeArtifact(
109:   records: DurableRecordStore,
110:   blobs: DurableBlobStore,
111:   maximumArtifactBytes: number,
112:   invocation: AdapterInvocation,
113: ): Promise<Readonly<Record<string, unknown>>> {
114:   const { request, signal, confidential, fence } = invocation;
115:   if (!confidential) fence.assertCurrent();
116:   if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
117:   const artifactId = requiredText(request.resource.canonicalId, 'ID');
118:   if (request.capability === 'artifacts.read' && ['get_json', 'get_json_bytes'].includes(request.operation)) {
119:     const digest = digestValue(request.payload.digest);
120:     const namespace = requiredText(request.payload.namespace, 'NAMESPACE');
121:     const stored = await findArtifact(records, blobs, artifactId, namespace, (entry) => entry.digest === digest, expectedReference(request));
122:     return request.operation === 'get_json_bytes' ? stored : { value: stored.value, digest: stored.digest, sizeBytes: stored.sizeBytes, artifact: stored.artifact };
123:   }
124:   if (request.capability === 'artifacts.read' && ['get_latest_json', 'get_latest_json_bytes'].includes(request.operation)) {
125:     const namespace = requiredText(request.payload.namespace, 'NAMESPACE');
126:     const stored = await findArtifact(records, blobs, artifactId, namespace, (entry) => entry.producer.runId === request.attempt.runId);
127:     return request.operation === 'get_latest_json_bytes' ? stored : { value: stored.value, digest: stored.digest, sizeBytes: stored.sizeBytes, artifact: stored.artifact };
128:   }
129:   if (request.capability !== 'artifacts.write' || request.operation !== 'put_json') {
130:     throw new Error(`ARTIFACT_OPERATION_UNSUPPORTED:${request.capability}:${request.operation}`);
131:   }
132:   const namespace = requiredText(request.payload.namespace, 'NAMESPACE');
133:   const mediaType = requiredText(request.payload.mediaType, 'MEDIA_TYPE');
134:   if (mediaType !== 'application/json') throw new Error('ARTIFACT_MEDIA_TYPE_UNSUPPORTED');
135:   const {encoding, bytes} = encodeArtifactJson(request.payload);
136:   if (bytes.byteLength > maximumArtifactBytes) throw new Error('ARTIFACT_SIZE_EXCEEDED');
137:   const digest = `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}`;
138:   const artifact: ArtifactRef = {
139:     artifactId,
140:     namespace,
141:     mediaType,
142:     digest,
143:     sizeBytes: bytes.byteLength,
144:     producer: request.attempt,
145:     ...(encoding === PORTABLE_JSON_ENCODING ? {encoding} : {}),
146:   };
