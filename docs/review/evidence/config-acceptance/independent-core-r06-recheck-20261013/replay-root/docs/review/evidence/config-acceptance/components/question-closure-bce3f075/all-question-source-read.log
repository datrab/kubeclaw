39:   readonly requestDigest: string;
40:   readonly remoteResultDigest: string | null;
41:   readonly remoteResult: RemotePlanResultV1 | null;
42:   readonly evidenceDigests: string[];
43:   readonly decision: GateDecisionV1;
44:   readonly state: 'pending_evidence' | 'complete';
45: }
46: 
47: function retainedResult(stored: StoredGateImportV2 | undefined, job: RemotePlanJobV1): RemotePlanResultV1 {
48:   if (!stored || stored.schemaVersion !== 'nova-test-gate-import.v2' || stored.state !== 'complete'
49:     || !stored.remoteResult || stored.jobId !== job.jobId || !same(stored.source, importSource(job))
50:     || stored.requestDigest !== job.requestDigest || stored.remoteResultDigest !== stored.remoteResult.resultDigest) {
51:     throw new Error('NOVA_DISPATCH_RETENTION_IMPORT_REQUIRED');
52:   }
53:   return stored.remoteResult;
54: }
55: 
56: function assertSameImport(existing: StoredGateImportV2, pending: StoredGateImportV2): void {
57:   if (existing.schemaVersion !== 'nova-test-gate-import.v2' || !same(existing.source, pending.source)
58:     || existing.requestDigest !== pending.requestDigest || existing.remoteResultDigest !== pending.remoteResultDigest
59:     || existing.decision.decisionDigest !== pending.decision.decisionDigest || !same(existing.evidenceDigests, pending.evidenceDigests)) {
60:     throw new Error('NOVA_REMOTE_IMPORT_CONFLICT');
61:   }
62: }
