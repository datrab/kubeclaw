3: function storageBytes(value: unknown): bigint {
4:     const quantity = text(value, 'persistentVolumeClaim.storage', 64);
5:     const parsed = STORAGE_QUANTITY.exec(quantity);
6:     if (!parsed)
7:         throw new Error(`KUBERNETES_FIXTURE_STORAGE_QUANTITY_INVALID:${quantity}`);
8:     const mantissa = parsed[1]!;
9:     const decimalPlaces = mantissa.includes('.') ? mantissa.length - mantissa.indexOf('.') - 1 : 0;
10:     let numerator = BigInt(mantissa.replace('.', ''));
11:     let denominator = 10n ** BigInt(decimalPlaces);
12:     const binaryPowers = new Map([['Ki', 10n], ['Mi', 20n], ['Gi', 30n], ['Ti', 40n], ['Pi', 50n], ['Ei', 60n]]);
13:     const decimalPowers = new Map([['n', -9], ['u', -6], ['m', -3], ['k', 3], ['K', 3],
14:         ['M', 6], ['G', 9], ['T', 12], ['P', 15], ['E', 18]]);
15:     if (parsed[2])
16:         numerator *= 1n << binaryPowers.get(parsed[2])!;
17:     const exponent = parsed[3] ? decimalPowers.get(parsed[3])!
18:         : parsed[4] ? Number.parseInt(parsed[4].slice(1), 10) : 0;
19:     if (!Number.isSafeInteger(exponent) || Math.abs(exponent) > 63) {
20:         throw new Error(`KUBERNETES_FIXTURE_STORAGE_QUANTITY_INVALID:${quantity}`);
21:     }
22:     if (exponent >= 0)
23:         numerator *= 10n ** BigInt(exponent);
24:     else
25:         denominator *= 10n ** BigInt(-exponent);
26:     if (numerator < 1n || numerator % denominator !== 0n) {
27:         throw new Error(`KUBERNETES_FIXTURE_STORAGE_QUANTITY_INVALID:${quantity}`);
28:     }
29:     return numerator / denominator;
30: }
31: export function persistentVolumeClaims(document: JsonObject): {
32:     name: string;
33:     spec: JsonObject;
34:     copies: bigint;
35: }[] {
36:     if (document.kind === 'PersistentVolumeClaim') {
37:         const metadata = object(document.metadata, 'persistentVolumeClaim.metadata');
38:         return [{ name: text(metadata.name, 'persistentVolumeClaim.metadata.name', 253),
39:                 spec: object(document.spec, 'persistentVolumeClaim.spec'), copies: 1n }];
40:     }
41:     if (document.kind !== 'StatefulSet')
42:         return [];
43:     const spec = object(document.spec, 'statefulSet.spec');
44:     const replicas = spec.replicas ?? 1;
45:     if (!Number.isSafeInteger(replicas) || Number(replicas) < 0) {
46:         throw new Error('KUBERNETES_FIXTURE_STATEFULSET_REPLICAS_INVALID');
47:     }
