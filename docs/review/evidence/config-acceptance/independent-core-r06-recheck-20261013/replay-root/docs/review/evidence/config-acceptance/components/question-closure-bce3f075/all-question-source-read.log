194: export function activate(context: AdapterActivationContext): AdapterInstance {
195:   const config = readConfig(context.config);
196:   const targets = config.targets;
197:   const records = new FileDurableRecordStore(config.deliveryRoot, {
198:     maximumRecords: config.maximumDeliveryRecords,
199:     maximumBytes: config.maximumDeliveryBytes,
200:     maximumRecordBytes: DELIVERY_RECORD_MAX_BYTES,
201:   });
202:   let shuttingDown = false;
203:   return {
204:     async ready() {
205:       if (shuttingDown) throw new Error('ADAPTER_SHUTTING_DOWN');
206:     },
207:     async invoke({ request, signal, confidential, fence }) {
208:       if (!confidential) fence.assertCurrent();
209:       if (shuttingDown) throw new Error('ADAPTER_SHUTTING_DOWN');
210:       if (request.capability !== 'transport.publish' || request.operation !== 'publish') {
211:         throw new Error('TRANSPORT_OPERATION_UNSUPPORTED');
212:       }
213:       if (request.resource.type !== 'transport.target') {
214:         throw new Error('TRANSPORT_RESOURCE_TYPE_INVALID');
215:       }
216:       if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
217:       const target = targets.get(request.resource.canonicalId);
218:       if (!target) throw new Error(`TRANSPORT_TARGET_UNKNOWN:${request.resource.canonicalId}`);
219:       const publication = publicationBody(request.payload, target.maxPayloadBytes);
220:       const stream = `publications/${request.resource.canonicalId}`;
221:       const requestKey = deliveryRecordKey(request.idempotencyKey, 'request');
222:       await records.append(stream, requestKey, {
223:         schemaVersion: 'transport-publication-request.v1',
224:         idempotencyKey: request.idempotencyKey,
225:         target: request.resource.canonicalId,
226:         message: publication.body,
227:       });
228:       const prior = await records.read<Readonly<Record<string, unknown>>>(stream);
229:       const completed = completedReceipt(prior, request.idempotencyKey);
230:       if (completed) return completed;
231:       const terminalKey = terminalRecordKey(
232:         request.idempotencyKey,
233:         request.attempt.attemptId,
234:         request.attempt.attemptNumber,
235:       );
236:       const existingTerminal = prior.find((entry) => entry.idempotencyKey === terminalKey);
237:       const reservation = existingTerminal
238:         ? { appended: false, record: existingTerminal }
239:         : await records.append<Readonly<Record<string, unknown>>>(stream, terminalKey, {
240:           schemaVersion: 'transport-publication-reservation.v1',
241:           attempt: request.attempt,
242:           reserved: ' '.repeat(TERMINAL_RESERVATION_BYTES),
243:         });
244:       if (!reservation.appended) {
245:         if (reservation.record.payload.schemaVersion === 'transport-publication-receipt.v1') {
246:           return reservation.record.payload.receipt as Readonly<Record<string, unknown>>;
247:         }
248:         if (reservation.record.payload.schemaVersion === 'transport-publication-failure.v1') {
249:           throw new Error(String(reservation.record.payload.error));
250:         }
251:       }
252:       try {
253:         const resolved = await context.invoke('secrets.read', {
254:           operation: 'resolve',
255:           resource: { type: 'secret.name', canonicalId: target.signingSecret },
256:           payload: {},
257:         });
258:         if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
259:         const signature = crypto
260:           .createHmac('sha256', secretValue(resolved))
261:           .update(`${request.resource.canonicalId}\n${request.idempotencyKey}\n${publication.serialized}`)
262:           .digest('hex');
263:         const response = await context.invoke('network.http', {
264:           operation: 'request',
265:           resource: { type: 'network.url', canonicalId: target.endpoint },
266:           payload: {
267:             method: 'POST',
268:             headers: {
269:               'content-type': 'application/json',
270:               'idempotency-key': request.idempotencyKey,
271:               'x-kubeclaw-target': request.resource.canonicalId,
272:               'x-kubeclaw-signature': `sha256=${signature}`,
273:             },
274:             body: publication.body,
275:           },
276:         });
277:         if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
278:         const receipt = validateResponse(response);
279:         const result = Object.freeze({
280:           accepted: true,
281:           target: request.resource.canonicalId,
282:           publicationId: receipt.publicationId,
283:           status: receipt.status,
284:         });
285:         try {
286:           const committed = await records.transition(stream, terminalKey, reservation.record.payloadDigest, {
287:             schemaVersion: 'transport-publication-receipt.v1',
288:             attempt: request.attempt,
289:             receipt: result,
290:           });
291:           return committed.payload.receipt as Readonly<Record<string, unknown>>;
292:         } catch (error) {
293:           if (error instanceof Error && error.message === 'DURABLE_RECORD_TRANSITION_CONFLICT') {
294:             const current = await records.read<Readonly<Record<string, unknown>>>(stream);
295:             const accepted = completedReceipt(current, request.idempotencyKey);
296:             if (accepted) return accepted;
297:             const terminal = current.find((entry) => entry.idempotencyKey === terminalKey);
298:             if (terminal) {
299:               const reconciled = await records.transition(stream, terminalKey, terminal.payloadDigest, {
300:                 schemaVersion: 'transport-publication-receipt.v1',
301:                 attempt: request.attempt,
302:                 receipt: result,
303:               });
304:               return reconciled.payload.receipt as Readonly<Record<string, unknown>>;
305:             }
306:           }
307:           throw error;
308:         }
309:       } catch (error) {
310:         const reason = error instanceof Error ? error.message : String(error);
311:         const reasonId = crypto.createHash('sha256').update(reason).digest('hex').slice(0, 16);
312:         const boundedReason = reason.slice(0, 2_048);
313:         try {
314:           await records.transition(stream, terminalKey, reservation.record.payloadDigest, {
315:             schemaVersion: 'transport-publication-failure.v1',
316:             idempotencyKey: request.idempotencyKey,
317:             target: request.resource.canonicalId,
318:             attempt: request.attempt,
319:             reasonId,
320:             error: boundedReason,
321:           });
322:         } catch (transitionError) {
323:           if (transitionError instanceof Error && transitionError.message === 'DURABLE_RECORD_TRANSITION_CONFLICT') {
324:             const accepted = completedReceipt(
325:               await records.read<Readonly<Record<string, unknown>>>(stream),
326:               request.idempotencyKey,
327:             );
328:             if (accepted) return accepted;
329:           }
330:           throw transitionError;
331:         }
332:         throw error;
333:       }
334:     },
335:     async shutdown() {
336:       shuttingDown = true;
337:     },
338:   };
339: }
