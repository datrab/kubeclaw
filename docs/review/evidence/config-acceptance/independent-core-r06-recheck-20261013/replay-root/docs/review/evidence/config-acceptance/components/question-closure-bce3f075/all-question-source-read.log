60: function validClockTime(match: RegExpExecArray): boolean {
61:   const hour = Number(match[4]);
62:   const minute = Number(match[5]);
63:   const second = Number(match[6]);
64:   const offsetSign = match[8] === '-' ? -1 : 1;
65:   const offsetHour = Number(match[9] ?? 0);
66:   const offsetMinute = Number(match[10] ?? 0);
67:   if (offsetHour > 23 || offsetMinute > 59) return false;
68:   if (hour <= 23 && minute <= 59 && second < 60) return true;
69:   const utcMinute = minute - offsetMinute * offsetSign;
70:   const utcHour = hour - offsetHour * offsetSign - (utcMinute < 0 ? 1 : 0);
71:   return (utcHour === 23 || utcHour === -1)
72:     && (utcMinute === 59 || utcMinute === -1)
73:     && second < 61;
74: }
