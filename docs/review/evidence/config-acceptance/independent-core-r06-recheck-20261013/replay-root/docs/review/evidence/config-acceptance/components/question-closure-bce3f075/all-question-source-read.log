178: test('original completed import projects duplicate bytes with real quotas and exact HTTP replay', { timeout: 60000 }, async t => {
179:   const f = await fixture(t), file = recordsFile(f.scope.intent.dispatchRoot), before = fs.readFileSync(file);
180:   const importBytes = fs.readFileSync(recordsFile(f.scope.intent.importRoot));
181:   const blob = blobFile(f.scope.intent.dispatchRoot, f.job.repositoryArchive.contentDigest), archive = fs.readFileSync(blob);
182:   const second = newJob(f.job, 'projection:active');
183:   const quota = { ...dispatchOptions, recordLimits: { ...recordLimits, maximumBytes: before.length + 8192, maximumRecords: 2 } };
184:   const store = new FileNovaRemotePlanStore(f.scope.intent.dispatchRoot, quota);
185:   await assert.rejects(store.persistBeforeDispatch(second), /DURABLE_RECORD_STORE_FULL/);
186:   const scope = { ...f.scope, dispatchOptions: quota };
187:   const receipt = await retireNovaDispatch(scope);
188:   assert.equal(receipt.newlyProjected, true); assert.equal(receipt.releasedBytes, before.length - fs.statSync(file).size);
189:   assert.ok(receipt.releasedBytes > 32768);
190:   assert.deepEqual(fs.readFileSync(blob), archive); assert.deepEqual(fs.readFileSync(recordsFile(f.scope.intent.importRoot)), importBytes);
191:   assert.equal(json(file).records.length, 1); assert.equal(json(file).records[0].payload.schemaVersion, 'nova-remote-plan-dispatch-projected.v1');
192:   assert.equal('data' in json(file).records[0].payload.job.repositoryArchive, false);
193:   assert.deepEqual(await store.load(f.job.jobId), f.job);
194:   assert.deepEqual(await store.persistBeforeDispatch(f.job), f.job);
195:   assert.equal('data' in json(file).records[0].payload.job.repositoryArchive, false);
196:   assert.deepEqual(await retireNovaDispatch(scope), { ...receipt, newlyProjected: false, releasedBytes: 0 });
197:   await store.persistBeforeDispatch(second);
198:   assert.equal(json(file).records.length, 2);
199:   await assert.rejects(store.persistBeforeDispatch(newJob(f.job, 'projection:third')), /DURABLE_RECORD_STORE_FULL/);
200:   const imports = new FileNovaGateImportStore(f.scope.intent.importRoot, importOptions);
201:   const graphBefore = await imports.readExecutionGraphs(), posts = f.posts(), requests = f.requests();
202:   const transport = new HttpRemotePlanTransport({ endpoint: f.endpoint, token, maximumResponseBytes: 1024 ** 2 });
203:   const dispatcher = new NovaRemotePlanDispatcher({ store: new FileNovaRemotePlanStore(f.scope.intent.dispatchRoot, quota), transport, pollMilliseconds: 10 });
204:   const terminal = await dispatcher.dispatch(f.job, { timeoutMs: 5000 });
205:   assert.equal(terminal.state, 'completed'); assert.equal(f.posts(), posts); assert.equal(f.requests(), requests);
206:   assert.deepEqual(await new FileNovaGateImportStore(f.scope.intent.importRoot, importOptions).readExecutionGraphs(), graphBefore);
207:   assert.deepEqual(json(recordsFile(f.scope.intent.importRoot)).records[0].payload.decision, f.imported.payload.decision);
208:   assert.equal((await f.buster.records()).length, 1);
209: });
