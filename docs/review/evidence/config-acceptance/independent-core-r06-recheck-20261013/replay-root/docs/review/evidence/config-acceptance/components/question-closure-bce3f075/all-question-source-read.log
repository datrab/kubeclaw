162:   exactKeys(value.body, ['accepted', 'publicationId'], 'TRANSPORT_RESPONSE_BODY_INVALID');
163:   if (value.body.accepted !== true) throw new Error('TRANSPORT_PUBLICATION_REJECTED');
164:   if (typeof value.body.publicationId !== 'string' || !PUBLICATION_ID.test(value.body.publicationId)) {
165:     throw new Error('TRANSPORT_PUBLICATION_ID_INVALID');
