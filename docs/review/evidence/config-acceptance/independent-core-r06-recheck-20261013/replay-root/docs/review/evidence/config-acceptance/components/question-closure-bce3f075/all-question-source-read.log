124: /** Called only with the original journal result and positive native quiescence. */
125: export async function publishHistoricalImport(options: PreparationExecutionOptions, stateRoot: string,
126:   result: WorkerAttemptResultV3, binding: PreparationGateBinding): Promise<HistoricalImportReceipt> {
127:   if (process.getuid?.() !== 0) throw new Error('BUSTER_HISTORICAL_ROOT_REQUIRED');
128:   const receipt = historicalResultReceipt(result);
129:   const reservations = await options.ledger.reservations();
130:   const reservation = reservations.find(item => item.admissionId === receipt.importId);
131:   if (!reservation || reservation.attemptSpecDigest !== receipt.attemptSpecDigest
132:     || reservation.slot !== receipt.preparationUid || preparationDigest(reservation.historicalDescriptor) !== preparationDigest(receipt.descriptor)
133:     || preparationDigest(reservation.gate) !== preparationDigest(binding)) throw new Error('BUSTER_HISTORICAL_RESULT_UNBOUND');
134:   const envelope = reservation.envelope;
135:   const owner = await options.owner.record({ workerId: envelope.claim.workerId, attemptId: envelope.attemptId,
136:     claimId: envelope.claim.claimId, generation: envelope.claim.generation, profileDigest: envelope.profile.profileDigest,
137:     attemptSpecDigest: envelope.attemptSpecDigest });
138:   if (owner?.phase !== 'disposed' || owner.finalObservation?.populated !== false) {
139:     throw new Error('BUSTER_HISTORICAL_QUIESCENCE_UNPROVEN');
140:   }
141:   await retainPreparationGate(options.command.sourceRoot, receipt.importId, binding);
142:   const group = path.join(options.command.sourceRoot, receipt.importId);
143:   const file = path.join(group, 'historical-receipt.json');
144:   return withDurableStoreLock(file, async () => {
145:     if (reservation.phase === 'retained-historical') {
146:       if (reservation.groupReceiptDigest !== preparationDigest(receipt)) throw new Error('BUSTER_HISTORICAL_RECEIPT_CHANGED');
147:       const actual = await digestHistoricalFile(file, options.settings.maximumResultBytes);
148:       // Stored receipt uses the exact canonical codec, so its raw identity is
149:       // the same digest as its canonical semantic identity.
150:       if (actual.originalStoreDigest !== preparationDigest(receipt)) throw new Error('BUSTER_HISTORICAL_RECEIPT_CHANGED');
151:       return receipt;
152:     }
153:     await publishCandidate(options, stateRoot, group, receipt);
154:     await writeDurableState(file, receipt);
155:     await fs.chmod(file, 0o400);
156:     await sync(group);
157:     await options.ledger.retainedHistorical(receipt.importId, preparationDigest(receipt));
158:     return receipt;
159:   });
160: }
