63:   'namespace-lease-denied': 'final-buster',
64:   'tailscale-exposure-url-unreachable': 'final-buster',
65:   'tailscale-exposure-wrong-content': 'final-buster',
66:   'pipeline-summary-failure': 'summary',
67:   'redis-unavailable': null,
68:   'k8s-context-invalid': 'final-buster',
69:   'registry-pull-failure': 'final-buster',
70:   'git-credential-failure': 'forge-01-nginx',
71:   'git-non-fast-forward': 'forge-01-nginx',
72:   'git-merge-conflict': 'forge-01-nginx',
73:   'git-commit-failure': 'forge-01-nginx',
74:   'forge-timeout': 'forge-01-nginx',
75:   'buster-module-timeout': 'buster-01-nginx',
76:   'echo-gate-timeout': 'module-review',
77:   'final-review-timeout': 'final-review',
78:   'pipeline-review-timeout': 'summary',
79:   'pipeline-cancelled': null,
80:   'multi-module-dependency-blocked': 'buster-01-nginx',
81: });
82: const BLOCKED_SCENARIOS = new Set([
83:   'approval-deny',
84:   'approval-timeout-block',
85:   'buster-module-infra-failure',
86:   'needs-nova-code-failure',
87:   'retry-budget-exhausted',
88:   'retry-buster-pass-echo-rejects',
89:   'architecture-validator-block',
90:   'buster-gate-failure',
91:   'namespace-lease-denied',
92:   'forge-timeout',
93:   'buster-module-timeout',
94:   'echo-gate-timeout',
95:   'final-review-timeout',
96:   'pipeline-review-timeout',
97:   'multi-module-dependency-blocked',
98: ]);
99: const FAILURE_DIAGNOSTICS = Object.freeze({
100:   'architecture-validator-block': ['arch_validation_blocked'],
101:   'git-credential-failure': ['permission denied', 'git_credential'],
102:   'git-non-fast-forward': ['non-fast-forward'],
103:   'git-merge-conflict': ['git_rebase_conflict', 'merge conflict'],
104:   'git-commit-failure': ['pre-commit', 'git_commit'],
105:   'pipeline-cancelled': ['cancel'],
106:   'namespace-lease-denied': ['namespace', 'lease'],
107:   'registry-pull-failure': ['registry', 'pull'],
108:   'k8s-context-invalid': ['k8s', 'context'],
109:   'k8s-pod-never-ready': ['ready', 'timeout'],
110:   'tailscale-exposure-url-unreachable': ['tailscale', 'unreachable'],
111:   'tailscale-exposure-wrong-content': ['tailscale', 'deployment'],
112: });
