317: const EMBEDDED_ATTEMPT_LIMITS = {
318:   maximumEvidenceObjects: 100_000,
319:   maximumEvidenceBytes: 10 * 1024 * 1024 * 1024,
320:   maximumEvidenceObjectBytes: 1024 * 1024 * 1024,
321:   maximumResults: 100_000,
322:   maximumClosures: 100_000,
323:   maximumMetadataBytes: 1024 * 1024 * 1024,
324:   maximumPendingEvidenceAgeMs: 60 * 60 * 1000,
325: } as const;
326: const EMBEDDED_ADMISSION_LIMITS = {
327:   maximumIngressBytes: 16 * 1024 * 1024,
328:   maximumRecords: 1_000_000,
