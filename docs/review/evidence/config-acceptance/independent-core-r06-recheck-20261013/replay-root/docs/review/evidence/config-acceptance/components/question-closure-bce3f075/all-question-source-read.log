133:   async records(): Promise<ReadonlyArray<DurableRecord<StoredPlanJob>>> {
134:     const records = await this.#records.read<StoredPlanJob>('buster-plan-jobs');
135:     for (const { payload } of records) {
136:       if (payload.schemaVersion === 'buster-plan-job-compacted-record.v1') {
