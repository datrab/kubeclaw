6: function readRegularFile(file, maximumBytes, kind) {
7:   const handle = fs.openSync(file, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW | fs.constants.O_NONBLOCK);
8:   try {
9:     const stat = fs.fstatSync(handle);
10:     if (!stat.isFile()) throw new Error(`BUSTER_COMPACTION_${kind}_FILE_INVALID`);
11:     if (!Number.isSafeInteger(stat.size) || stat.size > maximumBytes) throw new Error(`BUSTER_COMPACTION_${kind}_SIZE_INVALID`);
12:     // One extra byte detects growth; allocation follows the bounded opened file, not an arbitrary budget allocation.
13:     const bytes = Buffer.alloc(stat.size + 1);
14:     let total = 0;
15:     while (total < bytes.byteLength) {
16:       const count = fs.readSync(handle, bytes, total, bytes.byteLength - total, total);
17:       if (count === 0) break;
18:       total += count;
19:     }
20:     if (total !== stat.size) throw new Error(`BUSTER_COMPACTION_${kind}_FILE_CHANGED`);
21:     return bytes.subarray(0, total);
22:   } finally { fs.closeSync(handle); }
23: }
