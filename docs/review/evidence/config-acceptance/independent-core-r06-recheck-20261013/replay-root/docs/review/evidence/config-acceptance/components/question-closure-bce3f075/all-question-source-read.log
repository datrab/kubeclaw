19: async function configuredStores(t, name, group, values, nodes = { real: { uses: 'example.generic@1', retries: 0 } }, expectedState = 'completed') {
20:   let attempts;
21:   let admission;
22:   const originalResult = FileDurableAttemptStore.prototype.storeResult;
23:   const originalAdmission = FileObservabilityAdmissionStore.prototype.admitAndRead;
24:   t.mock.method(FileDurableAttemptStore.prototype, 'storeResult', function (...args) {
25:     attempts = this;
26:     return Reflect.apply(originalResult, this, args);
27:   });
28:   t.mock.method(FileObservabilityAdmissionStore.prototype, 'admitAndRead', function (...args) {
29:     admission = this;
30:     return Reflect.apply(originalAdmission, this, args);
31:   });
32:   const root = path.join(temporary, name);
33:   const workspaceRoot = path.join(root, 'workspace');
34:   const repositoryRoot = path.join(workspaceRoot, 'repository');
35:   fs.mkdirSync(repositoryRoot, { recursive: true });
36:   const executionPolicy = validateBusterExecutionSettings({ ...runnerExecutionPolicy,
37:     stores: { ...runnerExecutionPolicy.stores, [group]: { ...runnerExecutionPolicy.stores[group], ...values } } });
38:   const result = await new TestPlanRunner({ plan: plan(nodes),
39:     registry, workspaceRoot, repositoryRoot, artifactRoot: path.join(root, 'artifacts'),
40:     observabilityRoot: path.join(root, 'observability'), maximumConcurrency: 1,
41:     workerLocalRuntime: { drainTimeoutMs: 300000, cancellationTimeoutMs: 30000, replayLimit: 65536 },
42:     executionPolicy,
43:   }).run();
44:   assert.equal(result.attempts[0]?.executionState, expectedState);
45:   assert(attempts);
46:   if (expectedState === 'completed') {
47:     assert.equal(result.attempts[0]?.outcome, 'passed');
48:     assert(admission);
49:   }
50:   return { attempts, admission, result };
51: }
