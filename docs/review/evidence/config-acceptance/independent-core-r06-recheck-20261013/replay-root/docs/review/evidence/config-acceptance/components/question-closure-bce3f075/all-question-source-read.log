188: function childWorker(t, file, mode, data) {
189:   const child = fork(path.resolve(file), [mode, JSON.stringify(data)], { stdio: ['ignore', 'pipe', 'pipe', 'ipc'] });
190:   const messages = [], pending = [];
191:   let stderr = '';
192:   child.stderr.on('data', bytes => { stderr += bytes; });
193:   child.on('message', message => { if (pending.length) pending.shift()(message); else messages.push(message); });
194:   const exit = once(child, 'exit');
195:   t.after(() => { if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL'); });
196:   return { child, exit, next: () => messages.length ? Promise.resolve(messages.shift()) : new Promise(resolve => pending.push(resolve)), stderr: () => stderr };
197: }
