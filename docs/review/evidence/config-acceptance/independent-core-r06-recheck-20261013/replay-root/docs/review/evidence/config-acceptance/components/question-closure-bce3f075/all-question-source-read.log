257:   for (const corrupt of [
258:     state => { state.records.pop(); },
259:     state => { const terminal = state.records[1]; terminal.payload = { schemaVersion: 'notification-delivery-failure.v1', outcome: 'possible', attempt: f.request.attempt }; terminal.payloadDigest = payloadDigest(terminal.payload); },
260:     state => { const request = state.records[0]; request.payload.schemaVersion = 'notification-delivery-request.v2'; request.payloadDigest = payloadDigest(request.payload); },
261:     state => { const terminal = state.records[1]; assert.ok(terminal.payload.attempt); delete terminal.payload.attempt; terminal.payloadDigest = payloadDigest(terminal.payload); },
262:   ]) {
263:     const changed = structuredClone(originalDelivery); corrupt(changed);
264:     assert.notDeepEqual(changed, originalDelivery, 'each fault must alter actual durable authority');
265:     fs.writeFileSync(deliveryFile, JSON.stringify(changed));
266:     const corruptBytes = fs.readFileSync(deliveryFile);
267:     await assert.rejects(retireWaitValue(scope), undefined, `durable authority fault ${faultIndex++} must reject`);
268:     assert.deepEqual(fs.readFileSync(recordFile(f.waitRoot)), before);
269:     assert.deepEqual(fs.readFileSync(deliveryFile), corruptBytes);
270:   }
271:   fs.writeFileSync(deliveryFile, deliveryBytes);
272:   const otherDigest = `sha256:${'0'.repeat(64)}`;
273:   for (const field of ['runJournalHead', 'snapshotDigest', 'eventsDigest', 'effectsDigest', 'signalsDigest', 'rootIdentityDigest', 'originalPayloadDigest']) {
274:     const changed = structuredClone(scope); changed.intent.source[field] = otherDigest;
275:     await assert.rejects(retireWaitValue(changed));
276:     assert.deepEqual(fs.readFileSync(recordFile(f.waitRoot)), before);
277:   }
278:   for (const changed of [
279:     { ...scope.intent, terminalPayloadDigest: otherDigest },
280:     { ...scope.intent, waitRoot: scope.intent.deliveryRoot, deliveryRoot: scope.intent.waitRoot },
281:     { ...scope.intent, waitRoot: scope.intent.deliveryRoot },
282:     { ...scope.intent, source: { ...scope.intent.source, effectKey: 'effect:foreign' } },
283:     { ...scope.intent, source: { ...scope.intent.source, inventoryLimits: { ...scope.intent.source.inventoryLimits, maximumTotalBytes: 1 } } },
284:   ]) {
285:     await assert.rejects(retireWaitValue({ ...scope, intent: changed }));
286:     assert.deepEqual(fs.readFileSync(recordFile(f.waitRoot)), before);
287:   }
288:   const alias = path.join(f.root, 'wait-symlink'); fs.symlinkSync(f.waitRoot, alias);
289:   await assert.rejects(retireWaitValue({ ...scope, intent: { ...scope.intent, waitRoot: alias } }));
290:   assert.deepEqual(fs.readFileSync(recordFile(f.waitRoot)), before);
291:   assert.equal((await retireWaitValue(scope)).newlyProjected, true);
292:   const projected = fs.readFileSync(recordFile(f.waitRoot));
293:   await assert.rejects(retireWaitValue({ ...scope, intent: { ...scope.intent, actor: 'operator:other' } }));
294:   assert.deepEqual(fs.readFileSync(recordFile(f.waitRoot)), projected);
295:   assert.equal(f.received.length, 1);
296: });
