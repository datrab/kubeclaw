59: // Receiver hooks capture the real default Runner-owned stores and delegate every
60: // original call unchanged. The subsequent writes/reclamation are real public-store
61: // operations, not a claim that valid Runner completions generate corrupt input.
62: for (const field of ['maximumEvidenceObjects', 'maximumEvidenceBytes', 'maximumEvidenceObjectBytes']) {
63:   for (const limit of [1, 2]) {
64:     test(`default Runner-owned store enforces ${field}=${limit}`, { timeout: 30000 }, async (t) => {
65:       const values = { [field]: limit };
66:       if (field === 'maximumEvidenceBytes') values.maximumEvidenceObjectBytes = 1;
67:       const { attempts } = await configuredStores(t, `${field}-${limit}`, 'attempts', values);
68:       assert.equal((await attempts.snapshot()).evidence.length, 0, 'generic provider must not prefill evidence quota');
69:       if (field === 'maximumEvidenceObjectBytes') {
70:         const write = () => attempts.storeEvidence(evidenceInput(1), Buffer.from('ab'));
71:         if (limit === 1) await assert.rejects(write, /OBSERVABILITY_EVIDENCE_OBJECT_TOO_LARGE/);
72:         else assert.equal((await write()).artifact.sizeBytes, 2);
73:       } else {
74:         await attempts.storeEvidence(evidenceInput(1), Buffer.from('a'));
