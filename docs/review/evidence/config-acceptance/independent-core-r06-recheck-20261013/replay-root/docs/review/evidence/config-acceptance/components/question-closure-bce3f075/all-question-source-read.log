132: function publicationBody(payload: Readonly<Record<string, unknown>>, maxBytes: number): {
133:   readonly body: Readonly<Record<string, unknown>>;
134:   readonly serialized: string;
135: } {
136:   if (!plainRecord(payload)) throw new Error('TRANSPORT_PAYLOAD_INVALID');
137:   exactKeys(payload, ['message'], 'TRANSPORT_PAYLOAD_UNKNOWN_FIELD');
138:   if (!plainRecord(payload.message)) throw new Error('TRANSPORT_MESSAGE_INVALID');
139:   assertJson(payload.message, new Set(), 0);
140:   const body = Object.freeze({ message: payload.message });
141:   const serialized = JSON.stringify(body);
142:   if (Buffer.byteLength(serialized, 'utf8') > maxBytes) throw new Error('TRANSPORT_PAYLOAD_SIZE_EXCEEDED');
143:   return { body, serialized };
144: }
