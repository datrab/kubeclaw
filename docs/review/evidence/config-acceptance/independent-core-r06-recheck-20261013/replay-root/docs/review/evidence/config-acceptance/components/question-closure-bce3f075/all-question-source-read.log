146: function secretValue(value: Readonly<Record<string, unknown>>): string {
147:   exactKeys(value as Record<string, unknown>, ['value'], 'TRANSPORT_SECRET_RESPONSE_INVALID');
148:   if (typeof value.value !== 'string' || value.value.length === 0 || /[\r\n]/.test(value.value)) {
149:     throw new Error('TRANSPORT_SECRET_INVALID');
150:   }
151:   return value.value;
152: }
