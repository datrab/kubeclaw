53: function evidenceInput(index) {
54:   return { pipelineRunId: 'run:policy-orphan', attemptId: 'attempt:policy-orphan', claimGeneration: 1,
55:     producer: { producerId: 'worker:policy', bootId: 'boot:policy', producerType: 'buster' },
56:     evidenceId: `evidence:${index}`, type: 'log', mediaType: 'text/plain' };
