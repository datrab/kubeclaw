79: export function historicalResultReceipt(result: WorkerAttemptResultV3): HistoricalImportReceipt {
80:   if (result.state !== 'completed' || result.cleanup.state !== 'completed'
81:     || result.specialistResult?.schemaId !== 'buster-historical-import-result.v1') {
82:     throw new Error('BUSTER_HISTORICAL_RESULT_INVALID');
83:   }
84:   const receipt = { ...result.specialistResult.values, schemaVersion: 'buster-historical-import-receipt.v1',
85:     nativeResultDigest: preparationDigest(result) };
86:   assertHistoricalImportReceipt(receipt);
87:   return receipt;
88: }
