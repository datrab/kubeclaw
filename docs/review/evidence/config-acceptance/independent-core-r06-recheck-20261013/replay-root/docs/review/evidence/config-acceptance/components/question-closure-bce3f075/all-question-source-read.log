187:   const digest = crypto.createHash('sha256').update(idempotencyKey).digest('hex');
188:   const completed = records.find((entry) =>
189:     entry.idempotencyKey.endsWith(`:${digest}`)
190:     && entry.payload.schemaVersion === 'transport-publication-receipt.v1');
191:   return completed?.payload.receipt as Readonly<Record<string, unknown>> | undefined;
