25: function snapshot(root) {
26:   const result = {};
27:   const walk = directory => {
28:     for (const item of fs.readdirSync(directory, { withFileTypes: true })) {
29:       const file = path.join(directory, item.name); const stat = fs.lstatSync(file);
30:       if (item.isDirectory()) walk(file);
31:       else result[file] = { bytes: stat.size, mtime: stat.mtimeMs, hash: item.isFile() ? digest(fs.readFileSync(file)) : fs.readlinkSync(file) };
32:     }
33:   };
34:   walk(root); return result;
35: }
36: async function fixture(t, failures = {}) {
