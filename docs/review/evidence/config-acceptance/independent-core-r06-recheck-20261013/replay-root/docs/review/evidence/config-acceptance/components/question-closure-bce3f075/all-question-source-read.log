64:   constructor(root: string, options: BusterPlanJobStoreOptions) {
65:     if (!Number.isSafeInteger(options.maximumResultBytes) || options.maximumResultBytes < 1) {
66:       throw new Error('BUSTER_REMOTE_RESULT_LIMIT_INVALID');
