138: export async function readRunArtifacts(root, runId, namespaces) {
139:   const records = new FileDurableRecordStore(root, { maximumRecords: 100000, maximumBytes: 256 * 1024 * 1024, maximumRecordBytes: 64 * 1024 });
140:   const blobs = new FileDurableBlobStore(root, 16 * 1024 * 1024);
141:   const artifacts = [];
142:   for (const namespace of namespaces) {
143:     for (const record of await records.read(`artifacts/${namespace}`)) {
144:       const artifact = record.payload;
145:       if (artifact.producer?.runId !== runId) continue;
146:       if (artifact.namespace !== namespace || artifact.mediaType !== 'application/json') throw new Error('REAL_E2E_ARTIFACT_METADATA_INVALID');
147:       const bytes = await blobs.get(artifact.digest);
148:       if (bytes.byteLength !== artifact.sizeBytes) throw new Error('REAL_E2E_ARTIFACT_SIZE_MISMATCH');
149:       artifacts.push({ artifact, value: JSON.parse(bytes.toString('utf8')) });
150:     }
151:   }
152:   return artifacts;
153: }
154: 
155: function latestStageArtifacts(artifacts) {
156:   const latest = new Map();
157:   for (const { artifact } of artifacts) {
158:     const { stageId, attemptNumber } = artifact.producer;
159:     if (!Number.isSafeInteger(attemptNumber) || attemptNumber < 1) throw new Error('REAL_E2E_ARTIFACT_ATTEMPT_INVALID');
160:     latest.set(stageId, Math.max(latest.get(stageId) ?? 0, attemptNumber));
161:   }
162:   return artifacts.filter(({ artifact }) => artifact.producer.attemptNumber === latest.get(artifact.producer.stageId));
163: }
164: 
165: function effectRequestsAndReceipts(records) {
166:   const requests = new Map();
167:   const receipts = new Map();
168:   for (const record of records) {
169:     if (record?.entry?.type === 'requested') {
170:       requests.set(record.entry.request.idempotencyKey, record.entry.request);
171:     } else if (record?.entry?.type === 'completed') {
172:       receipts.set(record.entry.receipt.idempotencyKey, record.entry.receipt);
173:     }
174:   }
175:   return { requests, receipts };
176: }
177: 
178: function runRootFor(result) {
179:   return path.join(result.stateRoot, 'runs', String(result.runId).replaceAll(':', '_'));
180: }
181: 
182: function requireScenarioSetupContract(workspace, scenario) {
183:   try {
184:     const progress = readJson(path.join(workspace.swarmDir, 'progress.json'));
185:     const config = readJson(workspace.runConfigPath);
186:     validateRealE2EScenarioSetup({
187:       progress,
188:       config,
189:       projectSrc: workspace.projectSrc,
190:       swarmDir: workspace.swarmDir,
191:       scenarioId: scenario.id,
192:     });
193:     return evidencePass('v2_scenario_setup_contract', {
194:       scenario: scenario.id,
195:       expectedEvidence: scenario.expectedEvidence,
196:     });
197:   } catch (error) {
198:     return evidenceFail('v2_scenario_setup_contract', 'REAL_E2E_V2_SCENARIO_SETUP_INVALID', {
199:       scenario: scenario.id,
200:       failures: Array.isArray(error?.failures) ? error.failures : [],
201:       error: error?.message || String(error),
202:     });
203:   }
204: }
205: 
206: function downstreamStages(stageId) {
207:   if (stageId === null) return [];
208:   const index = EXPECTED_STAGES.indexOf(stageId);
209:   return index < 0 ? [] : EXPECTED_STAGES.slice(index + 1);
210: }
211: 
212: export function expectedFailureContractForScenario(scenario) {
213:   if (!Object.hasOwn(FAILURE_STAGE_BY_SCENARIO, scenario.id)) {
214:     throw new Error(`missing v2 failure contract for scenario: ${scenario.id}`);
215:   }
216:   const cancelled = scenario.id === 'pipeline-cancelled';
217:   const blocked = BLOCKED_SCENARIOS.has(scenario.id);
218:   return Object.freeze({
219:     schemaVersion: 'real-e2e-failure-expectation.v2',
220:     scenarioId: scenario.id,
221:     expectedEvidence: scenario.expectedEvidence,
222:     expectedStageId: FAILURE_STAGE_BY_SCENARIO[scenario.id],
223:     allowedRunEventTypes: Object.freeze(
224:       cancelled ? ['run.cancelled'] : blocked ? ['run.blocked', 'run.failed'] : ['run.failed'],
225:     ),
226:     allowedStageEventTypes: Object.freeze(
227:       cancelled
228:         ? ['stage.cancelled']
229:         : blocked
230:           ? ['stage.blocked', 'stage.failed']
231:           : ['stage.failed'],
232:     ),
233:     diagnosticTokens: Object.freeze(FAILURE_DIAGNOSTICS[scenario.id] ?? []),
234:     setup: realE2EScenarioSetupContract(scenario.id),
235:   });
236: }
