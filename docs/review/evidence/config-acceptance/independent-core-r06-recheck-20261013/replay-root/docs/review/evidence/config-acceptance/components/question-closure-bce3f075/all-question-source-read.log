25: /** Called inside the owned host. The caller streams chunks, never a decoded job. */
26: export async function readPreparationInput(input: AsyncIterable<Uint8Array>,
27:   settings: BusterPreparationSettings, authority: PreparationAuthority, signal: AbortSignal): Promise<{ readonly job: RemotePlanJobV1; readonly wire: Buffer }> {
28:   const chunks: Buffer[] = [];
29:   let count = 0;
30:   for await (const bytes of input) {
31:     signal.throwIfAborted();
32:     count += bytes.byteLength;
33:     if (count > settings.maximumRequestBytes) throw new Error('BUSTER_REMOTE_REQUEST_SIZE_EXCEEDED');
34:     chunks.push(Buffer.from(bytes));
35:   }
36:   signal.throwIfAborted();
37:   const wire = Buffer.concat(chunks, count);
38:   let value: unknown;
39:   try { value = JSON.parse(wire.toString('utf8')); }
40:   catch (error) { throw new Error('BUSTER_REMOTE_REQUEST_INVALID', { cause: error }); }
41:   // Contract validation performs the original canonical base64 and archive digest checks.
42:   validatePipelineTestGateContract('remotePlanJob', value);
43:   const job = value as RemotePlanJobV1;
44:   if (job.repositoryArchive.sizeBytes > settings.maximumArchiveBytes
45:     || job.repositoryArchive.data.length > Math.ceil(settings.maximumArchiveBytes / 3) * 4) {
46:     throw new Error('BUSTER_REMOTE_ARCHIVE_SIZE_EXCEEDED');
47:   }
48:   if (!verifySourceSnapshotAttestation(job.sourceSnapshot,
49:     authority.trustedSourceAuthority, authority.sourceAttestationPublicKey)) throw new Error('BUSTER_SOURCE_ATTESTATION_INVALID');
50:   if (remotePlanJobId(job.idempotencyKey) !== job.jobId) throw new Error('BUSTER_REMOTE_JOB_ID_INVALID');
51:   if (resolvedTestPlanDigest(job.plan) !== job.plan.planDigest) throw new Error('BUSTER_REMOTE_PLAN_DIGEST_MISMATCH');
52:   if (remotePlanJobDigest(job) !== job.requestDigest) throw new Error('BUSTER_REMOTE_REQUEST_DIGEST_MISMATCH');
53:   return { job, wire };
54: }
