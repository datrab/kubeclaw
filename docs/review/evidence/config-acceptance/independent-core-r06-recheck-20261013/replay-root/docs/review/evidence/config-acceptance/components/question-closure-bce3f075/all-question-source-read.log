188: /** A concurrent projection changes physical bytes, never the logical duplicate. */
189: async function concurrentDuplicate(store: FileDurableRecordStore, key: string, wait: WaitRequest,
190:   resolve: RetainedWaitResolver | undefined, assertCurrent: () => void,
191: ): Promise<{ created: false; wait: WaitRequest }> {
192:   const current = (await store.read('waits/all')).find(record => record.idempotencyKey === key);
193:   assertCurrent();
194:   if (current && canonicalJson(storedRecord(current, resolve).wait) === canonicalJson(wait)) return { created: false, wait };
195:   throw new Error('WAIT_IDEMPOTENCY_CONFLICT');
196: }
197: 
198: export function activate(context: AdapterActivationContext): AdapterInstance {
199:   const root = context.config.root;
200:   if (typeof root !== 'string' || root.length === 0) throw new Error('root is required');
201:   const maxEntryBytes = Number(context.config.maxEntryBytes ?? 1_048_576);
202:   const maximumRecords = Number(context.config.maximumRecords ?? 100_000);
203:   const maximumStoreBytes = Number(context.config.maximumStoreBytes ?? 256 * 1024 * 1024);
204:   if (!Number.isSafeInteger(maxEntryBytes) || maxEntryBytes < 1) throw new Error('maxEntryBytes is invalid');
205:   if (!Number.isSafeInteger(maximumRecords) || maximumRecords < 1) throw new Error('maximumRecords is invalid');
206:   if (!Number.isSafeInteger(maximumStoreBytes) || maximumStoreBytes < 1) throw new Error('maximumStoreBytes is invalid');
207:   const store = new FileDurableRecordStore(root, {
208:     maximumRecords,
209:     maximumBytes: maximumStoreBytes,
210:     maximumRecordBytes: maxEntryBytes,
211:   });
212:   const waitStream = 'waits/all';
213:   return {
214:     async ready() { await store.read<StoredWait>(waitStream); },
215:     async invoke({ request, signal, confidential, fence }) {
216:       assertAuthorized(confidential, fence, signal);
217:       if (request.capability !== 'signal.wait') throw new Error('WAIT_OPERATION_UNSUPPORTED');
218:       const existing = (await store.read<StoredWait>(waitStream)).map(record => storedRecord(record, context.resolveRetainedWait));
219:       assertAuthorized(confidential, fence, signal);
220:       if (request.operation === 'read') {
221:         return { waits: existing.map((record) => record.wait) };
222:       }
223:       if (request.operation !== 'create') throw new Error('WAIT_OPERATION_UNSUPPORTED');
224:       const parsed = parsePayload(request.payload);
225:       const duplicate = existing.find((record) => record.idempotencyKey === request.idempotencyKey);
226:       if (duplicate) {
227:         const expected = { ...parsed, waitId: duplicate.wait.waitId, schemaVersion: 'wait-request.v2' };
228:         if (canonicalJson(duplicate.wait) !== canonicalJson(expected)) throw new Error('WAIT_IDEMPOTENCY_CONFLICT');
229:         return { created: false, wait: duplicate.wait };
230:       }
231:       const wait: WaitRequest = {
232:         schemaVersion: 'wait-request.v2',
233:         waitId: `wait:${crypto.createHash('sha256').update(request.idempotencyKey).digest('hex')}`,
234:         ...parsed,
235:       };
236:       const value: StoredWait = {
237:         schemaVersion: 'wait-value.v1',
238:         wait,
239:       };
240:       try {
241:         const committed = await store.append(waitStream, request.idempotencyKey, value);
242:         return { created: committed.appended, wait: storedRecord(committed.record, context.resolveRetainedWait).wait };
243:       } catch (error) {
244:         if (error instanceof Error && error.message === 'DURABLE_RECORD_SIZE_EXCEEDED') throw new Error('WAIT_ENTRY_SIZE_EXCEEDED');
245:         if (error instanceof Error && error.message === 'DURABLE_RECORD_IDEMPOTENCY_CONFLICT') {
246:           return concurrentDuplicate(store, request.idempotencyKey, wait, context.resolveRetainedWait,
247:             () => assertAuthorized(confidential, fence, signal));
248:         }
249:         throw error;
250:       }
251:     },
252:     async shutdown() {},
253:   };
254: }
