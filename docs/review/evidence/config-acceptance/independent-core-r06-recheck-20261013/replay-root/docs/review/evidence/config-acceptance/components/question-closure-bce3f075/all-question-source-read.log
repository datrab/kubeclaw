20: 
21:   constructor() {
22:     // Group TERM may precede IPC abort and may be forwarded more than once.
23:     // Keep the handler installed; the parent's stop bounds remain authoritative.
24:     process.on('SIGTERM', () => this.#controller.abort(new Error('TEST_PROVIDER_TERMINATED')));
25:     this.#maximumMemoryBytes = process.memoryUsage().rss;
26:     this.#lines = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
27:     this.#lines.on('line', (line) => {
28:       void this.#receive(line).catch((error) => {
29:         send({ kind: 'error', error: error instanceof Error ? error.message : String(error), resources: this.#resources() });
30:         this.#finish();
31:         process.exitCode = 1;
32:       });
33:     });
34:   }
