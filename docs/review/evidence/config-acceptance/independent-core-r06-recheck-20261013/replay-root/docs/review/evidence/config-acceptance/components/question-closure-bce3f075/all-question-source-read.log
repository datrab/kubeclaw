68:     const writableRoot = preparedPlanStateRoot(root);
69:     this.#admissionLock = path.join(writableRoot, 'job-admission');
70:     this.#maximumResultStoreBytes = options.maximumResultStoreBytes;
71:     this.#records = new FileDurableRecordStore(writableRoot, options.recordLimits);
72:     this.#results = new FileDurableBlobStore(path.join(writableRoot, 'results'), options.maximumResultBytes, options.maximumResultStoreBytes);
73:     this.#maximumResultBytes = options.maximumResultBytes;
74:     let sourcePublicKey: crypto.KeyObject;
75:     try { sourcePublicKey = crypto.createPublicKey(options.sourceAttestationPublicKey); }
76:     catch (error) { throw new Error('BUSTER_SOURCE_ATTESTATION_CONFIG_INVALID', { cause: error }); }
77:     if (options.trustedSourceAuthority.length === 0 || sourcePublicKey.asymmetricKeyType !== 'ed25519') {
78:       throw new Error('BUSTER_SOURCE_ATTESTATION_CONFIG_INVALID');
79:     }
80:     this.#trustedSourceAuthority = options.trustedSourceAuthority;
81:     this.#sourceAttestationPublicKey = sourcePublicKey.export({ type: 'spki', format: 'pem' });
82:   }
