246: static volatile sig_atomic_t terminate_requested = 0;
247: static int supervisor_children_fd = -1;
248: static const char *child_cgroup = NULL;
249: static int child_cgroup_kill_fd = -1;
250: 
251: static void request_termination(int signal_number) {
252:   terminate_requested = signal_number;
253: }
254: 
255: static int signal_children(int signal_number) {
256:   if (supervisor_children_fd < 0 || lseek(supervisor_children_fd, 0, SEEK_SET) < 0) return 0;
257:   char children[16384];
258:   ssize_t children_length = read(supervisor_children_fd, children, sizeof(children) - 1);
259:   if (children_length < 1) return 0;
260:   children[children_length] = '\0';
261:   char *cursor = children;
262:   while (*cursor != '\0') {
263:     char *end = NULL;
264:     long candidate = strtol(cursor, &end, 10);
265:     if (end == cursor) break;
266:     if (candidate > 0) kill((pid_t)candidate, signal_number);
267:     cursor = end;
268:   }
269:   return 0;
270: }
271: 
272: static int reap_adopted_children(pid_t main_child, int *main_status) {
273:   for (;;) {
274:     int status = 0;
275:     pid_t child = waitpid(-1, &status, WNOHANG);
276:     if (child > 0) { if (child == main_child) *main_status = status; continue; }
277:     if (child == 0) return 1;
278:     if (errno == ECHILD) return 0;
279:     if (errno == EINTR) continue;
280:     return -1;
281:   }
282: }
283: 
284: static int supervise(char **program) {
285:   if (prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0) return -1;
286:   pid_t supervisor = getpid();
287:   if (terminate_requested) return 70;
288:   pid_t main_child = fork();
289:   if (main_child < 0) return -1;
290:   if (main_child == 0) {
291:     if (prctl(PR_SET_PDEATHSIG, SIGKILL, 0, 0, 0) != 0 || getppid() != supervisor) _exit(70);
292:     if (child_cgroup && join_cgroup(child_cgroup) != 0) { perror("child cgroup"); _exit(70); }
293:     signal(SIGTERM, SIG_DFL);
294:     signal(SIGINT, SIG_DFL);
295:     execv(program[0], program);
296:     perror("execv");
297:     _exit(71);
298:   }
299:   int main_status = 0;
300:   int main_complete = 0;
301:   for (;;) {
302:     if (terminate_requested || main_complete) {
303:       if (signal_children(SIGTERM) != 0) return -1;
304:       for (int iteration = 0; iteration < 20; iteration++) {
305:         int remaining = reap_adopted_children(main_child, &main_status);
306:         if (remaining < 0) return -1;
307:         if (remaining == 0) break;
308:         usleep(5000);
309:       }
310:       /* The Nova group contains only the workload, so the supervisor survives
311:          a whole-tree kill and can reap setsid/double-fork descendants. */
312:       if (child_cgroup_kill_fd >= 0 && write(child_cgroup_kill_fd, "1", 1) != 1) return -1;
313:       if (signal_children(SIGKILL) != 0) return -1;
314:     }
315:     int status = 0;
316:     pid_t child = waitpid(-1, &status, 0);
317:     if (child < 0) {
318:       if (errno == EINTR) continue;
319:       if (errno == ECHILD) break;
320:       return -1;
321:     }
322:     if (child == main_child) {
323:       main_status = status;
324:       main_complete = 1;
325:     }
326:   }
327:   if (WIFEXITED(main_status)) return WEXITSTATUS(main_status);
328:   if (WIFSIGNALED(main_status)) {
329:     int signal_number = WTERMSIG(main_status);
330:     signal(signal_number, SIG_DFL);
331:     raise(signal_number);
332:     return 128 + signal_number;
333:   }
334:   return 70;
335: }
