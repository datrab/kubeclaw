90: async function publishCandidate(options: PreparationExecutionOptions, stateRoot: string, group: string,
91:   receipt: HistoricalImportReceipt): Promise<void> {
92:   const original = await digestHistoricalFile(path.join(stateRoot, 'records', 'store.json'), options.settings.maximumSourceBytes);
93:   if (preparationDigest(original) !== preparationDigest(receipt.descriptor)) throw new Error('BUSTER_HISTORICAL_SOURCE_CHANGED');
94:   const manifest = await digestHistoricalFile(path.join(group, 'data', 'manifest.json'), options.settings.maximumMetadataBytes);
95:   if (manifest.originalStoreDigest !== receipt.manifestDigest) throw new Error('BUSTER_HISTORICAL_MANIFEST_CHANGED');
96:   const source = path.join(group, 'data', 'metadata-v2');
97:   const target = preparedPlanStateRoot(stateRoot);
98:   const intentFile = path.join(group, 'historical-publication.json');
99:   const candidate = await candidatePath(source, target, intentFile, receipt, options.settings.maximumResultBytes);
100:   await ownCandidate(candidate, 0);
101:   const current = await digestHistoricalFile(path.join(candidate, 'records', 'store.json'), options.settings.maximumMetadataBytes);
102:   if (current.originalStoreDigest !== receipt.initialV2StoreDigest) throw new Error('BUSTER_HISTORICAL_CANDIDATE_CHANGED');
103:   if (candidate === source) {
104:     const selected = await fs.lstat(source);
105:     await writeDurableState(intentFile, { schemaVersion: 'buster-historical-publication-intent.v1',
106:       device: selected.dev, inode: selected.ino, nativeResultDigest: receipt.nativeResultDigest });
107:     await fs.chmod(intentFile, 0o400);
108:     await sync(group);
109:     try {
110:       const stat = await fs.lstat(target);
111:       if (!stat.isDirectory() || stat.uid !== 0 || (stat.mode & 0o022) !== 0
112:         || await fs.realpath(target) !== target) throw new Error('BUSTER_HISTORICAL_TARGET_EXISTS');
113:       // Inspect only the root-owned target directory entry, not a V2 bulk parse.
114:       if ((await fs.readdir(target)).length !== 0) throw new Error('BUSTER_HISTORICAL_TARGET_EXISTS');
115:     } catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
116:     await fs.rename(source, target);
117:     await sync(path.join(group, 'data'));
118:     await sync(path.dirname(target));
119:   }
120:   await ownCandidate(target, 1000);
121:   await sync(path.dirname(target));
122: }
