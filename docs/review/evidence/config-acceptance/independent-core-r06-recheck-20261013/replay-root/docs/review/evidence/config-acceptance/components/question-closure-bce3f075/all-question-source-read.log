91: /** A lookup never reserves or transmits. Legacy records without explicit ownership cannot authorize a handoff. */
92: export async function lookupDelivery(records: FileDurableRecordStore, request: EffectRequest, deliveryId: string, stageId: string, payload: Payload): Promise<Payload> {
93:   const entries = await records.read<Payload>(`notifications/${request.resource.canonicalId}`);
94:   const original = entries.find(entry => entry.idempotencyKey === key(deliveryId, 'request'))?.payload;
95:   assertLookupRequest(original,request,deliveryId,stageId,payload);
96:   const terminals = entries.filter(entry => entry.idempotencyKey.endsWith(`:${hash(deliveryId)}`)
97:     && entry.payload.schemaVersion === 'notification-delivery-receipt.v1');
98:   if (terminals.length !== 1) throw new Error('OPERATOR_RECEIPT_UNRESOLVED');
99:   const terminal = terminals[0]!.payload;
100:   const attempt = terminal.attempt as Payload | undefined;
101:   if (attempt?.runId !== request.attempt.runId || attempt.stageId !== stageId) throw new Error('OPERATOR_RECEIPT_OWNER_UNBOUND');
102:   const receipt = terminal.receipt;
103:   if (!receipt || typeof receipt !== 'object' || Array.isArray(receipt)) throw new Error('OPERATOR_RECEIPT_UNRESOLVED');
104:   return receipt as Payload;
105: }
106: 
107: function assertLookupRequest(original:Payload|undefined,request:EffectRequest,deliveryId:string,stageId:string,payload:Payload) {
108:   const owner = original?.owner as Payload | undefined;
109:   if (!original || original.schemaVersion !== 'notification-delivery-request.v2'
110:     || original.idempotencyKey !== deliveryId || original.target !== request.resource.canonicalId
111:     || owner?.runId !== request.attempt.runId || owner.stageId !== stageId
112:     || original.transportBody !== JSON.stringify(payload)) throw new Error('OPERATOR_RECEIPT_REQUEST_UNBOUND');
113: }
