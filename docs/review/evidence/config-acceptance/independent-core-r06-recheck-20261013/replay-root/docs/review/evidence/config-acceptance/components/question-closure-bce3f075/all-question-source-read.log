1: import crypto from 'node:crypto';
2: import type { EffectRequest } from '@kubeclaw/plugin-sdk';
3: import type { FileDurableRecordStore, DurableRecord } from '@kubeclaw/plugin-foundation/observability/durable-records';
4: import { projectedDeliveryReceipt } from './delivery-projection.ts';
