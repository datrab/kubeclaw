53: static int add_path_rule(int ruleset_fd, const char *root, __u64 access) {
54:   int root_fd = open(root, O_PATH | O_CLOEXEC);
55:   if (root_fd < 0) return -1;
56:   struct stat root_stat;
57:   if (fstat(root_fd, &root_stat) != 0) {
58:     close(root_fd);
59:     return -1;
60:   }
61:   if (!S_ISDIR(root_stat.st_mode)) access &= ~LANDLOCK_ACCESS_FS_READ_DIR;
62:   struct landlock_path_beneath_attr path_rule = {
63:     .allowed_access = access,
64:     .parent_fd = root_fd,
65:   };
66:   int result = (int)syscall(__NR_landlock_add_rule, ruleset_fd,
67:     LANDLOCK_RULE_PATH_BENEATH, &path_rule, 0);
68:   close(root_fd);
69:   return result;
70: }
71: 
72: static int restrict_filesystem(const char *write_root, char **read_roots, int read_root_count) {
73:   int abi = (int)syscall(__NR_landlock_create_ruleset, NULL, 0, LANDLOCK_CREATE_RULESET_VERSION);
74:   if (abi < 2) { errno = ENOTSUP; return -1; }
75:   __u64 read_access = LANDLOCK_ACCESS_FS_EXECUTE | LANDLOCK_ACCESS_FS_READ_FILE
76:     | LANDLOCK_ACCESS_FS_READ_DIR;
77:   __u64 handled = read_access | LANDLOCK_ACCESS_FS_WRITE_FILE | LANDLOCK_ACCESS_FS_REMOVE_DIR
78:     | LANDLOCK_ACCESS_FS_REMOVE_FILE | LANDLOCK_ACCESS_FS_MAKE_CHAR
79:     | LANDLOCK_ACCESS_FS_MAKE_DIR | LANDLOCK_ACCESS_FS_MAKE_REG
80:     | LANDLOCK_ACCESS_FS_MAKE_SOCK | LANDLOCK_ACCESS_FS_MAKE_FIFO
81:     | LANDLOCK_ACCESS_FS_MAKE_BLOCK | LANDLOCK_ACCESS_FS_MAKE_SYM;
82:   handled |= LANDLOCK_ACCESS_FS_REFER;
83:   if (abi >= 3) handled |= LANDLOCK_ACCESS_FS_TRUNCATE;
84:   struct landlock_ruleset_attr ruleset = { .handled_access_fs = handled };
85:   int ruleset_fd = (int)syscall(__NR_landlock_create_ruleset, &ruleset, sizeof(ruleset), 0);
86:   if (ruleset_fd < 0) return -1;
87:   int result = add_path_rule(ruleset_fd, write_root, handled);
88:   for (int index = 0; result == 0 && index < read_root_count; index++) {
89:     result = add_path_rule(ruleset_fd, read_roots[index], read_access);
90:   }
91:   int null_fd = open("/dev/null", O_PATH | O_CLOEXEC);
92:   if (result == 0 && null_fd >= 0) {
93:     struct landlock_path_beneath_attr null_rule = {
94:       .allowed_access = LANDLOCK_ACCESS_FS_READ_FILE | LANDLOCK_ACCESS_FS_WRITE_FILE
95:         | (abi >= 3 ? LANDLOCK_ACCESS_FS_TRUNCATE : 0),
96:       .parent_fd = null_fd,
97:     };
98:     result = (int)syscall(__NR_landlock_add_rule, ruleset_fd,
99:       LANDLOCK_RULE_PATH_BENEATH, &null_rule, 0);
100:   }
101:   if (null_fd >= 0) close(null_fd);
102:   if (result != 0 || prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0
103:     || syscall(__NR_landlock_restrict_self, ruleset_fd, 0) != 0) {
104:     close(ruleset_fd);
105:     return -1;
106:   }
107:   close(ruleset_fd);
108:   return 0;
109: }
110: 
111: static int restrict_network(unsigned long long connect_tcp_port) {
112:   int abi = (int)syscall(__NR_landlock_create_ruleset, NULL, 0, LANDLOCK_CREATE_RULESET_VERSION);
113:   if (abi < 4) { errno = ENOTSUP; return -1; }
114:   struct kubeclaw_landlock_ruleset_attr_v4 ruleset = {
115:     .handled_access_fs = 0,
116:     .handled_access_net = LANDLOCK_ACCESS_NET_CONNECT_TCP,
117:   };
118:   int ruleset_fd = (int)syscall(__NR_landlock_create_ruleset, &ruleset, sizeof(ruleset), 0);
119:   if (ruleset_fd < 0) return -1;
120:   struct kubeclaw_landlock_net_port_attr port_rule = {
121:     .allowed_access = LANDLOCK_ACCESS_NET_CONNECT_TCP,
122:     .port = connect_tcp_port,
123:   };
124:   int result = (int)syscall(__NR_landlock_add_rule, ruleset_fd,
125:     LANDLOCK_RULE_NET_PORT, &port_rule, 0);
126:   if (result != 0 || prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0
127:     || syscall(__NR_landlock_restrict_self, ruleset_fd, 0) != 0) {
128:     close(ruleset_fd);
129:     return -1;
130:   }
131:   close(ruleset_fd);
132:   return 0;
133: }
