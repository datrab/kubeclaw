307: function operatorScope(f) {
308:   const records = json(recordFile(f.deliveryRoot)).records;
309:   const request = records.find(record => record.payload.schemaVersion === 'notification-delivery-request.v1');
310:   const terminal = records.find(record => record.payload.schemaVersion === 'notification-delivery-receipt.v1');
311:   const source = waitScope(f).intent.source;
312:   return { schemaVersion: 'operator-request-retirement-scope.v1', action: 'compact-completed-human-approval-request',
313:     novaStorageRoot: f.platform.storageRoot, orchestratorIssuerId: f.platform.orchestratorIssuerId,
314:     inventoryLimits: source.inventoryLimits,
315:     intent: { operationId: 'operator:before-wait', actor: 'operator:local', runRoot: f.run, runId: f.runId,
316:       waitRoot: f.waitRoot, deliveryRoot: f.deliveryRoot, effectKey: f.request.idempotencyKey,
317:       expectedPayloadDigest: request.payloadDigest, terminalPayloadDigest: terminal.payloadDigest,
318:       runJournalHead: source.runJournalHead, snapshotDigest: source.snapshotDigest } };
319: }
