250:       if (current.payload.status.result?.contentDigest !== contentDigest
251:         || current.payload.status.result.resultDigest !== result.resultDigest) {
252:         throw new Error('BUSTER_REMOTE_RESULT_CONFLICT');
253:       }
254:       return current.payload.status;
255:     }
256:     if (current.payload.status.state !== 'running') {
257:       throw new Error(`BUSTER_REMOTE_JOB_STATE_CONFLICT:${current.payload.status.state}`);
258:     }
259:     const storedResult = await this.#results.put(bytes);
260:     const status: RemotePlanStatusV1 = {
261:       ...current.payload.status,
262:       state: 'completed',
263:       updatedAt: now,
264:       result: {
265:         schemaVersion: 'buster-plan-result-ref.v1',
266:         resultDigest: result.resultDigest,
267:         contentDigest: storedResult.digest,
268:         sizeBytes: storedResult.sizeBytes,
269:       },
270:       error: null,
271:     };
272:     validatePipelineTestGateContract('remotePlanStatus', status);
273:     const next: StoredPreparedPlanJob = { ...current.payload, status, resultOrigin: { kind: 'v2' } };
274:     const stored = await this.#records.transition(
275:       'buster-plan-jobs', current.record.idempotencyKey, current.record.payloadDigest, next,
276:     );
277:     return structuredClone((stored.payload as PreparedPlanJobRecord).status);
278:   }
279: 
280:   async result(jobId: string, contentDigest: string, maximumBytes: number): Promise<Buffer> {
281:     if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 1) throw new Error('BUSTER_REMOTE_RESULT_LIMIT_INVALID');
282:     const payload = (await this.get(jobId)).payload;
283:     const status = payload.status;
284:     if (status.state !== 'completed' || !status.result) throw new Error('BUSTER_REMOTE_RESULT_NOT_READY');
285:     if (status.result.contentDigest !== contentDigest) throw new Error('BUSTER_REMOTE_RESULT_NOT_FOUND');
286:     if (status.result.sizeBytes > maximumBytes || status.result.sizeBytes > this.#maximumResultBytes) {
287:       throw new Error('BUSTER_REMOTE_RESULT_SIZE_EXCEEDED');
288:     }
289:     if (payload.resultOrigin?.kind !== 'v2') throw new Error('BUSTER_HISTORICAL_RESULT_AUTHORITY_REQUIRED');
290:     const bytes = await this.#results.get(contentDigest);
291:     if (bytes.byteLength !== status.result.sizeBytes) throw new Error('BUSTER_REMOTE_RESULT_SIZE_MISMATCH');
292:     const parsed = JSON.parse(bytes.toString('utf8')) as RemotePlanResultV1;
293:     validatePipelineTestGateContract('remotePlanResult', parsed);
294:     if (parsed.jobId !== jobId || parsed.resultDigest !== status.result.resultDigest) {
295:       throw new Error('BUSTER_REMOTE_RESULT_IDENTITY_MISMATCH');
296:     }
297:     return bytes;
298:   }
299: }
