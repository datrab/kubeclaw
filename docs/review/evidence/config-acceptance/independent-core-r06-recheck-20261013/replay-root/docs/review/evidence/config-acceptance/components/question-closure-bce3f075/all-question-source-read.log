66:         || spec.dataSource !== undefined || spec.dataSourceRef !== undefined) {
67:         throw new Error(`KUBERNETES_FIXTURE_PVC_SOURCE_DENIED:${name}`);
68:     }
69:     if (spec.volumeMode !== undefined && spec.volumeMode !== 'Filesystem') {
70:         throw new Error(`KUBERNETES_FIXTURE_PVC_VOLUME_MODE_DENIED:${name}`);
71:     }
72:     const storageClass = spec.storageClassName;
73:     if (storageClass === undefined) {
74:         if (!policy.allowDefaultStorageClass)
75:             throw new Error('KUBERNETES_FIXTURE_DEFAULT_STORAGE_CLASS_DENIED');
76:     }
77:     else {
78:         const selected = text(storageClass, 'persistentVolumeClaim.storageClassName', 253);
79:         if (!policy.allowedStorageClasses.has(selected)) {
80:             throw new Error(`KUBERNETES_FIXTURE_STORAGE_CLASS_DENIED:${selected}`);
81:         }
82:     }
83:     const resources = object(spec.resources, 'persistentVolumeClaim.resources');
84:     const requests = object(resources.requests, 'persistentVolumeClaim.resources.requests');
85:     const bytes = storageBytes(requests.storage);
86:     if (bytes > policy.maximumClaimBytes)
87:         throw new Error(`KUBERNETES_FIXTURE_PVC_SIZE_DENIED:${name}`);
88:     return bytes;
89: }
