210:     }
211:     return this.#writeStatus(current, state, now, terminal);
212:   }
213: 
214:   async #writeStatus(
215:     current: Readonly<{ record: DurableRecord<StoredPreparedPlanJob>; payload: StoredPreparedPlanJob }>,
216:     state: RemotePlanStatusV1['state'],
217:     now: string,
218:     terminal?: { readonly error?: string },
219:   ): Promise<RemotePlanStatusV1> {
220:     const status: RemotePlanStatusV1 = {
221:       ...current.payload.status,
222:       state,
223:       updatedAt: now,
224:       result: null,
225:       error: terminal?.error ?? null,
226:     };
227:     validatePipelineTestGateContract('remotePlanStatus', status);
228:     const next: StoredPreparedPlanJob = { ...current.payload, status, resultOrigin: null };
229:     const stored = await this.#records.transition(
230:       'buster-plan-jobs', current.record.idempotencyKey, current.record.payloadDigest, next,
231:     );
232:     return structuredClone((stored.payload as PreparedPlanJobRecord).status);
233:   }
