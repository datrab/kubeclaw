95: function encodeArtifactJson(payload: Readonly<Record<string, unknown>>) {
96:   const encoding = payload.encoding;
97:   if (encoding !== undefined && encoding !== PORTABLE_JSON_ENCODING) throw new Error('ARTIFACT_ENCODING_UNSUPPORTED');
