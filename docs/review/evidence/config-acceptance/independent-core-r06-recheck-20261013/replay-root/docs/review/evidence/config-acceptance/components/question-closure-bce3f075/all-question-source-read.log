101: function expectedReference(request: EffectRequest): Readonly<Record<string, unknown>> | undefined {
102:   if (request.operation !== 'get_json_bytes') return undefined;
103:   const reference = request.payload.reference;
104:   if (!reference || typeof reference !== 'object' || Array.isArray(reference)) throw new Error('ARTIFACT_REFERENCE_REQUIRED');
105:   return reference as Readonly<Record<string, unknown>>;
