47: export function deliveryRequestKey(request: EffectRequest): string {
48:   return `delivery:request:${hash(request.idempotencyKey)}`;
49: }
50: export function originalJsonDeliveryCandidate(request: EffectRequest, transportPayload?: Payload): Payload {
