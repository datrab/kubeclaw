37:   constructor(root: string, options: HistoricalPlanJobStoreOptions) {
38:     if (!Number.isSafeInteger(options.maximumArchiveBytes) || options.maximumArchiveBytes < 1) {
39:       throw new Error('BUSTER_REMOTE_ARCHIVE_LIMIT_INVALID');
40:     }
41:     if (!Number.isSafeInteger(options.maximumResultBytes) || options.maximumResultBytes < 1) {
42:       throw new Error('BUSTER_REMOTE_RESULT_LIMIT_INVALID');
43:     }
