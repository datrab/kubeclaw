114: function pathExists(filePath) {
115:   return fs.existsSync(filePath);
116: }
117: 
118: function readJson(filePath) {
119:   return JSON.parse(fs.readFileSync(filePath, 'utf8'));
120: }
121: 
122: function readJsonLines(filePath) {
123:   if (!pathExists(filePath)) return [];
124:   return fs.readFileSync(filePath, 'utf8')
125:     .split(/\r?\n/)
126:     .filter(Boolean)
127:     .map((line) => JSON.parse(line));
128: }
129: 
130: function evidencePass(code, details = {}) {
131:   return { code, ok: true, ...details };
132: }
133: 
134: function evidenceFail(code, reason, details = {}) {
135:   return { code, ok: false, reason, ...details };
136: }
