126:     const accepted = stored.record.payload as StoredPlanJob;
127:     if (accepted.job.jobId !== job.jobId || accepted.job.requestDigest !== job.requestDigest) {
128:       throw new Error('BUSTER_REMOTE_JOB_CONFLICT');
129:     }
130:     return structuredClone(accepted.status);
131:   }
