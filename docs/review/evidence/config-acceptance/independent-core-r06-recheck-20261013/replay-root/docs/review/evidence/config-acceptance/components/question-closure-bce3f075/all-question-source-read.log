149: export function inspectJobs(inventory, root, runtimeRoot, runId) {
150:   const records = recordSnapshot(inventory, root);
151:   const jobs = [];
152:   for (const record of records) {
153:     if (record.stream !== 'buster-plan-jobs') { inventory.block('JOB_STREAM_UNKNOWN', identityHash(record.stream)); continue; }
154:     const { job, status } = record.payload ?? {};
155:     if (!validJobRecord(record)) {
156:       inventory.block('JOB_IDENTITY_UNKNOWN', identityHash(record.idempotencyKey)); continue;
157:     }
158:     if (job.plan.runId !== runId) continue;
159:     const jobRoot = path.join(runtimeRoot, identityHash(job.jobId).slice(7));
160:     jobs.push({ jobId: job.jobId, requestDigest: job.requestDigest, idempotencyKeyHash: identityHash(record.idempotencyKey),
161:       recordSequence: record.sequence, recordDigest: record.payloadDigest, root: jobRoot, state: ['accepted', 'running', 'completed', 'failed', 'cancelled', 'uncertain'].includes(status.state) ? status.state : 'unknown', disposition: 'retain' });
162:     if (!['completed', 'failed', 'cancelled'].includes(status.state)) inventory.block('JOB_ACTIVE_OR_UNCERTAIN', identityHash(job.jobId));
163:     inventory.root(jobRoot, 'buster-job');
164:     if (!inventory.files.has(path.join(jobRoot, 'observability/attempts/attempt-store.json'))) inventory.block('JOB_EVIDENCE_SCOPE_UNKNOWN', jobRoot);
165:     inspectJobResult(inventory, root, status);
166:   }
167:   return { root, records: records.length, jobs };
168: }
