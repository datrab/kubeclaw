13: async function sync(directory: string): Promise<void> {
14:   const handle = await fs.open(directory, 'r');
15:   try { await handle.sync(); } finally { await handle.close(); }
16: }
17: 
18: async function regular(file: string): Promise<void> {
19:   const stat = await fs.lstat(file);
20:   if (!stat.isFile() || stat.nlink !== 1 || ![0, 1000, 1003, 1004].includes(stat.uid)) {
21:     throw new Error('BUSTER_HISTORICAL_CANDIDATE_INVALID');
22:   }
23: }
24: 
25: /** Only the three known V2 metadata nodes change owner, never the bulk input tree.
26:  * No service is started while this function runs. */
27: async function ownCandidate(directory: string, uid: number): Promise<void> {
28:   for (const item of [directory, path.join(directory, 'records')]) {
29:     const stat = await fs.lstat(item);
30:     if (!stat.isDirectory() || await fs.realpath(item) !== item || ![0, 1000, 1003, 1004].includes(stat.uid)) {
31:       throw new Error('BUSTER_HISTORICAL_CANDIDATE_INVALID');
32:     }
33:     await fs.chown(item, 0, 0);
34:     await fs.chmod(item, 0o755);
35:   }
36:   const file = path.join(directory, 'records', 'store.json');
37:   await regular(file);
38:   await fs.chown(file, 0, 0);
39:   await fs.chmod(file, uid === 0 ? 0o400 : 0o600);
40:   await fs.chown(file, uid, uid);
41:   if (uid !== 0) {
42:     for (const item of [path.join(directory, 'records'), directory]) {
43:       await fs.chmod(item, 0o700);
44:       await fs.chown(item, uid, uid);
45:     }
46:   }
47: }
