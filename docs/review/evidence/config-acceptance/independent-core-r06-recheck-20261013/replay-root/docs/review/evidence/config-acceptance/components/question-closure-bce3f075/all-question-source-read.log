193:   }
194: 
195:   async #transitionStatus(
196:     jobId: string,
197:     expected: readonly RemotePlanStatusV1['state'][],
198:     state: RemotePlanStatusV1['state'],
199:     now: string,
200:     terminal?: { readonly error?: string },
201:   ): Promise<RemotePlanStatusV1> {
202:     const current = await this.get(jobId);
203:     if (current.payload.status.state === 'completed') {
204:       if (state === 'completed') return current.payload.status;
205:       throw new Error('BUSTER_COMPACTED_JOB_TERMINAL');
206:     }
207:     if (!expected.includes(current.payload.status.state)) {
