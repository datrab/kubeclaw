90: const EMPTY_OUTBOX: OutboxState = {
91:   schemaVersion: "producer-outbox.v1",
92:   entries: [],
93: };
94: const EMPTY_ADMISSION: AdmissionState = {
95:   schemaVersion: "observability-admission-store.v1",
96:   nextCursor: 1,
97:   entries: [],
98:   quarantine: [],
99:   quarantineOverflow: null,
100:   gaps: [],
101:   unresolvedItems: [],
102:   overflowUnresolvedItems: [],
103: };
104: const ADMISSION_METADATA_RESERVE = 1024;
105: async function readAdmissionState(file: string, limits: AdmissionStoreLimits): Promise<AdmissionState> {
106:   const state = await readDurableState(file, EMPTY_ADMISSION, limits.maximumBytes);
107:   assertAdmissionReplay(state, limits);
108:   return state;
109: }
