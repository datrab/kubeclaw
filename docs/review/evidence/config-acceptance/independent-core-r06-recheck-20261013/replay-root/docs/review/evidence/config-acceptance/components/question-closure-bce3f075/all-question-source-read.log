208:   const held = childWorker(t, deliveryWorker, 'hold-delivery', data);
209:   assert.equal(await held.next(), 'held');
210:   const before = fs.readFileSync(recordFile(f.waitRoot));
211:   const projecting = childWorker(t, projectionWorker, 'project', scope);
