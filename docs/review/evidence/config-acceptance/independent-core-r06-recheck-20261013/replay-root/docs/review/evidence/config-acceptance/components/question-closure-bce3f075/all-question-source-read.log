136:     if (message.kind === 'abort') { this.#controller.abort(new Error(String(message.reason || 'TEST_PROVIDER_CANCELLED'))); return; }
137:     if (message.kind === 'cleanup') { await this.#cleanup(message); return; }
138:     if (message.kind === 'execute') { await this.#execute(); return; }
139:     await this.#initialize(message);
140:   }
