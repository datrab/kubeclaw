31: function exactKeys(
32:   value: Record<string, unknown>,
33:   required: readonly string[],
34:   optional: readonly string[] = [],
35: ): boolean {
36:   const allowed = new Set([...required, ...optional]);
37:   return required.every((key) => Object.hasOwn(value, key))
38:     && Object.keys(value).every((key) => allowed.has(key));
