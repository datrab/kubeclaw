337: #ifdef KUBECLAW_BUSTER_BROWSER_IDENTITY
338: /* This separately installed file-capability helper has one image-owned caller
339:    and target. The generic, unprivileged sandbox does not compile this policy. */
340: static int buster_caller_allowed(void) {
341:   uid_t real_uid, effective_uid, saved_uid;
342:   gid_t real_gid, effective_gid, saved_gid;
343:   return getresuid(&real_uid, &effective_uid, &saved_uid) == 0
344:     && getresgid(&real_gid, &effective_gid, &saved_gid) == 0
345:     && real_uid == 1000 && effective_uid == 1000 && saved_uid == 1000
346:     && real_gid == 1000 && effective_gid == 1000 && saved_gid == 1000;
347: }
348: 
349: static int drop_buster_capabilities(void) {
350:   struct __user_cap_header_struct header = { .version = _LINUX_CAPABILITY_VERSION_3, .pid = 0 };
351:   struct __user_cap_data_struct data[2] = {{0}, {0}};
352:   if (syscall(SYS_capset, &header, data) != 0
353:     || prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_CLEAR_ALL, 0, 0, 0) != 0) return -1;
354:   if (syscall(SYS_capget, &header, data) != 0) return -1;
355:   for (int index = 0; index < 2; index++) {
356:     if (data[index].effective || data[index].permitted || data[index].inheritable) return -1;
357:   }
358:   return 0;
359: }
360: #endif
361: 
362: int main(int argc, char **argv) {
363: #ifdef KUBECLAW_BUSTER_BROWSER_IDENTITY
364:   if (!buster_caller_allowed()) {
365:     fprintf(stderr, "BUSTER_SANDBOX_CALLER_DENIED\n");
366:     return 77;
367:   }
368: #endif
369:   if (argc == 2 && strcmp(argv[1], "--page-size") == 0) {
370:     long page_size = sysconf(_SC_PAGESIZE);
371:     if (page_size <= 0) { perror("page size"); return 70; }
372:     printf("%ld\n", page_size);
373:     return 0;
374:   }
375:   pid_t host_parent = getppid();
376:   struct sigaction action = {0};
377:   action.sa_handler = request_termination;
378:   sigemptyset(&action.sa_mask);
379:   if (sigaction(SIGTERM, &action, NULL) != 0 || sigaction(SIGINT, &action, NULL) != 0
380:     || prctl(PR_SET_PDEATHSIG, SIGTERM, 0, 0, 0) != 0) { perror("parent death signal"); return 70; }
381:   if (getppid() != host_parent) return 70;
382:   if (argc < 5) {
383:     fprintf(stderr, "usage: plugin-sandbox <memory-bytes> <cpu-seconds> <max-files> [--allow-network] [--connect-tcp-port port] [--run-as-uid uid --run-as-gid gid] [--no-address-space-limit] [--cgroup path | --child-cgroup path] [--read-root path]... [--write-root path] <program> [args...]\n");
384:     return 64;
385:   }
386:   char *end = NULL;
387:   unsigned long long memory = strtoull(argv[1], &end, 10);
388:   if (!end || *end != '\0' || memory < 16777216ULL) return 64;
389:   unsigned long long cpu = strtoull(argv[2], &end, 10);
390:   if (!end || *end != '\0' || cpu < 1ULL) return 64;
391:   unsigned long long files = strtoull(argv[3], &end, 10);
392:   if (!end || *end != '\0' || files < 8ULL) return 64;
393:   char children_file[64];
394:   snprintf(children_file, sizeof(children_file), "/proc/%ld/task/%ld/children",
395:     (long)getpid(), (long)getpid());
396:   supervisor_children_fd = open(children_file, O_RDONLY | O_CLOEXEC);
397:   if (supervisor_children_fd < 0) {
398:     perror("open task children");
399:     return 70;
400:   }
401:   int program_index = 4;
402:   int allow_network = 0;
403:   int no_address_space_limit = 0;
404:   unsigned long long connect_tcp_port = 0;
405:   unsigned long long run_as_uid = ULLONG_MAX;
406:   unsigned long long run_as_gid = ULLONG_MAX;
407: #ifdef KUBECLAW_BUSTER_BROWSER_IDENTITY
408:   int uid_seen = 0, gid_seen = 0;
409: #endif
410:   while (argc > program_index) {
411:     if (strcmp(argv[program_index], "--allow-network") == 0) allow_network = 1;
412:     else if (strcmp(argv[program_index], "--no-address-space-limit") == 0) no_address_space_limit = 1;
413:     else if (strcmp(argv[program_index], "--connect-tcp-port") == 0) {
414:       if (argc <= program_index + 1) return 64;
415:       connect_tcp_port = strtoull(argv[program_index + 1], &end, 10);
416:       if (!end || *end != '\0' || connect_tcp_port < 1ULL || connect_tcp_port > 65535ULL) return 64;
417:       program_index += 2;
418:       continue;
419:     }
420:     else if (strcmp(argv[program_index], "--run-as-uid") == 0 || strcmp(argv[program_index], "--run-as-gid") == 0) {
421:       int is_uid = strcmp(argv[program_index], "--run-as-uid") == 0;
422: #ifdef KUBECLAW_BUSTER_BROWSER_IDENTITY
423:       if ((is_uid && uid_seen++) || (!is_uid && gid_seen++)) {
424:         fprintf(stderr, "BUSTER_SANDBOX_IDENTITY_DENIED\n");
425:         return 77;
426:       }
427: #endif
428:       if (argc <= program_index + 1) return 64;
429:       unsigned long long identity = strtoull(argv[program_index + 1], &end, 10);
430:       if (!end || *end != '\0' || identity > UINT_MAX) return 64;
431:       if (is_uid) run_as_uid = identity; else run_as_gid = identity;
432:       program_index += 2;
433:       continue;
434:     }
435:     else break;
436:     program_index += 1;
437:   }
438:   unsigned long long address_space = memory > (ULLONG_MAX / 8ULL)
439:     ? ULLONG_MAX
440:     : memory * 8ULL;
441:   if (address_space < 2147483648ULL) address_space = 2147483648ULL;
442:   /* Browser processes reserve very large virtual address ranges. When the
443:      explicit exemption is selected, the caller measures the complete adopted
444:      process tree and applies the memory ceiling to resident bytes. Keep the
445:      seccomp filter and kernel CPU/file ceilings in all modes. */
446: #ifdef KUBECLAW_BUSTER_BROWSER_IDENTITY
447:   /* Validate before any cgroup write, kill-file open or credential change. */
448:   if (!uid_seen || !gid_seen || run_as_uid != 1001 || run_as_gid != 1000) {
449:     fprintf(stderr, "BUSTER_SANDBOX_IDENTITY_DENIED\n");
450:     return 77;
451:   }
452:   if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0) return 70;
453: #endif
454:   if (
455:     (!no_address_space_limit && limit_resource(RLIMIT_AS, address_space) != 0)
456:     || limit_resource(RLIMIT_CPU, cpu) != 0
457:     || limit_resource(RLIMIT_NOFILE, files) != 0
458:     || limit_resource(RLIMIT_CORE, 0) != 0
459:   ) {
460:     perror("setrlimit");
461:     return 70;
462:   }
463:   if (argc >= program_index + 2 && strcmp(argv[program_index], "--cgroup") == 0) {
464:     if (join_cgroup(argv[program_index + 1]) != 0) {
465:       perror("cgroup");
466:       return 70;
467:     }
468:     program_index += 2;
469:   }
470:   if (argc >= program_index + 2 && strcmp(argv[program_index], "--child-cgroup") == 0) {
471:     child_cgroup = argv[program_index + 1];
472:     char kill_file[PATH_MAX];
473:     int length = snprintf(kill_file, sizeof(kill_file), "%s/cgroup.kill", child_cgroup);
474:     if (length < 0 || (size_t)length >= sizeof(kill_file)) return 64;
475:     child_cgroup_kill_fd = open(kill_file, O_WRONLY | O_CLOEXEC);
476:     if (child_cgroup_kill_fd < 0) { perror("child cgroup kill"); return 70; }
477:     program_index += 2;
478:   }
479:   if ((run_as_uid == ULLONG_MAX) != (run_as_gid == ULLONG_MAX)) return 64;
480:   if (run_as_uid != ULLONG_MAX) {
481:     if (setgroups(0, NULL) != 0
482:       || setresgid((gid_t)run_as_gid, (gid_t)run_as_gid, (gid_t)run_as_gid) != 0
483:       || setresuid((uid_t)run_as_uid, (uid_t)run_as_uid, (uid_t)run_as_uid) != 0) {
484:       perror("set identity");
485:       return 70;
486:     }
487:     /* Linux clears PDEATHSIG on effective UID/GID changes. Preserve the host
488:        death boundary for browser/worker callers that drop credentials. */
489:     if (prctl(PR_SET_PDEATHSIG, SIGTERM, 0, 0, 0) != 0 || getppid() != host_parent) {
490:       perror("parent death signal after identity");
491:       return 70;
492:     }
493:   }
494: #ifdef KUBECLAW_BUSTER_BROWSER_IDENTITY
495:   if (drop_buster_capabilities() != 0) {
496:     perror("clear browser helper capabilities");
497:     return 70;
498:   }
499: #endif
500:   char *read_roots[64];
501:   int read_root_count = 0;
502:   while (argc >= program_index + 2 && strcmp(argv[program_index], "--read-root") == 0) {
503:     if (read_root_count >= 64) return 64;
504:     read_roots[read_root_count++] = argv[program_index + 1];
505:     program_index += 2;
506:   }
507:   if (argc >= program_index + 2 && strcmp(argv[program_index], "--write-root") == 0) {
508:     if (restrict_filesystem(argv[program_index + 1], read_roots, read_root_count) != 0) {
509:       perror("landlock");
510:       return 70;
511:     }
512:     program_index += 2;
513:   }
514:   if (connect_tcp_port > 0 && restrict_network(connect_tcp_port) != 0) {
515:     perror("landlock network");
516:     return 70;
517:   }
518:   if (program_index >= argc) return 64;
519:   if (install_filter(allow_network) != 0) {
520:     perror("seccomp");
521:     return 70;
522:   }
523:   int supervised = supervise(&argv[program_index]);
524:   if (supervised < 0) {
525:     perror("supervise");
526:     return 70;
527:   }
528:   return supervised;
529: }
