69:     });
70:   }
71: 
72:   async requestTeardown(input: BusterFixtureAdmission, reason: NonNullable<BusterFixtureState['teardown']>['reason']): Promise<BusterFixtureState> {
73:     const admission = structuredClone(input); validateFixtureAdmission(admission);
