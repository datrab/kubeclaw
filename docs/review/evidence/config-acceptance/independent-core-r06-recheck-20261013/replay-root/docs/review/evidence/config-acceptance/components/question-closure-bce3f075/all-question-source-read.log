1: import crypto from 'node:crypto';
2: import {
3:   canonicalJson, portableJson, PORTABLE_JSON_ENCODING, verifiedArtifactJsonText,
4:   type AdapterActivationContext,
5:   type AdapterInstance,
6:   type ArtifactRef,
7:   type AdapterInvocation,
8:   type EffectRequest,
9: } from '@kubeclaw/plugin-sdk';
10: import {
11:   FileDurableBlobStore,
12:   FileDurableRecordStore,
13:   type DurableRecordStore,
14:   type DurableBlobStore,
15: } from '@kubeclaw/plugin-foundation/observability/durable-records';
16: 
17: const DEFAULT_MAXIMUM_RECORDS = 100_000;
18: const DEFAULT_MAXIMUM_STORE_BYTES = 256 * 1024 * 1024;
19: 
20: function requiredText(value: unknown, label: string): string {
21:   if (typeof value !== 'string' || value.length === 0 || value.includes('\0') || /[\r\n]/.test(value)) {
22:     throw new Error(`ARTIFACT_${label}_INVALID`);
23:   }
24:   return value;
25: }
26: 
27: function digestValue(value: unknown): string {
28:   const digest = requiredText(value, 'DIGEST');
29:   if (!/^sha256:[a-f0-9]{64}$/.test(digest)) throw new Error('ARTIFACT_DIGEST_INVALID');
30:   return digest;
31: }
32: 
33: function stream(namespace: string): string {
34:   if (!/^[A-Za-z0-9][A-Za-z0-9._:/-]{0,245}$/.test(namespace)) throw new Error('ARTIFACT_NAMESPACE_INVALID');
35:   return `artifacts/${namespace}`;
36: }
37: 
38: async function findArtifact(
39:   records: DurableRecordStore,
40:   blobs: DurableBlobStore,
41:   artifactId: string,
42:   namespace: string,
43:   predicate: (artifact: ArtifactRef) => boolean,
44:   expected?: Readonly<Record<string, unknown>>,
45: ): Promise<{
46:   readonly schemaVersion: 'artifact-json-bytes.v1';
47:   readonly jsonBytes: string;
48:   readonly value: unknown;
49:   readonly digest: string;
50:   readonly sizeBytes: number;
51:   readonly artifact: ArtifactRef;
52: }> {
53:   let matches = (await records.read<ArtifactRef>(stream(namespace)))
54:     .map((record) => record.payload)
55:     .filter((artifact) => artifact.artifactId === artifactId && predicate(artifact))
56:     .reverse();
57:   if (expected !== undefined && matches.length > 0) {
58:     matches = matches.filter(artifact => portableJson(artifact) === portableJson(expected));
59:     if (matches.length === 0) throw new Error('ARTIFACT_REFERENCE_CORRUPT');
60:   }
61:   for (const artifact of matches) {
62:     try {
63:       return await readArtifact(blobs, artifact);
64:     } catch (error) {
65:       // Metadata is the bounded write intent. It becomes visible only after its
66:       // content-addressed blob exists. This also recovers a crash between the
67:       // metadata and blob writes without hiding an older completed artifact.
68:       if (error instanceof Error && error.message === 'ARTIFACT_NOT_FOUND') continue;
69:       throw error;
70:     }
71:   }
72:   throw new Error('ARTIFACT_NOT_FOUND');
73: }
74: 
75: async function readArtifact(blobs: DurableBlobStore, artifact: ArtifactRef): Promise<{
76:   readonly schemaVersion: 'artifact-json-bytes.v1';
77:   readonly jsonBytes: string;
78:   readonly value: unknown;
79:   readonly digest: string;
80:   readonly sizeBytes: number;
81:   readonly artifact: ArtifactRef;
82: }> {
83:   let bytes: Buffer;
84:   try { bytes = await blobs.get(artifact.digest); } catch (error) {
85:     if (error instanceof Error && error.message === 'DURABLE_BLOB_NOT_FOUND') throw new Error('ARTIFACT_NOT_FOUND');
86:     if (error instanceof Error && error.message === 'DURABLE_BLOB_INTEGRITY_FAILED') throw new Error('ARTIFACT_INTEGRITY_FAILED');
87:     throw error;
88:   }
