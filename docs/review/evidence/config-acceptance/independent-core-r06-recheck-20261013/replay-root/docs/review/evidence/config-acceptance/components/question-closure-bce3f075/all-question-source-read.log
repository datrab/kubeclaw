233: static int join_cgroup(const char *root) {
234:   char file[PATH_MAX];
235:   if (snprintf(file, sizeof(file), "%s/cgroup.procs", root) < 0
236:     || strlen(file) >= sizeof(file)) return -1;
237:   int descriptor = open(file, O_WRONLY | O_CLOEXEC);
238:   if (descriptor < 0) return -1;
239:   char pid[32];
240:   int length = snprintf(pid, sizeof(pid), "%ld\n", (long)getpid());
241:   int result = length > 0 && write(descriptor, pid, (size_t)length) == length ? 0 : -1;
242:   close(descriptor);
243:   return result;
244: }
