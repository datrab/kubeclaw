45:     this.#maximumResultStoreBytes = options.maximumResultStoreBytes;
46:     this.#records = new FileDurableRecordStore(root, options.recordLimits);
47:     this.#results = new FileDurableBlobStore(path.join(root, 'results'), options.maximumResultBytes, options.maximumResultStoreBytes);
48:     this.#maximumArchiveBytes = options.maximumArchiveBytes;
49:     this.#maximumResultBytes = options.maximumResultBytes;
50:     let sourcePublicKey: crypto.KeyObject;
51:     try { sourcePublicKey = crypto.createPublicKey(options.sourceAttestationPublicKey); }
52:     catch (error) { throw new Error('BUSTER_SOURCE_ATTESTATION_CONFIG_INVALID', { cause: error }); }
53:     if (options.trustedSourceAuthority.length === 0 || sourcePublicKey.asymmetricKeyType !== 'ed25519') {
54:       throw new Error('BUSTER_SOURCE_ATTESTATION_CONFIG_INVALID');
55:     }
56:     this.#trustedSourceAuthority = options.trustedSourceAuthority;
57:     this.#sourceAttestationPublicKey = sourcePublicKey.export({ type: 'spki', format: 'pem' });
58:   }
59: 
60:   #preflight(job: RemotePlanJobV1): void {
61:     const encodedLimit = Math.ceil(this.#maximumArchiveBytes / 3) * 4;
62:     if (job.repositoryArchive.sizeBytes > this.#maximumArchiveBytes
63:       || job.repositoryArchive.data.length > encodedLimit) {
64:       throw new Error('BUSTER_REMOTE_ARCHIVE_SIZE_EXCEEDED');
65:     }
66:     // Keep the network trust boundary explicit. Contract validation repeats
67:     // these semantic checks for all other callers.
68:     repositoryArchiveBytes(job.repositoryArchive);
69:     if (!verifySourceSnapshotAttestation(job.sourceSnapshot,
70:       this.#trustedSourceAuthority, this.#sourceAttestationPublicKey)) {
71:       throw new Error('BUSTER_SOURCE_ATTESTATION_INVALID');
72:     }
73:     if (remotePlanJobId(job.idempotencyKey) !== job.jobId) {
74:       throw new Error('BUSTER_REMOTE_JOB_ID_INVALID');
75:     }
76:     if (resolvedTestPlanDigest(job.plan) !== job.plan.planDigest) {
77:       throw new Error('BUSTER_REMOTE_PLAN_DIGEST_MISMATCH');
78:     }
79:     if (remotePlanJobDigest(job) !== job.requestDigest) {
