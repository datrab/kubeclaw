51: function validCalendarDate(match: RegExpExecArray): boolean {
52:   const year = Number(match[1]);
53:   const month = Number(match[2]);
54:   const day = Number(match[3]);
55:   const leapYear = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);
56:   const maximumDay = month === 2 && leapYear ? 29 : (DAYS_IN_MONTH[month] ?? 0);
57:   return month >= 1 && month <= 12 && day >= 1 && day <= maximumDay;
58: }
