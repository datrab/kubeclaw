159: export function activate(context: AdapterActivationContext): AdapterInstance {
160:   const configured = context.config.artifactRoot;
161:   if (typeof configured !== 'string' || configured.length === 0) throw new Error('artifactRoot is required');
162:   const maximum = context.config.maxArtifactBytes ?? 16 * 1024 * 1024;
163:   if (!Number.isSafeInteger(maximum) || Number(maximum) <= 0) throw new Error('maxArtifactBytes is invalid');
164:   const maximumStoreBytes = context.config.maximumStoreBytes ?? DEFAULT_MAXIMUM_STORE_BYTES;
165:   const maximumRecords = context.config.maximumRecords ?? DEFAULT_MAXIMUM_RECORDS;
166:   if (!Number.isSafeInteger(maximumStoreBytes) || Number(maximumStoreBytes) < 1) throw new Error('maximumStoreBytes is invalid');
167:   if (!Number.isSafeInteger(maximumRecords) || Number(maximumRecords) < 1) throw new Error('maximumRecords is invalid');
168:   const records = new FileDurableRecordStore(configured, {
169:     maximumRecords: Number(maximumRecords),
170:     maximumBytes: Number(maximumStoreBytes),
171:     maximumRecordBytes: 64 * 1024,
172:   });
173:   const blobs = new FileDurableBlobStore(configured, Number(maximum), Number(maximumStoreBytes));
174:   return {
175:     async ready() { await records.read<ArtifactRef>('artifacts/readiness'); },
176:     async invoke(invocation) { return invokeArtifact(records, blobs, Number(maximum), invocation); },
177:     async shutdown() {},
178:   };
179: }
