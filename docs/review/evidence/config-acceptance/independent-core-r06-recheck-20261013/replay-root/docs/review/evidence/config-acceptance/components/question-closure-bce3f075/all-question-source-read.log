105: export class NovaObservabilityReconciler {
106:   readonly #attempts: FileDurableAttemptStore;
107:   readonly #admission: FileObservabilityAdmissionStore;
108:   readonly #journal: FileJournal<ReconciliationJournalEntry>;
109:   readonly #now: () => Date;
110:   constructor(options: {
111:     attemptStore: FileDurableAttemptStore;
112:     admissionStore: FileObservabilityAdmissionStore;
113:     journalFile: string;
114:     now?: () => Date;
115:   }) {
116:     this.#attempts = options.attemptStore;
117:     this.#admission = options.admissionStore;
118:     this.#journal = new FileJournal(options.journalFile);
119:     this.#now = options.now ?? (() => new Date());
120:   }
121:   async reconcile(
122:     attempts: ReadonlyArray<ReconciliationAttempt>,
123:   ): Promise<ReconciliationDecision[]> {
124:     const desiredSnapshot = [...structuredClone(attempts)];
125:     if (
126:       desiredSnapshot.some(
127:         (item) =>
128:           typeof item.planId !== "string" ||
129:           item.planId.length === 0 ||
130:           typeof item.nodeId !== "string" ||
131:           item.nodeId.length === 0,
132:       )
133:     )
134:       throw new Error("NOVA_RECONCILIATION_OWNER_INVALID");
135:     const identities = desiredSnapshot.map(
136:       (item) =>
137:         `${item.pipelineRunId}\0${item.planId}\0${item.attemptId}\0${item.claimGeneration}`,
138:     );
139:     if (new Set(identities).size !== identities.length)
140:       throw new Error("NOVA_RECONCILIATION_ATTEMPT_DUPLICATE");
141:     if (
142:       desiredSnapshot.some(
143:         (item) =>
144:           item.gateClass === "authoritative-final" &&
145:           item.requiredClosures.length === 0,
146:       )
147:     )
148:       throw new Error("NOVA_FINAL_OBSERVABILITY_REQUIREMENTS_MISSING");
149:     const previous = this.#journal.refresh();
150:     for (const desired of desiredSnapshot) {
151:       const mapped = previous.find(
152:         (record) =>
153:           record.entry.decision.pipelineRunId === desired.pipelineRunId &&
154:           record.entry.decision.planId === desired.planId &&
155:           record.entry.decision.attemptId === desired.attemptId &&
156:           record.entry.decision.claimGeneration === desired.claimGeneration,
157:       );
158:       if (mapped && mapped.entry.decision.nodeId !== desired.nodeId)
159:         throw new Error("NOVA_RECONCILIATION_NODE_MAPPING_CONFLICT");
160:     }
161:     const snapshot = await this.#attempts.snapshot();
162:     const decisions: ReconciliationDecision[] = [];
163:     for (const desired of desiredSnapshot.sort((left, right) =>
164:       left.attemptId.localeCompare(right.attemptId),
165:     )) {
166:       const claimExpiresAt = validTime(desired.claimExpiresAt);
167:       const matching = snapshot.results
168:         .filter(
169:           (item) =>
170:             item.pipelineRunId === desired.pipelineRunId &&
171:             item.attemptId === desired.attemptId,
172:         )
173:         .sort((left, right) => right.claimGeneration - left.claimGeneration);
174:       let newest = matching[0];
175:       let action: ReconciliationAction;
176:       let result: WorkerAttemptResultV1 | null = null;
177:       let completeness: ObservabilityCompletenessV1 | null = null;
178:       let nextClaimGeneration: number | null = null;
179:       const identityMatches =
180:         newest?.claimGeneration === desired.claimGeneration &&
181:         newest.planId === desired.planId &&
182:         newest.nodeId === desired.nodeId &&
183:         newest.result.claimId === desired.claimId &&
184:         newest.workerId === desired.workerId;
185:       if (newest && identityMatches && newest.storedAt === null) {
186:         try {
187:           newest = await this.#attempts.storeResult(
188:             desired.pipelineRunId,
189:             newest.result,
190:             newest.completionIntent,
191:             { planId: desired.planId, nodeId: desired.nodeId },
192:           );
193:         } catch {
194:           // The result remains pending. The normal expiry branch below keeps
195:           // it out of the import path and issues a new claim generation.
196:         }
197:       }
198:       if (newest && newest.claimGeneration > desired.claimGeneration)
199:         action = "stale-result-rejected";
200:       else if (
201:         newest &&
202:         newest.claimGeneration === desired.claimGeneration &&
203:         (newest.planId !== desired.planId ||
204:           newest.nodeId !== desired.nodeId ||
205:           newest.result.claimId !== desired.claimId ||
206:           newest.workerId !== desired.workerId)
207:       )
208:         action = "identity-mismatch-rejected";
209:       else if (
210:         newest &&
211:         newest.claimGeneration === desired.claimGeneration &&
212:         (typeof newest.storedAt !== "string" ||
213:           validTime(newest.storedAt) >= claimExpiresAt)
214:       ) {
215:         action = "requeue";
216:         nextClaimGeneration = desired.claimGeneration + 1;
217:       } else if (newest && newest.claimGeneration === desired.claimGeneration) {
218:         result = structuredClone(newest.result);
219:         const requiredIntent = newest.completionIntent?.closure;
220:         const intentDeclared =
221:           !!requiredIntent &&
222:           desired.requiredClosures.some(
223:             (item) =>
224:               item.closureId === requiredIntent.closureId &&
225:               item.producer.producerId === requiredIntent.producer.producerId &&
226:               item.producer.bootId === requiredIntent.producer.bootId &&
227:               item.producer.producerType ===
228:                 requiredIntent.producer.producerType,
229:           );
230:         if (!intentDeclared) {
231:           completeness = missingIntent(
232:             desired.pipelineRunId,
233:             desired.workerId,
234:             this.#now().toISOString(),
235:           );
236:           action =
237:             desired.gateClass === "development"
238:               ? "continue-degraded"
239:               : "blocked-incomplete";
240:         } else {
241:           try {
242:             await this.#attempts.resumeCompletion(
243:               desired.pipelineRunId,
244:               desired.attemptId,
245:               desired.claimGeneration,
246:               this.#admission,
247:             );
248:           } catch {
249:             // Completeness below records the unavailable closure. The durable
250:             // completion intent remains available for the next reconciliation.
251:           }
252:           completeness = await this.#attempts.evaluateCompleteness(
253:             desired.pipelineRunId,
254:             desired.requiredClosures,
255:             this.#admission,
256:           );
257:           if (completeness.state === "complete") action = "imported";
258:           else
259:             action =
260:               desired.gateClass === "development"
261:                 ? "continue-degraded"
262:                 : "blocked-incomplete";
263:         }
264:       } else if (claimExpiresAt > this.#now().getTime()) action = "reconnect";
265:       else {
266:         action = "requeue";
267:         nextClaimGeneration = desired.claimGeneration + 1;
268:       }
269:       const decidedAt = this.#now().toISOString();
270:       let decision: ReconciliationDecision = {
271:         pipelineRunId: desired.pipelineRunId,
272:         planId: desired.planId,
273:         nodeId: desired.nodeId,
274:         attemptId: desired.attemptId,
275:         claimGeneration: desired.claimGeneration,
276:         action,
277:         nextClaimGeneration,
278:         result,
279:         completeness,
280:         decidedAt,
281:       };
282:       const decisionKey = key(desired, result?.resultDigest ?? null, action);
283:       decision = this.#journal.transact((records, append) => {
284:         const existing = records.find(
285:           (record) => record.entry.decisionKey === decisionKey,
286:         );
287:         if (existing)
288:           return {
289:             ...structuredClone(existing.entry.decision),
290:             action:
291:               action === "imported"
292:                 ? "already-imported"
293:                 : existing.entry.decision.action,
294:           };
295:         append({
296:           schemaVersion: "nova-observability-reconciliation.v1",
297:           decision,
298:           decisionKey,
299:         });
300:         return decision;
301:       });
302:       decisions.push(decision);
303:     }
304:     return decisions;
305:   }
306:   records(): readonly ReconciliationJournalEntry[] {
307:     return this.#journal.refresh().map((item) => item.entry);
308:   }
309: }
