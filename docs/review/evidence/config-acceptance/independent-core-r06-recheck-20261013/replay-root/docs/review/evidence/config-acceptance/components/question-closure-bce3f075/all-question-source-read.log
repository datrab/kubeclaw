106: function assertJsonObject(value: object, seen: Set<object>, depth: number): void {
107:   if (seen.has(value)) throw new Error('TRANSPORT_PAYLOAD_CYCLIC');
108:   seen.add(value);
109:   if (Array.isArray(value)) {
110:     for (const item of value) assertJson(item, seen, depth + 1);
111:   } else {
112:     if (!plainRecord(value)) throw new Error('TRANSPORT_PAYLOAD_INVALID');
113:     for (const [key, item] of Object.entries(value)) {
114:       assertJsonKey(key);
115:       assertJson(item, seen, depth + 1);
116:     }
117:   }
118:   seen.delete(value);
