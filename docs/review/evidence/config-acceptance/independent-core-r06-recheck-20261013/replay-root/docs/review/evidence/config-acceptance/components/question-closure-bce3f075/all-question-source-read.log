59: export function inspectArtifacts(inventory, root, runId, references) {
60:   const records = recordSnapshot(inventory, root);
61:   const matching = [];
62:   const digestOwners = new Map();
63:   for (const record of records) {
64:     const artifact = record.payload;
65:     if (!validArtifactRecord(record)) {
66:       inventory.block('ARTIFACT_REFERENCE_UNKNOWN', identityHash(record.idempotencyKey)); continue;
67:     }
68:     const target = blobPath(root, artifact.digest);
69:     const observed = inventory.files.get(target);
70:     if (observed?.hash !== artifact.digest || observed.bytes !== artifact.sizeBytes) inventory.block('ARTIFACT_BLOB_MISSING_OR_CHANGED', target);
71:     const owners = digestOwners.get(artifact.digest) ?? new Set(); owners.add(artifact.producer.runId); digestOwners.set(artifact.digest, owners);
72:     const reference = { ownerRunId: artifact.producer.runId, namespace: artifact.namespace, artifactId: artifact.artifactId, digest: artifact.digest,
73:       bytes: artifact.sizeBytes, path: target, recordSequence: record.sequence, recordDigest: record.payloadDigest, idempotencyKeyHash: identityHash(record.idempotencyKey), disposition: 'retain' };
