64: export interface NovaTestExecutionGraphV1 {
65:   readonly schemaVersion: 'nova-test-execution-graph.v1';
66:   readonly runId: string;
67:   readonly parentStageId: string;
68:   readonly jobId: string;
69:   readonly sourceRevision: string;
70:   readonly planId: string;
71:   readonly planDigest: string;
72:   readonly nodes: RemotePlanJobV1['plan']['nodes'];
73:   readonly links: RemotePlanJobV1['plan']['links'];
74:   readonly attempts: RemotePlanResultV1['attempts'];
75:   readonly results: RemotePlanResultV1['nodes'];
76:   readonly reviews: AgentEvidenceReviewRequestV1[];
77:   readonly decisionDigest: string;
78: }
79: 
80: // A graph is derived from the verified import, never a second write authority.
81: function executionGraph(job: GateImportSource, result: RemotePlanResultV1 | null,
82:   decision: GateDecisionV1): NovaTestExecutionGraphV1 {
83:   return {
84:     schemaVersion: 'nova-test-execution-graph.v1',
85:     runId: job.plan.runId, parentStageId: job.pipelineStageId, jobId: job.jobId,
86:     sourceRevision: job.sourceRevision, planId: job.plan.planId,
87:     planDigest: job.plan.planDigest, nodes: structuredClone(job.plan.nodes),
88:     links: structuredClone(job.plan.links), attempts: structuredClone(result?.attempts ?? []),
89:     results: structuredClone(result?.nodes ?? []), reviews: structuredClone(decision.reviews),
90:     decisionDigest: decision.decisionDigest,
91:   };
92: }
93: 
94: import { same, artifacts, verifyCompletedResult, verifyResult, decide, decideResult } from './remote-result-authority.ts';
95: 
96: export class FileNovaGateImportStore {
97:   readonly #records: FileDurableRecordStore;
98:   readonly #blobs: FileDurableBlobStore;
99:   constructor(root: string, options: { recordLimits: DurableRecordLimits; maximumEvidenceStoreBytes: number }) {
100:     this.#records = new FileDurableRecordStore(root, options.recordLimits);
101:     // The importer enforces the per-job evidence limit; no blob can exceed the
102:     // store quota, and the third argument enforces that quota across all jobs.
103:     this.#blobs = new FileDurableBlobStore(root, options.maximumEvidenceStoreBytes, options.maximumEvidenceStoreBytes);
104:   }
105:   /** Read only a completed import under an exact caller-independent execution binding. */
106:   async readVerifiedResult(binding: { readonly jobId: string; readonly runId: string; readonly pipelineStageId: string;
107:     readonly sourceRevision: string; readonly decisionDigest: string; readonly resultDigest: string }) {
108:     const record = (await this.#records.read<StoredGateImportV2>('remote-gate-imports'))
109:       .find(item => item.idempotencyKey === binding.jobId);
110:     return validateVerifiedOutput(record?.payload, binding);
111:   }
112: 
113:   /** Retain this original import and every referenced blob under its writer fence.
114:    * The caller holds the run fence and may acquire only the distinct dispatch
115:    * store next. It must not reenter this import store from operation. */
116:   async withRetainedImport<T>(inputJob: RemotePlanJobV1, expectedPayloadDigest: string,
117:     operation: (authority: { readonly payloadDigest: string; readonly resultDigest: string;
118:       readonly decisionDigest: string; readonly decision: GateDecisionV1 }) => Promise<T>): Promise<T> {
119:     const job = structuredClone(inputJob);
120:     validatePipelineTestGateContract('remotePlanJob', job);
121:     return this.#records.withRecords<StoredGateImportV2, T>('remote-gate-imports', async records => {
122:       const record = records.find(item => item.idempotencyKey === job.jobId);
123:       const stored = record?.payload;
124:       if (!record || record.payloadDigest !== expectedPayloadDigest || !stored) {
125:         throw new Error('NOVA_DISPATCH_RETENTION_IMPORT_REQUIRED');
126:       }
127:       const result = retainedResult(stored, job);
128:       verifyResult(job, result);
129:       const decision = decideResult(job, result);
130:       if (!same(decision, stored.decision) || decision.state === 'review_required') {
131:         throw new Error('NOVA_DISPATCH_RETENTION_DECISION_INCOMPLETE');
132:       }
133:       const referenced = artifacts(result);
134:       if (!same(stored.evidenceDigests, referenced.map(item => item.contentDigest).sort())) {
135:         throw new Error('NOVA_DISPATCH_RETENTION_EVIDENCE_MISMATCH');
136:       }
137:       for (const artifact of referenced) {
138:         const bytes = await this.#blobs.get(artifact.contentDigest);
139:         if (bytes.byteLength !== artifact.sizeBytes) throw new Error('NOVA_DISPATCH_RETENTION_EVIDENCE_MISMATCH');
140:       }
141:       return operation({ payloadDigest: record.payloadDigest, resultDigest: result.resultDigest,
142:         decisionDigest: decision.decisionDigest, decision: structuredClone(decision) });
143:     });
144:   }
145: 
146:   async readExecutionGraphs(): Promise<readonly NovaTestExecutionGraphV1[]> {
147:     return (await this.#records.read<StoredGateImportV2>('remote-gate-imports'))
148:       .filter(record => record.payload.state === 'complete')
149:       .map(({ payload }) => {
150:         if (payload.schemaVersion !== 'nova-test-gate-import.v2') throw new Error('NOVA_REMOTE_IMPORT_SCHEMA_UNSUPPORTED');
151:         return executionGraph(payload.source, payload.remoteResult, payload.decision);
152:       });
153:   }
154:   async record(job: RemotePlanJobV1, status: RemotePlanStatusV1, remoteResult: RemotePlanResultV1 | null,
155:     decision: GateDecisionV1,
156:     evidence: readonly { artifact: ArtifactRefV1; bytes: Uint8Array }[], signal?: AbortSignal): Promise<GateDecisionV1> {
157:     checkGateSignal(signal);
158:     const digests = evidence.map((item) => item.artifact.contentDigest).sort();
159:     const pending: StoredGateImportV2 = { schemaVersion: 'nova-test-gate-import.v2', jobId: job.jobId, source: importSource(job),
160:       requestDigest: job.requestDigest, remoteResultDigest: remoteResult?.resultDigest ?? null,
161:       remoteResult: remoteResult ? structuredClone(remoteResult) : null,
162:       evidenceDigests: digests, decision, state: 'pending_evidence' };
163:     let appended;
164:     try {
165:       appended = await this.#records.append('remote-gate-imports', job.jobId, pending);
166:       checkGateSignal(signal);
167:     } catch (error) {
168:       if (!(error instanceof Error) || error.message !== 'DURABLE_RECORD_IDEMPOTENCY_CONFLICT') throw error;
169:       const record = (await this.#records.read<StoredGateImportV2>('remote-gate-imports'))
170:         .find((item) => item.idempotencyKey === job.jobId);
171:       if (!record) throw error;
172:       checkGateSignal(signal);
173:       const existing = record.payload;
174:       assertSameImport(existing, pending);
175:       if (existing.state === 'complete') {
176:         return structuredClone(existing.decision);
177:       }
178:       appended = { appended: false, record };
179:     }
180:     const existing = appended.record.payload as StoredGateImportV2;
181:     assertSameImport(existing, pending);
182:     if (existing.state === 'complete') {
183:       return structuredClone(existing.decision);
184:     }
185:     for (const item of evidence) {
186:       checkGateSignal(signal);
187:       const stored = await this.#blobs.put(item.bytes);
188:       if (stored.digest !== item.artifact.contentDigest || stored.sizeBytes !== item.artifact.sizeBytes) {
189:         throw new Error('NOVA_REMOTE_EVIDENCE_STORE_MISMATCH');
190:       }
191:     }
192:     checkGateSignal(signal);
193:     const complete: StoredGateImportV2 = { ...pending, state: 'complete' };
194:     const stored = await this.#records.transition('remote-gate-imports', job.jobId, appended.record.payloadDigest, complete);
195:     checkGateSignal(signal);
196:     return structuredClone((stored.payload as StoredGateImportV2).decision);
197:   }
198: }
199: 
200: export class NovaRemoteGateImporter {
201:   readonly #store: FileNovaGateImportStore;
202:   readonly #evidence: RemotePlanEvidenceTransport;
203:   readonly #results: RemotePlanResultTransport;
204:   readonly #maximumEvidenceBytes: number;
205:   readonly #maximumResultBytes: number;
206:   constructor(options: { store: FileNovaGateImportStore; evidence: RemotePlanEvidenceTransport;
207:     results: RemotePlanResultTransport; maximumEvidenceBytes: number; maximumResultBytes: number }) {
208:     if (!Number.isSafeInteger(options.maximumEvidenceBytes) || options.maximumEvidenceBytes < 1) throw new Error('NOVA_REMOTE_EVIDENCE_LIMIT_INVALID');
209:     if (!Number.isSafeInteger(options.maximumResultBytes) || options.maximumResultBytes < 1) throw new Error('NOVA_REMOTE_RESULT_LIMIT_INVALID');
210:     this.#store = options.store; this.#evidence = options.evidence; this.#results = options.results;
211:     this.#maximumEvidenceBytes = options.maximumEvidenceBytes; this.#maximumResultBytes = options.maximumResultBytes;
212:   }
213:   async import(job: RemotePlanJobV1, status: RemotePlanStatusV1, signal?: AbortSignal): Promise<GateDecisionV1> {
214:     checkGateSignal(signal);
215:     validatePipelineTestGateContract('remotePlanJob', job);
216:     validatePipelineTestGateContract('remotePlanStatus', status);
217:     if (status.jobId !== job.jobId || status.requestDigest !== job.requestDigest
218:       || !['completed', 'failed', 'cancelled'].includes(status.state)) throw new Error('NOVA_REMOTE_IMPORT_STATUS_INVALID');
219:     const result = status.state === 'completed' && status.result
220:       ? await this.#results.result(job.jobId, status.result.contentDigest,
221:         Math.min(status.result.sizeBytes, this.#maximumResultBytes), signal)
222:       : null;
223:     checkGateSignal(signal);
224:     if (status.state === 'completed') {
225:       if (!result) throw new Error('NOVA_REMOTE_RESULT_MISSING');
226:       verifyCompletedResult(job, status, result);
227:     }
228:     const decision = decide(job, status, result);
229:     const source = artifacts(result);
230:     let total = 0;
231:     const evidence: Array<{ artifact: ArtifactRefV1; bytes: Buffer }> = [];
232:     for (const artifact of source) {
233:       checkGateSignal(signal);
234:       total += artifact.sizeBytes;
235:       if (!Number.isSafeInteger(total) || total > this.#maximumEvidenceBytes) throw new Error('NOVA_REMOTE_EVIDENCE_TOTAL_EXCEEDED');
236:       const bytes = await this.#evidence.evidence(
237:         job.jobId, artifact.contentDigest, Math.min(artifact.sizeBytes, this.#maximumEvidenceBytes - (total - artifact.sizeBytes)), signal,
238:       );
239:       if (bytes.byteLength !== artifact.sizeBytes
240:         || `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}` !== artifact.contentDigest) {
241:         throw new Error('NOVA_REMOTE_EVIDENCE_INVALID');
242:       }
243:       checkGateSignal(signal);
244:       evidence.push({ artifact, bytes });
245:     }
246:     checkGateSignal(signal);
247:     return this.#store.record(job, status, result, decision, evidence, signal);
248:   }
249: }
250: 
251: export interface RemotePlanTerminalDispatcher {
252:   dispatch(job: RemotePlanJobV1, options: { timeoutMs: number; signal?: AbortSignal }): Promise<RemotePlanStatusV1>;
253: }
254: 
255: export class NovaRemoteTestGate {
256:   readonly #dispatcher: RemotePlanTerminalDispatcher;
257:   readonly #importer: NovaRemoteGateImporter;
258:   constructor(options: { dispatcher: RemotePlanTerminalDispatcher; importer: NovaRemoteGateImporter }) {
259:     this.#dispatcher = options.dispatcher;
260:     this.#importer = options.importer;
261:   }
262:   async execute(job: RemotePlanJobV1, options: { timeoutMs: number; signal?: AbortSignal }): Promise<{
263:     status: RemotePlanStatusV1; decision: GateDecisionV1; stageResult: StageResult;
264:   }> {
265:     const deadline = new GateDeadline(options.timeoutMs, options.signal);
266:     try {
267:       deadline.check();
268:       const status = await this.#dispatcher.dispatch(job, { timeoutMs: deadline.remaining(), signal: deadline.signal });
269:       deadline.check();
270:       const decision = await this.#importer.import(job, status, deadline.signal).catch((error: unknown) => {
271:         deadline.check(); throw error;
272:       });
273:       deadline.check();
274:       return { status, decision, stageResult: gateDecisionStageResult(decision) };
275:     } finally { deadline.dispose(); }
276:   }
277: }
{"path": "skills/nova/core/test-gates/runtime-config.ts", "sha256": "11cf39d73d5efce2328a38057063fdff4e12d1714ad2c2935203a0a53108604a"}
1: import fs from 'node:fs';
2: import path from 'node:path';
3: import crypto from 'node:crypto';
4: import { assertSecureRemoteEndpoint } from './secure-endpoint.ts';
5: import { createProductionNovaTestGate, type ProductionNovaTestGate } from './production.ts';
6: 
7: function object(value: unknown, label: string): Record<string, unknown> {
8:   if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error(`NOVA_REMOTE_CONFIG_INVALID:${label}`);
9:   return value as Record<string, unknown>;
10: }
11: 
12: function integer(value: unknown, label: string, minimum = 1): number {
13:   if (!Number.isSafeInteger(value) || (value as number) < minimum) throw new Error(`NOVA_REMOTE_CONFIG_INVALID:${label}`);
14:   return value as number;
15: }
16: 
17: function assertKnownKeys(value: Record<string, unknown>, allowed: readonly string[], label: string): void {
18:   const allowedKeys = new Set(allowed);
19:   const unknown = Object.keys(value).find((key) => !allowedKeys.has(key));
20:   if (unknown) throw new Error(`NOVA_REMOTE_CONFIG_INVALID:${label}.${unknown}`);
21: }
22: 
23: export function loadProductionNovaTestGate(
24:   file: string,
25:   environment: Readonly<Record<string, string | undefined>> = process.env,
26: ): ProductionNovaTestGate {
27:   const canonical = fs.realpathSync(file);
28:   const directory = path.dirname(canonical);
29:   const value = object(JSON.parse(fs.readFileSync(canonical, 'utf8')), 'root');
30:   assertKnownKeys(value, ['schemaVersion', 'endpoint', 'authentication', 'tokenEnvironmentVariable',
31:     'sourceAttestationPrivateKeyEnvironmentVariable', 'sourceAuthority', 'stateRoot', 'pollMilliseconds',
32:     'maximumResponseBytes', 'maximumResultBytes', 'maximumArchiveBytes', 'maximumArchiveStoreBytes',
33:     'maximumEvidenceBytes', 'maximumEvidenceStoreBytes', 'recordLimits'], 'root');
34:   if (value.schemaVersion !== 'nova-remote-test-gate-runtime.v1') throw new Error('NOVA_REMOTE_CONFIG_VERSION_INVALID');
35:   for (const name of ['endpoint', 'sourceAttestationPrivateKeyEnvironmentVariable',
36:     'sourceAuthority', 'stateRoot']) {
37:     if (typeof value[name] !== 'string' || value[name].length === 0) throw new Error(`NOVA_REMOTE_CONFIG_INVALID:${name}`);
38:   }
39:   const authentication = value.authentication === 'spiffe-proxy' ? 'spiffe-proxy' : 'bearer';
40:   let tokenName: string | undefined;
41:   let token: string | undefined;
42:   if (authentication === 'bearer') {
43:     if (typeof value.tokenEnvironmentVariable !== 'string'
44:       || !/^[A-Z][A-Z0-9_]*$/u.test(value.tokenEnvironmentVariable)) {
45:       throw new Error('NOVA_REMOTE_CONFIG_TOKEN_ENV_INVALID');
46:     }
47:     tokenName = value.tokenEnvironmentVariable;
48:     token = environment[tokenName];
49:     if (!token) throw new Error('NOVA_REMOTE_CONFIG_TOKEN_MISSING');
50:   }
51:   const sourceKeyName = value.sourceAttestationPrivateKeyEnvironmentVariable as string;
52:   if (!/^[A-Z][A-Z0-9_]*$/u.test(sourceKeyName) || sourceKeyName === tokenName) {
53:     throw new Error('NOVA_SOURCE_ATTESTATION_ENV_INVALID');
54:   }
55:   const sourceAttestationPrivateKey = environment[sourceKeyName];
56:   if (!sourceAttestationPrivateKey) throw new Error('NOVA_SOURCE_ATTESTATION_PRIVATE_KEY_MISSING');
57:   let parsedSourceKey: crypto.KeyObject;
58:   try { parsedSourceKey = crypto.createPrivateKey(sourceAttestationPrivateKey); }
59:   catch (error) { throw new Error('NOVA_SOURCE_ATTESTATION_PRIVATE_KEY_INVALID', { cause: error }); }
60:   if (parsedSourceKey.asymmetricKeyType !== 'ed25519') throw new Error('NOVA_SOURCE_ATTESTATION_PRIVATE_KEY_INVALID');
61:   const endpoint = assertSecureRemoteEndpoint(value.endpoint as string);
62:   const records = object(value.recordLimits, 'recordLimits');
63:   assertKnownKeys(records, ['maximumRecords', 'maximumBytes', 'maximumRecordBytes'], 'recordLimits');
64:   return createProductionNovaTestGate({
65:     endpoint: endpoint.href,
66:     ...(token ? { token } : {}),
67:     authentication,
68:     sourceAuthority: value.sourceAuthority as string,
69:     sourceAttestationPrivateKey: parsedSourceKey.export({ type: 'pkcs8', format: 'pem' }),
70:     stateRoot: path.resolve(directory, value.stateRoot as string),
71:     pollMilliseconds: integer(value.pollMilliseconds, 'pollMilliseconds', 10),
72:     maximumResponseBytes: integer(value.maximumResponseBytes, 'maximumResponseBytes'),
73:     maximumResultBytes: integer(value.maximumResultBytes, 'maximumResultBytes'),
74:     maximumArchiveBytes: integer(value.maximumArchiveBytes, 'maximumArchiveBytes'),
75:     maximumArchiveStoreBytes: integer(value.maximumArchiveStoreBytes, 'maximumArchiveStoreBytes'),
76:     maximumEvidenceBytes: integer(value.maximumEvidenceBytes, 'maximumEvidenceBytes'),
77:     maximumEvidenceStoreBytes: integer(value.maximumEvidenceStoreBytes, 'maximumEvidenceStoreBytes'),
78:     recordLimits: {
79:       maximumRecords: integer(records.maximumRecords, 'recordLimits.maximumRecords'),
80:       maximumBytes: integer(records.maximumBytes, 'recordLimits.maximumBytes'),
81:       maximumRecordBytes: integer(records.maximumRecordBytes, 'recordLimits.maximumRecordBytes'),
82:     },
83:   });
84: }
