10: export interface BusterFixtureJournalLimits {
11:   readonly maximumRecords: number;
12:   readonly maximumStateBytes: number;
13:   readonly maximumBlobBytes: number;
14:   readonly maximumTotalBytes: number;
15: }
16: 
17: const stream = 'buster-fixtures.v1';
18: 
19: /** Durable Buster phases only. Readiness does not grant ownership or prove kernel quiescence. */
20: export class FileBusterFixtureJournal {
21:   readonly #root: string;
22:   readonly #limits: BusterFixtureJournalLimits;
23:   readonly #records: FileDurableRecordStore;
24:   readonly #blobs: FileDurableBlobStore;
25: 
26:   constructor(root: string, limits: BusterFixtureJournalLimits) {
27:     if (!path.isAbsolute(root) || Object.values(limits).some(value => !Number.isSafeInteger(value) || value < 1)) {
28:       throw new Error('BUSTER_FIXTURE_JOURNAL_CONFIG_INVALID');
29:     }
30:     this.#root = path.resolve(root); this.#limits = { ...limits };
31:     this.#records = new FileDurableRecordStore(path.join(this.#root, 'metadata'), {
32:       maximumRecords: limits.maximumRecords, maximumBytes: limits.maximumStateBytes, maximumRecordBytes: 4096,
33:     });
34:     this.#blobs = new FileDurableBlobStore(path.join(this.#root, 'data'), limits.maximumBlobBytes, limits.maximumTotalBytes);
35:   }
36: 
37:   async reserve(input: BusterFixtureAdmission): Promise<BusterFixtureState> {
38:     const admission = structuredClone(input); validateFixtureAdmission(admission);
39:     const bytes = Buffer.from(canonicalJson(admission));
40:     if (bytes.byteLength > this.#limits.maximumBlobBytes) throw new Error('BUSTER_FIXTURE_ADMISSION_SIZE_LIMIT');
41:     return this.#locked(async () => {
42:       const records = await this.#all(); const key = fixtureKey(admission);
43:       const existing = records.find(record => record.idempotencyKey === key);
44:       if (existing) { await this.#bound(existing, admission); return existing.payload; }
45:       if (records.length >= this.#limits.maximumRecords) throw new Error('BUSTER_FIXTURE_JOURNAL_RECORD_LIMIT');
46:       const reservedBytes = bytes.byteLength + 2 * this.#limits.maximumBlobBytes;
47:       const pending = records.filter(record => !record.payload.terminal).reduce((sum, record) => sum + record.payload.reservedBytes, 0);
48:       const requested = await retainedBytes(this.#root) + pending + reservedBytes + 2 * this.#limits.maximumStateBytes;
49:       if (!Number.isSafeInteger(requested) || requested > this.#limits.maximumTotalBytes) throw new Error('BUSTER_FIXTURE_JOURNAL_CAPACITY_EXCEEDED');
50:       const state: BusterFixtureState = { schemaVersion: 'buster-fixture-state.v1', admission: await this.#blobs.put(bytes),
51:         acceptedAt: new Date().toISOString(), readiness: null, teardown: null, terminal: null, reservedBytes };
52:       validateFixtureState(state);
53:       return (await this.#records.append(stream, key, state, `buster-fixture:${key.slice(7)}`)).record.payload;
54:     });
55:   }
56: 
57:   async ready(input: BusterFixtureAdmission, readinessValue: BusterFixtureReadiness): Promise<BusterFixtureState> {
58:     const admission = structuredClone(input); const readiness = structuredClone(readinessValue);
59:     validateFixtureAdmission(admission); validateFixtureReadiness(readiness, admission);
60:     return this.#locked(async () => {
61:       const current = await this.#required(admission);
62:       if (current.payload.readiness) {
63:         if (!sameFixtureValue(await this.#json(current.payload.readiness), readiness)) throw new Error('BUSTER_FIXTURE_READINESS_IMMUTABLE');
64:         return current.payload;
65:       }
66:       if (current.payload.teardown || current.payload.terminal) throw new Error('BUSTER_FIXTURE_READINESS_FENCED');
67:       if (Date.parse(readiness.readyAt) < Date.parse(current.payload.acceptedAt)) throw new Error('BUSTER_FIXTURE_READINESS_BEFORE_ADMISSION');
