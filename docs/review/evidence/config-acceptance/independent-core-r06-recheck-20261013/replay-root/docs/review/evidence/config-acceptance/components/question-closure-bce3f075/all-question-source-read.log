25: export function assertPreparedPlanJobRecord(value: unknown): asserts value is PreparedPlanJobRecord {
26:   if (!value || typeof value !== 'object' || Array.isArray(value)
27:     || Object.keys(value).sort().join(',') !== 'input,job,resultOrigin,schemaVersion,source,status') {
28:     throw new Error('BUSTER_JOB_RECORD_INVALID');
29:   }
30:   const payload = value as PreparedPlanJobRecord;
31:   if (payload.schemaVersion !== 'buster-plan-job-record.v2') throw new Error('BUSTER_JOB_RECORD_INVALID');
32:   assertBusterInput(payload.input, payload.job);
33:   if (payload.source !== null) assertPreparedSource(payload.source, payload.job);
34:   validatePipelineTestGateContract('remotePlanStatus', payload.status);
35:   assertPreparedResultOrigin(payload.resultOrigin, payload.status);
36:   if (payload.resultOrigin?.kind === 'historical'
37:     && (payload.input.schemaVersion !== 'buster-historical-input.v1'
38:       || payload.resultOrigin.importId !== payload.input.importId
39:       || payload.resultOrigin.originalPayloadDigest !== payload.input.originalPayloadDigest)) {
40:     throw new Error('BUSTER_RESULT_ORIGIN_INVALID');
41:   }
42:   if (payload.status.jobId !== payload.job.jobId || payload.status.requestDigest !== payload.job.requestDigest) {
43:     throw new Error('BUSTER_REMOTE_JOB_CONFLICT');
44:   }
45: }
