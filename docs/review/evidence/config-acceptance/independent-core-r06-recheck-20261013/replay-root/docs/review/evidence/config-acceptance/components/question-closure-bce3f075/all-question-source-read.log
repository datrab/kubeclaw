356: export async function reconcileNovaObservabilityOnRecovery(
357:   runRoot: string,
358:   pipelineRunId: string,
359:   now?: () => Date,
360: ): Promise<ReconciliationDecision[]> {
361:   const root = observabilityRoot(runRoot);
362:   const planFile = path.join(root, "reconciliation-plan.json");
363:   if (!fs.existsSync(planFile)) return [];
364:   const parsed = JSON.parse(
365:     fs.readFileSync(planFile, "utf8"),
366:   ) as Partial<PersistedReconciliationPlan>;
367:   if (
368:     parsed.schemaVersion !== "nova-observability-plan.v1" ||
369:     parsed.pipelineRunId !== pipelineRunId ||
370:     !Array.isArray(parsed.attempts) ||
371:     parsed.attempts.some(
372:       (item) =>
373:         !item ||
374:         typeof item !== "object" ||
375:         item.pipelineRunId !== pipelineRunId ||
376:         typeof item.planId !== "string" ||
377:         item.planId.length === 0 ||
378:         typeof item.nodeId !== "string" ||
379:         item.nodeId.length === 0,
380:     )
381:   )
382:     throw new Error("NOVA_OBSERVABILITY_PLAN_INVALID");
383:   const reconciler = new NovaObservabilityReconciler({
384:     attemptStore: new FileDurableAttemptStore(
385:       path.join(root, "attempts"),
386:       EMBEDDED_ATTEMPT_LIMITS,
387:     ),
388:     admissionStore: new FileObservabilityAdmissionStore(
389:       path.join(root, "admission"),
390:       EMBEDDED_ADMISSION_LIMITS,
391:     ),
392:     journalFile: path.join(root, "reconciliation.jsonl"),
393:     ...(now ? { now } : {}),
394:   });
395:   return reconciler.reconcile(parsed.attempts);
396: }
