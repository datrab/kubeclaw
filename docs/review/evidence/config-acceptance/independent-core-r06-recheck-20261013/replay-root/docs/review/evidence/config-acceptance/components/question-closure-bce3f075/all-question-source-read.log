56: export function preparationSourceDirectory(root: string, admissionId: string): string {
57:   if (typeof admissionId !== 'string' || !/^[a-f0-9]{32}$/u.test(admissionId) || !path.isAbsolute(root) || path.resolve(root) !== root || root === '/') {
58:     throw new Error('BUSTER_PREPARATION_PATH_INVALID');
59:   }
60:   return path.join(root, admissionId, 'data');
61: }
