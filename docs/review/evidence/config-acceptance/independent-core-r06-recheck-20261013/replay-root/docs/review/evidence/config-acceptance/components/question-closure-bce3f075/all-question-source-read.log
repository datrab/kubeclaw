135: #define DENY_SYSCALL(name) \
136:   BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_##name, 0, 1), \
137:   BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | (EPERM & SECCOMP_RET_DATA))
138: 
139: /* Denied syscalls return EPERM so approved runtimes can report a contained
140:    failure. KILL_PROCESS below is only the fail-closed wrong-architecture case. */
141: 
142: static int install_filter(int allow_network) {
143:   struct sock_filter filter[] = {
144:     BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, arch)),
145:     BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_X86_64, 1, 0),
146:     BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),
147:     BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
148:     DENY_SYSCALL(socket),
149:     DENY_SYSCALL(connect),
150:     DENY_SYSCALL(bind),
151:     DENY_SYSCALL(listen),
152:     DENY_SYSCALL(accept),
153:     DENY_SYSCALL(accept4),
154:     DENY_SYSCALL(sendto),
155:     DENY_SYSCALL(sendmsg),
156:     DENY_SYSCALL(recvfrom),
157:     DENY_SYSCALL(recvmsg),
158:     DENY_SYSCALL(ptrace),
159:     DENY_SYSCALL(mount),
160:     DENY_SYSCALL(umount2),
161:     DENY_SYSCALL(unshare),
162:     DENY_SYSCALL(setns),
163:     DENY_SYSCALL(bpf),
164:     DENY_SYSCALL(perf_event_open),
165:     DENY_SYSCALL(keyctl),
166:     DENY_SYSCALL(add_key),
167:     DENY_SYSCALL(request_key),
168:     DENY_SYSCALL(open_by_handle_at),
169:     DENY_SYSCALL(symlink),
170:     DENY_SYSCALL(symlinkat),
171:     DENY_SYSCALL(link),
172:     DENY_SYSCALL(linkat),
173:     DENY_SYSCALL(init_module),
174:     DENY_SYSCALL(finit_module),
175:     DENY_SYSCALL(delete_module),
176:     BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW),
177:   };
178:   struct sock_filter network_filter[] = {
179:     BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, arch)),
180:     BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_X86_64, 1, 0),
181:     BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_KILL_PROCESS),
182:     BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
183:     /* Browser mode permits Internet-domain stream sockets only. Unix-domain
184:        sockets remain available for the browser process tree. Datagram and raw
185:        Internet sockets stay denied, including direct DNS and QUIC egress. */
186:     BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, __NR_socket, 0, 9),
187:     BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, args[0])),
188:     BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AF_UNIX, 7, 0),
189:     BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AF_INET, 2, 0),
190:     BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AF_INET6, 1, 0),
191:     BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | (EPERM & SECCOMP_RET_DATA)),
192:     BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, args[1])),
193:     BPF_STMT(BPF_ALU | BPF_AND | BPF_K, SOCK_TYPE_MASK),
194:     BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, SOCK_STREAM, 1, 0),
195:     BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | (EPERM & SECCOMP_RET_DATA)),
196:     BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
197:     DENY_SYSCALL(ptrace),
198:     DENY_SYSCALL(mount),
199:     DENY_SYSCALL(umount2),
200:     DENY_SYSCALL(unshare),
201:     DENY_SYSCALL(setns),
202:     DENY_SYSCALL(bpf),
203:     DENY_SYSCALL(perf_event_open),
204:     DENY_SYSCALL(keyctl),
205:     DENY_SYSCALL(add_key),
206:     DENY_SYSCALL(request_key),
207:     DENY_SYSCALL(open_by_handle_at),
208:     DENY_SYSCALL(symlink),
209:     DENY_SYSCALL(symlinkat),
210:     DENY_SYSCALL(link),
211:     DENY_SYSCALL(linkat),
212:     DENY_SYSCALL(init_module),
213:     DENY_SYSCALL(finit_module),
214:     DENY_SYSCALL(delete_module),
215:     BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW),
216:   };
217:   struct sock_fprog program = {
218:     .len = (unsigned short)(allow_network ? sizeof(network_filter) / sizeof(network_filter[0]) : sizeof(filter) / sizeof(filter[0])),
219:     .filter = allow_network ? network_filter : filter,
220:   };
221:   if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0) return -1;
222:   return prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, &program);
223: }
