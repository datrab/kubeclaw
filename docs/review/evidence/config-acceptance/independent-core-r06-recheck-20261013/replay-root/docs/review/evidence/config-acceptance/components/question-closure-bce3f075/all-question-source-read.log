6: type Payload = Readonly<Record<string, unknown>>;
7: export interface Reservation { readonly stream: string; readonly key: string; readonly digest: string; }
8: function hash(value: string): string { return crypto.createHash('sha256').update(value).digest('hex'); }
9: function key(deliveryId: string, kind: string): string { return `delivery:${kind}:${hash(deliveryId)}`; }
10: export function deliveryIdentity(request: EffectRequest): string { return request.deliveryId ?? request.idempotencyKey; }
11: function completed(records: readonly DurableRecord<Payload>[], deliveryId: string): Payload | undefined {
12:   return records.find(entry => entry.idempotencyKey.endsWith(`:${hash(deliveryId)}`)
13:     && entry.payload.schemaVersion === 'notification-delivery-receipt.v1')?.payload.receipt as Payload | undefined;
14: }
15: 
16: export async function deliveryReceipt(records: FileDurableRecordStore, request: EffectRequest, transportPayload?: Payload): Promise<Payload | undefined> {
17:   const entries = await records.read<Payload>(`notifications/${request.resource.canonicalId}`);
18:   const projected = projectedDeliveryReceipt(entries, request, transportPayload);
19:   if (projected) return projected;
20:   if (request.deliveryId !== undefined) {
21:     const original = entries.find(entry => entry.idempotencyKey === key(request.deliveryId!, 'request'))?.payload;
22:     if (!original) return undefined;
23:     const owner = original.owner as Payload | undefined;
24:     if (original.schemaVersion !== 'notification-delivery-request.v2' || original.idempotencyKey !== request.deliveryId
25:       || original.target !== request.resource.canonicalId || owner?.runId !== request.attempt.runId || owner.stageId !== request.attempt.stageId
26:       || (transportPayload !== undefined && original.transportBody !== JSON.stringify(transportPayload))) throw new Error('OPERATOR_RECEIPT_REQUEST_UNBOUND');
27:   }
28:   return completed(entries, deliveryIdentity(request));
29: }
30: 
31: export async function reserveDelivery(records: FileDurableRecordStore, request: EffectRequest, payload: Payload, receiverSupported: boolean): Promise<Reservation | Payload> {
32:   const deliveryId = deliveryIdentity(request), stream = `notifications/${request.resource.canonicalId}`;
33:   const projected = projectedDeliveryReceipt(await records.read(stream), request, payload);
34:   if (projected) return projected;
35:   try { await records.append(stream, key(deliveryId, 'request'), request.deliveryId === undefined
36:     ? { schemaVersion: 'notification-delivery-request.v1', idempotencyKey: deliveryId, target: request.resource.canonicalId, payload }
37:     : { schemaVersion: 'notification-delivery-request.v2', idempotencyKey: deliveryId, target: request.resource.canonicalId,
38:       owner: { runId: request.attempt.runId, stageId: request.attempt.stageId }, transportBody: JSON.stringify(payload) }); }
39:   catch (error) {
40:     if (!(error instanceof Error) || error.message !== 'DURABLE_RECORD_IDEMPOTENCY_CONFLICT') throw error;
41:     const raced = projectedDeliveryReceipt(await records.read(stream), request, payload);
42:     if (raced) return raced;
43:     throw error;
44:   }
45:   const prior = await records.read<Payload>(stream), receipt = completed(prior, deliveryId);
46:   if (receipt) return receipt;
47:   const uncertain = prior.some(entry => entry.idempotencyKey.endsWith(`:${hash(deliveryId)}`)
48:     && ['notification-delivery-reservation.v1', 'notification-delivery-failure.v1'].includes(String(entry.payload.schemaVersion))
49:     && entry.payload.outcome !== 'not_sent');
50:   if (uncertain && !receiverSupported) throw new Error('OPERATOR_DELIVERY_UNRESOLVED:receiver_receipt_required');
51:   const terminalKey = key(deliveryId, `attempt-${request.attempt.attemptNumber}-${hash(request.attempt.attemptId).slice(0, 16)}`);
52:   const existing = prior.find(entry => entry.idempotencyKey === terminalKey);
53:   const reserved = existing ?? (await records.append<Payload>(stream, terminalKey, {
54:     schemaVersion: 'notification-delivery-reservation.v1', attempt: request.attempt, reserved: ' '.repeat(8192),
55:   })).record;
56:   if (reserved.payload.schemaVersion === 'notification-delivery-failure.v1') throw new Error(String(reserved.payload.error));
57:   return { stream, key: terminalKey, digest: reserved.payloadDigest };
58: }
59: 
60: export async function completeDelivery(records: FileDurableRecordStore, request: EffectRequest, reservation: Reservation, receipt: Payload): Promise<Payload> {
61:   const payload = { schemaVersion: 'notification-delivery-receipt.v1', attempt: request.attempt, receipt };
62:   try { await records.transition(reservation.stream, reservation.key, reservation.digest, payload); }
63:   catch (error) {
64:     if (!(error instanceof Error) || error.message !== 'DURABLE_RECORD_TRANSITION_CONFLICT') throw error;
65:     const current = await records.read<Payload>(reservation.stream), accepted = projectedDeliveryReceipt(current, request)
66:       ?? completed(current, deliveryIdentity(request));
67:     if (accepted) return accepted;
68:     const terminal = current.find(entry => entry.idempotencyKey === reservation.key);
69:     if (!terminal) throw error;
70:     await records.transition(reservation.stream, reservation.key, terminal.payloadDigest, payload);
71:   }
72:   return receipt;
73: }
74: 
75: export async function failDelivery(records: FileDurableRecordStore, request: EffectRequest, reservation: Reservation, sent: boolean, error: unknown): Promise<Payload> {
76:   const reason = error instanceof Error ? error.message : String(error);
77:   try {
78:     await records.transition(reservation.stream, reservation.key, reservation.digest, {
79:       schemaVersion: 'notification-delivery-failure.v1', idempotencyKey: deliveryIdentity(request), target: request.resource.canonicalId,
80:       attempt: request.attempt, outcome: sent ? 'possible' : 'not_sent', reasonId: hash(reason).slice(0, 16), error: reason.slice(0, 2048),
81:     });
82:   } catch (transitionError) {
83:     if (transitionError instanceof Error && transitionError.message === 'DURABLE_RECORD_TRANSITION_CONFLICT') {
84:       const accepted = await deliveryReceipt(records, request); if (accepted) return accepted;
85:     }
86:     throw transitionError;
87:   }
88:   throw error;
89: }
