1: import type { AdapterActivationContext, AdapterInstance } from '@kubeclaw/plugin-sdk';
2: import { FileDurableRecordStore } from '@kubeclaw/plugin-foundation/observability/durable-records';
3: import { telemetryProjection } from './projection.ts';
4: 
5: export function activate(context: AdapterActivationContext): AdapterInstance {
6:   const root = context.config.root;
7:   if (typeof root !== 'string' || root.length === 0) throw new Error('root is required');
8:   const maxRecordBytes = Number(context.config.maxRecordBytes ?? 1_048_576);
9:   const maximumRecords = Number(context.config.maximumRecords ?? 100_000);
10:   const maximumStoreBytes = Number(context.config.maximumStoreBytes ?? 256 * 1024 * 1024);
11:   if (!Number.isSafeInteger(maxRecordBytes) || maxRecordBytes < 1) throw new Error('maxRecordBytes is invalid');
12:   if (!Number.isSafeInteger(maximumRecords) || maximumRecords < 1) throw new Error('maximumRecords is invalid');
13:   if (!Number.isSafeInteger(maximumStoreBytes) || maximumStoreBytes < 1) throw new Error('maximumStoreBytes is invalid');
14:   const store = new FileDurableRecordStore(root, {
15:     maximumRecords,
16:     maximumBytes: maximumStoreBytes,
17:     maximumRecordBytes: maxRecordBytes,
18:   });
19:   const stream = 'telemetry/plugin-events';
20:   return {
21:     async ready() { await store.read<Record<string, unknown>>(stream); },
22:     async invoke({ request, signal, confidential, fence }) {
23:       if (!confidential) fence.assertCurrent();
24:       if (request.capability !== 'telemetry.emit' || request.operation !== 'append') throw new Error('TELEMETRY_OPERATION_UNSUPPORTED');
25:       if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
26:       try {
27:         const committed = await store.append(
28:           stream,
29:           request.idempotencyKey,
30:           telemetryProjection(request.payload, maxRecordBytes),
31:           request.attempt.runId,
32:         );
33:         return { accepted: committed.appended, sequence: committed.record.sequence };
34:       } catch (error) {
35:         if (error instanceof Error && error.message === 'DURABLE_RECORD_SIZE_EXCEEDED') {
36:           throw new Error('TELEMETRY_RECORD_SIZE_EXCEEDED');
37:         }
38:         throw error;
39:       }
40:     },
41:     async shutdown() {},
42:   };
43: }
