49: function assertPublicationIdentity(intent: Record<string, unknown>, candidate: Stats, receipt: HistoricalImportReceipt): void {
50:   if (Object.keys(intent).sort().join(',') !== 'device,inode,nativeResultDigest,schemaVersion'
51:     || intent.schemaVersion !== 'buster-historical-publication-intent.v1'
52:     || intent.nativeResultDigest !== receipt.nativeResultDigest || candidate.dev !== intent.device
53:     || candidate.ino !== intent.inode || !candidate.isDirectory()) throw new Error('BUSTER_HISTORICAL_PUBLICATION_INTENT_INVALID');
54: }
