225: static int limit_resource(int resource, unsigned long long value) {
226:   struct rlimit limit = {
227:     .rlim_cur = (rlim_t)value,
228:     .rlim_max = (rlim_t)value,
229:   };
230:   return setrlimit(resource, &limit);
231: }
