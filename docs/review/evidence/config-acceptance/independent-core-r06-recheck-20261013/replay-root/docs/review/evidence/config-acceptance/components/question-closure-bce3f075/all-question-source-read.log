287: async function childAtMarker(t,script,args,marker) {
288:   const child=spawn(process.execPath,['--input-type=module','-e',script,...args],{stdio:['ignore','pipe','pipe']});
289:   t.after(()=>{if(child.exitCode===null)child.kill('SIGKILL');});
290:   let stderr='';child.stderr.on('data',chunk=>stderr+=chunk);
291:   await new Promise((resolve,reject)=>{
292:     let output='';
293:     child.stdout.on('data',chunk=>{output+=chunk;if(output.includes(marker))resolve();});
294:     child.once('exit',(code,signal)=>reject(new Error(`child ${code}/${signal}: ${stderr}`)));
295:   });
296:   return child;
297: }
