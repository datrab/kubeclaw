66: export function retainedTerminal(records: ReadonlyArray<DurableRecord>, request: EffectRequest): DurableRecord<Payload> {
67:   const stream = `notifications/${request.resource.canonicalId}`, suffix = `:${hash(request.idempotencyKey)}`;
68:   const selected = records.filter(record => record.stream === stream && record.idempotencyKey.endsWith(suffix)
