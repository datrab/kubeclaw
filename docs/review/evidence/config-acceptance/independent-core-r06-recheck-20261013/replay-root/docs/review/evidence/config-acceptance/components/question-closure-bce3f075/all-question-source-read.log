94: /** The single current.json rename commits both members; loose files alone never authorize execution. */
95: export async function publishJsonPair(root:string,names:readonly [string,string],values:readonly [unknown,unknown]):Promise<void> {
96:   root=path.resolve(root);namesValid(names);const rootPins=pins(root);
