39:   const f = budgetFixture(root, failures); const runId = 'run:retirement';
40:   const result = await runPipelineV2(f.platform, f.definition, runId);
41:   const target = runRoot(f.platform.storageRoot, runId);
42:   fs.writeFileSync(path.join(target, 'final-report.txt'), canary);
43:   const scope = { schemaVersion: 'observability-retirement-scope.v1', runId, novaStorageRoot: f.platform.storageRoot,
44:     artifactRoots: [path.join(root, 'artifacts')], telemetryRoots: [], busterStores: [] };
45:   return { root, f, result, runId, target, scope };
46: }
47: function inspect(f) {
48:   const before = snapshot(f.root); const plan = planRetirement(f.scope);
49:   assert.deepEqual(snapshot(f.root), before, 'planning preserves bytes, mtimes and file set');
50:   assert.equal(plan.executable, false); assert.equal(plan.releaseBytes, 0);
51:   assert.ok(plan.files.every(file => file.disposition === 'retain'));
52:   assert.ok(!JSON.stringify(plan).includes(canary), 'payload and diagnostic secrets are omitted');
53:   return plan;
54: }
55: function codes(plan) { return new Set(plan.blockers.map(item => item.code)); }
