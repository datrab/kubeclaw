199:         throw new Error('BUSTER_REMOTE_RESULT_CONFLICT');
200:       }
201:       return current.payload.status;
202:     }
203:     if (current.payload.status.state !== 'running') {
204:       throw new Error(`BUSTER_REMOTE_JOB_STATE_CONFLICT:${current.payload.status.state}`);
205:     }
206:     const storedResult = await this.#results.put(bytes);
207:     const status: RemotePlanStatusV1 = {
208:       ...current.payload.status,
209:       state: 'completed',
210:       updatedAt: now,
211:       result: {
212:         schemaVersion: 'buster-plan-result-ref.v1',
213:         resultDigest: result.resultDigest,
214:         contentDigest: storedResult.digest,
215:         sizeBytes: storedResult.sizeBytes,
216:       },
217:       error: null,
218:     };
219:     validatePipelineTestGateContract('remotePlanStatus', status);
220:     const next: StoredPlanJob = { ...current.payload, status };
221:     const stored = await this.#records.transition(
222:       'buster-plan-jobs', current.record.idempotencyKey, current.record.payloadDigest, next,
223:     );
224:     return structuredClone((stored.payload as StoredPlanJob).status);
225:   }
