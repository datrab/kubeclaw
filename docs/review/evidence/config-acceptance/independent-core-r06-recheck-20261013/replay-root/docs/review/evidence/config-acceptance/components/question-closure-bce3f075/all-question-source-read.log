235:   async complete(jobId: string, result: RemotePlanResultV1, now: string): Promise<RemotePlanStatusV1> {
236:     result = structuredClone(result);
237:     validatePipelineTestGateContract('remotePlanResult', result);
238:     return withDurableStoreLock(this.#admissionLock, () => this.#complete(jobId, result, now));
239:   }
240: 
241:   async #complete(jobId: string, result: RemotePlanResultV1, now: string): Promise<RemotePlanStatusV1> {
242:     const current = await this.get(jobId);
243:     const job = current.payload.job;
244:     if (result.jobId !== jobId || result.planId !== job.plan.planId
245:       || result.planDigest !== job.plan.planDigest || result.runId !== job.plan.runId) throw new Error('BUSTER_REMOTE_RESULT_IDENTITY_MISMATCH');
246:     const bytes = Buffer.from(canonicalJson(result));
247:     if (bytes.byteLength > this.#maximumResultBytes) throw new Error('BUSTER_REMOTE_RESULT_SIZE_EXCEEDED');
248:     const contentDigest = `sha256:${crypto.createHash('sha256').update(bytes).digest('hex')}`;
