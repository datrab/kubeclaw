76:       // The first durable intent remains authoritative across cancellation/recovery retries.
77:       if (current.payload.teardown || current.payload.terminal) return current.payload;
78:       return this.#transition(current, { ...current.payload, teardown: { requestedAt: new Date().toISOString(), reason } });
79:     });
80:   }
81: 
82:   /** Only the original sealed Core journal can supply the final lifetime receipt. */
83:   async seal(input: BusterFixtureAdmission, journal: NativeAttemptJournal): Promise<BusterFixtureState> {
84:     const admission = structuredClone(input); validateFixtureAdmission(admission);
85:     const result = await journal.readResult(admission.envelope);
86:     if (!result || !checkWorkerNativeResultBinding(admission.envelope, result).ok) throw new Error('BUSTER_FIXTURE_TERMINAL_RECEIPT_REQUIRED');
87:     return this.#locked(async () => {
88:       const current = await this.#required(admission);
89:       if (current.payload.terminal) {
90:         if (!sameFixtureValue(await this.#json(current.payload.terminal), result)) throw new Error('BUSTER_FIXTURE_TERMINAL_IMMUTABLE');
91:         return current.payload;
92:       }
93:       terminalBinding(current.payload, result);
94:       return this.#transition(current, { ...current.payload, terminal: await this.#blobs.put(Buffer.from(canonicalJson(result))) });
95:     });
96:   }
97: 
98:   async snapshot(): Promise<readonly { admission: BusterFixtureAdmission; state: BusterFixtureState;
99:     readiness: BusterFixtureReadiness | null; terminal: WorkerAttemptResultV3 | null }[]> {
100:     return this.#locked(async () => {
101:       const output = [];
102:       for (const record of await this.#all()) {
103:         const admission = await this.#json(record.payload.admission); validateFixtureAdmission(admission); await this.#bound(record, admission);
104:         const readiness = record.payload.readiness ? await this.#json(record.payload.readiness) : null;
105:         if (readiness !== null) validateFixtureReadiness(readiness, admission);
106:         const terminal = record.payload.terminal ? await this.#json(record.payload.terminal) : null;
107:         if (terminal !== null) {
108:           validateWorkerResourceContractV3('workerAttemptResult', terminal);
109:           if (!checkWorkerNativeResultBinding(admission.envelope, terminal as WorkerAttemptResultV3).ok) throw new Error('BUSTER_FIXTURE_TERMINAL_BINDING_INVALID');
110:           terminalBinding(record.payload, terminal as WorkerAttemptResultV3);
111:         }
112:         output.push({ admission, state: record.payload, readiness: readiness as BusterFixtureReadiness | null,
113:           terminal: terminal as WorkerAttemptResultV3 | null });
114:       }
115:       return output;
116:     });
117:   }
118: 
119:   async #locked<T>(operation: () => Promise<T>): Promise<T> {
120:     await ensureDirectoryDurable(path.dirname(this.#root));
121:     try { await fs.mkdir(this.#root, { mode: 0o700 }); }
122:     catch (error) { if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error; }
123:     const stat = await fs.lstat(this.#root);
124:     if (!stat.isDirectory() || stat.uid !== process.getuid!() || (stat.mode & 0o077)) throw new Error('BUSTER_FIXTURE_JOURNAL_NOT_PRIVATE');
125:     return withDurableStoreLock(path.join(this.#root, 'phases', 'lifetime'), operation);
126:   }
127: 
128:   async #all(): Promise<readonly DurableRecord<BusterFixtureState>[]> {
129:     const records = await this.#records.read<BusterFixtureState>(stream);
130:     for (const record of records) validateFixtureState(record.payload);
131:     return records;
132:   }
133: 
134:   async #bound(record: DurableRecord<BusterFixtureState>, admission: BusterFixtureAdmission): Promise<void> {
135:     if (record.idempotencyKey !== fixtureKey(admission) || record.payload.admission.digest !== sha256Digest(admission)) {
136:       throw new Error('BUSTER_FIXTURE_IDENTITY_CONFLICT');
137:     }
138:     if (!sameFixtureValue(await this.#json(record.payload.admission), admission)) throw new Error('BUSTER_FIXTURE_IDENTITY_CONFLICT');
139:   }
140: 
141:   async #required(admission: BusterFixtureAdmission): Promise<DurableRecord<BusterFixtureState>> {
142:     const record = (await this.#all()).find(record => record.idempotencyKey === fixtureKey(admission));
143:     if (!record) throw new Error('BUSTER_FIXTURE_ADMISSION_REQUIRED');
144:     await this.#bound(record, admission); return record;
145:   }
146: 
147:   async #transition(current: DurableRecord<BusterFixtureState>, state: BusterFixtureState): Promise<BusterFixtureState> {
148:     validateFixtureState(state);
149:     return (await this.#records.transition(stream, current.idempotencyKey, current.payloadDigest, state)).payload;
150:   }
151: 
152:   async #json(reference: FixtureBlob): Promise<unknown> {
153:     const bytes = await this.#blobs.get(reference.digest);
154:     if (bytes.byteLength !== reference.sizeBytes) throw new Error('BUSTER_FIXTURE_BLOB_SIZE_CHANGED');
155:     return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes));
156:   }
157: }
158: 
159: function terminalBinding(state: BusterFixtureState, result: WorkerAttemptResultV3): void {
160:   if (state.readiness && result.cleanup.state === 'not_required') throw new Error('BUSTER_FIXTURE_LAUNCH_STATE_CONFLICT');
161:   if (result.state === 'completed' && (!state.readiness || !state.teardown || result.cleanup.state !== 'completed'
162:     || result.specialistResult?.values.fixtureReadinessDigest !== state.readiness.digest)) {
163:     throw new Error('BUSTER_FIXTURE_LIFETIME_NOT_COMPLETED');
164:   }
165: }
166: 
167: async function retainedBytes(root: string): Promise<number> {
168:   let total = 0; const pending = [root];
169:   while (pending.length) {
170:     for (const entry of await fs.readdir(pending.pop()!, { withFileTypes: true })) {
171:       const file = path.join(entry.parentPath, entry.name);
172:       if (entry.isDirectory()) { pending.push(file); continue; }
173:       if (!entry.isFile()) throw new Error('BUSTER_FIXTURE_JOURNAL_PATH_INVALID');
174:       total += (await fs.lstat(file)).size;
175:       if (!Number.isSafeInteger(total)) throw new Error('BUSTER_FIXTURE_JOURNAL_CAPACITY_EXCEEDED');
176:     }
177:   }
178:   return total;
179: }
{"path": "skills/buster/engine/test-gates/preparation-archive.ts", "sha256": "a3f47267addf5e371faff3896521eb3aac35b49523275a7766ed29c8d1d42f6a"}
1: import { spawn } from 'node:child_process';
2: import type { BusterPreparationSettings } from '../../../common/plugin-runtime/foundation/config/swarm.ts';
3: 
4: export type ArchivePreparationLimits = Pick<BusterPreparationSettings, 'maximumExtractedBytes' | 'tarTimeoutMs'
5:   | 'maximumArchiveEntries' | 'maximumListingLineBytes' | 'maximumTarStderrBytes'>;
6: 
7: async function runTar(
8:   executable: string,
9:   args: readonly string[],
10:   signal: AbortSignal,
11:   limits: ArchivePreparationLimits,
12:   onLine?: (line: string) => void,
13: ): Promise<void> {
14:   signal.throwIfAborted();
15:   await new Promise<void>((resolve, reject) => {
16:     const child = spawn(executable, [...args], { stdio: ['ignore', 'pipe', 'pipe'] });
17:     let fault: Error | null = null;
18:     let pending = '';
19:     let stderr = Buffer.alloc(0);
20:     const stop = (error: Error): void => {
21:       fault ??= error;
22:       child.kill('SIGKILL');
23:     };
24:     const timer = setTimeout(() => stop(new Error('BUSTER_REMOTE_ARCHIVE_TIMEOUT')), limits.tarTimeoutMs);
25:     const abort = () => stop(new Error('BUSTER_REMOTE_ARCHIVE_CANCELLED'));
26:     signal.addEventListener('abort', abort, { once: true });
27:     child.stdout.on('data', (chunk: Buffer) => {
28:       if (!onLine || fault) return;
29:       pending += chunk.toString('utf8');
30:       if (Buffer.byteLength(pending) > limits.maximumListingLineBytes) {
31:         stop(new Error('BUSTER_REMOTE_ARCHIVE_LISTING_EXCEEDED'));
32:         return;
33:       }
34:       const lines = pending.split('\n');
35:       pending = lines.pop() ?? '';
36:       try { for (const line of lines) if (line) onLine(line); }
37:       catch (error) { stop(error instanceof Error ? error : new Error(String(error))); }
38:     });
39:     child.stderr.on('data', (chunk: Buffer) => {
40:       const available = Math.max(0, limits.maximumTarStderrBytes - stderr.byteLength);
41:       stderr = Buffer.concat([stderr, chunk.subarray(0, available)]);
42:     });
43:     child.once('error', (error) => { fault ??= error; });
44:     child.once('close', (code, terminationSignal) => {
45:       clearTimeout(timer);
46:       signal.removeEventListener('abort', abort);
47:       if (!fault && onLine && pending) {
48:         try { onLine(pending); } catch (error) { fault = error instanceof Error ? error : new Error(String(error)); }
49:       }
50:       if (fault) reject(fault);
51:       else if (code !== 0) reject(new Error(`BUSTER_REMOTE_TAR_FAILED:${code}:${terminationSignal ?? ''}:${stderr.toString('utf8').slice(-4096)}`));
52:       else resolve();
53:     });
54:   });
55: }
56: 
57: export async function safeExtract(
58:   tarExecutable: string,
59:   archive: string,
60:   target: string,
61:   limits: ArchivePreparationLimits,
62:   signal: AbortSignal,
63: ): Promise<void> {
64:   let entries = 0;
65:   let total = 0;
66:   const unsafeName = (name: string): boolean => {
67:     if (name.startsWith('/') || name.includes('\0')) return true;
68:     const normalized = name.endsWith('/') ? name.slice(0, -1) : name;
69:     const parts = normalized.split('/');
70:     return parts.some((part, index) => part === '..' || part === '' || (part === '.' && index !== 0));
71:   };
