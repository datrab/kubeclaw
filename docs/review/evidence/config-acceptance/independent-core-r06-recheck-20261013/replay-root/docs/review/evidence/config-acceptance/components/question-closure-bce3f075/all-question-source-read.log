91: /** Files remain unpublished until the parent records the authoritative native receipt. */
92: export async function materializePreparedSource(job: RemotePlanJobV1, assigned: {
93:   admissionId: string; attemptSpecDigest: string; root: string; tarExecutable: string;
94:   settings: BusterPreparationSettings; signal: AbortSignal; onAllocated: () => void;
95: }): Promise<PreparedSource> {
96:   const { admissionId, attemptSpecDigest, root, tarExecutable, settings, signal, onAllocated } = assigned;
97:   const prepared = preparedSourceMetadata(job, admissionId, attemptSpecDigest, settings);
98:   const metadata = Buffer.from(JSON.stringify(prepared));
99:   signal.throwIfAborted();
100:   const directory = preparationSourceDirectory(root, admissionId);
101:   await fs.mkdir(directory, { mode: 0o700 });
102:   onAllocated();
103:   await writeExclusive(path.join(directory, 'owner.json'), Buffer.from(JSON.stringify({
104:     schemaVersion: 'buster-preparation-owner.v1', admissionId, attemptSpecDigest,
105:     claimId: `claim-${admissionId}`, generation: 1,
106:   })));
107:   const repository = path.join(directory, 'repository');
108:   await ensureDirectoryDurable(repository);
109:   const archive = path.join(directory, 'repository.tar.gz');
110:   await writeExclusive(archive, repositoryArchiveBytes(job.repositoryArchive));
111:   await safeExtract(tarExecutable, archive, repository, settings, signal);
112:   await synchronizeRepository(repository, signal);
113:   await writeExclusive(path.join(directory, 'source.json'), metadata);
114:   await fs.chmod(path.join(directory, 'source.json'), 0o444);
115:   await fs.chmod(directory, 0o755);
116:   for (const item of [directory, path.dirname(directory)]) {
117:     const handle = await fs.open(item, 'r');
118:     try { await handle.sync(); } finally { await handle.close(); }
119:   }
120:   return prepared;
121: }
122: 
123: async function synchronizeRepository(directory: string, signal: AbortSignal): Promise<void> {
124:   const entries = await fs.opendir(directory);
125:   for await (const entry of entries) {
126:     signal.throwIfAborted();
127:     const file = path.join(directory, entry.name);
128:     if (entry.isDirectory()) await synchronizeRepository(file, signal);
129:     else if (entry.isFile()) {
130:       const handle = await fs.open(file, 'r');
131:       try {
132:         const stat = await handle.stat();
133:         await handle.chmod(0o644 | (stat.mode & 0o111 ? 0o111 : 0));
134:         await handle.sync();
135:       } finally { await handle.close(); }
136:     } else throw new Error('BUSTER_REMOTE_ARCHIVE_TYPE_DENIED');
137:   }
138:   const handle = await fs.open(directory, 'r');
139:   try { await handle.chmod(0o755); await handle.sync(); } finally { await handle.close(); }
140: }
