56: async function candidatePath(source: string, target: string, intentFile: string,
57:   receipt: HistoricalImportReceipt, maximumBytes: number): Promise<string> {
58:   try { await fs.lstat(source); return source; }
59:   catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
60:   // A crash can occur after rename, before receipt publication. The exact
61:   // native result still binds this candidate before any service has started.
62:   const handle = await fs.open(intentFile, 'r');
63:   try {
64:     const stat = await handle.stat();
65:     if (!stat.isFile() || stat.uid !== 0 || stat.nlink !== 1 || stat.size > maximumBytes
66:       || (stat.mode & 0o777) !== 0o400 || await fs.realpath(intentFile) !== intentFile) {
67:       throw new Error('BUSTER_HISTORICAL_PUBLICATION_INTENT_INVALID');
68:     }
69:     const bytes = Buffer.alloc(stat.size + 1);
70:     const read = await handle.read(bytes, 0, bytes.length, 0);
71:     if (read.bytesRead !== stat.size) throw new Error('BUSTER_HISTORICAL_PUBLICATION_INTENT_INVALID');
72:     const intent = JSON.parse(bytes.subarray(0, stat.size).toString('utf8'));
73:     const candidate = await fs.lstat(target);
74:     assertPublicationIdentity(intent, candidate, receipt);
75:     return target;
76:   } finally { await handle.close(); }
77: }
