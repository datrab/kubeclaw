1: import fs, {type Stats} from 'node:fs';
2: import fsp from 'node:fs/promises';
3: import path from 'node:path';
4: import crypto from 'node:crypto';
5: import { ensureDirectoryDurable, withDurableStoreLock, writeDurableState } from '../observability/durable-delivery.ts';
6: 
7: const LIMIT = 64 * 1024 * 1024;
8: const DIRECTORY = '.scaffold-publication';
9: type Member = { name: string; digest: string; bytes: number };
10: type Manifest = { schemaVersion: 'published-json-pair.v1'; generation: string; members: [Member, Member] };
11: const digest = (bytes: Buffer | string) => crypto.createHash('sha256').update(bytes).digest('hex');
12: const generationId = (members: readonly Member[]) => digest(JSON.stringify(members.map(member=>[member.name,member.digest,member.bytes])));
13: function fail(code: string): never { throw new Error(`PUBLISHED_PAIR_${code}: reconcile explicitly with scaffold --apply`); }
14: function namesValid(names: readonly [string,string]): void {
15:   if (names[0] === names[1] || names.some(name => !/^[a-z][a-z0-9.-]*\.json$/u.test(name))) fail('NAMES_INVALID');
16: }
17: function present(file: string): boolean {
18:   try { fs.lstatSync(file); return true; } catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false; throw error; }
19: }
20: function pins(root: string): Map<string,Stats> {
21:   const result = new Map<string,Stats>(); let current = path.parse(root).root;
22:   for (const component of root.slice(current.length).split(path.sep).filter(Boolean)) {
23:     current = path.join(current,component); const stat = fs.lstatSync(current);
24:     if (!stat.isDirectory() || stat.isSymbolicLink()) fail('DIRECTORY_INVALID'); result.set(current,stat);
25:   }
26:   return result;
27: }
28: function verifyPins(values: Map<string,Stats>): void {
29:   for (const [file,stat] of values) {
30:     const actual=fs.lstatSync(file);
31:     if(!actual.isDirectory()||actual.dev!==stat.dev||actual.ino!==stat.ino)fail('CHANGED');
32:   }
33: }
34: function same(a:Stats,b:Stats):boolean {return a.dev===b.dev&&a.ino===b.ino&&a.size===b.size&&a.mtimeMs===b.mtimeMs&&a.ctimeMs===b.ctimeMs;}
35: function read(file:string,maximum=LIMIT):Buffer {
36:   const fd=fs.openSync(file,fs.constants.O_RDONLY|fs.constants.O_NOFOLLOW|fs.constants.O_NONBLOCK);
37:   try {
38:     const stat=fs.fstatSync(fd);if(!stat.isFile()||stat.size>maximum)fail('FILE_INVALID');
39:     const buffer=Buffer.alloc(stat.size+1);let offset=0;
40:     while(offset<buffer.length){const count=fs.readSync(fd,buffer,offset,buffer.length-offset,null);if(!count)break;offset+=count;}
41:     if(offset!==stat.size||!same(stat,fs.fstatSync(fd))||!same(stat,fs.lstatSync(file)))fail('CHANGED');
42:     return buffer.subarray(0,offset);
43:   }finally{fs.closeSync(fd);}
44: }
45: function validateMember(member:Member,name:string):void {
46:   if(!member||member.name!==name||!Number.isSafeInteger(member.bytes)||member.bytes<1||member.bytes>LIMIT
47:     ||!/^[a-f0-9]{64}$/u.test(member.digest)||Object.keys(member).sort().join(',')!=='bytes,digest,name')fail('MANIFEST_INVALID');
48: }
49: function manifestValue(bytes:Buffer,names:readonly [string,string]):Manifest {
50:   let value:Manifest;try{value=JSON.parse(bytes.toString());}catch{fail('MANIFEST_INVALID');}
51:   if(!value||value.schemaVersion!=='published-json-pair.v1'||!Array.isArray(value.members)||value.members.length!==2
52:     ||Object.keys(value).sort().join(',')!=='generation,members,schemaVersion')fail('MANIFEST_INVALID');
53:   value.members.forEach((member,index)=>validateMember(member,names[index]!));
54:   if(value.generation!==generationId(value.members))fail('MANIFEST_INVALID');return value;
55: }
56: /** A present but damaged publication never falls back to loose authored files. */
57: export function readPublishedPair(root:string,names:readonly [string,string],verifyCopies=true):readonly [unknown,unknown] {
58:   root=path.resolve(root);namesValid(names);const base=path.join(root,DIRECTORY);
59:   const rootPins=pins(root);
60:   if(!present(base)){
61:     const values=names.map(name=>{const file=path.join(root,name);return present(file)?JSON.parse(read(file).toString()):null;});
62:     if(present(base))fail('CHANGED');verifyPins(rootPins);return values as [unknown,unknown];
63:   }
64:   const basePins=pins(base);const pointer=path.join(base,'current.json');
65:   if(!present(pointer))fail('UNCOMMITTED');
66:   const bytes=read(pointer,4096),manifest=manifestValue(bytes,names);
67:   const generation=path.join(base,manifest.generation),generationPins=pins(generation);
68:   const values=manifest.members.map(member=>{
69:     const content=read(path.join(generation,member.name));
70:     if(content.length!==member.bytes||digest(content)!==member.digest)fail('MEMBER_INVALID');
71:     if(verifyCopies&&!content.equals(read(path.join(root,member.name))))fail('MATERIALIZATION_DIVERGED');
72:     try{return JSON.parse(content.toString());}catch{fail('MEMBER_INVALID');}
73:   });
74:   if(!read(pointer,4096).equals(bytes))fail('CHANGED');
75:   verifyPins(rootPins);verifyPins(basePins);verifyPins(generationPins);
76:   return values as [unknown,unknown];
77: }
78: function targetValid(file:string):void {
79:   if(!present(file))return;
80:   const stat=fs.lstatSync(file);if(!stat.isFile()||stat.isSymbolicLink()||stat.nlink!==1)fail('TARGET_INVALID');
81: }
82: async function syncDirectory(directory:string):Promise<void> {const handle=await fsp.open(directory,'r');try{await handle.sync();}finally{await handle.close();}}
