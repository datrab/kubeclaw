1: import fs from 'node:fs';
2: import process from 'node:process';
3: import type { ChildProcess } from 'node:child_process';
4: 
5: /** A disappearing /proc entry is expected; permission/I/O failures are not a sample. */
6: function processFile(pid: number, name: 'stat' | 'status'): string | null {
7:   try { return fs.readFileSync(`/proc/${pid}/${name}`, 'utf8'); }
8:   catch (cause) {
9:     const code = (cause as NodeJS.ErrnoException).code;
10:     if (code === 'ENOENT' || code === 'ESRCH') return null;
11:     throw new Error('TEST_PROVIDER_PROCESS_OBSERVATION_FAILED', { cause });
12:   }
13: }
14: 
15: function processParents(): Map<number, number> {
16:   const parents = new Map<number, number>();
17:   for (const name of fs.readdirSync('/proc')) {
18:     if (!/^\d+$/u.test(name)) continue;
19:     const status = processFile(Number(name), 'status');
20:     if (status === null) continue;
21:     parents.set(Number(name), Number(/^PPid:\s+(\d+)$/mu.exec(status)?.[1] ?? -1));
22:   }
23:   return parents;
24: }
25: 
26: function descendantsOf(pid: number, parents: ReadonlyMap<number, number>): Set<number> {
27:   const descendants = new Set([pid]);
28:   let changed = true;
29:   while (changed) {
30:     changed = false;
31:     for (const [candidate, parent] of parents) {
32:       if (!descendants.has(parent) || descendants.has(candidate)) continue;
33:       descendants.add(candidate);
34:       changed = true;
35:     }
36:   }
37:   return descendants;
38: }
39: 
40: export function processFacts(pid: number): { cpuTimeMs: number; memoryBytes: number; processes: number } {
41:   const descendants = descendantsOf(pid, processParents());
42:   let cpuTimeMs = 0; let memoryBytes = 0;
43:   for (const processId of descendants) {
44:     const stat = processFile(processId, 'stat');
45:     if (stat === null) continue;
46:     const fields = stat.slice(stat.lastIndexOf(')') + 2).trim().split(/\s+/u);
47:     cpuTimeMs += ((Number(fields[11]) + Number(fields[12])) / 100) * 1000;
48:     const status = processFile(processId, 'status');
49:     if (status !== null) memoryBytes += Number(/^VmRSS:\s+(\d+)\s+kB$/mu.exec(status)?.[1] ?? 0) * 1024;
50:   }
51:   return { cpuTimeMs, memoryBytes, processes: descendants.size };
52: }
53: 
54: export function signalProvider(child: ChildProcess, signal: NodeJS.Signals): void {
55:   try {
56:     if (process.platform !== 'win32' && child.pid) process.kill(-child.pid, signal);
57:     else child.kill(signal);
58:   } catch (cause) {
59:     if ((cause as NodeJS.ErrnoException).code === 'ESRCH') return;
60:     throw new Error('TEST_PROVIDER_PROCESS_SIGNAL_FAILED', { cause });
61:   }
62: }
