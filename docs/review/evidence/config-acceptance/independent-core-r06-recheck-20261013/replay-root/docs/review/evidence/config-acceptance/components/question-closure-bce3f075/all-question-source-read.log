121: function assertJson(value: unknown, seen: Set<object>, depth: number): void {
122:   if (depth > MAX_JSON_DEPTH) throw new Error('TRANSPORT_PAYLOAD_DEPTH_EXCEEDED');
123:   if (value === null || ['string', 'boolean'].includes(typeof value)) return;
124:   if (typeof value === 'number') {
125:     if (!Number.isFinite(value)) throw new Error('TRANSPORT_PAYLOAD_INVALID');
126:     return;
127:   }
128:   if (typeof value !== 'object') throw new Error('TRANSPORT_PAYLOAD_INVALID');
129:   assertJsonObject(value, seen, depth);
