190:     const job = current.payload.job;
191:     if (result.jobId !== jobId || result.planId !== job.plan.planId
192:       || result.planDigest !== job.plan.planDigest || result.runId !== job.plan.runId) throw new Error('BUSTER_REMOTE_RESULT_IDENTITY_MISMATCH');
