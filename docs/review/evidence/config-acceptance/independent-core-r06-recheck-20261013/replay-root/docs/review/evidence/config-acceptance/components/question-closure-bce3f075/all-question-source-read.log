69: /** Bounded preview before any source directory allocation. */
70: export function preparedSourceMetadata(job: RemotePlanJobV1, admissionId: string,
71:   attemptSpecDigest: string, settings: BusterPreparationSettings): PreparedSource {
72:   const header = preparedPlanHeader(job);
73:   if (Buffer.byteLength(JSON.stringify(header)) > settings.maximumHeaderBytes) throw new Error('BUSTER_PREPARATION_HEADER_LIMIT');
74:   const preparationUid = process.getuid?.();
75:   assertPreparationSlot(preparationUid);
76:   if (process.getgid?.() !== preparationUid) throw new Error('BUSTER_PREPARATION_SLOT_INVALID');
77:   const source: PreparedSourceReference = {
78:     schemaVersion: 'buster-prepared-source.v1', admissionId, preparationUid, jobId: header.jobId,
79:     requestDigest: header.requestDigest, headerDigest: preparationDigest(header),
80:     archiveDigest: header.repositoryArchive.contentDigest, archiveBytes: header.repositoryArchive.sizeBytes,
81:     attemptSpecDigest,
82:   };
83:   assertPreparedSource(source, header);
84:   const prepared = { job: header, source };
85:   if (Buffer.byteLength(JSON.stringify(prepared)) + 4 * settings.maximumInputBytes > settings.maximumResultBytes) {
86:     throw new Error('BUSTER_PREPARATION_RESULT_CAPACITY');
87:   }
88:   return prepared;
89: }
