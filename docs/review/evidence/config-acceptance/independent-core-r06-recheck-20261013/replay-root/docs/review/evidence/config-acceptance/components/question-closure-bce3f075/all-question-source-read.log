181:   if (!confidential) {
182:     if (!fence) throw new Error('RESOURCE_FENCE_REQUIRED');
183:     fence.assertCurrent();
184:   }
185:   if (signal.aborted) throw new Error('ADAPTER_CANCELLED');
186: }
