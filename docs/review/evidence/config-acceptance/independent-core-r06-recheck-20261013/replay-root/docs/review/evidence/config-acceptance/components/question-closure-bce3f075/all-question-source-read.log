111: export async function readDurableState<T>(
112:   file: string,
113:   fallback: T,
114:   maximumBytes?: number,
115: ): Promise<T> {
116:   try {
117:     if (maximumBytes === undefined) return JSON.parse(await fs.readFile(file, "utf8")) as T;
118:     return JSON.parse(await readBoundedSnapshot(file, maximumBytes)) as T;
119:   } catch (error) {
120:     if ((error as NodeJS.ErrnoException).code === "ENOENT")
121:       return structuredClone(fallback);
122:     throw error;
123:   }
124: }
125: async function syncDirectory(directory: string): Promise<void> {
126:   const handle = await fs.open(directory, "r");
127:   try {
128:     await handle.sync();
129:   } finally {
130:     await handle.close();
131:   }
132: }
133: export async function ensureDirectoryDurable(directory: string): Promise<void> {
134:   const resolved = path.resolve(directory);
135:   const root = path.parse(resolved).root;
136:   const parts = path.relative(root, resolved).split(path.sep).filter(Boolean);
137:   let current = root;
138:   for (const part of parts) {
139:     current = path.join(current, part);
140:     try {
141:       const stat = await fs.lstat(current);
142:       if (stat.isSymbolicLink())
143:         throw new Error("OBSERVABILITY_STORE_PATH_SYMLINK");
144:       if (!stat.isDirectory())
145:         throw new Error("OBSERVABILITY_STORE_PATH_NOT_DIRECTORY");
146:     } catch (error) {
147:       if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
148:       try {
149:         await fs.mkdir(current);
150:       } catch (mkdirError) {
151:         if ((mkdirError as NodeJS.ErrnoException).code !== "EEXIST")
152:           throw mkdirError;
153:       }
154:       const created = await fs.lstat(current);
155:       if (created.isSymbolicLink())
156:         throw new Error("OBSERVABILITY_STORE_PATH_SYMLINK");
157:       if (!created.isDirectory())
158:         throw new Error("OBSERVABILITY_STORE_PATH_NOT_DIRECTORY");
159:       await syncDirectory(path.dirname(current));
160:     }
161:   }
162: }
163: export async function writeDurableState(
164:   file: string,
165:   value: unknown,
166: ): Promise<void> {
167:   await ensureDirectoryDurable(path.dirname(file));
168:   const temporary = `${file}.${process.pid}.${randomUUID()}.tmp`;
169:   let renamed = false;
170:   try {
171:     const handle = await fs.open(temporary, "wx", 0o600);
172:     try {
173:       await handle.writeFile(canonicalJson(value));
174:       await handle.sync();
175:     } finally {
176:       await handle.close();
177:     }
178:     await fs.rename(temporary, file);
179:     renamed = true;
180:     await syncDirectory(path.dirname(file));
181:   } finally {
182:     if (!renamed) await fs.unlink(temporary).catch(() => undefined);
183:   }
184: }
185: async function acquireKernelLock(
186:   lockFile: string,
187: ): Promise<() => Promise<void>> {
188:   const child = spawn(
189:     "/usr/bin/flock",
190:     [
191:       "--exclusive",
192:       "--timeout",
193:       "5",
194:       lockFile,
195:       "/bin/sh",
196:       "-c",
197:       "printf 'locked\\n'; exec /bin/cat >/dev/null",
198:     ],
199:     { stdio: ["pipe", "pipe", "pipe"] },
200:   );
201:   let error = "";
202:   child.stderr?.on("data", (chunk: Buffer) => {
203:     error += chunk.toString("utf8");
204:   });
205:   const exited = new Promise<number | null>((resolve, reject) => {
206:     child.once("error", reject);
207:     child.once("exit", resolve);
208:   });
209:   await new Promise<void>((resolve, reject) => {
210:     let output = "";
211:     child.stdout?.on("data", (chunk: Buffer) => {
212:       output += chunk.toString("utf8");
213:       if (output.includes("locked\n")) resolve();
214:     });
215:     child.once("error", reject);
216:     child.once("exit", (code) => {
217:       if (!output.includes("locked\n"))
218:         reject(new Error(`OBSERVABILITY_STORE_LOCKED:${code}:${error.trim()}`));
219:     });
220:   });
221:   return async () => {
222:     child.stdin?.end();
223:     const code = await exited;
224:     if (code !== 0)
225:       throw new Error(
226:         `OBSERVABILITY_STORE_UNLOCK_FAILED:${code}:${error.trim()}`,
227:       );
228:   };
229: }
230: async function cleanupCrashArtifacts(
231:   directory: string,
232:   file: string,
233: ): Promise<void> {
234:   const basename = path.basename(file);
235:   for (const entry of await fs.readdir(directory, { withFileTypes: true })) {
236:     if (
237:       entry.isFile() &&
238:       entry.name.startsWith(`${basename}.`) &&
239:       entry.name.endsWith(".tmp")
240:     )
241:       await fs.unlink(path.join(directory, entry.name)).catch(() => undefined);
242:   }
243: }
244: export async function withDurableStoreLock<T>(
245:   file: string,
246:   operation: () => Promise<T>,
247: ): Promise<T> {
248:   const directory = path.dirname(file);
249:   await ensureDirectoryDurable(directory);
250:   const lockFile = path.join(directory, ".write-lock");
251:   const handle = await fs.open(lockFile, "a+", 0o600);
252:   try {
253:     const stat = await handle.stat();
254:     if (!stat.isFile() || stat.nlink !== 1)
255:       throw new Error("OBSERVABILITY_STORE_LOCK_FILE_INVALID");
256:   } finally {
257:     await handle.close();
258:   }
259:   let release: () => Promise<void>;
260:   try {
261:     release = await acquireKernelLock(lockFile);
262:   } catch (error) {
263:     throw new Error(
264:       `OBSERVABILITY_STORE_LOCK_FAILED:${file}:${error instanceof Error ? error.message : String(error)}`,
265:     );
266:   }
267:   try {
268:     await cleanupCrashArtifacts(directory, file);
269:     return await operation();
270:   } finally {
271:     await release();
272:   }
273: }
274: function keyOf(record: ProducerRecordV1): string {
275:   return [
276:     record.producer.producerId,
277:     record.producer.bootId,
278:     record.producer.producerType,
279:     record.correlation.pipelineRunId,
280:     String(record.sequence),
281:   ].join("|");
282: }
283: function validLimit(value: number): boolean {
284:   return Number.isSafeInteger(value) && value > 0;
285: }
286: function validIdentityPart(value: unknown): value is string {
287:   return (
288:     typeof value === "string" &&
289:     value.length >= 1 &&
290:     value.length <= 256 &&
291:     /^[A-Za-z0-9][A-Za-z0-9._:-]*$/.test(value)
292:   );
293: }
294: function quarantineAttribution(
295:   raw: Uint8Array | string,
296: ): AdmissionState["unresolvedItems"][number] | null {
297:   try {
298:     const bytes = Buffer.from(raw);
299:     const decoded = JSON.parse(bytes.toString("utf8")) as {
300:       producer?: Record<string, unknown>;
301:       correlation?: { pipelineRunId?: string };
302:       recordId?: string;
303:     };
304:     if (
305:       !decoded.producer ||
306:       !validIdentityPart(decoded.producer.producerId) ||
307:       !validIdentityPart(decoded.producer.bootId) ||
308:       !validIdentityPart(decoded.producer.producerType) ||
309:       !validIdentityPart(decoded.correlation?.pipelineRunId)
310:     )
311:       return null;
312:     const producer = {
313:       producerId: decoded.producer.producerId,
314:       bootId: decoded.producer.bootId,
315:       producerType: decoded.producer.producerType,
316:     };
317:     const rawDigest = createHash("sha256").update(bytes).digest("hex");
318:     return {
319:       itemId: `quarantine:${rawDigest}`,
320:       kind: "quarantined-record",
321:       producer,
322:       subjectId: validIdentityPart(decoded.recordId)
323:         ? decoded.recordId
324:         : `record:${rawDigest}`,
325:       reasonCode: "record-quarantined",
326:       pipelineRunId: decoded.correlation.pipelineRunId,
327:     };
328:   } catch {
329:     return null;
330:   }
331: }
332: 
333: export class FileProducerOutbox {
334:   readonly #file: string;
335:   readonly #limits: ProducerOutboxLimits;
336:   #queue: Promise<unknown> = Promise.resolve();
337:   constructor(directory: string, limits: ProducerOutboxLimits) {
338:     if (!validLimit(limits.maximumRecords) || !validLimit(limits.maximumBytes))
339:       throw new Error("OBSERVABILITY_OUTBOX_LIMIT_INVALID");
340:     this.#file = path.join(directory, "outbox.json");
341:     this.#limits = limits;
342:   }
343:   #serial<T>(operation: () => Promise<T>): Promise<T> {
344:     const locked = () => withDurableStoreLock(this.#file, operation);
345:     const result = this.#queue.then(locked, locked);
346:     this.#queue = result.then(
347:       () => undefined,
348:       () => undefined,
349:     );
350:     return result;
351:   }
352:   async append(
353:     unsigned: Omit<ProducerRecordV1, "recordDigest"> | ProducerRecordV1,
354:   ): Promise<ProducerRecordV1> {
355:     const input = structuredClone(unsigned);
356:     const candidateRecord = {
357:       ...input,
358:       recordDigest: producerRecordDigest(input as ProducerRecordV1),
359:     } as ProducerRecordV1;
360:     const bytes = canonicalJson(candidateRecord);
361:     const record = decodePipelineObservabilityContract(
362:       "producerRecord",
363:       bytes,
364:     ) as ProducerRecordV1;
365:     return this.#serial(async () => {
366:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
367:       const key = keyOf(record);
368:       const existing = state.entries.find(
369:         (entry) => keyOf(entry.record) === key,
370:       );
371:       if (existing) {
372:         if (existing.record.recordDigest !== record.recordDigest)
373:           throw new Error("OBSERVABILITY_OUTBOX_IDENTITY_CONFLICT");
374:         return structuredClone(existing.record);
375:       }
376:       const candidate = {
377:         ...state,
378:         entries: [
379:           ...state.entries,
380:           { record, bytes, acknowledged: false, canonicalCursor: null },
381:         ],
382:       };
383:       if (
384:         state.entries.length >= this.#limits.maximumRecords ||
385:         Buffer.byteLength(canonicalJson(candidate)) > this.#limits.maximumBytes
386:       )
387:         throw new Error("OBSERVABILITY_OUTBOX_FULL");
388:       await writeDurableState(this.#file, candidate);
389:       return structuredClone(record);
390:     });
391:   }
392:   async pending(): Promise<ReadonlyArray<OutboxEntry>> {
393:     return this.#serial(async () => {
394:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
395:       return state.entries
396:         .filter((entry) => !entry.acknowledged)
397:         .sort((left, right) => left.record.sequence - right.record.sequence);
398:     });
399:   }
400:   async acknowledge(ack: AdmissionAcknowledgementV1): Promise<void> {
401:     validatePipelineObservabilityContract("admissionAcknowledgement", ack);
402:     const snapshot = JSON.parse(
403:       canonicalJson(ack),
404:     ) as AdmissionAcknowledgementV1;
405:     await this.#serial(async () => {
406:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
407:       const entry = state.entries.find(
408:         (candidate) =>
409:           candidate.record.recordId === snapshot.recordId &&
410:           keyOf(candidate.record) ===
411:             [
412:               snapshot.producer.producerId,
413:               snapshot.producer.bootId,
414:               snapshot.producer.producerType,
415:               snapshot.pipelineRunId,
416:               String(snapshot.sequence),
417:             ].join("|"),
418:       );
419:       if (
420:         !entry ||
421:         entry.record.recordDigest !== snapshot.recordDigest ||
422:         entry.record.producer.producerType !== snapshot.producer.producerType
423:       )
424:         throw new Error("OBSERVABILITY_ACK_MISMATCH");
425:       entry.acknowledged = true;
426:       entry.canonicalCursor = snapshot.canonicalCursor;
427:       await writeDurableState(this.#file, state);
428:     });
429:   }
430:   async compact(): Promise<number> {
431:     return this.#serial(async () => {
432:       const state = await readDurableState(this.#file, EMPTY_OUTBOX);
433:       const before = state.entries.length;
434:       state.entries = state.entries.filter((entry) => !entry.acknowledged);
435:       await writeDurableState(this.#file, state);
436:       return before - state.entries.length;
437:     });
438:   }
439: }
440: 
441: export class FileObservabilityAdmissionStore {
442:   readonly #file: string;
443:   readonly #limits: AdmissionStoreLimits;
444:   #queue: Promise<unknown> = Promise.resolve();
445:   constructor(directory: string, limits: AdmissionStoreLimits) {
446:     if (
447:       Object.values(limits).some((value) => !validLimit(value)) ||
448:       limits.maximumBytes <= ADMISSION_METADATA_RESERVE
449:     )
450:       throw new Error("OBSERVABILITY_ADMISSION_LIMIT_INVALID");
451:     this.#file = path.join(directory, "admission.json");
452:     this.#limits = limits;
453:   }
454:   storageDirectory(): string {
455:     return path.dirname(this.#file);
456:   }
457:   #serial<T>(operation: () => Promise<T>): Promise<T> {
458:     const locked = () => withDurableStoreLock(this.#file, operation);
459:     const result = this.#queue.then(locked, locked);
460:     this.#queue = result.then(
461:       () => undefined,
462:       () => undefined,
463:     );
464:     return result;
465:   }
466:   #reason(reason: string): string {
467:     return reason.length <= 256
468:       ? reason
469:       : `${reason.slice(0, 180)}:sha256:${createHash("sha256").update(reason).digest("hex")}`;
470:   }
471:   async #recordOverflow(
472:     state: AdmissionState,
473:     raw: Uint8Array | string,
474:     reason: string,
475:     attributeToRun = true,
476:   ): Promise<void> {
477:     const attributed = attributeToRun ? quarantineAttribution(raw) : null;
478:     if (attributed) {
479:       const overflowItem = {
480:         ...attributed,
481:         itemId: `quarantine-overflow:${attributed.pipelineRunId}`,
482:         subjectId: `quarantine-overflow:${attributed.pipelineRunId}`,
483:         reasonCode: "quarantine-overflow",
484:       };
485:       const alreadyTracked = state.overflowUnresolvedItems.some(
486:         (item) => item.itemId === overflowItem.itemId,
487:       );
488:       if (
489:         !alreadyTracked &&
490:         state.overflowUnresolvedItems.length >=
491:           this.#limits.maximumQuarantineRecords
492:       )
493:         throw new Error("OBSERVABILITY_ADMISSION_FULL");
494:       if (!alreadyTracked) state.overflowUnresolvedItems.push(overflowItem);
495:     }
496:     state.quarantineOverflow = {
497:       count: (state.quarantineOverflow?.count ?? 0) + 1,
498:       lastReceivedAt: new Date().toISOString(),
499:       lastReason: this.#reason(reason),
500:       lastRawDigest: `sha256:${createHash("sha256").update(raw).digest("hex")}`,
501:       lastRawBytes:
502:         typeof raw === "string" ? Buffer.byteLength(raw) : raw.byteLength,
503:     };
504:     if (Buffer.byteLength(canonicalJson(state)) > this.#limits.maximumBytes)
505:       throw new Error("OBSERVABILITY_ADMISSION_FULL");
506:     await writeDurableState(this.#file, state);
507:   }
508:   async #quarantine(
509:     state: AdmissionState,
510:     raw: Uint8Array,
511:     reason: string,
512:   ): Promise<void> {
513:     const boundedReason = this.#reason(reason);
514:     if (state.quarantine.length >= this.#limits.maximumQuarantineRecords) {
515:       await this.#recordOverflow(state, raw, boundedReason);
516:       return;
517:     }
518:     const encoded = Buffer.from(raw).toString("base64");
519:     const attributed = quarantineAttribution(raw);
520:     const candidate = {
521:       ...state,
522:       quarantine: [
523:         ...state.quarantine,
524:         {
525:           quarantineId: `quarantine:${randomUUID()}`,
526:           receivedAt: new Date().toISOString(),
527:           reason: boundedReason,
528:           rawBase64: encoded,
529:         },
530:       ],
531:       unresolvedItems:
532:         attributed &&
533:         !state.unresolvedItems.some((item) => item.itemId === attributed.itemId)
534:           ? [...state.unresolvedItems, attributed]
535:           : state.unresolvedItems,
536:     };
537:     if (
538:       Buffer.byteLength(canonicalJson(candidate.quarantine)) >
539:         this.#limits.maximumQuarantineBytes ||
540:       Buffer.byteLength(canonicalJson(candidate)) >
541:         this.#limits.maximumBytes - ADMISSION_METADATA_RESERVE
542:     ) {
543:       await this.#recordOverflow(state, raw, boundedReason);
544:       return;
545:     }
546:     await writeDurableState(this.#file, candidate);
547:   }
548:   async #rejectOversizedIngress(raw: Uint8Array | string): Promise<void> {
549:     const inputBytes =
550:       typeof raw === "string" ? Buffer.byteLength(raw) : raw.byteLength;
551:     if (inputBytes <= this.#limits.maximumIngressBytes) return;
552:     await this.#serial(async () => {
553:       const state = await readAdmissionState(this.#file, this.#limits);
554:       await this.#recordOverflow(
555:         state,
556:         raw,
557:         "OBSERVABILITY_INGRESS_TOO_LARGE",
558:         false,
559:       );
560:     });
561:     throw new Error("OBSERVABILITY_INGRESS_TOO_LARGE");
562:   }
563:   async #retiredAcknowledgement(state:AdmissionState,key:string,recordDigest:string,bytes:Buffer):Promise<AdmissionAcknowledgementV1|null> {
564:     const retired=state.retiredEntries?.find(entry=>entry.key===key);
565:     if(!retired)return null;
566:     if(retired.acknowledgement.recordDigest!==recordDigest) {
567:       await this.#quarantine(state,bytes,"OBSERVABILITY_ADMISSION_IDENTITY_CONFLICT");
568:       throw new Error("OBSERVABILITY_ADMISSION_IDENTITY_CONFLICT");
569:     }
570:     await resolveAdmissionRetiredEntry(retired);
571:     return structuredClone(retired.acknowledgement);
572:   }
573:   async #admitUnlocked(
574:     state: AdmissionState,
575:     bytes: Buffer,
576:   ): Promise<{
577:     acknowledgement: AdmissionAcknowledgementV1;
578:     state: AdmissionState;
579:   }> {
580:     let record: ProducerRecordV1;
581:     try {
582:       record = decodePipelineObservabilityContract(
583:         "producerRecord",
584:         bytes,
585:       ) as ProducerRecordV1;
586:     } catch (error) {
587:       await this.#quarantine(
588:         state,
589:         bytes,
590:         error instanceof Error ? error.message : "OBSERVABILITY_WIRE_INVALID",
591:       );
592:       throw error;
593:     }
594:     const key = keyOf(record);
595:     const retired = await this.#retiredAcknowledgement(state,key,record.recordDigest,bytes);
596:     if(retired)return {acknowledgement:retired,state};
597:     const existing = state.entries.find((entry) => entry.key === key);
598:     if (existing) {
599:       if (existing.record.recordDigest !== record.recordDigest) {
600:         await this.#quarantine(
601:           state,
602:           bytes,
603:           "OBSERVABILITY_ADMISSION_IDENTITY_CONFLICT",
604:         );
605:         throw new Error("OBSERVABILITY_ADMISSION_IDENTITY_CONFLICT");
606:       }
607:       return {
608:         acknowledgement: this.#ack(existing, "duplicate"),
609:         state,
610:       };
611:     }
612:     if (state.entries.length >= this.#limits.maximumRecords)
613:       throw new Error("OBSERVABILITY_ADMISSION_FULL");
614:     if (!Number.isSafeInteger(state.nextCursor) || state.nextCursor < 1)
615:       throw new Error("OBSERVABILITY_CURSOR_EXHAUSTED");
616:     const entry: AdmissionEntry = {
617:       key,
618:       record,
619:       bytes: bytes.toString("utf8"),
620:       canonicalCursor: state.nextCursor,
621:       admittedAt: new Date().toISOString(),
622:     };
623:     const candidate = {
624:       ...state,
625:       nextCursor: state.nextCursor + 1,
626:       entries: [...state.entries, entry],
627:     };
628:     if (
629:       Buffer.byteLength(canonicalJson(candidate)) >
630:       this.#limits.maximumBytes - ADMISSION_METADATA_RESERVE
631:     )
632:       throw new Error("OBSERVABILITY_ADMISSION_FULL");
633:     await writeDurableState(this.#file, candidate);
634:     return {
635:       acknowledgement: this.#ack(entry, "admitted"),
636:       state: candidate,
637:     };
638:   }
639:   async #recordViews(state: AdmissionState): Promise<ReadonlyArray<AdmittedRecordView>> {
640:     const retired = await resolveAdmissionRetiredEntries(state.retiredEntries ?? []);
641:     return [...state.entries.map((entry) => ({
642:       record: structuredClone(entry.record), canonicalCursor: entry.canonicalCursor, admittedAt: entry.admittedAt,
643:     })),...retired].sort((left,right)=>left.canonicalCursor-right.canonicalCursor);
644:   }
645:   /** Caller holds the original attempt-store fence before acquiring this fence. */
