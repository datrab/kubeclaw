63: async function writeExclusive(file: string, bytes: Uint8Array): Promise<void> {
64:   const handle = await fs.open(file, 'wx', 0o600);
65:   try { await handle.writeFile(bytes); await handle.chmod(0o640); await handle.sync(); }
66:   finally { await handle.close(); }
67: }
