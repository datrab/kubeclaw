238: export function verifyNativeSubagentToolPairs(events) {
239:   const starts = events.filter((event) => event?.type === 'agent.tool.started');
240:   const finishes = events.filter((event) => event?.type === 'agent.tool.finished');
241:   const errors = [];
242:   const startsById = new Map();
243:   const finishesById = new Map();
244:   const causalIdentity = (event) => ({
245:     sessionId: event.session_id ?? event.session_key ?? null,
246:     modelCallId: event.model_call_id ?? null,
247:     workId: event.work_id ?? event.module_id ?? event.gate_id ?? null,
248:     attempt: event.attempt ?? null,
249:     dispatchId: event.dispatch_id ?? null,
250:   });
251:   for (const event of starts) {
252:     if (!event.tool_call_id) {
253:       errors.push({ reason: 'TOOL_CALL_ID_MISSING', type: event.type });
254:       continue;
255:     }
256:     if (startsById.has(event.tool_call_id)) errors.push({ reason: 'DUPLICATE_TOOL_START', toolCallId: event.tool_call_id });
257:     startsById.set(event.tool_call_id, event);
258:   }
259:   for (const event of finishes) {
260:     if (!event.tool_call_id) {
261:       errors.push({ reason: 'TOOL_CALL_ID_MISSING', type: event.type });
262:       continue;
263:     }
264:     const existing = finishesById.get(event.tool_call_id) ?? [];
265:     existing.push(event);
266:     finishesById.set(event.tool_call_id, existing);
267:   }
268:   for (const [toolCallId, start] of startsById) {
269:     const matches = finishesById.get(toolCallId) ?? [];
270:     if (matches.length !== 1) {
271:       errors.push({ reason: matches.length === 0 ? 'ORPHAN_TOOL_START' : 'DUPLICATE_TOOL_FINISH', toolCallId });
272:       continue;
273:     }
274:     const startIdentity = causalIdentity(start);
275:     const finishIdentity = causalIdentity(matches[0]);
276:     for (const field of Object.keys(startIdentity)) {
277:       if (startIdentity[field] === null || startIdentity[field] !== finishIdentity[field]) {
278:         errors.push({ reason: 'TOOL_PAIR_IDENTITY_MISMATCH', toolCallId, field });
279:       }
280:     }
281:   }
282:   for (const toolCallId of finishesById.keys()) {
283:     if (!startsById.has(toolCallId)) errors.push({ reason: 'ORPHAN_TOOL_FINISH', toolCallId });
284:   }
285:   return { ok: errors.length === 0, starts: starts.length, finishes: finishes.length, errors };
286: }
287: 
288: function canonicalResult(workspace, mode) {
289:   const resultPath = path.join(workspace.swarmDir, 'real-production-result.json');
290:   if (!pathExists(resultPath)) {
291:     const failure = evidenceFail('v2_canonical_result', 'REAL_E2E_V2_RESULT_MISSING', { path: resultPath });
292:     return { error: { ok: false, mode, checks: [failure], failures: [failure] } };
293:   }
294:   return { result: readJson(resultPath) };
295: }
296: 
297: export async function verifyRealRunEvidence(workspace, { mode = 'full' } = {}) {
298:   const loaded = canonicalResult(workspace, mode);
299:   if (loaded.error) return loaded.error;
300:   const { result } = loaded;
301:   const runRoot = runRootFor(result);
302:   const events = readJsonLines(path.join(runRoot, 'events.jsonl'));
303:   const effects = readJsonLines(path.join(runRoot, 'effects.jsonl'));
304:   const storedArtifacts = await readRunArtifacts(result.artifactRoot, result.runId, [
305:     'kubeclaw.architecture-validator', 'kubeclaw.implementation-agent', 'kubeclaw.buster-quality-gate', 'kubeclaw.project-summary', 'kubeclaw.review', 'kubeclaw.lint',
306:   ]);
307:   const catalog = storedArtifacts.map(({ artifact }) => artifact);
308:   const progress = readJson(path.join(workspace.swarmDir, 'progress.json'));
309:   const { requests, receipts } = effectRequestsAndReceipts(effects);
310:   const stageFailures = EXPECTED_STAGES.filter((stageId) => result.stages?.[stageId] !== 'succeeded');
311:   const planEffects = [...requests.values()].filter((request) => request.capability === 'test.plan.execute');
312:   const runtimeEffects = [...requests.values()].filter((request) => request.capability === 'runtime.dispatch');
313:   const deliveries = readJsonLines(path.join(runRoot, 'observer-deliveries.jsonl'))
314:     .filter((record) => record?.entry?.observerId === 'kubeclaw.notification-observer:notifications');
315:   const discordReceipts = [...receipts].flatMap(([key, receipt]) => {
316:     const request = requests.get(key);
317:     return request?.capability === 'operator.request'
318:       && receipt?.status === 'completed'
319:       && receipt?.result?.accepted === true
320:       && typeof receipt?.result?.messageId === 'string'
321:       ? [receipt.result.messageId]
322:       : [];
323:   });
324:   const stageRoles = Object.fromEntries(events
325:     .filter((record) => record?.entry?.type === 'stage.started')
326:     .map((record) => [record.entry.identity?.stageId, record.entry.payload?.agentRole ?? null]));
327:   const roleMismatches = Object.entries(EXPECTED_ROLES)
328:     .filter(([stageId, role]) => stageRoles[stageId] !== role)
329:     .map(([stageId, role]) => ({ stageId, expected: role, actual: stageRoles[stageId] ?? null }));
330:   const artifacts = (namespace) => storedArtifacts.filter(({ artifact }) => artifact.namespace === namespace);
331:   const implementationArtifacts = latestStageArtifacts(artifacts('kubeclaw.implementation-agent'));
332:   const gateArtifacts = latestStageArtifacts(artifacts('kubeclaw.buster-quality-gate'));
333:   const testArtifacts = gateArtifacts.filter(({ artifact }) => artifact.producer.stageId.startsWith('buster-') && !artifact.artifactId.includes(':decision:'));
334:   const qualityArtifacts = gateArtifacts.filter(({ artifact }) => artifact.producer.stageId === 'final-buster' && !artifact.artifactId.includes(':decision:'));
335:   const decisionFor = (artifact) => {
336:     const matches = gateArtifacts.filter(item => item.artifact.producer.stageId === artifact.producer.stageId
337:       && item.artifact.producer.attemptNumber === artifact.producer.attemptNumber && item.artifact.artifactId.includes(':decision:'));
338:     if (matches.length !== 1) throw new Error('REAL_E2E_NATIVE_DECISION_MISSING_OR_AMBIGUOUS');
339:     const decision = parseGateDecision(matches[0].value);
340:     if (decision.runId !== result.runId) throw new Error('REAL_E2E_NATIVE_DECISION_RUN_MISMATCH');
341:     return decision;
342:   };
343:   const implementationFailures = implementationArtifacts.flatMap(({ artifact, value }) => {
344:     const changedPaths = Array.isArray(value?.changedPaths) ? value.changedPaths : [];
345:     const checksPassed = Array.isArray(value?.checks)
346:       && value.checks.length > 0
347:       && value.checks.every((check) => check?.passed === true);
348:     const mutationsExist = changedPaths.length > 0 && changedPaths.every((changedPath) => {
349:       const file = path.join(workspace.worktreePath, changedPath);
350:       return pathExists(file) && fs.readFileSync(file, 'utf8').includes(String(result.runId));
351:     });
352:     return value?.status === 'ready_for_testing'
353:       && value?.session?.termination === 'completed'
354:       && typeof value?.session?.sessionId === 'string'
355:       && /^[a-f0-9]{64}$/.test(String(value?.session?.transcriptDigest || ''))
356:       && checksPassed
357:       && mutationsExist
358:       ? []
359:       : [{ artifactId: artifact.artifactId, changedPaths, checksPassed, mutationsExist }];
360:   });
361:   const moduleBusterFailures = testArtifacts.flatMap(({ artifact, value }) => {
362:     try {
363:       const decision = decisionFor(artifact);
364:       return decision.state === 'passed' && value?.verdict?.outcome === 'passed'
365:         && value.decisionDigest === decision.decisionDigest ? [] : [{ artifactId: artifact.artifactId }];
366:     } catch (error) { return [{ artifactId: artifact.artifactId, error: String(error) }]; }
367:   });
368:   const requiredFinalSuites = ['security-headers', 'dependency-security', 'image-security',
369:     'kubernetes-policy-security', 'kubernetes-runtime-security'];
370:   const finalBusterFailures = qualityArtifacts.flatMap(({ artifact, value }) => {
371:     try {
372:       const decision = decisionFor(artifact);
373:       const nodeIds = new Set(decision.nodes.filter(node => ['passed', 'advisory_failure'].includes(node.effect)).map(node => node.nodeId));
374:       const missing = requiredFinalSuites.filter(suite => !nodeIds.has(suite));
375:       return decision.state === 'passed' && missing.length === 0 && value?.verdict?.outcome === 'passed'
376:         && value.decisionDigest === decision.decisionDigest ? [] : [{ artifactId: artifact.artifactId, missing }];
377:     } catch (error) { return [{ artifactId: artifact.artifactId, error: String(error) }]; }
378:   });
379:   const forgeCommitCount = String(result.gitLog || '').split('\n')
380:     .filter((line) => /\[forge:(?:01|02|03|04)-nginx\]/.test(line)).length;
381:   const branchPattern = `e2e-${String(result.runId).toLowerCase().replace(/[^a-z0-9-]+/gu, '-').replace(/^-+|-+$/gu, '').slice(0, 80)}-*`;
382:   const residualBranches = execFileSync('git', ['branch', '--list', branchPattern], {
383:     cwd: workspace.worktreePath,
384:     encoding: 'utf8',
385:   }).trim();
386:   const requiredArtifacts = [
387:     ['kubeclaw.architecture-validator', 1],
388:     ['kubeclaw.implementation-agent', 4],
389:     ['kubeclaw.buster-quality-gate', 10],
390:     ['kubeclaw.project-summary', 1],
391:   ];
392:   const checks = [
393:     result.schemaVersion === RESULT_SCHEMA
394:       ? evidencePass('v2_result_contract')
395:       : evidenceFail('v2_result_contract', 'REAL_E2E_V2_RESULT_CONTRACT_INVALID', { actual: result.schemaVersion ?? null }),
396:     result.status === 'succeeded'
397:       ? evidencePass('v2_pipeline_terminal_success', { runId: result.runId })
398:       : evidenceFail('v2_pipeline_terminal_success', 'REAL_E2E_V2_PIPELINE_NOT_SUCCEEDED', { status: result.status }),
399:     result.model === SPARK_MODEL
400:       ? evidencePass('v2_exact_spark_model', { model: result.model })
401:       : evidenceFail('v2_exact_spark_model', 'REAL_E2E_V2_MODEL_MISMATCH', { model: result.model }),
402:     stageFailures.length === 0
403:       ? evidencePass('v2_full_stage_topology', { stages: EXPECTED_STAGES })
404:       : evidenceFail('v2_full_stage_topology', 'REAL_E2E_V2_STAGE_FAILURES', { stages: stageFailures }),
405:     events.some((record) => record?.entry?.type === 'run.succeeded')
406:       ? evidencePass('v2_lifecycle_terminal')
407:       : evidenceFail('v2_lifecycle_terminal', 'REAL_E2E_V2_RUN_SUCCEEDED_EVENT_MISSING'),
408:     events.some((record) => record?.entry?.type === 'wait.created')
409:       && events.some((record) => record?.entry?.type === 'wait.resolved')
410:       ? evidencePass('v2_approval_wait_resume')
411:       : evidenceFail('v2_approval_wait_resume', 'REAL_E2E_V2_APPROVAL_EVIDENCE_MISSING'),
412:     planEffects.length >= 5
413:       ? evidencePass('v2_buster_plan_effects', { count: planEffects.length })
414:       : evidenceFail('v2_buster_plan_effects', 'REAL_E2E_V2_BUSTER_PLAN_EFFECTS_MISSING', { count: planEffects.length }),
415:     runtimeEffects.length >= 12
416:       ? evidencePass('v2_agent_effects', { count: runtimeEffects.length })
417:       : evidenceFail('v2_agent_effects', 'REAL_E2E_V2_AGENT_DISPATCH_EFFECTS_MISSING', { count: runtimeEffects.length }),
418:     deliveries.length >= EXPECTED_STAGES.length * 2
419:       ? evidencePass('v2_observer_delivery', { count: deliveries.length })
420:       : evidenceFail('v2_observer_delivery', 'REAL_E2E_V2_NOTIFICATION_DELIVERY_MISSING', { count: deliveries.length }),
421:     discordReceipts.length >= EXPECTED_STAGES.length * 2
422:       ? evidencePass('v2_discord_receipts', { messageIds: discordReceipts })
423:       : evidenceFail('v2_discord_receipts', 'REAL_E2E_V2_DISCORD_RECEIPTS_MISSING', { count: discordReceipts.length }),
424:     roleMismatches.length === 0
425:       ? evidencePass('v2_agent_roles', { roles: EXPECTED_ROLES })
426:       : evidenceFail('v2_agent_roles', 'REAL_E2E_V2_AGENT_ROLE_MISMATCH', { mismatches: roleMismatches }),
427:     implementationArtifacts.length === 4 && implementationFailures.length === 0
428:       ? evidencePass('v2_forge_evidence', { count: implementationArtifacts.length })
429:       : evidenceFail('v2_forge_evidence', 'REAL_E2E_V2_FORGE_EVIDENCE_INVALID', { failures: implementationFailures }),
430:     forgeCommitCount === 4 && residualBranches === ''
431:       ? evidencePass('v2_git_cleanup', { forgeCommitCount })
432:       : evidenceFail('v2_git_cleanup', 'REAL_E2E_V2_GIT_EVIDENCE_INVALID', { forgeCommitCount, residualBranches }),
433:     testArtifacts.length === 4 && moduleBusterFailures.length === 0
434:       ? evidencePass('v2_module_buster_evidence', { count: testArtifacts.length })
435:       : evidenceFail('v2_module_buster_evidence', 'REAL_E2E_V2_MODULE_BUSTER_EVIDENCE_INVALID', { failures: moduleBusterFailures }),
436:     qualityArtifacts.length === 1 && finalBusterFailures.length === 0
437:       ? evidencePass('v2_final_buster_evidence', { requiredFinalSuites })
438:       : evidenceFail('v2_final_buster_evidence', 'REAL_E2E_V2_FINAL_BUSTER_EVIDENCE_INVALID', { failures: finalBusterFailures }),
439:     ...requiredArtifacts.map(([namespace, minimum]) => {
440:       const count = catalog.filter((artifact) => artifact.namespace === namespace).length;
441:       return count >= minimum
442:         ? evidencePass(`v2_artifacts:${namespace}`, { count })
443:         : evidenceFail(`v2_artifacts:${namespace}`, 'REAL_E2E_V2_ARTIFACT_EVIDENCE_MISSING', { count, minimum });
444:     }),
445:   ];
446:   const failures = checks.filter((check) => !check.ok);
447:   return { ok: failures.length === 0, mode, checks, failures };
448: }
449: 
450: export async function verifyExpectedFailureEvidence(workspace, scenario) {
451:   const loaded = canonicalResult(workspace, 'failure');
452:   if (loaded.error) return loaded.error;
453:   const { result } = loaded;
454:   const events = readJsonLines(path.join(runRootFor(result), 'events.jsonl'));
455:   const contract = expectedFailureContractForScenario(scenario);
456:   const terminalIndex = events.findLastIndex((record) =>
457:     ['run.failed', 'run.blocked', 'run.cancelled'].includes(record?.entry?.type));
458:   const terminal = terminalIndex < 0 ? null : events[terminalIndex];
459:   const stageTerminal = contract.expectedStageId === null
460:     ? null
461:     : events.findLast((record) =>
462:       contract.allowedStageEventTypes.includes(record?.entry?.type)
463:       && record?.entry?.identity?.stageId === contract.expectedStageId);
464:   const failedAttempt = contract.expectedStageId === null
465:     ? null
466:     : events.findLast((record) =>
467:       ['attempt.completed', 'attempt.timed_out', 'attempt.cancelled'].includes(record?.entry?.type)
468:       && record?.entry?.identity?.stageId === contract.expectedStageId
469:       && record?.entry?.payload?.outcome !== 'passed');
470:   const causalStage = terminalIndex < 0
471:     ? null
472:     : events.slice(0, terminalIndex).findLast((record) =>
473:       ['stage.failed', 'stage.blocked', 'stage.cancelled'].includes(record?.entry?.type));
474:   const downstreamPasses = events
475:     .filter((record) =>
476:       record?.entry?.type === 'attempt.completed'
477:       && record?.entry?.payload?.outcome === 'passed'
478:       && downstreamStages(contract.expectedStageId).includes(record?.entry?.identity?.stageId))
479:     .map((record) => record.entry.identity.stageId);
480:   const diagnosticText = JSON.stringify({
481:     stage: stageTerminal?.entry?.payload ?? null,
482:     attempt: failedAttempt?.entry?.payload ?? null,
483:     run: terminal?.entry?.payload ?? null,
484:   }).toLowerCase();
485:   const matchedDiagnostics = contract.diagnosticTokens
486:     .filter((token) => diagnosticText.includes(token.toLowerCase()));
487:   const checks = [
488:     requireScenarioSetupContract(workspace, scenario),
489:     result.schemaVersion === RESULT_SCHEMA
490:       ? evidencePass('v2_failure_result_contract')
491:       : evidenceFail('v2_failure_result_contract', 'REAL_E2E_V2_RESULT_CONTRACT_INVALID', { actual: result.schemaVersion ?? null }),
492:     result.status !== 'succeeded'
493:       ? evidencePass('v2_expected_non_success', { status: result.status })
494:       : evidenceFail('v2_expected_non_success', 'REAL_E2E_UNEXPECTED_SUCCESS'),
495:     result.scenario?.id === contract.scenarioId
496:       && result.scenario?.expectedEvidence === contract.expectedEvidence
497:       ? evidencePass('v2_exact_failure_scenario')
498:       : evidenceFail('v2_exact_failure_scenario', 'REAL_E2E_V2_FAILURE_SCENARIO_MISMATCH'),
499:     terminal && contract.allowedRunEventTypes.includes(terminal.entry.type)
500:       ? evidencePass('v2_terminal_failure_event', { type: terminal.entry.type })
501:       : evidenceFail('v2_terminal_failure_event', 'REAL_E2E_V2_TERMINAL_FAILURE_EVENT_MISMATCH', {
502:         expected: contract.allowedRunEventTypes,
503:         actual: terminal?.entry?.type ?? null,
504:       }),
505:     contract.expectedStageId === null || stageTerminal
506:       ? evidencePass('v2_exact_failure_stage', { stageId: contract.expectedStageId })
507:       : evidenceFail('v2_exact_failure_stage', 'REAL_E2E_V2_FAILURE_STAGE_MISMATCH', { stageId: contract.expectedStageId }),
508:     contract.expectedStageId === null
509:       || (causalStage?.entry?.identity?.stageId === contract.expectedStageId
510:         && contract.allowedStageEventTypes.includes(causalStage?.entry?.type))
511:       ? evidencePass('v2_terminal_failure_causality')
512:       : evidenceFail('v2_terminal_failure_causality', 'REAL_E2E_V2_TERMINAL_CAUSE_MISMATCH'),
513:     contract.expectedStageId === null || failedAttempt
514:       ? evidencePass('v2_causal_failure_attempt')
515:       : evidenceFail('v2_causal_failure_attempt', 'REAL_E2E_V2_CAUSAL_FAILURE_ATTEMPT_MISSING'),
516:     downstreamPasses.length === 0
517:       ? evidencePass('v2_no_downstream_success')
518:       : evidenceFail('v2_no_downstream_success', 'REAL_E2E_V2_DOWNSTREAM_SUCCESS_AFTER_FAILURE', { stages: downstreamPasses }),
519:     contract.diagnosticTokens.length === 0 || matchedDiagnostics.length > 0
520:       ? evidencePass('v2_failure_diagnostic', { matched: matchedDiagnostics })
521:       : evidenceFail('v2_failure_diagnostic', 'REAL_E2E_V2_FAILURE_DIAGNOSTIC_MISMATCH', {
522:         expectedAny: contract.diagnosticTokens,
523:       }),
524:     result.model === SPARK_MODEL
525:       ? evidencePass('v2_exact_spark_model', { model: result.model })
526:       : evidenceFail('v2_exact_spark_model', 'REAL_E2E_V2_MODEL_MISMATCH', { model: result.model }),
527:   ];
528:   const failures = checks.filter((check) => !check.ok);
529:   return { ok: failures.length === 0, mode: 'failure', checks, failures };
530: }
