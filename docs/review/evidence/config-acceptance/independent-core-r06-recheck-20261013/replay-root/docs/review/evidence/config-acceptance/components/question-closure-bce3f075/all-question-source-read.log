53: export interface AdmissionState {
54:   schemaVersion: "observability-admission-store.v1" | "observability-admission-store.v2";
55:   retiredEntries?: AdmissionRetiredEntry[];
56:   nextCursor: number;
57:   entries: AdmissionEntry[];
58:   quarantine: QuarantineEntry[];
59:   quarantineOverflow: QuarantineOverflow | null;
60:   gaps: ProducerGapReportV1[];
61:   unresolvedItems: Array<
62:     UnresolvedObservabilityItemV1 & { pipelineRunId: string }
63:   >;
64:   overflowUnresolvedItems: Array<
65:     UnresolvedObservabilityItemV1 & { pipelineRunId: string }
66:   >;
67: }
68: export interface ProducerOutboxLimits {
69:   maximumRecords: number;
70:   maximumBytes: number;
