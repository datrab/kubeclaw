41: function isJson(value: unknown, depth = 0): boolean {
42:   if (depth > 64) return false;
43:   if (value === null || typeof value === 'string' || typeof value === 'boolean') return true;
44:   if (typeof value === 'number') return Number.isFinite(value);
45:   if (Array.isArray(value)) return value.every((entry) => isJson(entry, depth + 1));
46:   if (!value || typeof value !== 'object') return false;
47:   return Object.entries(value as Record<string, unknown>)
48:     .every(([key, entry]) => key.length > 0 && isJson(entry, depth + 1));
