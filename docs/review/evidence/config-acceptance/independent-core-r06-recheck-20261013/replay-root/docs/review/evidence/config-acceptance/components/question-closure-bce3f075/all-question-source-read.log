1: #!/usr/bin/env node
2: 
3: import fs from 'node:fs';
4: import {publishJsonPair} from '@kubeclaw/plugin-foundation/config/published-pair';
5: import path from 'node:path';
6: import { fileURLToPath } from 'node:url';
7: import { buildScaffold } from './progress-scaffold-discovery.ts';
8: import { scaffoldToProgress, validateScaffold } from './progress-scaffold-validation.ts';
9: import {
10:   errorMessage,
11:   readJsonIfExists,
12:   relFromRepo,
13:   writeJson,
14: } from './progress-scaffold-values.ts';
15: import type { Args, Context, Diagnostic } from './progress-scaffold-values.ts';
16: 
17: const DEFAULT_SCAFFOLD_FILE = 'progress.scaffold.json';
18: 
19: function usage() {
20:   return `Usage:
21:   node skills/nova/project_setup/tools/progress-scaffold.ts --project <name> [--repo <repo>]
22:   node skills/nova/project_setup/tools/progress-scaffold.ts --project <name> --apply [--repo <repo>]
23:   node skills/nova/project_setup/tools/progress-scaffold.ts --project <name> --check [--repo <repo>]
24: 
25: Options:
26:   --project <name>       Project under Projects/<name>/src/.swarm
27:   --swarm <path>         Use an explicit .swarm directory instead of --project
28:   --repo <path>          Repository root. Defaults to nearest parent with .git
29:   --scaffold <path>      Scaffold file. Defaults to .swarm/progress.scaffold.json
30:   --apply                Validate scaffold and write progress.json plus pipeline.json
31:   --check                Validate scaffold/progress without writing
32:   --print                Print generated progress JSON
33:   --help                 Show this help
34: `;
35: }
36: 
37: function requireValue(argv: string[], index: number, flag: string) {
38:   const value = argv[index];
39:   if (!value || value.startsWith('--')) throw new Error(`${flag} requires a value.`);
40:   return value;
41: }
42: 
43: function parseArgs(argv: string[]): Args {
44:   const args: Args = {
45:     apply: false,
46:     check: false,
47:     print: false,
48:     help: false,
49:     project: null,
50:     repo: null,
51:     swarm: null,
52:     scaffold: null,
53:   };
54:   const valueFlags: Record<string, keyof Pick<Args, 'project' | 'repo' | 'swarm' | 'scaffold'>> = {
55:     '--project': 'project',
56:     '--repo': 'repo',
57:     '--swarm': 'swarm',
58:     '--scaffold': 'scaffold',
59:   };
60:   for (let index = 0; index < argv.length; index += 1) {
61:     const argument = argv[index];
62:     if (argument === '--apply') args.apply = true;
63:     else if (argument === '--check') args.check = true;
64:     else if (argument === '--print') args.print = true;
65:     else if (argument === '--help' || argument === '-h') args.help = true;
66:     else if (argument && valueFlags[argument]) args[valueFlags[argument]] = requireValue(argv, ++index, argument);
67:     else throw new Error(`Unknown argument: ${argument}`);
68:   }
69:   if (args.apply && args.check) throw new Error('Use either --apply or --check, not both.');
70:   if (!args.help && !args.project && !args.swarm) throw new Error('Provide --project <name> or --swarm <path>.');
71:   return args;
72: }
73: 
74: function findRepoRoot(startDir = process.cwd()) {
75:   let current = path.resolve(startDir);
76:   for (;;) {
77:     if (fs.existsSync(path.join(current, '.git'))) return current;
78:     const parent = path.dirname(current);
79:     if (parent === current) throw new Error('Cannot find repository root. Pass --repo <path>.');
80:     current = parent;
81:   }
82: }
83: 
84: function safeProject(value: unknown) {
85:   if (typeof value !== 'string' || !value.trim()) throw new Error('project must be a non-empty string.');
86:   if (!/^[A-Za-z0-9._-]+$/.test(value) || value.includes('..')) throw new Error(`project must be a safe path segment: ${value}`);
87:   return value;
88: }
89: 
90: function inferProject(swarmDir: string) {
91:   const parts = swarmDir.split(path.sep);
92:   const projectsIndex = parts.lastIndexOf('Projects');
93:   return projectsIndex >= 0 ? parts[projectsIndex + 1] : null;
94: }
95: 
96: function resolveContext(args: Args): Context {
97:   const repoRoot = path.resolve(args.repo ?? findRepoRoot());
98:   if (!fs.existsSync(path.join(repoRoot, '.git'))) throw new Error(`Repo root is not a git repository: ${repoRoot}`);
99:   const swarmDir = args.swarm
100:     ? path.resolve(args.swarm)
101:     : path.join(repoRoot, 'Projects', safeProject(args.project), 'src', '.swarm');
102:   const project = args.project ?? inferProject(swarmDir);
103:   if (!project) throw new Error('Cannot infer project name from --swarm; pass --project too.');
104:   return {
105:     repoRoot,
106:     project,
107:     swarmDir,
108:     scaffoldFile: args.scaffold ? path.resolve(args.scaffold) : path.join(swarmDir, DEFAULT_SCAFFOLD_FILE),
109:     progressFile: path.join(swarmDir, 'progress.json'),
110:     pipelineFile: path.join(swarmDir, 'pipeline.json'),
111:   };
112: }
113: 
114: function printDiagnostics(diagnostics: Diagnostic[]) {
115:   if (!diagnostics.length) {
116:     console.log('progress scaffold validation passed');
117:     return;
118:   }
119:   console.log(`progress scaffold diagnostics (${diagnostics.length}):`);
120:   diagnostics.forEach((item) => console.log(`- [${item.kind}] ${item.field}: ${item.message}`));
121: }
122: 
123: function diffSummary(existing: unknown, next: unknown) {
124:   if (!existing) return 'progress.json will be created';
125:   const before = JSON.stringify(existing, null, 2);
126:   const after = JSON.stringify(next, null, 2);
127:   if (before === after) return 'progress.json is already current';
128:   return `progress.json will change (${before.split('\n').length} -> ${after.split('\n').length} JSON lines)`;
129: }
130: 
131: async function applyScaffold(args: Args, context: Context) {
132:   const scaffold = readJsonIfExists(context.scaffoldFile);
133:   if (!scaffold) throw new Error(`Scaffold file not found. Run without --apply first: ${context.scaffoldFile}`);
134:   const { progress, pipeline, diagnostics } = scaffoldToProgress(scaffold, context);
135:   printDiagnostics(diagnostics);
136:   if (args.check) return 0;
137:   if (args.print) {
138:     console.log(JSON.stringify({ progress, pipeline }, null, 2));
139:     return 0;
140:   }
141:   console.log(diffSummary(readJsonIfExists(context.progressFile), progress));
142:   await publishJsonPair(context.swarmDir,['progress.json','pipeline.json'],[progress,pipeline]);
143:   console.log(`wrote ${relFromRepo(context.repoRoot, context.progressFile)}`);
144:   console.log(`wrote ${relFromRepo(context.repoRoot, context.pipelineFile)}`);
145:   return 0;
146: }
147: 
148: export async function run(argv: string[] = process.argv.slice(2)): Promise<number> {
149:   const args = parseArgs(argv);
150:   if (args.help) {
151:     console.log(usage());
152:     return 0;
153:   }
154:   const context = resolveContext(args);
155:   if (!fs.existsSync(context.swarmDir)) throw new Error(`.swarm directory not found: ${context.swarmDir}`);
156:   if (args.apply || args.check || args.print) return applyScaffold(args, context);
157:   const scaffold = buildScaffold(context);
158:   writeJson(context.scaffoldFile, scaffold);
159:   console.log(`wrote ${relFromRepo(context.repoRoot, context.scaffoldFile)}`);
160:   printDiagnostics(validateScaffold(scaffold, context));
161:   console.log('Next: fill the progress and provider-plan gaps, then rerun with --apply.');
162:   return 0;
163: }
164: 
165: const isCli = process.argv[1] && path.resolve(process.argv[1]) === path.resolve(fileURLToPath(import.meta.url));
166: if (isCli) {
167:   try {
168:     process.exitCode = await run();
169:   } catch (error) {
170:     const scaffoldError = error as Error & { diagnostics?: Diagnostic[] };
171:     console.error(errorMessage(error));
172:     if (scaffoldError.diagnostics) printDiagnostics(scaffoldError.diagnostics);
173:     process.exitCode = 1;
174:   }
175: }
176: 
177: export { buildScaffold, scaffoldToProgress, validateScaffold };
