70:   const key = `delivery:attempt-${request.attempt.attemptNumber}-${hash(request.attempt.attemptId).slice(0, 16)}${suffix}`;
71:   const terminal = selected[0] as DurableRecord<Payload> | undefined;
72:   if (selected.length !== 1 || !terminal || terminal.idempotencyKey !== key
