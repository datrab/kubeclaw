239:       }
240:       if (current.record.payloadDigest !== intent.expectedPayloadDigest) throw new Error('BUSTER_COMPACTION_RECORD_CHANGED');
241:       const { job, status } = current.payload;
242:       if (status.state !== 'completed' || !status.result) throw new Error('BUSTER_COMPACTION_JOB_NOT_COMPLETED');
243:       this.#preflight(job);
244:       const result = JSON.parse((await this.result(job.jobId, status.result.contentDigest, status.result.sizeBytes)).toString()) as RemotePlanResultV1;
245:       if (result.cleanupErrors.length || result.attempts.some(attempt => attempt.executionState !== 'completed')) {
246:         throw new Error('BUSTER_COMPACTION_EXECUTION_UNCERTAIN');
247:       }
248:       let evidenceBytes = 0;
249:       for (const artifact of resultArtifacts(result)) {
250:         evidenceBytes += artifact.sizeBytes;
251:         if (!Number.isSafeInteger(evidenceBytes) || evidenceBytes > intent.maximumEvidenceBytes) throw new Error('BUSTER_COMPACTION_EVIDENCE_BUDGET_EXCEEDED');
252:         await readJobArtifact(runtimeRoot, job.jobId, artifact, intent.maximumEvidenceBytes);
253:       }
254:       await verifyRetainedSource(job, intent);
255:       const archive = { schemaVersion: 'repository-archive-summary.v1' as const, encoding: job.repositoryArchive.encoding,
256:         contentDigest: job.repositoryArchive.contentDigest, sizeBytes: job.repositoryArchive.sizeBytes };
257:       const receipt: CompactionReceipt = {
258:         schemaVersion: 'buster-job-compaction-receipt.v1', intent: structuredClone(intent),
259:         intentDigest: compactionDigest(intent), compactedAt: new Date().toISOString(),
260:         revision: job.sourceSnapshot.revision, tree: job.sourceSnapshot.tree,
261:         archiveDigest: archive.contentDigest, archiveBytes: archive.sizeBytes, releasedMetadataBytes: 0,
262:       };
263:       let next: CompactedPlanJobRecord = {
264:         schemaVersion: 'buster-plan-job-compacted-record.v1', job: { ...job, schemaVersion: 'buster-plan-job-header.v1', repositoryArchive: archive }, status, compaction: receipt,
265:       };
266:       // Canonical record envelopes have fixed-size digests and ISO timestamps.
267:       // Include the receipt itself in the net metadata byte saving.
268:       const oldBytes = Buffer.byteLength(canonicalJson(current.payload));
269:       for (let iteration = 0; iteration < 8; iteration += 1) {
270:         const releasedMetadataBytes = oldBytes - Buffer.byteLength(canonicalJson(next));
271:         if (releasedMetadataBytes === next.compaction.releasedMetadataBytes) break;
272:         next = { ...next, compaction: { ...next.compaction, releasedMetadataBytes } };
273:       }
274:       if (next.compaction.releasedMetadataBytes < 1
275:         || next.compaction.releasedMetadataBytes !== oldBytes - Buffer.byteLength(canonicalJson(next))) {
276:         throw new Error('BUSTER_COMPACTION_NO_BYTE_SAVING');
277:       }
278:       assertCompactedPlanJobRecord(next);
279:       await this.#records.transition('buster-plan-jobs', current.record.idempotencyKey, current.record.payloadDigest, next);
280:       return { receipt: next.compaction, releasedMetadataBytes: next.compaction.releasedMetadataBytes };
281:     });
282:   }
283: 
284:   async result(jobId: string, contentDigest: string, maximumBytes: number): Promise<Buffer> {
285:     if (!Number.isSafeInteger(maximumBytes) || maximumBytes < 1) throw new Error('BUSTER_REMOTE_RESULT_LIMIT_INVALID');
286:     const status = (await this.get(jobId)).payload.status;
287:     if (status.state !== 'completed' || !status.result) throw new Error('BUSTER_REMOTE_RESULT_NOT_READY');
288:     if (status.result.contentDigest !== contentDigest) throw new Error('BUSTER_REMOTE_RESULT_NOT_FOUND');
289:     if (status.result.sizeBytes > maximumBytes || status.result.sizeBytes > this.#maximumResultBytes) {
290:       throw new Error('BUSTER_REMOTE_RESULT_SIZE_EXCEEDED');
291:     }
292:     const bytes = await this.#results.get(contentDigest);
293:     if (bytes.byteLength !== status.result.sizeBytes) throw new Error('BUSTER_REMOTE_RESULT_SIZE_MISMATCH');
294:     const parsed = JSON.parse(bytes.toString('utf8')) as RemotePlanResultV1;
295:     validatePipelineTestGateContract('remotePlanResult', parsed);
296:     if (parsed.jobId !== jobId || parsed.resultDigest !== status.result.resultDigest) {
297:       throw new Error('BUSTER_REMOTE_RESULT_IDENTITY_MISMATCH');
298:     }
299:     return bytes;
300:   }
301: }
