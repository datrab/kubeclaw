115: /** Caller must hold original Core/wait fences and provide synchronous full causal authorization. */
116: export async function projectDeliveryRequest(records: FileDurableRecordStore, request: EffectRequest, intent: DeliveryProjectionIntent,
117:   authorityDigest: string, authorize: (records: ReadonlyArray<DurableRecord>) => void): Promise<{ newlyProjected: boolean; releasedBytes: number }> {
118:   request = structuredClone(request); intent = structuredClone(intent);
119:   assertDeliveryProjectionIntent(intent);
120:   const candidate = originalJsonDeliveryCandidate(request), stream = `notifications/${request.resource.canonicalId}`;
121:   if (!digest(authorityDigest) || intent.runId !== request.attempt.runId || intent.effectKey !== request.idempotencyKey
122:     || intent.expectedPayloadDigest !== payloadDigest(candidate)) fail();
123:   const observed = await records.read(stream), terminal = retainedTerminal(observed, request);
124:   if (terminal.payloadDigest !== intent.terminalPayloadDigest) fail();
125:   if (projectedDeliveryReceipt(observed, request)) {
126:     return records.withRecords(stream, async current => {
127:       if (!projectedDeliveryReceipt(current, request)) fail();
128:       const stored = current.find(record => record.idempotencyKey === deliveryRequestKey(request))!.payload as ProjectedRequest;
129:       if (!same(stored.projection.intent, intent) || stored.projection.authorityDigest !== authorityDigest) fail();
130:       if (authorize(current) !== undefined) fail();
131:       return { newlyProjected: false, releasedBytes: 0 };
132:     });
133:   }
134:   const projection: ProjectionReceipt = { schemaVersion: 'operator-request-projection-receipt.v1', intent,
135:     intentDigest: payloadDigest(intent), authorityDigest, releasedBytesHex: '0000000000000000' };
136:   const value: ProjectedRequest = { schemaVersion: 'notification-delivery-request-projected.v1', originalDigest: intent.expectedPayloadDigest,
137:     deliveryId: request.idempotencyKey, target: request.resource.canonicalId, attempt: request.attempt, effectId: request.effectId,
138:     terminalKey: terminal.idempotencyKey, terminalDigest: terminal.payloadDigest, projection };
139:   const original = observed.find(record => record.idempotencyKey === deliveryRequestKey(request));
140:   if (!original || original.payloadDigest !== intent.expectedPayloadDigest) fail();
141:   const replacement = { ...original, committedAt: '2000-01-01T00:00:00.000Z', payloadDigest: payloadDigest(value), payload: value };
142:   const releasedBytes = Buffer.byteLength(canonicalJson(original)) - Buffer.byteLength(canonicalJson(replacement));
143:   if (releasedBytes < 1) throw new Error('OPERATOR_PROJECTION_NO_NET_SAVINGS');
144:   const retained = { ...value, projection: { ...projection, releasedBytesHex: releasedBytes.toString(16).padStart(16, '0') } };
145:   await records.transition(stream, deliveryRequestKey(request), intent.expectedPayloadDigest, retained, current => {
146:     const actual = retainedTerminal(current, request);
147:     if (actual.payloadDigest !== terminal.payloadDigest) fail();
148:     if (authorize(current) !== undefined) fail();
149:   });
150:   return { newlyProjected: true, releasedBytes };
151: }
