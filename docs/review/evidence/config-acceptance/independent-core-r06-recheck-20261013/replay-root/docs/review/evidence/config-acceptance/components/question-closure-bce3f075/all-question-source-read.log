338: export async function persistNovaObservabilityPlan(
339:   runRoot: string,
340:   pipelineRunId: string,
341:   attempts: ReadonlyArray<ReconciliationAttempt>,
342: ): Promise<void> {
343:   const snapshot: PersistedReconciliationPlan = {
344:     schemaVersion: "nova-observability-plan.v1",
345:     pipelineRunId,
346:     attempts: [...structuredClone(attempts)],
347:   };
348:   if (snapshot.attempts.some((item) => item.pipelineRunId !== pipelineRunId))
349:     throw new Error("NOVA_OBSERVABILITY_PLAN_RUN_MISMATCH");
350:   await writeDurableState(
351:     path.join(observabilityRoot(runRoot), "reconciliation-plan.json"),
352:     snapshot,
353:   );
354: }
