68: function rewriteJournal(file, entries) {
69:   let previousHash = null;
70:   const records = entries.map((entry, index) => {
71:     const record = { sequence: index + 1, previousHash, entry };
72:     const hash = `sha256:${crypto.createHash('sha256').update(JSON.stringify(record)).digest('hex')}`;
73:     previousHash = hash; return { ...record, hash };
74:   });
75:   fs.writeFileSync(file, records.map(record => JSON.stringify(record)).join('\n') + '\n');
76: }
