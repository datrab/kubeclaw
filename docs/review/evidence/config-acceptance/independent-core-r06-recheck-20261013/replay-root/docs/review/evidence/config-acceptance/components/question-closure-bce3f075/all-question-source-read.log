1: import fs from 'node:fs';
2: import path from 'node:path';
3: import Ajv2020 from 'ajv/dist/2020.js';
4: import addFormats from 'ajv-formats';
5: 
6: export interface PlatformConfig {
7:   readonly schemaVersion: 'pipeline-platform.v2';
8:   readonly installationRoots: readonly string[];
9:   readonly trustedBuiltinRoots: readonly string[];
10:   readonly externalTrust: Readonly<{
11:     readonly allowedSourceDigests: Readonly<Record<string, readonly string[]>>;
12:     readonly verifiedAttestations: Readonly<Record<string, string>>;
13:   }>;
14:   readonly providers: Readonly<Record<string, string>>;
15:   readonly grants: Readonly<Record<string, Readonly<Record<string, Readonly<Record<string, unknown>>>>>>;
16:   readonly adapters: Readonly<Record<string, Readonly<Record<string, unknown>>>>;
17:   readonly activeAdapters: readonly string[];
18:   readonly observers: Readonly<Record<string, Readonly<Record<string, unknown>>>>;
19:   readonly isolation?: Readonly<{ readonly cgroupRoot: string }>;
20:   readonly storageRoot: string;
21:   readonly shutdownTimeoutMs: number;
22:   readonly effectLockTtlMs: number;
23:   readonly orchestratorIssuerId: string;
24:   readonly administrativeDecisionIssuers: readonly Readonly<{
25:     readonly type: 'operator' | 'administrator';
26:     readonly id: string;
27:   }>[];
28: }
29: 
30: const schema = JSON.parse(fs.readFileSync(new URL('./platform.schema.json', import.meta.url), 'utf8')) as object;
31: interface Validator {
32:   (value: unknown): boolean;
33:   errors?: unknown[] | null;
34: }
35: interface AjvInstance {
36:   compile(schema: object): Validator;
37: }
38: const AjvConstructor = Ajv2020 as unknown as new (options: {
39:   allErrors: boolean;
40:   strict: boolean;
41: }) => AjvInstance;
42: const installFormats = addFormats as unknown as (instance: AjvInstance) => AjvInstance;
43: const ajv = new AjvConstructor({ allErrors: true, strict: true });
44: installFormats(ajv);
45: const validate = ajv.compile(schema);
46: 
47: function deepFreeze<T>(value: T): T {
48:   if (!value || typeof value !== 'object' || Object.isFrozen(value)) return value;
49:   for (const child of Object.values(value as Record<string, unknown>)) deepFreeze(child);
50:   return Object.freeze(value);
51: }
52: 
53: function resolvePaths(config: PlatformConfig, directory: string): PlatformConfig {
54:   return deepFreeze({
55:     ...config,
56:     installationRoots: config.installationRoots.map((value) => path.resolve(directory, value)),
57:     trustedBuiltinRoots: config.trustedBuiltinRoots.map((value) => path.resolve(directory, value)),
58:     storageRoot: path.resolve(directory, config.storageRoot),
59:     ...(config.isolation ? { isolation: { cgroupRoot: path.resolve(directory, config.isolation.cgroupRoot) } } : {}),
60:   });
61: }
62: 
63: export function loadPlatformConfig(file: string): PlatformConfig {
64:   const canonical = fs.realpathSync(file);
65:   const value = JSON.parse(fs.readFileSync(canonical, 'utf8')) as unknown;
66:   if (!validate(value)) {
67:     throw new Error(`PLATFORM_CONFIG_INVALID:${canonical}:${JSON.stringify(validate.errors ?? [])}`);
68:   }
69:   return resolvePaths(value as PlatformConfig, path.dirname(canonical));
70: }
