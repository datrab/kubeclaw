27: #ifndef LANDLOCK_ACCESS_FS_REFER
28: #define LANDLOCK_ACCESS_FS_REFER (1ULL << 13)
29: #endif
30: #ifndef LANDLOCK_ACCESS_FS_TRUNCATE
31: #define LANDLOCK_ACCESS_FS_TRUNCATE (1ULL << 14)
32: #endif
33: #ifndef LANDLOCK_ACCESS_NET_CONNECT_TCP
34: #define LANDLOCK_ACCESS_NET_CONNECT_TCP (1ULL << 1)
35: #endif
36: #ifndef LANDLOCK_RULE_NET_PORT
37: #define LANDLOCK_RULE_NET_PORT 2
38: #endif
39: #ifndef SOCK_TYPE_MASK
40: #define SOCK_TYPE_MASK 0xf
41: #endif
42: 
43: struct kubeclaw_landlock_ruleset_attr_v4 {
44:   __u64 handled_access_fs;
45:   __u64 handled_access_net;
46: };
47: 
48: struct kubeclaw_landlock_net_port_attr {
49:   __u64 allowed_access;
50:   __u64 port;
51: };
