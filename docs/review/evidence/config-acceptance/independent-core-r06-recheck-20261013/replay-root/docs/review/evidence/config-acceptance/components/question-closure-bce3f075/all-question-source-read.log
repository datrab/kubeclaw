98:   if(contents.some(bytes=>bytes.length>LIMIT))fail('SIZE_EXCEEDED');
99:   const members=contents.map((bytes,index)=>({name:names[index]!,digest:digest(bytes),bytes:bytes.length})) as [Member,Member];
