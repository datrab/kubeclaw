12: import type { BusterRemotePlanServiceOptions } from './remote-plan-service.ts';
13: 
14: type ExecutionPaths = Parameters<NonNullable<BusterRemotePlanServiceOptions['execute']>>[1];
15: 
16: async function executionPaths(options: BusterRemotePlanServiceOptions, jobId: string,
17:   source: PreparedSourceReference): Promise<ExecutionPaths> {
18:   const jobRoot = path.join(preparedPlanRuntimeRoot(options.runtimeRoot), crypto.createHash('sha256').update(jobId).digest('hex'));
19:   await ensureDirectoryDurable(jobRoot);
20:   const workspaceRoot = path.join(jobRoot, 'workspace');
21:   const repositoryRoot = path.join(workspaceRoot, 'repository');
22:   const artifactRoot = path.join(jobRoot, 'artifacts');
23:   const observabilityRoot = path.join(jobRoot, 'observability');
24:   for (const directory of [repositoryRoot, workspaceRoot, artifactRoot, observabilityRoot]) await ensureDirectoryDurable(directory);
25:   const sourceRepositoryRoot = await options.preparation.repository(source);
26:   return { jobRoot, repositoryRoot, sourceRepositoryRoot, workspaceRoot, artifactRoot, observabilityRoot };
27: }
28: 
29: async function runPlan(options: BusterRemotePlanServiceOptions, job: PreparedPlanJob,
30:   paths: ExecutionPaths, signal: AbortSignal): Promise<TestPlanRunResult> {
31:   signal.throwIfAborted();
32:   const capabilities = createBusterCapabilityRuntime(options, paths, options.executionPolicy.processInput);
33:   if (options.execute) return options.execute(job, paths, signal);
34:   return new TestPlanRunner({ plan: job.plan, registry: options.registry,
35:     workspaceRoot: paths.workspaceRoot, repositoryRoot: paths.repositoryRoot,
36:     sourceRepositoryRoot: paths.sourceRepositoryRoot, artifactRoot: paths.artifactRoot,
37:     observabilityRoot: paths.observabilityRoot, maximumConcurrency: job.maximumConcurrency,
38:     grants: new Map(Object.entries(job.grants)), workerLocalRuntime: options.workerLocalRuntime, executionPolicy: options.executionPolicy,
39:     ...(capabilities.invoker ? { capabilityInvoker: capabilities.invoker } : {}), signal,
40:   }).run().finally(() => capabilities.shutdown());
41: }
42: 
43: /** Accepted wire and source publication precede mutable per-attempt execution. */
44: export async function executeBusterPreparedJob(options: BusterRemotePlanServiceOptions,
45:   prepared: BusterStagedAdmission, signal: AbortSignal, now: () => Date): Promise<void> {
46:   const { job } = prepared;
47:   try {
48:     const extracted = await options.preparation.extract(prepared);
49:     await options.store.attachSource(extracted);
50:     await options.store.transition(job.jobId, ['accepted'], 'running', now().toISOString());
51:     const paths = await executionPaths(options, job.jobId, extracted.source);
52:     const run = await runPlan(options, job, paths, signal);
53:     if (run.cleanupErrors.length === 0 && run.attempts.every(attempt => attempt.executionState === 'completed')) {
54:       await cleanupTerminalWorkspace(paths.jobRoot);
55:     }
56:     if (signal.aborted) {
57:       await options.store.transition(job.jobId, ['running', 'cancelling'], 'cancelled',
58:         now().toISOString(), { error: 'cancelled by Nova' });
59:       return;
60:     }
61:     const unsigned = { schemaVersion: 'buster-plan-result.v1' as const,
62:       workerRevision: options.workerRevision, jobId: job.jobId, planId: job.plan.planId,
63:       planDigest: job.plan.planDigest, runId: job.plan.runId,
64:       attempts: [...run.attempts], nodes: [...run.nodes], cleanupErrors: [...run.cleanupErrors], completedAt: now().toISOString() };
65:     const resultDigest = remotePlanResultDigest(unsigned);
66:     const result: RemotePlanResultV1 = { ...unsigned, resultDigest, receipt: remotePlanResultReceipt(job.jobId, resultDigest) };
67:     validatePipelineTestGateContract('remotePlanResult', result);
68:     await options.store.complete(job.jobId, result, now().toISOString());
69:   } catch (error) {
70:     const current = await options.store.get(job.jobId).then(value => value.payload.status).catch((readError: unknown) => {
71:       throw new AggregateError([error, readError], 'BUSTER_REMOTE_TERMINAL_STATUS_UNREADABLE');
72:     });
73:     if (['completed', 'failed', 'cancelled'].includes(current.state)) return;
74:     const cancelled = signal.aborted || current.state === 'cancelling';
75:     await options.store.transition(job.jobId, [current.state], cancelled ? 'cancelled' : 'failed', now().toISOString(),
76:       { error: error instanceof Error ? error.message : String(error) });
77:   }
78: }
{"path": "skills/buster/engine/test-gates/runner-completion.ts", "sha256": "2281dc0ddf02338e1619f8710d10b42819a1641d5e850fd2c062f3f161e28c82"}
1: import crypto from 'node:crypto';
2: import type { WorkerAttemptEnvelopeV1, WorkerAttemptResultV1 } from '@kubeclaw/pipeline-worker-core-contract';
3: import { workerAttemptResultDigest } from '@kubeclaw/worker-core';
4: import { producerRecordDigest } from '@kubeclaw/pipeline-observability-contract';
5: import { createProducerClosure, scopedEvidenceId, type FileDurableAttemptStore } from '@kubeclaw/plugin-foundation/observability/durable-attempts';
6: import type { FileObservabilityAdmissionStore } from '@kubeclaw/plugin-foundation/observability/durable-delivery';
7: import type { TestPlanRunnerOptions } from './runner-types.ts';
8: import { receipt } from './runner-values.ts';
9: import { readManagedEvidence } from './runner-managed-evidence.ts';
10: 
11: export interface CompletionOwner {
12:   readonly options: TestPlanRunnerOptions;
13:   readonly attemptStore: FileDurableAttemptStore;
14:   readonly admissionStore: FileObservabilityAdmissionStore;
15:   readonly authorityId: string;
16:   readonly now: () => Date;
17: }
18: 
19: export async function resumeRunnerCompletions(owner: CompletionOwner): Promise<number> {
20:     const snapshot = await owner.attemptStore.snapshot();
21:     const closed = new Set(
22:       snapshot.closures.map(
23:         (item) => `${item.pipelineRunId}\0${item.closureId}`,
24:       ),
25:     );
26:     const current = snapshot.results.filter(
27:       (stored) =>
28:         stored.pipelineRunId === owner.options.plan.runId &&
29:         stored.planId === owner.options.plan.planId,
30:     );
31:     const newestGeneration = new Map<string, number>();
32:     for (const stored of current)
33:       newestGeneration.set(
34:         stored.attemptId,
35:         Math.max(
36:           newestGeneration.get(stored.attemptId) ?? 0,
37:           stored.claimGeneration,
38:         ),
39:       );
40:     let recovered = 0;
41:     for (const stored of current) {
42:       if (
43:         stored.claimGeneration <
44:         (newestGeneration.get(stored.attemptId) ?? 0)
45:       )
46:         continue;
47:       recovered += 1;
48:       if (
49:         !stored.completionIntent ||
50:         closed.has(
51:           `${stored.pipelineRunId}\0${stored.completionIntent.closure.closureId}`,
52:         )
53:       )
54:         continue;
55:       if (typeof stored.storedAt !== "string") continue;
56:       await owner.attemptStore.resumeCompletion(
57:         stored.pipelineRunId,
58:         stored.attemptId,
59:         stored.claimGeneration,
60:         owner.admissionStore,
61:       );
62:     }
63:     return recovered;
64:   }
65: 
66: function completionProducer(envelope: WorkerAttemptEnvelopeV1, result: WorkerAttemptResultV1) {
67:     if (
68:       result.attemptId !== envelope.attemptId ||
69:       result.claimId !== envelope.claim.claimId ||
70:       result.claimGeneration !== envelope.claim.generation ||
71:       result.workerId !== envelope.claim.workerId
72:     )
73:       throw new Error("OBSERVABILITY_WORKER_RESULT_IDENTITY_MISMATCH");
74:     const bootHash = crypto
75:       .createHash("sha256")
76:       .update(
77:         `${envelope.pipelineRunId}\0${envelope.attemptId}\0${envelope.claim.claimId}\0${envelope.claim.generation}`,
78:       )
79:       .digest("hex");
80:     const producer = {
81:       producerId: `attempt:${bootHash}`,
82:       bootId: `claim:${bootHash}`,
83:       producerType: "buster-attempt",
84:     };
85:     return { bootHash, producer };
86: }
87: 
88: type CompletionProducer = ReturnType<typeof completionProducer>;
89: 
90: async function storeCompletionEvidence(owner: CompletionOwner, envelope: WorkerAttemptEnvelopeV1,
91:   result: WorkerAttemptResultV1, producer: CompletionProducer['producer']) {
92:     const durableEvidence: WorkerAttemptResultV1["evidence"][number][] = [];
93:     let remainingEvidenceBytes = envelope.limits.evidenceBytes;
94:     for (const evidence of result.evidence) {
95:       const content = await readManagedEvidence(owner.options.artifactRoot,
96:         evidence.artifact.storageUrl,
97:         remainingEvidenceBytes,
98:       );
99:       remainingEvidenceBytes -= content.byteLength;
100:       durableEvidence.push(
101:         await owner.attemptStore.storeEvidence(
102:           {
103:             pipelineRunId: envelope.pipelineRunId,
104:             attemptId: envelope.attemptId,
105:             claimGeneration: envelope.claim.generation,
106:             producer,
107:             evidenceId: evidence.evidenceId,
108:             type: evidence.type,
109:             mediaType: evidence.artifact.mediaType,
110:           },
111:           content,
112:         ),
113:       );
114:     }
115:     return durableEvidence;
116: }
117: 
118: function completionResult(owner: CompletionOwner, result: WorkerAttemptResultV1,
119:   durableEvidence: WorkerAttemptResultV1['evidence'], bootHash: string): WorkerAttemptResultV1 {
120:     const durableResult: WorkerAttemptResultV1 = {
121:       ...structuredClone(result),
122:       evidence: durableEvidence,
123:       resultDigest: "",
124:     };
125:     durableResult.resultDigest = workerAttemptResultDigest(durableResult);
126:     durableResult.receipt = receipt(
127:       owner.authorityId,
128:       bootHash,
129:       durableResult.resultDigest,
130:     );
131:     return durableResult;
132: }
133: 
134: function completionIntent(owner: CompletionOwner, envelope: WorkerAttemptEnvelopeV1,
135:   durableResult: WorkerAttemptResultV1, { bootHash, producer }: CompletionProducer) {
136:     const durableEvidence = durableResult.evidence;
137:     const occurredAt = owner.now().toISOString();
138:     const unsignedRecord = {
139:       schemaVersion: "producer-record.v1" as const,
140:       recordId: `record:${bootHash}`,
141:       producer,
142:       sequence: 1,
143:       recordType: "attempt.completed",
144:       occurredAt,
145:       correlation: {
146:         pipelineRunId: envelope.pipelineRunId,
147:         moduleId: envelope.moduleId,
148:         gateId: envelope.gateId,
149:         attemptId: envelope.attemptId,
150:         claimId: envelope.claim.claimId,
151:         claimGeneration: envelope.claim.generation,
152:         traceId: null,
153:         parentEventId: null,
154:       },
155:       payload: {
156:         state: durableResult.state,
157:         workerId: durableResult.workerId,
158:         resultDigest: durableResult.resultDigest,
159:         evidence: durableEvidence.map((item) => ({
160:           evidenceId: item.evidenceId,
161:           contentDigest: item.artifact.contentDigest,
162:         })),
163:       },
164:     };
165:     const record = {
166:       ...unsignedRecord,
167:       recordDigest: producerRecordDigest(unsignedRecord),
168:     };
169:     const closure = createProducerClosure({
170:       schemaVersion: "producer-closure.v1",
171:       closureId: `closure:${bootHash}`,
172:       producer,
173:       pipelineRunId: envelope.pipelineRunId,
174:       firstSequence: 1,
175:       finalSequence: 1,
176:       recordCount: 1,
177:       requiredEvidenceIds: durableEvidence.map((item) =>
178:         scopedEvidenceId(
179:           envelope.attemptId,
180:           envelope.claim.generation,
181:           item.evidenceId,
182:         ),
183:       ),
184:       closedAt: owner.now().toISOString(),
185:     });
186:     return { record, closure };
187: }
188: 
189: /** An admission failure retains the already persisted result/intent for ordinary recovery. */
190: async function admitCompletion(owner: CompletionOwner, envelope: WorkerAttemptEnvelopeV1) {
191:   try {
192:     await owner.attemptStore.resumeCompletion(envelope.pipelineRunId,
193:       envelope.attemptId, envelope.claim.generation, owner.admissionStore);
194:   } catch {
195:     // INTENTIONAL_NONCRITICAL(committed_completion_admission): Result and intent
196:     // are already committed by storeResult outside this catch. Nova recovery resumes
197:     // admission and evaluates completeness; this does not claim an admitted closure.
198:     // Keep the existing recovery boundary: never retry the completed provider here.
199:   }
200: }
201: 
202: export async function persistRunnerCompletion(owner: CompletionOwner,
203:   envelope: WorkerAttemptEnvelopeV1, result: WorkerAttemptResultV1) {
204:   const identity = completionProducer(envelope, result);
205:   const evidence = await storeCompletionEvidence(owner, envelope, result, identity.producer);
206:   const durableResult = completionResult(owner, result, evidence, identity.bootHash);
207:   const intent = completionIntent(owner, envelope, durableResult, identity);
208:   await owner.attemptStore.storeResult(envelope.pipelineRunId, durableResult, intent,
209:     { planId: envelope.planId, nodeId: envelope.nodeId });
210:   await admitCompletion(owner, envelope);
211:   return Object.freeze(durableResult);
212: }
