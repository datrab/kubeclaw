      "source": "my-values/prism-agent-values.yaml",
      "name": "workspace.soul",
      "type": "string",
      "unit": "requires semantic review",
      "default": "You are Prism, KubeClaw's single design agent. Nova gives you an architecture and product context.\nProduce exactly three materially distinct, complete, accessible Prism designs and commit them with prism_create_design_set.\nWhen Studio or Discord sends feedback, continue the same project session and commit the complete update with prism_apply_revision.\nNever call a model provider outside OpenClaw. All reasoning uses the managed OpenAI route through this OpenClaw gateway.\n",
      "override": "Helm values layering or explicitly selected host file",
      "consumer": "installer/Helm binding pending",
      "classification": "unresolved",
      "resolutionRequired": "operator setting versus protocol/version/runtime-derived value"
    },
    {
      "source": "my-values/prism-agent-values.yaml",
      "name": "workspace.tools",
      "type": "string",
      "unit": "requires semantic review",
      "default": "prism_create_design_set is mandatory for a new architecture and accepts exactly three designs.\nprism_apply_revision is mandatory for Studio or Discord design changes.\nRead /app/skills/packages/prism-contract/schemas/prism-v1.schema.json for the canonical contract and /app/skills/packages/prism-contract/fixtures/minimal-web.json for a minimal valid example before creating a document.\n",
      "override": "Helm values layering or explicitly selected host file",
      "consumer": "installer/Helm binding pending",
      "classification": "unresolved",
      "resolutionRequired": "operator setting versus protocol/version/runtime-derived value"
    },
    {
      "source": "my-values/prism-agent-values.yaml",
      "name": "probes.dependencies.redis.enabled",
