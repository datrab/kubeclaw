      "name": "spec.validations",
      "type": "array",
      "unit": "requires semantic review",
      "default": [
        {
          "expression": "request.operation != \"UPDATE\" || (\n  oldObject.metadata.name.startsWith(\"test-\") &&\n  has(oldObject.metadata.labels) &&\n  \"kubeclaw/managed-by\" in oldObject.metadata.labels &&\n  oldObject.metadata.labels[\"kubeclaw/managed-by\"] == \"buster-namespace-controller\"\n)\n",
          "message": "The controller cannot adopt an existing unowned namespace by updating its labels."
        },
        {
          "expression": "request.userInfo.username != \"system:serviceaccount:kubeclaw:agent-buster\"\n",
          "message": "Buster must request BusterNamespaceLease objects instead of creating or deleting namespaces directly.\n"
        },
        {
          "expression": "request.operation != \"DELETE\"\n  ? (\n      object.metadata.name.startsWith(\"test-\") &&\n      has(object.metadata.labels) &&\n      \"kubeclaw/managed-by\" in object.metadata.labels &&\n      object.metadata.labels[\"kubeclaw/managed-by\"] ==\n        \"buster-namespace-controller\"\n    )\n  : (\n      oldObject.metadata.name.startsWith(\"test-\") &&\n      has(oldObject.metadata.labels) &&\n      \"kubeclaw/managed-by\" in oldObject.metadata.labels &&\n      oldObject.metadata.labels[\"kubeclaw/managed-by\"] ==\n        \"buster-namespace-controller\"\n    )\n",
          "message": "The Buster namespace controller may only create, update or delete managed namespaces with prefix \"test-\".\n"
        }
      ],
