    {
      "source": "my-values/prism-agent-values.yaml",
      "name": "extraContainers",
      "type": "array",
      "unit": "requires semantic review",
      "default": [
        {
          "name": "prism-agent-bridge",
          "image": "ghcr.io/datrab/kubeclaw-prism-agent:latest",
          "imagePullPolicy": "Always",
          "command": [
            "node",
            "/opt/kubeclaw-prism/agent-bridge.mjs"
          ],
          "env": [
            {
              "name": "PORT",
              "value": "18080"
            },
            {
              "name": "PRISM_CONTROL_URL",
              "value": "http://127.0.0.1:28080"
            },
            {
              "name": "PRISM_STUDIO_PUBLIC_URL",
              "value": "https://prism-studio"
            },
            {
              "name": "OPENCLAW_GATEWAY_TOKEN",
              "valueFrom": {
                "secretKeyRef": {
                  "name": "openclaw-shared-secrets",
                  "key": "gatewayToken-prism"
                }
              }
            }
          ],
          "volumeMounts": [
            {
              "name": "config",
              "mountPath": "/home/node/.openclaw"
            },
            {
              "name": "tmp",
              "mountPath": "/tmp"
            }
          ],
          "securityContext": {
            "runAsUser": 1000,
            "runAsGroup": 1000,
            "allowPrivilegeEscalation": false,
            "readOnlyRootFilesystem": true,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            }
          },
          "readinessProbe": {
            "httpGet": {
              "path": "/ready",
              "port": 18080
            },
            "initialDelaySeconds": 3
          },
          "livenessProbe": {
            "httpGet": {
              "path": "/health",
              "port": 18080
            },
            "initialDelaySeconds": 10
          },
          "resources": {
            "requests": {
              "cpu": "50m",
              "memory": "128Mi"
            },
            "limits": {
              "cpu": "500m",
              "memory": "512Mi"
            }
          }
        }
      ],
      "override": "Helm values layering or explicitly selected host file",
      "consumer": "installer/Helm binding pending",
      "classification": "unresolved",
      "resolutionRequired": "operator setting versus protocol/version/runtime-derived value"
    },
