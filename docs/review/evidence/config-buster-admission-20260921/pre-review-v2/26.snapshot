      "source": "my-values/infra/litellm-deployment.yaml",
      "name": "spec.template.spec.containers",
      "type": "array",
      "unit": "requires semantic review",
      "default": [
        {
          "name": "litellm",
          "image": "ghcr.io/berriai/litellm@sha256:690f24800e2208e4f31b01483b9d0521d79dc508c8191f1c0b2f21549400c580",
          "imagePullPolicy": "IfNotPresent",
          "args": [
            "--config",
            "/app/config.yaml",
            "--port",
            "4000"
          ],
          "env": [
            {
              "name": "GOOGLE_APPLICATION_CREDENTIALS",
              "value": "/keys/credentials.json"
            },
            {
              "name": "STORE_MODEL_IN_DB",
              "value": "True"
            }
          ],
          "envFrom": [
            {
              "secretRef": {
                "name": "litellm-secrets"
              }
            }
          ],
          "ports": [
            {
              "name": "http",
              "containerPort": 4000,
              "protocol": "TCP"
            }
          ],
          "startupProbe": {
            "httpGet": {
              "path": "/health/liveliness",
              "port": "http"
            },
            "periodSeconds": 5,
            "timeoutSeconds": 3,
            "failureThreshold": 24
          },
          "readinessProbe": {
            "httpGet": {
              "path": "/health/readiness",
              "port": "http"
            },
            "periodSeconds": 5,
            "timeoutSeconds": 3,
            "failureThreshold": 2
          },
          "livenessProbe": {
            "httpGet": {
              "path": "/health/liveliness",
              "port": "http"
            },
            "periodSeconds": 10,
            "timeoutSeconds": 3,
            "failureThreshold": 3
          },
          "volumeMounts": [
            {
              "name": "config",
              "mountPath": "/app/config.yaml",
              "subPath": "config.yaml"
            },
            {
              "name": "google-key-vol",
              "mountPath": "/keys",
              "readOnly": true
            }
          ],
          "resources": {
            "requests": {
              "cpu": "100m",
              "memory": "256Mi"
            },
            "limits": {
              "cpu": "1000m",
              "memory": "4Gi"
            }
          }
        }
      ],
      "override": "Helm values layering or explicitly selected host file",
      "consumer": "installer/Helm binding pending",
      "classification": "unresolved",
      "resolutionRequired": "operator setting versus protocol/version/runtime-derived value"
