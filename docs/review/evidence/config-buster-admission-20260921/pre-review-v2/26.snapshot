    {
      "source": "my-values/infra/registry-local.yaml",
      "name": "spec.template.spec.containers",
      "type": "array",
      "unit": "requires semantic review",
      "default": [
        {
          "name": "registry",
          "image": "registry:3.0.0",
          "args": [
            "serve",
            "/etc/kubeclaw-registry/config.yml"
          ],
          "ports": [
            {
              "containerPort": 5000
            }
          ],
          "env": [
            {
              "name": "OTEL_TRACES_EXPORTER",
              "value": "none"
            }
          ],
          "volumeMounts": [
            {
              "name": "data",
              "mountPath": "/var/lib/registry"
            },
            {
              "name": "config",
              "mountPath": "/etc/kubeclaw-registry",
              "readOnly": true
            }
          ],
          "readinessProbe": {
            "httpGet": {
              "path": "/v2/",
