      "unit": "requires semantic review",
      "default": [
        {
          "name": "buster-plan",
          "port": 18891,
          "targetPort": "buster-plan"
        }
      ],
      "override": "Helm values layering or explicitly selected host file",
      "consumer": "installer/Helm binding pending",
      "classification": "unresolved",
      "resolutionRequired": "operator setting versus protocol/version/runtime-derived value"
    },
    {
      "source": "my-values/buster-values.yaml",
      "name": "extraContainers",
      "type": "array",
      "unit": "requires semantic review",
      "default": [
        {
          "name": "buster-v2-runtime",
          "image": "ghcr.io/datrab/kubeclaw-buster-runtime:latest",
          "imagePullPolicy": "Always",
          "env": [
            {
              "name": "BUSTER_V2_TOKEN",
              "valueFrom": {
                "secretKeyRef": {
                  "name": "openclaw-shared-secrets",
                  "key": "busterV2Token"
                }
              }
            },
            {
              "name": "BUSTER_SOURCE_ATTESTATION_PUBLIC_KEY",
              "valueFrom": {
                "secretKeyRef": {
                  "name": "pipeline-test-gate-source-attestation",
                  "key": "publicKey"
                }
              }
            },
            {
              "name": "BUSTER_TRUSTED_PEER_SPIFFE_ID",
              "value": "spiffe://kubeclaw.internal/ns/kubeclaw/sa/agent-nova"
            },
            {
              "name": "BUSTER_PLAN_PORT",
              "value": "28891"
            },
            {
              "name": "BUSTER_PLAN_STATE_DIR",
              "value": "/var/lib/buster-v2/plan-jobs"
            },
            {
              "name": "BUSTER_PLAN_RUN_DIR",
              "value": "/var/lib/buster-v2/runs"
            },
            {
              "name": "BUSTER_V2_MAX_ARCHIVE_BYTES",
              "value": "67108864"
            },
            {
              "name": "BUSTER_V2_MAX_EXTRACTED_BYTES",
              "value": "536870912"
            },
            {
              "name": "BUSTER_V2_RESULT_ROOT",
              "value": "/workspace/git-repo/.swarm/runtime-results"
            },
            {
              "name": "BUSTER_V2_KUBERNETES_CREDENTIALS",
              "value": "/var/run/buster-worker/kubernetes"
            },
            {
              "name": "BUSTER_ALLOWED_SOURCE_SECRETS",
              "value": "kubeclaw-fixture-preflight,prism-test-provider,prism-test-runtime,prism-test-postgresql-auth,prism-test-ghcr"
            },
            {
              "name": "CONTAINER_BUILD_BUILDKIT_HOST",
              "value": "unix:///run/user/1000/buildkit/buildkitd.sock"
            },
            {
              "name": "BUSTER_BROWSER_PLAYWRIGHT_CGROUP_ROOT",
              "value": "/var/run/kubeclaw-browser-cgroup"
            }
          ],
          "ports": [
            {
              "name": "plan-runtime",
              "containerPort": 28891,
              "protocol": "TCP"
            }
          ],
          "startupProbe": {
            "httpGet": {
              "scheme": "HTTP",
              "path": "/bootstrapz",
              "port": 28891
            },
            "periodSeconds": 2,
            "timeoutSeconds": 2,
            "failureThreshold": 60
          },
          "readinessProbe": {
            "httpGet": {
              "scheme": "HTTP",
              "path": "/readyz",
              "port": 28891
            },
            "initialDelaySeconds": 5,
            "periodSeconds": 5,
            "timeoutSeconds": 2,
            "failureThreshold": 6
          },
          "livenessProbe": {
            "httpGet": {
              "scheme": "HTTP",
              "path": "/healthz",
              "port": 28891
            },
            "initialDelaySeconds": 30,
            "periodSeconds": 15,
            "timeoutSeconds": 2,
            "failureThreshold": 3
          },
          "volumeMounts": [
            {
              "name": "workspace",
              "mountPath": "/workspace"
            },
            {
              "name": "buster-v2-state",
              "mountPath": "/var/lib/buster-v2"
            },
            {
              "name": "buster-api-token",
              "mountPath": "/var/run/buster-worker/kubernetes",
              "readOnly": true
            },
            {
              "name": "buster-browser-cgroup",
              "mountPath": "/var/run/kubeclaw-browser-cgroup"
            }
          ],
          "resources": {
            "requests": {
              "cpu": "2",
              "memory": "8Gi",
              "ephemeral-storage": "8Gi"
            },
            "limits": {
              "cpu": "8",
              "memory": "24Gi",
              "ephemeral-storage": "60Gi"
            }
          },
          "securityContext": {
            "runAsUser": 0,
            "runAsGroup": 0,
            "runAsNonRoot": false,
            "privileged": false,
            "allowPrivilegeEscalation": true,
            "appArmorProfile": {
              "type": "Unconfined"
            },
            "seccompProfile": {
              "type": "Unconfined"
            },
            "capabilities": {
              "drop": [
                "ALL"
              ],
              "add": [
                "CHOWN",
                "SETGID",
                "SETPCAP",
                "SETUID"
              ]
            }
          }
        }
      ],
      "override": "Helm values layering or explicitly selected host file",
      "consumer": "installer/Helm binding pending",
      "classification": "unresolved",
      "resolutionRequired": "operator setting versus protocol/version/runtime-derived value"
    },
    {
      "source": "my-values/buster-values.yaml",
      "name": "extraVolumes",
      "type": "array",
      "unit": "requires semantic review",
      "default": [
        {
          "name": "buster-v2-state",
          "persistentVolumeClaim": {
            "claimName": "agent-buster-runtime-state"
          }
        },
        {
          "name": "buster-api-token",
          "projected": {
            "defaultMode": 288,
            "sources": [
              {
                "serviceAccountToken": {
                  "path": "token",
                  "expirationSeconds": 3600
                }
              },
              {
                "configMap": {
                  "name": "kube-root-ca.crt",
                  "items": [
                    {
                      "key": "ca.crt",
                      "path": "ca.crt"
                    }
