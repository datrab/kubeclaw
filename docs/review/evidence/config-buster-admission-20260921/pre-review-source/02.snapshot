{
  "_doc": "Single authored swarm configuration. operator.prism is consumed by production Prism startup loaders; legacy profile expansion remains separate test support.",
  "profile": "standard",
  "features": {
    "observability": true,
    "buster": true,
    "discord_alerts": true
  },
  "tuning": {
    "safety_margins": "high",
    "retention": "high",
    "alerts": "rich",
    "logs": "verbose",
    "checks": "strict",
    "determinism": "strict"
  },
  "overrides": {},
  "operator": {
    "prism": {
      "worker": {
        "maximumActiveRequests": 16,
        "maximumProbeRequests": 4,
        "maximumConnections": 128,
        "requestTimeoutMs": 120000,
        "shutdownTimeoutMs": 120000,
        "maximumInputBytes": 16777216
      },
      "native": {
        "maximumResultBytes": 67108864,
        "dispatchTimeoutMs": 900000,
        "resourcePolicy": {
          "cpuTimeMs": 60000,
          "memoryBytes": 8589934592,
          "tasks": 2048
        },
        "supervisor": {
          "uid": 1000,
          "gid": 1000,
          "maximumOwnershipRecords": 65536,
          "maximumOwnershipBytes": 67108864,
          "maximumOutputBytes": 33554432,
          "maximumJournalBytes": 68719476736,
          "pollIntervalMs": 20,
          "drainTimeoutMs": 10000,
          "closeTimeoutMs": 105000
        }
      },
      "control": {
        "pipelinePreferenceSubject": null,
        "artifactRoot": "/var/lib/prism/artifacts",
        "studioPublicUrl": "https://prism-studio",
        "port": 8080
      },
      "studio": {
        "port": 8080,
        "controlTimeoutMs": 30000,
        "controlUrl": "http://prism-control:8080"
      }
    },
    "buster": {
      "preparation": {
        "resourcePolicy": {
          "cpuTimeMs": 120000,
          "memoryBytes": 8589934592,
          "tasks": 64
        },
        "timeoutMs": 300000,
        "cleanupTimeoutMs": 10000,
        "maximumActivePreparations": 2,
        "maximumPendingAdmissions": 16,
        "maximumRequestBytes": 100663296,
        "maximumArchiveBytes": 67108864,
        "maximumExtractedBytes": 536870912,
        "maximumHeaderBytes": 3145728,
        "maximumSourceBytes": 1073741824,
        "maximumMetadataBytes": 67108864,
        "maximumRecords": 10000,
        "maximumOwnershipBytes": 16777216,
        "maximumJournalBytes": 268435456,
        "maximumInputBytes": 65536,
        "maximumOutputBytes": 8388608,
        "maximumResultBytes": 4194304,
        "pollIntervalMs": 25,
        "drainTimeoutMs": 5000,
        "closeTimeoutMs": 10000,
        "tarTimeoutMs": 120000,
        "maximumArchiveEntries": 200000,
        "maximumListingLineBytes": 1048576,
        "maximumTarStderrBytes": 65536,
        "maximumSourceEntries": 400014,
        "sourceEntryReservationBytes": 256,
        "maximumOpenFiles": 64
      },
      "admission": {
        "maximumActiveJobs": 2,
        "maximumQueuedJobs": 8,
        "maximumConcurrentAttempts": 64
      }
    }
  }
}
