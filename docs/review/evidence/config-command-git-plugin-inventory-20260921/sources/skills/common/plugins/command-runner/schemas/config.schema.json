{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowedExecutables",
    "allowedWorkingRoots",
    "maxOutputBytes",
    "maxExecutionMs",
    "terminationGraceMs"
  ],
  "properties": {
    "allowedExecutables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executableCatalog": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedWorkingRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maxExecutionMs": {
      "type": "integer",
      "minimum": 1
    },
    "terminationGraceMs": {
      "type": "integer",
      "minimum": 1
    }
  }
}
