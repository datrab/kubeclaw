      "assert.equal((await fetch(statusUrl, { headers: {\n      'x-forwarded-client-cert': `By=spiffe://kubeclaw.internal/proxy;URI=${novaSpiffeId}`,\n    } })).status, 200, 'the configured Nova SPIFFE identity must be accepted')",
