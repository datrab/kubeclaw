{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "dockerfile", "staticPath"],
  "properties": {
    "moduleId": { "type": "string", "minLength": 1 },
    "dockerfile": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "staticPath": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    }
  }
}
