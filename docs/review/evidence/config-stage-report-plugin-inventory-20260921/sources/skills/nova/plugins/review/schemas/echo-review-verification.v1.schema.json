{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubeclaw.dev/schemas/echo-review-verification.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleDigest",
    "policyDigest",
    "proposalSetDigest",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": "echo-review-verification.v1"
    },
    "bundleDigest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "policyDigest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "proposalSetDigest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "results": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "maxLength": 71,
        "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verdict",
          "reason",
          "evidence"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "confirmed",
              "rejected",
              "insufficient_evidence"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
          },
          "evidence": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "digest"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
                },
                "digest": {
                  "type": "string",
                  "maxLength": 71,
                  "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": [
                    "confirmed",
                    "rejected"
                  ]
                }
              },
              "required": [
                "verdict"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
