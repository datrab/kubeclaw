{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "^(?![\\s\\S]*[\\r\\n\\u0000])[\\s\\S]*\\S[\\s\\S]*$"
    }
  }
}
