{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactRoot"],
  "properties": {
    "artifactRoot": { "type": "string", "minLength": 1 },
    "maxArtifactBytes": { "type": "integer", "minimum": 1 },
    "maximumRecords": { "type": "integer", "minimum": 1, "default": 100000 },
    "maximumStoreBytes": { "type": "integer", "minimum": 1, "default": 268435456 }
  }
}
