        "supervisor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid",
            "gid",
            "maximumOwnershipRecords",
            "maximumOwnershipBytes",
            "maximumOutputBytes",
            "maximumJournalBytes",
            "pollIntervalMs",
            "drainTimeoutMs",
            "closeTimeoutMs"
