{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "positiveTimerInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "prism-control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipelinePreferenceSubject",
        "artifactRoot",
        "studioPublicUrl",
        "port",
        "dispatchTimeoutMs"
      ],
      "properties": {
        "pipelinePreferenceSubject": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^user-[a-f0-9]{24}$"
        },
        "artifactRoot": {
          "type": "string",
          "pattern": "^/[^\u0000]+$"
        },
        "studioPublicUrl": {
          "type": "string",
          "pattern": "^https?://[^/?#\\s@]+(?:/[^?#\\s]*)?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dispatchTimeoutMs": {
          "$ref": "#/$defs/positiveTimerInteger"
        }
      }
    },
    "prism-studio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "controlTimeoutMs",
        "controlUrl"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "controlTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "controlUrl": {
          "type": "string",
          "pattern": "^https?://[^/?#\\s@\\\\\\x00-\\x20\\x7f]+/?$"
        }
      }
    },
    "prism-worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress",
        "supervisor"
      ],
      "properties": {
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "maximumActiveRequests",
            "maximumProbeRequests",
            "maximumConnections",
            "requestTimeoutMs",
            "shutdownTimeoutMs",
            "maximumInputBytes"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "maximumActiveRequests": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "maximumProbeRequests": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "maximumConnections": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "requestTimeoutMs": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "shutdownTimeoutMs": {
              "$ref": "#/$defs/positiveTimerInteger"
