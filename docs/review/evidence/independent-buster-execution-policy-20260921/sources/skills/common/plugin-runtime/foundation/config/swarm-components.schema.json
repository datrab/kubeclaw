          "properties": {
            "uid": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "gid": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "maximumOwnershipRecords": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "maximumOwnershipBytes": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "maximumOutputBytes": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "maximumJournalBytes": {
              "$ref": "#/$defs/positiveSafeInteger"
            },
            "pollIntervalMs": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "drainTimeoutMs": {
              "$ref": "#/$defs/positiveTimerInteger"
            },
            "closeTimeoutMs": {
              "$ref": "#/$defs/positiveTimerInteger"
            }
          }
        }
      }
