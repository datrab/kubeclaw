+
+const selected = { cleanupTimeoutMs: 1500, terminationGraceMs: 250, acknowledgementPollMs: 10 };
+function observe(t, delayedClose = false) {
+  const realSpawn = childProcess.spawn;
+  const realKill = process.kill;
