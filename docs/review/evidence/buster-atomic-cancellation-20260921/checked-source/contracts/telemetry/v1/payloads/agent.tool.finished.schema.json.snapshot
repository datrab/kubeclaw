{
  "$id": "agent.tool.finished.payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/agent_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "agent_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/attempt"
        },
        {
          "type": "number"
        }
      ]
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "dispatch_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/dispatch_id"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "$ref": "../envelope.schema.json#/properties/extensions"
    },
    "gate_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "gate_type": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_type"
        },
        {
          "minLength": 1
        }
      ]
    },
    "gateway_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/model_call_id"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "module_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/module_id"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "outcome": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_bytes": {
      "minimum": 0,
      "type": "number"
    },
    "session_key": {
      "minLength": 1,
      "type": "string"
    },
    "tool_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/tool_call_id"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "tool_name": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "tool_name",
    "tool_call_id",
    "session_key",
    "model_call_id",
    "module_id",
    "attempt",
    "dispatch_id",
    "content_completeness",
    "outcome",
    "result_bytes",
    "error"
  ],
  "type": "object"
}
