{
  "$id": "quarantined_payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "extensions": {
      "type": "object"
    },
    "identity": {
      "type": [
        "object",
        "null"
      ]
    },
    "intended_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_byte_length": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "original_sha256": {
      "oneOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "quarantine_id": {
      "minLength": 1,
      "type": "string"
    },
    "quarantined_at": {
      "format": "date-time",
      "type": "string"
    },
    "reason_code": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "quarantined_payload.v1"
    }
  },
  "required": [
    "schema_version",
    "quarantine_id",
    "quarantined_at",
    "reason_code",
    "producer"
  ],
  "type": "object"
}
