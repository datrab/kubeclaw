{
  "$id": "pipeline_lifecycle_event.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "effective_at": {
      "format": "date-time",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "gate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle_version": {
      "const": "pipeline_lifecycle.v1"
    },
    "module_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "new_state": {
      "minLength": 1,
      "type": "string"
    },
    "previous_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "reason_code": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "pipeline_lifecycle_event.v1"
    },
    "source_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_type": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "source_event_id",
    "run_id",
    "project",
    "lifecycle_version",
    "effective_at",
    "authority",
    "previous_state",
    "new_state",
    "reason_code"
  ],
  "type": "object"
}
