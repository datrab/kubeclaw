{
  "$id": "evaluation_fact.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "dimension": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "evaluation_fact.v1"
    },
    "value": {},
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "recorded_at",
    "run_id",
    "dimension",
    "value"
  ],
  "type": "object"
}
