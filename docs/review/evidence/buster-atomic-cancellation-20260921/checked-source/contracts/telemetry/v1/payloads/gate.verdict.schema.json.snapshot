{
  "$id": "gate.verdict.payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/agent_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "$ref": "../envelope.schema.json#/properties/attempt"
    },
    "blockers_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "dispatch_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/dispatch_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "duration_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "extensions": {
      "$ref": "../envelope.schema.json#/properties/extensions"
    },
    "fix_cycle": {
      "type": [
        "number",
        "null"
      ]
    },
    "gate_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_id"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "gate_type": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_type"
        },
        {
          "minLength": 1
        }
      ]
    },
    "gateway_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "issues_count": {
      "type": [
        "number",
        "null"
      ]
    },
    "model_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/model_call_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "module_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/module_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "$ref": "../envelope.schema.json#/properties/run_id"
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "tool_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/tool_call_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "type": "string"
    }
  },
  "required": [
    "gate_id",
    "verdict"
  ],
  "type": "object"
}
