{
  "$id": "pipeline.started.payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/agent_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "$ref": "../envelope.schema.json#/properties/attempt"
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "dispatch_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/dispatch_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "execution_order": {
      "type": "array"
    },
    "extensions": {
      "$ref": "../envelope.schema.json#/properties/extensions"
    },
    "gate_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "gate_type": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_type"
        },
        {
          "minLength": 1
        }
      ]
    },
    "gates": {
      "type": "array"
    },
    "manifest_fingerprint": {
      "minLength": 1,
      "type": "string"
    },
    "manifest_reference": {
      "minLength": 1,
      "type": "string"
    },
    "model_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/model_call_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "models": {
      "type": [
        "object",
        "null"
      ]
    },
    "module_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/module_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "modules": {
      "type": "array"
    },
    "nova_prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "resume": {
      "type": "boolean"
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "tool_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/tool_call_id"
        },
        {
          "minLength": 1
        }
      ]
    }
  },
  "required": [
    "modules",
    "gates",
    "execution_order",
    "resume"
  ],
  "type": "object"
}
