{
  "$id": "pipeline_evidence_export.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "contract_manifest_reference": {
      "minLength": 1,
      "type": "string"
    },
    "contracts_reference": {
      "minLength": 1,
      "type": "string"
    },
    "expected_source_facts_reference": {
      "minLength": 1,
      "type": "string"
    },
    "exported_at": {
      "format": "date-time",
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "hash_algorithm": {
      "const": "sha256-path-content-v1"
    },
    "schema_version": {
      "const": "pipeline_evidence_export.v1"
    },
    "source_git_clean": {
      "type": "boolean"
    },
    "source_git_commit": {
      "pattern": "^[a-f0-9]{40,64}$",
      "type": "string"
    },
    "source_run_id": {
      "minLength": 1,
      "type": "string"
    },
    "verification": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "exported_at",
    "source_run_id",
    "verification",
    "contracts_reference",
    "contract_manifest_reference",
    "source_git_commit",
    "source_git_clean",
    "bundle_sha256",
    "hash_algorithm"
  ],
  "type": "object"
}
