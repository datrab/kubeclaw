{
  "$id": "observability.restored.event.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "allOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "minLength": 1
        }
      ]
    },
    "agent_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "authority_class": {
      "minLength": 1,
      "type": "string"
    },
    "authorization": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "component": {
      "minLength": 1,
      "type": "string"
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "degraded_at": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "dispatch_id": {
      "allOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "minLength": 1
        }
      ]
    },
    "emitted_at": {
      "format": "date-time",
      "type": "string"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "properties": {
        "evidence_provenance": {
          "enum": [
            "production",
            "recorded",
            "synthetic"
          ]
        }
      },
      "required": [
        "evidence_provenance"
      ],
      "type": "object"
    },
    "gate_id": {
      "allOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "minLength": 1
        }
      ]
    },
    "gate_type": {
      "allOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "minLength": 1
        }
      ]
    },
    "gateway_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "hook_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "impacted_event_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "model_call_id": {
      "allOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "minLength": 1
        }
      ]
    },
    "module_id": {
      "allOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "minLength": 1
        }
      ]
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "parent_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "restored_after_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "restored_at": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "telemetry_envelope.v1"
    },
    "seq": {
      "minimum": 1,
      "type": "integer"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "source_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "stdout": {
      "type": [
        "string",
        "null"
      ]
    },
    "stream_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "surface": {
      "minLength": 1,
      "type": "string"
    },
    "tool_call_id": {
      "allOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "minLength": 1
        }
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "transcript": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "const": "observability.restored"
    },
    "validation_errors": {
      "type": [
        "array",
        "null"
      ]
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_type": {
      "enum": [
        "pipeline",
        "module",
        "gate",
        "generator",
        "validator",
        "pipeline_step",
        null
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "source_event_id",
    "type",
    "occurred_at",
    "emitted_at",
    "seq",
    "cursor",
    "project",
    "run_id",
    "source",
    "producer",
    "authority_class",
    "extensions",
    "component",
    "surface",
    "reason"
  ],
  "type": "object"
}
