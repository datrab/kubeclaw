{
  "$id": "pipeline_command_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "type": "string"
    },
    "capability": {
      "minLength": 1,
      "type": "string"
    },
    "command_id": {
      "minLength": 1,
      "type": "string"
    },
    "command_type": {
      "enum": [
        "approval.resolve",
        "pipeline.pause",
        "pipeline.resume",
        "pipeline.cancel"
      ]
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_lifecycle_version": {
      "minimum": 0,
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "pipeline_command_request.v1"
    },
    "target": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "command_type",
    "project",
    "run_id",
    "actor",
    "capability",
    "issued_at",
    "expires_at",
    "reason",
    "target",
    "expected_lifecycle_version"
  ],
  "type": "object"
}
