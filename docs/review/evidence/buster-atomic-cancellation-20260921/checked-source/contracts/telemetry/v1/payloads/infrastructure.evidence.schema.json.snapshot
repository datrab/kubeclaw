{
  "$id": "infrastructure.evidence.payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/agent_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "$ref": "../envelope.schema.json#/properties/attempt"
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "delivery": {
      "type": [
        "object",
        "null"
      ]
    },
    "dispatch_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/dispatch_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "evidence_type": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "$ref": "../envelope.schema.json#/properties/extensions"
    },
    "gate_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "gate_type": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_type"
        },
        {
          "minLength": 1
        }
      ]
    },
    "gateway": {
      "type": [
        "object",
        "null"
      ]
    },
    "model_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/model_call_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "module_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/module_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "namespace_lease": {
      "type": [
        "object",
        "null"
      ]
    },
    "preview_url": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "readiness": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "redis": {
      "type": [
        "object",
        "null"
      ]
    },
    "resource_usage": {
      "type": [
        "object",
        "null"
      ]
    },
    "restarts": {
      "type": [
        "number",
        "null"
      ]
    },
    "rollout": {
      "type": [
        "object",
        "null"
      ]
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "termination_reason": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "tool_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/tool_call_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "workload": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "evidence_type",
    "status"
  ],
  "type": "object"
}
