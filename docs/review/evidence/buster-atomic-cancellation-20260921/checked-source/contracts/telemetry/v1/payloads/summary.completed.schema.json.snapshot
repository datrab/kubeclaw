      "type": [
        "string",
        "null"
      ]
    },
    "markdown_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "model_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/model_call_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "module_id": {
      "allOf": [
