+    for (const stored of current)
+      newestGeneration.set(
+        stored.attemptId,
+        Math.max(
+          newestGeneration.get(stored.attemptId) ?? 0,
+          stored.claimGeneration,
+        ),
+      );
+    let recovered = 0;
+    for (const stored of current) {
+      if (
+        stored.claimGeneration <
+        (newestGeneration.get(stored.attemptId) ?? 0)
+      )
