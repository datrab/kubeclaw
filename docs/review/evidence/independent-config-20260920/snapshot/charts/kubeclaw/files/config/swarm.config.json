{
  "_doc": "Single authored swarm configuration. The operator.prism.worker section is consumed by the production Prism loader; legacy profile expansion remains separate test support.",
  "profile": "standard",
  "features": {
    "observability": true,
    "buster": true,
    "discord_alerts": true
  },
  "tuning": {
    "safety_margins": "high",
    "retention": "high",
    "alerts": "rich",
    "logs": "verbose",
    "checks": "strict",
    "determinism": "strict"
  },
  "overrides": {},
  "operator": {
    "prism": {
      "worker": {
        "maximumActiveRequests": 16,
        "maximumProbeRequests": 4,
        "maximumConnections": 128,
        "requestTimeoutMs": 120000,
        "shutdownTimeoutMs": 120000
      }
    }
  }
}
