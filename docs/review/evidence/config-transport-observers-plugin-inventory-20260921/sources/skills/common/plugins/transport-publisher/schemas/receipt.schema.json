{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "target", "publicationId", "status"],
  "properties": {
    "accepted": {
      "const": true
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "publicationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "status": {
      "type": "integer",
      "minimum": 200,
      "maximum": 299
    }
  }
}
