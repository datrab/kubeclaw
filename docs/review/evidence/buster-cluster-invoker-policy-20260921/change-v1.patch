+      canonicalId: `${capability === 'kubernetes.fixture' ? 'kubernetes-fixture' : 'kubernetes-exposure'}:attempt:one` },
+      payload: { leaseName: 'test-one', namespace: 'test-one', serviceName: 'app', servicePort: 80,
