    "prism-control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipelinePreferenceSubject",
        "artifactRoot",
        "studioPublicUrl",
        "port",
        "dispatchTimeoutMs"
      ],
      "properties": {
        "pipelinePreferenceSubject": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^user-[a-f0-9]{24}$"
        },
        "artifactRoot": {
          "type": "string",
          "pattern": "^/[^\u0000]+$"
        },
        "studioPublicUrl": {
          "type": "string",
          "pattern": "^https?://[^/?#\\s@]+(?:/[^?#\\s]*)?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dispatchTimeoutMs": {
          "$ref": "#/$defs/positiveTimerInteger"
        }
      }
    },
    "prism-studio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "controlTimeoutMs",
        "controlUrl"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "controlTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "controlUrl": {
          "type": "string",
          "pattern": "^https?://[^/?#\\s@\\\\\\x00-\\x20\\x7f]+/?$"
        }
      }
    },
