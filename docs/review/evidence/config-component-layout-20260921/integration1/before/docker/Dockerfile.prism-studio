# Version defaults are generated from versions.json; run npm run versions:sync.
ARG NODE_BASE=node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
FROM ${NODE_BASE} AS build
USER root
WORKDIR /build
COPY . /build
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund \
 && npm run build:studio --prefix skills/prism \
 && npm prune --omit=dev --ignore-scripts

FROM ${NODE_BASE}
USER root
WORKDIR /app/prism
COPY --from=build /build/skills/prism/dist-studio /app/prism/skills/prism/dist-studio
COPY --from=build /build/skills/prism/server /app/prism/skills/prism/server
COPY --from=build /build/node_modules/ajv /app/prism/node_modules/ajv
COPY --from=build /build/node_modules/fast-deep-equal /app/prism/node_modules/fast-deep-equal
COPY --from=build /build/node_modules/fast-uri /app/prism/node_modules/fast-uri
COPY --from=build /build/node_modules/json-schema-traverse /app/prism/node_modules/json-schema-traverse
COPY --from=build /build/node_modules/require-from-string /app/prism/node_modules/require-from-string
COPY --from=build /build/skills/common/plugin-runtime/foundation/config /app/prism/skills/common/plugin-runtime/foundation/config
COPY --from=build /build/skills/prism/package.json /app/prism/skills/prism/package.json
RUN chown -R node:node /app/prism
USER node
ENV NODE_ENV=production STUDIO_ROOT=/app/prism/skills/prism/dist-studio
# Exercise the packaged service as its runtime user, without build dependencies.
RUN --mount=type=bind,source=skills/prism/tests/studio-service.test.mts,target=/app/prism/skills/prism/tests/studio-service.test.mts \
    --mount=type=bind,source=skills/prism/tests/fixtures/studio-service.mts,target=/app/prism/skills/prism/tests/fixtures/studio-service.mts \
    --mount=type=bind,source=skills/prism/tests/studio-canonical-image.mts,target=/app/prism/skills/prism/tests/studio-canonical-image.mts \
    --mount=type=bind,source=charts/kubeclaw/files/config/swarm.config.json,target=/tmp/studio-authored.json \
    SWARM_CONFIG=/tmp/studio-authored.json node --test --test-concurrency=1 /app/prism/skills/prism/tests/studio-service.test.mts /app/prism/skills/prism/tests/studio-canonical-image.mts
EXPOSE 8080
CMD ["node","--experimental-strip-types","skills/prism/server/studio.ts"]
