{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["profile", "paths", "policy"],
  "properties": {
    "profile": { "enum": ["web-https-v1", "api-http-v1"] },
    "paths": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/(?!/)", "maxLength": 2048 } },
    "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
    "rules": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "add": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/rule" } },
        "replace": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/rule" } },
        "remove": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 128 } }
      }
    },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "rule": { "type": "object", "additionalProperties": false, "required": ["id", "header", "severity", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 128 },
        "header": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 128 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "kind": { "enum": ["present", "equals", "contains", "hsts-min-age"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "policy": { "type": "object", "additionalProperties": false, "required": ["profile"],
      "properties": {
        "profile": { "const": "strict-v1" },
        "acceptances": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/acceptance" } }
      } },
    "acceptance": { "type": "object", "additionalProperties": false, "required": ["findingId", "reason", "expiresAt"],
      "properties": {
        "findingId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:@/-]+$" },
        "reason": { "type": "string", "minLength": 8, "maxLength": 1024 },
        "expiresAt": { "type": "string", "format": "date-time" }
      } }
  }
}
