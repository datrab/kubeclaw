        {
          "path": "targets",
          "required": true,
          "schema": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "endpoint"
              ],
              "properties": {
                "endpoint": {
                  "type": "string",
                  "format": "uri"
                },
                "authentication": {
                  "enum": [
                    "hmac",
                    "spiffe-proxy"
                  ],
                  "default": "hmac"
                },
                "tokenSecret": {
                  "type": "string",
                  "minLength": 1
                },
                "maxRequestBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608,
                  "default": 1048576
                },
                "maxResponseBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8388608,
                  "default": 1048576
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "authentication": {
                        "const": "spiffe-proxy"
                      }
                    },
                    "required": [
                      "authentication"
                    ]
                  },
                  "then": {
                    "properties": {
                      "endpoint": {
                        "type": "string",
                        "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):"
                      }
                    },
                    "not": {
                      "properties": {
                        "tokenSecret": {}
                      },
                      "required": [
                        "tokenSecret"
                      ]
                    }
                  },
                  "else": {
                    "properties": {
                      "tokenSecret": {}
                    },
                    "required": [
                      "tokenSecret"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "path": "targets.*.endpoint",
          "requiredInTarget": true,
          "schema": {
            "type": "string",
            "format": "uri"
          }
        },
        {
