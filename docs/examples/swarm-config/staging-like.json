{
  "_doc": "Example compact swarm config for a staging-like exception. It keeps the standard profile and changes only a few known effective paths.",
  "profile": "standard",
  "features": {
    "observability": true,
    "buster": true,
    "discord_alerts": true
  },
  "tuning": {
    "safety_margins": "high",
    "retention": "high",
    "alerts": "rich",
    "logs": "verbose",
    "checks": "strict",
    "determinism": "strict"
  },
  "overrides": {
    "pipeline_defaults": {
      "timeout_minutes": 300,
      "max_fails": 8,
      "auto_retry_threshold": 7
    },
    "rate_limit": {
      "cooldown_hours": 2,
      "max_pauses_per_module": 5
    },
    "buster": {
      "runtime": {
        "suite_timeout_ms": 300000
      }
    },
    "review_defaults": {
      "max_fix_cycles": 3
    }
  },
  "discord_webhook_url": ""
}
