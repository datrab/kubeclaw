{
  "_doc": "Example compact swarm config for a local exception. It still uses the standard profile; only known effective config paths may be overridden.",
  "profile": "standard",
  "features": {
    "observability": true,
    "buster": true,
    "discord_alerts": true
  },
  "tuning": {
    "safety_margins": "high",
    "retention": "high",
    "alerts": "rich",
    "logs": "verbose",
    "checks": "strict",
    "determinism": "strict"
  },
  "overrides": {
    "pipeline_defaults": {
      "timeout_minutes": 180,
      "max_fails": 4,
      "auto_retry_threshold": 3
    },
    "rate_limit": {
      "cooldown_hours": 1,
      "max_pauses_per_module": 3
    },
    "buster": {
      "runtime": {
        "suite_timeout_ms": 180000
      }
    },
    "review_defaults": {
      "max_fix_cycles": 2
    }
  },
  "discord_webhook_url": ""
}
