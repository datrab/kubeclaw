    {
      "id": "buster-legacy-suite",
      "path": "tests/skills/buster",
      "targetPackage": null,
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "rewrite",
        "legacyBehavior": "Buster selects and executes deterministic suites, supervises optional agent judgment, records evidence, and classifies assertion versus infrastructure failures.",
        "replacementBehavior": "The v2 test stage executes bounded command suites through command.execute, combines their real results with supplied specialized-suite evidence, and accepts only a terminal identity-bound runtime verdict with transcript evidence.",
        "rationale": "Suite policy stays in the test package while subprocesses and agent sessions remain replaceable capabilities.",
        "complexityImpact": "Replaces the monolithic worker with one explicit execute-collect-judge reducer.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "232aab34786fe20d57a397c2b7e15e02bc66387120df8cdf0b0f723e72f50b2f"
    },
    {
      "id": "buster-quality-gate-replacement-live-function",
      "path": "skills/nova/plugins/buster-quality-gate/tests/live-function.test.ts",
      "targetPackage": "buster-quality-gate",
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "refactor",
        "legacyBehavior": "The quality gate evaluates Buster evidence across every supported failure class and chooses pass, remediation, or terminal block.",
        "replacementBehavior": "The v2 package keeps the complete failure-class matrix in one strict decoder and returns only typed core-owned control results.",
        "rationale": "Nova must adjudicate Buster evidence so Buster cannot approve itself.",
        "complexityImpact": "Centralizes verdict contradictions and removes worker scheduling from the gate.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "db5c9b2824b53e92ab610f7c6bcd702ef4c34b57681d954942ae9956f516be0f"
    },
    {
      "id": "buster-simulator",
      "path": "tests/verification/e2e/buster-simulator.test.mjs",
      "targetPackage": null,
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "refactor",
        "legacyBehavior": "Nova consumes Buster evidence and distinguishes actionable test failure from contract, configuration, infrastructure, rate-limit, and timeout failure.",
        "replacementBehavior": "The v2 quality gate retains the full closed failure-class matrix and maps it to pass, request-fix, or blocked outcomes.",
        "rationale": "Evidence production and quality adjudication remain separate owners.",
        "complexityImpact": "A strict verdict reducer replaces distributed worker/gate conditionals.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "4f5901d0b2f9a70d0aaec88b795ea3be1658c8de04dad1e28edbd8ce242459c9"
    },
    {
      "id": "test-agent-replacement-live-function",
      "path": "skills/buster/plugins/test-agent/tests/live-function.test.ts",
      "targetPackage": "test-agent",
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "rewrite",
        "legacyBehavior": "Buster runs real suites, captures their output, supervises test judgment, and emits an identity-bound terminal verdict and evidence.",
        "replacementBehavior": "The v2 package runs real bounded command suites, passes normalized evidence to runtime.dispatch, validates terminal session/transcript evidence, and writes a durable verdict artifact.",
        "rationale": "This restores execution behavior without embedding subprocess or session authority in the stage.",
        "complexityImpact": "One small state flow replaces the worker's scheduler, polling, and process internals.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "3734e36d5bb1cac4b61b1312339831b47de4e11706161397e613d986f31a0feb"
    }
