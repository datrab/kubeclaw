    {
      "id": "architecture-legacy-contract",
      "path": "tests/skills/nova/pipeline/services/arch-validator.test.mjs",
      "targetPackage": null,
      "disposition": "intentionally-changed",
      "implementationDecision": {
        "strategy": "refactor",
        "legacyBehavior": "The architecture validator combined software-architecture judgment with graph checks, file presence, runtime configuration validation, session spawning, monitoring, retry, and termination.",
        "replacementBehavior": "The stage owns only software-architecture judgment and rich findings; generic graph validity belongs to core, required-file checks belong to deterministic preflight stages, configuration belongs to registry activation, and session lifecycle belongs to runtime.dispatch.",
        "rationale": "Separating generic orchestration and deterministic validation from architecture judgment follows the target ownership model and avoids duplicating core guarantees.",
        "complexityImpact": "Deletes stage-specific lifecycle and bookkeeping machinery while preserving architecture verdicts and structured findings.",
        "behaviorChanged": true,
        "approvalRef": "discord:1531749860674637876"
      },
      "pathDigest": "036a298d27a3d3273b65555c309c94e77a27560e726077debab7e8278c83f107"
    },
    {
      "id": "architecture-validator-replacement-live-function",
      "path": "skills/nova/plugins/architecture-validator/tests",
      "targetPackage": "architecture-validator",
      "disposition": "intentionally-changed",
      "implementationDecision": {
        "strategy": "refactor",
        "legacyBehavior": "Architecture judgment returned scoped findings and blocked on blocking or error severity while its service also owned generic runtime lifecycle work.",
        "replacementBehavior": "The v2 package validates closed domain-model and integration-boundary findings and delegates all generic session lifecycle to the runtime capability.",
        "rationale": "This keeps domain judgment package-local and moves reusable runtime behavior to its proper privileged adapter.",
        "complexityImpact": "Reduces the stage to prompt, strict decoding, artifact evidence, and a typed result.",
        "behaviorChanged": true,
        "approvalRef": "discord:1531749860674637876"
      },
      "pathDigest": "61719832ee3396f3cb58e82573726a72715b0dcbc8ab2eb9ddb5233203f29527"
    },
    {
      "id": "delivery-lint-replacement",
      "path": "skills/nova/plugins/delivery-lint/tests/live-function.test.ts",
      "targetPackage": "delivery-lint",
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "reuse",
        "legacyBehavior": "Delivery lint validates Dockerfile/static delivery declarations and returns pass, remediation, or blocked outcomes with stable reports.",
        "replacementBehavior": "The authoritative v2 delivery-lint package retains those outcomes, reason codes, repository reads, and report artifacts.",
        "rationale": "Phase 8 already proved the direct deterministic implementation and deleted the legacy owner.",
        "complexityImpact": "Keeps one small implementation and no compatibility facade.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "6859a533c5343b5b51727e190f3c1eecec11498414a0258a62a2bb7e1d929acf"
    },
    {
      "id": "lint-replacement-live-function",
      "path": "skills/nova/plugins/lint/tests/live-function.test.ts",
      "targetPackage": "lint",
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "reuse",
        "legacyBehavior": "Pre-check and full lint discover applicable tools, execute the policy tier, normalize findings, and emit deterministic reports.",
        "replacementBehavior": "The v2 lint package retains the proven data-driven engine behind separate pre-check and full registrations plus a bounded executor adapter.",
        "rationale": "The engine complexity reflects supported tools and policies; rewriting it would add parity risk without reducing the small v2 orchestration boundary.",
        "complexityImpact": "Removes legacy process orchestration while reusing the mature tool engine and stable fingerprints.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "75cec1202c7fbb54b752585c695d8d283632b7f03d1e5b6184f9f75127bcbe4f"
