      "id": "prompt-buster-legacy-contract",
      "path": "tests/skills/nova/pipeline/prompts/buster-prompts.test.mjs",
      "targetPackage": null,
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "refactor",
        "legacyBehavior": "Buster prompts bind suite instructions, workspace rules, output schema, and completion ordering.",
        "replacementBehavior": "Test-agent and quality-gate own their equivalent execution and verdict protocols while shared serialization is data-only.",
        "rationale": "Testing policy belongs to the Buster extensions rather than global prompt infrastructure.",
        "complexityImpact": "Separates execution policy from generic safe serialization.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "2eb4cd26befec4f3b074eb95eaf551108530dc9a5f381732013d2427c874b873"
    },
    {
      "id": "prompt-contract-replacement-live-function",
      "path": "skills/common/plugins/prompt-contract/tests/live-function.test.ts",
      "targetPackage": "prompt-contract",
      "disposition": "intentionally-changed",
      "implementationDecision": {
        "strategy": "rewrite",
        "legacyBehavior": "One shared module assembled role-specific prose, filesystem paths, shell commands, completion artifacts, and compatibility shims and performed artifact-context writes while building prompts.",
        "replacementBehavior": "A dependency-only library creates versioned deterministic data envelopes, rejects unsafe or lossy JSON values, enforces size/depth/entry limits, and owns no domain instructions or effects.",
        "rationale": "Shared prompt infrastructure should standardize safe data and response boundaries, while each stage package owns its domain language and completion semantics.",
        "complexityImpact": "Deletes global role coupling and prompt-time filesystem effects instead of porting the large helper surface.",
        "behaviorChanged": true,
        "approvalRef": "discord:1531749860674637876"
      },
      "pathDigest": "cde70008a8c0a25ee5de01cabdd9b78f9b2fcf368f5217beb4ba9e63992d8db4"
    },
    {
      "id": "prompt-forge-legacy-contract",
      "path": "tests/skills/nova/pipeline/prompts/forge-prompts.test.mjs",
      "targetPackage": null,
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "refactor",
        "legacyBehavior": "Forge prompts bind task identity, Git context, completion evidence, and exact output instructions.",
        "replacementBehavior": "Implementation-agent owns the equivalent domain protocol and terminal session/evidence contract while shared serialization is data-only.",
        "rationale": "Domain prompt behavior remains with the implementation extension instead of a global helper.",
        "complexityImpact": "Moves policy to one owner and removes compatibility shims.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "ed60f437c8069aa754ada937d5c55e3710adfa9ced1092bffffbbe331dc5bd15"
    }
