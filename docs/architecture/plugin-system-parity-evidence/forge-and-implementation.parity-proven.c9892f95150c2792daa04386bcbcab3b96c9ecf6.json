  "scenarios": [
    {
      "id": "blueprint-sync-replacement-live-function",
      "path": "skills/nova/plugins/blueprint-sync/tests/live-function.test.ts",
      "targetPackage": "blueprint-sync",
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "refactor",
        "legacyBehavior": "Blueprint synchronization copies declared control files from the architecture branch, commits changed paths, records state, and reports missing controls for remediation.",
        "replacementBehavior": "The v2 stage preserves the sequence through durable Git, state, and artifact effects and returns a typed remediation result for missing controls.",
        "rationale": "The stage retains domain sequencing while adapters own every privileged mutation.",
        "complexityImpact": "Removes direct Git and filesystem process orchestration.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "efbe670345e63d01440be724051185a8b3fd7601034ffa996ecf7ee29b53884b"
    },
    {
      "id": "forge-agent-tests",
      "path": "tests/skills/nova/pipeline/agents",
      "targetPackage": null,
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "rewrite",
        "legacyBehavior": "Forge starts and monitors implementation sessions, verifies identity and completion, captures handoff and transcript evidence, terminates sessions, and classifies retryable versus terminal failures.",
        "replacementBehavior": "The implementation stage requires a closed runtime-owned session record with identity, timestamps, transcript digest, handoffs, termination, changed paths, and checks; core owns retries and lifecycle transitions.",
        "rationale": "A strict session result removes polling and scheduler coupling from Forge while preserving observable completion evidence.",
        "complexityImpact": "Replaces distributed polling state with one bounded runtime capability and one strict reducer.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "9ca0fe822a3732b840405167c9178e65f17c1044858cda47de0f1b2c705f2e8d"
    },
    {
      "id": "implementation-agent-replacement-live-function",
      "path": "skills/nova/plugins/implementation-agent/tests/live-function.test.ts",
      "targetPackage": "implementation-agent",
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "rewrite",
        "legacyBehavior": "Forge executes an implementation task in a tracked session and only hands off code with verified checks and transcript evidence.",
        "replacementBehavior": "The v2 package delegates session execution to runtime.dispatch and rejects completion without a terminal session, transcript digest, matching attempt identity, changed paths, and passing checks.",
        "rationale": "Session mechanics are generic runtime authority; implementation policy and completion evidence remain package authority.",
        "complexityImpact": "Keeps the stage as a strict request/result boundary instead of copying the legacy session supervisor.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "e10d2ac962a5512c15c532f9325ce4e1d52fd22fccd480c3fc751cb6a91a6a27"
    },
    {
      "id": "repository-adapter-replacement-live-function",
      "path": "skills/nova/plugins/repository-adapter/tests/live-function.test.ts",
      "targetPackage": "repository-adapter",
      "disposition": "must-remain-equivalent",
      "implementationDecision": {
        "strategy": "reuse",
        "legacyBehavior": "Forge reads bounded repository text while rejecting missing, non-file, oversized, traversal, and symlink-escape paths.",
        "replacementBehavior": "The v2 repository adapter preserves those read-only outcomes behind one narrowly granted capability.",
        "rationale": "The direct read-only adapter is already the smallest safe boundary.",
        "complexityImpact": "Removes all Git mutation and agent lifecycle authority from repository reads.",
        "behaviorChanged": false,
        "approvalRef": null
      },
      "pathDigest": "310b31c0b266e144e0ceeb857461fcf6f74d51b7336dad11d02313a5a9c66f7a"
    }
  ],
