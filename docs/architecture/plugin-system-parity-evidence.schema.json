{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubeclaw.dev/contracts/plugin-system/parity-evidence-v2.schema.json",
  "title": "Plugin migration parity evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "unitId",
    "status",
    "commit",
    "recordedAt",
    "previousEvidenceDigest",
    "sourceFiles",
    "sourceDigest",
    "targetFiles",
    "targetDigest",
    "bundleDigests",
    "scenarios",
    "scenarioDispositionDigest",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": "plugin-system-parity-evidence-v2" },
    "unitId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "status": { "enum": ["implementation-in-progress", "parity-proven", "cutover-complete"] },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "previousEvidenceDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "sourceFiles": { "$ref": "#/$defs/files" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "targetFiles": { "$ref": "#/$defs/files" },
    "targetDigest": { "$ref": "#/$defs/digest" },
    "bundleDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nova", "buster"],
      "properties": {
        "nova": { "$ref": "#/$defs/digest" },
        "buster": { "$ref": "#/$defs/digest" }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "targetPackage",
          "disposition",
          "implementationDecision",
          "pathDigest"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "targetPackage": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "disposition": {
            "enum": [
              "must-remain-equivalent",
              "intentionally-changed",
              "approved-obsolete",
              "new-v2-foundation"
            ]
          },
          "implementationDecision": { "$ref": "#/$defs/implementationDecision" },
          "pathDigest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "scenarioDispositionDigest": { "$ref": "#/$defs/digest" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "command", "exitCode", "outputPath", "outputDigest"],
        "properties": {
          "gateId": { "type": "string" },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "const": 0 },
          "outputPath": { "type": "string", "pattern": "^docs/architecture/plugin-system-parity-evidence/outputs/" },
          "outputDigest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "implementationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "legacyBehavior",
        "replacementBehavior",
        "rationale",
        "complexityImpact",
        "behaviorChanged",
        "approvalRef"
      ],
      "properties": {
        "strategy": { "enum": ["reuse", "refactor", "rewrite"] },
        "legacyBehavior": { "type": "string", "minLength": 1 },
        "replacementBehavior": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "complexityImpact": { "type": "string", "minLength": 1 },
        "behaviorChanged": { "type": "boolean" },
        "approvalRef": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  }
}
