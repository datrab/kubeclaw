{
  "schemaVersion": "plugin-system-inventory-rules-v1",
  "classificationMode": "ordered-first-match",
  "scan": {
    "roots": [
      "skills/nova/pipeline",
      "skills/nova/plugins",
      "skills/buster",
      "skills/common/pipeline",
      "skills/common/plugin-runtime",
      "skills/common/plugins",
      "tests/skills/nova/pipeline",
      "tests/skills/buster",
      "tests/skills/common/pipeline",
      "contracts/agent-observability",
      "contracts/telemetry"
    ],
    "files": [
      "charts/kubeclaw/files/config/swarm.config.json",
      "docs/ROADMAP.md",
      "docs/architecture/plugin-system-vision.md",
      "docs/architecture/plugin-system-implementation-plan.md",
      "docs/architecture/plugin-system-migration-units.json",
      "docs/architecture/plugin-system-parity-evidence.schema.json",
      "docs/concepts/extensibility-model.md",
      "docs/developers/hooks-and-plugins.md",
      "docs/developers/adding-gates.md",
      "docs/developers/adding-observability-sinks.md",
      "docs/developers/adding-pipeline-features.md",
      "docs/pipeline/configuration.md",
      "docs/pipeline/modules-and-gates.md",
      "docs/reference/swarm-config.md",
      "tests/verification/contracts/check-gate-control-result-surface.mjs",
      "tests/verification/contracts/check-generator-result-surface.mjs",
      "tests/verification/contracts/check-module-runner-slice-surface.mjs",
      "tests/verification/contracts/check-openclaw-agent-observer-plugin.mjs",
      "tests/verification/contracts/check-pipeline-runner-slice-surface.mjs",
      "tests/verification/contracts/check-validator-control-result-surface.mjs",
      "tests/verification/contracts/check-worker-control-result-surface.mjs",
      "scripts/check-plugin-system-migration-units.mjs",
      "scripts/record-plugin-parity-evidence.mjs",
      "scripts/verify-plugin-migration-baseline.mjs",
      "scripts/verify-all-skill-tests.mjs"
    ],
    "excludeSuffixes": [
      ".map",
      ".pyc"
    ],
    "excludePaths": [
      "skills/common/plugin-runtime/core/isolation/plugin-sandbox"
    ],
    "excludeSegments": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "classificationRules": [
    {
      "id": "v2-plugin-runtime-sdk-and-contracts",
      "prefixes": [
        "skills/common/plugin-runtime/sdk/",
        "skills/common/plugin-runtime/contracts/"
