      "target": {"kind": "plugin-sdk", "id": "pipeline-plugin-sdk"}
    },
    {
      "id": "v2-plugin-runtime-registry",
      "prefixes": ["skills/common/plugin-runtime/core/registry/"],
      "target": {"kind": "core", "id": "pipeline-core-registry"}
    },
    {
      "id": "v2-plugin-runtime-state",
