    },
    {
      "id": "delete-telemetry-registry-contract",
      "includesAny": ["telemetry-sink-contract", "telemetry-sink-constants", "telemetry-sink-validation"],
      "target": {"kind": "delete", "id": "legacy-telemetry-registry-contract"}
    },
    {
      "id": "observer-telemetry",
      "includesAny": ["telemetry-stream", "/telemetry/sinks"],
      "target": {"kind": "plugin", "id": "kubeclaw.telemetry-observers"}
    },
    {
      "id": "core-telemetry-spine",
      "includesAny": ["telemetry", "run-facts", "evidence-manifest", "notification-dispatch"],
      "target": {"kind": "core", "id": "pipeline-core-telemetry"}
    },
    {
      "id": "adapter-git",
      "includesAny": ["git-worktree", "git-primitives", "git-workflow", "git-sync", "git-identity", "git-push"],
      "target": {"kind": "adapter", "id": "kubeclaw.git"}
    },
    {
      "id": "adapter-redis",
      "includesAny": ["redis-", "redis.", "/redis", "task-queue", "task-transport"],
      "target": {"kind": "adapter", "id": "kubeclaw.redis"}
    },
    {
      "id": "adapter-runtime-dispatch",
      "includesAny": [
        "acp-",
        "/agents/",
        "/integrations/gateway",
        "gateway-invoke",
        "openclaw-plugin-runtime",
        "runtime-policy",
        "session-monitor"
      ],
      "target": {"kind": "adapter", "id": "kubeclaw.runtime-dispatch"}
    },
    {
      "id": "adapter-artifacts",
      "includesAny": ["agent-artifact", "artifact-", "portable-artifacts", "quality-artifacts"],
      "target": {"kind": "adapter", "id": "kubeclaw.artifacts"}
    },
    {
      "id": "adapter-operator",
      "includesAny": ["discord", "operator"],
      "target": {"kind": "adapter", "id": "kubeclaw.operator-messaging"}
    },
    {
      "id": "adapter-command",
      "includesAny": ["command-runtime", "command-lifecycle", "command-validation"],
      "target": {"kind": "adapter", "id": "kubeclaw.command"}
    },
    {
      "id": "delete-concrete-orchestrator-runners",
