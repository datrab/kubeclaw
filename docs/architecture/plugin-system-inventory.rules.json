      "id": "plugin-blueprint-sync",
      "includesAny": ["/services/blueprint", "blueprint-control-sync"],
      "target": {"kind": "plugin", "id": "kubeclaw.blueprint-sync"}
    },
    {
      "id": "shared-prompt-primitives",
      "includesAny": ["/prompts/shared"],
