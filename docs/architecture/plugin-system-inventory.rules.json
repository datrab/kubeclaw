        "/runners/gate-runner",
        "/runners/module-runner",
        "/runners/gate-forge-fix",
        "/runners/remediable-gate-engine",
        "/runners/waitable-gate-engine",
        "/runners/scheduled-gate-invocation"
      ],
      "target": {"kind": "delete", "id": "legacy-kind-schedulers"}
    },
    {
      "id": "plugin-sdk-contracts",
      "includesAny": [
        "/services/contracts/",
        "plugin-context",
        "/core/context",
        "operation-result",
        "value-boundary",
        "pipeline-event-contract",
        "rate-limit-contract",
        "redis-message-contract",
        "task-transport-contract",
        "discord-fields-contract"
      ],
      "target": {"kind": "plugin-sdk", "id": "pipeline-plugin-sdk"}
    },
    {
      "id": "core-state",
      "includesAny": [
        "status-store",
        "lifecycle",
        "completion-identity",
        "completion-adjudicator",
        "pipeline-checkpoint",
        "session-authority",
        "file-lock",
        "correlation",
        "serialization"
      ],
      "target": {"kind": "core", "id": "pipeline-core-state"}
    },
    {
      "id": "core-execution",
      "includesAny": [
        "/scheduler",
        "pipeline-runner",
        "/core/",
        "/cli",
        "/index.ts",
        "failure-semantics",
        "/failures/",
        "rate-limit",
        "polling",
        "remediation-handoff",
        "dependencies",
        "runtime-defaults",
        "run-discovery",
        "runtime-environment",
        "runtime-state-paths",
        "security",
        "timing"
      ],
      "target": {"kind": "core", "id": "pipeline-core-execution"}
    },
    {
      "id": "shared-pipeline-primitives",
      "prefixes": ["skills/common/pipeline/", "contracts/"],
      "target": {"kind": "shared-library", "id": "kubeclaw.pipeline-primitives"}
    },
    {
      "id": "verification-core",
      "prefixes": [
        "tests/",
        "scripts/check-plugin-system-migration-units.mjs",
        "scripts/record-plugin-parity-evidence.mjs",
        "scripts/verify-plugin-migration-baseline.mjs",
        "scripts/verify-all-skill-tests.mjs"
      ],
      "target": {"kind": "core", "id": "pipeline-core-verification"}
    },
    {
      "id": "documentation",
      "prefixes": ["docs/"],
      "target": {"kind": "shared-library", "id": "plugin-system-documentation"}
    },
    {
      "id": "platform-config",
      "prefixes": ["charts/"],
      "target": {"kind": "core", "id": "pipeline-core-config"}
    },
    {
      "id": "nova-core-fallback",
      "prefixes": ["skills/nova/pipeline/"],
      "target": {"kind": "core", "id": "pipeline-core-execution"}
    }
  ],
  "effectMatchers": [
    {"id": "filesystem.read", "adapter": "kubeclaw.artifacts", "pattern": "\\b(?:readFile|readFileSync|readdir|readdirSync|stat|statSync|existsSync)\\s*\\("},
    {"id": "filesystem.write", "adapter": "kubeclaw.artifacts", "pattern": "\\b(?:writeFile|writeFileSync|appendFile|appendFileSync|rename|renameSync|mkdir|mkdirSync|unlink|unlinkSync|rm|rmSync)\\s*\\("},
    {"id": "git.execute", "adapter": "kubeclaw.git", "pattern": "(?:['\\\"]git['\\\"]|\\bgit\\s+(?:status|diff|show|rev-parse|worktree|commit|push|merge|checkout|fetch)\\b)"},
    {"id": "redis.execute", "adapter": "kubeclaw.redis", "pattern": "\\b(?:xadd|xread|xreadgroup|xack|publish|subscribe|createClient|redisCommand|execRedis)\\b"},
    {"id": "runtime.dispatch", "adapter": "kubeclaw.runtime-dispatch", "pattern": "\\b(?:sessions_spawn|spawnSession|dispatchWorker|invokeGateway|gatewayInvoke|acp\\.spawn|acp\\.send)\\b"},
    {"id": "network.http", "adapter": "kubeclaw.network", "pattern": "\\b(?:fetch|https?\\.request|requestHttp)\\s*\\("},
    {"id": "secret.read", "adapter": "kubeclaw.secrets", "pattern": "\\bprocess\\.env(?:\\.|\\[)"},
    {"id": "command.execute", "adapter": "kubeclaw.command", "pattern": "\\b(?:exec|execFile|execSync|execFileSync|spawn|spawnSync)\\s*\\("},
    {"id": "operator.notify", "adapter": "kubeclaw.operator-messaging", "pattern": "\\b(?:sendDiscord|sendWebhook|notifyOperator|postDiscord|discordWebhook)\\b"},
    {"id": "telemetry.emit", "adapter": "kubeclaw.telemetry-transport", "pattern": "\\b(?:emitTelemetry|publishTelemetry|telemetry\\.emit|writeTelemetry)\\b"}
  ],
  "targetAdapters": [
    {"id": "kubeclaw.artifacts", "capabilities": ["artifacts.read", "artifacts.write"]},
    {"id": "kubeclaw.git", "capabilities": ["git.repository.read", "git.workspace.create", "git.commit", "git.merge"]},
    {"id": "kubeclaw.redis", "capabilities": ["transport.redis"]},
    {"id": "kubeclaw.runtime-dispatch", "capabilities": ["runtime.dispatch"]},
    {"id": "kubeclaw.network", "capabilities": ["network.http"]},
    {"id": "kubeclaw.secrets", "capabilities": ["secrets.read"]},
    {"id": "kubeclaw.command", "capabilities": ["command.execute"]},
    {"id": "kubeclaw.operator-messaging", "capabilities": ["operator.request", "transport.publish"]},
    {"id": "kubeclaw.telemetry-transport", "capabilities": ["transport.publish"]}
  ],
  "legacyContractMatchers": [
    {"id": "result.needs_nova", "pattern": "\\bneeds_nova\\b"},
    {"id": "result.action_required", "pattern": "\\baction_required\\b"},
    {"id": "manifest.package-capabilities", "pattern": "\\bcapabilities\\s*:\\s*\\["},
    {"id": "manifest.kind", "pattern": "\\bkind\\s*:\\s*['\\\"](?:worker|gate|validator|generator|notification|telemetry)['\\\"]"},
    {"id": "manifest.hook-family", "pattern": "\\bhookFamily\\s*:\\s*['\\\"]"},
    {"id": "manifest.contract-v1", "pattern": "pipeline-plugin-v1"}
  ],
  "hardcodingMatchers": [
    {"id": "stage.worker-forge", "pattern": "worker:module_forge"},
    {"id": "stage.worker-buster", "pattern": "worker:module_buster"},
    {"id": "stage.gate-review", "pattern": "gate:review"},
    {"id": "stage.gate-approval", "pattern": "gate:approval"},
    {"id": "stage.gate-buster", "pattern": "gate:buster"},
    {"id": "stage.validator", "pattern": "validator:(?:architecture|delivery_lint|pre_check|full_lint)"},
    {"id": "stage.generator", "pattern": "generator:(?:project_summary|pipeline_review|case_study)"},
    {"id": "kind.branch", "pattern": "(?:plugin|manifest|producer)\\.?kind\\s*===?\\s*['\\\"](?:worker|gate|validator|generator|notification|telemetry)['\\\"]"}
  ],
