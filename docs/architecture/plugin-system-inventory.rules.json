      "target": {"kind": "core", "id": "pipeline-core-telemetry"}
    },
    {
      "id": "v2-plugin-runtime-config",
      "prefixes": ["skills/common/plugin-runtime/core/config/"],
      "target": {"kind": "core", "id": "pipeline-core-config"}
    },
    {
