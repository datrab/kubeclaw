{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "eventId"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    }
  }
}
