{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "buildctl",
    "cc",
    "eslint",
    "gofmt",
    "go",
    "openssl",
    "mkfifo",
    "helm",
    "kubeconform",
    "kubectl",
    "tsc",
    "which"
  ],
  "ignore": [
    "**/dist/**",
    "**/generated/**",
    "**/node_modules/**",
    "Projects/**",
    "contracts/telemetry/v1/{bundle-types,telemetry-types}.ts"
  ],
  "ignoreDependencies": [
    "@axe-core/playwright",
    "@types/node",
    "file",
    "ioredis",
    "js-yaml",
    "openclaw",
    "pixelmatch",
    "playwright",
    "pg",
    "pngjs",
    "ws"
  ],
