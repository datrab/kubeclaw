      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "react-dom",
        "@types/react-dom"
      ]
    },
    "tools/ops-mcp": {
      "entry": [
        "src/server.mjs",
        "test/*.test.mjs"
      ],
      "project": [
        "src/**/*.mjs",
        "test/**/*.mjs"
      ]
    }
  }
}
