{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "plugins/openclaw-agent-observer/src/index.ts",
    "scripts/**/*.mjs",
    "skills/buster/pipeline/buster-pipeline.ts",
    "skills/nova/pipeline/pipeline.ts",
    "skills/nova/pipeline/tools/lint-report.ts",
    "skills/nova/project_setup/**/*.ts",
    "tests/**/*.mjs"
  ],
  "project": [
    "plugins/openclaw-agent-observer/src/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,cjs}",
    "skills/{buster,common,nova}/**/*.{js,jsx,ts,tsx,mjs,cjs}",
    "tests/**/*.{js,mjs,cjs,ts}"
  ],
  "ignore": [
    "**/dist/**",
    "**/generated/**",
    "**/node_modules/**"
  ],
  "ignoreDependencies": [
    "@types/node"
  ]
}
