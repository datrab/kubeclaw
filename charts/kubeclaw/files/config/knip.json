{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "skills/common/plugins/openclaw-agent-observer/src/index.ts",
    "contracts/agent-observability/v1/src/{mapping,validation}.ts*",
    "skills/common/plugins/openclaw-agent-observer/src/redis-transport.ts",
    "scripts/**/*.mjs",
    "skills/common/discord-purge.ts",
    "skills/common/plugin-runtime/cli.ts",
    "skills/common/plugin-runtime/core/src/index.ts",
    "skills/{common,nova,buster}/plugins/*/src/**/*.ts",
    "skills/nova/pipeline.ts",
    "skills/nova/project_setup/**/*.ts",
    "tests/**/*.{mjs,mts,ts}"
  ],
  "project": [
    "skills/common/plugins/openclaw-agent-observer/src/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,cjs}",
    "skills/{buster,common,nova}/**/*.{js,jsx,ts,tsx,mjs,cjs}",
    "tests/**/*.{js,mjs,mts,cjs,ts}"
  ],
  "ignore": [
    "**/dist/**",
    "**/generated/**",
    "**/node_modules/**"
  ],
  "ignoreDependencies": [
    "@axe-core/playwright",
    "@types/node",
    "file",
    "ioredis",
    "js-yaml",
    "openclaw",
    "pixelmatch",
    "playwright",
    "pngjs",
    "ws"
  ]
}
