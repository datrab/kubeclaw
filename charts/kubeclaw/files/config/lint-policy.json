    "rules": [
      {
        "tool": "eslint",
        "code": "complexity",
        "principle": "Keep decision paths small and obvious.",
        "remediation": "Extract cohesive decisions without moving branches mechanically.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "gocyclo",
        "code": "go-complexity",
        "principle": "Keep decision paths small and obvious.",
        "remediation": "Extract cohesive Go decisions without moving branches mechanically.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "max-depth",
        "principle": "Keep control flow shallow.",
        "remediation": "Use guard clauses or extract one coherent operation.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "max-params",
        "principle": "Keep interfaces explicit and cohesive.",
        "remediation": "Replace parameter bundles with one typed request object.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "max-lines-per-function",
        "principle": "Keep functions focused on one responsibility.",
        "remediation": "Split complete responsibilities, not arbitrary line ranges.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "max-lines",
        "principle": "Keep files cohesive and narrow.",
        "remediation": "Move a complete concern behind an explicit interface.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "discipline/no-direct-env-access",
        "principle": "Read infrastructure environment only at declared boundaries.",
        "remediation": "Parse and validate environment input in an approved adapter.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "discipline/no-env-default",
        "principle": "Keep application settings in canonical configuration.",
        "remediation": "Require validated configuration instead of a hardcoded environment fallback.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "discipline/no-fallback-chain",
        "principle": "Use one explicit authority path.",
        "remediation": "Remove compatibility and guessed candidates, leaving one explicit fallback at most.",
        "historical_changed_sets": 3,
        "false_positives": 47,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "discipline/no-dynamic-module-loading",
        "principle": "Keep dependencies explicit.",
        "remediation": "Use a static import or a centrally declared loader boundary.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "discipline/no-top-level-mutable-state",
        "principle": "Avoid invisible shared state.",
        "remediation": "Move mutable state into an explicit lifecycle owner.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "discipline/no-swallowed-error",
        "principle": "Handle errors intentionally.",
        "remediation": "Return a typed failure or rethrow with context.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "discipline/filename-case",
        "principle": "Use predictable naming.",
        "remediation": "Rename source files to lowercase kebab-case and update imports.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      },
      {
        "tool": "eslint",
        "code": "no-console",
        "principle": "Use structured logging.",
        "remediation": "Use the canonical logger with level and context.",
        "historical_changed_sets": 3,
        "false_positives": 0,
        "approved_by": "pipeline-maintainers",
        "approved_on": "2026-07-20"
      }
    ]
  },
