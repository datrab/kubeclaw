{
  "schema_version": "pipeline_lint_policy.v6",
  "baseline_path": "lint-baseline.json",
  "experimental_tools": [],
  "projects": [
    {
      "id": "workspace",
      "root": ".",
      "discovery_max_depth": 20,
      "languages": [
        "javascript",
        "typescript",
        "shell",
        "docker",
        "helm",
        "yaml",
        "go"
      ],
      "language_evidence": {
        "javascript": [
          "package.json"
        ],
        "typescript": [
          "skills/nova/tsconfig.json"
        ],
        "shell": [
          "scripts/*.sh"
        ],
        "docker": [
          "docker/Dockerfile.general"
        ],
        "helm": [
          "charts/kubeclaw/Chart.yaml"
        ],
        "yaml": [
          "charts/kubeclaw/values.yaml"
        ],
        "go": [
          "go.mod"
        ]
      },
      "go": {
        "modules": [
          {
            "mod_file": "go.mod",
            "packages": [
              "./cmd/buster-namespace-controller/..."
            ],
            "build_tags": [],
            "allowed_import_prefixes": [
              "github.com/datrab/kubeclaw"
            ]
          }
        ]
      },
      "terraform": {
        "roots": [],
        "provider_mirror": "/opt/terraform-provider-mirror"
      }
    }
  ],
  "global_exclusions": [
    ".git/**",
    ".swarm/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/vendor/**",
    "**/generated/**"
  ],
  "architecture": {
    "layers": [
      {
        "id": "plugin-runtime",
        "roots": [
          "skills/common/plugin-runtime"
        ],
        "may_depend_on": [
          "plugin-runtime"
        ]
      },
      {
        "id": "plugins",
        "roots": [
          "skills/common/plugins",
          "skills/nova/plugins",
          "skills/buster/plugins"
        ],
        "may_depend_on": [
          "plugin-runtime",
          "plugins"
        ]
      }
    ]
  },
  "rule_admission": {
    "historical_commits": [
      "c33020319b13ac0054622812eb454a828b0d5f74",
