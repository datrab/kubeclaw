{
  "_doc": "Platform-level config. Loaded from SWARM_CONFIG env or /app/config/swarm.config.json. Project/repo_root/paths are derived by loadConfig — do NOT set them here.",

  "discord_webhook_url": "",
  "discord_alerts": {
    "info": true,
    "warn": true,
    "critical": true,
    "ok": true
  },

  "poll_interval_seconds": 30,
  "default_timeout_minutes": 45,
  "default_max_fails": 3,
  "auto_retry_threshold": 2,
  "session_nudge_threshold": 0.75,

  "rate_limit": {
    "cooldown_hours": 2,
    "max_pauses_per_module": 5
  },

  "pre_check": {
    "enabled": true,
    "lint_report_path": "/app/skills/lint-report.js",
    "semgrep_config_path": "/home/node/.openclaw/.semgrep.yml",
    "timeout_seconds": 30
  },

  "memory": {
    "enabled": true,
    "memory_js_path": "/app/skills/memory.js",
    "recall_limit": 5,
    "recall_before_forge": true,
    "feedback_after_outcome": true,
    "store_patterns_globally": true,
    "targeted_decay_amount": 0.1
  },

  "agents": {
    "forge": {
      "dispatch": "acp",
      "acp_agent_id": "codex",
      "cwd": null
    },
    "buster": {},
    "echo": {
      "dispatch": "acp",
      "acp_agent_id": "claude",
      "cwd": null
    }
  },

  "models": {
    "forge": "codex-5.4",
    "buster": "claude-sonnet-4-6",
    "echo": "claude-opus-4-6"
  },

  "review_defaults": {
    "reviewers": [
      { "label": "echo-opus", "agent_id": "claude" }
    ],
    "timeout_minutes": 30,
    "max_fix_cycles": 3,
    "lint_tier": "full"
  }
}
