{
  "_doc": "Platform-level config. Loaded from SWARM_CONFIG env or /app/config/swarm.config.json. Project/repo_root/paths are derived by loadConfig — do NOT set them here.",

  "discord_webhook_url": "",
  "discord_alerts": {
    "info": true,
    "warn": true,
    "critical": true,
    "ok": true
  },

  "poll_interval_seconds": 30,
  "default_timeout_minutes": 300,
  "default_max_fails": 8,
  "auto_retry_threshold": 7,
  "session_nudge_threshold": 0.75,

  "rate_limit": {
    "cooldown_hours": 2,
    "max_pauses_per_module": 5
  },

  "acp_monitor": {
    "unknown_poll_limit": 10,
    "stale_poll_limit": 10
  },

  "pre_check": {
    "enabled": true,
    "lint_report_path": "/app/skills/lint-report.js",
    "semgrep_config_path": "/home/node/.openclaw/.semgrep.yml",
    "timeout_seconds": 60
  },

  "agents": {
    "forge": {
      "dispatch": "subagent",
      "acp_agent_id": "codex",
      "cwd": null
    },
    "buster": {},
    "echo": {
      "dispatch": "subagent",
      "acp_agent_id": "codex",
      "cwd": null
    }
  },

  "models": {
    "forge": "codex-5.4",
    "buster": "codex-5.4",
    "echo": "codex-5.4"
  },

  "review_defaults": {
    "reviewers": [
      { "label": "codex-5.4", "agent_id": "codex" }
    ],
    "timeout_minutes": 30,
    "max_fix_cycles": 3,
    "lint_tier": "full"
  }
}
