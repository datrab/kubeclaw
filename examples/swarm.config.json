{
  "_doc": "OpenClaw Swarm — Platform Config. Location: /app/config/swarm.config.json. Shared across ALL projects.",

  "discord_webhook_url": "",
  "discord_alerts": {
    "info": true,
    "warn": true,
    "critical": true,
    "ok": true
  },

  "poll_interval_seconds": 30,
  "default_timeout_minutes": 45,
  "default_max_fails": 3,
  "auto_retry_threshold": 2,

  "rate_limit": {
    "cooldown_hours": 2,
    "max_pauses_per_module": 5
  },

  "memory": {
    "enabled": true,
    "memory_js_path": "/app/skills/memory.js",
    "recall_limit": 5,
    "recall_before_forge": true,
    "feedback_after_outcome": true
  },

  "agents": {
    "_doc": "Dispatch infrastructure — HOW agents are spawned. Models are per-module/gate in progress.json.",
    "forge": {
      "dispatch": "acp",
      "acp_agent_id": "codex",
      "cwd": null
    },
    "buster": {
      "dispatch": "redis",
      "redis_stream": "swarm:buster:tasks",
      "redis_js_path": "/app/skills/redis.js"
    },
    "echo": {
      "dispatch": "acp",
      "acp_agent_id": "claude",
      "cwd": null
    }
  },

  "models": {
    "_doc": "Fallback models. Forge always uses forge_model from progress.json.",
    "buster": "claude-sonnet-4-6"
  },

  "review_defaults": {
    "_doc": "Defaults for type:review gates. Gates in progress.json can override any field.",
    "reviewers": [
      { "label": "echo-codex",  "agent_id": "codex",  "model": "codex-5.3" },
      { "label": "echo-sonnet", "agent_id": "claude", "model": "claude-sonnet-4-6" },
      { "label": "echo-pro",    "agent_id": "gemini", "model": "gemini-pro" }
    ],
    "merge_script": "echo-reviews/merge-reviews.js",
    "timeout_minutes": 30,
    "max_fix_cycles": 3
  }
}
