        "api": {
          "spec_file": ".swarm/modules/01-project-scaffold-auth-database/test-spec.json"
        },
        "unit": {
          "test_cmd": "pip install -r backend/requirements.txt -r backend/dev-requirements.txt -q && KUBECOMMAND_API_KEY=test_api_key_for_buster_minimum_32_chars IN_CLUSTER=false python -m pytest backend/tests/ -v --tb=short"
