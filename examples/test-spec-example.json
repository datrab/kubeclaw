{
  "schemaVersion": "kubeclaw.api-flow.v1",
  "variables": { "testUser": "admin" },
  "setup": [
    {
      "id": "login",
      "method": "POST",
      "path": "/api/auth/login",
      "headers": { "content-type": "application/json" },
      "body": { "username": "{{testUser}}" },
      "expect": { "status": 200, "contentType": "application/json" },
      "extract": { "token": "token" }
    }
  ],
  "steps": [
    {
      "id": "health",
      "path": "/api/health",
      "expect": { "status": 200, "json": { "status": "ok" } }
    },
    {
      "id": "pods",
      "path": "/api/pods",
      "headers": { "authorization": "Bearer {{token}}" },
      "expect": { "status": 200, "contentType": "application/json" }
    },
    {
      "id": "events",
      "protocol": "websocket",
      "path": "/api/ws/events",
      "headers": { "authorization": "Bearer {{token}}" },
      "messages": [{ "type": "subscribe", "resource": "pods" }],
      "expect": { "minimumMessages": 1, "messageContains": "subscribed" }
    }
  ],
  "cleanup": [
    {
      "id": "logout",
      "method": "DELETE",
      "path": "/api/auth/session",
      "headers": { "authorization": "Bearer {{token}}" },
      "expect": { "status": 204 }
    }
  ]
}
