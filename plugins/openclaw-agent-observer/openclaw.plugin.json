{
  "id": "kubeclaw-agent-observer",
  "name": "KubeClaw Agent Observer",
  "description": "Observes OpenClaw agent hooks and writes kubeclaw agent-observability Redis streams.",
  "version": "0.0.0",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "redisHost": { "type": "string" },
      "redisPort": { "type": "number" },
      "redisUsername": { "type": "string" },
      "redisPassword": { "type": "string" },
      "redisTls": { "type": "boolean" },
      "redisNetworkIsolation": { "type": ["boolean", "string"] },
      "maxEventBytes": { "type": "number" },
      "maxQueuePerStream": { "type": "number" },
      "redisCommandTimeoutMs": { "type": "number" },
      "streamMaxLen": { "type": "number" },
      "deadLetterMaxLen": { "type": "number" },
      "controlWriteMaxAttempts": { "type": "number" },
      "controlWriteRetryBaseMs": { "type": "number" },
      "controlWriteRetryMaxMs": { "type": "number" },
      "hookPriority": { "type": "number" },
      "hookTimeoutMs": { "type": "number" }
    }
  },
  "uiHints": {
    "redisPassword": { "label": "Redis password", "sensitive": true }
  }
}
