# =============================================================================
# KubeClaw General — Root Environment for Nova, Forge, Echo
# =============================================================================
ARG OPENCLAW_BASE=ghcr.io/openclaw/openclaw:2026.7.1@sha256:6a31d44b2944e7adcd2b582bf6fb463111264ebca97a0201795b799135bd102c
# hadolint ignore=DL3006
FROM ${OPENCLAW_BASE}

# Root is the declared Nova/Forge/Echo runtime mode.
# hadolint ignore=DL3002
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Anchor Debian packages to the snapshot matching the pinned OpenClaw base.
ARG DEBIAN_SNAPSHOT=20260713T000000Z
RUN printf '%s\n' \
      'Types: deb' \
      "URIs: https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" \
      'Suites: bookworm bookworm-updates' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      '' \
      'Types: deb' \
      "URIs: https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" \
      'Suites: bookworm-security' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot

# System tools. Playwright owns its Chromium binary and installs only the
# corresponding OS libraries below, avoiding a second Debian Chromium copy.
# Package resolution is pinned by DEBIAN_SNAPSHOT rather than per-package
# versions, keeping the complete dependency graph coherent.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      sudo curl git openssh-client jq nano tree net-tools iputils-ping dnsutils ripgrep \
      build-essential python3 python3-pip python3-venv python-is-python3 ffmpeg \
      netcat-openbsd nmap shellcheck yamllint \
    && rm -rf /var/lib/apt/lists/*

# Locked JavaScript runtime and verification tools.
COPY docker/general-tools/package.json docker/general-tools/package-lock.json /opt/kubeclaw-tools/
RUN npm ci --prefix /opt/kubeclaw-tools --ignore-scripts --no-audit --no-fund \
    && npm install -g --no-audit --no-fund ioredis@5.11.1 \
    && mkdir -p /root/.npm

ENV PATH=/opt/kubeclaw-tools/node_modules/.bin:${PATH} \
    NODE_PATH=/opt/kubeclaw-tools/node_modules:/app/node_modules \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NPM_CONFIG_CACHE=/root/.npm

RUN playwright install --with-deps chromium \
    && playwright --version \
    && test -d /ms-playwright

# Exact Python tool versions keep resolver output stable.
ARG RUFF_VERSION=0.15.22
ARG MYPY_VERSION=2.3.0
ARG PIP_AUDIT_VERSION=2.10.1
ARG SEMGREP_VERSION=1.170.0
RUN pip install --break-system-packages --no-cache-dir \
      "ruff==${RUFF_VERSION}" \
      "mypy==${MYPY_VERSION}" \
      "pip-audit==${PIP_AUDIT_VERSION}" \
    && python3 -m venv /opt/semgrep \
    && /opt/semgrep/bin/pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" \
    && ln -s /opt/semgrep/bin/semgrep /usr/local/bin/semgrep \
    && ruff --version \
    && mypy --version \
    && pip-audit --version \
    && semgrep --version

# Pinned, checksum-verified binary tools for amd64 and arm64.
ARG TARGETARCH
ARG K6_VERSION=v0.54.0
ARG HADOLINT_VERSION=2.12.0
ARG KUBECONFORM_VERSION=0.6.4
ARG KUBECTL_VERSION=1.35.6
ARG HELM_VERSION=3.18.4
RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64) hadolint_arch="x86_64" ;; \
      arm64) hadolint_arch="arm64" ;; \
      *) echo "Unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    tmp="$(mktemp -d)"; \
    k6_archive="k6-${K6_VERSION}-linux-${arch}.tar.gz"; \
    curl -fsSL "https://github.com/grafana/k6/releases/download/${K6_VERSION}/${k6_archive}" -o "$tmp/$k6_archive"; \
    curl -fsSL "https://github.com/grafana/k6/releases/download/${K6_VERSION}/k6-${K6_VERSION}-checksums.txt" -o "$tmp/k6-checksums.txt"; \
    k6_sha="$(awk -v file="$k6_archive" '$2 == file { print $1 }' "$tmp/k6-checksums.txt")"; \
    printf '%s  %s\n' "$k6_sha" "$tmp/$k6_archive" | sha256sum -c -; \
    tar -xzf "$tmp/$k6_archive" --strip-components=1 -C /usr/local/bin "k6-${K6_VERSION}-linux-${arch}/k6"; \
    hadolint_file="hadolint-Linux-${hadolint_arch}"; \
    curl -fsSL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/${hadolint_file}" -o "$tmp/$hadolint_file"; \
    curl -fsSL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/${hadolint_file}.sha256" -o "$tmp/${hadolint_file}.sha256"; \
    hadolint_sha="$(awk '{ print $1 }' "$tmp/${hadolint_file}.sha256")"; \
    printf '%s  %s\n' "$hadolint_sha" "$tmp/$hadolint_file" | sha256sum -c -; \
    install -m 0755 "$tmp/$hadolint_file" /usr/local/bin/hadolint; \
    kubeconform_archive="kubeconform-linux-${arch}.tar.gz"; \
    curl -fsSL "https://github.com/yannh/kubeconform/releases/download/v${KUBECONFORM_VERSION}/${kubeconform_archive}" -o "$tmp/$kubeconform_archive"; \
    curl -fsSL "https://github.com/yannh/kubeconform/releases/download/v${KUBECONFORM_VERSION}/CHECKSUMS" -o "$tmp/kubeconform-checksums.txt"; \
    kubeconform_sha="$(awk -v file="$kubeconform_archive" '$2 == file { print $1 }' "$tmp/kubeconform-checksums.txt")"; \
    printf '%s  %s\n' "$kubeconform_sha" "$tmp/$kubeconform_archive" | sha256sum -c -; \
    tar -xzf "$tmp/$kubeconform_archive" -C /usr/local/bin kubeconform; \
    kubectl_file="kubectl-${arch}"; \
    curl -fsSL "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${arch}/kubectl" -o "$tmp/$kubectl_file"; \
    kubectl_sha="$(curl -fsSL "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${arch}/kubectl.sha256")"; \
    printf '%s  %s\n' "$kubectl_sha" "$tmp/$kubectl_file" | sha256sum -c -; \
    install -m 0755 "$tmp/$kubectl_file" /usr/local/bin/kubectl; \
    helm_archive="helm-v${HELM_VERSION}-linux-${arch}.tar.gz"; \
    curl -fsSL "https://get.helm.sh/${helm_archive}" -o "$tmp/$helm_archive"; \
    helm_sha="$(curl -fsSL "https://get.helm.sh/${helm_archive}.sha256sum" | awk '{ print $1 }')"; \
    printf '%s  %s\n' "$helm_sha" "$tmp/$helm_archive" | sha256sum -c -; \
    tar -xzf "$tmp/$helm_archive" -C "$tmp"; \
    install -m 0755 "$tmp/linux-${arch}/helm" /usr/local/bin/helm; \
    rm -rf "$tmp"; \
    k6 version; \
    hadolint --version; \
    kubeconform -v; \
    kubectl version --client=true; \
    helm version --short

# Agent skill code is delivered by the code-bundle overlay at deploy time.
RUN mkdir -p /app/skills

# The observer is self-contained and must not import from /app/skills.
COPY plugins/openclaw-agent-observer/ /tmp/kubeclaw-openclaw-plugins/kubeclaw-agent-observer/
WORKDIR /tmp/kubeclaw-openclaw-plugins/kubeclaw-agent-observer
RUN rm -rf dist \
    && node /opt/kubeclaw-tools/node_modules/typescript/bin/tsc -p tsconfig.build.json \
    && mkdir -p /app/dist/extensions/kubeclaw-agent-observer \
    && cp -R package.json openclaw.plugin.json src dist /app/dist/extensions/kubeclaw-agent-observer/ \
    && rm -rf /tmp/kubeclaw-openclaw-plugins

# Official plugins are pinned and baked into an OpenClaw home seed so startup
# never requires a network install.
ARG OPENCLAW_PLUGIN_VERSION=2026.7.1
RUN mkdir -p /tmp/openclaw-plugin-home \
    && HOME=/tmp/openclaw-plugin-home openclaw plugins install "@openclaw/acpx@${OPENCLAW_PLUGIN_VERSION}" \
    && HOME=/tmp/openclaw-plugin-home openclaw plugins install "@openclaw/discord@${OPENCLAW_PLUGIN_VERSION}" \
    && mkdir -p /opt/openclaw-plugin-home \
    && cp -a /tmp/openclaw-plugin-home/.openclaw/. /opt/openclaw-plugin-home/ \
    && rm -rf /tmp/openclaw-plugin-home

WORKDIR /opt/openclaw-plugin-home/npm
RUN find . -type f -print0 \
      | sort -z \
      | xargs -0 sha256sum \
      | sha256sum \
      | awk '{print $1}' > /opt/openclaw-plugin-home/.kubeclaw-plugin-cache-version

WORKDIR /app
ENV HOME=/home/node

LABEL org.opencontainers.image.title="KubeClaw General (Root Mode)"
LABEL org.opencontainers.image.description="Root environment for Nova, Forge, and Echo with locked verification tools"
