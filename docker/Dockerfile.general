# =============================================================================
# KubeClaw General — Root Environment for Nova, Forge, Echo
# =============================================================================
FROM ghcr.io/openclaw/openclaw:2026.3.7

USER root

# 1. System tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo curl wget git jq nano tree net-tools iputils-ping dnsutils \
    build-essential python3 python3-pip python3-venv ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# 2. Global skill dependencies
RUN mkdir -p /root/.npm && npm config set cache /root/.npm --global \
    && npm install -g ioredis uuid @qdrant/js-client-rest

# 3. File ownership for root mode
RUN chown -R root:root /app

# 4. KubeClaw skills — common + nova-specific, placed alongside OpenClaw's own skills
COPY skills/common/ /app/skills/
COPY skills/nova/ /app/skills/

# 5. Environment
ENV NODE_PATH=/usr/local/lib/node_modules:/app/node_modules
ENV NPM_CONFIG_CACHE=/root/.npm
ENV HOME=/home/node

# 6. ACPX plugin (Agent Communication Protocol)
RUN mkdir -p /home/node/.openclaw \
    && chown -R root:root /home/node \
    && openclaw plugins install acpx

# 7. Build verification
RUN echo "=== Build Verification ===" && \
    node -e "require('ioredis'); console.log('  ✅ ioredis')" && \
    ls /app/skills/redis.js /app/skills/memory.js /app/skills/pipeline.js && echo "  ✅ KubeClaw skills in /app/skills/"

LABEL org.opencontainers.image.title="KubeClaw General (Root Mode)"
LABEL org.opencontainers.image.description="Root environment for K8s stateful deployments with ACPX"
