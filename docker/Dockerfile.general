# =============================================================================
# KubeClaw General — Root Environment for Nova, Forge, Echo
# =============================================================================
FROM ghcr.io/openclaw/openclaw:latest
USER root

# 1. System tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo curl wget git jq nano tree net-tools iputils-ping dnsutils ripgrep \
    build-essential python3 python3-pip python3-venv python-is-python3 ffmpeg \
    shellcheck yamllint \
    && rm -rf /var/lib/apt/lists/*

# 2. Global skill dependencies + lint tools (JS/TS)
RUN mkdir -p /root/.npm && npm config set cache /root/.npm --global \
    && npm install -g ioredis uuid @qdrant/js-client-rest \
       typescript eslint knip madge

# 3. Python lint tools (stable, no hash issues)
RUN pip install --break-system-packages --no-cache-dir \
    'ruff>=0.1.0' 'mypy>=1.0' 'pip-audit>=2.6.0'

# 4. Semgrep — isolated install (musl/hash issues on PyPI)
#    Eigenes venv verhindert Konflikte mit System-Python
RUN python3 -m venv /opt/semgrep \
    && /opt/semgrep/bin/pip install --no-cache-dir 'semgrep>=1.40.0' \
    && ln -s /opt/semgrep/bin/semgrep /usr/local/bin/semgrep

# 5. Binary tools — pinned versions for reproducible builds
ARG HADOLINT_VERSION=2.12.0
ARG KUBECONFORM_VERSION=0.6.4

# hadolint — Dockerfile linter
RUN wget -qO /usr/local/bin/hadolint \
    https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-Linux-x86_64 \
    && chmod +x /usr/local/bin/hadolint

# kubeconform — K8s manifest validation
RUN wget -qO- \
    https://github.com/yannh/kubeconform/releases/download/v${KUBECONFORM_VERSION}/kubeconform-linux-amd64.tar.gz \
    | tar xz -C /usr/local/bin/

# helm (if not already in base image)
RUN if ! command -v helm &>/dev/null; then \
      curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash; \
    fi

# 6. File ownership for root mode
RUN chown -R root:root /app

# 7. KubeClaw skills
#    Keep canonical shared helper source at /app/common.
#    Production /app/skills/pipeline helper paths are populated directly from
#    skills/common/pipeline so the runtime uses one canonical implementation.
#    Repo-local Nova facade files remain only for source-tree testability and
#    are excluded from the image layer for those helper paths.
COPY skills/common/ /tmp/kubeclaw-skills/common/
COPY skills/nova/ /tmp/kubeclaw-skills/nova/
RUN mkdir -p /app/common /app/skills \
    && cp -r /tmp/kubeclaw-skills/common/. /app/common/ \
    && tar -C /tmp/kubeclaw-skills/common -cf - . | tar -C /app/skills -xf - \
    && tar -C /tmp/kubeclaw-skills/nova \
         --exclude='pipeline/agents/runtime.js' \
         --exclude='pipeline/integrations/gateway.js' \
         --exclude='pipeline/agents/lifecycle.js' \
         --exclude='pipeline/agents/acp-monitor.js' \
         --exclude='pipeline/lifecycle-state.js' \
         -cf - . | tar -C /app/skills -xf - \
    && rm -rf /tmp/kubeclaw-skills

# 8. Environment
ENV NODE_PATH=/usr/local/lib/node_modules:/app/node_modules
ENV NPM_CONFIG_CACHE=/root/.npm
ENV HOME=/home/node

# 9. ACPX plugin (Agent Communication Protocol)
RUN mkdir -p /home/node/.openclaw \
    && chown -R root:root /home/node \
    && openclaw plugins install acpx

# 10. Hotfix backgrounded exec onUpdate crash in current OpenClaw base image.
#     Guard emitUpdate() after backgrounding/exiting so late stdout/stderr
#     does not invoke a stale agent listener and crash the gateway.
RUN node - <<'NODE'
const fs = require('fs');
const path = require('path');
const dir = '/app/dist';
const files = fs.readdirSync(dir).filter((f) => /^exec-defaults-.*\.js$/.test(f));
if (!files.length) throw new Error('exec-defaults bundle not found in /app/dist');
const before = "\tconst emitUpdate = () => {\n\t\tif (!opts.onUpdate) return;\n\t\tconst tailText = session.tail || session.aggregated;\n";
const after = "\tconst emitUpdate = () => {\n\t\tif (!opts.onUpdate) return;\n\t\tif (session.backgrounded || session.exited) return;\n\t\tconst tailText = session.tail || session.aggregated;\n";
for (const file of files) {
  const full = path.join(dir, file);
  const text = fs.readFileSync(full, 'utf8');
  if (text.includes(after)) {
    console.log(`already patched ${file}`);
    continue;
  }
  if (!text.includes(before)) throw new Error(`emitUpdate anchor not found in ${file}`);
  fs.writeFileSync(full, text.replace(before, after));
  console.log(`patched ${file}`);
}
NODE

LABEL org.opencontainers.image.title="KubeClaw General (Root Mode)"
LABEL org.opencontainers.image.description="Root environment for K8s stateful deployments with ACPX + lint tools"
