ARG OPENCLAW_BASE=ghcr.io/openclaw/openclaw:2026.8.1@sha256:e7849cb6c1ef1ead39ab4be7d85edb2df89611f486e283284c7cf35ce39a20d4
FROM ${OPENCLAW_BASE} AS build
USER root
WORKDIR /build
COPY . /build
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund \
 && npm run typecheck --prefix skills/prism \
 && npm prune --omit=dev --ignore-scripts

FROM ${OPENCLAW_BASE}
USER root
WORKDIR /app/prism
COPY --from=build /build/node_modules /app/prism/node_modules
COPY --from=build /build/contracts /app/prism/contracts
COPY --from=build /build/skills/prism /app/prism/skills/prism
COPY --from=build /build/skills/worker/core /app/prism/skills/worker/core
RUN chown -R node:node /app/prism
USER node
ENV NODE_ENV=production PORT=8080 PRISM_INGESTION_MODE=true
EXPOSE 8080
CMD ["node","--experimental-strip-types","skills/prism/server/ingestion.ts"]
