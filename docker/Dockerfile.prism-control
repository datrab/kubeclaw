# Version defaults are generated from versions.json; run npm run versions:sync.
ARG NODE_BASE=node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
FROM ${NODE_BASE} AS build
USER root
WORKDIR /build
COPY . /build
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund \
 && npm run typecheck --prefix skills/prism \
 && npm prune --omit=dev --ignore-scripts

FROM ${NODE_BASE}
USER root
WORKDIR /app/prism
COPY --from=build /build/node_modules /app/prism/node_modules
COPY --from=build /build/contracts /app/prism/contracts
COPY --from=build /build/skills/prism /app/prism/skills/prism
COPY --from=build /build/skills/worker/core /app/prism/skills/worker/core
COPY --from=build /build/skills/common/plugin-runtime /app/prism/skills/common/plugin-runtime
COPY --from=build /build/tests/verification/live /app/prism/tests/verification/live
RUN install -d -o node -g node /var/lib/prism/artifacts
USER node
ENV NODE_ENV=production PORT=8080 ARTIFACT_ROOT=/var/lib/prism/artifacts
EXPOSE 8080
CMD ["node","--experimental-strip-types","skills/prism/server/control.ts"]
