# =============================================================================
# Mission Control - Autarkes Build-Image (Root-Mode für OpenClaw)
# =============================================================================
FROM node:20-slim AS builder

# System-Abhängigkeiten für Build & Git
RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# pnpm global aktivieren
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /build-source

# Repository direkt im Docker-Build klonen
# (Dies stellt sicher, dass alle benötigten Dateien wie package.json vorhanden sind)
RUN git clone https://github.com/builderz-labs/mission-control.git .

# Abhängigkeiten installieren und Next.js App bauen
RUN pnpm install --frozen-lockfile
RUN pnpm build

# --- Runtime Stage ---
FROM node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

# Kopiere die gebauten Standalone-Dateien aus dem builder
COPY --from=builder /build-source/.next/standalone ./
COPY --from=builder /build-source/.next/static ./.next/static
COPY --from=builder /build-source/src/lib/schema.sql ./src/lib/schema.sql

# Datenverzeichnis für SQLite (Root-Mode für Sidecar-Kompatibilität)
RUN mkdir -p .data
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

ENV PORT=3000
EXPOSE 3000
ENV HOSTNAME=0.0.0.0

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:${PORT:-3000}/login || exit 1

CMD ["node", "server.js"]
