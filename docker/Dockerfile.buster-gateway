# Buster's OpenClaw gateway and native/ACP agent runtime. Deterministic test,
# image-build and Kubernetes tooling are reached through bounded v2 adapters.

ARG OPENCLAW_BASE=ghcr.io/openclaw/openclaw:2026.8.2@sha256:5d25165995041caa6a7175bec82b25ad98c44eb269bb42435da8e27ec06e6be4
ARG OPENCLAW_SOURCE_COMMIT=2e2aa1136152d8462f242270825cbfad63d9c6dc
ARG OPENCLAW_SOURCE_ARCHIVE_SHA256=79ea85fe5ffb1f86278a728e6f6f0c1033c0bdb08525239bcc076fd75adae962
ARG OPENCLAW_NODE_BUILD_IMAGE=docker.io/library/node:24-bookworm@sha256:934240a162082fd8b8a2f90cd5114446443f1eba1c5378f6687167ca405e6584
ARG OPENCLAW_BUN_IMAGE=docker.io/oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6

# hadolint ignore=DL3006
FROM ${OPENCLAW_BUN_IMAGE} AS openclaw-bun

# hadolint ignore=DL3006
FROM ${OPENCLAW_NODE_BUILD_IMAGE} AS openclaw-runtime-build
ARG OPENCLAW_SOURCE_COMMIT
ARG OPENCLAW_SOURCE_ARCHIVE_SHA256
WORKDIR /src
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN corepack enable
# hadolint ignore=DL3020
ADD \
https://github.com/openclaw/openclaw/archive/${OPENCLAW_SOURCE_COMMIT}.tar.gz \
/tmp/openclaw-source.tar.gz
RUN printf '%s  %s\n' "${OPENCLAW_SOURCE_ARCHIVE_SHA256}" /tmp/openclaw-source.tar.gz \
| sha256sum -c - \
&& tar -xzf /tmp/openclaw-source.tar.gz --strip-components=1 -C /src \
&& rm /tmp/openclaw-source.tar.gz \
&& test "$(node -p "require('./package.json').version")" = "2026.8.2"
COPY --from=openclaw-bun /usr/local/bin/bun /usr/local/bin/bun
COPY docker/openclaw-runtime-patch/apply.mjs /tmp/apply-openclaw-runtime-patch.mjs
RUN node /tmp/apply-openclaw-runtime-patch.mjs /src
RUN --mount=type=cache,id=openclaw-patched-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
NODE_OPTIONS=--max-old-space-size=2048 pnpm install --frozen-lockfile
RUN NODE_OPTIONS=--max-old-space-size=8192 \
OPENCLAW_RUN_NODE_SKIP_DTS_BUILD=1 \
pnpm build \
&& grep -R -q 'canReconcileLateSuccess' /src/dist \
&& test -s /src/dist/control-ui/index.html \
&& printf '%s\n' "${OPENCLAW_SOURCE_COMMIT}" > /src/dist/.kubeclaw-openclaw-source \
&& printf '%s\n' 'collector-late-structured-output-reconciliation-v1' \
> /src/dist/.kubeclaw-runtime-patch

# hadolint ignore=DL3006
FROM ${OPENCLAW_BASE} AS gateway-assets
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN rm -rf /app/dist
COPY --from=openclaw-runtime-build /src/dist/ /app/dist/

COPY tsconfig.base.json /tmp/tsconfig.base.json
COPY contracts/agent-observability/v1/ /tmp/contracts/agent-observability/v1/
COPY skills/common/plugins/openclaw-agent-observer/ /tmp/skills/common/plugins/openclaw-agent-observer/
WORKDIR /tmp/skills/common/plugins/openclaw-agent-observer

RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund \
&& rm -rf src/generated/agent-observability \
&& mkdir -p src/generated/agent-observability \
&& cp -R /tmp/contracts/agent-observability/v1/src/. src/generated/agent-observability/ \
&& ./node_modules/.bin/tsc -p /tmp/contracts/agent-observability/v1/tsconfig.build.json \
&& node scripts/build.mjs --tsc ./node_modules/.bin/tsc \
&& mkdir -p /out/extensions/kubeclaw-agent-observer \
&& cp -R \
/tmp/skills/common/plugins/openclaw-agent-observer/package.json \
/tmp/skills/common/plugins/openclaw-agent-observer/openclaw.plugin.json \
/tmp/skills/common/plugins/openclaw-agent-observer/src \
/tmp/skills/common/plugins/openclaw-agent-observer/dist \
/out/extensions/kubeclaw-agent-observer/

ARG OPENCLAW_PLUGIN_VERSION=2026.8.2
ARG TARGETARCH

RUN set -eux; \
mkdir -p /tmp/openclaw-plugin-home /tmp/openclaw-plugin-npm-cache /out/openclaw-plugin-home/packs; \
HOME=/tmp/openclaw-plugin-home NPM_CONFIG_CACHE=/tmp/openclaw-plugin-npm-cache openclaw plugins install "npm:@openclaw/acpx@${OPENCLAW_PLUGIN_VERSION}" --force --accept-capabilities; \
HOME=/tmp/openclaw-plugin-home NPM_CONFIG_CACHE=/tmp/openclaw-plugin-npm-cache openclaw plugins install "npm:@openclaw/discord@${OPENCLAW_PLUGIN_VERSION}" --force --accept-capabilities; \
acpx_root="$(find /tmp/openclaw-plugin-home/.openclaw/npm/projects -type d -path '*/node_modules/@openclaw/acpx' -print -quit)"; \
test -n "$acpx_root"; \
discord_root="$(find /tmp/openclaw-plugin-home/.openclaw/npm/projects -type d -path '*/node_modules/@openclaw/discord' -print -quit)"; \
test -n "$discord_root"; \
project_root="${acpx_root%/node_modules/@openclaw/acpx}"; \
case "${TARGETARCH:-amd64}" in \
amd64) keep_codex=codex-acp-linux-x64; keep_claude=claude-agent-sdk-linux-x64; keep_esbuild=linux-x64 ;; \
arm64) keep_codex=codex-acp-linux-arm64; keep_claude=claude-agent-sdk-linux-arm64; keep_esbuild=linux-arm64 ;; \
*) exit 1 ;; \
esac; \
test ! -d "$project_root/node_modules/@zed-industries" || find "$project_root/node_modules/@zed-industries" -mindepth 1 -maxdepth 1 -type d -name 'codex-acp-*' ! -name "$keep_codex" -exec rm -rf -- {} +; \
test ! -d "$project_root/node_modules/@anthropic-ai" || find "$project_root/node_modules/@anthropic-ai" -mindepth 1 -maxdepth 1 -type d -name 'claude-agent-sdk-*' ! -name "$keep_claude" -exec rm -rf -- {} +; \
test ! -d "$project_root/node_modules/@esbuild" || find "$project_root/node_modules/@esbuild" -mindepth 1 -maxdepth 1 -type d ! -name "$keep_esbuild" -exec rm -rf -- {} +; \
npm pack "$acpx_root" --pack-destination /out/openclaw-plugin-home/packs >/dev/null; \
npm pack "$discord_root" --pack-destination /out/openclaw-plugin-home/packs >/dev/null; \
cp -a /tmp/openclaw-plugin-npm-cache /out/openclaw-plugin-home/npm-cache; \
test "$(find /out/openclaw-plugin-home/packs -maxdepth 1 -type f -name '*.tgz' | wc -l)" -eq 2; \
find /out/openclaw-plugin-home -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}' > /out/openclaw-plugin-home/.kubeclaw-plugin-cache-version; \
rm -rf /tmp/openclaw-plugin-home /tmp/openclaw-plugin-npm-cache

USER node

# hadolint ignore=DL3006
FROM ${OPENCLAW_BASE}
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN rm -rf /app/dist
COPY --from=openclaw-runtime-build /src/dist/ /app/dist/

ARG DEBIAN_SNAPSHOT=20260901T000000Z

RUN test -s /etc/ssl/certs/ca-certificates.crt \
&& printf '%s\n' \
'Types: deb' \
"URIs: https://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" \
'Suites: bookworm bookworm-updates' \
'Components: main' \
'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
'' \
'Types: deb' \
"URIs: https://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" \
'Suites: bookworm-security' \
'Components: main' \
'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
> /etc/apt/sources.list.d/debian.sources \
&& rm -f /etc/apt/sources.list \
&& printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot

# The snapshot pins the complete dependency graph coherently.

# hadolint ignore=DL3008
RUN packages=(ca-certificates curl git openssh-client jq ripgrep tree) \
&& apt-get -o Acquire::Retries=5 -o APT::Update::Error-Mode=any update \
&& for package in "${packages[@]}"; do apt-cache show "${package}" >/dev/null; done \
&& apt-get install -y --no-install-recommends "${packages[@]}" \
&& rm -rf /var/lib/apt/lists/* \
&& mkdir -p /app/skills /root/.npm \
&& npm config set cache /root/.npm --global \
&& npm install -g ioredis@5.11.1

COPY --from=gateway-assets /out/extensions/kubeclaw-agent-observer /app/dist/extensions/kubeclaw-agent-observer
COPY --from=gateway-assets /out/openclaw-plugin-home /opt/openclaw-plugin-home

ENV NODE_PATH=/usr/local/lib/node_modules:/app/node_modules \
NPM_CONFIG_CACHE=/root/.npm \
HOME=/home/node

USER node

LABEL org.opencontainers.image.title="KubeClaw Buster Gateway"
LABEL org.opencontainers.image.description="Minimal OpenClaw gateway for Buster native and ACP agents"
