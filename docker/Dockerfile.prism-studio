# Version defaults are generated from versions.json; run npm run versions:sync.
ARG NODE_BASE=node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
FROM ${NODE_BASE} AS build
ARG DEBIAN_SNAPSHOT=20260901T000000Z
ARG KUBECLAW_BUILD_REVISION
USER root
WORKDIR /build
COPY . /build
RUN sh docker/install-prism-build-tools.sh \
 && npm ci --include=dev --ignore-scripts --no-audit --no-fund \
 && npm run build:studio --prefix skills/prism \
 && npm run plugin-system:sandbox:build \
 && npm run typecheck --prefix skills/prism \
 && node scripts/build-prism-image-bundle.mjs prism-studio /image "$KUBECLAW_BUILD_REVISION" \
 && npm prune --omit=dev --ignore-scripts

FROM ${NODE_BASE}
USER root
WORKDIR /app/prism
COPY --from=build /image/role /app/prism
COPY --from=build /image/generation/system /etc/kubeclaw/config
COPY --from=build /image/delivery /run/pipeline-delivery
COPY --from=build /build/skills/prism/dist-studio /opt/prism-studio
USER node
ENV NODE_ENV=production STUDIO_ROOT=/opt/prism-studio
EXPOSE 8080
CMD ["node","--experimental-strip-types","skills/packages/prism-engine/server/studio.ts"]
