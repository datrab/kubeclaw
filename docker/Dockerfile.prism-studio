# Version defaults are generated from versions.json; run npm run versions:sync.
ARG NODE_BASE=node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
FROM ${NODE_BASE} AS build
USER root
WORKDIR /build
COPY . /build
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund \
 && npm run build:studio --prefix skills/prism

FROM ${NODE_BASE}
USER root
# These services execute Node directly; package managers are build-only tools.
RUN rm -rf /usr/local/lib/node_modules /opt/yarn-* \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app/prism
COPY --from=build /build/skills/prism/dist-studio /app/prism/dist-studio
COPY --from=build /build/skills/prism/server /app/prism/server
RUN chown -R node:node /app/prism
USER node
ENV NODE_ENV=production PORT=8080 STUDIO_ROOT=/app/prism/dist-studio
# Exercise the packaged service as its runtime user, without build dependencies.
RUN --mount=type=bind,source=skills/prism/tests/studio-service.test.mts,target=/app/prism/tests/studio-service.test.mts \
    node --test /app/prism/tests/studio-service.test.mts
EXPOSE 8080
CMD ["node","--experimental-strip-types","server/studio.ts"]
