# Version defaults are generated from versions.json; run npm run versions:sync.
ARG NODE_BASE=node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
FROM ${NODE_BASE} AS native-launcher
ARG DEBIAN_SNAPSHOT=20260901T000000Z
USER root
RUN printf '%s\n' \
      'Types: deb' \
      "URIs: http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}" \
      'Suites: bookworm bookworm-updates' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      '' \
      'Types: deb' \
      "URIs: http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}" \
      'Suites: bookworm-security' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/debian.sources \
 && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot \
 && apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
COPY skills/worker/core/worker/native-worker-launcher.c /build/native-worker-launcher.c
RUN cc -std=c11 -O2 -Wall -Wextra -Werror -fstack-protector-strong -D_FORTIFY_SOURCE=3 \
      -fPIE -pie -Wl,-z,relro,-z,now /build/native-worker-launcher.c -o /native-worker-launcher \
 && chmod 0755 /native-worker-launcher

FROM ${NODE_BASE} AS build
ARG DEBIAN_SNAPSHOT=20260901T000000Z
ARG KUBECLAW_BUILD_REVISION
USER root
WORKDIR /build
COPY . /build
RUN sh docker/install-prism-build-tools.sh \
 && npm ci --include=dev --ignore-scripts --no-audit --no-fund \
 && npm run typecheck --prefix skills/prism \
 && npm run plugin-system:sandbox:build \
 && node scripts/build-prism-image-bundle.mjs prism-worker /image "$KUBECLAW_BUILD_REVISION" \
 && npm prune --omit=dev --ignore-scripts

FROM ${NODE_BASE}
ARG TARGETARCH
USER root
COPY --from=native-launcher /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list.d/debian.sources
COPY --from=native-launcher /etc/apt/apt.conf.d/99snapshot /etc/apt/apt.conf.d/99snapshot
WORKDIR /app/prism
COPY --from=build /image/role /app/prism
COPY --from=build /image/generation/system /etc/kubeclaw/config
COPY --from=build /image/delivery /run/pipeline-delivery
COPY --from=native-launcher /native-worker-launcher /usr/local/libexec/kubeclaw-native-worker-launcher
ENV PRISM_NATIVE_LAUNCHER=/usr/local/libexec/kubeclaw-native-worker-launcher \
    PRISM_NATIVE_POOL_POLICY_FILE=/etc/kubeclaw/prism-pool.json
COPY package-lock.json versions.json /opt/prism-image-tools/
COPY docker/browser-archives.lock.json /opt/prism-image-tools/docker/browser-archives.lock.json
COPY scripts/browser-archive-lock.mjs /opt/prism-image-tools/scripts/browser-archive-lock.mjs
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /opt/prism-image-tools
RUN ln -s /app/prism/skills/node_modules node_modules \
 && rm -f /etc/apt/sources.list \
 && node ./node_modules/playwright/cli.js install-deps chromium \
 && node scripts/browser-archive-lock.mjs --install "$TARGETARCH" prism /ms-playwright \
 && test -d /ms-playwright

WORKDIR /app/prism
USER node
ENV NODE_ENV=production
EXPOSE 8080
CMD ["node","--experimental-strip-types","skills/packages/prism-engine/server/worker.ts"]
