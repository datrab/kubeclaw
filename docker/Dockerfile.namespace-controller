# =============================================================================
# KubeClaw Namespace Controller
# =============================================================================
# Lightweight controller runtime for Buster namespace leases.
FROM node:22-bookworm-slim

WORKDIR /app

COPY scripts/buster-namespace-controller.mjs /app/scripts/buster-namespace-controller.mjs

USER node

CMD ["node", "/app/scripts/buster-namespace-controller.mjs"]

LABEL org.opencontainers.image.title="KubeClaw Namespace Controller"
LABEL org.opencontainers.image.description="Lightweight Buster namespace lease controller"
