# =============================================================================
# KubeClaw Archviewer — Lightweight architecture presentation server
# =============================================================================
# Serves Nova's HTML architecture presentations from /designs on port 3456.
# It is independent from Prism Studio and has no Prism design authority. The
# Nova sidecar retains the historical workspace/prism/designs storage subpath.
#
# Build:  docker build -f docker/Dockerfile.archviewer -t ghcr.io/datrab/kubeclaw-archviewer:latest .
# Run:    docker run -p 3456:3456 -v ./designs:/designs ghcr.io/datrab/kubeclaw-archviewer:latest
# =============================================================================
FROM docker.io/library/nginx:1.29-alpine

COPY docker/archviewer.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3456

# Ensure /designs exists (empty is fine — nginx lists the directory).
RUN mkdir -p /designs
