# Version defaults are generated from versions.json; run npm run versions:sync.
ARG ARCHVIEWER_BASE=docker.io/library/nginx:1.30-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949

# =============================================================================
# KubeClaw Archviewer — Lightweight architecture presentation server
# =============================================================================
# Serves Nova's HTML architecture presentations from /designs on port 3456.
# It is independent from Prism Studio and has no Prism design authority. The
# Nova sidecar retains the historical workspace/prism/designs storage subpath.
#
# Build:  docker build -f docker/Dockerfile.archviewer -t ghcr.io/datrab/kubeclaw-archviewer:latest .
# Run with /designs read-only and an htpasswd file at /etc/archviewer-auth/htpasswd.
# Publish through the authenticated Tailnet ingress configured by the chart.
# =============================================================================
FROM ${ARCHVIEWER_BASE}

# Fixes available in Alpine 3.24 for the retained upstream nginx image.
RUN apk upgrade --no-cache brotli-libs=1.2.1-r0 curl=8.23.0-r0 libcurl=8.23.0-r0

COPY docker/archviewer.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3456

# An empty document directory is valid; /healthz remains available to probes.
RUN mkdir -p /designs
