[Unit]
Description=External KubeClaw read-only Ops MCP
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=kubeclaw-mcp
Group=kubeclaw-mcp
SupplementaryGroups=kubeclaw-mcp-client
EnvironmentFile=/etc/kubeclaw-ops/ops.env
WorkingDirectory=/opt/kubeclaw-ops/mcp
ExecStart=/usr/bin/node /opt/kubeclaw-ops/mcp/src/server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=384M
CPUQuota=50%
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
