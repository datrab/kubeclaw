[Unit]
Description=Renew external KubeClaw observer token
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=kubeclaw-mcp
Group=kubeclaw-mcp
ExecStart=/usr/bin/python3 /opt/kubeclaw-ops/renew-token.py
TimeoutStartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/kubeclaw-ops
CapabilityBoundingSet=
UMask=0077
