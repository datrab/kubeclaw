[Unit]
Description=KubeClaw Codex Remote host
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=kubeclaw-codex
Group=kubeclaw-codex
SupplementaryGroups=kubeclaw-mcp-client
Environment=HOME=/var/lib/kubeclaw-codex
WorkingDirectory=/var/lib/kubeclaw-codex/workspace
# Install and pin the CLI here. Verify this version supports the documented
# foreground command; do not also run `remote-control start` as another daemon.
ExecStart=/opt/kubeclaw-ops/codex-remote.sh
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/kubeclaw-codex
InaccessiblePaths=/etc/kubeclaw-ops/ssh_config /etc/kubeclaw-ops/diagnostics_ed25519 /etc/kubeclaw-ops/token_ed25519 /var/lib/kubeclaw-ops
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
MemoryMax=3G
CPUQuota=150%
TasksMax=512

[Install]
WantedBy=multi-user.target
