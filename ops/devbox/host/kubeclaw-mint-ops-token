#!/bin/sh
set -eu
test "$#" -eq 0 || { echo 'This command accepts no arguments' >&2; exit 2; }
# Root's kubeconfig never leaves the host. Neither subject nor duration is input.
exec /usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin \
  /usr/local/bin/k3s kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml \
  --request-timeout=15s -n kubeclaw-ops create token external-ops --duration=24h
