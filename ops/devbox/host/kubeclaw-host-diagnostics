#!/usr/bin/python3
"""Install root-owned on the K3s host; sudoers permits this exact no-argument command."""
import datetime
import json
import os
import shutil
import subprocess
import sys

if len(sys.argv) != 1:
    sys.exit('This command accepts no arguments')

def run(argv):
    try:
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, timeout=3, check=False,
                                env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'})
        return {'exitCode': result.returncode,
                'output': result.stdout.decode('utf-8', errors='replace')[:8192],
                'error': result.stderr.decode('utf-8', errors='replace')[:2048]}
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {'unavailable': type(exc).__name__}

usage = shutil.disk_usage('/')
report = {
    'observedAt': datetime.datetime.now(datetime.timezone.utc).isoformat(),
    'hostname': os.uname().nodename,
    'kernel': os.uname().release,
    'load': os.getloadavg(),
    'rootDisk': {'total': usage.total, 'used': usage.used, 'free': usage.free},
    'memory': open('/proc/meminfo', encoding='utf-8').read(),
    'services': run(['/usr/bin/systemctl', 'show', 'k3s.service', 'tailscaled.service',
                     '-p', 'Id,LoadState,ActiveState,SubState,Result,NRestarts']),
    'filesystems': run(['/usr/bin/df', '-P', '-l']),
    'inodes': run(['/usr/bin/df', '-P', '-i', '-l']),
    'scope': 'Read-only OS snapshot. Does not establish pipeline, API or backup health.',
}
print(json.dumps(report))
