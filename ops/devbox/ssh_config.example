# Copy to /etc/kubeclaw-ops/ssh_config, root:kubeclaw-mcp 0640.
# HostName must be the HOST OS Tailscale address, never an operator proxy.
Host kubeclaw-diagnostics kubeclaw-token
    HostName REPLACE_WITH_HOST_TAILSCALE_IP
    User kubeclaw-observer
    Port 22
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /etc/kubeclaw-ops/known_hosts
    GlobalKnownHostsFile /dev/null
    IdentitiesOnly yes
    IdentityAgent none
    ForwardAgent no
    ClearAllForwardings yes
    RequestTTY no
    ConnectTimeout 4
    ConnectionAttempts 1
    ServerAliveInterval 5
    ServerAliveCountMax 1
    ControlMaster no
    ControlPath none
    PermitLocalCommand no
Host kubeclaw-diagnostics
    IdentityFile /etc/kubeclaw-ops/diagnostics_ed25519
Host kubeclaw-token
    IdentityFile /etc/kubeclaw-ops/token_ed25519
