{
  "name": "@kubeclaw/prism",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./runtime.ts",
    "./domain": "./domain/index.ts",
    "./renderer": "./renderer/index.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.mts openclaw-plugin/index.test.mjs",
    "test:domain": "node --test tests/domain.test.mts tests/domain-storage.test.mts",
    "test:renderer": "node --test tests/renderer.test.mts tests/renderer-remediation.test.mts",
    "test:storage": "node --test tests/storage.test.mts tests/control.test.mts",
    "test:engine": "node --test tests/engine.test.mts",
    "test:corpus": "node --test tests/corpus.test.mts",
    "test:quality": "node --test tests/quality.test.mts tests/directions.test.mts",
    "test:pipeline": "node --test tests/pipeline-adapter.test.mts",
    "test:e2e": "node --test tests/e2e.test.mts",
    "prebuild:studio": "node ../../contracts/prism/v1/scripts/generate-validators.mjs",
    "build:studio": "vite build --config studio/vite.config.ts",
    "dev:studio": "NODE_ENV=development vite --config studio/vite.config.ts",
    "test:studio": "node --test tests/studio-adapter.test.mts && playwright test --config studio/playwright.config.mjs",
    "start:control": "node --experimental-strip-types server/control.ts",
    "start:studio": "node --experimental-strip-types server/studio.ts",
    "start:worker": "node --experimental-strip-types server/worker.ts",
    "typecheck": "tsc --noEmit",
    "test:studio-remediation": "node --test tests/studio-roundtrip.test.mts tests/preview-assets.test.mts && npm run build:studio && playwright test --config studio/playwright-remediation.mjs"
  },
  "dependencies": {
    "@kubeclaw/pipeline-worker-core-contract": "1.0.0",
    "@kubeclaw/worker-core": "*",
    "@kubeclaw/prism-contracts-v1": "1.0.0",
    "@puckeditor/core": "0.23.0",
    "pg": "8.16.3",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@electric-sql/pglite-pgvector": "0.0.6",
    "@playwright/test": "1.62.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "vite": "7.3.6"
  }
}
