import test from "node:test";import assert from "node:assert/strict";import {PGlite}from"@electric-sql/pglite";import{vector}from"@electric-sql/pglite-pgvector";import fixture from"../../../contracts/prism/v1/fixtures/minimal-web.json"with{type:"json"};
import{migrate,RevisionRepository}from"../storage/index.ts";import{PrismEngine,DeterministicDesignProvider}from"../engine/index.ts";import{evaluate}from"../evaluation/index.ts";import{toBusterPlan}from"../pipeline-adapter/index.ts";
test("Nova request to Prism baseline to visual provider plan",async()=>{const db=new PGlite({extensions:{vector}});await migrate(db as any);const repo=new RevisionRepository(db as any);const project=await repo.createProject("demo","Demo");const documentId=await repo.createDocument(project,"main",fixture as any,"tailscale:test");const engine=new PrismEngine(new DeterministicDesignProvider());const generated=await engine.execute({contract:"kubeclaw.prism-design-engine@1",operation:"generate",input:{document:fixture,instruction:"Operational services"},idempotencyKey:"generate:1"});const next=generated.output.document as any;assert.notEqual(evaluate(next).status,"blocked");const published=await engine.execute({contract:"kubeclaw.prism-design-engine@1",operation:"publish",input:{document:next,approved:true},idempotencyKey:"publish:1"});const digest=String(published.output.bundleDigest);const plan=toBusterPlan({baselineDigest:digest,projectId:"demo",targets:[{id:"home-wide",view:"home",state:"default",viewport:"wide",fidelity:"exact",path:"/home"}]});assert.equal(plan.visual.uses,"kubeclaw.visual@1");assert.equal((await repo.current(documentId)).document.meta.revision,1);await db.close();});
test("publication rejects missing approval and stale edits reject conflicts",async()=>{const engine=new PrismEngine(new DeterministicDesignProvider());await assert.rejects(()=>engine.execute({contract:"kubeclaw.prism-design-engine@1",operation:"publish",input:{document:fixture},idempotencyKey:"bad"}),/approval/);});
