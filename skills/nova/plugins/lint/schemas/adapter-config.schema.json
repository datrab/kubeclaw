{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowedRepositoryRoots",
    "allowedPolicyRoots"
  ],
  "properties": {
    "allowedRepositoryRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedPolicyRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidatePreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "executable",
        "path",
        "timeoutMs",
        "maxOutputBytes"
      ],
      "properties": {
        "mode": {
          "const": "npm-ci"
        },
        "executable": {
          "type": "string",
          "pattern": "^/"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
