{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "candidateStageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "deliveryStageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "readyStageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "manifestStageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "tokenPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "caPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "stateRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "operatorTarget": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    }
  },
  "required": [
    "candidateStageId",
    "deliveryStageId",
    "readyStageId",
    "manifestStageId",
    "endpoint",
    "tokenPath",
    "caPath",
    "stateRoot",
    "operatorTarget",
    "timeoutMs"
  ],
  "additionalProperties": false
}
