{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "source"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "journalHead",
        "snapshotDigest",
        "sourceStageId",
        "sourceRevision",
        "artifacts"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "journalHead": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sourceStageId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "https://kubeclaw.dev/contracts/plugin-system/v2/plugin-system-v2.schema.json#/$defs/artifactRef"
          }
        }
      }
    }
  }
}
