{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "target",
    "issuerId",
    "timeoutMinutes",
    "budgets"
  ],
  "properties": {
    "agent": {
      "const": "prism"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "issuerId": {
      "type": "string",
      "minLength": 1
    },
    "timeoutMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 525600
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumArchiveBytes",
        "maximumArchiveFiles",
        "maximumArchitectureBytes"
      ],
      "properties": {
        "maximumArchiveBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumArchiveFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumArchitectureBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
