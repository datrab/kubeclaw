{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["baselineReport"],
  "properties": {
    "baselineReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "namespace", "mediaType", "digest", "sizeBytes"],
      "properties": {
        "artifactId": { "type": "string", "pattern": "^repository-review:[0-9a-f]{64}$" },
        "namespace": { "const": "kubeclaw.review" },
        "mediaType": { "const": "application/json" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }
      }
    },
    "grade": { "enum": ["fast", "standard", "deep"], "default": "standard" },
    "scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "repository" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "names"],
          "properties": { "kind": { "const": "plugin" }, "dependencyRadius": { "enum": [0, 1] },
            "names": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "prefixes"],
          "properties": { "kind": { "const": "path" },
            "prefixes": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 } } } }
      ]
    },
    "overrides": { "type": "object" }
  }
}
