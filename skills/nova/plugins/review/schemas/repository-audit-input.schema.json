{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allowedPrefixes": {
      "description": "Deprecated path-scope shorthand. Use scope instead.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "grade": { "enum": ["fast", "standard", "deep"], "default": "standard" },
    "mode": { "enum": ["plan", "execute", "resume"], "default": "execute" },
    "scope": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "repository" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "names"],
          "properties": {
            "kind": { "const": "plugin" },
            "dependencyRadius": { "enum": [0, 1] },
            "names": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "prefixes"],
          "properties": {
            "kind": { "const": "path" },
            "prefixes": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenizerEncoding": { "const": "o200k_base", "default": "o200k_base" },
        "componentBudget": { "$ref": "#/$defs/sliceBudget" },
        "boundaryBudget": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "maxFiles": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxBytes": { "type": "integer", "minimum": 1, "maximum": 100000000 },
            "maxTokens": { "type": "integer", "minimum": 1, "maximum": 100000000 },
            "maxRelations": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "maxSlices": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        },
        "maxPrimaryJobs": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxContextExpansionJobs": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxVerificationJobs": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxInputTokensPerJob": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxPromptTokensPerJob": { "description": "Deprecated alias for maxInputTokensPerJob.",
          "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxContextTokensPerJob": { "type": "integer", "minimum": 1, "maximum": 128000 },
        "maxPromptBytesPerJob": { "type": "integer", "minimum": 1, "maximum": 900000 },
        "maxInitialInputTokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maxContextExpansionInputTokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maxVerificationInputTokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maxTotalInputTokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maxInputTokens": { "description": "Deprecated alias for maxTotalInputTokens.",
          "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maxOutputTokensPerJob": { "const": 6000 },
        "maxEstimatedCostUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "maxWallTimeSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "estimatedSecondsPerJob": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "inputUsdPerMillionTokens": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "outputUsdPerMillionTokens": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "maxRetryAttemptsPerPhase": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "enabledLenses": { "type": "array", "uniqueItems": true,
          "items": { "enum": ["architecture", "contracts", "security", "lifecycle", "resilience", "deployment"] } }
      }
    }
  },
  "$defs": {
    "sliceBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 100000000 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 100000000 }
      }
    }
  }
}
