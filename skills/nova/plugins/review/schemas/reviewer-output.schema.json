{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "critical_issues",
    "deferred_issues",
    "checked_contracts",
    "opened_artifacts",
    "failed_commands",
    "unverified_requirements",
    "summary"
  ],
  "properties": {
    "status": {
      "enum": ["PASS", "FAIL"]
    },
    "critical_issues": {
      "$ref": "#/$defs/issues"
    },
    "deferred_issues": {
      "$ref": "#/$defs/issues"
    },
    "checked_contracts": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "opened_artifacts": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "failed_commands": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "unverified_requirements": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "description",
          "affected_files",
          "recommended_fix"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "affected_files": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "recommended_fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
