{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "contract"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "repositoryRoot",
        "architectureRef",
        "paths"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "repositoryRoot": {
          "type": "string",
          "minLength": 1
        },
        "architectureRef": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "baseRevision",
        "requiredFiles",
        "modules",
        "policy"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "baseRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "requiredFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "moduleId",
              "modulePath",
              "ownedPaths",
              "serveDockerfile",
              "apiSpecFile"
            ],
            "properties": {
              "moduleId": {
                "type": "string",
                "minLength": 1
              },
              "modulePath": {
                "type": "string",
                "minLength": 1
              },
              "substeps": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ownedPaths": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "serveDockerfile": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "apiSpecFile": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "policy": {
          "type": "object"
        }
      }
    }
  }
}
