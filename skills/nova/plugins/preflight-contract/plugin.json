{
  "id": "kubeclaw.preflight-contract",
  "apiVersion": "pipeline-plugin-v2",
  "packageVersion": "1.0.0",
  "stages": [
    {
      "id": "validate",
      "type": "kubeclaw.validate.preflight-contract",
      "module": "src/stage.ts",
      "export": "execute",
      "requiredCapabilities": [
        "git.repository.read",
        "artifacts.write"
      ],
      "configSchema": "schemas/config.schema.json",
      "inputSchema": "schemas/input.schema.json",
      "resultSchema": "schemas/result.schema.json"
    },
    {
      "id": "buildkit",
      "type": "kubeclaw.validate.buildkit-preflight",
      "module": "src/buildkit.ts",
      "export": "execute",
      "requiredCapabilities": [
        "test.suite.execute",
        "network.http"
      ],
      "configSchema": "schemas/buildkit-config.schema.json",
      "inputSchema": "schemas/buildkit-input.schema.json",
      "resultSchema": "schemas/result.schema.json"
    }
  ],
  "observers": [],
  "adapters": []
}
