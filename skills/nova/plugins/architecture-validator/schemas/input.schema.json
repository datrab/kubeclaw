{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "object",
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "repositoryRoot",
        "architectureRef",
        "paths"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "repositoryRoot": {
          "type": "string",
          "minLength": 1
        },
        "architectureRef": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageId",
        "inputDigest"
      ],
      "properties": {
        "stageId": {
          "type": "string",
          "minLength": 1
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reviewStageId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
