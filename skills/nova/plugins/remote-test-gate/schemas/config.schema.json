{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoint", "tokenSecret", "sourcePrivateKeySecret", "sourceAuthority", "stateRoot", "allowedRepositoryRoots", "legacyLedgerPath"],
  "properties": {
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "tokenSecret": { "type": "string", "minLength": 1 },
    "sourcePrivateKeySecret": { "type": "string", "minLength": 1 },
    "sourceAuthority": { "type": "string", "minLength": 1 },
    "stateRoot": { "type": "string", "minLength": 1 },
    "allowedRepositoryRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "legacyLedgerPath": { "type": "string", "minLength": 1 }
  }
}
