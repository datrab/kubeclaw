{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint",
    "authentication",
    "sourcePrivateKeySecret",
    "sourceAuthority",
    "stateRoot",
    "allowedRepositoryRoots",
    "gateLimits"
  ],
  "properties": {
    "endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "authentication": {
      "enum": [
        "bearer",
        "spiffe-proxy"
      ]
    },
    "tokenSecret": {
      "type": "string",
      "minLength": 1
    },
    "sourcePrivateKeySecret": {
      "type": "string",
      "minLength": 1
    },
    "sourceAuthority": {
      "type": "string",
      "minLength": 1
    },
    "stateRoot": {
      "type": "string",
      "minLength": 1
    },
    "allowedRepositoryRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gateLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pollMilliseconds",
        "maximumResponseBytes",
        "maximumResultBytes",
        "maximumArchiveBytes",
        "maximumArchiveStoreBytes",
        "maximumEvidenceBytes",
        "maximumEvidenceStoreBytes",
        "recordLimits"
      ],
      "properties": {
        "pollMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maximumResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maximumResultBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maximumArchiveBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maximumArchiveStoreBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "maximumEvidenceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maximumEvidenceStoreBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "recordLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumRecords",
            "maximumBytes",
            "maximumRecordBytes"
          ],
          "properties": {
            "maximumRecords": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maximumBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824
            },
            "maximumRecordBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authentication": {
            "const": "bearer"
          }
        }
      },
      "then": {
        "properties": {
          "tokenSecret": {}
        },
        "required": [
          "tokenSecret"
        ]
      },
      "else": {
        "properties": {
          "endpoint": {
            "type": "string",
            "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):"
          }
        },
        "not": {
          "properties": {
            "tokenSecret": {}
          },
          "required": [
            "tokenSecret"
          ]
        }
      }
    }
  ]
}
