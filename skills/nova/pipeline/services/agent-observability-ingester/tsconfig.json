{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "../../agent-observability/src/**/*.ts",
    "../../redis-transport.ts",
    "../telemetry/dispatch.js",
    "../observability.ts"
  ]
}
