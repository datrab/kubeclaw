{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "installationRoots",
    "trustedBuiltinRoots",
    "externalTrust",
    "providers",
    "grants",
    "adapters",
    "activeAdapters",
    "observers",
    "storageRoot",
    "shutdownTimeoutMs",
    "orchestratorIssuerId"
  ],
  "properties": {
    "schemaVersion": { "const": "pipeline-platform.v2" },
    "installationRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "trustedBuiltinRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "externalTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedSourceDigests", "verifiedAttestations"],
      "properties": {
        "allowedSourceDigests": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "verifiedAttestations": {
          "type": "object",
          "propertyNames": { "pattern": "^sha256:[a-f0-9]{64}$" },
          "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "grants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "activeAdapters": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "storageRoot": { "type": "string", "minLength": 1 },
    "shutdownTimeoutMs": { "type": "integer", "minimum": 1 },
    "orchestratorIssuerId": { "type": "string", "minLength": 1 }
  }
}
