{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "features",
    "tuning",
    "overrides",
    "schemaVersion",
    "components",
    "bindings"
  ],
  "properties": {
    "_doc": {
      "type": "string"
    },
    "profile": {
      "const": "standard"
    },
    "features": {
      "const": {
        "observability": true,
        "buster": true,
        "discord_alerts": true
      }
    },
    "tuning": {
      "const": {
        "safety_margins": "high",
        "retention": "high",
        "alerts": "rich",
        "logs": "verbose",
        "checks": "strict",
        "determinism": "strict"
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false
    },
    "schemaVersion": {
      "const": "pipeline-entry.v3"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prism-control",
        "prism-studio",
        "prism-worker",
        "prism-execution",
        "buster-engine",
        "worker-core"
      ],
      "properties": {
        "prism-control": {
          "const": "components/prism-control.config.json"
        },
        "prism-studio": {
          "const": "components/prism-studio.config.json"
        },
        "prism-worker": {
          "const": "components/prism-worker.config.json"
        },
        "prism-execution": {
          "const": "components/prism-execution.config.json"
        },
        "buster-engine": {
          "const": "components/buster-engine.config.json"
        },
        "worker-core": {
          "const": "components/worker-core.config.json"
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "owner",
          "instanceId",
          "profileId"
        ],
        "properties": {
          "role": {
            "enum": [
              "nova",
              "buster",
              "prism"
            ]
          },
          "owner": {
            "enum": [
              "prism-control",
              "prism-studio",
              "prism-worker",
              "prism-execution",
              "buster-engine",
              "worker-core"
            ]
          },
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "profileId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    }
  }
}
