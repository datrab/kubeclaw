{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowedRepositoryRoots",
    "workspaceRoot",
    "gitExecutable",
    "authorName",
    "authorEmail",
    "maxExecutionMs",
    "maxOutputBytes",
    "terminationGraceMs"
  ],
  "properties": {
    "allowedRepositoryRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "gitExecutable": { "type": "string", "minLength": 1 },
    "authorName": { "type": "string", "minLength": 1, "maxLength": 320, "pattern": "^[^\\r\\n\\u0000]+$" },
    "authorEmail": { "type": "string", "minLength": 1, "maxLength": 320, "pattern": "^[^\\r\\n\\u0000]+$" },
    "maxExecutionMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "terminationGraceMs": { "type": "integer", "minimum": 1, "maximum": 60000 }
  }
}
