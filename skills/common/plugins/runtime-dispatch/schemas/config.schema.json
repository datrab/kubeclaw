{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets",
    "targetByteProfiles",
    "payloadStructure"
  ],
  "properties": {
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint",
          "byteProfile"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "authentication": {
            "enum": [
              "hmac",
              "spiffe-proxy"
            ],
            "default": "hmac"
          },
          "tokenSecret": {
            "type": "string",
            "minLength": 1
          },
          "byteProfile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "authentication": {
                  "const": "spiffe-proxy"
                }
              },
              "required": [
                "authentication"
              ]
            },
            "then": {
              "properties": {
                "endpoint": {
                  "type": "string",
                  "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):"
                }
              },
              "not": {
                "properties": {
                  "tokenSecret": {}
                },
                "required": [
                  "tokenSecret"
                ]
              }
            },
            "else": {
              "properties": {
                "tokenSecret": {}
              },
              "required": [
                "tokenSecret"
              ]
            }
          }
        ]
      }
    },
    "targetByteProfiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maxRequestBytes",
          "maxResponseBytes"
        ],
        "properties": {
          "maxRequestBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          },
          "maxResponseBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          }
        }
      }
    },
    "payloadStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumDepth",
        "maximumArrayEntries",
        "maximumObjectProperties"
      ],
      "properties": {
        "maximumDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "maximumArrayEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maximumObjectProperties": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
