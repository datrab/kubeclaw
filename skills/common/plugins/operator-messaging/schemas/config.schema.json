{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets"],
  "properties": {
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9._:-]{0,126}[a-z0-9])?$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "tokenSecret"],
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "tokenSecret": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9._:-]{0,126}[a-z0-9])?$"
            },
            "maxPayloadBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576,
              "default": 65536
            }
          }
        }
      }
    }
  }
}
