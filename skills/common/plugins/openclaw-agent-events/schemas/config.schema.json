{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hooks",
    "maxQueueEvents",
    "maxQueueBytes",
    "drainTimeoutMs"
  ],
  "properties": {
    "hooks": {
      "type": "array",
      "items": {
        "enum": [
          "agent_end",
          "llm_input",
          "llm_output",
          "subagent_spawned",
          "subagent_delivery_target",
          "subagent_ended",
          "before_tool_call",
          "after_tool_call",
          "model_call_started",
          "model_call_ended",
          "session_start",
          "session_end"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "maxQueueEvents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maxQueueBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "drainTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    }
  }
}
