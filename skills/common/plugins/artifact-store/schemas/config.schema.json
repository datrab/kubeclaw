{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactRoot",
    "maxArtifactBytes",
    "maximumRecords",
    "maximumStoreBytes",
    "maximumRecordBytes"
  ],
  "properties": {
    "artifactRoot": {
      "type": "string",
      "minLength": 1
    },
    "maxArtifactBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maximumRecords": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maximumStoreBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maximumRecordBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
