{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint",
    "tokenSecret",
    "allowedRepositoryRoots",
    "unmigratedSuites",
    "suiteCapabilities",
    "gitExecutable",
    "maxArchiveBytes",
    "maxSuiteTimeoutMs",
    "pollMs"
  ],
  "properties": {
    "endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "tokenSecret": {
      "type": "string",
      "pattern": "^[a-z0-9._:-]+$"
    },
    "allowedRepositoryRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unmigratedSuites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "suiteCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gitExecutable": {
      "type": "string",
      "pattern": "^/"
    },
    "maxArchiveBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    },
    "maxSuiteTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200000
    },
    "pollMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    }
  }
}
