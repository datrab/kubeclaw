{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceName",
    "servicePort"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+(?::[0-9]{1,5})?/[a-z0-9]+(?:[._/-][a-z0-9]+)*@sha256:[a-f0-9]{64}$",
          "maxLength": 2048
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "serviceName": {
      "$ref": "#/$defs/dnsLabel"
    },
    "servicePort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "serviceTargetPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "namespacePrefix": {
      "$ref": "#/$defs/namespacePrefix"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "delete",
            "retain"
          ]
        },
        "seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        }
      }
    },
    "readinessTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "secretReferences": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$",
        "maxLength": 253
      }
    },
    "testCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "secretName"
      ],
      "properties": {
        "mode": {
          "const": "generate"
        },
        "secretName": {
          "$ref": "#/$defs/dnsLabel"
        }
      }
    },
    "fullStack": {
      "const": true
    },
    "verifiedImages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9.-]+(?::[0-9]{1,5})?/[a-z0-9]+(?:[._/-][a-z0-9]+)*@sha256:[a-f0-9]{64}$",
        "maxLength": 2048
      }
    },
    "podReplacementSelectors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 32,
        "additionalProperties": {
          "type": "string",
          "maxLength": 63
        }
      }
    },
    "familyclawBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "release"
      ],
      "properties": {
        "profile": {
          "const": "familyclaw.v1"
        },
        "release": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,34}$"
        }
      }
    },
    "testSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "secrets"
      ],
      "properties": {
        "values": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "random",
                  "tls"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 16,
                "maximum": 64
              },
              "encoding": {
                "type": "string",
                "enum": [
                  "hex",
                  "base64",
                  "base64url"
                ]
              },
              "host": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[A-Za-z0-9._-]{1,128}$",
              "not": {
                "pattern": "^\\.(\\.|$)"
              }
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "namespacePrefix": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,40}[a-z0-9])?$",
      "maxLength": 42
    }
  },
  "dependentRequired": {
    "fullStack": [
      "verifiedImages"
    ],
    "verifiedImages": [
      "fullStack"
    ],
    "podReplacementSelectors": [
      "fullStack"
    ]
  },
  "allOf": [
    {
      "if": {
        "required": [
          "familyclawBootstrap"
        ],
        "properties": {
          "familyclawBootstrap": {}
        }
      },
      "then": {
        "required": [
          "fullStack"
        ],
        "not": {
          "required": [
            "testCredentials"
          ],
          "properties": {
            "testCredentials": {}
          }
        },
        "properties": {
          "fullStack": {
            "const": true
          },
          "namespacePrefix": {
            "const": "test"
          },
          "secretReferences": {
            "maxItems": 0,
            "type": "array"
          },
          "retention": {
            "properties": {
              "seconds": {
                "maximum": 3600,
                "type": "integer"
              }
            },
            "type": "object"
          }
        }
      }
    }
  ]
}
