{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["routes"],
  "properties":{
    "url":{"type":"string","pattern":"^https?://","maxLength":2048},
    "endpointName":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":64},
    "routes":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^/(?!/)[^?#\\r\\n]*$","maxLength":1024}},
    "profiles":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","maxLength":64},"default":["desktop","mobile"]},
    "profileFile":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "tags":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128},"default":["wcag2a","wcag2aa"]},
    "exclude":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512},"default":[]},
    "acceptances":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["rule","route","selector","reason","expiresAt"],"properties":{
      "rule":{"type":"string","minLength":1,"maxLength":256},"route":{"type":"string","pattern":"^/(?!/)[^?#\\r\\n]*$","maxLength":1024},
      "selector":{"type":"string","minLength":1,"maxLength":512},"reason":{"type":"string","minLength":8,"maxLength":1024},
      "expiresAt":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
    }},"default":[]},
    "timeoutMs":{"type":"integer","minimum":1000,"maximum":120000,"default":30000}
  }
}
