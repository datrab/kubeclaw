{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["specFile"],
  "properties": {
    "specFile": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "endpointName": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "operations": { "type": "array", "minItems": 1, "maxItems": 128, "items": {
      "type": "object", "additionalProperties": false, "required": ["operationId"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pathParameters": { "type": "object", "maxProperties": 32, "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
        "query": { "type": "object", "maxProperties": 32, "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }] } },
        "headers": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "body": {}, "cleanup": { "type": "boolean", "default": false }, "expectedStatuses": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
      }
    } },
    "tags": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000, "default": 10000 },
    "maximumResponseBytes": { "type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576 }
  }, "anyOf": [
    { "required": ["operations"], "properties": { "operations": true } },
    { "required": ["tags"], "properties": { "tags": true } }
  ]
}
