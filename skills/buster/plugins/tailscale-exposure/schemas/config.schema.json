{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "endpointName": { "$ref": "#/$defs/dnsLabel" },
    "hostname": { "$ref": "#/$defs/dnsLabel" },
    "path": { "type": "string", "pattern": "^/(?:[^/?#\\r\\n][^?#\\r\\n]*)?$", "maxLength": 1024 },
    "readinessTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
  },
  "$defs": {
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" }
  }
}
