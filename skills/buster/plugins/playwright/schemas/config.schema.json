{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["projectDirectory","configFile"],
  "properties":{
    "url":{"type":"string","pattern":"^https?://","maxLength":2048},
    "endpointName":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "projectDirectory":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+)$"},
    "configFile":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "workers":{"type":"integer","minimum":1,"maximum":64},
    "timeoutMs":{"type":"integer","minimum":1000,"maximum":3600000,"default":600000}
  }
}
