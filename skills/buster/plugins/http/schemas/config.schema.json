{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "endpointName": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "path": { "type": "string", "pattern": "^/(?!/)", "maxLength": 2048 },
    "method": { "enum": ["GET", "HEAD"], "default": "GET" },
    "accept": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n]+$", "default": "*/*" },
    "expectedStatuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 100, "maximum": 599 }
    },
    "expectedText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "expectedContentType": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$" },
    "maximumResponseBytes": { "type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576 },
    "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000, "default": 10000 }
  }
}
