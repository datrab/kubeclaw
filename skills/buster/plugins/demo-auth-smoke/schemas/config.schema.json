{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "loginPath",
    "usernameKey",
    "passwordKey",
    "cookieName",
    "protectedPath",
    "usernamePointer",
    "assertions"
  ],
  "properties": {
    "protocol": {
      "const": "json-session.v1"
    },
    "loginPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "usernameKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "passwordKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "cookieName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "protectedPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "usernamePointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "equals"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "equals": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      }
    }
  }
}
