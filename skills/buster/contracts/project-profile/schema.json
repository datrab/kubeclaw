{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:kubeclaw:project-profile:v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "project", "sourceRevision", "ttlSeconds", "values", "secrets"],
  "properties": {
    "version": {"const": "project-profile.v1"},
    "project": {"$ref": "#/definitions/name"},
    "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "ttlSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "values": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "bytes", "encoding"], "properties": {
        "id": {"$ref": "#/definitions/name"}, "kind": {"const": "random"},
        "bytes": {"type": "integer", "minimum": 16, "maximum": 4096}, "encoding": {"enum": ["hex", "base64"]}
      }},
      {"type": "object", "additionalProperties": false, "required": ["id", "kind", "parts"], "properties": {
        "id": {"$ref": "#/definitions/name"}, "kind": {"const": "concat"},
        "parts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"$ref": "#/definitions/name"}}},
          {"type": "object", "additionalProperties": false, "required": ["literal"], "properties": {"literal": {"type": "string", "maxLength": 1024, "pattern": "^[ -~]*$"}}}
        ]}}
      }}
    ]}},
    "secrets": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "keys"], "properties": {
        "name": {"$ref": "#/definitions/name"},
        "keys": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false, "required": ["key", "value", "consumers"], "properties": {
            "key": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
            "value": {"$ref": "#/definitions/name"},
            "consumers": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
              "type": "object", "additionalProperties": false, "required": ["workload", "container"], "properties": {
                "workload": {"$ref": "#/definitions/name"}, "container": {"$ref": "#/definitions/name"}
              }
            }}
          }
        }}
      }
    }}
  },
  "definitions": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}}
}
