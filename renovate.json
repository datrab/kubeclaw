  "timezone": "Etc/UTC",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "ignorePaths": [
    "**/node_modules/**",
    "**/fixtures/**",
    "**/dist/**"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "node",
        "docker.io/library/node"
      ],
      "allowedVersions": "/^(22|24)([.-]|$)/"
    },
    {
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "envoyproxy/envoy",
        "/^ghcr.io/datrab/kubeclaw-/"
      ],
      "enabled": false,
      "description": "Envoy is centrally generated; our images are promoted from tested release manifests."
    },
    {
      "matchFileNames": [
        "versions.json"
      ],
      "postUpgradeTasks": {
        "commands": [
          "node /opt/kubeclaw-updates/updates/refresh-versions.mjs"
        ],
        "fileFilters": [
          "versions.json",
          "docker/**",
          "ops/pod/Dockerfile",
          "tools/ops-mcp/Dockerfile",
          "charts/**",
          "skills/common/plugins/openclaw-agent-observer/package.json",
          "scripts/scan-runtime-images.sh",
          ".github/workflows/*.yaml"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchPackageNames": [
        "kubernetes/kubernetes"
      ],
      "matchCurrentVersion": "/^1\\.34\\./",
      "allowedVersions": "/^1\\.34\\./"
    },
    {
      "matchPackageNames": [
        "kubernetes/kubernetes"
      ],
      "matchCurrentVersion": "/^1\\.35\\./",
      "allowedVersions": "/^1\\.35\\./"
    },
    {
      "matchPackageNames": [
        "openclaw/openclaw"
      ],
      "ignoreUnstable": false,
      "allowedVersions": "/^[0-9]{4}\\.[0-9]+\\.[0-9]+(-[0-9]+)?$/"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": "0 days",
    "dependencyDashboardApproval": false,
    "automerge": false,
    "labels": [
      "security"
    ]
  }
}
