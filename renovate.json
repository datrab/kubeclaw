  "timezone": "Etc/UTC",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "ignorePaths": [
    "**/node_modules/**",
    "**/fixtures/**",
    "**/dist/**"
  ],
  "packageRules": [
    {
      "description": "Identity images follow the selected chart; retain the installed CSI override during adoption.",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "gitops/platform/values/spire.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Monitoring images follow the selected chart releases; Promtail remains frozen for retirement.",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "gitops/platform/values/prometheus.yaml",
        "gitops/platform/values/loki.yaml",
        "gitops/platform/values/alloy.yaml",
        "gitops/platform/values/promtail-retired.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Production Redis image is generated from the central selection.",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "gitops/platform/values/redis.yaml",
        "gitops/platform/values/postgresql.yaml"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": [
        "node",
        "docker.io/library/node"
      ],
      "allowedVersions": "/^(22|24)([.-]|$)/"
    },
    {
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "envoyproxy/envoy",
        "/^ghcr.io/datrab/kubeclaw-/"
      ],
      "enabled": false,
      "description": "Envoy is centrally generated; our images are promoted from tested release manifests."
    },
    {
      "matchFileNames": [
        "versions.json"
      ],
      "postUpgradeTasks": {
        "commands": [
          "node /opt/kubeclaw-updates/updates/refresh-versions.mjs"
        ],
        "fileFilters": [
          "versions.json",
          "docker/**",
          "ops/pod/Dockerfile",
          "tools/ops-mcp/Dockerfile",
          "charts/**",
          "skills/common/plugins/openclaw-agent-observer/package.json",
          "scripts/scan-runtime-images.sh",
          ".github/workflows/*.yaml",
          "my-values/infra/**",
          "gitops/platform/values/redis.yaml",
          "gitops/platform/bootstrap/redis.yaml",
          "gitops/platform/bootstrap/prometheus.yaml",
          "gitops/platform/bootstrap/loki.yaml",
          "gitops/platform/bootstrap/alloy.yaml",
          "gitops/platform/bootstrap/promtail.yaml",
          "gitops/platform/values/postgresql.yaml",
          "gitops/platform/bootstrap/postgresql.yaml",
          "gitops/platform/bootstrap/spire.yaml",
          "gitops/platform/bootstrap/spire-crds.yaml",
          "gitops/platform/bootstrap/csi-driver-smb.yaml",
          "gitops/platform/litellm/resources.yaml"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchPackageNames": [
        "kubernetes/kubernetes"
      ],
      "matchCurrentVersion": "/^1\\.34\\./",
      "allowedVersions": "/^1\\.34\\./"
    },
    {
      "matchPackageNames": [
        "kubernetes/kubernetes"
      ],
      "matchCurrentVersion": "/^1\\.35\\./",
      "allowedVersions": "/^1\\.35\\./"
    },
    {
      "matchPackageNames": [
        "openclaw/openclaw"
      ],
      "ignoreUnstable": false,
      "allowedVersions": "/^[0-9]{4}\\.[0-9]+\\.[0-9]+(-[0-9]+)?$/"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Ops kubectl release modules must be updated together with the selected client version and source entry point.",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "ops/pod/kubectl-build/go.mod"
      ],
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/cli-runtime",
        "k8s.io/client-go",
        "k8s.io/component-base",
        "k8s.io/component-helpers",
        "k8s.io/kubectl",
        "k8s.io/metrics"
      ],
      "allowedVersions": "0.34.11"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": "0 days",
    "dependencyDashboardApproval": false,
    "automerge": false,
    "labels": [
      "security"
    ]
  }
}
