{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies"
  ],
  "enabledManagers": [
    "npm",
    "gomod",
    "github-actions",
    "helmv3",
    "helm-values",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"(?:[A-Z_]+_BASE|envoy|renovate|testRegistry)\": \"(?<depName>[^\"@]+?):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"openclaw\": \\{\\s*\"version\": \"(?<currentValue>[^\"\\n]+)\""
      ],
      "depNameTemplate": "openclaw/openclaw",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
