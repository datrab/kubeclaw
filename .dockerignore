# Keep image build contexts narrow. Runtime images contain durable tools and
# baked plugins only; agent skills are delivered by code bundles.
**

!docker/
!docker/Dockerfile.general
!docker/Dockerfile.buster-gateway
!docker/Dockerfile.buster-runtime
!docker/Dockerfile.namespace-controller
!docker/buster-runtime-entrypoint.sh

!go.mod
!cmd/
!cmd/buster-namespace-controller/
!cmd/buster-namespace-controller/**

!plugins/
!skills/
!skills/buster/
!skills/buster/plugins/
!skills/buster/plugins/buster-suite-runtime/
!skills/buster/plugins/buster-suite-runtime/**
!skills/common/
!skills/common/plugin-runtime/
!skills/common/plugin-runtime/sdk/
!skills/common/plugin-runtime/sdk/**
!skills/common/plugins/openclaw-agent-observer/
!skills/common/plugins/openclaw-agent-observer/**
!contracts/
!contracts/agent-observability/
!contracts/agent-observability/v1/
!contracts/agent-observability/v1/**

# Always keep deployment values and local operator state out of image contexts,
# even while my-values remains tracked as the audited deployment surface.
my-values/
.swarm/
worktrees/
.git/
.github/
.cache/
tmp/
/tmp/

# Local dependencies, generated output, logs, and secret-shaped files.
**/node_modules/
skills/common/plugins/openclaw-agent-observer/dist/
contracts/agent-observability/v1/dist/
*.log
**/*.log
*.env
.env
.env.*
**/*.key
**/*.pem
**/*.sops.yaml.dec
secrets.yml.dec
keys.txt
