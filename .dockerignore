# Keep image build contexts narrow. Dockerfiles currently copy only skills, the
# observer plugin source, and the namespace controller entrypoint.
**

!docker/
!docker/Dockerfile.general
!docker/Dockerfile.sandbox
!docker/Dockerfile.namespace-controller

!skills/
!skills/**

!plugins/
!plugins/openclaw-agent-observer/
!plugins/openclaw-agent-observer/**

!scripts/
!scripts/buster-namespace-controller.mjs

# Always keep deployment values and local operator state out of image contexts,
# even while my-values remains tracked as the audited deployment surface.
my-values/
.swarm/
worktrees/
.git/
.github/
.cache/
tmp/
/tmp/

# Local dependencies, generated output, logs, and secret-shaped files.
**/node_modules/
plugins/openclaw-agent-observer/dist/
*.log
**/*.log
*.env
.env
.env.*
**/*.key
**/*.pem
**/*.sops.yaml.dec
secrets.yml.dec
keys.txt
