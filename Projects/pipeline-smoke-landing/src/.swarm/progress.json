{
  "project": "pipeline-smoke-landing",
  "version": 1,
  "description": "Small landing-page smoke test for the OpenClaw autonomous pipeline.",
  "notes": [
    "Approval gates are intentionally omitted for this run.",
    "Tailscale preview serving is intentionally disabled until the operator is installed.",
    "Architecture branch: pipeline-smoke-landing/architecture"
  ],
  "defaults": {
    "models": {
      "forge": "codex-5.4",
      "buster": "codex-5.4",
      "echo": "codex-5.4",
      "arch_validator": "codex-5.4"
    },
    "reviewers": [
      {
        "label": "echo-codex",
        "model": "codex-5.4",
        "dispatch": "subagent",
        "agent_id": "codex"
      }
    ],
    "thinking": {
      "forge": "adaptive",
      "buster": "adaptive",
      "echo": "high",
      "arch_validator": "adaptive"
    }
  },
  "arch_validation": {
    "enabled": true,
    "model": "codex-5.4",
    "thinking_level": "adaptive"
  },
  "pipeline_review": {
    "enabled": true,
    "model": "codex-5.4",
    "thinking_level": "high",
    "agent_id": "codex",
    "instructions_file": "pipeline-review/PIPELINE-REVIEW-INSTRUCTIONS.md",
    "output_file": "logs/pipeline-review/PIPELINE-REVIEW.md",
    "json_output_file": "logs/pipeline-review/PIPELINE-REVIEW.json"
  },
  "case_study": {
    "enabled": true,
    "model": "codex-5.4",
    "thinking_level": "adaptive",
    "agent_id": "codex",
    "output_file": "logs/pipeline/case-study.md",
    "timeout_minutes": 30
  },
  "telemetry": {
    "enabled": true
  },
  "payload": {
    "rate_limit": {
      "max_pauses": 3,
      "initial_cooldown_s": 45,
      "max_cooldown_s": 240
    }
  },
  "execution_order": [
    "01-foundation",
    "gate:module-01-review",
    "02-content-polish",
    "03-kubernetes",
    "gate:module-03-review",
    "gate:final-buster",
    "gate:final-review"
  ],
  "modules": {
    "01-foundation": {
      "title": "Landing page foundation, Dockerfile, and first section",
      "dir": "01-foundation",
      "depends_on": [],
      "stages": [
        "forge",
        "buster"
      ],
      "timeout_minutes": 120,
      "max_fails": 2,
      "thinking_level": "adaptive",
      "test_suites": [
        "build",
        "health",
        "unit"
      ],
      "capabilities": [
        "container_runtime",
        "browser_automation"
      ],
      "test_config": {
        "serve": {
          "type": "server",
          "project_dir": "Projects/pipeline-smoke-landing/src",
          "start_cmd": "PORT=43101 npm start",
          "image": "localhost/pipeline-smoke-landing:module-01",
          "port": 43101,
          "health_path": "/health",
          "health_retries": 6,
          "health_base_delay": 1000,
          "health_timeout": 10000,
          "dockerfile": "Projects/pipeline-smoke-landing/src/Dockerfile",
          "build_context": "Projects/pipeline-smoke-landing/src",
          "build_timeout": 300,
          "smoke_paths": [
            "/"
          ],
          "smoke_settle_ms": 250
        },
        "unit": {
          "test_cmd": "npm test",
          "thresholds": {
            "max_failures": 0
          }
        }
      }
    },
    "02-content-polish": {
      "title": "Second landing-page section and responsive polish",
      "dir": "02-content-polish",
      "depends_on": [
        "01-foundation"
      ],
      "stages": [
        "forge"
      ],
      "timeout_minutes": 90,
      "max_fails": 2,
      "thinking_level": "adaptive",
      "test_suites": []
    },
    "03-kubernetes": {
      "title": "Kubernetes deployment, service, and final section",
      "dir": "03-kubernetes",
      "depends_on": [
        "02-content-polish"
      ],
      "stages": [
        "forge"
      ],
      "timeout_minutes": 90,
      "max_fails": 2,
      "thinking_level": "adaptive",
      "test_suites": []
    }
  },
  "gates": {
    "module-01-review": {
      "type": "review",
      "title": "Module 01 review gate",
      "review_name": "MODULE-01-REVIEW",
      "on_fail": "fix_and_rereview",
      "instructions_file": "echo-review/MODULE-01-REVIEW-INSTRUCTIONS.md",
      "output_file": "logs/echo-review/MODULE-01-REVIEW.json",
      "review_output_dir": "logs/echo-review",
      "primary_reviewer": "echo-codex",
      "forge_model": "codex-5.4",
      "forge_thinking_level": "adaptive",
      "timeout_minutes": 45,
      "max_fix_cycles": 2,
      "lint_tier": "full"
    },
    "module-03-review": {
      "type": "review",
      "title": "Module 03 review gate",
      "review_name": "MODULE-03-REVIEW",
      "on_fail": "fix_and_rereview",
      "instructions_file": "echo-review/MODULE-03-REVIEW-INSTRUCTIONS.md",
      "output_file": "logs/echo-review/MODULE-03-REVIEW.json",
      "review_output_dir": "logs/echo-review",
      "primary_reviewer": "echo-codex",
      "forge_model": "codex-5.4",
      "forge_thinking_level": "adaptive",
      "timeout_minutes": 45,
      "max_fix_cycles": 2,
      "lint_tier": "full"
    },
    "final-buster": {
      "type": "buster",
      "title": "Final Buster validation",
      "on_fail": "fix_and_retest",
      "instructions_file": "buster-test/FINAL-BUSTER.md",
      "output_file": "buster-test/FINAL-BUSTER-RESULT.json",
      "model": "codex-5.4",
      "forge_model": "codex-5.4",
      "timeout_minutes": 90,
      "max_fix_cycles": 2,
      "test_suites": [
        "build",
        "health",
        "unit",
        "manifest",
        "k8s"
      ],
      "capabilities": [
        "container_runtime",
        "browser_automation"
      ],
      "test_config": {
        "serve": {
          "type": "server",
          "project_dir": "Projects/pipeline-smoke-landing/src",
          "start_cmd": "PORT=43101 npm start",
          "image": "localhost/pipeline-smoke-landing:final",
          "port": 43101,
          "health_path": "/health",
          "health_retries": 6,
          "health_base_delay": 1000,
          "health_timeout": 10000,
          "dockerfile": "Projects/pipeline-smoke-landing/src/Dockerfile",
          "build_context": "Projects/pipeline-smoke-landing/src",
          "build_timeout": 300,
          "smoke_paths": [
            "/"
          ],
          "smoke_settle_ms": 250
        },
        "unit": {
          "test_cmd": "npm test",
          "thresholds": {
            "max_failures": 0
          }
        },
        "manifest": {
          "deployment_yaml": "Projects/pipeline-smoke-landing/src/k8s/pipeline-smoke-landing.yaml",
          "required_env": [
            "NODE_ENV"
          ],
          "thresholds": {
            "max_missing_env": 0
          }
        },
        "k8s": {
          "dockerfile": "Projects/pipeline-smoke-landing/src/Dockerfile",
          "build_context": "Projects/pipeline-smoke-landing/src",
          "image_name": "pipeline-smoke-landing",
          "service_name": "pipeline-smoke-landing",
          "manifests": [
            "Projects/pipeline-smoke-landing/src/k8s/pipeline-smoke-landing.yaml"
          ],
          "port": 43101,
          "health_path": "/health",
          "purpose": "pretest",
          "cleanup_policy": "delete",
          "namespace_prefix": "test",
          "ready_timeout_seconds": 120,
          "preview": {
            "provider": "off",
            "path": "/"
          }
        }
      }
    },
    "final-review": {
      "type": "review",
      "title": "Final review",
      "review_name": "FINAL-REVIEW",
      "on_fail": "fix_and_rereview",
      "instructions_file": "echo-review/FINAL-REVIEW-INSTRUCTIONS.md",
      "output_file": "logs/echo-review/FINAL-REVIEW.json",
      "review_output_dir": "logs/echo-review",
      "primary_reviewer": "echo-codex",
      "forge_model": "codex-5.4",
      "forge_thinking_level": "adaptive",
      "timeout_minutes": 60,
      "max_fix_cycles": 2,
      "lint_tier": "full"
    }
  }
}
