            ]
          ]
        },
        {
          "path": "charts/ops-pod/templates/rbac.yaml",
          "ranges": [
            [
              65,
              92
            ]
          ]
        },
        {
          "path": "charts/ops-pod/templates/kubeconfig.yaml",
          "ranges": [
            [
              1,
              26
            ]
          ]
        }
      ],
      "suggestedFiniteCorrection": "Nonempty execNamespaces enables Codex token/kubeconfig mounts and namespace-scoped exec; MCP keeps the same ServiceAccount token, including those effective grants."
    }
