  "findings": [
    {
      "id": "F1",
      "priority": "P2",
      "boxIndex": 30,
      "page": "docs/site/understand/platform-and-operations.md",
      "line": 1014,
      "title": "Do not label the shared ServiceAccount credential as a separate read token",
      "body": "The new Contract/setting says MCP retains its read token separately when execNamespaces enables Codex exec. Both containers mount the same projected kube-api volume and use the same ServiceAccount. Namespace exec grants bind that identity, so the MCP-held credential also has those effective exec rights. The surrounding existing prose and links correctly say the credential is shared; the new field contradicts that boundary. Describe the retained MCP mount of the same ServiceAccount token, not a separate read-only token.",
      "sources": [
        {
          "path": "charts/ops-pod/templates/workload.yaml",
          "ranges": [
            [
              38,
              39
            ],
            [
              74,
              77
            ],
