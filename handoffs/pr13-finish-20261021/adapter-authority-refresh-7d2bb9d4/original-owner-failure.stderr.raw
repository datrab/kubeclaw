          '      `${field.sourcePath}#${fieldPath}: runtime proof is not pinned to source content`);\n' +
          '  }\n' +
          '}'
      },
      {
        kind: 'FirstStatement',
        syntax: "const automountIgnoredTrue = render('--set', 'serviceAccount.create=false', '--set', 'serviceAccount.automount=true');"
      },
      {
        kind: 'FirstStatement',
        syntax: "const automountIgnoredFalse = render('--set', 'serviceAccount.create=false', '--set', 'serviceAccount.automount=false');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.equal(automountIgnoredTrue.status, 0, automountIgnoredTrue.stderr);'
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.equal(automountIgnoredFalse.status, 0, automountIgnoredFalse.stderr);'
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.equal(automountIgnoredTrue.stdout, automountIgnoredFalse.stdout,\n' +
          "  'serviceAccount.automount changed output while serviceAccount.create=false');"
      },
      {
        kind: 'FirstStatement',
        syntax: "const busterLeaseFalse = spawnSync('helm', [\n" +
          "  'template', 'acceptance', 'charts/kubeclaw', '-f', 'my-values/buster-values.yaml',\n" +
          "  '--set', 'busterNamespaceBroker.enabled=true', '--set', 'busterNamespaceBroker.leaseClient.enabled=false',\n" +
          "  '--set', 'runtimeInfrastructure.registry.endpoint=http://registry.local:5000',\n" +
          "  '--set', 'runtimeInfrastructure.registry.transport=http-lab',\n" +
          "], { cwd: root, encoding: 'utf8' });"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.equal(busterLeaseFalse.status, 0, busterLeaseFalse.stderr);'
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(busterLeaseFalse.stdout, /name: agent-buster-namespace-lease-client/u,\n' +
          "  'Buster role no longer force-enables lease-client RBAC');"
      },
      {
        kind: 'FirstStatement',
        syntax: "const deploymentTemplate = fs.readFileSync('charts/kubeclaw/templates/deployment.yaml', 'utf8');"
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const [sourceExpression, documentedPaths] of [\n' +
          `  ["if (mode === 'liveness')", ['$.probes.dependencies.gateway.enabled']],\n` +
          `  ["enabled('KUBECLAW_HEALTH_CHECK_GATEWAY', true)", ['$.probes.dependencies.gateway.enabled']],\n` +
          `  ["enabled('KUBECLAW_HEALTH_CHECK_REDIS', true)", ['$.probes.dependencies.redis.enabled']],\n` +
          `  ["enabled('KUBECLAW_HEALTH_CHECK_REDIS_STREAM', true)", ['$.probes.dependencies.redisStream.enabled']],\n` +
          `  ["enabled('KUBECLAW_HEALTH_CHECK_LITELLM', false)", ['$.probes.dependencies.litellm.enabled']],\n` +
          `  ["enabled('KUBECLAW_HEALTH_CHECK_REGISTRIES', false)", ['$.probes.dependencies.registries.enabled']],\n` +
          ']) {\n' +
          "  assert.match(deploymentTemplate, new RegExp(sourceExpression.replace(/[.*+?^${}()|[\\]\\\\]/gu, '\\\\$&'), 'u'),\n" +
          '    `health implementation no longer contains ${sourceExpression}`);\n' +
          '  for (const fieldPath of documentedPaths) {\n' +
          '    assert(booleanAuthorities.some((field) => field.fieldPath === fieldPath),\n' +
          '      `${fieldPath}: dependency-switch documentation is missing`);\n' +
          '  }\n' +
          '}'
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(deploymentTemplate, /return \\/\\^\\(1\\|true\\|yes\\|on\\)\\$\\/i\\.test\\(raw\\)/u,\n' +
          "  'health Boolean parser no longer recognizes the documented true tokens');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: "assert.match(deploymentTemplate, /if \\(raw === undefined \\|\\| raw === ''\\) return defaultValue/u,\n" +
          "  'health Boolean parser no longer applies the documented empty-value default');"
      },
      {
        kind: 'FirstStatement',
        syntax: "const renderOpsPolicy = (parent, child) => spawnSync('helm', [\n" +
          "  'template', 'acceptance', 'charts/ops-pod',\n" +
          "  '--set', 'codexImage=example.invalid/codex@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',\n" +
          "  '--set', 'mcpImage=example.invalid/mcp@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb',\n" +
          "  '--set', 'networkPolicy.apiServerCIDRs[0]=10.0.0.1/32',\n" +
          "  '--set', `networkPolicy.enabled=${parent}`,\n" +
          "  '--set', `networkPolicy.cilium=${child}`,\n" +
          "], { cwd: root, encoding: 'utf8' });"
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const [parent, child, portable, cilium] of [\n' +
          '  [false, false, false, false],\n' +
          '  [false, true, false, false],\n' +
          '  [true, false, true, false],\n' +
          '  [true, true, true, true],\n' +
          ']) {\n' +
          '  const result = renderOpsPolicy(parent, child);\n' +
          '  assert.equal(result.status, 0, `Ops policy truth-table render failed\\n${result.stderr}`);\n' +
          '  assert.equal(/^kind: NetworkPolicy$/mu.test(result.stdout), portable,\n' +
          '    `networkPolicy.enabled=${parent}, cilium=${child}: portable policy result changed`);\n' +
          '  assert.equal(/^kind: CiliumNetworkPolicy$/mu.test(result.stdout), cilium,\n' +
          '    `networkPolicy.enabled=${parent}, cilium=${child}: Cilium policy result changed`);\n' +
          '}'
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'console.log(`local Helm Boolean semantics verified (${booleanAuthorities.length} authorities; truthiness and strict-function render controls passed)`);'
      }
    ]
  },
  expected: {
    language: 'TypeScript',
    statements: [
      {
        kind: 'ImportDeclaration',
        syntax: "import assert from 'node:assert/strict';"
      },
      {
        kind: 'ImportDeclaration',
        syntax: "import { spawnSync } from 'node:child_process';"
      },
      {
        kind: 'ImportDeclaration',
        syntax: "import fs from 'node:fs';"
      },
      { kind: 'FirstStatement', syntax: 'const root = process.cwd();' },
      {
        kind: 'FirstStatement',
        syntax: "const registry = JSON.parse(fs.readFileSync('scripts/docs-local-helm-field-authorities.json', 'utf8'));"
      },
      {
        kind: 'FirstStatement',
        syntax: 'const booleanAuthorities = Object.entries(registry.files).flatMap(([sourcePath, file]) =>\n' +
          '  Object.entries(file.fields)\n' +
          '    .filter(([, field]) => field.booleanInputSemantics)\n' +
          '    .map(([fieldPath, field]) => ({ sourcePath, fieldPath, ...field })));'
      },
      {
        kind: 'ExpressionStatement',
        syntax: "assert.equal(booleanAuthorities.length, 93, 'local Helm Boolean authority coverage changed');"
      },
      {
        kind: 'FirstStatement',
        syntax: 'const registryText = JSON.stringify(booleanAuthorities);'
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const forbidden of [\n' +
          "  'Disabling a required dependency makes its consumers unready',\n" +
          "  'can preserve, replace, reject, or reinterpret',\n" +
          "  'active and rendered',\n" +
          "  'JSON receives a string',\n" +
          ']) {\n' +
          "  assert.doesNotMatch(registryText, new RegExp(forbidden, 'u'),\n" +
          '    `generic Boolean contract text returned: ${forbidden}`);\n' +
          '}'
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const field of booleanAuthorities) {\n' +
          '  const label = `${field.sourcePath}#${field.fieldPath}`;\n' +
          '  assert.match(field.failure, /YAML Boolean|schema validation|template comparison|type guard/u,\n' +
          '    `${label}: invalid-type behavior is not explicit`);\n' +
          '  assert.match(field.emptyBehavior, /omitted override/u, `${label}: omission behavior is not explicit`);\n' +
          "  if (field.booleanInputSemantics.receivers.includes('helm-truthiness')\n" +
          "    && field.booleanInputSemantics.validation !== 'chart-schema-boolean') {\n" +
          '    assert.match(field.failure, /non-empty string/u, `${label}: Helm string truthiness is not documented`);\n' +
          '    assert.match(field.failure, /`"false"`/u, `${label}: quoted false hazard is not documented`);\n' +
          '  }\n' +
          '}'
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const [sourcePath, fieldPath, expected] of [\n' +
          "  ['charts/kubeclaw/values.yaml', '$.archviewer.enabled', 'receiver-specific-without-schema'],\n" +
          "  ['charts/prism/values.yaml', '$.control.productDecisions.enabled', 'chart-schema-boolean'],\n" +
          "  ['my-values/prism-values.yaml', '$.workerTrust.spiffe.enabled', 'chart-schema-boolean'],\n" +
          ']) {\n' +
          '  assert.equal(registry.files[sourcePath]?.fields[fieldPath]?.booleanInputSemantics?.validation, expected,\n' +
          '    `${sourcePath}#${fieldPath}: unexpected Boolean validation authority`);\n' +
          '}'
      },
      {
        kind: 'FirstStatement',
        syntax: "const render = (...values) => spawnSync('helm', [\n" +
          "  'template', 'acceptance', 'charts/kubeclaw',\n" +
          "  '--set', 'agentRole=nova',\n" +
          "  '--set', 'archviewer.existingSecret=acceptance-secret',\n" +
          '  ...values,\n' +
          "], { cwd: root, encoding: 'utf8' });"
      },
      {
        kind: 'FirstStatement',
        syntax: "const booleanFalse = render('--set', 'archviewer.enabled=false');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.equal(booleanFalse.status, 0, `Boolean false render failed\\n${booleanFalse.stderr}`);'
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.doesNotMatch(booleanFalse.stdout, /agent-nova-archviewer/u,\n' +
          "  'Boolean false unexpectedly rendered Archviewer resources');"
      },
      {
        kind: 'FirstStatement',
        syntax: "const stringFalse = render('--set-string', 'archviewer.enabled=false');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.equal(stringFalse.status, 0, `string false render failed\\n${stringFalse.stderr}`);'
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(stringFalse.stdout, /agent-nova-archviewer/u,\n' +
          "  'quoted false no longer demonstrates the documented Helm truthiness hazard');"
      },
      {
        kind: 'FirstStatement',
        syntax: 'const discordStringFalse = render(\n' +
          "  '--set', 'archviewer.enabled=false',\n" +
