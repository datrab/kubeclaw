          "  const externalAuthority = fieldPath.includes('.securityContext.')\n" +
          '    ? /\\[Kubernetes 1\\.35 SecurityContext API\\]\\(https:\\/\\/kubernetes\\.io\\/docs\\/reference\\/generated\\/kubernetes-api\\/v1\\.35\\/#securitycontext-v1-core\\)/u\n' +
          '    : /\\[Kubernetes 1\\.35 VolumeMount API\\]\\(https:\\/\\/kubernetes\\.io\\/docs\\/reference\\/generated\\/kubernetes-api\\/v1\\.35\\/#volumemount-v1-core\\)/u;\n' +
          '  assert.match(field.acceptedValues, externalAuthority,\n' +
          '    `${sourcePath}#${fieldPath}: versioned Kubernetes runtime authority is missing`);\n' +
          '}'
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const [fieldPath, expectedLines] of [\n' +
          "  ['$.codeBundle.enabled', [950, 1009]],\n" +
          "  ['$.discord.enabled', [221, 297]],\n" +
          "  ['$.probes.dependencies.gateway.enabled', [784, 969, 976, 984]],\n" +
          "  ['$.probes.dependencies.redis.enabled', [784, 977, 985]],\n" +
          "  ['$.probes.dependencies.redisStream.enabled', [784, 978]],\n" +
          "  ['$.probes.dependencies.litellm.enabled', [784, 979]],\n" +
          "  ['$.probes.dependencies.registries.enabled', [784, 980]],\n" +
          "  ['$.swarmConfig.overrideOnRestart', [707, 715, 722]],\n" +
          "  ['$.workspace.overrideOnRestart', [458, 460]],\n" +
          ']) {\n' +
          '  const matching = booleanAuthorities.filter((field) => field.fieldPath === fieldPath);\n' +
