      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(discordStringFalse.stdout, /"discord": \\{\\s*"enabled": false,/su,\n' +
          "  'Discord string false no longer renders a JSON Boolean false');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(discordStringFalse.stdout, /"channel": "discord"/u,\n' +
          "  'Discord string false no longer proves Helm-truthy binding enablement');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(discordStringFalse.stdout, /name: DISCORD_TOKEN/u,\n' +
          "  'Discord string false no longer proves Helm-truthy token wiring');"
      },
      {
        kind: 'FirstStatement',
        syntax: "const strictStringFalse = spawnSync('helm', [\n" +
          "  'template', 'acceptance', 'charts/kubeclaw',\n" +
          "  '--set', 'agentRole=nova',\n" +
          "  '--set-string', 'runAsRoot=false',\n" +
          "], { cwd: root, encoding: 'utf8' });"
      },
      {
        kind: 'ExpressionStatement',
        syntax: "assert.notEqual(strictStringFalse.status, 0, 'string false unexpectedly passed the strict runAsRoot ternary receiver');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(`${strictStringFalse.stdout}\\n${strictStringFalse.stderr}`, /expected bool; got string/u,\n' +
          "  'strict runAsRoot failure did not prove the Boolean receiver contract');"
      },
      {
        kind: 'FirstStatement',
        syntax: "const runAsRoot = registry.files['charts/kubeclaw/values.yaml'].fields['$.runAsRoot'];"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.deepEqual(runAsRoot.booleanInputSemantics.receivers,\n' +
          "  ['helm-truthiness', 'quoted-runtime-string', 'strict-boolean-function'],\n" +
