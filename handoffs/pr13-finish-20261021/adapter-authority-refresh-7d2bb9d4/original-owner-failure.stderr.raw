          '  assert.match(field.failure, /SPIFFE worker trust or the Nova readiness client/u,\n' +
          '    `${field.sourcePath}: conditional release-ServiceAccount requirements are missing`);\n' +
          '}'
      },
      {
        kind: 'FirstStatement',
        syntax: "const defaultServiceAccount = spawnSync('helm', [\n" +
          "  'template', 'acceptance', 'charts/kubeclaw',\n" +
          "  '--set', 'agentRole=nova',\n" +
          "  '--set', 'serviceAccount.create=false',\n" +
          "  '--set', 'workerTrust.spiffe.enabled=false',\n" +
          "  '--set', 'busterNamespaceBroker.readyClient.enabled=false',\n" +
          "], { cwd: root, encoding: 'utf8' });"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.equal(defaultServiceAccount.status, 0,\n' +
          '  `serviceAccount.create=false ordinary render failed\\n${defaultServiceAccount.stderr}`);'
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.doesNotMatch(defaultServiceAccount.stdout, /^kind: ServiceAccount$/mu,\n' +
          "  'serviceAccount.create=false unexpectedly rendered a ServiceAccount');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.doesNotMatch(defaultServiceAccount.stdout, /^\\s*serviceAccountName:/mu,\n' +
          "  'serviceAccount.create=false unexpectedly selected a named ServiceAccount');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(defaultServiceAccount.stdout, /^\\s*automountServiceAccountToken: false$/mu,\n' +
          "  'serviceAccount.create=false did not disable automatic token mounting');"
      },
      {
        kind: 'FirstStatement',
        syntax: "const requiredReleaseServiceAccount = spawnSync('helm', [\n" +
          "  'template', 'acceptance', 'charts/kubeclaw',\n" +
          "  '--set', 'agentRole=nova',\n" +
          "  '--set', 'serviceAccount.create=false',\n" +
          "  '--set', 'workerTrust.spiffe.enabled=true',\n" +
          "], { cwd: root, encoding: 'utf8' });"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.notEqual(requiredReleaseServiceAccount.status, 0,\n' +
          "  'SPIFFE worker trust unexpectedly rendered without the release-specific ServiceAccount');"
      },
      {
        kind: 'ExpressionStatement',
        syntax: 'assert.match(`${requiredReleaseServiceAccount.stdout}\\n${requiredReleaseServiceAccount.stderr}`,\n' +
          '  /workerTrust\\.spiffe requires serviceAccount\\.create=true/u,\n' +
          "  'SPIFFE failure did not prove the conditional release-ServiceAccount requirement');"
      },
      {
        kind: 'FirstStatement',
        syntax: 'const behavioralContracts = [\n' +
          "  ['$.serviceAccount.automount', 5, /renders `automountServiceAccountToken: false` on both.*Pod independently forces/isu],\n" +
          "  ['$.busterNamespaceBroker.enabled', 4, /agentRole=buster|non-Buster release/iu],\n" +
          "  ['$.busterNamespaceBroker.controller.readiness.enabled', 1, /Outside that parent and role path.*no rendered effect/iu],\n" +
          "  ['$.busterNamespaceBroker.controller.productDecisions.enabled', 1, /Outside that parent and role path.*no rendered effect/iu],\n" +
          "  ['$.busterNamespaceBroker.leaseClient.enabled', 2, /cannot disable lease-client RBAC|ignores `false`/iu],\n" +
          "  ['$.busterNamespaceBroker.leaseClient.verificationRead.enabled', 2, /parent broker.*effective lease client.*ServiceAccount/iu],\n" +
          "  ['$.codeBundle.enabled', 4, /environment entry.*rendered in both cases|without adding or removing a Deployment resource branch/iu],\n" +
          "  ['$.probes.dependencies.gateway.enabled', 1, /startup, readiness, and liveness.*gateway `\\/health`/isu],\n" +
          "  ['$.probes.dependencies.litellm.enabled', 1, /startup probe.*LiteLLM `\\/health`/isu],\n" +
          "  ['$.probes.dependencies.redis.enabled', 2, /startup and readiness.*`PING`.*`PONG`/isu],\n" +
          "  ['$.probes.dependencies.redisStream.enabled', 1, /startup probe.*mutating.*`XADD`/isu],\n" +
          "  ['$.probes.dependencies.registries.enabled', 2, /startup probe.*`\\/v2\\/`.*HTTP 401/isu],\n" +
          "  ['$.probes.liveness.enabled', 1, /does not restart the container/iu],\n" +
          "  ['$.probes.readiness.enabled', 1, /become Ready without/iu],\n" +
          "  ['$.probes.startup.enabled', 1, /slow startup is exposed/iu],\n" +
          "  ['$.persistence.config.enabled', 1, /emptyDir.*lost when the Pod is replaced/isu],\n" +
          "  ['$.persistence.workspace.enabled', 1, /emptyDir.*lost when the Pod is replaced/isu],\n" +
          "  ['$.networkPolicy.enabled', 1, /workload remains present.*loses.*restrictions/isu],\n" +
          "  ['$.networkPolicy.cilium', 1, /networkPolicy\\.enabled=false.*neither policy renders/isu],\n" +
          "  ['$.workspace.enabled', 6, /does not remove the `\\/workspace` volume|volume, mount, and runtime directories remain/iu],\n" +
          "  ['$.workspace.overrideOnRestart', 2, /workspace\\.enabled=false.*no managed seed files|no effect when workspace seeding is disabled/iu],\n" +
          '];'
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const [fieldPath, count, proof] of behavioralContracts) {\n' +
          '  const authorities = booleanAuthorities.filter((field) => field.fieldPath === fieldPath);\n' +
          '  assert.equal(authorities.length, count, `${fieldPath}: behavioral authority coverage changed`);\n' +
          '  for (const field of authorities) {\n' +
          '    const prose = `${field.purpose} ${field.acceptedValues} ${field.impact} ${field.failure}`;\n' +
          '    assert.match(prose, proof, `${field.sourcePath}#${fieldPath}: source-specific behavior proof is missing`);\n' +
          '    assert.doesNotMatch(prose, /Disabling a required dependency makes its consumers unready/iu,\n' +
          '      `${field.sourcePath}#${fieldPath}: generic enabled-field failure text returned`);\n' +
          '  }\n' +
          '}'
      },
      {
        kind: 'FirstStatement',
        syntax: 'const sourceSpecificContracts = [\n' +
          "  ['$.agent.git.enabled', 6, /SSH Secret.*clones or reconciles.*workspace and `REPO_ROOT`/isu],\n" +
          "  ['$.archviewer.enabled', 2, /sidecar itself is supplied separately.*Kubernetes rejects the Pod/isu],\n" +
          "  ['$.busterNamespaceBroker.readyClient.enabled', 1, /not gated by `busterNamespaceBroker.enabled`/iu],\n" +
          "  ['$.busterRuntimePersistence.enabled', 2, /creates no claim.*pre-existing claim/isu],\n" +
          "  ['$.discord.enabled', 6, /raw JSON value blank.*`openclaw\\.json` invalid/isu],\n" +
          "  ['$.gateway.startupDoctor.enabled', 3, /doctor --fix --non-interactive.*legacy state remains unmigrated/isu],\n" +
          "  ['$.workerTrust.spiffe.enabled', 4, /capabilities with `proxyPort`.*SPIFFE/isu],\n" +
          '];'
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const [fieldPath, count, proof] of sourceSpecificContracts) {\n' +
          '  const allAuthorities = booleanAuthorities.filter((field) => field.fieldPath === fieldPath\n' +
          "    && (field.sourcePath === 'charts/kubeclaw/values.yaml'\n" +
          "      || (field.sourcePath.startsWith('my-values/') && field.sourcePath !== 'my-values/prism-values.yaml')));\n" +
          "  const selected = fieldPath === '$.workerTrust.spiffe.enabled' ? allAuthorities :\n" +
          '    booleanAuthorities.filter((field) => field.fieldPath === fieldPath);\n' +
          '  assert.equal(selected.length, count, `${fieldPath}: source-specific authority coverage changed`);\n' +
          '  for (const field of selected) {\n' +
          '    assert.match(`${field.purpose} ${field.acceptedValues} ${field.emptyBehavior} ${field.impact} ${field.failure}`,\n' +
          '      proof, `${field.sourcePath}#${fieldPath}: exact operational contract is missing`);\n' +
          '  }\n' +
          '}'
      },
      {
        kind: 'ForOfStatement',
        syntax: 'for (const [sourcePath, fieldPath, proof] of [\n' +
          "  ['charts/ops-pod/values.yaml', '$.tailscale.enabled', /main Ops workload present.*Kubernetes-local|non-Tailscale paths/isu],\n" +
          "  ['charts/prism/values.yaml', '$.control.productDecisions.enabled', /separate signing Secret.*operator allowlist/isu],\n" +
          "  ['charts/prism/values.yaml', '$.ingestion.enabled', /Deployment, Service, and dedicated NetworkPolicy.*still receives the ingestion URL/isu],\n" +
          "  ['my-values/prism-values.yaml', '$.ingestion.enabled', /Deployment, Service, and dedicated NetworkPolicy.*still receives the ingestion URL/isu],\n" +
          "  ['charts/prism/values.yaml', '$.postgresql.enabled', /migration, backup, and verification stack.*externally managed/isu],\n" +
          "  ['my-values/prism-values.yaml', '$.postgresql.enabled', /migration, backup, and verification stack.*externally managed/isu],\n" +
          "  ['charts/prism/values.yaml', '$.tailscale.enabled', /Studio cluster-internal.*Product decisions require/isu],\n" +
          "  ['my-values/prism-values.yaml', '$.tailscale.enabled', /Studio cluster-internal.*Product decisions require/isu],\n" +
          "  ['charts/prism/values.yaml', '$.workerTrust.spiffe.enabled', /control and worker Envoy sidecars.*direct port 8080/isu],\n" +
          "  ['my-values/prism-values.yaml', '$.workerTrust.spiffe.enabled', /control and worker Envoy sidecars.*direct port 8080/isu],\n" +
