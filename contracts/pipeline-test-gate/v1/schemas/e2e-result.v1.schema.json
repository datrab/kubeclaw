{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubeclaw.dev/contracts/pipeline-test-gate/e2e-result.v1.schema.json",
  "title": "KubeClaw common end-to-end provider result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "targetOrigin", "workers", "browserProjects", "testCases", "counts", "reportFormat", "resourceEnforcement"],
  "properties": {
    "schemaVersion": { "const": "e2e-result.v1" },
    "provider": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "targetOrigin": { "type": "string", "format": "uri", "maxLength": 2048 },
    "workers": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "browserProjects": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "project", "status", "attempts", "errors"],
        "properties": {
          "id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "project": { "type": ["string", "null"], "maxLength": 256 },
          "browser": { "type": ["string", "null"], "maxLength": 128 },
          "status": { "enum": ["passed", "failed", "skipped", "unexecuted"] },
          "attempts": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "errors": {
            "type": "array",
            "maxItems": 1000,
            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped", "unexecuted"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "unexecuted": { "type": "integer", "minimum": 0 }
      }
    },
    "reportFormat": { "type": "string", "minLength": 1, "maxLength": 128 },
    "resourceEnforcement": { "enum": ["cgroup-v2", "sampled"] }
  }
}
