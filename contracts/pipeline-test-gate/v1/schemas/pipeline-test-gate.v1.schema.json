        "resultDigest": { "$ref": "#/$defs/digest" },
        "receipt": { "$ref": "#/$defs/receiptRef" }
      }
    },
    "remotePlanResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resultDigest", "contentDigest", "sizeBytes"],
      "properties": {
        "schemaVersion": { "const": "buster-plan-result-ref.v1" },
        "resultDigest": { "$ref": "#/$defs/digest" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
      }
    },
    "remotePlanStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "jobId", "requestDigest", "state", "submittedAt",
        "updatedAt", "result", "error"
      ],
      "properties": {
        "schemaVersion": { "const": "buster-plan-status.v1" },
        "jobId": { "$ref": "#/$defs/stableId" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "state": { "enum": ["accepted", "running", "cancelling", "completed", "failed", "cancelled"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/remotePlanResultRef" },
            { "type": "null" }
          ]
        },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        }
      }
    }
  }
