        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "errored": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "reportAdapterResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "adapter",
        "sourceArtifact",
        "counts",
        "durationMs",
        "cases",
        "casesTruncated",
        "omittedCaseCount",
        "findings",
        "findingsTruncated",
        "omittedFindingCount"
      ],
      "properties": {
        "schemaVersion": { "const": "report-adapter-result.v1" },
        "adapter": { "$ref": "#/$defs/reportAdapterRef" },
        "sourceArtifact": { "$ref": "#/$defs/artifactRef" },
        "counts": { "$ref": "#/$defs/reportCounts" },
        "durationMs": { "type": "number", "minimum": 0 },
        "cases": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/reportCase" }
        },
        "casesTruncated": { "type": "boolean" },
        "omittedCaseCount": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/finding" }
        },
        "findingsTruncated": { "type": "boolean" },
        "omittedFindingCount": { "type": "integer", "minimum": 0 }
      }
    },
    "repositoryArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "encoding", "contentDigest", "sizeBytes", "data"],
      "properties": {
        "schemaVersion": { "const": "repository-archive.v1" },
        "encoding": { "const": "base64" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 178956972,
          "contentEncoding": "base64"
        }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sourceType", "pipelineStageId", "repositoryId", "revision", "tree", "archiveContentDigest", "archiveSizeBytes", "creatorAuthority"],
      "properties": {
        "schemaVersion": { "const": "source-snapshot.v1" },
        "sourceType": { "const": "git-commit" },
        "pipelineStageId": { "$ref": "#/$defs/stableId" },
        "repositoryId": { "$ref": "#/$defs/stableId" },
        "revision": { "type": "string", "pattern": "^git:(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "tree": { "type": "string", "pattern": "^git:(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "archiveContentDigest": { "$ref": "#/$defs/digest" },
        "archiveSizeBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "creatorAuthority": { "$ref": "#/$defs/stableId" }
      }
    },
    "grantMap": {
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "array",
        "maxItems": 128,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/stableId" }
      }
    },
    "remotePlanJob": {
