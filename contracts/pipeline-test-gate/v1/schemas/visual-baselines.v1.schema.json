{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://kubeclaw.dev/contracts/pipeline-test-gate/visual-baselines.v1.schema.json",
  "type":"object","additionalProperties":false,"required":["schemaVersion","entries"],
  "properties":{
    "schemaVersion":{"const":"kubeclaw.visual-baselines.v1"},
    "baselineBundleDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "entries":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"object","additionalProperties":false,
      "required":["id","route","profile","baselineFile","sha256","browser","viewport","pageConditions"],"properties":{
        "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "route":{"type":"string","pattern":"^/(?!/)[^?#\\r\\n]*$","maxLength":1024},
        "profile":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "baselineFile":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.png$"},
        "sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "browser":{"enum":["chromium","firefox","webkit"]},
        "viewport":{"type":"object","additionalProperties":false,"required":["width","height"],"properties":{"width":{"type":"integer","minimum":240,"maximum":3840},"height":{"type":"integer","minimum":240,"maximum":2160}}},
        "pageConditions":{"type":"object","additionalProperties":false,"required":["colorScheme","reducedMotion","locale","timezoneId","deviceScaleFactor","hasTouch","isMobile","fullPage"],"properties":{
          "colorScheme":{"type":["string","null"],"enum":["light","dark","no-preference",null]},"reducedMotion":{"type":["string","null"],"enum":["reduce","no-preference",null]},"locale":{"type":["string","null"],"minLength":1,"maxLength":128},"timezoneId":{"type":["string","null"],"minLength":1,"maxLength":128},"deviceScaleFactor":{"type":"number","minimum":0.5,"maximum":4},"hasTouch":{"type":"boolean"},"isMobile":{"type":"boolean"},"fullPage":{"const":true}
        }}
      }
    }}
  }
}
