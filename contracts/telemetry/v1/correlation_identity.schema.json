{
  "$id": "correlation_identity.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt": {
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "dispatch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_type": {
      "enum": [
        "pipeline",
        "module",
        "gate",
        "generator",
        "validator",
        "pipeline_step",
        null
      ]
    }
  },
  "required": [
    "project",
    "run_id",
    "source",
    "producer"
  ],
  "title": "Canonical correlation identity",
  "type": "object"
}
