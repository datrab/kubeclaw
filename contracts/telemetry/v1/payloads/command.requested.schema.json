{
  "$id": "command.requested.payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "type": "string"
    },
    "agent_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "capability": {
      "type": "string"
    },
    "command_id": {
      "type": "string"
    },
    "command_type": {
      "enum": [
        "approval.resolve",
        "pipeline.pause",
        "pipeline.resume",
        "pipeline.cancel"
      ]
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "decision": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "dispatch_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "expected_lifecycle_version": {
      "minimum": 0,
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "gate_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "gate_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "model_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "module_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "type": [
        "object",
        "null"
      ]
    },
    "tool_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "command_id",
    "command_type",
    "actor",
    "capability",
    "expires_at",
    "expected_lifecycle_version"
  ],
  "type": "object"
}
