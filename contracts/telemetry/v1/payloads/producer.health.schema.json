{
  "$id": "producer.health.payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability": { "minLength": 1, "type": "string" },
          "details": { "type": ["object", "null"] },
          "reason_code": { "type": ["string", "null"] },
          "status": { "enum": ["available", "capability_unavailable", "degraded", "unknown"] }
        },
        "required": ["capability", "status", "reason_code"],
        "type": "object"
      },
      "type": "array"
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "dead_letter_count": {
      "type": "integer"
    },
    "dispatch_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object"
    },
    "gate_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "gate_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "invalid_count": {
      "type": "integer"
    },
    "lag": {
      "type": [
        "integer",
        "null"
      ]
    },
    "last_successful_emission": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_payload_count": {
      "type": "integer"
    },
    "model_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "module_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "producer_id": {
      "type": "string"
    },
    "quarantined_count": {
      "type": "integer"
    },
    "reconciliation": {
      "type": [
        "object",
        "null"
      ]
    },
    "restart_count": {
      "type": "integer"
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown",
        "not_applicable"
      ]
    },
    "tool_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "producer_id",
    "status",
    "invalid_count",
    "quarantined_count",
    "dead_letter_count",
    "last_successful_emission"
    ,"capabilities"
  ],
  "type": "object"
}
