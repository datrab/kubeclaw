{
  "$id": "producer.health.payload.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/agent_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "$ref": "../envelope.schema.json#/properties/attempt"
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "minLength": 1,
            "type": "string"
          },
          "details": {
            "type": [
              "object",
              "null"
            ]
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "available",
              "capability_unavailable",
              "degraded",
              "unknown"
            ]
          }
        },
        "required": [
          "capability",
          "status",
          "reason_code"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "dead_letter_count": {
      "type": "integer"
    },
    "dispatch_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/dispatch_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "extensions": {
      "$ref": "../envelope.schema.json#/properties/extensions"
    },
    "gate_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "gate_type": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/gate_type"
        },
        {
          "minLength": 1
        }
      ]
    },
    "invalid_count": {
      "type": "integer"
    },
    "lag": {
      "type": [
        "integer",
        "null"
      ]
    },
    "last_successful_emission": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_payload_count": {
      "type": "integer"
    },
    "model_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/model_call_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "module_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/module_id"
        },
        {
          "minLength": 1
        }
      ]
    },
    "producer_id": {
      "type": "string"
    },
    "quarantined_count": {
      "type": "integer"
    },
    "reconciliation": {
      "type": [
        "object",
        "null"
      ]
    },
    "restart_count": {
      "type": "integer"
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown",
        "not_applicable"
      ]
    },
    "tool_call_id": {
      "allOf": [
        {
          "$ref": "../envelope.schema.json#/properties/tool_call_id"
        },
        {
          "minLength": 1
        }
      ]
    }
  },
  "required": [
    "producer_id",
    "status",
    "invalid_count",
    "quarantined_count",
    "dead_letter_count",
    "last_successful_emission",
    "capabilities"
  ],
  "type": "object"
}
