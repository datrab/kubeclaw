{
  "$id": "command.requested.event.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "type": "string"
    },
    "agent_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "capability": {
      "type": "string"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "command_id": {
      "type": "string"
    },
    "command_type": {
      "enum": [
        "approval.resolve",
        "pipeline.pause",
        "pipeline.resume",
        "pipeline.cancel"
      ]
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "dispatch_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "emitted_at": {
      "format": "date-time",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "expected_lifecycle_version": {
      "minimum": 0,
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "gate_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "gate_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "model_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "module_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "telemetry_envelope.v1"
    },
    "seq": {
      "minimum": 1,
      "type": "integer"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "target": {
      "type": [
        "object",
        "null"
      ]
    },
    "tool_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "const": "command.requested"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_type": {
      "enum": [
        "pipeline",
        "module",
        "gate",
        "generator",
        "validator",
        "pipeline_step",
        null
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "type",
    "occurred_at",
    "emitted_at",
    "seq",
    "project",
    "run_id",
    "source",
    "producer",
    "command_id",
    "command_type",
    "actor",
    "capability",
    "expires_at",
    "expected_lifecycle_version"
  ],
  "type": "object"
}
