{
  "$id": "artifact.published.event.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_id": {
      "type": "string"
    },
    "artifact_reference": {
      "minLength": 1,
      "type": "string"
    },
    "attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "byte_length": {
      "minimum": 0,
      "type": "integer"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "completeness": {
      "enum": [
        "full",
        "truncated",
        "summarized",
        "transformed",
        "unavailable",
        "reference-only"
      ]
    },
    "content_class": {
      "enum": [
        "metadata",
        "payload",
        "artifact",
        "quarantined"
      ]
    },
    "content_completeness": {
      "minLength": 1,
      "type": "string"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "dispatch_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "emitted_at": {
      "format": "date-time",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "type": "object"
    },
    "gate_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "gate_type": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "logical_id": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "model_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "module_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "original_byte_length": {
      "type": [
        "integer",
        "null"
      ]
    },
    "original_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "project": {
      "minLength": 1,
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "telemetry_envelope.v1"
    },
    "seq": {
      "minimum": 1,
      "type": "integer"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_key": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "tool_call_id": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "transformation": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "const": "artifact.published"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_type": {
      "enum": [
        "pipeline",
        "module",
        "gate",
        "generator",
        "validator",
        "pipeline_step",
        null
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "type",
    "occurred_at",
    "emitted_at",
    "seq",
    "project",
    "run_id",
    "source",
    "producer",
    "artifact_id",
    "logical_id",
    "kind",
    "media_type",
    "byte_length",
    "sha256",
    "content_class",
    "reference"
  ],
  "type": "object"
}
