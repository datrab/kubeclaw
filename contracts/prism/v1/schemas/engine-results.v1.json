{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubeclaw.dev/contracts/prism/engine-results.v1.json",
  "$defs": {
    "generate": {
      "type": "object",
      "required": [
        "document",
        "operations",
        "mode"
      ],
      "properties": {
        "document": {
          "type": "object"
        },
        "operations": {
          "type": "array"
        },
        "mode": {
          "enum": [
            "directions",
            "initial-document",
            "refine"
          ]
        }
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "required": [
        "html",
        "renderer",
        "accessibilityFindings"
      ],
      "properties": {
        "html": {
          "type": "string"
        },
        "screenshotBase64": {
          "type": "string"
        },
        "ariaSnapshot": {
          "type": "string"
        },
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "locale",
            "timezone",
            "motion"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "locale": {
              "const": "en-US"
            },
            "timezone": {
              "const": "UTC"
            },
            "motion": {
              "const": "reduced"
            }
          }
        },
        "accessibilityFindings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evaluate": {
      "type": "object",
      "required": [
        "status",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "needs-attention",
            "blocked"
          ]
        },
        "findings": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "ingest": {
      "type": "object",
      "required": [
        "embedding",
        "model",
        "modelVersion",
        "sourceDigest"
      ],
      "properties": {
        "embedding": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "number"
          }
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "required": [
        "manifest",
        "bundleDigest"
      ],
      "properties": {
        "manifest": {
          "type": "object"
        },
        "bundleDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "renderSelected": {
      "type": "object",
      "required": [
        "html",
        "renderer",
        "accessibilityFindings"
      ],
      "properties": {
        "html": {
          "type": "string"
        },
        "screenshotBase64": {
          "type": "string"
        },
        "ariaSnapshot": {
          "type": "string"
        },
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "locale",
            "timezone",
            "motion",
            "policyVersion",
            "viewport"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "locale": {
              "enum": [
                "en-US",
                "de-DE"
              ]
            },
            "timezone": {
              "enum": [
                "UTC",
                "Europe/Berlin"
              ]
            },
            "motion": {
              "const": "reduced"
            },
            "policyVersion": {
              "const": "prism-render-policy.v1"
            },
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            }
          }
        },
        "accessibilityFindings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
