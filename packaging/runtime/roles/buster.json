{
  "schemaVersion": "pipeline-runtime-role.v1",
  "role": "buster",
  "entrypoint": {
    "package": "buster-runtime",
    "path": "runtime.ts",
    "output": "runtime.ts",
    "import": "@kubeclaw/buster-engine"
  },
  "packages": [
    "plugin-sdk",
    "plugin-foundation",
    "plugin-system-contract",
    "worker-core",
    "buster-engine",
    "buster-runtime",
    "agent-observability-contract",
    "telemetry-contract",
    "pipeline-test-gate-contract",
    "pipeline-worker-core-contract",
    "pipeline-observability-contract"
  ],
  "plugins": [
    "kubeclaw.agent-observability",
    "kubeclaw.artifact-store",
    "kubeclaw.api-flow",
    "kubeclaw.axe",
    "kubeclaw.lighthouse",
    "kubeclaw.visual",
    "kubeclaw.playwright",
    "kubeclaw.security-providers",
    "kubeclaw.command-runner",
    "kubeclaw.network-http",
    "kubeclaw.openapi",
    "kubeclaw.runtime-dispatch",
    "kubeclaw.secret-resolver",
    "kubeclaw.telemetry-store",
    "kubeclaw.container-build",
    "kubeclaw.coverage-budget",
    "kubeclaw.direct-command",
    "kubeclaw.junit-report",
    "kubeclaw.kubernetes-fixture",
    "kubeclaw.tailscale-exposure",
    "kubeclaw.http",
    "kubeclaw.size-budget"
  ],
  "extensions": ["kubeclaw-agent-observer"],
  "externalCapabilities": [
    {
      "id": "git.repository.read",
      "source": "worker-workspace",
      "reason": "Buster receives a read-only repository snapshot for its attempt."
    },
    {
      "id": "test.plan.execute",
      "source": "nova-orchestrator",
      "reason": "Nova signs and submits the immutable provider plan before Buster judges its evidence."
    }
  ]
}
