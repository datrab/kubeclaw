{
  "schemaVersion": "pipeline-runtime-role.v1",
  "role": "prism",
  "entrypoint": {
    "package": "prism-runtime",
    "path": "runtime.ts",
    "output": "runtime.ts",
    "import": "@kubeclaw/prism"
  },
  "packages": [
    "plugin-sdk", "plugin-foundation", "plugin-system-contract", "worker-core",
    "prism-engine", "prism-runtime", "agent-observability-contract",
    "pipeline-test-gate-contract", "pipeline-worker-core-contract",
    "pipeline-observability-contract", "prism-contract"
  ],
  "plugins": [
    "kubeclaw.agent-observability", "kubeclaw.artifact-store",
    "kubeclaw.network-http", "kubeclaw.runtime-dispatch",
    "kubeclaw.secret-resolver", "kubeclaw.telemetry-store"
  ],
  "extensions": ["kubeclaw-agent-observer"],
  "externalCapabilities": [
    {
      "id": "git.repository.read",
      "source": "worker-workspace",
      "reason": "Prism receives a read-only project snapshot for design analysis."
    }
  ]
}
